15\u0c30\u0c23 \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30",description:"\u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c39\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f."},bankSeedingStatus:{title:"\u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c38\u0c40\u0c21\u0c3f\u0c02\u0c17\u0c4d \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f",description:"\u0c2e\u0c40 \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c38\u0c40\u0c21\u0c3f\u0c02\u0c17\u0c4d \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f."},authenticationHistory:{title:"\u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30",description:"\u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30\u0c28\u0c41 \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",heading:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c47\u0c02\u0c26\u0c41\u0c15\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c24\u0c47\u0c26\u0c40 \u0c2a\u0c30\u0c3f\u0c27\u0c3f\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",modality:"\u0c2e\u0c4b\u0c21\u0c3e\u0c32\u0c3f\u0c1f\u0c40\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",fieldStartText:"\u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d \u0c24\u0c47\u0c26\u0c40\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",fieldEndText:"\u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c2a\u0c41 \u0c24\u0c47\u0c26\u0c40\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",button:"\u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c02\u0c21\u0c3f",tableHeading:"\u0c2e\u0c40 \u0c0e\u0c02\u0c2a\u0c3f\u0c15 \u0c2b\u0c32\u0c3f\u0c24\u0c02\u0c17\u0c3e {{txnNumber}} \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23\u0c32\u0c41 \u0c35\u0c1a\u0c4d\u0c1a\u0c3e\u0c2f\u0c3f",dateRange:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c0f\u0c1c\u0c46\u0c28\u0c4d\u0c38\u0c40 (AUA) \u0c32\u0c47\u0c26\u0c3e \u0c05\u0c24\u0c28\u0c41/\u0c06\u0c2e\u0c46 \u0c17\u0c24 6 \u0c28\u0c46\u0c32\u0c32\u0c4d\u0c32\u0c4b \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c3f\u0c28 50 \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c17\u0c32\u0c30\u0c41.",filterName:"\u0c2e\u0c4b\u0c21\u0c3e\u0c32\u0c3f\u0c1f\u0c40\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",note:{l1:"\u0c17\u0c2e\u0c28\u0c3f\u0c15:",l2:"AUA \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 ID:",l3:"\u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c38\u0c2e\u0c2f\u0c02\u0c32\u0c4b \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c47\u0c15\u0c2e\u0c48\u0c28 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 ID.",l4:"\u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c0f\u0c1c\u0c46\u0c28\u0c4d\u0c38\u0c40 \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e:",l5:"\u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40\u0c15\u0c3f \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \u0c0f\u0c35\u0c48\u0c28\u0c3e \u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c32\u0c41 \u0c09\u0c02\u0c1f\u0c47, \u0c06 \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c15\u0c4b\u0c38\u0c02 AUA\u0c28\u0c3f \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",l6:"\u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",l7:"\u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c28:",l8:"\u0c35\u0c3f\u0c1c\u0c2f\u0c02 / \u0c35\u0c48\u0c2b\u0c32\u0c4d\u0c2f\u0c02",l9:"UIDAI \u0c0e\u0c30\u0c4d\u0c30\u0c30\u0c4d \u0c15\u0c4b\u0c21\u0c4d\u200c\u0c32\u0c41:",l10:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c32\u0c4b\u0c2a\u0c02 \u0c15\u0c4b\u0c21\u0c4d\u200c\u0c32\u0c41.",l11:"\u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c28\u0c4a\u0c15\u0c4d\u0c15\u0c02\u0c21\u0c3f",l12:"FAQs: ",l13:"\u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30. ",l14:"\u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c28\u0c4a\u0c15\u0c4d\u0c15\u0c02\u0c21\u0c3f",l15:"\u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02:",l16:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02",l17:"\u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30 PDF \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d 8 \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32\u0c32\u0c4b \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f. \u0c2e\u0c40 \u0c2a\u0c47\u0c30\u0c41\u0c32\u0c4b\u0c28\u0c3f \u0c2e\u0c4a\u0c26\u0c1f\u0c3f \u0c28\u0c3e\u0c32\u0c41\u0c17\u0c41 \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32\u0c41 (\u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28\u0c1f\u0c4d\u0c32\u0c41) \u0c15\u0c4d\u0c2f\u0c3e\u0c2a\u0c3f\u0c1f\u0c32\u0c4d \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 YYYY \u0c06\u0c15\u0c43\u0c24\u0c3f\u0c32\u0c4b \u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02 \u0c15\u0c32\u0c2f\u0c3f\u0c15."}},documentUpdate:{title:"\u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d",description:"\u0c2e\u0c40 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c30\u0c41\u0c1c\u0c41\u0c35\u0c41 (PoI) \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c30\u0c41\u0c1c\u0c41\u0c35\u0c41 (PoA) \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f."}}},requests:{title:"\u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c32\u0c41",description:"\u0c08 \u0c2e\u0c27\u0c4d\u0c2f\u0c15\u0c3e\u0c32\u0c02\u0c32\u0c4b \u0c2e\u0c40\u0c30\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c3f\u0c35\u0c3f\u0c27 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c32 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f. \u201c\u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26\u0c3f\u0c15\u0c3f\u201d \u0c2c\u0c3e\u0c23\u0c02 \u0c1a\u0c3f\u0c39\u0c4d\u0c28\u0c02\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c2f\u0c4a\