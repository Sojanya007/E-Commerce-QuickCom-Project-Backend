d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},bookAppointment:{title:"\u0d12\u0d30\u0d41 \u0d15\u0d42\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d34\u0d4d\u200c\u0d1a \u0d2c\u0d41\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",description:"\u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d3f\u0d28\u0d4b \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d4b \u0d35\u0d47\u0d23\u0d4d\u0d1f\u0d3f \u0d12\u0d30\u0d41 \u0d05\u0d2a\u0d4d\u0d2a\u0d4b\u0d2f\u0d3f\u0d28\u0d4d\u0d31\u0d4d\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d2c\u0d41\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},vidGenerator:{title:"\u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d7c",description:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d31\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d32\u0d3f\u0d19\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d33\u0d4d\u0d33 16 \u0d05\u0d15\u0d4d\u0d15 \u0d35\u0d46\u0d7c\u0d1a\u0d4d\u0d35\u0d7d \u0d10\u0d21\u0d3f (\u0d35\u0d3f\u0d10\u0d21\u0d3f) \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},lec:{title:"\u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d38\u0d46\u0d28\u0d4d\u0d31\u0d7c \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d41\u0d15",description:"\u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d24\u0d3f\u0d30\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3e\u0d28\u0d41\u0d02 \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},lockUnlockAadhaar:{title:"\u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d / \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",description:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d24\u0d3e\u0d7d\u200c\u0d15\u0d4d\u0d15\u0d3e\u0d32\u0d3f\u0d15\u0d2e\u0d3e\u0d2f\u0d3f \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d / \u0d05\u0d7a\u200c\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. \u0d08 \u0d38\u0d47\u0d35\u0d28\u0d02 \u0d36\u0d4d\u0d30\u0d26\u0d4d\u0d27\u0d3e\u0d2a\u0d42\u0d7c\u0d35\u0d4d\u0d35\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15"},complaintStatus:{title:"\u0d2a\u0d30\u0d3e\u0d24\u0d3f / \u0d2b\u0d40\u0d21\u0d4d\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d32 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",description:"\u0d2a\u0d30\u0d3e\u0d24\u0d3f / \u0d2b\u0d40\u0d21\u0d4d\u200c\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d32 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},fileComplaint:{title:"\u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d2f\u0d41\u0d02 \u0d2b\u0d40\u0d21\u0d4d\u200c\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d02",description:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d2f\u0d41\u0d02 \u0d2b\u0d40\u0d21\u0d4d\u200c\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d2b\u0d2f\u0d7d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"}}}},documentUpdate:{intentPage:{title:"\u0d21\u0d4b\u0d15\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d47\u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d32\u0d15\u0d4d\u0d37\u0d4d\u0d2f\u0d02",p1:"\u0d2a\u0d4d\u0d30\u0d3f\u0d2f \u0d28\u0d3f\u0d35\u0d3e\u0d38\u0d3f,",p2:"\u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d10\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f \u0d2a\u0d4d\u0d30\u0d42\u0d2b\u0d4d (POI), \u0d05\u0d21\u0d4d\u0d30\u0d38\u0d4d \u0d2a\u0d4d\u0d30\u0d42\u0d2b\u0d4d (POA) \u0d21\u0d4b\u0d15\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d3e\u0d2c\u0d47\u0d38\u0d3f\u0d32\u0d46 \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d41\u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d36\u0d15\u0d4d\u0d24\u0d3f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d28\u0d3f\u0d7c\u0d26\u0d4d\u0d26\u0d47\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. POI/POA \u0d30\u0d47\u0d16\u0d15\u0d33\u0d3f\u0d32\u0d46 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7d \u0d38\u0d42\u0d1a\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d4a\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d23\u0d02. \u0d06\u0d27\u0d3e\u0d7c \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d3e\u0d2c\u0d47\u0d38\u0d3f\u0d7d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d24\u0d41\u0d1f\u0d7c\u0d1a\u0d4d\u0d1a\u0d2f\u0d3e\u0d2f \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d24 \u0d09\u0d31\u0d2a\u0d4d\u0d2a\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d07\u0d24\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d46 \u0d38\u0d39\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02.",p3:"\u0d0f\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d38\u0d46\u0d28\u0d4d\u0d31\u0d31\u0d41\u0d15\u0d7e \u0d35\u0d34\u0d3f\u0d2f\u0d4b myAadhaar \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d7d \u0d35\u0d34\u0d3f\u0d2f\u0d4b \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d07\u0d24\u0d3f\u0d28\u0d15\u0d02 \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d05\u0d24\u0d4d \u0d38\u0d4d\u0d35\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4b \u0d2e\u0d31\u0d4d\u0d31\u0d4b \u0d15\u0d3e\u0d24\u0d4d\u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a \u0d05\u0d2a\u0d47\u0d15\u0d4d\u0d37 \u0d28\u0d3f\u0d30\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d3e\u0d7d, \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d41\u0d02 \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d47\u0d23\u0d4d\u0d1f\u0d3f \u0d35\u0d28\u0d4d\u0d28\u0d47\u0d15\u0d4d\u0d15\u0d3e\u0d02.",p4:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d32\u0d46 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d06\u0d17\u0d4d\u0d30\u0d39\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d35\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f",p5:"\u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.",p6:"\u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3e\u0d2e\u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d3e\u0d2f 25/- \u0d30\u0d42\u0d2a \u0d28\u0d7d\u0d15\u0d23\u0d02, \u0d05\u0d24\u0d4d \u0d31\u0d40\u0d2b\u0d23\u0d4d\u0d1f\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d3f\u0d32\u0d4d\u0d32.",p7:"\u0d08 \u0d38\u0d47\u0d35\u0d28\u0d02 14/06/2025 \u0d35\u0d30\u0d46 \u0d38\u0d57\u0d1c\u0d28\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d"},howItWorks:{description:"\u0d07\u0d28\u0d3f\u0d2a\u0d4d\u0d2a\u0d31\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d18\u0d1f\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d7e \u0d36\u0d4d\u0d30\u0d26\u0d4d\u0d27\u0d3e\u0d2a\u0d42\u0d7c\u0d35\u0d4d\u0d35\u0d02 \u0d35\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d2a\u0d4d\u0d30\u0d4b\u0d38\u0d38\u0d4d\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4b \u0d28\u0d3f\u0d30\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4b \u0d09\u0d33\u0d4d\u0d33 \u0d15\u0d3e\u0d32\u0d24\u0d3e\u0d2e\u0d38\u0d02 \u0d12\u0d34\u0d3f\u0d35\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d35\u0d3f\u0d35\u0d3f\u0d27 \u0d18\u0d1f\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d28\u0d3f\u0d7c\u0d26\u0d4d\u0d26\u0d47\u0d36\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d19\u0d4d\u0d19\u0d7e \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d1f\u0d30\u0d41\u0d15. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d32\u0d46 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d06\u0d17\u0d4d\u0d30\u0d39\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d35\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f",stepDescription:{one:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d10\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f \u0d2a\u0d4d\u0d30\u0d42\u0d2b\u0d4d (PoI), \u0d05\u0d21\u0d4d\u0d30\u0d38\u0d4d \u0d2a\u0d4d\u0d30\u0d42\u0d2b\u0d4d (PoA) \u0d21\u0d4b\u0d15\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.",two:"\u0d08 \u0d18\u0d1f\u0d4d\u0d1f\u0d24\u0d4d\u0d24\u0d3f\u0d7d, \u0d18\u0d1f\u0d4d\u0d1f\u0d02 1-\u0d7d \u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d40\u0d15\u0d30\u0d3f\u0d1a\u0d4d\u0d1a \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d1a\u0d4d\u0d1a \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f \u0d38\u0d3e\u0d27\u0d41\u0d35\u0d3e\u0d2f POI/POA \u0d21\u0d4b\u0d15\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d4b\u0d1f\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d02.",three:"\u0d08 \u0d38\u0d47\u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u20b9 25 (\u0d07\u0d30\u0d41\u0d2a\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d1e\u0d4d\u0d1a\u0d4d \u0d30\u0d42\u0d2a \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02) \u0d28\u0d7d\u0d15\u0d23\u0d02. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d15\u0d4d\u0d30\u0d46\u0d21\u0d3f\u0d31\u0d4d\u0d31\u0d4d/\u0d21\u0d46\u0d2c\u0d3f\u0d31\u0d4d\u0d31\u0d4d \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d28\u0d46\u0d31\u0d4d\u0d31\u0d4d \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d35\u0d34\u0d3f \u0d2a\u0d23\u0d2e\u0d1f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d3e\u0d02. \u0d08 \u0d24\u0d41\u0d15 \u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d46 \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d3f\u0d32\u0d4d\u0d32."},note:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d  \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e (\u0d2a\u0d47\u0d30\u0d4d, \u0d1c\u0d28\u0d28\u0d24\u0d4d\u0d24\u0d40\u0d2f\u0d24\u0d3f , \u0d32\u0d3f\u0d02\u0d17\u0d2d\u0d47\u0d26\u0d02 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02) \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d06\u0d17\u0d4d\u0d30\u0d39\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d35\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d07\u0d35\u0d3f\u0d1f\u0d46 ",noteLink:"\u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15."},currentSection:{form:{title:"\u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",name:"\u0d2a\u0d47\u0d30\u0d4d",gender:"\u0d32\u0d3f\u0d02\u0d17\u0d2d\u0d47\u0d26\u0d02",dob:"\u0d1c\u0d28\u0d3f\u0d1a\u0d4d\u0d1a \u0d26\u0d3f\u0d35\u0d38\u0d02",address:"\u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02",consent:"\u0d2e\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d36\u0d30\u0d3f\u0d2f\u0d3e\u0d23\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d1e\u0d3e\u0d7b \u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41."},note:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d0f\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d2a\u0d4a\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d15\u0d4d\u0d15\u0d47\u0d1f\u0d41\u0d15\u0d7e \u0d09\u0d23\u0d4d\u0d1f\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e (\u0d2a\u0d47\u0d30\u0d4d, \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02, DoB \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d32\u0d3f\u0d02\u0d17\u0d2d\u0d47\u0d26\u0d02) \u0d07\u0d35\u0d3f\u0d1f\u0d46 ",noteLink:"\u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15."},uploadSection:{confirmationPopUp:{title:"\u0d21\u0d4b\u0d15\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d3f\u0d32\u0d46 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d32\u0d46 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d4a\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d23\u0d4d\u0d1f\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15"},stepper:{verify:"\u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",upload:"\u0d05\u0d2a\u0d4d\u0d32\u0d4b\u0d21\u0d4d"},guidelines:{title:"\u0d30\u0d47\u0d16\u0d15\u0d7e  \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d2e\u0d3e\u0d7c\u0d17\u0d4d\u0d17\u0d28\u0d3f\u0d7c\u0d26\u0d4d\u0d26\u0d47\u0d36\u0d19\u0d4d\u0d19\u0d7e",l1:"\u0d30\u0d47\u0d16\u0d2f\u0d41\u0d1f\u0d46  \u0d35\u0d32\u0d41\u0d2a\u0d4d\u0d2a\u0d02 2 MB-\u0d2f\u0d3f\u0d7d \u0d15\u0d41\u0d31\u0d35\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d02",l2:"\u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2b\u0d2f\u0d7d \u0d2b\u0d4b\u0d7c\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d07\u0d35\u0d2f\u0d3e\u0d23\u0d4d: <b>JPEG, PNG</b>, <b>PDF</b>"},form:{poiTitle:"\u0d10\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f \u0d2a\u0d4d\u0d30\u0d42\u0d2b\u0d4d (POI) \u0d30\u0d47\u0d16 \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",poaTitle:"\u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d24\u0d46\u0d33\u0d3f\u0d35\u0d4d (POA) \u0d30\u0d47\u0d16 \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},consent:"\u0d1e\u0d3e\u0d7b \u0d28\u0d7d\u0d15\u0d3f\u0d2f/\u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u200c\u0d24 \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e/\u0d30\u0d47\u0d16\u0d15\u0d7e \u0d17\u0d35\u0d7a\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d0f\u0d24\u0d4d \u0d18\u0d1f\u0d4d\u0d1f\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d41\u0d02 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d31\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d32\u0d3f\u0d28\u0d4d \u0d35\u0d3f\u0d27\u0d47\u0d2f\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d2e\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d1e\u0d3e\u0d7b \u0d07\u0d24\u0d3f\u0d28\u0d3e\u0d7d \u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d2e\u0d4d\u0d2e\u0d24\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41."},faq:{card:{heading:"\u0d21\u0d4b\u0d15\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d",description_1:"",description_2:""},guidelines:{heading_1:"\u0d10\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f\u0d2f\u0d41\u0d02 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d35\u0d41\u0d02 \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",heading_2:"14/06/2025 \u0d35\u0d30\u0d46 \u0d38\u0d57\u0d1c\u0d28\u0d4d\u0d2f\u0d02",question_1:{title:"\u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d23\u0d4d\u0d1f\u0d24\u0d4d?",content:{line_1:"\u0d31\u0d47\u0d37\u0d7b \u0d15\u0d3e\u0d7c\u0d21\u0d4d, \u0d35\u0d4b\u0d1f\u0d4d\u0d1f\u0d7c \u0d10\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d,\xa0 \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d28\u0d7d\u0d15\u0d3f\u0d2f \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d15\u0d3e\u0d7c\u0d21\u0d4d/ \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d, \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d7b \u0d2a\u0d3e\u0d38\u0d4d\u200c\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d10\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f\u0d2f\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46\u0d2f\u0d41\u0d02 \u0d24\u0d46\u0d33\u0d3f\u0d35\u0d3e\u0d2f\u0d3f \u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",line_2:"\u0d2a\u0d3e\u0d7b \u0d15\u0d3e\u0d7c\u0d21\u0d4d, \u0d21\u0d4d\u0d30\u0d48\u0d35\u0d3f\u0d02\u0d17\u0d4d \u0d32\u0d48\u0d38\u0d7b\u0d38\u0d4d, \u0d38\u0d46\u0d15\u0d4d\u0d15\u0d7b\u0d21\u0d31\u0d3f \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d38\u0d40\u0d28\u0d3f\u0d2f\u0d7c \u0d38\u0d4d\u0d15\u0d42\u0d7e \u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d37\u0d40\u0d31\u0d4d\u0d31\u0d4d/ \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b \u0d09\u0d33\u0d4d\u0d33 \u0d38\u0d4d\u0d15\u0d42\u0d7e \u0d32\u0d40\u0d35\u0d4d \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d, \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d28\u0d7d\u0d15\u0d3f\u0d2f \u0d10\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d/ \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d - \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d30\u0d47\u0d16 \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02.",line_3:"\u0d35\u0d48\u0d26\u0d4d\u0d2f\u0d41\u0d24\u0d3f/\u0d35\u0d46\u0d33\u0d4d\u0d33\u0d02/\u0d17\u0d4d\u0d2f\u0d3e\u0d38\u0d4d \u0d2c\u0d3f\u0d7d (\u0d15\u0d34\u0d3f\u0d1e\u0d4d\u0d1e 3 \u0d2e\u0d3e\u0d38\u0d02),\xa0 \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d4d / \u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d13\u0d2b\u0d40\u0d38\u0d4d \u0d2a\u0d3e\u0d38\u0d4d\u200c\u0d2c\u0d41\u0d15\u0d4d\u0d15\u0d4d,\xa0 \u0d35\u0d3e\u0d1f\u0d15/ \u0d2a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02/ \u0d32\u0d40\u0d35\u0d4d, \u0d32\u0d48\u0d38\u0d7b\u0d38\u0d4d \u0d15\u0d30\u0d3e\u0d7c \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d24\u0d46\u0d33\u0d3f\u0d35\u0d3e\u0d2f\u0d3f \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02 \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",line_4:"\u0d38\u0d4d\u0d35\u0d40\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d10\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f\u0d2f\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d30\u0d47\u0d16\u0d15\u0d33\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d35\u0d3f\u0d36\u0d26\u0d2e\u0d3e\u0d2f \u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d3e\u0d2f\u0d3f,",line_5:" \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"}},question_2:{title:"\u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02?",content:{line_1:"\u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d7d \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d0f\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02 \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d13\u0d7a\u0d32\u0d48\u0d28\u0d3e\u0d2f\u0d3f \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02.",line_2:"\u0d30\u0d47\u0d16\u0d15\u0d7e \u0d13\u0d7a\u0d32\u0d48\u0d28\u0d3e\u0d2f\u0d3f \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d18\u0d1f\u0d4d\u0d1f\u0d02 \u0d18\u0d1f\u0d4d\u0d1f\u0d2e\u0d3e\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d28\u0d1f\u0d2a\u0d1f\u0d3f\u0d15\u0d4d\u0d30\u0d2e\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",line_3:" \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"}},main_content:{submit:"\u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d35\u0d3e\u0d7b \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",title:"\u0d38\u0d39\u0d3e\u0d2f\u0d02 \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d41\u0d23\u0d4d\u0d1f\u0d4b?",videoText:"\u0d35\u0d40\u0d21\u0d3f\u0d2f\u0d4b \u0d17\u0d48\u0d21\u0d4d",knowMoreText:"\u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d \u0d05\u0d31\u0d3f\u0d2f\u0d41\u0d35\u0d3e\u0d7b?",callText:"\u0d1f\u0d4b\u0d7e \u0d2b\u0d4d\u0d30\u0d40 \u0d28\u0d02\u0d2c\u0d31\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d35\u0d3f\u0d33\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15(1947)"}},one:{title:"\u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d1e\u0d3e\u0d7b \u0d0e\u0d28\u0d4d\u0d24\u0d3f\u0d28\u0d4d \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d30\u0d47\u0d16\u0d15\u0d33\u0d41\u0d02 \u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d30\u0d47\u0d16\u0d15\u0d33\u0d41\u0d02 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d02?",content:"\u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d28\u0d3e\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d32\u0d3f\u0d28\u0d41\u0d02 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d41\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d7d \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d1c\u0d40\u0d35\u0d3f\u0d24 \u0d38\u0d57\u0d15\u0d30\u0d4d\u0d2f\u0d02, \u0d2e\u0d3f\u0d15\u0d1a\u0d4d\u0d1a \u0d38\u0d47\u0d35\u0d28 \u0d35\u0d3f\u0d24\u0d30\u0d23\u0d02, \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d23\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d2a\u0d4d\u0d30\u0d3e\u0d2a\u0d4d\u0d24\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.\u0d05\u0d24\u0d3f\u0d28\u0d3e\u0d7d, \u0d38\u0d2e\u0d40\u0d2a\u0d15\u0d3e\u0d32 \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d30\u0d47\u0d16\u0d15\u0d33\u0d41\u0d02 \u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d30\u0d47\u0d16\u0d15\u0d33\u0d41\u0d02 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d41\u0d1f\u0d46 \u0d24\u0d3e\u0d7d\u0d2a\u0d4d\u0d2a\u0d30\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d3e\u0d23\u0d4d."},two:{title:"\u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d32\u0d3f\u0d28\u0d41\u0d02 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d35\u0d47\u0d23\u0d4d\u0d1f\u0d3f \u0d1e\u0d3e\u0d7b \u0d0f\u0d24\u0d4d \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d02?",content:{para_1:{heading_one:"\u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d, \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d30\u0d47\u0d16:",list_1:"(a) \u0d31\u0d47\u0d37\u0d7b \u0d15\u0d3e\u0d7c\u0d21\u0d4d",list_2:"(b) \u0d35\u0d4b\u0d1f\u0d4d\u0d1f\u0d7c \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d15\u0d3e\u0d7c\u0d21\u0d4d ",list_3:"(c) \u0d15\u0d3f\u0d38\u0d3e\u0d7b \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b \u0d2a\u0d3e\u0d38\u0d4d\u0d2c\u0d41\u0d15\u0d4d\u0d15\u0d4d",list_4:"(d) \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d7b \u0d2a\u0d3e\u0d38\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d",list_5:"(e) \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d15\u0d3e\u0d7c\u0d21\u0d4d/\u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d \u0d0e\u0d38\u0d4d\u0d1f\u0d3f/\u0d0e\u0d38\u0d4d\u0d38\u0d3f/\u0d12\u0d2c\u0d3f\u0d38\u0d3f \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b \u0d09\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d35\u0d3e\u0d39 \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d",list_6:"(f) \u0d35\u0d48\u0d15\u0d32\u0d4d\u0d2f\u0d2e\u0d41\u0d33\u0d4d\u0d33\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d15\u0d3e\u0d7c\u0d21\u0d4d/\u0d35\u0d48\u0d15\u0d32\u0d4d\u0d2f \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d",list_7:"(g) \u0d1f\u0d4d\u0d30\u0d3e\u0d7b\u0d38\u0d4d\u0d1c\u0d46\u0d7b\u0d21\u0d7c \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d15\u0d3e\u0d7c\u0d21\u0d4d/\u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d",list_8:"(h) \u0d12\u0d30\u0d41 \u0d32\u0d48\u0d02\u0d17\u0d3f\u0d15\u0d24\u0d4d\u0d24\u0d4a\u0d34\u0d3f\u0d32\u0d3e\u0d33\u0d3f\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d7b\u0d21\u0d47\u0d7c\u0d21\u0d4d \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d \u0d2b\u0d4b\u0d7c\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d7d \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d",list_9:"(i) \u0d05\u0d02\u0d17\u0d40\u0d15\u0d43\u0d24 \u0d05\u0d2d\u0d2f\u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d4b \u0d05\u0d28\u0d3e\u0d25\u0d3e\u0d32\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d4b \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d7b\u0d21\u0d47\u0d7c\u0d21\u0d4d \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d \u0d2b\u0d4b\u0d7c\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d7d \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d",list_10:"(j) \u0d1c\u0d2f\u0d3f\u0d7d \u0d09\u0d26\u0d4d\u0d2f\u0d4b\u0d17\u0d38\u0d4d\u0d25\u0d7b \u0d38\u0d3e\u0d15\u0d4d\u0d37\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d3f \u0d28\u0d7d\u0d15\u0d3f\u0d2f \u0d24\u0d1f\u0d35\u0d41\u0d15\u0d3e\u0d30\u0d28\u0d4d\u0d31\u0d46 \u0d30\u0d47\u0d16"},para_2:{heading_one:"\u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d30\u0d47\u0d16:",list_1:"(a) \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b\u0d2f\u0d4b\u0d1f\u0d41\u0d15\u0d42\u0d1f\u0d3f\u0d2f \u0d38\u0d4d\u0d15\u0d42\u0d7e \u0d32\u0d40\u0d35\u0d3f\u0d02\u0d17\u0d4d \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d/\u0d38\u0d4d\u0d15\u0d42\u0d7e \u0d1f\u0d4d\u0d30\u0d3e\u0d7b\u0d38\u0d4d\u0d2b\u0d7c \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d",list_2:"(b) b. \u0d05\u0d02\u0d17\u0d40\u0d15\u0d43\u0d24 \u0d35\u0d3f\u0d26\u0d4d\u0d2f\u0d3e\u0d2d\u0d4d\u0d2f\u0d3e\u0d38 \u0d2c\u0d4b\u0d7c\u0d21\u0d4b \u0d38\u0d7c\u0d35\u0d4d\u0d35\u0d15\u0d32\u0d3e\u0d36\u0d3e\u0d32\u0d2f\u0d4b \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b \u0d38\u0d39\u0d3f\u0d24\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2e\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d37\u0d40\u0d31\u0d4d\u0d31\u0d4d/\u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d",list_3:"(c) \u0d2a\u0d3e\u0d7b/\u0d07-\u0d2a\u0d3e\u0d7b \u0d15\u0d3e\u0d7c\u0d21\u0d4d",list_4:"(d) \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c/\u0d28\u0d3f\u0d2f\u0d2e\u0d2a\u0d30\u0d2e\u0d3e\u0d2f-\u0d38\u0d4d\u0d25\u0d3e\u0d2a\u0d28\u0d02/\u0d2a\u0d4a\u0d24\u0d41\u0d2e\u0d47\u0d16\u0d32\u0d3e \u0d38\u0d4d\u0d25\u0d3e\u0d2a\u0d28\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d1c\u0d40\u0d35\u0d28\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d7b/\u0d2a\u0d46\u0d7b\u0d37\u0d7b\u0d15\u0d3e\u0d30\u0d7b \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d15\u0d3e\u0d7c\u0d21\u0d4d, \u0d2a\u0d46\u0d7b\u0d37\u0d7b \u0d2a\u0d47\u0d2f\u0d4d\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d13\u0d7c\u0d21\u0d7c \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2e\u0d46\u0d21\u0d3f \u0d15\u0d4d\u0d32\u0d46\u0d2f\u0d3f\u0d02 \u0d15\u0d3e\u0d7c\u0d21\u0d4d",list_5:"(e) \u0d21\u0d4d\u0d30\u0d48\u0d35\u0d3f\u0d02\u0d17\u0d4d \u0d32\u0d48\u0d38\u0d7b\u0d38\u0d4d",list_6:"(f) \u0d38\u0d4d\u0d35\u0d3e\u0d24\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d4d\u0d2f\u0d38\u0d2e\u0d30\u0d38\u0d47\u0d28\u0d3e\u0d28\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d15\u0d3e\u0d7c\u0d21\u0d4d"},para_3:{heading_one:"\u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d30\u0d47\u0d16:",list_1:"(a) \u0d35\u0d48\u0d26\u0d4d\u0d2f\u0d41\u0d24\u0d3f, \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d02, \u0d17\u0d4d\u0d2f\u0d3e\u0d38\u0d4d \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d1f\u0d46\u0d32\u0d3f\u0d2b\u0d4b\u0d7a/\u0d2e\u0d4a\u0d2c\u0d48\u0d7d/\u0d2c\u0d4d\u0d30\u0d4b\u0d21\u0d4d\u0d2c\u0d3e\u0d7b\u0d21\u0d4d \u0d2c\u0d3f\u0d7d (\u0d2e\u0d42\u0d28\u0d4d\u0d28\u0d41 \u0d2e\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d27\u0d3f\u0d15\u0d02 \u0d2a\u0d34\u0d15\u0d4d\u0d15\u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d4d\u0d24\u0d24\u0d4d)",list_2:"(b) \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f\u0d3f \u0d12\u0d2a\u0d4d\u0d2a\u0d3f\u0d1f\u0d4d\u0d1f\u0d4d \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d2e\u0d4d\u0d2a\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b \u0d09\u0d33\u0d4d\u0d33 \u0d37\u0d46\u0d21\u0d4d\u0d2f\u0d42\u0d7e\u0d21\u0d4d \u0d15\u0d4a\u0d2e\u0d47\u0d34\u0d4d\u0d38\u0d4d\u0d2f\u0d7d \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d4d/\u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d13\u0d2b\u0d40\u0d38\u0d4d \u0d2a\u0d3e\u0d38\u0d4d\u0d2c\u0d41\u0d15\u0d4d\u0d15\u0d4d",list_3:"(c) \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f\u0d3f \u0d12\u0d2a\u0d4d\u0d2a\u0d3f\u0d1f\u0d4d\u0d1f\u0d24\u0d41\u0d02 \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d2e\u0d4d\u0d2a\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d24\u0d41\u0d02 \u0d06\u0d2f  \u0d37\u0d46\u0d21\u0d4d\u0d2f\u0d42\u0d7e\u0d21\u0d4d \u0d15\u0d4a\u0d2e\u0d47\u0d34\u0d4d\u0d38\u0d4d\u0d2f\u0d7d \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d4d/\u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d13\u0d2b\u0d40\u0d38\u0d4d \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d/\u0d15\u0d4d\u0d30\u0d46\u0d21\u0d3f\u0d31\u0d4d\u0d31\u0d4d-\u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d2a\u0d4d\u0d30\u0d38\u0d4d\u0d24\u0d3e\u0d35\u0d28 (\u0d2e\u0d42\u0d28\u0d4d\u0d28\u0d4d \u0d2e\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d \u0d2a\u0d34\u0d15\u0d4d\u0d15\u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d4d\u0d24\u0d24\u0d4d)",list_4:"(d) \u0d38\u0d3e\u0d27\u0d41\u0d35\u0d3e\u0d2f \u0d35\u0d3e\u0d1f\u0d15, \u0d2a\u0d3e\u0d1f\u0d4d\u0d1f\u0d02 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d05\u0d35\u0d27\u0d3f & \u0d32\u0d48\u0d38\u0d7b\u0d38\u0d4d \u0d15\u0d30\u0d3e\u0d7c",list_5:"(e) \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d05\u0d02\u0d17\u0d40\u0d15\u0d43\u0d24\u0d2e\u0d3e\u0d2f \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d \u0d2b\u0d4b\u0d7c\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d7d \u0d0e\u0d02\u0d2a\u0d3f, \u0d0e\u0d02\u0d0e\u0d7d\u0d0e, \u0d0e\u0d02\u0d0e\u0d7d\u0d38\u0d3f, \u0d2e\u0d41\u0d28\u0d3f\u0d38\u0d3f\u0d2a\u0d4d\u0d2a\u0d7d \u0d15\u0d57\u0d7a\u0d38\u0d3f\u0d32\u0d7c, \u0d17\u0d4d\u0d30\u0d42\u0d2a\u0d4d\u0d2a\u0d4d '\u0d0e' \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d '\u0d2c\u0d3f' ,\u0d17\u0d38\u0d31\u0d4d\u0d31\u0d21\u0d4d \u0d13\u0d2b\u0d40\u0d38\u0d7c, \u0d07\u0d2a\u0d3f\u0d0e\u0d2b\u0d4d\u0d12 \u0d13\u0d2b\u0d40\u0d38\u0d7c \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d24\u0d39\u0d38\u0d3f\u0d7d\u0d26\u0d3e\u0d7c \u0d28\u0d7d\u0d15\u0d3f\u0d2f \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d",list_6:"(f) \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d05\u0d02\u0d17\u0d40\u0d15\u0d43\u0d24\u0d2e\u0d3e\u0d2f \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d \u0d2b\u0d4b\u0d7c\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d7d \u0d17\u0d4d\u0d30\u0d3e\u0d2e \u0d2a\u0d1e\u0d4d\u0d1a\u0d3e\u0d2f\u0d24\u0d4d\u0d24\u0d4d \u0d39\u0d46\u0d21\u0d4d/\u0d38\u0d46\u0d15\u0d4d\u0d30\u0d1f\u0d4d\u0d1f\u0d31\u0d3f, \u0d35\u0d3f\u0d32\u0d4d\u0d32\u0d47\u0d1c\u0d4d \u0d31\u0d35\u0d28\u0d4d\u0d2f\u0d42 \u0d13\u0d2b\u0d40\u0d38\u0d7c \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d24\u0d24\u0d4d\u0d24\u0d41\u0d32\u0d4d\u0d2f\u0d02 (\u0d17\u0d4d\u0d30\u0d3e\u0d2e\u0d40\u0d23 \u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d) \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d",list_7:"(g) \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d05\u0d02\u0d17\u0d40\u0d15\u0d43\u0d24\u0d2e\u0d3e\u0d2f \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d \u0d2b\u0d4b\u0d7c\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d7d \u0d12\u0d30\u0d41 \u0d35\u0d3f\u0d26\u0d4d\u0d2f\u0d3e\u0d7c\u0d24\u0d4d\u0d25\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d05\u0d02\u0d17\u0d40\u0d15\u0d43\u0d24 \u0d35\u0d3f\u0d26\u0d4d\u0d2f\u0d3e\u0d2d\u0d4d\u0d2f\u0d3e\u0d38 \u0d38\u0d4d\u0d25\u0d3e\u0d2a\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d46 \u0d2a\u0d4d\u0d30\u0d27\u0d3e\u0d28\u0d3e\u0d26\u0d4d\u0d27\u0d4d\u0d2f\u0d3e\u0d2a\u0d15\u0d28\u0d4d \u0d28\u0d7d\u0d15\u0d3f\u0d2f \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d",list_8:"(h) \u0d35\u0d38\u0d4d\u0d24\u0d41 \u0d28\u0d3f\u0d15\u0d41\u0d24\u0d3f \u0d30\u0d38\u0d40\u0d24\u0d4d (\u0d12\u0d30\u0d41 \u0d35\u0d7c\u0d37\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d \u0d2a\u0d34\u0d15\u0d4d\u0d15\u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d4d\u0d24\u0d24\u0d4d)",list_9:"(i) \u0d38\u0d3e\u0d27\u0d41\u0d35\u0d3e\u0d2f \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d35\u0d3f\u0d7d\u0d2a\u0d4d\u0d2a\u0d28 \u0d15\u0d30\u0d3e\u0d7c \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d07\u0d37\u0d4d\u0d1f\u0d26\u0d3e\u0d28\u0d02 \u0d28\u0d32\u0d4d\u0d15\u0d3f\u0d2f\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d28\u0d3f\u0d2f\u0d2e\u0d2a\u0d30\u0d2e\u0d3e\u0d2f \u0d06\u0d27\u0d3e\u0d30\u0d02.",list_10:"(j) \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d7c/\u0d28\u0d3f\u0d2f\u0d2e\u0d2a\u0d30\u0d2e\u0d3e\u0d2f \u0d2c\u0d4b\u0d21\u0d3f/ \u0d2a\u0d4a\u0d24\u0d41\u0d2e\u0d47\u0d16\u0d32\u0d3e \u0d38\u0d4d\u0d25\u0d3e\u0d2a\u0d28\u0d02 \u0d28\u0d7d\u0d15\u0d3f\u0d2f \u0d24\u0d3e\u0d2e\u0d38\u0d38\u0d57\u0d15\u0d30\u0d4d\u0d2f \u0d05\u0d32\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d15\u0d24\u0d4d\u0d24\u0d4d (\u0d12\u0d30\u0d41 \u0d35\u0d7c\u0d37\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d \u0d2a\u0d34\u0d15\u0d4d\u0d15\u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d4d\u0d24\u0d24\u0d4d)",list_11:"(k) \u0d32\u0d48\u0d2b\u0d4d \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2e\u0d46\u0d21\u0d3f\u0d15\u0d4d\u0d15\u0d7d \u0d07\u0d7b\u0d37\u0d41\u0d31\u0d7b\u0d38\u0d4d \u0d2a\u0d4b\u0d33\u0d3f\u0d38\u0d3f (\u0d12\u0d30\u0d41 \u0d35\u0d7c\u0d37\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d \u0d2a\u0d34\u0d15\u0d4d\u0d15\u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d4d\u0d24\u0d24\u0d4d)"}}},three:{title:"\u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02?",content:"\u0d30\u0d47\u0d16\u0d15\u0d7e \u0d2e\u0d48 \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d32\u0d3f\u0d7d (https://myaadhaar.uidai.gov.in/) \u0d13\u0d7a\u0d32\u0d48\u0d28\u0d3e\u0d2f\u0d3f \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02.\u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d0f\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02."},four:{title:"\u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d13\u0d7a\u0d32\u0d48\u0d28\u0d3e\u0d2f\u0d3f \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02?",content:{list_1:"(1) https://myaadhaar.uidai.gov.in/ \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d4b\u0d2f\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d41\u0d02 \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7d \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12 \u0d1f\u0d3f \u0d2a\u0d3f\u0d2f\u0d41\u0d02  \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d32\u0d4b\u0d17\u0d3f\u0d7b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.",list_2:"(2) \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d32\u0d3f\u0d7d \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3