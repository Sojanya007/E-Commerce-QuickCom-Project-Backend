644\u0648\u0645\u0627\u062a \u0630\u062e\u06cc\u0631\u06c1 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u0631\u06c1\u06cc \u06c1\u06d2\u06d4",noRecordsAvailable:"\u06a9\u0648\u0626\u06cc \u0631\u06cc\u06a9\u0627\u0631\u0688 \u062f\u0633\u062a\u06cc\u0627\u0628 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4",checkWithBank:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u067e\u0646\u06d2 \u0628\u06cc\u0646\u06a9 \u0633\u06d2 \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u06a9\u0627 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0627\u067e\u0646\u06d2 \u0628\u06cc\u0646\u06a9 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0633\u06d2 \u0645\u0646\u0633\u0644\u06a9 \u06c1\u06d2\u06d4"},bankSeedingStatus:{AadhaarNumber:"\u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631",BankName:"\u0628\u06cc\u0646\u06a9 \u06a9\u0627 \u0646\u0627\u0645",BankSeedingStatus:"\u0628\u06cc\u0646\u06a9 \u0633\u06cc\u0688\u0646\u06af \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a",LastUpdatedDate:"\u0622\u062e\u0631\u06cc \u062a\u0627\u0632\u06c1 \u06a9\u0627\u0631\u06cc \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e",noRecordAlert:"\u0627\u067e\u0646\u0627 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0627\u067e\u0646\u06d2 \u0628\u06cc\u0646\u06a9 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0633\u06d2 \u0644\u0646\u06a9 \u06a9\u0631\u0648\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u067e\u0646\u06d2 \u0628\u06cc\u0646\u06a9 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4",note:"\u0644\u0646\u06a9 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062f\u06c1 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0646\u06cc\u0634\u0646\u0644 \u067e\u06cc\u0645\u0646\u0679 \u06a9\u0627\u0631\u067e\u0648\u0631\u06cc\u0634\u0646 \u0622\u0641 \u0627\u0646\u0688\u06cc\u0627 (\u0627\u06cc\u0646 \u067e\u06cc \u0633\u06cc \u0622\u0626\u06cc) \u06a9\u06d2 \u0633\u0631\u0648\u0631 \u0633\u06d2 \u062d\u0627\u0635\u0644 \u06a9\u06cc \u06af\u0626\u06cc \u06c1\u06cc\u06ba\u06d4 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0627\u0633 \u06a9\u06cc \u062f\u0631\u0633\u062a\u06af\u06cc \u06a9\u06cc \u0630\u0645\u06c1 \u062f\u0627\u0631 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4 \u062d\u0627\u0635\u0644 \u06a9\u0631\u062f\u06c1 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0622\u0626\u06cc \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 \u0645\u062d\u0641\u0648\u0638 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06cc\u06ba ",ActiveText:"\u0641\u0639\u0627\u0644",InactiveText:"\u063a\u06cc\u0631 \u0641\u0639\u0627\u0644"},FAQ:{checkAadhaarPvcCardOrderStatus:[{question:"\u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc \u0645\u062e\u062a\u0644\u0641 \u0634\u06a9\u0644\u06cc\u06ba \u06a9\u06cc\u0627 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0627\u0646 \u06a9\u06cc \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u06a9\u06cc\u0627 \u06c1\u06cc\u06ba\u061f",answer:"\u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc \u0645\u062e\u062a\u0644\u0641 \u0634\u06a9\u0644\u06cc\u06ba \u0622\u062f\u06be\u0627\u0631 \u0644\u06cc\u0679\u0631\u060c \u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688\u060c \u0627\u06cc \u0622\u062f\u06be\u0627\u0631 \u0627\u0648\u0631 \u0627\u06cc\u0645 \u0622\u062f\u06be\u0627\u0631 \u06c1\u06cc\u06ba\u06d4 \u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc \u062a\u0645\u0627\u0645 \u0634\u06a9\u0644\u06cc\u06ba \u06cc\u06a9\u0633\u0627\u06ba \u0637\u0648\u0631 \u067e\u0631 \u062f\u0631\u0633\u062a \u0627\u0648\u0631 \u0642\u0627\u0628\u0644 \u0642\u0628\u0648\u0644 \u06c1\u06cc\u06ba\u06d4"},{question:"\u06a9\u06cc\u0627 \u0645\u06cc\u06ba \u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0634\u06a9\u0644 \u06a9\u0648 \u0631\u06a9\u06be\u0646\u06d2 \u0627\u0648\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",answer:"\u062c\u06cc \u06c1\u0627\u06ba"},{question:"\u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688 \u0622\u0631\u0688\u0631 \u06a9\u0631\u06cc\u06ba \u0633\u0631\u0648\u0633 \u06a9\u06cc\u0627 \u06c1\u06d2\u061f",answer:"\u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688 \u0622\u0631\u0688\u0631 \u06a9\u0631\u06cc\u06ba \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06cc \u0637\u0631\u0641 \u0633\u06d2 \u0634\u0631\u0648\u0639 \u06a9\u06cc \u06af\u0626\u06cc \u0627\u06cc\u06a9 \u0622\u0646 \u0644\u0627\u0626\u0646 \u0633\u0631\u0648\u0633 \u06c1\u06d2 \u062c\u0648 \u0622\u062f\u06be\u0627\u0631 \u06c1\u0648\u0644\u0688\u0631 \u06a9\u0648 \u0645\u0639\u0645\u0648\u0644\u06cc \u0686\u0627\u0631\u062c\u0632 \u0627\u062f\u0627 \u06a9\u0631\u06a9\u06d2 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688 \u067e\u0631 \u0627\u067e\u0646\u06d2 \u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u067e\u0631\u0646\u0679 \u06a9\u0631\u0648\u0627\u0646\u06d2 \u0645\u06cc\u06ba \u0633\u06c1\u0648\u0644\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u06cc \u06c1\u06d2\u06d4"},{question:"\u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688 \u06a9\u06cc \u062d\u0641\u0627\u0638\u062a\u06cc \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u06a9\u06cc\u0627 \u06c1\u06cc\u06ba\u061f",answer:"\u0627\u0633 \u06a9\u0627\u0631\u0688 \u0645\u06cc\u06ba \u062d\u0641\u0627\u0638\u062a\u06cc \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u0634\u0627\u0645\u0644 \u06c1\u06cc\u06ba \u062c\u06cc\u0633\u06d2:\r\n1. \u0686\u06be\u06cc\u0691 \u0686\u06be\u0627\u0691 \u06a9\u0627 QR \u06a9\u0648\u0688\n2.\u06c1\u0648\u0644\u0648\u06af\u0631\u0627\u0645\n3. \u0645\u0627\u0626\u06cc\u06a9\u0631\u0648 \u0679\u06cc\u06a9\u0633\u0679\n4. \u0628\u06be\u0648\u062a \u06a9\u06cc \u062a\u0635\u0648\u06cc\u0631\n5. \u0627\u06cc\u0634\u0648 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e \u0627\u0648\u0631 \u067e\u0631\u0646\u0679 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e\n6.\u06af\u06cc\u0644\u0648\u0686\u06d2\u067e\u06cc\u0679\u0631\u0646\n7. \u0627\u0628\u06be\u0631\u0627 \u06c1\u0648\u0627 \u0622\u062f\u06be\u0627\u0631 \u0644\u0648\u06af\u0648"},{question:"\u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u06cc\u0627 \u0686\u0627\u0631\u062c\u0632 \u0627\u062f\u0627 \u06a9\u06cc\u06d2 \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u061f",answer:"\u0627\u062f\u0627 \u06a9\u06cc\u06d2 \u062c\u0627\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0686\u0627\u0631\u062c\u0632 50/- \u0631\u0648\u067e\u06d2 \u06c1\u06cc\u06ba (\u0628\u0634\u0645\u0648\u0644 \u062c\u06cc \u0627\u06cc\u0633 \u0679\u06cc \u0627\u0648\u0631 \u0633\u067e\u06cc\u0688 \u067e\u0648\u0633\u0679 \u0686\u0627\u0631\u062c\u0632)\u06d4"},{question:"\u06a9\u0648\u0626\u06cc \u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06cc\u0633\u06d2 \u0627\u0679\u06be\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u061f",answer:"\u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688' \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06cc \u0622\u0641\u06cc\u0634\u0644 \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 (https://www.uidai.gov.in \u06cc\u0627 https://myaadhaar.uidai.gov.in) \u06cc\u0627 mAadhaar \u0627\u06cc\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u067e\u0631 \u062c\u0627 \u06a9\u0631 \u06a9\u06cc \u062c\u0627 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u06d4"},{question:"\u0631\u062c\u0633\u0679\u0631\u0688 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06cc\u0633\u06d2 \u062c\u0645\u0639 \u06a9\u06cc \u062c\u0627\u0626\u06d2\u061f",answer:"1.\u0645\u0644\u0627\u062d\u0638\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4 https://myaadhaar.uidai.gov.in/genricPVC \u06cc\u0627 https://uidai.gov.in \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645.\n2. \u0627\u067e\u0646\u0627 12 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 (\u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc) \u06cc\u0627 28 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 \u0627\u0646\u062f\u0631\u0627\u062c \u0645\u06cc\u06ba \u0688\u06cc \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4\n3. \u0633\u06cc\u06a9\u0648\u0631\u0679\u06cc \u06a9\u0648\u0688 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4\n4. \u0631\u062c\u0633\u0679\u0631\u0688 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u067e\u0631 \u0645\u0648\u0635\u0648\u0644\u06c1 OTP \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4\n5. '\u0634\u0631\u0627\u0626\u0637 \u0648 \u0636\u0648\u0627\u0628\u0637' \u06a9\u06d2 \u062e\u0644\u0627\u0641 \u0686\u06cc\u06a9 \u0628\u0627\u06a9\u0633 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 (\u0646\u0648\u0679: \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u062f\u06cc\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u0627\u0626\u067e\u0631 \u0644\u0646\u06a9 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba)\u06d4\n6. OTP \u062a\u0635\u062f\u06cc\u0642 \u0645\u06a9\u0645\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 '\u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0626\u06cc\u06ba' \u0628\u0679\u0646 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4\n7. \u0627\u06af\u0644\u06cc \u0627\u0633\u06a9\u0631\u06cc\u0646 \u067e\u0631\u060c \u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06a9\u0627 \u067e\u06cc\u0634 \u0646\u0638\u0627\u0631\u06c1 \u062f\u0648\u0628\u0627\u0631\u06c1 \u067e\u0631\u0646\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u0631\u0688\u0631 \u062f\u06cc\u0646\u06d2 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0631\u06c1\u0627\u0626\u0634\u06cc \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0638\u0627\u06c1\u0631 \u06c1\u0648\u06af\u0627\u06d4\n8. '\u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0631\u06cc\u06ba' \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 \u0622\u067e \u06a9\u0648 \u06a9\u0631\u06cc\u0688\u0679/\u0688\u06cc\u0628\u0679 \u06a9\u0627\u0631\u0688\u060c \u0646\u06cc\u0679 \u0628\u06cc\u0646\u06a9\u0646\u06af \u0627\u0648\u0631 UPI \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06d2 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06d2 \u06af\u06cc\u0679 \u0648\u06d2 \u06a9\u06d2 \u0635\u0641\u062d\u06c1 \u067e\u0631 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0628\u06be\u06cc\u062c \u062f\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4\n9. \u06a9\u0627\u0645\u06cc\u0627\u0628 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06d2 \u0628\u0639\u062f\u060c \u0688\u06cc\u062c\u06cc\u0679\u0644 \u062f\u0633\u062a\u062e\u0637 \u0648\u0627\u0644\u06cc \u0631\u0633\u06cc\u062f \u062a\u06cc\u0627\u0631 \u06a9\u06cc \u062c\u0627\u0626\u06d2 \u06af\u06cc \u062c\u0633\u06d2 \u0631\u06c1\u0627\u0626\u0634\u06cc \u067e\u06cc \u0688\u06cc \u0627\u06cc\u0641 \u0641\u0627\u0631\u0645\u06cc\u0679 \u0645\u06cc\u06ba \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0631\u06c1\u0627\u0626\u0634\u06cc \u06a9\u0648 \u0627\u06cc\u0633 \u0627\u06cc\u0645 \u0627\u06cc\u0633 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0633\u0631\u0648\u0633 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0646\u0645\u0628\u0631 \u0628\u06be\u06cc \u0645\u0644\u06d2 \u06af\u0627\u06d4\n10. \u0622\u062f\u06be\u0627\u0631 \u06c1\u0648\u0644\u0688\u0631 \u0622\u062f\u06be\u0627\u0631 \u06a9\u0627\u0631\u0688 \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a \u0686\u06cc\u06a9 \u06a9\u0631\u0646\u06d2 \u067e\u0631 \u0622\u062f\u06be\u0627\u0631 \u06a9\u0627\u0631\u0688 \u06a9\u06cc \u062a\u0631\u0633\u06cc\u0644 \u062a\u06a9 SRN \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a \u06a9\u0627 \u067e\u062a\u06c1 \u0644\u06af\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4\n11. DoP \u0633\u06d2 \u0628\u06be\u06cc\u062c\u06d2 \u062c\u0627\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f AWB \u0646\u0645\u0628\u0631 \u067e\u0631 \u0645\u0634\u062a\u0645\u0644 SMS \u0628\u06be\u06cc \u0628\u06be\u06cc\u062c\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u0622\u062f\u06be\u0627\u0631 \u06c1\u0648\u0644\u0688\u0631 \u0688\u06cc \u0627\u0648 \u067e\u06cc \u06a9\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 \u067e\u0631 \u062c\u0627 \u06a9\u0631 \u0688\u06cc\u0644\u06cc\u0648\u0631\u06cc \u06a9\u06cc \u0635\u0648\u0631\u062a\u062d\u0627\u0644 \u06a9\u0648 \u0645\u0632\u06cc\u062f \u0679\u0631\u06cc\u06a9 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4"},{question:"\u063a\u06cc\u0631 \u0631\u062c\u0633\u0679\u0631\u0688/\u0645\u062a\u0628\u0627\u062f\u0644 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06cc\u0633\u06d2 \u062c\u0645\u0639 \u06a9\u06cc \u062c\u0627\u0626\u06d2\u061f",answer:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 https://uidai.gov.in \u06cc\u0627 https://myaadhaar.uidai.gov.in/genricPVC \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba '\u0622\u062f\u06be\u0627\u0631 \u06a9\u0627\u0631\u0688 \u0622\u0631\u0688\u0631 \u06a9\u0631\u06cc\u06ba' \u0633\u0631\u0648\u0633 \u06cc\u0627 mAadhaar \u0627\u06cc\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba \u0627\u067e\u0646\u0627 12 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 (UID) \u06cc\u0627 28 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 \u0627\u0646\u062f\u0631\u0627\u062c \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4 \u0622\u0626\u06cc \u0688\u06cc \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba \u0686\u06cc\u06a9 \u0628\u0627\u06a9\u0633 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba '\u0627\u06af\u0631 \u0622\u067e \u06a9\u06d2 \u067e\u0627\u0633 \u0631\u062c\u0633\u0679\u0631\u0688 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u063a\u06cc\u0631 \u0631\u062c\u0633\u0679\u0631\u0688 / \u0645\u062a\u0628\u0627\u062f\u0644 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba \u062c\u0648 \u063a\u06cc\u0631 \u0631\u062c\u0633\u0679\u0631\u0688 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2 \u0622\u0631\u0688\u0631 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0633\u062a\u06cc\u0627\u0628 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u06ba \u06af\u06d2\u06d4 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u0622\u0631\u0688\u0631 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0628\u0627\u0642\u06cc \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u0648\u06c1\u06cc \u06c1\u06cc\u06ba\u06d4"},{question:"\u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0648\u0646 \u0633\u06d2 \u0637\u0631\u06cc\u0642\u06d2 \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u06cc\u06ba\u061f",answer:"\u0641\u06cc \u0627\u0644\u062d\u0627\u0644\u060c \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u062c \u0630\u06cc\u0644 \u0622\u0646 \u0644\u0627\u0626\u0646 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06d2 \u0637\u0631\u06cc\u0642\u06d2 \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u06cc\u06ba:-                                                                            \u06a9\u0631\u06cc\u0688\u0679 \u06a9\u0627\u0631\u0688                                                                                                                                                                                      \u0688\u06cc\u0628\u0679 \u06a9\u0627\u0631\u0688                                                                                                                                                                                        \u0646\u06cc\u0679 \u0628\u06cc\u0646\u06a9\u0646\u06af                                                                                                                                                                                    \u06cc\u0648 \u067e\u06cc \u0622\u0626\u06cc                                                                                                                                                                                          \u067e\u06d2 \u0679\u06cc \u0627\u06cc\u0645"},{question:"\u0627\u06cc\u0633 \u0622\u0631 \u0627\u06cc\u0646  \u06a9\u06cc\u0627 \u06c1\u06d2\u061f",answer:"\u0627\u06cc\u0633 \u0622\u0631 \u0627\u06cc\u0646 14 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 \u0633\u0631\u0648\u0633 \u0631\u06cc\u06a9\u0648\u0626\u0633\u0679 \u0646\u0645\u0628\u0631 \u06c1\u06d2 \u062c\u0648 \u0622\u062f\u06be\u0627\u0631 \u0627\u067e\u0688\u06cc\u0679 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f \u062a\u06cc\u0627\u0631 \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u06d4 \u062c\u0628 \u0622\u067e \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0646\u0627 \u0634\u0631\u0648\u0639 \u06a9\u0631 \u062f\u06cc\u06ba \u06af\u06d2 \u062a\u0648 \u06cc\u06c1 \u062a\u06cc\u0627\u0631 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u0644\u06cc\u0646 \u062f\u06cc\u0646 \u06a9\u06d2 \u0645\u06a9\u0645\u0644 \u06c1\u0648\u0646\u06d2 \u062a\u06a9 '\u0631\u06cc\u0632\u06cc\u0648\u0645' \u06a9\u0627 \u0622\u067e\u0634\u0646 \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u0648\u06af\u0627\u06d4"},{question:"\u0627\u06d2 \u0688\u0628\u0644\u06cc\u0648 \u0628\u06cc  \u0646\u0645\u0628\u0631 \u06a9\u06cc\u0627 \u06c1\u06d2\u061f",answer:"\u0627\u06cc\u0626\u0631 \u0648\u06d2 \u0628\u0644 \u0646\u0645\u0628\u0631 \u0648\u06c1 \u0679\u0631\u06cc\u06a9\u0646\u06af \u0646\u0645\u0628\u0631 \u06c1\u06d2 \u062c\u0648 \u0688\u06cc \u0627\u0648 \u067e\u06cc \u06cc\u0639\u0646\u06cc \u0627\u0646\u0688\u06cc\u0627 \u0627\u0633\u067e\u06cc\u0688 \u067e\u0648\u0633\u0679 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u0633\u0627\u0626\u0646\u0645\u0646\u0679/\u067e\u0631\u0648\u0688\u06a9\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062a\u06cc\u0627\u0631 \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u062c\u0633\u06d2 \u0648\u06c1 \u0688\u06cc\u0644\u06cc\u0648\u0631 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"},{question:"\u06a9\u06cc\u0627 \u06c1\u0648\u06af\u0627 \u0627\u06af\u0631 \u0631\u06c1\u0627\u0626\u0634\u06cc \u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688 \u06a9\u0648 \u0627\u0646 \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06a9\u06d2 \u0633\u0627\u062a\u06be \u067e\u0631\u0646\u0679 \u06a9\u0631\u0648\u0627\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0648 \u0648\u06c1 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u061f",answer:"\u0627\u06af\u0631 \u0631\u06c1\u0627\u0626\u0634\u06cc \u067e\u0631\u0646\u0679 \u0634\u062f\u06c1 \u0622\u062f\u06be\u0627\u0631 \u0644\u06cc\u0679\u0631 \u06cc\u0627 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0645\u06cc\u06ba \u06a9\u0686\u06be \u062a\u0628\u062f\u06cc\u0644\u06cc\u0627\u06ba \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u0627\u0646\u06c1\u06cc\u06ba \u067e\u06c1\u0644\u06d2 \u067e\u0631\u0645\u0646\u0646\u0679 \u0627\u0646\u0631\u0648\u0644\u0645\u0646\u0679 \u0633\u06cc\u0646\u0679\u0631 \u06cc\u0627 \u0627\u06cc\u0633 \u0627\u06cc\u0633 \u06cc\u0648 \u067e\u06cc \u067e\u0648\u0631\u0679\u0644 \u067e\u0631 \u062c\u0627 \u06a9\u0631 \u0627\u067e\u0646\u0627 \u0622\u062f\u06be\u0627\u0631 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u0627 \u06c1\u0648\u06af\u0627 (\u0627\u067e \u0688\u06cc\u0679 \u067e\u0631 \u0645\u0646\u062d\u0635\u0631 \u06c1\u06d2) \u0627\u0648\u0631 \u067e\u06be\u0631 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0627\u0679\u06be\u0627\u0646\u06cc \u06c1\u0648\u06af\u06cc \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u0627\u0633 \u0633\u06c1\u0648\u0644\u062a \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688/\u062e\u0637 \u06a9\u06cc \u06c1\u0627\u0631\u0688 \u06a9\u0627\u067e\u06cc \u062d\u0627\u0635\u0644 \u06a9\u0631\u06cc\u06ba\u06d4"},{question:"\u06a9\u0627\u0645\u06cc\u0627\u0628 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0628\u0646\u0627\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f '\u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688' \u062d\u0627\u0635\u0644 \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u06a9\u062a\u0646\u06d2 \u062f\u0646 \u0644\u06af\u06cc\u06ba \u06af\u06d2\u061f",answer:"\u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06c1\u0648\u0644\u0688\u0631 \u0633\u06d2 \u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688 \u06a9\u0627 \u0622\u0631\u0688\u0631 \u0645\u0644\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f\u060c \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u067e\u0631\u0646\u0679 \u0634\u062f\u06c1 \u0622\u062f\u06be\u0627\u0631 \u06a9\u0627\u0631\u0688 \u0688\u06cc \u0627\u0648 \u067e\u06cc \u06a9\u0648 5 \u06a9\u0627\u0645 \u06a9\u06d2 \u062f\u0646\u0648\u06ba \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u062f\u06d2 \u062f\u06cc\u062a\u0627 \u06c1\u06d2 (\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e \u06a9\u0648 \u0686\u06be\u0648\u0691 \u06a9\u0631)\u06d4 \u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688 \u06a9\u06cc \u0688\u06cc\u0644\u06cc\u0648\u0631\u06cc \u0627\u0633\u067e\u06cc\u0688 \u067e\u0648\u0633\u0679 \u0633\u0631\u0648\u0633 \u0622\u0641 \u0627\u0646\u0688\u06cc\u0627 \u067e\u0648\u0633\u0679 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0688\u06cc\u0679\u0627 \u0628\u06cc\u0633 \u0645\u06cc\u06ba \u0631\u062c\u0633\u0679\u0631\u0688 \u067e\u062a\u06d2 \u067e\u0631 \u0645\u0648\u062c\u0648\u062f\u06c1 \u0688\u06cc\u0644\u06cc\u0648\u0631\u06cc \u0627\u0635\u0648\u0644\u0648\u06ba \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u06a9\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06d2\u06d4 \u0627\u06cc\u06a9 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u0627 https://www.indiapost.gov.in/_layouts/15/dop.portal.track \u067e\u0631 DoP \u0679\u0631\u06cc\u06a9\u0646\u06af \u0633\u0631\u0648\u0633\u0632 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2 \u0688\u06cc\u0644\u06cc\u0648\u0631\u06cc \u06a9\u06cc \u0635\u0648\u0631\u062a\u062d\u0627\u0644 \u06a9\u0627 \u067e\u062a\u06c1 \u0644\u06af\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4"}],verifyEmailMobile:[{question:"\u06a9\u06cc\u0627 \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06a9\u06cc \u0622\u0646 \u0644\u0627\u0626\u0646 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0648\u0626\u06cc \u0641\u06cc\u0633 \u0634\u0627\u0645\u0644 \u06c1\u06d2\u061f",answer:"\u06c1\u0627\u06ba\u060c \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06cc \u0622\u0646 \u0644\u0627\u0626\u0646 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u067e \u06a9\u0648 \u0631\u0648\u067e\u06d2 \u0627\u062f\u0627 \u06a9\u0631\u0646\u06d2 \u06c1\u0648\u06ba \u06af\u06d2\u06d4 50/- (\u062c\u06cc \u0627\u06cc\u0633 \u0679\u06cc \u0633\u0645\u06cc\u062a)\u06d4"}],orderAadhaarPvcCard:[{question:"\u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u0627 \u0627\u06cc \u0622\u062f\u06be\u0627\u0631 \u06a9\u0648 \u06a9\u06c1\u0627\u06ba \u0633\u06d2 \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u061f",answer:"\u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u0627 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06d2 \u0645\u06cc\u0631\u0627 \u0622\u062f\u06be\u0627\u0631 \u067e\u0648\u0631\u0679\u0627- https://myaadhaar.uidai.gov.in \u067e\u0631 \u062c\u0627\u06a9\u0631 \u06cc\u0627 \u0645\u0648\u0628\u0627\u0626\u0644 \u0641\u0648\u0646 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u0645 \u0622\u062f\u06be\u0627\u0631 \u0627\u06cc\u067e \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06a9\u06d2 \u0627\u06cc-\u0622\u062f\u06be\u0627\u0631 \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631\u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4"}],retrieveEidAadhaarNumber:[{question:"\u0622\u062f\u06be\u0627\u0631 \u0688\u06cc\u0679\u0627 \u06a9\u0648 \u06a9\u062a\u0646\u06cc \u0628\u0627\u0631 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u061f",answer:"\u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06cc \u062a\u0627\u0632\u06c1 \u06a9\u0627\u0631\u06cc \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u062c \u0630\u06cc\u0644 \u062d\u062f\u0648\u062f \u0644\u0627\u06af\u0648 \u06c1\u06cc\u06ba:                                                                                \u2022 \u0646\u0627\u0645: \u0632\u0646\u062f\u06af\u06cc \u0645\u06cc\u06ba \u062f\u0648 \u0628\u0627\u0631                                                                                                                                        \u2022 \u062c\u0646\u0633: \u0632\u0646\u062f\u06af\u06cc \u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u0628\u0627\u0631                                                                                                                                   \u2022 \u062a\u0627\u0631\u06cc\u062e \u067e\u06cc\u062f\u0627\u0626\u0634: \u0632\u0646\u062f\u06af\u06cc \u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u0628\u0627\u0631"},{question:"\u0645\u06cc\u06ba \u0622\u062f\u06be\u0627\u0631 \u0645\u06cc\u06ba \u0627\u067e\u0646\u06d2 \u0646\u0627\u0645 \u0645\u06cc\u06ba \u06a9\u06cc\u0627 \u062a\u0628\u062f\u06cc\u0644\u06cc \u0644\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",answer:"\u0627\u067e\u0646\u06d2 \u0646\u0627\u0645 \u0645\u06cc\u06ba \u0645\u0639\u0645\u0648\u0644\u06cc \u062a\u0635\u062d\u06cc\u062d \u06cc\u0627 \u0646\u0627\u0645 \u0645\u06cc\u06ba \u062a\u0628\u062f\u06cc\u0644\u06cc \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0628\u0631\u0627\u0626\u06d2 \u0645\u06c1\u0631\u0628\u0627\u0646\u06cc \u0642\u0631\u06cc\u0628\u06cc \u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba\u06d4"},{question:"\u0622\u0646 \u0644\u0627\u0626\u0646 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0646 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u06d2\u061f",answer:"\u0645\u0639\u0627\u0648\u0646 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u06cc \u0641\u06c1\u0631\u0633\u062a \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u067e\u06cc \u0627\u0648 \u0627\u06d2 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u0648\u06af\u06cc\u06d4 https://uidai.gov.in \u0645\u0644\u0627\u062d\u0638\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4"},{question:"\u0622\u062f\u06be\u0627\u0631 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0645\u06cc\u06ba \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0648\u0646 \u0633\u06d2 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062f\u0631\u06a9\u0627\u0631 \u06c1\u06cc\u06ba\u061f",answer:"\u0645\u0639\u0627\u0648\u0646 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u06cc \u0641\u06c1\u0631\u0633\u062a \u062c\u0646\u06c1\u06cc\u06ba \u0622\u067e \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u06cc\u06c1\u0627\u06ba \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u06d2\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0641\u06c1\u0631\u0633\u062a \u0633\u06d2 \u0645\u0646\u0627\u0633\u0628 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u0688\u06cc\u0645\u0648\u06af\u0631\u0627\u0641\u06a9 \u0688\u06cc\u0679\u0627 \u06a9\u06cc \u0627\u0635\u0644\u0627\u062d \u06a9\u0631\u062a\u06d2 \u0648\u0642\u062a \u0627\u0633 \u06a9\u06cc \u0627\u0633\u06a9\u06cc\u0646/\u062a\u0635\u0648\u06cc\u0631 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u06cc\u06ba\u06d4"},{question:"\u0627\u06cc\u0688\u0631\u06cc\u0633 \u0627\u067e \u0688\u06cc\u0679 \u0622\u0646 \u0644\u0627\u0626\u0646 \u0633\u0631\u0648\u0633 \u06a9\u06cc \u0635\u0648\u0631\u062a \u0645\u06cc\u06ba \u0645\u06cc\u06ba \u0627\u067e\u0646\u06d2 \u0645\u0639\u0627\u0648\u0646 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u06cc\u0633\u06d2 \u062c\u0645\u0639 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",answer:"\u0622\u067e \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0622\u0646 \u0644\u0627\u0626\u0646 \u0633\u0631\u0648\u0633 \u0645\u06cc\u06ba \u067e\u06cc \u0688\u06cc \u0627\u06cc\u0641 \u06cc\u0627 \u062c\u06d2 \u067e\u06cc \u0627\u06cc \u062c\u06cc \u0641\u0627\u0631\u0645\u06cc\u0679 \u0645\u06cc\u06ba \u0645\u0639\u0627\u0648\u0646 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u06cc \u0627\u0633\u06a9\u06cc\u0646/\u062a\u0635\u0648\u06cc\u0631 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u06c1\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u067e\u0646\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u067e\u0631 \u06a9\u0627\u0631\u0631\u0648\u0627\u0626\u06cc \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u0633\u062a \u0645\u0639\u0627\u0648\u0646 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba\u06d4 \u06a9\u0686\u06be \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062c\u06cc\u0633\u06d2 \u067e\u0627\u0633\u067e\u0648\u0631\u0679\u060c \u06a9\u0631\u0627\u06cc\u06c1 \u0627\u0648\u0631 \u062c\u0627\u0626\u06cc\u062f\u0627\u062f \u06a9\u06d2 \u0645\u0639\u0627\u06c1\u062f\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u062a\u0639\u062f\u062f \u0635\u0641\u062d\u0627\u062a \u06a9\u06cc \u062a\u0635\u0648\u06cc\u0631 \u062f\u0631\u06a9\u0627\u0631 \u06c1\u0648\u06af\u06cc\u06d4"},{question:"\u06a9\u06cc\u0627 \u0645\u06cc\u06ba \u0627\u067e\u0646\u06cc \u0645\u0642\u0627\u0645\u06cc \u0632\u0628\u0627\u0646 \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u0622\u062f\u06be\u0627\u0631 \u0622\u0646 \u0644\u0627\u0626\u0646 \u0633\u0631\u0648\u0633 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",answer:"\u0641\u06cc \u0627\u0644\u062d\u0627\u0644 \u0622\u067e \u0622\u0646 \u0644\u0627\u0626\u0646 \u067e\u0648\u0631\u0679\u0644 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u067e\u0646\u06cc \u0645\u0642\u0627\u0645\u06cc \u0632\u0628\u0627\u0646 \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u0646\u06c1\u06cc\u06ba \u06a9\u0631 \u0633\u06a9\u062a\u06d2\u06d4"},{question:"\u06a9\u06cc\u0627 \u0645\u06cc\u06ba \u0627\u067e \u0688\u06cc\u0679 \u0622\u062f\u06be\u0627\u0631 \u0622\u0646 \u0644\u0627\u0626\u0646 \u0633\u0631\u0648\u0633 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u067e\u0646\u06cc \u062a\u0627\u0631\u06cc\u062e \u067e\u06cc\u062f\u0627\u0626\u0634 \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",answer:"\u0646\u06c1\u06cc\u06ba\u06d4\u062a\u0627\u0631\u06cc\u062e \u067e\u06cc\u062f\u0627\u0626\u0634 (\u0688\u06cc \u0627\u0648 \u0628\u06cc) \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u0631\u0627\u0626\u06d2 \u0645\u06c1\u0631\u0628\u0627\u0646\u06cc \u0688\u06cc \u0627\u0648 \u0628\u06cc \u062b\u0628\u0648\u062a \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0642\u0631\u06cc\u0628\u06cc \u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba\u06d4"},{question:"\u0645\u06cc\u06ba \u0646\u06d2 \u067e\u06c1\u0644\u06d2 \u06c1\u06cc \u0627\u067e\u0646\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0645\u06cc\u06ba \u062a\u0627\u0631\u06cc\u062e \u067e\u06cc\u062f\u0627\u0626\u0634 \u06a9\u0648 \u0627\u06cc\u06a9 \u0628\u0627\u0631 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc\u0627 \u06c1\u06d2\u06d4 \u06a9\u06cc\u0627 \u0645\u06cc\u06ba \u0627\u0633\u06d2 \u0627\u067e \u0688\u06cc\u0679/ \u062f\u0631\u0633\u062a \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",answer:"\u0646\u06c1\u06cc\u06ba\u060c \u0622\u067e \u0627\u067e\u0646\u06cc \u062a\u0627\u0631\u06cc\u062e \u067e\u06cc\u062f\u0627\u0626\u0634 (\u0688\u06cc \u0627\u0648 \u0628\u06cc) \u06a9\u0648 \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0628\u0627\u0631 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0645\u0632\u06cc\u062f \u062a\u0627\u0631\u06cc\u062e \u067e\u06cc\u062f\u0627\u0626\u0634 (\u0688\u06cc \u0627\u0648 \u0628\u06cc) \u06a9\u0648 \u063a\u06cc\u0631 \u0645\u0639\u0645\u0648\u0644\u06cc \u062d\u0627\u0644\u0627\u062a \u0645\u06cc\u06ba \u062a\u0628\u062f\u06cc\u0644 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u060c \u0628\u0631\u0627\u0626\u06d2 \u0645\u06c1\u0631\u0628\u0627\u0646\u06cc \u0627\u0633 \u0633\u0644\u0633\u0644\u06d2 \u0645\u06cc\u06ba 1947 \u067e\u0631 \u06a9\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4"},{question:"\u06a9\u06cc\u0627 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0646\u0627 \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06cc \u062a\u0627\u0632\u06c1 \u06a9\u0627\u0631\u06cc \u06a9\u06cc \u0636\u0645\u0627\u0646\u062a \u062f\u06cc\u062a\u0627 \u06c1\u06d2\u061f",answer:"\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0646\u0627 \u0622\u062f\u06be\u0627\u0631 \u0688\u06cc\u0679\u0627 \u06a9\u06cc \u062a\u0627\u0632\u06c1 \u06a9\u0627\u0631\u06cc \u06a9\u06cc \u0636\u0645\u0627\u0646\u062a \u0646\u06c1\u06cc\u06ba \u062f\u06cc\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u067e \u0688\u06cc\u0679 \u0622\u062f\u06be\u0627\u0631 \u0622\u0646 \u0644\u0627\u0626\u0646 \u0633\u0631\u0648\u0633 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062c\u0645\u0639 \u06a9\u0631\u0627\u0626\u06cc \u06af\u0626\u06cc \u062a\u0628\u062f\u06cc\u0644\u06cc\u0627\u06ba \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062a\u0635\u062f\u06cc\u0642 \u0627\u0648\u0631 \u062a\u0648\u062b\u06cc\u0642 \u0633\u06d2 \u0645\u0634\u0631\u0648\u0637 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u062a\u0648\u062b\u06cc\u0642 \u06a9\u06d2 \u0628\u0639\u062f \u0635\u0631\u0641 \u062a\u0628\u062f\u06cc\u0644\u06cc \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u067e\u0631 \u0622\u062f\u06be\u0627\u0631 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u0632\u06cc\u062f \u06a9\u0627\u0631\u0631\u0648\u0627\u0626\u06cc \u06a9\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06d2\u06d4"},{question:"\u0645\u06cc\u06ba \u0646\u06d2 \u0627\u067e\u0646\u0627 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u06a9\u06be\u0648 \u062f\u06cc\u0627 \u06c1\u06d2/ \u0645\u06cc\u0631\u06d2 \u067e\u0627\u0633 \u0648\u06c1 \u0646\u0645\u0628\u0631 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u062c\u0633\u06d2 \u0645\u06cc\u06ba \u0646\u06d2 \u0622\u062f\u06be\u0627\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u0646\u062f\u0631\u0627\u062c \u06a9\u06cc\u0627 \u062a\u06be\u0627\u06d4 \u0645\u062c\u06be\u06d2 \u0627\u067e\u0646\u06cc \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06cc\u0633\u06d2 \u062c\u0645\u0639 \u06a9\u0631\u0646\u06cc \u0686\u0627\u06c1\u06cc\u06d2\u061f",answer:"\u0627\u06af\u0631 \u0622\u067e \u06a9\u06d2 \u067e\u0627\u0633 \u0622\u062f\u06be\u0627\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0631\u062c\u0633\u0679\u0631\u0688 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u06af\u0645 \u06c1\u0648 \u06af\u06cc\u0627 \u06c1\u0648/ \u0622\u067e \u06a9\u06d2 \u067e\u0627\u0633 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u062a\u0648 \u0622\u067e \u06a9\u0648 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u06a9\u06cc \u062a\u0627\u0632\u06c1 \u06a9\u0627\u0631\u06cc \u06a9\u06d2 \u0644\u06cc\u06d2 \u0630\u0627\u062a\u06cc \u0637\u0648\u0631 \u067e\u0631 \u0642\u0631\u06cc\u0628\u06cc \u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631 \u067e\u0631 \u062c\u0627\u0646\u0627 \u06c1\u0648\u06af\u0627\u06d4"},{question:"\u06a9\u06cc\u0627 \u0645\u06cc\u0631\u0627 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0627\u067e \u0688\u06cc\u0679 \u06c1\u0648\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f \u062a\u0628\u062f\u06cc\u0644 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627\u061f",answer:"\u0646\u06c1\u06cc\u06ba\u060c \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06d2 \u0628\u0639\u062f \u0628\u06be\u06cc \u0622\u067e \u06a9\u0627 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0648\u06c1\u06cc \u0631\u06c1\u06d2 \u06af\u0627\u06d4"},{question:"\u0645\u06cc\u06ba \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0648 \u0645\u0646\u0633\u0648\u062e \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u0627 \u06c1\u0648\u06ba\u06d4 \u06a9\u06cc\u0627 \u0645\u06cc\u06ba \u06cc\u06c1 \u06a9\u0631 \u0633\u06a9\u0648\u06ba \u06af\u0627\u061f",answer:"\u0627\u06cc\u06a9 \u0631\u06c1\u0627\u0626\u0634\u06cc \u0645\u06cc\u0631\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0688\u06cc\u0634 \u0628\u0648\u0631\u0688 \u0645\u06cc\u06ba \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u0648\u06ba \u06a9\u06cc \u062c\u06af\u06c1 \u0633\u06d2 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0648 \u0627\u0633 \u0648\u0642\u062a \u062a\u06a9 \u0645\u0646\u0633\u0648\u062e \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u062c\u0628 \u062a\u06a9 \u06a9\u06c1 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0648 \u0645\u0632\u06cc\u062f \u06a9\u0627\u0631\u0631\u0648\u0627\u0626\u06cc \u06a9\u06d2 \u0644\u06cc\u06d2 \u0646\u06c1\u06cc\u06ba \u0644\u06cc\u0627 \u062c\u0627\u062a\u0627\u06d4 \u0645\u0646\u0633\u0648\u062e \u06c1\u0648\u0646\u06d2 \u067e\u0631\u060c \u0627\u062f\u0627 \u06a9\u06cc \u06af\u0626\u06cc \u0631\u0642\u0645 21 \u062f\u0646\u0648\u06ba \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0645\u06cc\u06ba \u0648\u0627\u067e\u0633 \u06a9\u0631 \u062f\u06cc \u062c\u0627\u0626\u06d2 \u06af\u06cc\u06d4"},{question:"\u0645\u06cc\u06ba \u0627\u067e\u0646\u06cc \u062a\u0645\u0627\u0645 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u06cc\u06ba \u06a9\u06c1\u0627\u06ba \u062f\u06cc\u06a9\u06be \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",answer:"\u0627\u06cc\u06a9 \u0631\u06c1\u0627\u0626\u0634\u06cc \u0627\u067e\u0646\u06cc \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u06cc\u06ba \u0645\u06cc\u0631\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0688\u06cc\u0634 \u0628\u0648\u0631\u0688 \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u0648\u06ba \u06a9\u06cc \u062c\u06af\u06c1 \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u062f\u06cc\u06a9\u06be \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4"},{question:"\u0645\u06cc\u06ba \u0627\u067e\u0646\u06d2 \u067e\u062a\u06d2 \u0645\u06cc\u06ba \u0627\u067e\u0646\u06d2 \u0648\u0627\u0644\u062f/\u0634\u0648\u06c1\u0631 \u06a9\u0627 \u0646\u0627\u0645 \u06a9\u06cc\u0633\u06d2 \u0634\u0627\u0645\u0644 \u06a9\u0631\u0648\u06ba\u061f",answer:"\u0631\u0634\u062a\u06d2 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0622\u062f\u06be\u0627\u0631 \u0645\u06cc\u06ba \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0641\u06cc\u0644\u0688 \u06a9\u0627 \u0627\u06cc\u06a9 \u062d\u0635\u06c1 \u06c1\u06cc\u06ba\u06d4 \u0627\u0633\u06d2 C/o (\u06a9\u06cc\u0626\u0631 \u0622\u0641) \u0645\u06cc\u06ba \u0645\u0639\u06cc\u0627\u0631\u06cc \u0628\u0646\u0627\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4 \u0627\u0633\u06d2 \u0628\u06be\u0631\u0646\u0627 \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u06c1\u06d2\u06d4"}],eaadhaarDownload:[{question:"\u0627\u06cc \u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc\u0627 \u06c1\u06d2\u061f",answer:"\u0627\u06cc-\u0622\u062f\u06be\u0627\u0631 \u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc \u067e\u0627\u0633 \u0648\u0631\u0688 \u0633\u06d2 \u0645\u062d\u0641\u0648\u0638 \u0627\u0644\u06cc\u06a9\u0679\u0631\u0627\u0646\u06a9 \u06a9\u0627\u067e\u06cc \u06c1\u06d2\u060c \u062c\u0633 \u067e\u0631 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0688\u06cc\u062c\u06cc\u0679\u0644 \u0637\u0648\u0631 \u067e\u0631 \u062f\u0633\u062a\u062e\u0637 \u06a9\u06cc\u06d2 \u06af\u0626\u06d2 \u06c1\u06cc\u06ba\u06d4"},{question:"\u06a9\u06cc\u0627 \u0627\u06cc \u0622\u062f\u06be\u0627\u0631 \u0628\u06be\u06cc \u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc \u0641\u0632\u06cc\u06a9\u0644 \u06a9\u0627\u067e\u06cc \u06a9\u06cc \u0637\u0631\u062d \u062f\u0631\u0633\u062a \u06c1\u06d2\u061f",answer:"\u0622\u062f\u06be\u0627\u0631 \u0627\u06cc\u06a9\u0679 \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642\u060c \u0627\u06cc \u0622\u062f\u06be\u0627\u0631 \u062a\u0645\u0627\u0645 \u0645\u0642\u0627\u0635\u062f \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc \u0641\u0632\u06cc\u06a9\u0644 \u06a9\u0627\u067e\u06cc \u06a9\u06cc \u0637\u0631\u062d \u06cc\u06a9\u0633\u0627\u06ba \u0637\u0648\u0631 \u067e\u0631 \u062f\u0631\u0633\u062a \u06c1\u06d2\u06d4 \u0627\u06cc \u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc \u062f\u0631\u0633\u062a\u06af\u06cc \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645  \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0633\u0631\u06a9\u0644\u0631 \u062f\u06cc\u06a9\u06be\u06cc\u06ba- https://uidai.gov.in/images/ uidai_om_on_e_aadhaar_validity.pdf"},{question:"\u0645\u0627\u0633\u06a9\u0688 \u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc\u0627 \u06c1\u06d2\u061f",answer:"\u0646\u0642\u0627\u0628 \u067e\u0648\u0634 \u0622\u062f\u06be\u0627\u0631 \u06a9\u0627 \u0645\u0637\u0644\u0628 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u067e\u06c1\u0644\u06d2 8 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0648 'xxxx-xxxx' \u0633\u06d2 \u0628\u062f\u0644\u0646\u0627 \u06c1\u06d2 \u062c\u0628\u06a9\u06c1 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0635\u0631\u0641 \u0622\u062e\u0631\u06cc 4 \u06c1\u0646\u062f\u0633\u06d2 \u06c1\u06cc \u0646\u0638\u0631 \u0622\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"},{question:"\u0627\u06cc \u0622\u062f\u06be\u0627\u0631 \u0645\u06cc\u06ba \u0688\u06cc\u062c\u06cc\u0679\u0644 \u062f\u0633\u062a\u062e\u0637\u0648\u06ba \u06a9\u06cc \u062a\u0635\u062f\u06cc\u0642 \u06a9\u06cc\u0633\u06d2 \u06a9\u06cc \u062c\u0627\u0626\u06d2\u061f",answer:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0622\u062f\u06be\u0627\u0631 \u06cc\u0648\u0679\u06cc\u0648\u0628 \u0686\u06cc\u0646\u0644 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba \u0627\u0648\u0631 \u0679\u06cc\u0648\u0679\u0648\u0631\u06cc\u0644 \u0644\u0646\u06a9 \u062f\u06cc\u06a9\u06be\u06cc\u06ba https://youtu.be/aVNfUNIccZs?si=ByW1O6BIPMwc0seL"},{question:"\u0627\u06cc \u0622\u062f\u06be\u0627\u0631 \u06a9\u0627 \u067e\u0627\u0633 \u0648\u0631\u0688 \u06a9\u06cc\u0627 \u06c1\u06d2\u061f",answer:"\u0627\u06cc \u0622\u062f\u06be\u0627\u0631 \u06a9\u0627 \u067e\u0627\u0633 \u0648\u0631\u0688 \u06a9\u06cc\u067e\u06cc\u0679\u0644 \u0645\u06cc\u06ba \u0646\u0627\u0645 \u06a9\u06d2 \u067e\u06c1\u0644\u06d2 4 \u062d\u0631\u0648\u0641 \u0627\u0648\u0631 \u067e\u06cc\u062f\u0627\u0626\u0634 \u06a9\u06d2 \u0633\u0627\u0644 (YYYY) \u06a9\u0627 \u0645\u062c\u0645\u0648\u0639\u06c1 \u06c1\u06d2\u06d4\n\u0645\u062b\u0627\u0644 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631:\n\u0645\u062b\u0627\u0644 1\n\u0646\u0627\u0645: \u0633\u0631\u06cc\u0634 \u06a9\u0645\u0627\u0631\n\u067e\u06cc\u062f\u0627\u0626\u0634 \u06a9\u0627 \u0633\u0627\u0644: 1990\n\u067e\u0627\u0633 \u0648\u0631\u0688: SURE1990\n\u0645\u062b\u0627\u0644 2\n\u0646\u0627\u0645: \u0633\u0627\u0626\u06cc \u06a9\u0645\u0627\u0631\n\u067e\u06cc\u062f\u0627\u0626\u0634 \u06a9\u0627 \u0633\u0627\u0644: 1990\n\u067e\u0627\u0633 \u0648\u0631\u0688: SAIK1990\n\u0645\u062b\u0627\u0644 3\n\u0646\u0627\u0645: \u067e\u06cc \u06a9\u0645\u0627\u0631\n\u067e\u06cc\u062f\u0627\u0626\u0634 \u06a9\u0627 \u0633\u0627\u0644: 1990\n\u067e\u0627\u0633 \u0648\u0631\u0688: P.KU1990\n\u0645\u062b\u0627\u0644 4\n\u0646\u0627\u0645: \u0622\u0631 \u0622\u0626\u06cc \u0627\u06d2\n\u067e\u06cc\u062f\u0627\u0626\u0634 \u06a9\u0627 \u0633\u0627\u0644: 1990\n\u067e\u0627\u0633 \u0648\u0631\u0688: RIA1990"},{question:"\u0627\u06cc-\u0622\u062f\u06be\u0627\u0631 \u06a9\u06be\u0648\u0644\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0633 \u0645\u0639\u0627\u0648\u0646 \u0633\u0627\u0641\u0679 \u0648\u06cc\u0626\u0631 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u06d2\u061f",answer:"\u0631\u06c1\u0627\u0626\u0634\u06cc \u06a9\u0648 \u0627\u06cc \u0622\u062f\u06be\u0627\u0631 \u062f\u06cc\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 '\u0627\u06cc\u0688\u0648\u0628 \u0631\u06cc\u0688\u0631' \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u06d2\u06d4 \u0622\u067e \u06a9\u06d2 \u0633\u0633\u0679\u0645 \u0645\u06cc\u06ba '\u0627\u06cc\u0688\u0648\u0628 \u0631\u06cc\u0688\u0631' \u0627\u0646\u0633\u0679\u0627\u0644 \u06c1\u06d2\u06d4 \u0633\u0633\u0679\u0645 \u0645\u06cc\u06ba \u0627\u06cc\u0688\u0648\u0628 \u0631\u06cc\u0688\u0631  \u0627\u0646\u0633\u0679\u0627\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\n\u0645\u0644\u0627\u062d\u0638\u06c1 \u06a9\u0631\u06cc\u06ba https://get.adobe.com/reader/"},{question:"\u0627\u06cc\u06a9 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u0627 \u0627\u06cc-\u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc\u0633\u06d2 \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631\u0633\u06a9\u062a\u0627 \u06c1\u06d2\u061f",answer:"\u0627\u06cc\u06a9 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u0627 \u062a\u06cc\u0646 \u0637\u0631\u06cc\u0642\u0648\u06ba \u067e\u0631 \u0639\u0645\u0644 \u06a9\u0631\u06a9\u06d2 \u0627\u06cc-\u0622\u062f\u06be\u0627\u0631 \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631\u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4\n\u0627\u0646\u062f\u0631\u0627\u062c \u0646\u0645\u0628\u0631 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2:\n\u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2:\n\u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06a9\u06d2:\n\u0627\u06cc \u0622\u062f\u06be\u0627\u0631 \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0648 \u0679\u06cc \u067e\u06cc \u0631\u062c\u0633\u0679\u0631\u0688 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u067e\u0631 \u0645\u0648\u0635\u0648\u0644 \u06c1\u0648\u06af\u0627\u06d4"}],bookAnAppointment:[{question:"\u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0645\u06cc\u06ba \u0634\u06a9\u0627\u06cc\u0627\u062a \u06a9\u06d2 \u0627\u0632\u0627\u0644\u06d2 \u06a9\u06d2 \u0686\u06cc\u0646\u0644 \u06a9\u06cc\u0627 \u06c1\u06cc\u06ba\u061f",answer:"\u0627\u0641\u0631\u0627\u062f \u0627\u067e\u0646\u06cc \u0634\u06a9\u0627\u06cc\u0627\u062a \u06a9\u06d2 \u0627\u0632\u0627\u0644\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u062a\u0639\u062f\u062f \u0686\u06cc\u0646\u0644\u0632 \u062c\u06cc\u0633\u06d2 \u06a9\u06c1 \u0641\u0648\u0646\u060c \u0627\u06cc \u0645\u06cc\u0644\u060c \u0686\u06cc\u0679\u060c \u0644\u06cc\u0679\u0631/\u067e\u0648\u0633\u0679\u060c \u0648\u06cc\u0628 \u067e\u0648\u0631\u0679\u0644\u060c \u0648\u0627\u06a9 \u0627\u0646 \u0627\u0648\u0631 \u0633\u0648\u0634\u0644 \u0645\u06cc\u0688\u06cc\u0627 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u062a\u06a9 \u067e\u06c1\u0646\u0686 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\u062f\u0633\u062a\u06cc\u0627\u0628 \u0686\u06cc\u0646\u0644\u0632 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u062a\u0641\u0635\u06cc\u0644\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062d\u0633\u0628 \u0630\u06cc\u0644 \u06c1\u06cc\u06ba:\n1. \u0641\u0648\u0646 \u06a9\u0627\u0644 (\u0679\u0648\u0644 \u0641\u0631\u06cc \u0646\u0645\u0628\u0631) -\n\u0622\u062f\u06be\u0627\u0631 \u0633\u06d2 \u0645\u062a\u0639\u0644\u0642 \u062e\u062f\u0634\u0627\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0641\u0631\u0627\u062f \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0679\u0648\u0644 \u0641\u0631\u06cc \u0646\u0645\u0628\u0631 (1947) \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0631\u0627\u0628\u0637\u06c1 \u0645\u0631\u06a9\u0632 \u0633\u06cc\u0644\u0641 \u0633\u0631\u0648\u0633 IVRS (\u0627\u0646\u0679\u0631\u0627\u06cc\u06a9\u0679\u0648 \u0648\u0627\u0626\u0633 \u0631\u0633\u067e\u0627\u0646\u0633 \u0633\u0633\u0679\u0645) \u0627\u0648\u0631 \u0627\u0646\u0641\u0631\u0627\u062f\u06cc \u0633\u067e\u0648\u0631\u0679 \u0627\u06cc\u06af\u0632\u06cc\u06a9\u0679\u0648 \u067e\u0631 \u0645\u0628\u0646\u06cc \u0627\u0645\u062f\u0627\u062f \u067e\u0631 \u0645\u0634\u062a\u0645\u0644 \u06c1\u06d2\u06d4 \u0641\u0631\u062f \u0627\u067e\u0646\u06cc \u0622\u0633\u0627\u0646\u06cc \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u0628\u0627\u062a \u0686\u06cc\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u062c \u0630\u06cc\u0644 \u0645\u06cc\u06ba \u0633\u06d2 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0632\u0628\u0627\u0646 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4\n1. \u06c1\u0646\u062f\u06cc\n5. \u06a9\u0646\u0691\n9. \u06af\u062c\u0631\u0627\u062a\u06cc\n2. \u0627\u0646\u06af\u0631\u06cc\u0632\u06cc\n6. \u0645\u0644\u06cc\u0627\u0644\u0645\n10. \u0645\u0631\u0627\u0679\u06be\u06cc\n3. \u062a\u06cc\u0644\u06af\u0648\n7. \u0622\u0633\u0627\u0645\u06cc \n11. \u067e\u0646\u062c\u0627\u0628\u06cc\n4. \u062a\u0645\u0644\n8. \u0628\u0646\u06af\u0627\u0644\u06cc\n12. \u0627\u0648\u0688\u06cc\u0627\n\u0627\u0648\u0642\u0627\u062a:\na) IVRS \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0633\u06cc\u0644\u0641 \u0633\u0631\u0648\u0633 \u06a9\u0627 \u0641\u0627\u0626\u062f\u06c1 \u0627\u0679\u06be\u0627\u0646\u0627: IVRS \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062e\u062f\u0645\u0627\u062a 24X7 \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631 \u0633\u06cc\u0644\u0641 \u0633\u0631\u0648\u0633 \u0645\u0648\u0688 \u0645\u06cc\u06ba \u062d\u0627\u0635\u0644 \u06a9\u06cc \u062c\u0627 \u0633\u06a9\u062a\u06cc \u06c1\u06cc\u06ba\u06d4\n\u0628) \u0633\u067e\u0648\u0631\u0679 \u0627\u06cc\u06af\u0632\u06cc\u06a9\u0679\u0648 \u0645\u062f\u062f: \u06cc\u06c1 \u0633\u0631\u0648\u0633 \u067e\u06cc\u0631 \u0633\u06d2 \u06c1\u0641\u062a\u06c1: \u0635\u0628\u062d 7 \u0628\u062c\u06d2 \u0633\u06d2 \u0631\u0627\u062a 11 \u0628\u062c\u06d2 \u062a\u06a9\u060c \u0627\u062a\u0648\u0627\u0631: \u0635\u0628\u062d 8 \u0628\u062c\u06d2 \u0633\u06d2 \u0634\u0627\u0645 5 \u0628\u062c\u06d2 \u062a\u06a9 \u062d\u0627\u0635\u0644 \u06a9\u06cc \u062c\u0627 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u06d4                                  \n\u0639\u0627\u0645 \u0633\u0648\u0627\u0644\u0627\u062a \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06d2 \u0645\u0646\u0638\u0648\u0631 \u0634\u062f\u06c1 \u0645\u0639\u06cc\u0627\u0631\u06cc \u062c\u0648\u0627\u0628\u0627\u062a \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u0645\u0631\u06a9\u0632 \u06a9\u06d2 \u0627\u06cc\u06af\u0632\u06cc\u06a9\u0679\u0648 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 \u062d\u0644 \u06a9\u06cc\u06d2 \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0634\u06a9\u0627\u06cc\u0627\u062a \u06a9\u0648 \u062d\u0642\u06cc\u0642\u06cc \u0648\u0642\u062a \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631  \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06d2 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0688\u0648\u06cc\u0698\u0646\u0648\u06ba/\u0639\u0644\u0627\u0642\u0627\u0626\u06cc \u062f\u0641\u0627\u062a\u0631 \u06a9\u0648 \u062a\u0641\u0648\u06cc\u0636 \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u0646 \u0634\u06a9\u0627\u06cc\u0627\u062a \u06a9\u0627  \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06d2 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0688\u0648\u06cc\u0698\u0646/\u0639\u0644\u0627\u0642\u0627\u0626\u06cc \u062f\u0641\u0627\u062a\u0631 \u0645\u06cc\u06ba \u0627\u0646\u062f\u0631\u0648\u0646\u06cc \u0637\u0648\u0631 \u067e\u0631 \u062c\u0627\u0646\u0686 \u067e\u0691\u062a\u0627\u0644 \u06a9\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06d2 \u062a\u0627\u06a9\u06c1 \u0645\u0624\u062b\u0631 \u062d\u0644 \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06d2 \u0628\u0639\u062f \u0641\u0631\u062f \u062a\u06a9 \u067e\u06c1\u0646\u0686\u0627\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u06d2\u06d4\n2. \u0686\u06cc\u0679 \u0628\u0648\u0679 (\u0622\u062f\u06be\u0627\u0631 \u062f\u0648\u0633\u062a) - \u0627\u0641\u0631\u0627\u062f  \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0686\u06cc\u0679 \u0628\u0648\u0679 \u0633\u0631\u0648\u0633 '\u0622\u062f\u06be\u0627\u0631 \u062f\u0648\u0633\u062a \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0633\u06d2 \u0645\u062a\u0639\u0644\u0642 \u0627\u067e\u0646\u06cc \u062a\u0634\u0648\u06cc\u0634 \u06a9\u0627 \u0627\u0638\u06c1\u0627\u0631 \u06a9\u0631\u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0648  \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06cc \u0622\u0641\u06cc\u0634\u0644 \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 \u067e\u0631 \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u06d2 \u0627\u0633 \u0686\u06cc\u0679 \u0628\u0648\u0679 \u06a9\u0648 \u0633\u0648\u0627\u0644\u0627\u062a \u06a9\u0627 \u062c\u0648\u0627\u0628 \u062f\u06cc\u0646\u06d2 \u06a9\u06cc \u062a\u0631\u0628\u06cc\u062a \u062f\u06cc \u06af\u0626\u06cc \u06c1\u06d2 \u0627\u0648\u0631 \u0627\u0633 \u06a9\u0627 \u0645\u0642\u0635\u062f \u0627\u0646\u0641\u0631\u0627\u062f\u06cc \u062a\u062c\u0631\u0628\u06d2 \u06a9\u0648 \u0628\u06c1\u062a\u0631 \u0628\u0646\u0627\u0646\u0627 \u06c1\u06d2\u06d4                                                                                      3. \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0622\u0626\u06cc \u0648\u06cc\u0628 \u067e\u0648\u0631\u0679\u0644 - \u0627\u0641\u0631\u0627\u062f \u0634\u06a9\u0627\u06cc\u0627\u062a \u0627\u0648\u0631 \u0641\u06cc\u0688 \u0628\u06cc\u06a9 \u06a9\u06d2 \u062a\u062d\u062a \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0622\u0626\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 \u067e\u0631 \u0627\u067e\u0646\u06cc \u0634\u06a9\u0627\u06cc\u0627\u062a \u062f\u0631\u062c \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0627\u0646 \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a \u06a9\u0648 \u0686\u06cc\u06a9 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0634\u06a9\u0627\u06cc\u0627\u062a/\u0641\u06cc\u0688 \u0628\u06cc\u06a9 \u0633\u0679\u06cc\u0679\u0633 \u06a9\u0648 \u0686\u06cc\u06a9 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n4. \u0627\u06cc \u0645\u06cc\u0644 - \u0627\u0641\u0631\u0627\u062f \u0622\u062f\u06be\u0627\u0631 \u0633\u06d2 \u0645\u062a\u0639\u0644\u0642 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0633\u0648\u0627\u0644 \u0627\u0648\u0631 \u0634\u06a9\u0627\u06cc\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 help@uidai.gov.in \u067e\u0631 \u0627\u06cc \u0645\u06cc\u0644 \u0628\u06be\u06cc\u062c \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n5. \u0639\u0644\u0627\u0642\u0627\u0626\u06cc \u062f\u0641\u0627\u062a\u0631 \u0645\u06cc\u06ba \u0648\u0627\u06a9 \u0627\u0646: \u0627\u0641\u0631\u0627\u062f \u0627\u067e\u0646\u06d2 \u0633\u0648\u0627\u0644\u0627\u062a \u06a9\u06d2 \u062d\u0644 \u06cc\u0627 \u0622\u062f\u06be\u0627\u0631 \u0633\u06d2 \u0645\u062a\u0639\u0644\u0642 \u0634\u06a9\u0627\u06cc\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u067e\u0646\u06cc \u0631\u06cc\u0627\u0633\u062a \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0639\u0644\u0627\u0642\u0627\u0626\u06cc \u062f\u0641\u0627\u062a\u0631 \u0645\u06cc\u06ba \u0628\u0631\u0627\u06c1 \u0631\u0627\u0633\u062a \u062c\u0627 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n6. \u0688\u0627\u06a9/\u062e\u0637: \u0627\u0641\u0631\u0627\u062f \u0627\u067e\u0646\u06cc \u0634\u06a9\u0627\u06cc\u0627\u062a \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0627\u06cc\u0686 \u0627\u0648 \u06cc\u0627 \u0639\u0644\u0627\u0642\u0627\u0626\u06cc \u062f\u0641\u0627\u062a\u0631 \u0645\u06cc\u06ba \u0688\u0627\u06a9 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062f\u0631\u062c \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u06cc\u0627 \u06c1\u0627\u062a\u06be \u0633\u06d2 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062c\u0645\u0639 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0639\u0644\u0627\u0642\u0627\u0626\u06cc \u062f\u0641\u062a\u0631/ \u0688\u0648\u06cc\u0698\u0646 \u0634\u06a9\u0627\u06cc\u062a \u06a9\u06d2 \u062d\u0644 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0636\u0631\u0648\u0631\u06cc \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u06a9\u0631\u06d2 \u06af\u0627\u06d4\n7. \u062d\u06a9\u0648\u0645\u062a \u06c1\u0646\u062f \u06a9\u0627 \u0639\u0648\u0627\u0645\u06cc \u0634\u06a9\u0627\u06cc\u0627\u062a \u067e\u0648\u0631\u0679\u0644 (CPGRAMS): \u0633\u0646\u0679\u0631\u0644\u0627\u0626\u0632\u0688 \u067e\u0628\u0644\u06a9 \u06af\u0631\u06cc\u0648\u06cc\u0646\u0633 \u0631\u06cc\u0688\u06cc\u0633 \u0627\u06cc\u0646\u0688 \u0645\u0627\u0646\u06cc\u0679\u0631\u0646\u06af \u0633\u0633\u0679\u0645 (CPGRAMS) \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0634\u06a9\u0627\u06cc\u062a\u06cc\u06ba \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u067e\u0631 \u062f\u0631\u062c \u06a9\u06cc \u062c\u0627 \u0633\u06a9\u062a\u06cc \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0634\u06c1\u0631\u06cc\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 24x7 \u062f\u0633\u062a\u06cc\u0627\u0628 \u0627\u06cc\u06a9 \u0622\u0646 \u0644\u0627\u0626\u0646 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u06c1\u06d2\u06d4\n8. \u0633\u0648\u0634\u0644 \u0645\u06cc\u0688\u06cc\u0627: \u0679\u0648\u06cc\u0679\u0631\u060c \u0641\u06cc\u0633 \u0628\u06a9\u060c \u06cc\u0648 \u0679\u06cc\u0648\u0628\u060c \u0627\u0646\u0633\u0679\u0627\u06af\u0631\u0627\u0645 \u0648\u063a\u06cc\u0631\u06c1 \u062c\u06cc\u0633\u06d2 \u0645\u062a\u0639\u062f\u062f \u0633\u0648\u0634\u0644 \u0645\u06cc\u0688\u06cc\u0627 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0632 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0634\u06a9\u0627\u06cc\u0627\u062a \u062f\u0631\u062c \u06a9\u06cc \u062c\u0627 \u0633\u06a9\u062a\u06cc \u06c1\u06cc\u06ba\u06d4 \u0641\u0631\u062f \u0627\u067e\u0646\u06cc \u062a\u0634\u0648\u06cc\u0634/\u0634\u06a9\u0627\u06cc\u062a \u0633\u06d2 \u0645\u062a\u0639\u0644\u0642 \u0627\u06cc\u06a9 \u067e\u0648\u0633\u0679 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u062c\u0648 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0622\u0626\u06cc \u0679\u06cc\u06af \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u06cc\u0627 \u0645\u062e\u062a\u0644\u0641 \u067e\u0631 \u0633\u067e\u0648\u0631\u0679 \u067e\u06cc\u062c \u06a9\u0648 \u0688\u06cc \u0627\u06cc\u0645 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0633\u0648\u0634\u0644 \u0645\u06cc\u0688\u06cc\u0627 \u0627\u0633\u0679\u0631\u06cc\u0645\u0632\u06d4'"},{question:"\u06a9\u06cc\u0627 \u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u0633\u0631\u0648\u0633 \u0686\u0627\u0631\u062c\u0632 \u0645\u062e\u062a\u0644\u0641 \u06c1\u06cc\u06ba\u061f",answer:"\u0646\u06c1\u06cc\u06ba\u060c \u0622\u062f\u06be\u0627\u0631 \u062e\u062f\u0645\u0627\u062a \u06a9\u06d2 \u0686\u0627\u0631\u062c\u0632 \u0645\u0644\u06a9 \u06a9\u06d2 \u062a\u0645\u0627\u0645 \u0622\u062f\u06be\u0627\u0631 \u0645\u0631\u0627\u06a9\u0632 \u0628\u0634\u0645\u0648\u0644 \u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631\u0648\u06ba \u067e\u0631 \u0627\u06cc\u06a9 \u062c\u06cc\u0633\u06d2 \u06c1\u06cc\u06ba\u06d4\n\u0686\u0627\u0631\u062c\u0632 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u062f\u06cc\u06a9\u06be\u06cc\u06ba: \u0622\u062f\u06be\u0627\u0631 \u0627\u0646\u062f\u0631\u0627\u062c \u0627\u0648\u0631 \u0627\u067e \u0688\u06cc\u0679 \u0686\u0627\u0631\u062c\u0632"},{question:"\u06a9\u06cc\u0627 \u0645\u06cc\u06ba \u0627\u067e\u0646\u06cc \u0645\u0644\u0627\u0642\u0627\u062a \u06a9\u0648 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0634\u06cc\u0688\u0648\u0644/\u0645\u0646\u0633\u0648\u062e \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",answer:"\u06c1\u0627\u06ba\u060c \u0622\u067e \u0627\u0633\u06cc \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631/ \u0627\u06cc \u0645\u06cc\u0644 \u0622\u0626\u06cc \u0688\u06cc (\u062c\u06cc\u0633\u0627 \u06a9\u06c1 \u067e\u06c1\u0644\u06d2 \u062f\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2) \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u067e\u0648\u0627\u0626\u0646\u0679\u0645\u0646\u0679 \u067e\u0648\u0631\u0679\u0644 \u0645\u06cc\u06ba \u0644\u0627\u06af \u0627\u0646 \u06a9\u0631\u06a9\u06d2 24 \u06af\u06be\u0646\u0679\u06d2 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0627\u067e\u0648\u0627\u0626\u0646\u0679\u0645\u0646\u0679 \u06a9\u0648 \u0631\u06cc \u0634\u06cc\u0688\u0648\u0644 \u06a9\u0631\u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"},{question:"\u0645\u06cc\u06ba \u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631 \u0633\u06d2 \u06a9\u0648\u0646 \u0633\u06cc \u062e\u062f\u0645\u0627\u062a \u062d\u0627\u0635\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",answer:"\u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631 \u06c1\u0631 \u0642\u0633\u0645 \u06a9\u06cc \u0622\u062f\u06be\u0627\u0631 \u062e\u062f\u0645\u0627\u062a \u0645\u06c1\u06cc\u0627 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u06cc\u0633\u06d2\n1. \u062a\u0645\u0627\u0645 \u0639\u0645\u0631 \u06a9\u06d2 \u06af\u0631\u0648\u067e \u06a9\u06d2 \u0644\u06cc\u06d2 \u0646\u06cc\u0627 \u0627\u0646\u062f\u0631\u0627\u062c\u06d4\n2. \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a (\u0646\u0627\u0645\u060c \u067e\u062a\u06c1\u060c \u062c\u0646\u0633\u060c \u062a\u0627\u0631\u06cc\u062e \u067e\u06cc\u062f\u0627\u0626\u0634\u060c \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u0627\u0648\u0631 \u0627\u06cc \u0645\u06cc\u0644 \u0622\u0626\u06cc \u0688\u06cc) \u06a9\u06cc \u062a\u0627\u0632\u06c1 \u06a9\u0627\u0631\u06cc\u06d4\n3. \u0628\u0627\u0626\u06cc\u0648 \u0645\u06cc\u0679\u0631\u06a9 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06cc \u062a\u0627\u0632\u06c1 \u06a9\u0627\u0631\u06cc (\u062a\u0635\u0648\u06cc\u0631\u060c \u0641\u0646\u06af\u0631 \u067e\u0631\u0646\u0679\u0633 \u0627\u0648\u0631 \u0627\u06cc\u0631\u0633 \u0627\u0633\u06a9\u06cc\u0646)\u06d4\n4. \u0628\u0686\u0648\u06ba \u06a9\u06cc \u0644\u0627\u0632\u0645\u06cc \u0628\u0627\u06cc\u0648\u0645\u06cc\u0679\u0631\u06a9 \u0627\u067e\u0688\u06cc\u0679 (5 \u0627\u0648\u0631 15 \u0633\u0627\u0644 \u06a9\u06cc \u0639\u0645\u0631 \u06a9\u0648 \u067e\u06c1\u0646\u0686\u0646\u06d2 \u0648\u0627\u0644\u06d2)\u06d4\n5. \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u06cc \u062a\u0627\u0632\u06c1 \u06a9\u0627\u0631\u06cc( \u067e\u06cc \u0627\u0648 \u0622\u0626\u06cc \u0627\u0648\u0631  \u067e\u06cc \u0627\u0648 \u0627\u06d2)\u06d4\n6. \u0622\u062f\u06be\u0627\u0631 \u062a\u0644\u0627\u0634 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u067e\u0631\u0646\u0679 \u06a9\u0631\u06cc\u06ba\u06d4"},{question:"\u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0627\u06d2 \u0627\u06cc\u0633 \u06a9\u06d2 \u0627\u06cc\u0633  (\u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631) \u06a9\u06d2 \u0627\u0648\u0642\u0627\u062a \u06a9\u06cc\u0627 \u06c1\u06cc\u06ba\u061f",answer:"\u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631 \u0642\u0648\u0645\u06cc/\u0639\u0644\u0627\u0642\u0627\u0626\u06cc \u062a\u0639\u0637\u06cc\u0644\u0627\u062a \u06a9\u0648 \u0686\u06be\u0648\u0691 \u06a9\u0631 \u06c1\u0641\u062a\u06c1 \u06a9\u06d2 \u062a\u0645\u0627\u0645 7 \u062f\u0646 \u06a9\u06be\u0644\u06d2 \u0631\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0639\u0627\u0645 \u0637\u0648\u0631 \u067e\u0631 \u06cc\u06c1 \u0635\u0628\u062d 9:30 AM \u0633\u06d2 5:30 PM (IST) \u062a\u06a9 \u06a9\u0627\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4\n\u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0627\u06d2 \u0627\u06cc\u0633 \u06a9\u06d2 \u0627\u06cc\u0633 \u06a9\u06d2 \u0639\u0644\u0627\u0648\u06c1 \u0622\u062f\u06be\u0627\u0631 \u0627\u0646\u062f\u0631\u0627\u062c \u06a9\u06d2 \u0645\u0631\u0627\u06a9\u0632 \u0627\u0646 \u06a9\u06d2 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0631\u062c\u0633\u0679\u0631\u0627\u0631 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 \u0628\u06cc\u0627\u0646 \u06a9\u0631\u062f\u06c1 \u0627\u0648\u0642\u0627\u062a \u06a9\u06cc \u067e\u06cc\u0631\u0648\u06cc \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0627\u0646\u062f\u0631\u0627\u062c \u06a9\u06d2 \u062e\u0648\u0627\u06c1\u0627\u06ba \u0627\u0641\u0631\u0627\u062f/ \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0645\u0632\u06cc\u062f \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u067e\u0646\u06d2 \u0642\u0631\u06cc\u0628\u06cc \u0622\u062f\u06be\u0627\u0631 \u0627\u0646\u062f\u0631\u0627\u062c \u0645\u0631\u06a9\u0632 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"},{question:"\u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631 (\u0627\u06d2 \u0627\u06cc\u0633 \u06a9\u06d2) \u06a9\u06cc\u0627 \u06c1\u06d2\u061f",answer:"\u2019\u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631\u2018 \u06cc\u0627  \u0627\u06d2 \u0627\u06cc\u0633 \u06a9\u06d2 \u0631\u06c1\u0627\u0626\u0634\u06cc\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u062a\u0645\u0627\u0645 \u0622\u062f\u06be\u0627\u0631 \u062e\u062f\u0645\u0627\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u0648\u0627\u062d\u062f \u0627\u0633\u0679\u0627\u067e \u0645\u0646\u0632\u0644 \u06c1\u06d2\u06d4  \u0627\u06d2 \u0627\u06cc\u0633 \u06a9\u06d2 \u0627\u06cc\u06a9 \u062c\u062f\u06cc\u062f \u062a\u0631\u06cc\u0646 \u0645\u0627\u062d\u0648\u0644 \u0645\u06cc\u06ba \u0631\u06c1\u0627\u0626\u0634\u06cc\u0648\u06ba \u06a9\u0648 \u0648\u0642\u0641 \u0634\u062f\u06c1 \u0622\u062f\u06be\u0627\u0631 \u0627\u0646\u062f\u0631\u0627\u062c \u0627\u0648\u0631 \u0627\u067e \u0688\u06cc\u0679 \u062e\u062f\u0645\u0627\u062a \u067e\u06cc\u0634 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631 \u0631\u06c1\u0627\u0626\u0634\u06cc\u0648\u06ba \u06a9\u0648 \u0627\u06cc\u06a9 \u0622\u0631\u0627\u0645 \u062f\u06c1 \u0627\u06cc\u0626\u0631 \u06a9\u0646\u0688\u06cc\u0634\u0646\u0688 \u0645\u0627\u062d\u0648\u0644 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u062a\u0645\u0627\u0645  \u0627\u06d2 \u0627\u06cc\u0633 \u06a9\u06d2 \u0648\u06c1\u06cc\u0644 \u0686\u06cc\u0626\u0631 \u062f\u0648\u0633\u062a\u0627\u0646\u06c1 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0628\u0632\u0631\u06af\u0648\u06ba \u0627\u0648\u0631 \u062e\u0627\u0635 \u0637\u0648\u0631 \u067e\u0631 \u0645\u0639\u0630\u0648\u0631 \u0627\u0641\u0631\u0627\u062f \u06a9\u06cc \u062e\u062f\u0645\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u062e\u0635\u0648\u0635\u06cc \u0627\u0646\u062a\u0638\u0627\u0645\u0627\u062a \u06c1\u06cc\u06ba\u06d4  \u0627\u06d2 \u0627\u06cc\u0633 \u06a9\u06d2s \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0645\u0632\u06cc\u062f \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06cc\u06c1\u0627\u06ba \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u06d2: uidai.gov.in \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679\u06d4"},{question:"\u0645\u062c\u06be\u06d2 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0627\u06d2 \u0627\u06cc\u0633 \u06a9\u06d2 \u0627\u06cc\u0633 (\u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631\u0648\u06ba) \u06a9\u06cc \u0641\u06c1\u0631\u0633\u062a \u06a9\u06c1\u0627\u06ba \u0633\u06d2 \u0645\u0644 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u061f",answer:"\u062a\u0645\u0627\u0645 \u0641\u0639\u0627\u0644 ASKs \u06a9\u06cc \u0627\u06cc\u06a9 \u062c\u0627\u0645\u0639 \u0641\u06c1\u0631\u0633\u062a \u06cc\u06c1\u0627\u06ba \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u06d2: \u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631 \u06a9\u06cc \u0641\u06c1\u0631\u0633\u062a\n\u06cc\u06c1 ASKs \u0628\u06cc\u0646\u06a9\u0648\u06ba\u060c \u0688\u0627\u06a9\u062e\u0627\u0646\u0648\u06ba\u060c \u0633\u06cc \u0627\u06cc\u0633 \u0633\u06cc\u060c \u0628\u06cc \u0627\u06cc\u0633 \u0627\u06cc\u0646 \u0627\u06cc\u0644 \u0627\u0648\u0631 \u0631\u06cc\u0627\u0633\u062a\u06cc \u062d\u06a9\u0648\u0645\u062a\u0648\u06ba \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 \u0686\u0644\u0627\u0626\u06d2 \u062c\u0627\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0627\u0646\u062f\u0631\u0627\u062c \u0645\u0631\u0627\u06a9\u0632 \u06a9\u06d2 \u0639\u0644\u0627\u0648\u06c1 \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u06cc\u06ba\u06d4"}],checkEnrolmentUpdateStatus:[{question:"\u0645\u06cc\u06ba \u06a9\u0648\u0646 \u0633\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u0622\u062f\u06be\u0627\u0631 \u0622\u0646 \u0644\u0627\u0626\u0646 \u0633\u0631\u0648\u0633 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",answer:"\u0627\u0633 \u0622\u0646 \u0644\u0627\u0626\u0646 \u067e\u0648\u0631\u0679\u0644 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2\u060c \u0622\u067e \u0635\u0631\u0641 \u067e\u062a\u06c1 \u0627\u0648\u0631 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u06cc \u062a\u0627\u0632\u06c1 \u06a9\u0627\u0631\u06cc \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u062f\u0648\u0633\u0631\u06d2 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0642\u0631\u06cc\u0628\u06cc \u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba\u06d4"}],checkAadhaarValidity:[{question:"\u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688 \u0622\u062f\u06be\u0627\u0631 \u062e\u0637 \u0633\u06d2 \u06a9\u06cc\u0633\u06d2 \u0645\u062e\u062a\u0644\u0641 \u06c1\u06d2\u061f",answer:"\u0622\u062f\u06be\u0627\u0631 \u0644\u06cc\u0679\u0631 \u06a9\u0627\u063a\u0630 \u067e\u0631 \u0645\u0628\u0646\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06c1\u06d2 \u062c\u0648 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u0648\u06ba \u06a9\u0648 \u0627\u0646\u062f\u0631\u0627\u062c \u06cc\u0627 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06d2 \u0628\u0639\u062f \u062c\u0627\u0631\u06cc \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u067e\u0631 \u0645\u0628\u0646\u06cc \u067e\u0627\u0626\u06cc\u062f\u0627\u0631 \u0627\u0648\u0631 \u0645\u062a\u0639\u062f\u062f \u062d\u0641\u0627\u0638\u062a\u06cc \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u06a9\u06d2 \u0633\u0627\u062a\u06be \u06a9\u0627\u0631\u0688 \u0644\u06d2 \u062c\u0627\u0646\u06d2 \u0645\u06cc\u06ba \u0622\u0633\u0627\u0646 \u06c1\u06d2\u06d4 \u0622\u062f\u06be\u0627\u0631 \u067e\u06cc \u0648\u06cc \u0633\u06cc \u06a9\u0627\u0631\u0688 \u0628\u06be\u06cc \u0627\u062a\u0646\u0627 \u06c1\u06cc \u062f\u0631\u0633\u062a \u06c1\u06d2\u06d4"}],lockUnlockAadhaar:[{question:"\u0645\u06cc\u0631\u06cc \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u063a\u0644\u0637 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u0645\u0633\u062a\u0631\u062f \u06a9\u0631 \u062f\u06cc \u06af\u0626\u06cc\u06d4 \u0627\u0633 \u06a9\u0627 \u06a9\u06cc\u0627 \u0645\u0637\u0644\u0628 \u06c1\u06d2\u061f",answer:"\u062c\u0648 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0622\u067e \u0622\u0646 \u0644\u0627\u0626\u0646 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u0648\u06c1 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2:\n\u2022 https://uidai.gov.in \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u062f\u0631\u0633\u062a \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u06d4\n\u2022 \u0627\u067e \u0644\u0648\u0688 \u06a9\u06cc \u06af\u0626\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0631\u06c1\u0627\u0626\u0634\u06cc \u06a9\u06d2 \u0646\u0627\u0645 \u067e\u0631 \u06c1\u06d2\u06d4\n\u2022 \u0627\u067e \u0644\u0648\u0688 \u06a9\u06cc \u06af\u0626\u06cc \u062a\u0635\u0648\u06cc\u0631 \u0627\u0635\u0644\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u06cc \u0648\u0627\u0636\u062d \u0627\u0648\u0631 \u0631\u0646\u06af\u06cc\u0646 \u0627\u0633\u06a9\u06cc\u0646 \u06c1\u0648\u0646\u06cc \u0686\u0627\u06c1\u06cc\u06d2\u06d4\n\u0627\u0633 \u0628\u0627\u062a \u06a9\u0648 \u06cc\u0642\u06cc\u0646\u06cc \u0628\u0646\u0627\u0626\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u0646\u0626\u06cc \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0628\u0646\u0627\u0646\u06d2 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0627\u0648\u067e\u0631 \u06a9\u06cc \u067e\u06cc\u0631\u0648\u06cc \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"},{question:"\u0622\u062f\u06be\u0627\u0631 (\u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc) \u0644\u0627\u06a9 \u0627\u06cc\u0646\u0688 \u0627\u0646\u0644\u0627\u06a9 \u06a9\u06cc\u0627 \u06c1\u06d2\u061f",answer:"\u0627\u06cc\u06a9 \u0631\u06c1\u0627\u0626\u0634\u06cc \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0630\u0627\u062a\u06cc \u0688\u06cc\u0679\u0627 \u06a9\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0648\u0631 \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06c1\u0645\u06cc\u0634\u06c1 \u0627\u06cc\u06a9 \u0628\u0646\u06cc\u0627\u062f\u06cc \u062a\u0634\u0648\u06cc\u0634 \u06c1\u0648\u062a\u06cc \u06c1\u06d2\u06d4 \u0627\u0633 \u06a9\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u06cc \u062d\u0641\u0627\u0638\u062a \u06a9\u0648 \u0645\u0636\u0628\u0648\u0637 \u0628\u0646\u0627\u0646\u06d2 \u0627\u0648\u0631 \u0631\u06c1\u0627\u0626\u0634\u06cc \u06a9\u0648 \u06a9\u0646\u0679\u0631\u0648\u0644 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 (\u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc) \u06a9\u0648 \u0644\u0627\u06a9 \u0627\u0648\u0631 \u0627\u0646 \u0644\u0627\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u0627 \u0637\u0631\u06cc\u0642\u06c1 \u06a9\u0627\u0631 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4\n\u0631\u06c1\u0627\u0626\u0634\u06cc\u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 www.myaadhaar.uidai.gov.in \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u06cc\u0627 \u0627\u06cc\u0645 \u0622\u062f\u06be\u0627\u0631 \u0627\u06cc\u067e \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u067e\u0646\u0627 \u0622\u062f\u06be\u0627\u0631 (\u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc) \u0644\u0627\u06a9 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4\n\u0627\u06cc\u0633\u0627 \u06a9\u0631\u0646\u06d2 \u0633\u06d2 \u0631\u06c1\u0627\u0626\u0634\u06cc \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc\u060c \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0679\u0648\u06a9\u0646 \u0627\u0648\u0631 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2 \u0628\u0627\u0626\u06cc\u0648 \u0645\u06cc\u0679\u0631\u06a9\u0633\u060c \u0688\u06cc\u0645\u0648\u06af\u0631\u0627\u0641\u06a9 \u0627\u0648\u0631 \u0627\u0648 \u0679\u06cc \u067e\u06cc \u0645\u0648\u0688\u06cc\u0644\u0679\u06cc \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0642\u0633\u0645 \u06a9\u06cc \u062a\u0648\u062b\u06cc\u0642 \u0646\u06c1\u06cc\u06ba \u06a9\u0631 \u0633\u06a9\u062a\u0627\u06d4\n\u0627\u06af\u0631 \u0631\u06c1\u0627\u0626\u0634\u06cc \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0648 \u063a\u06cc\u0631 \u0645\u0642\u0641\u0644 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u0627 \u06c1\u06d2 \u062a\u0648 \u0648\u06c1\u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 \u06cc\u0627 \u0627\u06cc\u0645 \u0622\u062f\u06be\u0627\u0631 \u0627\u06cc\u067e \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631 \u06a9\u06d2 \u0627\u06cc\u0633\u0627 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4\n\u0622\u062f\u06be\u0627\u0631 (\u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc) \u06a9\u0648 \u063a\u06cc\u0631 \u0645\u0642\u0641\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f\u060c \u0631\u06c1\u0627\u0626\u0634\u06cc \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc\u060c \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0679\u0648\u06a9\u0646 \u0627\u0648\u0631 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631 \u06a9\u06d2 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4"},{question:"\u0631\u06c1\u0627\u0626\u0634\u06cc \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0648 \u06a9\u06cc\u0633\u06d2 \u0644\u0627\u06a9 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u061f",answer:"\u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0648 \u0644\u0627\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0631\u06c1\u0627\u0626\u0634\u06cc \u06a9\u06d2 \u067e\u0627\u0633 16 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0646\u0645\u0628\u0631 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2 \u0627\u0648\u0631 \u06cc\u06c1 \u0644\u0627\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u0634\u0631\u0637 \u06c1\u06d2\u06d4 \u0627\u06af\u0631 \u0631\u06c1\u0627\u0626\u0634\u06cc \u06a9\u06d2 \u067e\u0627\u0633 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u062a\u0648 \u0648\u06c1 \u0627\u06cc\u0633 \u0627\u06cc\u0645 \u0627\u06cc\u0633 \u0633\u0631\u0648\u0633 \u06cc\u0627 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 (www.myaadhaar.uidai.gov.in) \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062a\u06cc\u0627\u0631 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4\n\u0627\u06cc\u0633 \u0627\u06cc\u0645 \u0627\u06cc\u0633 \u0633\u0631\u0648\u0633\u06d4 \u062c\u06cc \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u062c\u06af\u06c1 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u06a9\u06d2 \u0622\u062e\u0631\u06cc 4 \u06cc\u0627 8 \u06c1\u0646\u062f\u0633\u0648\u06ba \u067e\u0631 \u0645\u0634\u062a\u0645\u0644 \u06c1\u06d2\u06d4 1947. Ex-GVID 1234 \u067e\u0631 SMS \u06a9\u0631\u06cc\u06ba\u06d4\n\u0631\u06c1\u0627\u0626\u0634\u06cc \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 https://resident.uidai.gov.in/aadhaar-lockunlock \u067e\u0631 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u0645\u06cc\u0631\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0679\u06cc\u0628 \u06a9\u06d2 \u062a\u062d\u062a\u060c \u0622\u062f\u06be\u0627\u0631 \u0644\u0627\u06a9 \u0627\u06cc\u0646\u0688 \u0627\u0646\u0644\u0627\u06a9 \u0633\u0631\u0648\u0633\u0632 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0644\u0627\u06a9 \u0631\u06cc\u0688\u06cc\u0648 \u0628\u0679\u0646 \u06a9\u0648 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646 \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0646\u0645\u0628\u0631\u060c \u067e\u0648\u0631\u0627 \u0646\u0627\u0645\u060c \u0627\u0648\u0631 \u067e\u0646 \u06a9\u0648\u0688 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u0633\u06cc\u06a9\u06cc\u0648\u0631\u0679\u06cc \u06a9\u0648\u0688 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4 \u0627\u0648 \u0679\u06cc \u067e\u06cc \u0628\u06be\u06cc\u062c\u06cc\u06ba \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u062c\u0645\u0639 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 \u0622\u067e \u06a9\u0627 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0627\u0645\u06cc\u0627\u0628\u06cc \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0644\u0627\u06a9 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4"},{question:"\u0631\u06c1\u0627\u0626\u0634\u06cc \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0648 \u06a9\u06cc\u0633\u06d2 \u06a9\u06be\u0648\u0644 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u061f",answer:"\u0627\u0646\u0644\u0627\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u2019\u2019\u0622\u0626\u06cc\u2018\u2018 \u06a9\u06d2 \u0631\u06c1\u0627\u0626\u0634\u06cc \u06a9\u06d2 \u067e\u0627\u0633 \u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646 16 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2 \u0627\u0648\u0631 \u0627\u06af\u0631 \u0631\u06c1\u0627\u0626\u0634\u06cc 16 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0628\u06be\u0648\u0644 \u06af\u06cc\u0627 \u06c1\u06d2 \u062a\u0648 \u0648\u06c1 \u0627\u06cc\u0633 \u0627\u06cc\u0645 \u0627\u06cc\u0633 \u0633\u0631\u0648\u0633\u0632 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0628\u0627\u0632\u06cc\u0627\u0641\u062a \u06a9\u0631\u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4    \u0622\u0631 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0627\u0633\u067e\u06cc\u0633 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u06a9\u06d2 \u0622\u062e\u0631\u06cc 4 \u06cc\u0627 8 \u06c1\u0646\u062f\u0633\u0648\u06ba \u067e\u0631 \u06c1\u06d2\u06d4 1947 \u067e\u0631 SMS \u06a9\u0631\u06cc\u06ba\u06d4 \u0633\u0627\u0628\u0642 RVID 1234          \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0648 \u0627\u0646\u0644\u0627\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0631\u06c1\u0627\u0626\u0634\u06cc \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc  \u06a9\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 https://resident.uidai.gov.in/aadhaar-lockunlock \u067e\u0631 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0646\u0644\u0627\u06a9 \u0631\u06cc\u0688\u06cc\u0648 \u0628\u0679\u0646 \u06a9\u0648 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u060c \u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646\u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc  \u0627\u0648\u0631 \u0633\u06cc\u06a9\u06cc\u0648\u0631\u0679\u06cc \u06a9\u0648\u0688 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u0627\u0648 \u0679\u06cc \u067e\u06cc \u0628\u06be\u06cc\u062c\u06cc\u06ba\u06d4 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0626\u06cc\u06ba \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 \u0622\u067e \u06a9\u0627 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0627\u0645\u06cc\u0627\u0628\u06cc \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u0646 \u0644\u0627\u06a9 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4                                                                                                         \u0631\u06c1\u0627\u0626\u0634\u06cc \u0627\u06cc\u0645 \u0622\u062f\u06be\u0627\u0631 \u0627\u06cc\u067e \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0644\u0627\u06a9 \u06cc\u0627 \u0627\u0646\u0644\u0627\u06a9 \u0633\u0631\u0648\u0633 \u06a9\u0627 \u0628\u06be\u06cc \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4"}],grievanceAndFeedback:[],generateOrRetrieveVid:[{question:"\u0645\u06cc\u06ba \u0627\u067e\u0646\u06cc \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0628\u06be\u0648\u0644 \u06af\u06cc\u0627 \u06c1\u0648\u06ba\u06d4 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0644\u0627\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f \u0645\u06cc\u06ba \u0627\u0633\u06d2 \u06a9\u06cc\u0633\u06d2 \u062d\u0627\u0635\u0644 \u06a9\u0631\u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",answer:"\u0644\u0627\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f \u0627\u06af\u0631 \u0631\u06c1\u0627\u0626\u0634\u06cc \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0628\u06be\u0648\u0644 \u062c\u0627\u0626\u06d2 \u062a\u0648 \u0631\u06c1\u0627\u0626\u0634\u06cc 16 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u06cc \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0628\u0627\u0632\u06cc\u0627\u0641\u062a \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u0633 \u0627\u06cc\u0645 \u0627\u06cc\u0633 \u0633\u0631\u0648\u0633 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0631\u06c1\u0627\u0626\u0634\u06cc \u0627\u067e\u0646\u06d2 \u0631\u062c\u0633\u0679\u0631\u0688 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u067e\u0631 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0648\u0635\u0648\u0644 \u06a9\u0631\u06d2 \u06af\u0627\u06d4                               \u0622\u062f\u06be\u0627\u0631 \u0631\u062c\u0633\u0679\u0631 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u0633\u06d2 1947 \u067e\u0631 \u0627\u06cc\u0633 \u0627\u06cc\u0645 \u0627\u06cc\u0633 \u0628\u06be\u06cc\u062c\u06cc\u06ba\u060c\n\u0622\u0631 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0627\u0633\u067e\u06cc\u0633 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u06a9\u06d2 \u0622\u062e\u0631\u06cc 4 \u06cc\u0627 8 \u06c1\u0646\u062f\u0633\u0648\u06ba \u067e\u0631 \u06c1\u06d2\u06d4\n\u0645\u062b\u0627\u0644 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631: RVID 1234"},{question:"\u0648\u0631\u0686\u0648\u0626\u0644 \u0622\u0626\u06cc \u0688\u06cc (\u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc )\u06a9\u06cc\u0627 \u06c1\u06d2\u061f",answer:"\u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0627\u06cc\u06a9 \u0639\u0627\u0631\u0636\u06cc\u060c \u0642\u0627\u0628\u0644 \u062a\u0646\u0633\u06cc\u062e 16 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 \u0628\u06d2 \u062a\u0631\u062a\u06cc\u0628 \u0646\u0645\u0628\u0631 \u06c1\u06d2 \u062c\u0633\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0645\u06cc\u067e \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4 \u062c\u0628 \u0628\u06be\u06cc \u062a\u0635\u062f\u06cc\u0642 \u06cc\u0627 \u0627\u06cc-\u06a9\u06d2 \u0648\u0627\u0626\u06cc \u0633\u06cc \u062e\u062f\u0645\u0627\u062a \u0627\u0646\u062c\u0627\u0645 \u062f\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06cc\u06ba \u062a\u0648 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0628\u062f\u0644\u06d2 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc \u0637\u0631\u062d \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2 \u062a\u0648\u062b\u06cc\u0642 \u06a9\u06cc \u062c\u0627 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u06d4 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0633\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u062d\u0627\u0635\u0644 \u06a9\u0631\u0646\u0627 \u0645\u0645\u06a9\u0646 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4"},{question:"\u0627\u06cc\u06a9 \u0631\u06c1\u0627\u0626\u0634\u06cc \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u06cc\u0633\u06d2 \u062d\u0627\u0635\u0644 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u061f",answer:"\u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0635\u0631\u0641 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06c1\u0648\u0644\u0688\u0631 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 \u062a\u06cc\u0627\u0631 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0648\u06c1 \u0648\u0642\u062a\u0627\u064b \u0641\u0648\u0642\u062a\u0627\u064b \u0627\u067e\u0646\u06d2 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0648 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba (\u0627\u06cc\u06a9 \u0646\u06cc\u0627 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0628\u0646\u0627 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba)\u06d4 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0648\u0642\u062a \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0627\u06cc\u06a9 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u0633\u062a \u06c1\u0648 \u06af\u0627\u06d4  \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0622\u062f\u06be\u0627\u0631 \u06a9\u0648 \u0645\u062e\u062a\u0644\u0641 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0627\u067e\u0646\u0627 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0628\u0646\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0628\u06be\u0648\u0644 \u062c\u0627\u0646\u06d2 \u06a9\u06cc \u0635\u0648\u0631\u062a \u0645\u06cc\u06ba \u0627\u067e\u0646\u0627 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u062f\u0648\u0628\u0627\u0631\u06c1 \u062d\u0627\u0635\u0644 \u06a9\u0631\u06cc\u06ba\u060c \u0627\u0648\u0631 \u0627\u067e\u0646\u06d2 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0648 \u0627\u06cc\u06a9 \u0646\u0626\u06d2 \u0646\u0645\u0628\u0631 \u0633\u06d2 \u0628\u062f\u0644 \u062f\u06cc\u06ba\u060c \u06cc\u06c1 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a  \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 (www.myaadhaar.uidai.gov.in)\u060c \u0627\u06cc \u0622\u062f\u06be\u0627\u0631 \u0688\u0627\u0624\u0646 \u0644\u0648\u0688\u060c \u0627\u06cc\u0645 \u0622\u062f\u06be\u0627\u0631 \u0645\u0648\u0628\u0627\u0626\u0644 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u0648\u06ba \u06af\u06d2\u06d4\u062f\u0631\u062e\u0648\u0627\u0633\u062a\u060c \u0648\u063a\u06cc\u0631\u06c1                                                                                                        \u0622\u062f\u06be\u0627\u0631 \u06c1\u06cc\u0644\u067e \u0644\u0627\u0626\u0646 \u0646\u0645\u0628\u0631 1947 \u067e\u0631 \u0627\u06cc\u0633 \u0627\u06cc\u0645 \u0627\u06cc\u0633 \u0628\u06be\u06cc\u062c \u06a9\u0631 \u0628\u06be\u06cc \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u062a\u06cc\u0627\u0631 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0631\u06c1\u0627\u0626\u0634\u06cc \u06a9\u0648 '\u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0622\u062e\u0631\u06cc 4 \u06c1\u0646\u062f\u0633\u0648\u06ba \u062c\u06cc \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc' \u0679\u0627\u0626\u067e \u06a9\u0631\u0646\u0627 \u06c1\u0648\u06af\u0627 \u0627\u0648\u0631 \u0627\u0633\u06d2 \u0631\u062c\u0633\u0679\u0631\u0688 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 1947 \u067e\u0631 \u0628\u06be\u06cc\u062c\u0646\u0627 \u06c1\u0648\u06af\u0627\u06d4"},{question:"\u06a9\u06cc\u0627 \u06a9\u0648\u0626\u06cc \u0627\u0648\u0631 \u0645\u06cc\u0631\u06d2 \u0644\u06cc\u06d2 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0628\u0646\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u061f",answer:"\u06a9\u0648\u0626\u06cc \u0627\u0648\u0631 \u0627\u062f\u0627\u0631\u06c1 \u062c\u06cc\u0633\u06d2 \u0627\u06d2 \u06cc\u0648 \u0627\u06d2/\u06a9\u06d2 \u06cc\u0648 \u0627\u06cc\u0646 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06c1\u0648\u0644\u0688\u0631 \u06a9\u06cc \u062c\u0627\u0646\u0628 \u0633\u06d2 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0646\u06c1\u06cc\u06ba \u0628\u0646\u0627 \u0633\u06a9\u062a\u0627\u06d4 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06c1\u0648\u0644\u0688\u0631 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 \u062e\u0648\u062f \u06c1\u06cc \u062a\u06cc\u0627\u0631 \u06a9\u06cc\u0627 \u062c\u0627\u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u06a9\u0648 \u0631\u062c\u0633\u0679\u0631\u0688 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u067e\u0631 \u0627\u06cc\u0633 \u0627\u06cc\u0645 \u0627\u06cc\u0633 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0645\u0648\u0635\u0648\u0644 \u06c1\u0648\u06af\u0627\u06d4"},{question:"\u0627\u06af\u0631 \u06a9\u0648\u0626\u06cc \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u0627 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0628\u06be\u0648\u0644 \u062c\u0627\u0626\u06d2 \u062a\u0648 \u06a9\u06cc\u0627 \u06c1\u0648\u06af\u0627\u061f \u06a9\u06cc\u0627 \u0648\u06c1 \u062f\u0648\u0628\u0627\u0631\u06c1 \u062d\u0627\u0635\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u061f",answer:"\u06c1\u0627\u06ba\u060c \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc  \u0646\u0626\u06d2 \u0628\u0646\u0627\u0646\u06d2 \u0627\u0648\u0631/\u06cc\u0627 \u0645\u0648\u062c\u0648\u062f\u06c1 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0648 \u0628\u0627\u0632\u06cc\u0627\u0641\u062a \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0645\u062a\u0639\u062f\u062f \u0637\u0631\u06cc\u0642\u06d2 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u06cc\u06c1 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc  \u06a9\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 (www.myaadhaar.uidai.gov.in)\u060c \u0627\u06cc \u0622\u062f\u06be\u0627\u0631\u060c  \u0627\u06cc\u0645 \u0622\u062f\u06be\u0627\u0631  \u0645\u0648\u0628\u0627\u0626\u0644 \u0627\u06cc\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646\u060c \u0627\u06cc\u0633 \u0627\u06cc\u0645 \u0627\u06cc\u0633\u060c \u0648\u063a\u06cc\u0631\u06c1 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u06cc\u06ba\u06d4                                                                                       \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u06cc \u0628\u0627\u0632\u06cc\u0627\u0641\u062a \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u0627 \u0622\u062f\u06be\u0627\u0631 \u06c1\u06cc\u0644\u067e \u0644\u0627\u0626\u0646 \u0646\u0645\u0628\u0631 1947 \u067e\u0631 \u0627\u06cc\u0633 \u0627\u06cc\u0645 \u0627\u06cc\u0633 \u0628\u06be\u06cc\u062c \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0631\u06c1\u0627\u0626\u0634\u06cc \u06a9\u0648 '\u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0622\u0631 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0622\u062e\u0631\u06cc 4 \u06c1\u0646\u062f\u0633\u0648\u06ba' \u06a9\u0648 \u0679\u0627\u0626\u067e \u06a9\u0631\u0646\u0627 \u06c1\u0648\u06af\u0627 \u0627\u0648\u0631 \u0627\u0633\u06d2 \u0631\u062c\u0633\u0679\u0631\u0688 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 1947 \u067e\u0631 \u0628\u06be\u06cc\u062c\u0646\u0627 \u06c1\u0648\u06af\u0627\u06d4"},{question:"\u06a9\u06cc\u0627 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0648 \u0627\u0648 \u0679\u06cc \u067e\u06cc \u06cc\u0627 \u0628\u0627\u0626\u06cc\u0648 \u0645\u06cc\u0679\u0631\u06a9\u0633 \u06cc\u0627 \u0688\u06cc\u0645\u0648\u06af\u0631\u0627\u0641\u06a9\u0633 \u06a9\u06cc \u062a\u0635\u062f\u06cc\u0642 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u061f",answer:"\u062c\u06cc \u06c1\u0627\u06ba \u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc \u062a\u0648\u062b\u06cc\u0642 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0628\u062f\u0644\u06d2 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4"},{question:"\u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc  \u06a9\u06cc \u0635\u0648\u0631\u062a \u0645\u06cc\u06ba\u060c \u06a9\u06cc\u0627 \u0645\u062c\u06be\u06d2 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u06d2\u061f",answer:"\u06c1\u0627\u06ba\u060c \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u067e\u0631 \u0645\u0628\u0646\u06cc \u062a\u0635\u062f\u06cc\u0642 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u06a9\u06cc \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u0636\u0631\u0648\u0631\u06cc \u06c1\u06d2\u06d4 \u0627\u06cc\u062c\u0646\u0633\u06cc \u06a9\u0648 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u06a9\u0648 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u06d2 \u0645\u0642\u0635\u062f \u0633\u06d2 \u0622\u06af\u0627\u06c1 \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0648\u0627\u0636\u062d \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u062d\u0627\u0635\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u06d2\u06d4"},{question:"\u06a9\u06cc\u0627 \u06a9\u0648\u0626\u06cc \u0627\u06cc\u062c\u0646\u0633\u06cc \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0627\u0633\u0679\u0648\u0631 \u06a9\u0631 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u061f",answer:"\u0646\u06c1\u06cc\u06ba\u060c \u0686\u0648\u0646\u06a9\u06c1 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc  \u0639\u0627\u0631\u0636\u06cc \u06c1\u06d2 \u0627\u0648\u0631 \u0627\u0633\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0633 \u0644\u06cc\u06d2 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc  \u06a9\u0648 \u0630\u062e\u06cc\u0631\u06c1 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u06a9\u0648\u0626\u06cc \u0642\u06cc\u0645\u062a \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4 \u0627\u06cc\u062c\u0646\u0633\u06cc\u0648\u06ba \u06a9\u0648 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0688\u06cc\u0679\u0627 \u0628\u06cc\u0633 \u06cc\u0627 \u0644\u0627\u06af \u0645\u06cc\u06ba \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc  \u0630\u062e\u06cc\u0631\u06c1 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2\u06d4"},{question:"\u06a9\u06cc\u0627 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u06cc \u062f\u0648\u0628\u0627\u0631\u06c1 \u062a\u062e\u0644\u06cc\u0642 \u0627\u06cc\u06a9 \u06c1\u06cc \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06cc\u0627 \u0627\u06cc\u06a9 \u0645\u062e\u062a\u0644\u0641 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u06cc \u0637\u0631\u0641 \u0644\u06d2 \u062c\u0627\u0626\u06d2 \u06af\u06cc\u061f",answer:"\u06a9\u0645 \u0627\u0632 \u06a9\u0645 \u0645\u06cc\u0639\u0627\u062f \u06a9\u06cc \u0645\u062f\u062a \u06a9\u06d2 \u0628\u0639\u062f (\u0641\u06cc \u0627\u0644\u062d\u0627\u0644 1 \u06a9\u06cc\u0644\u0646\u0688\u0631 \u0688\u06d2 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u0633\u06cc\u0679 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2 \u06cc\u0627 12 \u0622\u062f\u06be\u06cc \u0631\u0627\u062a \u06a9\u06d2 \u0628\u0639\u062f)\u060c \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u0627 \u0627\u06cc\u06a9 \u0646\u0626\u06d2 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0648 \u062f\u0648\u0628\u0627\u0631\u06c1 \u062a\u062e\u0644\u06cc\u0642 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u0633 \u0637\u0631\u062d\u060c \u0646\u06cc\u0627 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u062a\u06cc\u0627\u0631 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u0627\u0648\u0631 \u067e\u0686\u06be\u0644\u0627 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u063a\u06cc\u0631 \u0641\u0639\u0627\u0644 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4\n\u0627\u0633 \u0635\u0648\u0631\u062a \u0645\u06cc\u06ba\u060c \u0627\u06af\u0631 \u0631\u06c1\u0627\u0626\u0634\u06cc \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u06cc \u0628\u0627\u0632\u06cc\u0627\u0641\u062a \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u060c \u062a\u0648 \u0622\u062e\u0631\u06cc \u0641\u0639\u0627\u0644 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06c1\u0648\u0644\u0688\u0631 \u06a9\u0648 \u0627\u06cc\u0633 \u0627\u06cc\u0645 \u0627\u06cc\u0633 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0628\u06be\u06cc\u062c\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u0631\u06c1\u0627\u0626\u0634\u06cc \u06a9\u0648 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0622\u062e\u0631\u06cc 4 \u06c1\u0646\u062f\u0633\u0648\u06ba RVID' \u0679\u0627\u0626\u067e \u06a9\u0631\u0646\u0627 \u06c1\u0648\u06af\u0627 \u0627\u0648\u0631 \u0627\u0633\u06d2 \u0631\u062c\u0633\u0679\u0631\u0688 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 1947 \u067e\u0631 \u0628\u06be\u06cc\u062c\u0646\u0627 \u06c1\u0648\u06af\u0627\u06d4"}],checkGrievanceFeedbackStatus:[{question:"\u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc \u06a9\u06cc \u0645\u06cc\u0639\u0627\u062f \u062e\u062a\u0645 \u06c1\u0648\u0646\u06d2 \u06a9\u06cc \u0645\u062f\u062a \u06a9\u06cc\u0627 \u06c1\u06d2\u061f",answer:"\u0627\u0633 \u0648\u0642\u062a \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc  \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0648\u0626\u06cc \u0645\u06cc\u0639\u0627\u062f \u062e\u062a\u0645 \u06c1\u0648\u0646\u06d2 \u06a9\u06cc \u0648\u0636\u0627\u062d\u062a \u0646\u06c1\u06cc\u06ba \u06a9\u06cc \u06af\u0626\u06cc \u06c1\u06d2\u06d4 \u0648\u06cc \u0622\u0626\u06cc \u0688\u06cc  \u0627\u0633 \u0648\u0642\u062a \u062a\u06a9 \u062f\u0631\u0633\u0