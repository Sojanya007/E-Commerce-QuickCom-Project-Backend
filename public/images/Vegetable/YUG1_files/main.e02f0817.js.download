:{case1:"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cc6\u0c97\u0cbe\u0c97\u0cbf {{resident}} \u0ca8\u0cbf\u0c82\u0ca6 \u0cae\u0cc7\u0cb2\u0cbf\u0ca8 SRN \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf.",case2:"{{resident}} \u0c9c\u0cca\u0ca4\u0cc6\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf.",case3:"{{resident}} \u0c9c\u0cca\u0ca4\u0cc6\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf.",case4:"\u0cae\u0cc7\u0cb2\u0cbf\u0ca8 SRN \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0c95\u0c82\u0ca1\u0cc1\u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2."},acceptScreen:{acceptMsg:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c95\u0cc1\u0c9f\u0cc1\u0c82\u0cac\u0ca6 \u0cae\u0cc1\u0c96\u0ccd\u0caf\u0cb8\u0ccd\u0ca5\u0cb0\u0cbe\u0c97\u0cbf \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf.",declineMsg:"\u0c95\u0cc1\u0c9f\u0cc1\u0c82\u0cac\u0ca6 \u0cae\u0cc1\u0c96\u0ccd\u0caf\u0cb8\u0ccd\u0ca5\u0cb0\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1  \u0ca4\u0cbf\u0cb0\u0cb8\u0ccd\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf."},confirmationPopUp:{rejectPrompt:"HoF \u0c86\u0c97\u0cbf \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf  \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbf\u0cb0\u0cb8\u0ccd\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1  \u0cac\u0caf\u0cb8\u0cc1\u0cb5\u0cbf\u0cb0\u0cbe?",acceptPrompt:"HoF \u0c86\u0c97\u0cbf  \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf  \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0cb5\u0cbf\u0cb0\u0cbe?"}}},pvc:{oauth:{preview:{sectionHeading:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cbe\u0c97\u0cbf \u0c86\u0ca6\u0cc7\u0cb6 \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cc2\u0cb0\u0ccd\u0cb5\u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0ca3\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf",sectionText:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0ca4\u0caa\u0ccd\u0caa\u0cbe\u0ca6 / \u0c95\u0cbe\u0ca3\u0cc6\u0caf\u0cbe\u0ca6 / \u0cb9\u0cb3\u0cc6\u0caf / \u0cb9\u0cb3\u0cc6\u0caf\u0ca6\u0cbe\u0ca6 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0c95\u0cca\u0c82\u0ca1\u0cb0\u0cc6, \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c95\u0ccd\u0c95\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0c85\u0ca5\u0cb5\u0cbe \u0c88 \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",name:"\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1",dob:"\u0c9c\u0ca8\u0ccd\u0cae \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95",gender:"\u0cb2\u0cbf\u0c82\u0c97",address:"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8"}},generic:{form:{selectLabel:"12 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 / 28 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf \u0c90\u0ca1\u0cbf \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",radioLabels:{uid:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",eid:"\u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf ID \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6"},textFields:{uid:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",eid:"14 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",generic:"\u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf ID \u0c85\u0ca5\u0cb5\u0cbe SRN \u0c85\u0ca5\u0cb5\u0cbe URN \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",mobile:"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",otp:"\u0c92\u0c9f\u0cbf\u0caa\u0cbf \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",securityCode:"\u0c95\u0ccd\u0caf\u0cbe\u0caa\u0ccd\u0c9a\u0cbe \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf"},checkBox:{mobile:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0cb2\u0ccd\u0cb2",tnc:"\u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb7\u0cb0\u0ca4\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0cc1"},button:{otp:"\u0c92\u0c9f\u0cbf\u0caa\u0cbf \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf",submit:"\u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cc1"},modal:{mobile:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0ccd\u0caa\u0c9f\u0ccd\u0c9f\u0cb0\u0cc6, \u0cae\u0cc8\u0c86\u0ca7\u0cbe\u0cb0\u0ccd (myaadhaar.uidai.gov.in) \u0c97\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0c86\u0c97\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c97\u0cbe\u0c97\u0cbf \u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c87\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb6\u0cbf\u0cab\u0cbe\u0cb0\u0cb8\u0cc1 \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0cb5\u0cc6.",tnc:{heading:"\u0c92\u0c8e\u0cb8\u0cbf \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0ca4 '\u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb7\u0cb0\u0ca4\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1' \u0c95\u0cc6\u0cb3\u0c97\u0cc6 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbf:",t1:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c88 \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0ca8\u0ccd\u0ca8 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c97\u0cc6 \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6.",t2:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbf\u0ca4 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca4\u0cb2\u0cc1\u0caa\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c8e\u0c82\u0ca6\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c85\u0cb0\u0ccd\u0ca5\u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6, \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0ca6\u0cc1 \u0caa\u0cbf\u0ca8\u0ccd\u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb8\u0c82\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.",t3:"\u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0ca8\u0cbe\u0ca8\u0cc1 50 / - (Incl GST) \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cb2\u0cc1 \u0c92\u0caa\u0ccd\u0caa\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6.",t4:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c87\u0c82\u0ca1\u0cbf\u0caf\u0cbe \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd\u200c\u0ca8 \u0cb8\u0ccd\u0caa\u0cc0\u0ca1\u0ccd \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0c85\u0cb5\u0cb0 \u0cb5\u0cbf\u0ca4\u0cb0\u0ca3\u0cbe \u0cae\u0cbe\u0ca8\u0ca6\u0c82\u0ca1\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c85\u0ca8\u0cc1\u0c97\u0cc1\u0ca3\u0cb5\u0cbe\u0c97\u0cbf \u0ca4\u0cb2\u0cc1\u0caa\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c8e\u0c82\u0ca6\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c85\u0cb0\u0ccd\u0ca5\u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6. \u0c87\u0c82\u0ca1\u0cbf\u0caf\u0cbe \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cb8\u0ccd\u0c9f\u0cc7\u0c9f\u0cb8\u0ccd \u0c9f\u0ccd\u0cb0\u0ccd\u0caf\u0cbe\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0cb5\u0cbf\u0ca4\u0cb0\u0ca3\u0cbe \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c9f\u0ccd\u0cb0\u0ccd\u0caf\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1."}}},payment:{welcomeText:"\u0c86\u0ca4\u0ccd\u0cae\u0cc0\u0caf \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf, ",srnInfo:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c8e\u0cb8\u0ccd \u0c86\u0cb0\u0ccd \u0c8e\u0ca8\u0ccd # \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.",trackInfo:"\u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0c9f\u0ccd\u0cb0\u0ccd\u0caf\u0cbe\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caf\u0cc1\u0c90\u0ca1\u0cbf\u0c8e\u0c90 \u0c9c\u0cca\u0ca4\u0cc6 \u0caa\u0ca4\u0ccd\u0cb0\u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c88 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf.",paymentText:"\u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0c97\u0cc6 50 / - \u0cb0\u0cc2 (\u0c9c\u0cbf\u0c8e\u0cb8\u0ccd\u200c\u0c9f\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0caa\u0cc0\u0ca1\u0ccd \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0cb3\u0c97\u0cca\u0c82\u0ca1\u0c82\u0ca4\u0cc6) \u0cb5\u0cbf\u0ca7\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",redirectInfo:" \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cbf \u0cac\u0c9f\u0ca8\u0ccd \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cbe\u0c97, \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 PayU \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0c97\u0cc7\u0c9f\u0ccd\u200c\u0cb5\u0cc7\u0c97\u0cc6 \u0cae\u0cb0\u0cc1\u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cc7\u0cb6\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf, \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cc3\u0ca4\u0cbf \u0cb8\u0ccd\u0cb2\u0cbf\u0caa\u0ccd \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0c88 \u0caa\u0cc1\u0c9f\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cb0\u0cc1\u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cc7\u0cb6\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0ca6\u0cb0\u0cc6, \u0ca8\u0cc0\u0cb5\u0cc1 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cb2\u0cb5\u0cc1 \u0cac\u0cbe\u0cb0\u0cbf \u0cae\u0cb0\u0cc1\u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",button:{cancel:"\u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0cae\u0cbe\u0ca1\u0cbf",makePayment:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cbf"}}},status:{srnField:"\u0c8e\u0cb8\u0ccd.\u0c86\u0cb0\u0ccd.\u0c8e\u0ca8\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",table:{srn:"\u0c8e\u0cb8\u0ccd \u0c86\u0cb0\u0ccd \u0c8e\u0ca8\u0ccd",orderDate:"\u0c86\u0ca6\u0cc7\u0cb6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95",currentStatus:"\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf",awb:"\u0c8f\u0cb0\u0ccd \u0cb5\u0cc7 \u0cac\u0cbf\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",dispatchDate:"\u0cb0\u0cb5\u0cbe\u0ca8\u0cc6\u0caf \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95",awb_subText:"\u0cae\u0cc7\u0cb2\u0cbf\u0ca8 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 'www.indiapost.gov.in' \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c9f\u0ccd\u0cb0\u0ccd\u0caf\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1",demographic:"\u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cc6 \u0c95\u0cbe\u0cb0\u0ca3\u0c97\u0cb3\u0cbf\u0c82\u0ca6\u0cbe\u0c97\u0cbf, \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0ca1\u0cc6\u0cae\u0cca\u0c97\u0ccd\u0cb0\u0cbe\u0cab\u0cbf\u0c95\u0ccd  \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb9\u0cbf\u0cb0\u0c82\u0c97\u0caa\u0ca1\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2. \u0c86\u0ca6\u0cb0\u0cc6 \u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8 \u0c87\u0ca4\u0ccd\u0ca4\u0cc0\u0c9a\u0cbf\u0ca8 \u0ca1\u0cc6\u0cae\u0cca\u0c97\u0ccd\u0cb0\u0cbe\u0cab\u0cbf\u0c95\u0ccd  \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."}}},aadharStatus:{title:"\u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",description:{one:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6\u0caf\u0cc7 \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6\u0caf\u0cc7 \u0c8e\u0c82\u0ca6\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf .",twoEID:"\u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf/\u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c95\u0ccd\u0c95\u0cc6 \u0cad\u0ccc\u0ca4\u0cbf\u0c95\u0cb5\u0cbe\u0c97\u0cbf \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5\u0cbe\u0c97 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cc3\u0ca4\u0cbf \u0c9a\u0cc0\u0c9f\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0cb5 14 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 \u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",twoSRN:"\u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf/\u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c95\u0ccd\u0c95\u0cc6 \u0cad\u0ccc\u0ca4\u0cbf\u0c95\u0cb5\u0cbe\u0c97\u0cbf \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5\u0cbe\u0c97 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cc3\u0ca4\u0cbf \u0c9a\u0cc0\u0c9f\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0cb5 14 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 \u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",twoURN:"'mAadhaar' \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5\u0cbe\u0c97 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cc3\u0ca4\u0cbf \u0c9a\u0cc0\u0c9f\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 8 \u0c85\u0c82\u0c95\u0cc6\u0c97\u0cb3 URN",twoSID:"\u2018S\u2019 followed by 27 digits, printed on acknowledgement slip while physically visiting Enrolment / Update center. Sample: S123456789123456789123456789",three:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c87\u0c90\u0ca1\u0cbf \u0c95\u0cb3\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0c82\u0ca1\u0cb0\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0c95\u0cb3\u0cc6\u0ca6\u0cc1\u0cb9\u0ccb\u0ca6 \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0cb0\u0cc6\u0ca4\u0cc1\u0cb9\u0ccb\u0ca6 \u0c87\u0c90\u0ca1\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cbf\u0c82\u0caa\u0ca1\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1."},optionalMessage:"\u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cbe\u0cb0 \u0caa\u0ca4\u0ccd\u0cb0\u0ca6 \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cae\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (<b>\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95</b>)"},complaintStatus:{title:"\u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 / \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",form:{complaintNumber:"\u0cb8\u0cc7\u0cb5\u0cbe \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",QRCid:"Qrc Id",status:"\u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf",ComplaintNumber:"\u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 / \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",ResolutionResponse:"\u0cb0\u0cc6\u0cb8\u0cb2\u0ccd\u0caf\u0cc2\u0cb6\u0ca8\u0ccd \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6"}},fileComplaint:{title:"\u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6",description:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",disclaimer:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd, \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf \u0cac\u0cb3\u0cb8\u0cc1\u0cb5 \u0ca1\u0cbf\u0c9c\u0cbf\u0c9f\u0cb2\u0ccd \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbe\u0c97\u0cbf, \u0cb9\u0cb2\u0cb5\u0cbe\u0cb0\u0cc1 \u0cb8\u0cac\u0ccd\u0cb8\u0cbf\u0ca1\u0cbf\u0c97\u0cb3\u0cc1, \u0caa\u0ccd\u0cb0\u0caf\u0ccb\u0c9c\u0ca8\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c85\u0ca6\u0cc7 \u0ca6\u0cc3\u0cb7\u0ccd\u0c9f\u0cbf\u0caf\u0cbf\u0c82\u0ca6, \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe\u0cac\u0cc7\u0cb8\u0ccd\u200c\u0ca8 \u0ca8\u0cbf\u0c96\u0cb0\u0ca4\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cbe\u0caa\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1, \u0caf\u0cc1\u0c90\u0ca1\u0cbf\u0c8e\u0c90 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb5\u0ccd\u0caf\u0cbe\u0caf\u0cbe\u0cae\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf\u0ca6\u0cc6. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe\u0cac\u0cc7\u0cb8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c95\u0cc8\u0c97\u0cca\u0c82\u0ca1 \u0c9a\u0c9f\u0cc1\u0cb5\u0c9f\u0cbf\u0c95\u0cc6\u0c97\u0cb3 \u0cb8\u0c82\u0ca6\u0cb0\u0ccd\u0cad\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf, \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cbf\u0c97\u0cc6 \u0c95\u0cbe\u0cb2\u0c95\u0cbe\u0cb2\u0c95\u0ccd\u0c95\u0cc6 \u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c88 \u0cb8\u0c82\u0cac\u0c82\u0ca7 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0cb2\u0ccd\u0cb2 \u0c8e\u0c82\u0ca6\u0cc1 \u0cb8\u0ccd\u0caa\u0cb7\u0ccd\u0c9f\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6. \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0c88 \u0cb5\u0cbf\u0cb7\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0c85\u0cb5\u0cb0\u0cc1 \u0ca4\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c85\u0c82\u0ca4\u0cb9 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0caa\u0cb0\u0cbf\u0cb9\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1.",form:{heading:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",state:"\u0cb0\u0cbe\u0c9c\u0ccd\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",enquirer:"\u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 / \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 (\u0cb8\u0ccd\u0cb5\u0caf\u0c82/\u0c87\u0ca4\u0cb0\u0cb0\u0cbf\u0c97\u0cc6)",complaintType:"\u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 / \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",categoryType:"\u0cb5\u0cb0\u0ccd\u0c97\u0ca6 \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",uploadDocumentLabel:"\u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf (\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cbe\u0ca6\u0cb0\u0cc2 \u0c87\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6)",statusField:"EID / SRN / URN \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",placeholder:"\u0c86\u0ca4\u0ccd\u0cae\u0cc0\u0caf \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cb3\u0cc7, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cbe\u0cb3\u0c9c\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0ca3\u0cbe\u0cae\u0c95\u0cbe\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0caa\u0cb0\u0cbf\u0cb9\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 {{fields}} \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0cb5\u0c82\u0ca4\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.",error:{complaintType:"\u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 / \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0cb2\u0ccd\u0cb2",categoryType:"\u0cb5\u0cb0\u0ccd\u0c97\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0cb2\u0ccd\u0cb2",state:"\u0cb0\u0cbe\u0c9c\u0ccd\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0cb2\u0ccd\u0cb2",enquirer:"\u0c8e\u0ca8\u0ccd\u0c95\u0ccd\u0cb5\u0cc8\u0cb0\u0cb0\u0ccd \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0cb2\u0ccd\u0cb2"}},Complaintnote:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6\u0caf \u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0caa\u0cb0\u0cbf\u0cb9\u0cbe\u0cb0\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0ca6\u0cc2\u0cb0\u0cc1 / \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cac\u0cb2\u0cb5\u0cbe\u0c97\u0cbf \u0cb8\u0cb2\u0cb9\u0cc6 \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca4\u0caa\u0ccd\u0caa\u0cbe\u0ca6 \u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 / \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0\u0ca6 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0caf\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb5\u0cbf\u0cb3\u0c82\u0cac\u0c95\u0ccd\u0c95\u0cc6 \u0c95\u0cbe\u0cb0\u0ca3\u0cb5\u0cbe\u0c97\u0cac\u0cb9\u0cc1\u0ca6\u0cc1",Categorynote:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6\u0caf \u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0caa\u0cb0\u0cbf\u0cb9\u0cbe\u0cb0\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0cb5\u0cb0\u0ccd\u0c97 \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cac\u0cb2\u0cb5\u0cbe\u0c97\u0cbf \u0cb8\u0cb2\u0cb9\u0cc6 \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca4\u0caa\u0ccd\u0caa\u0cc1 \u0cb5\u0cb0\u0ccd\u0c97\u0ca6 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0caf\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb5\u0cbf\u0cb3\u0c82\u0cac\u0c95\u0ccd\u0c95\u0cc6 \u0c95\u0cbe\u0cb0\u0ca3\u0cb5\u0cbe\u0c97\u0cac\u0cb9\u0cc1\u0ca6\u0cc1",feedbackTextArea:" \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf",feedback:"\u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 \u0cb0\u0cc7\u0c9f\u0cbf\u0c82\u0c97\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 / \u0caa\u0ccd