u0915\u094b {{-dob}} \u092e\u0947\u0902 \u092c\u0926\u0932\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?",description:"\u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f '\u0920\u0940\u0915 \u0939\u0948' \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"}},genderForm:{currentSection:{title:"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0935\u093f\u0935\u0930\u0923",fields:{}},updateSection:{title:"\u0935\u093f\u0935\u0930\u0923 \u0905\u092a\u0921\u0947\u091f \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u0939\u0948"},options:{male:"\u092a\u0941\u0930\u0941\u0937",female:"\u092e\u0939\u093f\u0932\u093e",transgender:"\u091f\u094d\u0930\u093e\u0902\u0938\u091c\u0947\u0902\u0921\u0930"},confirmationPopUp:{heading:"\u0915\u094d\u092f\u093e \u0906\u092a \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a \u0905\u092a\u0928\u0947 \u0932\u093f\u0902\u0917 \u0915\u094b {{gender}} \u092e\u0947\u0902 \u092c\u0926\u0932\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?",description:"\u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f '\u0920\u0940\u0915 \u0939\u0948' \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"}},addressForm:{currentSection:{title:"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0935\u093f\u0935\u0930\u0923",fields:{currentLocalAddress:"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092a\u0924\u093e"}},updateSection:{title:"\u0935\u093f\u0935\u0930\u0923 \u0905\u092a\u0921\u0947\u091f \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u0939\u0948",fields:{documentType:"\u092e\u093e\u0928\u094d\u092f \u0938\u0939\u093e\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902\u0964",documentTypeError:"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u09