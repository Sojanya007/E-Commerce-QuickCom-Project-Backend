7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0ab9\u0abe\u0aaf\u0a95 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb\u0aa8\u0ac0 \u0aaf\u0abe\u0aa6\u0ac0",serviceCards:{downloadAadhaar:{title:"\u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb",description:"\u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac0 \u0aa1\u0abf\u0a9c\u0abf\u0a9f\u0ab2 \u0ab8\u0ab9\u0ac0 \u0aa5\u0aaf\u0ac7\u0ab2 \u0a85\u0aa8\u0ac7 \u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1\u0aa5\u0ac0 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0a87\u0ab2\u0ac7\u0a95\u0acd\u0a9f\u0acd\u0ab0\u0acb\u0aa8\u0abf\u0a95 \u0a95\u0acb\u0aaa\u0ac0 \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb"},orderPVC:{title:"\u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ac0\u0ab5\u0ac0\u0ab8\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aa1\u0aa8\u0acb \u0a93\u0ab0\u0acd\u0aa1\u0ab0 \u0a86\u0aaa\u0acb",description:"\u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4, \u0ab5\u0ac9\u0ab2\u0ac7\u0a9f \u0a95\u0aa6\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ac0\u0ab5\u0ac0\u0ab8\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aa1\u0aa8\u0acb \u0a93\u0ab0\u0acd\u0aa1\u0ab0 \u0a86\u0aaa\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb"},retrieveEID:{title:"\u0a87\u0a86\u0a88\u0aa1\u0ac0 / \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aaa\u0abe\u0a9b\u0acb \u0aae\u0ac7\u0ab3\u0ab5\u0acb",description:"\u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0a85\u0aa5\u0ab5\u0abe \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0a86\u0a88\u0aa1\u0ac0 (\u0a87\u0a86\u0a88\u0aa1\u0ac0) \u0ab6\u0acb\u0aa7\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb."},verifyMobile:{title:"\u0a87\u0aae\u0ac7\u0a87\u0ab2 / \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0a9a\u0a95\u0abe\u0ab8\u0acb",description:"\u