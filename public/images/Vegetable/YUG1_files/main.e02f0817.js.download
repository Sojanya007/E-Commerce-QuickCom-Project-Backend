6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09a4\u09c7 \u09a6\u09af\u09bc\u09be \u0995\u09b0\u09c7 '\u09a0\u09bf\u0995 \u0986\u099b\u09c7'\u09a4\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\u0964"}},addressForm:{currentSection:{title:"\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09ac\u09bf\u09b6\u09a6",fields:{currentLocalAddress:"\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09a0\u09bf\u0995\u09be\u09a8\u09be"}},updateSection:{title:"\u09ac\u09bf\u09b6\u09a6\u0997\u09c1\u09b2\u09bf \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be \u09b9\u09ac\u09c7",fields:{documentType:"\u09ac\u09c8\u09a7 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8\u0995\u09be\u09b0\u09c0 \u09a1\u0995\u09c1\u09ae\u09c7\u09a8\u09cd\u099f \u098f\u09b0 \u09aa\u09cd\u09b0\u0995\u09be\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8",documentTypeError:"\u09a6\u09b8\u09cd\u09a4\u09be\u09ac\u09c7\u099c\u09c7\u09b0 \u09aa\u09cd\u09b0\u0995\u09be\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09a8\u09bf",uploadDocumentLabel:"\u09ac\u09bf\u09b6\u09a6 \u098f\u09ac\u0982 \u0986\u09aa\u09b2\u09cb\u09a1 \u09a8\u09a5\u09bf \u09a6\u09c7\u0996\u09c1\u09a8",clear:"\u09aa\u09b0\u09bf\u09b7\u09cd\u0995\u09be\u09b0 \u0995\u09b0\u09c1\u09a8"}}},preview:{fields:{newLocalName:"\u09a8\u09a4\u09c1\u09a8 \u09a8\u09be\u09ae",newLocalGender:"\u09a8\u09a4\u09c1\u09a8 \u09b2\u09bf\u0999\u09cd\u0997",newLocalAddress:"\u09a8\u09a4\u09c1\u09a8 \u09a0\u09bf\u0995\u09be\u09a8\u09be",updateLanguage:"\u0986\u09aa\u09a1\u09c7\u099f \u09b9\u0993\u09df\u09be \u09b8\u09cd\u09a5\u09be\u09a8\u09c0\u09df \u09ad\u09be\u09b7\u09be \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be \u0995\u09b0\u09c1\u09a8",updateName:"\u0986\u09aa\u09a1\u09c7\u099f \u09b9\u0993\u09af\u09bc\u09be \u09a8\u09be\u09ae \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be \u0995\u09b0\u09c1\u09a8",updateDOB:"\u0986\u09aa\u09a1\u09c7\u099f \u09b9\u0993\u09af\u09bc\u09be \u099c\u09a8\u09cd\u09ae\u09a4\u09bf\u09a5\u09bf \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be \u0995\u09b0\u09c1\u09a8",updateGender:"\u0986\u09aa\u09a1\u09c7\u099f \u09b2\u09bf\u0999\u09cd\u0997 \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be \u0995\u09b0\u09c1\u09a8",updateAddress:"\u0986\u09aa\u09a1\u09c7\u099f \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be \u0995\u09b0\u09c1\u09a8"},edit:"\u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be \u0995\u09b0\u09c1\u09a8",supportingDocuments:"\u09b8\u09ae\u09b0\u09cd\u09a5\u09a8\u0995\u09be\u09b0\u09c0 \u09a6\u09b8\u09cd\u09a4\u09be\u09ac\u09c7\u099c\u09b8\u09ae\u09c2\u09b9",dataFields:"\u09a8\u09ac\u09c0\u0995\u09b0\u09a3 \u0995\u09b0\u09be \u09a4\u09a5\u09cd\u09af \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09b8\u09ae\u09c2\u09b9",transliterationText:"\u0987\u0989\u0986\u0987\u09a1\u09bf\u098f\u0986\u0987 \u0995\u09c7 \u09af\u09c7 \u0995\u09cb\u09a8\u09cb \u09b2\u09bf\u09aa\u09cd\u09af\u09a8\u09cd\u09a4\u09b0 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u09a4\u09cd\u09b0\u09c1\u099f\u09bf \u09b8\u0982\u09b6\u09cb\u09a7\u09a8 \u0995\u09b0\u09be\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09a8, \u09af\u09c7\u099f\u09be \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 |",acceptTermsText:"\u0986\u09ae\u09bf \u098f\u09a4\u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u099b\u09bf \u09af\u09c7, \u0986\u09ae\u09bf \u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09be\u09ac\u09b2\u09c0 \u09ae\u09a8\u09cb\u09af\u09cb\u0997 \u09b8\u09b9\u0995\u09be\u09b0\u09c7 \u09aa\u09a1\u09bc\u09c7\u099b\u09bf \u098f\u09ac\u0982 \u0986\u09ae\u09be\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0987\u0989\u0986\u0987\u09a1\u09bf\u098f\u0986\u0987 \u0995\u09c7 \u09aa\u09cd\u09b0\u09a6\u09a4\u09cd\u09a4 \u09a4\u09a5\u09cd\u09af\u0997\u09c1\u09b2\u09bf \u09b8\u09a4\u09cd\u09af \u098f\u09ac\u0982 \u09b8\u09a0\u09bf\u0995\u0964",acceptTermsText_p1:"\u0986\u09ae\u09bf \u098f\u09a4\u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u099b\u09bf \u098f\u09ac\u0982 \u0998\u09cb\u09b7\u09a3\u09be \u0995\u09b0\u099b\u09bf \u09af\u09c7 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b8\u09ae\u09b8\u09cd\u09a4 \u09a4\u09a5\u09cd\u09af \u098f\u09ac\u0982 \u09a8\u09a5\u09bf \u0986\u09ae\u09be\u09b0 \u09b8\u09b0\u09cd\u09ac\u09cb\u09a4\u09cd\u09a4\u09ae \u099c\u09cd\u099e\u09be\u09a8 \u098f\u09ac\u0982 \u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8 \u0985\u09a8\u09c1\u09b8\u09be\u09b0\u09c7 \u09b8\u09a0\u09bf\u0995\u0964",acceptTermsText_p2:"\u0986\u09ae\u09bf \u09ac\u09c1\u099d\u09bf \u09af\u09c7 \u0989\u09aa\u09b0\u09c7\u09b0 \u0998\u09cb\u09b7\u09a3\u09be\u099f\u09bf \u09ad\u09c1\u09b2 \u09ac\u09b2\u09c7 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09bf\u09a4 \u09b9\u09b2\u09c7, \u0986\u09ae\u09be\u09b0 \u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09a8\u09bf\u09b7\u09cd\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u0995\u09b0\u09be \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u098f\u09ac\u0982 \u0989\u09aa\u09b0\u09a8\u09cd\u09a4\u09c1, \u0986\u0987\u09a8 \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u0986\u09ae\u09be\u09b0 \u09ac\u09bf\u09b0\u09c1\u09a6\u09cd\u09a7\u09c7 \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be \u09a8\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964",acceptTermsText_p3:"\u0986\u09ae\u09bf \u09ac\u09c1\u099d\u09bf \u09af\u09c7 \u0989\u09aa\u09b0\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af\u0997\u09c1\u09b2\u09bf \u0986\u09a7\u09be\u09b0 (\u0986\u09b0\u09cd\u09a5\u09bf\u0995 \u098f\u09ac\u0982 \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u09ad\u09b0\u09cd\u09a4\u09c1\u0995\u09bf, \u09b8\u09c1\u09ac\u09bf\u09a7\u09be \u098f\u09ac\u0982 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u0997\u09c1\u09b2\u09bf\u09b0 \u09b2\u0995\u09cd\u09b7\u09cd\u09af\u09af\u09c1\u0995\u09cd\u09a4 \u09ac\u09bf\u09a4\u09b0\u09a3) \u0986\u0987\u09a8, 2016 \u098f\u09ac\u0982 \u098f\u09b0 \u0985\u09a7\u09c0\u09a8\u09c7 \u09aa\u09cd\u09b0\u09a3\u09c0\u09a4 \u09aa\u09cd\u09b0\u09ac\u09bf\u09a7\u09be\u09a8 \u0985\u09a8\u09c1\u09b8\u09be\u09b0\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0, \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u09ac\u09be \u09ad\u09be\u0997 \u0995\u09b0\u09be \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09f7",acceptTermsText_p4:"\u0986\u09ae\u09bf \u098f\u09a4\u09a6\u09cd\u09ac\u09be\u09b0\u09be \u098f\u0987 \u09a7\u09b0\u09a8\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af\u09c7\u09b0 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09c1\u09a4\u09bf \u09ac\u09be \u09b0\u0995\u09cd\u09b7\u09a3\u09be\u09ac\u09c7\u0995\u09cd\u09b7\u09a3\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u0995\u09b0\u09cd\u09a4\u09c3\u09aa\u0995\u09cd\u09b7\u09c7\u09b0 \u09a1\u09c7\u099f\u09be\u09ac\u09c7\u09b8 \u09a5\u09c7\u0995\u09c7 \u09aa\u09b0\u09bf\u099a\u09af\u09bc, \u09a0\u09bf\u0995\u09be\u09a8\u09be, \u099c\u09a8\u09cd\u09ae \u098f\u09ac\u0982/\u0985\u09a5\u09ac\u09be \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 \u0987\u09b2\u09c7\u0995\u099f\u09cd\u09b0\u09a8\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u09a4\u09a5\u09cd\u09af \u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09a4\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u09ac\u0982 \u09b8\u09b0\u0995\u09be\u09b0\u09c0 \u09b8\u0982\u09b8\u09cd\u09a5\u09be \u098f\u09ac\u0982/\u0985\u09a5\u09ac\u09be \u0989\u09aa\u09b0\u09cb\u0995\u09cd\u09a4 \u09a4\u09a5\u09cd\u09af \u098f\u09ac\u0982 \u09a8\u09a5\u09bf\u0997\u09c1\u09b2\u09bf \u09ad\u09be\u0997 \u0995\u09b0\u09c7 \u09a8\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09ae\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u09a6\u09bf\u099a\u09cd\u099b\u09bf \u098f\u0987 \u09a7\u09b0\u09a8\u09c7\u09b0 \u0995\u09cb\u09a8\u09cb \u0995\u09b0\u09cd\u09a4\u09c3\u09aa\u0995\u09cd\u09b7, \u09af\u09be\u099a\u09be\u0987\u0995\u09b0\u09a3\u09c7\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7\u0964",acceptTermsText_p5:"\u0986\u09ae\u09bf \u098f\u0987 \u0998\u09cb\u09b7\u09a3\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u098f\u0995\u09ae\u09a4\u0964",errorPop:{error:"\u09a4\u09cd\u09b0\u09c1\u099f\u09bf!",close:"\u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09c1\u09a8"}}},payment:{paymentOptions:{text:"\u098f\u0995\u099f\u09bf \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09ac\u09bf\u0995\u09b2\u09cd\u09aa \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8"},makePayment:{welcomeText:"\u09aa\u09cd\u09b0\u09bf\u09df \u09ac\u09be\u09b8\u09bf\u09a8\u09cd\u09a6\u09be,",documentPaymentInfo:"\u09a1\u0995\u09c1\u09ae\u09c7\u09a8\u09cd\u099f \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u099f\u09be\u0995\u09be {{paymentAmount}} \u099a\u09be\u09b0\u09cd\u099c \u0995\u09b0\u09be \u09b9\u09ac\u09c7\u0964",paymentInfo:" \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u0986\u09aa\u09a1\u09c7\u099f \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u099f\u09bf \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09be\u09b0 \u09a5\u09c7\u0995\u09c7 \u09eb\u09e6/- \u099f\u09be\u0995\u09be \u099a\u09be\u09b0\u09cd\u099c \u09a8\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09ac\u09c7\u0964",linkText:"\u0986\u09aa\u09a8\u09bf \u098f\u0996\u09be\u09a8\u09c7 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f\u09b8 / \u09ac\u09be\u09a4\u09bf\u09b2\u0995\u09b0\u09a3 / \u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1\u09b8 \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u0986\u09b0\u0993 \u09a4\u09a5\u09cd\u09af \u09aa\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8",acceptTerms:"\u0986\u09ae\u09bf \u098f\u09a4\u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u099b\u09bf \u09af\u09c7, \u0986\u09ae\u09bf \u0985\u09b0\u09cd\u09a5 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 / \u09ac\u09be\u09a4\u09bf\u09b2\u0995\u09b0\u09a3 / \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09b0\u09cd\u09aa\u09a3 \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u099f\u09bf \u09aa\u09a1\u09bc\u09c7\u099b\u09bf \u098f\u09ac\u0982 \u09ac\u09c1\u099d\u09a4\u09c7 \u09aa\u09c7\u09b0\u09c7\u099b\u09bf\u0964",poweredBy:"\u09a6\u09cd\u09ac\u09be\u09b0\u09be \u099a\u09be\u09b2\u09bf\u09a4"},paymentStatus:{transactionStatus:"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf",reason:"\u0995\u09be\u09b0\u09a3",dateAndTime:"\u09aa\u09cd\u09b0\u09a6\u09be\u09a8\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996 \u098f\u09ac\u0982 \u09b8\u09ae\u09af\u09bc",amount:"\u099f\u09be\u0995\u09be\u09b0 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3",failed:"\u09ac\u09cd\u09af\u09b0\u09cd\u09a5",success:"\u09b8\u09ab\u09b2\u09a4\u09be",downloadAckText:"\u09b8\u09cd\u09ac\u09c0\u0995\u09c3\u09a4\u09bf \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8"},paymentPopup:{estTime:"\u0986\u09a8\u09c1\u09ae\u09be\u09a8\u09bf\u0995 \u09b8\u09ae\u09af\u09bc",description:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7, \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u099f\u09be \u09b8\u09ae\u09cd\u09aa\u09c1\u09b0\u09cd\u09a8 \u0995\u09b0\u09be \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u098f\u09ac\u0982 \u09b8\u09cd\u09ac\u09c0\u0995\u09c3\u09a4\u09bf \u09b8\u09cd\u09b2\u09bf\u09aa \u0989\u09a4\u09cd\u09aa\u09a8\u09cd\u09a8 \u0995\u09b0\u09c1\u09a8 |"}}},myHofRequests:{title:"\u0986\u09ae\u09be\u09b0 \u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 (\u098f\u0987\u099a\u0993\u098f\u09ab) \u0985\u09a8\u09c1\u09b0\u09cb\u09a7",description:"\u098f\u0987\u099a\u0993\u098f\u09ab \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8",forms:{title:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 SRN \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u099c\u09be\u09a8\u09a4\u09c7 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u0995\u09b0\u09c1\u09a8",label:"\u098f\u09b8\u0986\u09b0\u098f\u09a8 \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c1\u09a8 ",buttons:{decline:"\u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u0996\u09cd\u09af\u09be\u09a8",accept:"\u09b8\u09cd\u09ac\u09c0\u0995\u09be\u09b0 \u0995\u09b0\u09be "},displayMsg:{case1:"\u0986\u09aa\u09a8\u09bf \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af {{resident}} \u098f\u09b0 \u09a5\u09c7\u0995\u09c7 \u0989\u09aa\u09b0\u09bf\u0995\u09cd\u09a4 SRN-\u098f \u098f\u0995\u099f\u09bf \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09aa\u09c7\u09af\u09bc\u09c7\u099b\u09c7\u09a8\u0964",case2:"\u0986\u09aa\u09a8\u09bf {{resident}} \u098f\u09b0 \u09b8\u0999\u09cd\u0997\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09b6\u09c7\u09df\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09a8 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09c7\u09a8\u09f7",case3:"\u0986\u09aa\u09a8\u09bf {{resident}} \u098f\u09b0 \u09b8\u0999\u09cd\u0997\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u0985\u09b8\u09cd\u09ac\u09c0\u0995\u09be\u09b0 \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u09f7",case4:"\u0989\u09aa\u09b0\u09bf\u0995\u09cd\u09a4 \u098f\u09b8\u0986\u09b0\u098f\u09a8-\u098f \u0995\u09cb\u09a8\u09cb \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\u0964"},acceptScreen:{acceptMsg:"\u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09b6\u09c7\u09df\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u099f\u09bf \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u0964",declineMsg:"\u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09b6\u09c7\u09df\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u099f\u09bf \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u0996\u09cd\u09af\u09be\u09a8 \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u09f7"},confirmationPopUp:{rejectPrompt:"\u0986\u09aa\u09a8\u09bf \u0995\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u09af\u09c7 \u0986\u09aa\u09a8\u09bf \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09b6\u09c7\u09df\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099f\u09bf \u098f\u0987\u099a\u0993\u098f\u09ab \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u099f\u09bf \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u0996\u09cd\u09af\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8?",acceptPrompt:"\u0986\u09aa\u09a8\u09bf \u0995\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u09af\u09c7 \u0986\u09aa\u09a8\u09bf \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09b6\u09c7\u09df\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099f\u09bf \u098f\u0987\u099a\u0993\u098f\u09ab \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u099f\u09bf \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8?"}}},pvc:{oauth:{preview:{sectionHeading:"\u0986\u09a7\u09be\u09b0 \u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0995\u09be\u09b0\u09cd\u09a1\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u09a6\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u0986\u0997\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09a4\u09be\u09a4\u09cd\u09a4\u09cd\u09ac\u09bf\u0995 \u09ac\u09bf\u09b6\u09a6\u099f\u09bf \u09aa\u09c2\u09b0\u09cd\u09ac\u09b2\u09cb\u0995\u09a8 \u0995\u09b0\u09c1\u09a8",sectionText:'\u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0995\u09cb\u09a8\u09cb \u0985\u09b6\u09c1\u09a6\u09cd\u09a7\u09a4\u09be/ \u09a8\u09bf\u0996\u09cb\u0981\u099c/ \u09aa\u09c1\u09b0\u09be\u09a8\u09cb/ \u09aa\u09c1\u09b0\u09be\u09a8\u09cb \u09a4\u09a5\u09cd\u09af \u0996\u09c1\u0981\u099c\u09c7 \u09aa\u09be\u09a8,\u09a4\u09ac\u09c7 \u0986\u09aa\u09a8\u09bf \u09a8\u09bf\u0995\u099f\u09a4\u09ae \u0986\u09a7\u09be\u09b0 \u09b8\u09c7\u09ac\u09be \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u09c7 \u0997\u09bf\u09af\u09bc\u09c7 \u09ac\u09be \u098f\u0987 \u09aa\u09cb\u09b0\u09cd\u099f\u09be\u09b2 \u09a5\u09c7\u0995\u09c7 " \u0986\u09aa\u09a1\u09c7\u099f \u0986\u09a7\u09be\u09b0 \u09a4\u09a5\u09cd\u09af" \u09ac\u09bf\u0995\u09b2\u09cd\u09aa\u099f\u09bf \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u0995\u09b0\u09c7 \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0\u099f\u09bf \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be\u09b0 \u09ac\u09bf\u0995\u09b2\u09cd\u09aa \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964',name:"\u09a8\u09be\u09ae",dob:"\u099c\u09a8\u09cd\u09ae\u09a4\u09bf\u09a5\u09bf",gender:"\u09b2\u09bf\u0999\u09cd\u0997",address:"\u09a0\u09bf\u0995\u09be\u09a8\u09be"}},generic:{form:{selectLabel:"\u09e7\u09e8 \u0985\u0999\u09cd\u0995\u09c7\u09b0 \u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0 / \u09e7\u09ea \u0985\u0999\u09cd\u0995\u09c7\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf \u0986\u0987\u09a1\u09bf \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8",radioLabels:{uid:"\u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0",eid:"\u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf \u0986\u0987\u09a1\u09bf \u09a8\u09ae\u09cd\u09ac\u09b0"},textFields:{uid:"\u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c1\u09a8",eid:"\u09e7\u09ea \u0985\u0999\u09cd\u0995\u09c7\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf \u09a8\u09ae\u09cd\u09ac\u09b0 \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c1\u09a8 ",generic:"\u098f\u09a8\u09b0\u09cb\u09b2\u09ae\u09c7\u09a8\u09cd\u099f \u0986\u0987\u09a1\u09bf, \u098f\u09b8\u0986\u09b0\u098f\u09a8 \u09ac\u09be \u0987\u0989\u0986\u09b0\u098f\u09a8 \u09b2\u09bf\u0996\u09c1\u09a8",mobile:"\u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c1\u09a8 ",otp:"\u0993\u099f\u09bf\u09aa\u09bf \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c1\u09a8",securityCode:"\u0995\u09cd\u09af\u09be\u09aa\u099a\u09be \u09b2\u09bf\u0996\u09c1\u09a8"},checkBox:{mobile:"\u0986\u09ae\u09be\u09b0 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a8\u09ae\u09cd\u09ac\u09b0\u099f\u09bf \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u09a8\u09df",tnc:"\u09b6\u09b0\u09cd\u09a4\u09be\u09ac\u09b2\u09c0 \u098f\u09ac\u0982 \u09a8\u09bf\u09df\u09ae\u09be\u09ac\u09b2\u09c0"},button:{otp:"\u0993\u099f\u09bf\u09aa\u09bf \u09aa\u09cd\u09b0\u09c7\u09b0\u09a3 \u0995\u09b0\u09c1\u09a8",submit:"\u09a6\u09be\u0996\u09bf\u09b2 \u0995\u09b0\u09be"},modal:{mobile:"\u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0\u099f\u09bf \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a8\u09ae\u09cd\u09ac\u09b0\u09c7\u09b0 \u09b8\u0999\u09cd\u0997\u09c7 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u09b9\u09af\u09bc, \u0986\u09ae\u09b0\u09be \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09ae\u09be\u0987 \u0986\u09a7\u09be\u09b0 (myaadhaar.uidai.gov.in) \u098f \u09b2\u0997\u0987\u09a8 \u0995\u09b0\u09a4\u09c7 \u098f\u09ac\u0982 \u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0995\u09be\u09b0\u09cd\u09a1\u09c7\u09b0 \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u09a6\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0989\u09ce\u09b8\u09be\u09b9\u09bf\u09a4 \u0995\u09b0\u09ac\u09cb |",tnc:{heading:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0993\u098f\u09b8\u09bf \u09aa\u09cb\u09b0\u09cd\u099f\u09be\u09b2\u09c7 \u0986\u09aa\u09a1\u09c7\u099f \u09b9\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09bf\u09a4 '\u09a8\u09bf\u09df\u09ae\u09be\u09ac\u09b2\u09c0 \u0993 \u09b6\u09b0\u09cd\u09a4\u09be\u09ac\u09b2\u09c0\u09b0' \u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u09a8\u09c0\u099a\u09c7 \u0995\u09b0\u09c1\u09a8:",t1:"\u09e7. \u0986\u09ae\u09bf \u098f\u09a4\u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0986\u09ae\u09be\u09b0 \u0986\u09a7\u09be\u09b0 \u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0995\u09be\u09b0\u09cd\u09a1 \u09ae\u09c1\u09a6\u09cd\u09b0\u09a3\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09ae\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u099c\u09be\u09a8\u09be\u099a\u09cd\u099b\u09bf\u0964",t2:"\u09e8. \u0986\u09ae\u09bf \u09ac\u09c1\u099d\u09a4\u09c7 \u09aa\u09be\u09b0\u099b\u09bf \u09af\u09c7 \u0986\u09ae\u09be\u09b0 \u09ae\u09c1\u09a6\u09cd\u09b0\u09bf\u09a4 \u0986\u09a7\u09be\u09b0 \u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0995\u09be\u09b0\u09cd\u09a1\u099f\u09bf \u0986\u09ae\u09be\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09af\u09bc \u09aa\u09cc\u0981\u099b\u09c7 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09ac\u09c7, \u0986\u09a7\u09be\u09b0\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u09af\u09c7\u099f\u09bf \u09aa\u09bf\u09a8\u0995\u09cb\u09a1\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u098f\u09ac\u0982 \u09b8\u09a0\u09bf\u0995\u0964",t3:"\u09e9.\u0986\u09ae\u09bf \u098f\u09a4\u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u0986\u09a7\u09be\u09b0 \u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0995\u09be\u09b0\u09cd\u09a1 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u09a6\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u09eb\u09e6/ - \u099f\u09be\u0995\u09be ( \u099c\u09bf\u098f\u09b8\u099f\u09bf \u09b8\u09b9) \u09a6\u09bf\u09a4\u09c7 \u09b8\u09ae\u09cd\u09ae\u09a4\u0964",t4:"\u09ea. \u0986\u09ae\u09bf \u09ac\u09c1\u099d\u09a4\u09c7 \u09aa\u09be\u09b0\u099b\u09bf \u09af\u09c7 \u0986\u09a7\u09be\u09b0 \u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0995\u09be\u09b0\u09cd\u09a1 \u0987\u09a8\u09cd\u09a1\u09bf\u09df\u09be \u09aa\u09cb\u09b8\u09cd\u099f\u09c7\u09b0 \u09b8\u09cd\u09aa\u09bf\u09a1 \u09aa\u09cb\u09b7\u09cd\u099f \u09b8\u09be\u09b0\u09cd\u09ad\u09bf\u09b8\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u09b8\u09b0\u09ac\u09b0\u09be\u09b9\u09c7\u09b0 \u09a8\u09bf\u09af\u09bc\u09ae\u0997\u09c1\u09b2\u09bf\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09be\u09ae\u099e\u09cd\u099c\u09b8\u09cd\u09af \u09b0\u09c7\u0996\u09c7 \u09b8\u09b0\u09ac\u09b0\u09be\u09b9 \u0995\u09b0\u09be \u09b9\u09ac\u09c7\u0964\u0987\u09a8\u09cd\u09a1\u09bf\u09df\u09be \u09aa\u09cb\u09b8\u09cd\u099f\u09c7\u09b0 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf \u099f\u09cd\u09b0\u09cd\u09af\u09be\u0995\u09bf\u0982 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7 \u09a1\u09c7\u09b2\u09bf\u09ad\u09be\u09b0\u09bf \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf \u099f\u09cd\u09b0\u09cd\u09af\u09be\u0995 \u0995\u09b0\u09be \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964"}}},payment:{welcomeText:"\u09aa\u09cd\u09b0\u09bf\u09af\u09bc \u09ac\u09be\u09b8\u09bf\u09a8\u09cd\u09a6\u09be, ",srnInfo:"\u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u099f\u09bf \u0995\u09c7 \u098f\u09b8\u0986\u09b0\u098f\u09a8 # \u098f\u09b0 \u09b8\u09be\u09a5\u09c7 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964",trackInfo:"\u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u099f\u09cd\u09b0\u09cd\u09af\u09be\u0995\u09bf\u0982 \u098f\u09ac\u0982 \u0987\u0989\u0986\u0987\u09a1\u09bf\u098f\u0986\u0987\u09af\u09bc\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u099a\u09bf\u09a0\u09bf\u09aa\u09a4\u09cd\u09b0\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u098f\u0987 \u09a8\u09ae\u09cd\u09ac\u09b0\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\u0964",paymentText:"\u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0986\u09a7\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09be\u09b0 \u09a5\u09c7\u0995\u09c7 \u09eb\u09e6 / - \u099f\u09be\u0995\u09be (\u099c\u09bf\u098f\u09b8\u099f\u09bf \u0993 \u09b8\u09cd\u09aa\u09bf\u09a1 \u09aa\u09cb\u09b8\u09cd\u099f \u09b6\u09c1\u09b2\u09cd\u0995 \u09b8\u09b9) \u09b6\u09c1\u09b2\u09cd\u0995 \u09a8\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09ac\u09c7\u0964",redirectInfo:"\u0985\u09b0\u09cd\u09a5 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c1\u09a8 \u09ac\u09cb\u09a4\u09be\u09ae\u099f\u09bf \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09be\u09b0 \u09aa\u09b0\u09c7, \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09c7\u0987\u0987\u0989 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u0997\u09c7\u099f\u0993\u09af\u09bc\u09c7\u09a4\u09c7 \u09aa\u09c1\u09a8\u0983\u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09bf\u09a4 \u0995\u09b0\u09be \u09b9\u09ac\u09c7\u0964\u09b8\u09ab\u09b2 \u0985\u09b0\u09cd\u09a5\u09aa\u09cd\u09b0\u09a6\u09be\u09a8\u09c7\u09b0 \u09aa\u09b0\u09c7, \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09b8\u09cd\u09ac\u09c0\u0995\u09c3\u09a4\u09bf \u09b8\u09cd\u09b2\u09bf\u09aa \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0987 \u09aa\u09c3\u09b7\u09cd\u09a0\u09be\u09af\u09bc \u09aa\u09c1\u09a8\u0983\u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09bf\u09a4 \u0995\u09b0\u09be \u09b9\u09ac\u09c7\u0964\u09af\u09a6\u09bf \u0985\u09b0\u09cd\u09a5 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u09ac\u09cd\u09af\u09b0\u09cd\u09a5 \u09b9\u09af\u09bc, \u0986\u09aa\u09a8\u09bf \u098f\u0995\u09be\u09a7\u09bf\u0995\u09ac\u09be\u09b0 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09aa\u09c1\u09a8\u09b0\u09be\u09df \u0995\u09b0\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964",button:{cancel:"\u09ac\u09be\u09a4\u09bf\u09b2",makePayment:"\u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u0995\u09b0\u09c1\u09a8"}}},status:{srnField:"\u098f\u09b8\u0986\u09b0\u098f\u09a8 \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c1\u09a8 ",table:{srn:"\u098f\u09b8\u0986\u09b0\u098f\u09a8",orderDate:"\u0985\u09b0\u09cd\u09a1\u09be\u09b0\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996",currentStatus:"\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8  \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf",awb:"\u098f\u09af\u09bc\u09be\u09b0 \u0993\u09af\u09bc\u09c7 \u09ac\u09bf\u09b2 \u09a8\u09ae\u09cd\u09ac\u09b0",dispatchDate:"\u09aa\u09cd\u09b0\u09c7\u09b0\u09a3\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996",awb_subText:"\u0986\u09aa\u09a8\u09bf \u0989\u09aa\u09b0\u09c7\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7 'www.indiapost.gov.in' \u098f \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u099f\u09cd\u09b0\u09cd\u09af\u09be\u0995 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8 |",demographic:"\u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be\u09b0 \u0995\u09be\u09b0\u09a3\u09c7, \u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u099c\u09a8\u09a4\u09be\u09a4\u09cd\u09a4\u09cd\u09ac\u09bf\u0995 \u09a4\u09a5\u09cd\u09af \u09b0\u09be\u099c\u09cd\u09af\u09c7 \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u0995\u09b0\u09be \u09af\u09be\u09ac\u09c7 \u09a8\u09be\u0964 \u09a4\u09ac\u09c7 ,\u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u0995\u09b0\u09be \u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0995\u09be\u09b0\u09cd\u09a1\u09c7 \u0986\u09a7\u09be\u09b0\u09c7\u09b0 \u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u099c\u09a8\u09a4\u09be\u09a4\u09cd\u09a4\u09cd\u09ac\u09bf\u0995 \u09a4\u09a5\u09cd\u09af \u09a5\u09be\u0995\u09ac\u09c7\u0964"}}},aadharStatus:{title:"\u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf \u098f\u09ac\u0982 \u0986\u09aa\u09a1\u09c7\u099f \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8",description:{one:"\u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u09b9\u09df\u09c7\u099b\u09c7 \u09ac\u09be \u0986\u09aa\u09a1\u09c7\u099f \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u0995\u09bf\u09a8\u09be \u09a4\u09be \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8 \u0964",twoEID:"\u09a8\u09a5\u09bf\u09ad\u09c1\u0995\u09cd\u09a4\u09bf/\u0986\u09aa\u09a1\u09c7\u099f \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u09c7 \u09b6\u09be\u09b0\u09c0\u09b0\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u09af\u09be\u0993\u09af\u09bc\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u09b8\u09cd\u09ac\u09c0\u0995\u09c3\u09a4\u09bf \u09b8\u09cd\u09b2\u09bf\u09aa\u09c7 \u09ae\u09c1\u09a6\u09cd\u09b0\u09bf\u09a4 \u09e7\u09ea \u0985\u0999\u09cd\u0995\u09c7\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf \u09a8\u09ae\u09cd\u09ac\u09b0 |  \u09a8\u09ae\u09c1\u09a8\u09be: \u09e7\u09e8\u09e9\u09ea/\u09e7\u09e8\u09e9\u09ea\u09eb/\u09e7\u09e8\u09e9\u09ea\u09eb",twoSRN:"\u0985\u09a8\u09b2\u09be\u0987\u09a8 \u0986\u09aa\u09a1\u09c7\u099f \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u09b8\u09cd\u09ac\u09c0\u0995\u09c3\u09a4\u09bf \u09b8\u09cd\u09b2\u09bf\u09aa\u09c7 \u09ae\u09c1\u09a6\u09cd\u09b0\u09bf\u09a4 'S' \u098f\u09b0 \u09aa\u09b0\u09c7 \u09e7\u09e9\u099f\u09bf \u09b8\u0982\u0996\u09cd\u09af\u09be,  \u09a8\u09ae\u09c1\u09a8\u09be: \u09e7\u09e8\u09e9\u09ea\u09eb\u09ec\u09ed\u09ee\u09ef\u09e7\u09e8\u09e9\u09ea",twoURN:"'\u098f\u09ae\u0986\u09a7\u09be\u09b0' \u0985\u09cd\u09af\u09be\u09aa\u09cd\u09b2\u09bf\u0995\u09c7\u09b6\u09a8\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u09b8\u09cd\u09ac\u09c0\u0995\u09c3\u09a4\u09bf \u09b8\u09cd\u09b2\u09bf\u09aa\u09c7 \u09ae\u09c1\u09a6\u09cd\u09b0\u09bf\u09a4 \u09ee \u0985\u0999\u09cd\u0995\u09c7\u09b0 \u0987\u0989\u0986\u09b0\u098f\u09a8, \u09a8\u09ae\u09c1\u09a8\u09be: \u09e7\u09e8\u09e9\u09ea\u09eb\u09ec\u09ed\u09ee\"",twoSID:"\u2018S\u2019 followed by 27 digits, printed on acknowledgement slip while physically visiting Enrolment / Update center. Sample: S123456789123456789123456789",three:"\u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09bf \u0987\u0986\u0987\u09a1\u09bf \u09b9\u09be\u09b0\u09bf\u09af\u09bc\u09c7 \u09ab\u09c7\u09b2\u09c7\u09a8\u099b\u09c7\u09a8 \u09a4\u09ac\u09c7 \u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09b9\u09be\u09b0\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u0993\u09af\u09bc\u09be \u09ac\u09be \u09ad\u09c1\u09b2\u09c7 \u09af\u09be\u0993\u09af\u09bc\u09be \u0987\u0986\u0987\u09a1\u09bf \u09aa\u09c1\u09a8\u09b0\u09c1\u09a6\u09cd\u09a7\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964"},optionalMessage:"\u09b8\u09cd\u09ac\u09c0\u0995\u09c3\u09a4\u09bf \u09b8\u09cd\u09b2\u09bf\u09aa \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u09a4\u09be\u09b0\u09bf\u0996 \u098f\u09ac\u0982 \u09b8\u09ae\u09af\u09bc \u0989\u09b2\u09cd\u09b2\u09c7\u0996 \u0995\u09b0\u09c1\u09a8 (<b>\u0990\u099a\u09cd\u099b\u09bf\u0995</b>)"},complaintStatus:{title:"\u0985\u09ad\u09bf\u09af\u09cb\u0997/\u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u09b0 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8",form:{complaintNumber:"\u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09b2\u09bf\u0996\u09c1\u09a8",QRCid:"Qrc Id",status:"\u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09be\u09b8",ComplaintNumber:"\u0985\u09ad\u09bf\u09af\u09cb\u0997/\u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09a8\u09ae\u09cd\u09ac\u09b0",ResolutionResponse:"\u09b0\u09c7\u099c\u09cb\u09b2\u09bf\u0989\u09b6\u09a8 \u09b0\u09c7\u09b8\u09aa\u09a8\u09cd\u09b8"}},fileComplaint:{title:"\u0985\u09ad\u09bf\u09af\u09cb\u0997 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be",description:"\u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09ad\u09bf\u09af\u09cb\u0997 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09ab\u09be\u0987\u09b2 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8",disclaimer:"\u0986\u09a7\u09be\u09b0, \u09b8\u09b0\u09cd\u09ac\u09be\u09a7\u09bf\u0995 \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09a1\u09bf\u099c\u09bf\u099f\u09be\u09b2 \u09aa\u09b0\u09bf\u099a\u09af\u09bc \u09b9\u09bf\u09b8\u09be\u09ac\u09c7, \u0985\u09b8\u0982\u0996\u09cd\u09af \u09ad\u09b0\u09cd\u09a4\u09c1\u0995\u09bf, \u09b8\u09c1\u09ac\u09bf\u09a7\u09be \u098f\u09ac\u0982 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u0997\u09c1\u09b2\u09bf \u09aa\u09c7\u09a4\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09b9\u09af\u09bc\u0964 \u098f\u0995\u0987 \u09ac\u09bf\u09ac\u09c7\u099a\u09a8\u09be\u09af\u09bc, \u0986\u09a7\u09be\u09b0 \u09a1\u09be\u099f\u09be\u09ac\u09c7\u09b8\u09c7\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ad\u09c1\u09b2\u09a4\u09be \u09ac\u099c\u09be\u09af\u09bc \u09b0\u09be\u0996\u09be\u09b0 \u099c\u09a8\u09cd\u09af, UIDAI \u09a8\u09a5\u09bf \u098f\u09ac\u0982 \u0986\u09a7\u09be\u09b0 \u09a4\u09a5\u09cd\u09af \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099f\u09bf \u0985\u09a8\u09c1\u09b6\u09c0\u09b2\u09a8 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c7\u099b\u09bf\u09b2\u0964 \u0986\u09a7\u09be\u09b0 \u09a1\u09c7\u099f\u09be\u09ac\u09c7\u09b8 \u0986\u09aa\u09a1\u09c7\u099f \u09b0\u09be\u0996\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0997\u09c3\u09b9\u09c0\u09a4 \u0995\u09be\u09b0\u09cd\u09af\u0995\u09cd\u09b0\u09ae\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7, \u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09a7\u09be\u09b0\u0995\u09a6\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u09b8\u09ae\u09af\u09bc\u09c7 \u09b8\u09ae\u09af\u09bc\u09c7 \u09ac\u09bf\u099c\u09cd\u099e\u09aa\u09cd\u09a4\u09bf \u099c\u09be\u09b0\u09bf \u0995\u09b0\u09be \u09b9\u09af\u09bc\u0964 \u098f\u0987 \u09aa\u09cd\u09b0\u09b8\u0999\u09cd\u0997\u09c7, \u098f\u099f\u09bf \u09b8\u09cd\u09aa\u09b7\u09cd\u099f \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u09af\u09c7 \u0995\u09cb\u09a8\u0993 \u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09ac\u09be\u09a4\u09bf\u09b2 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09a8\u09bf\u0964 \u09af\u09a6\u09bf \u0995\u09cb\u09a8\u0993 \u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0\u09a7\u09be\u09b0\u09c0\u09b0 \u098f\u0987 \u09ac\u09bf\u09b7\u09af\u09bc\u09c7 \u0995\u09cb\u09a8\u0993 \u0985\u09ad\u09bf\u09af\u09cb\u0997 \u09a5\u09be\u0995\u09c7 \u09a4\u09ac\u09c7 \u09a4\u09be\u09b0\u09be \u098f\u0996\u09be\u09a8\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964 \u098f\u0987 \u09a7\u09b0\u09a8\u09c7\u09b0 \u09af\u09c7\u0995\u09cb\u09a8 \u0985\u09ad\u09bf\u09af\u09cb\u0997 \u09af\u09a5\u09be\u09af\u09a5\u09ad\u09be\u09ac\u09c7 \u09b8\u09ae\u09be\u09a7\u09be\u09a8 \u0995\u09b0\u09be \u09b9\u09ac\u09c7\u0964",form:{heading:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u09ac\u09bf\u09ac\u09b0\u09a3 \u09b2\u09bf\u0996\u09c1\u09a8",state:"\u09b0\u09be\u099c\u09cd\u09af\u09c7 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09c1\u09a8",enquirer:"(\u09a8\u09bf\u099c\u09c7\u09b0/\u0985\u09a8\u09cd\u09af\u09a6\u09c7\u09b0) \u099c\u09a8\u09cd\u09af \u0985\u09ad\u09bf\u09af\u09cb\u0997/\u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be",complaintType:"\u0985\u09ad\u09bf\u09af\u09cb\u0997/\u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u09b0 \u09a7\u09b0\u09a8 \u09b2\u09bf\u0996\u09c1\u09a8",categoryType:"\u0995\u09cd\u09af\u09be\u099f\u09be\u0997\u09b0\u09bf \u099f\u09be\u0987\u09aa \u09b2\u09bf\u0996\u09c1\u09a8",uploadDocumentLabel:"\u09ac\u09bf\u09ac\u09b0\u09a3 \u09a6\u09c7\u0996\u09c1\u09a8 \u098f\u09ac\u0982 \u09a8\u09a5\u09bf \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8 (\u09af\u09a6\u09bf \u09a5\u09be\u0995\u09c7)",statusField:"EID/SRN/URN \u09b2\u09bf\u0996\u09c1\u09a8",placeholder:"\u09aa\u09cd\u09b0\u09bf\u09af\u09bc \u09ac\u09be\u09b8\u09bf\u09a8\u09cd\u09a6\u09be, \u0986\u09aa\u09a8\u09be\u09b0 \u0989\u09a6\u09cd\u09ac\u09c7\u0997 \u0995\u09be\u09b0\u09cd\u09af\u0995\u09b0\u09ad\u09be\u09ac\u09c7 \u09b8\u09ae\u09be\u09a7\u09be\u09a8 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09be\u0995\u09c7 {{fields}} \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u0995\u09b0\u09be \u09b9\u099a\u09cd\u099b\u09c7\u0964",error:{complaintType:"\u0985\u09ad\u09bf\u09af\u09cb\u0997/\u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u09b0 \u09a7\u09b0\u09a8 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09a8\u09bf",categoryType:"\u09ac\u09bf\u09ad\u09be\u0997 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09a8\u09bf",state:"\u09b0\u09be\u099c\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4 \u09b9\u09af\u09bc\u09a8\u09bf",enquirer:"\u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8\u0995\u09be\u09b0\u09c0\u09b0 \u09a7\u09b0\u09a8 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09a8\u09bf"}},Complaintnote:"\u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09ad\u09bf\u09af\u09cb\u0997\u09c7\u09b0 \u09a6\u09cd\u09b0\u09c1\u09a4 \u09b8\u09ae\u09be\u09a7\u09be\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09a0\u09bf\u0995 \u0985\u09ad\u09bf\u09af\u09cb\u0997/\u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u09b0 \u09a7\u09b0\u09a8 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09a6\u09c3\u09a2\u09bc\u09ad\u09be\u09ac\u09c7 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u099a\u09cd\u099b\u09c7\u0964 \u09ad\u09c1\u09b2 \u0985\u09ad\u09bf\u09af\u09cb\u0997/\u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09a