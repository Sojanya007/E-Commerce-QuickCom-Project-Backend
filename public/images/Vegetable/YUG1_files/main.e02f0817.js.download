0b5f\u0b3e\u0b2e\u0b3f\u0b32\u0b3f (HOF) \u0b06\u0b27\u0b3e\u0b30\u0b3f\u0b24 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d",address:"\u0b20\u0b3f\u0b15\u0b23\u0b3e"}},documentDescriptionLinkText:"\u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b2a\u0b3e\u0b07\u0b01 PoI / PoA / PoB \u0b38\u0b39\u0b3f\u0b24 \u0b1c\u0b21\u0b3f\u0b24 \u0b2c\u0b48\u0b27 \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b17\u0b41\u0b21\u0b3f\u0b15 \u0b26\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41",proceedToUpdateAadhaar:"\u0b06\u0b27\u0b3e\u0b30 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b05\u0b17\u0b4d\u0b30\u0b17\u0b24\u0b3f \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41",faq:"\u0b2a\u0b4d\u0b30\u0b3e\u0b5f\u0b24\u0b03 \u0b2a\u0b1a\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b2a\u0b4d\u0b30\u0b36\u0b4d\u0b28"},dashboard:"\u0b21\u0b4d\u0b5f\u0b3e\u0b38\u0b2c\u0b4b\u0b30\u0b4d\u0b21",hof:{title:"\u0b39\u0b47\u0b21\u0b4d \u0b05\u0b2b\u0b4d \u0b2b\u0b4d\u0b5f\u0b3e\u0b2e\u0b3f\u0b32\u0b3f (HOF) \u0b06\u0b27\u0b3e\u0b30\u0b3f\u0b24 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d",description:"\u0b39\u0b47\u0b21\u0b4d \u0b05\u0b2b\u0b4d \u0b2b\u0b4d\u0b5f\u0b3e\u0b2e\u0b3f\u0b32\u0b3f \u0b06\u0b27\u0b3e\u0b30\u0b3f\u0b24 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b38\u0b39\u0b3f\u0b24 \u0b05\u0b17\u0b4d\u0b30\u0b17\u0b24\u0b3f \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b0f\u0b20\u0b3e\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 |",howItWorks:{step1:"\u0b06\u0b27\u0b3e\u0b30 \u0b21\u0b3e\u0b1f\u0b3e\u0b2c\u0b47\u0b38\u0b4d \u0b30\u0b41 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b16\u0b4b\u0b1c\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b2a\u0b30\u0b3f\u0b2c\u0b3e\u0b30\u0b30 \u0b2e\u0b41\u0b16\u0b4d\u0b5f\u0b19\u0b4d\u0b15 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2a\u0b4d\u0b30\u0b2c\u0b47\u0b36 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 | \u0b2f\u0b47\u0b09\u0b01\u0b2e\u0b3e\u0b28\u0b47 18 \u0b2c\u0b30\u0b4d\u0b37 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b24\u0b26\u0b41\u0b30\u0b4d\u0b26\u0b4d\u0b27\u0b4d\u0b71 \u0b2c\u0b5f\u0b38 \u0b39\u0b3e\u0b38\u0b32 \u0b15\u0b30\u0b3f\u0b25\u0b3f\u0b2c\u0b3e \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b19\u0b4d\u0b15\u0b41  \u0b15\u0b47\u0b2c\u0b33 \u0b0f\u0b15 HoF \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b2c\u0b3f\u0b2c\u0b47\u0b1a\u0b28\u0b3e \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c |",step2:"\u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b2a\u0b4d\u0b30\u0b41\u0b2b\u0b4d \u0b05\u0b2b\u0b4d \u0b30\u0b3f\u0b32\u0b47\u0b38\u0b28\u0b38\u0b3f\u0b2a\u0b4d (PoR) \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b4d \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b2f\u0b47\u0b09\u0b01\u0b25\u0b3f\u0b30\u0b47 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b28\u0b3e\u0b2e \u0b38\u0b39\u0b3f\u0b24 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b2a\u0b30\u0b3f\u0b2c\u0b3e\u0b30\u0b30 \u0b28\u0b3e\u0b2e \u0b38\u0b39\u0b3f\u0b24 \u0b38\u0b4d\u0b2a\u0b37\u0b4d\u0b1f \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b09\u0b32\u0b4d\u0b32\u0b47\u0b16 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b1b\u0b3f | \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b38\u0b39\u0b3f\u0b24 HoF \u0b30 \u0b38\u0b2e\u0b4d\u0b2a\u0b30\u0b4d\u0b15 \u0b1a\u0b5f\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41, \u0b09\u0b26\u0b3e\u0b39\u0b30\u0b23 \u0b38\u0b4d\u0b71\u0b30\u0b42\u0b2a \u0b2f\u0b26\u0b3f HoF \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 \u0b38\u0b4d\u0b71\u0b3e\u0b2e\u0b40, \u0b24\u0b47\u0b2c\u0b47 \u201c\u0b38\u0b4d\u0b71\u0b3e\u0b2e\u0b40\u201d \u0b1a\u0b5f\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 |",step3:"\u0b05\u0b28\u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b2b\u0b3f \u0b2c\u0b3e\u0b2c\u0b26\u0b15\u0b41 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b41 \u20b9 50 (\u0b15\u0b47\u0b2c\u0b33 \u0b2a\u0b1a\u0b3e\u0b36 \u0b1f\u0b19\u0b4d\u0b15\u0b3e) \u0b26\u0b47\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b21\u0b3f\u0b2c | \u0b06\u0b2a\u0b23 \u0b15\u0b4d\u0b30\u0b47\u0b21\u0b3f\u0b1f\u0b4d / \u0b21\u0b47\u0b2c\u0b3f\u0b1f\u0b4d \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b28\u0b47\u0b1f\u0b4d \u0b2c\u0b4d\u0b5f\u0b3e\u0b19\u0b4d\u0b15\u0b3f\u0b19\u0b4d\u0b17\u0b4d \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b2a\u0b47\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b4d \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 | \u0b0f\u0b39\u0b3f \u0b30\u0b3e\u0b36\u0b3f \u0b2b\u0b47\u0b30\u0b38\u0b4d\u0b24 \u0b39\u0b4b\u0b07\u0b28\u0b25\u0b3e\u0b0f |",step4:"\u0b2f\u0b47\u0b24\u0b47\u0b2c\u0b47\u0b33\u0b47 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 \u0b2b\u0b4d\u0b5f\u0b3e\u0b2e\u0b3f\u0b32\u0b3f \u0b39\u0b47\u0b21\u0b4d \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b30 myAadhaar \u0b2a\u0b4b\u0b30\u0b4d\u0b1f\u0b3e\u0b32\u0b30\u0b47 \u0b32\u0b17\u0b4d \u0b07\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b3f, \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b47 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b2c\u0b3e\u0b23\u0b4d\u0b1f\u0b3f\u0b2c\u0b3e (\u0b36\u0b47\u0b5f\u0b3e\u0b30) \u0b2a\u0b3e\u0b07\u0b01 \u0b0f\u0b15 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b17\u0b4d\u0b30\u0b39\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b47, \u0b2f\u0b3e\u0b39\u0b3e\u0b15\u0b41 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b47 \u0b17\u0b4d\u0b30\u0b39\u0b23 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b05\u0b38\u0b4d\u0b71\u0b40\u0b15\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 | HoF \u0b26\u0b4d\u0b35\u0b3e\u0b30\u0b3e \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b17\u0b4d\u0b30\u0b39\u0b23 / \u0b2a\u0b4d\u0b30\u0b24\u0b4d\u0b5f\u0b3e\u0b16\u0b4d\u0b5f\u0b3e\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b0f\u0b39\u0b3f \u0b2c\u0b3f\u0b15\u0b33\u0b4d\u0b2a \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b24\u0b3e\u0b30\u0b