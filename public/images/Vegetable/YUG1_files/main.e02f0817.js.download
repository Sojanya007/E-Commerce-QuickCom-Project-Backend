0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d06\u0d17\u0d4d\u0d30\u0d39\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d21\u0d4d\u0d30\u0d4b\u0d2a\u0d4d\u0d2a\u0d4d-\u0d21\u0d57\u0d7a \u0d2e\u0d46\u0d28\u0d41\u0d35\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d30\u0d47\u0d16 \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15.",list_6:"(6) \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d30\u0d47\u0d16  \u0d05\u0d2a\u0d4d\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15 (\u0d35\u0d32\u0d3f\u0d2a\u0d4d\u0d2a\u0d02 2 \u0d0e\u0d02\u0d2c\u0d3f; \u0d2b\u0d2f\u0d7d \u0d2b\u0d4b\u0d7c\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d1c\u0d46\u0d2a\u0d3f\u0d07\u0d1c\u0d3f /\u0d2a\u0d3f\u0d0e\u0d7b\u0d1c\u0d3f /\u0d2a\u0d3f\u0d21\u0d3f\u0d0e\u0d2b\u0d4d)",list_7:"(7) \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d06\u0d17\u0d4d\u0d30\u0d39\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d30\u0d47\u0d16 \u0d21\u0d4d\u0d30\u0d4b\u0d2a\u0d4d\u0d2a\u0d4d-\u0d21\u0d57\u0d7a \u0d2e\u0d46\u0d28\u0d41\u0d35\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15.",list_8:"(8) \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d30\u0d47\u0d16 \u0d05\u0d2a\u0d4d\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15 (\u0d35\u0d32\u0d3f\u0d2a\u0d4d\u0d2a\u0d02 2 \u0d0e\u0d02\u0d2c\u0d3f; \u0d2b\u0d2f\u0d7d \u0d2b\u0d4b\u0d7c\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d1c\u0d46\u0d2a\u0d3f\u0d07\u0d1c\u0d3f  / \u0d2a\u0d3f\u0d0e\u0d7b\u0d1c\u0d3f /\u0d2a\u0d3f\u0d21\u0d3f\u0d0e\u0d2b\u0d4d ).",list_9:"(9) \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d2e\u0d4d\u0d2e\u0d24\u0d02 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15."}},five:{title:"\u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d4a\u0d2b\u0d48\u0d32\u0d3f\u0d7d \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d32\u0d46 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d35\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d4a\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d1e\u0d3e\u0d7b \u0d0e\u0d28\u0d4d\u0d24\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d23\u0d02?",content:{list_1:"(1) '\u0d2e\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d36\u0d30\u0d3f\u0d2f\u0d3e\u0d23\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d1e\u0d3e\u0d7b \u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41'  \u0d0e\u0d28\u0d4d\u0d28 \u0d1f\u0d3e\u0d2c\u0d3f\u0d28\u0d4d \u0d24\u0d3e\u0d34\u0d46 \u0d15\u0d4a\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 '\u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d2a\u0d4a\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d15\u0d4d\u0d15\u0d47\u0d1f\u0d4d \u0d09\u0d23\u0d4d\u0d1f\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15' \u0d0e\u0d28\u0d4d\u0d28 \u0d32\u0d3f\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",list_2:"(2) \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2b\u0d4b\u0d2e\u0d3f\u0d7d \u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d2a\u0d42\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",list_3:"(3) \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d2a\u0d4d\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d06\u0d17\u0d4d\u0d30\u0d39\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d21\u0d4d\u0d30\u0d4b\u0d2a\u0d4d\u0d2a\u0d4d-\u0d21\u0d57\u0d7a \u0d2e\u0d46\u0d28\u0d41\u0d35\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d30\u0d47\u0d16 \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15.",list_4:"(4) \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d30\u0d47\u0d16 \u0d05\u0d2a\u0d4d\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15 (\u0d35\u0d32\u0d3f\u0d2a\u0d4d\u0d2a\u0d02 2 \u0d0e\u0d02\u0d2c\u0d3f; \u0d2b\u0d2f\u0d7d \u0d2b\u0d4b\u0d7c\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d4d \u0d1c\u0d46\u0d2a\u0d3f\u0d07\u0d1c\u0d3f / \u0d2a\u0d3f\u0d0e\u0d7b\u0d1c\u0d3f  /\u0d2a\u0d3f\u0d21\u0d3f\u0d0e\u0d2b\u0d4d).",list_5:"(5) \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d2a\u0d23\u0d02 \u0d05\u0d1f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d15.",list_6:"(6) \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15."}},six:{title:"\u0d0f\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d35\u0d3f\u0d35\u0d30 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e (\u0d2a\u0d47\u0d30\u0d4d, \u0d32\u0d3f\u0d02\u0d17\u0d2d\u0d47\u0d26\u0d02 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d1c\u0d28\u0d28\u0d24\u0d4d\u0d24\u0d40\u0d2f\u0d24\u0d3f) \u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d2f\u0d25\u0d3e\u0d7c\u0d24\u0d4d\u0d25 \u0d35\u0d3f\u0d35\u0d30\u0d35\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d4a\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d1e\u0d3e\u0d7b \u0d0e\u0d28\u0d4d\u0d24\u0d41 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d23\u0d02?",content:"\u0d07\u0d24\u0d3f\u0d7d https://uidai.gov.in/images/commdoc/List_of_Supporting_Document_for_Aadhaar_Enrolment_and_Update.pdf. \u0d2a\u0d1f\u0d4d\u0d1f\u0d3f\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d4d\u0d30\u0d15\u0d3e\u0d30\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d2f\u0d25\u0d3e\u0d7c\u0d24\u0d4d\u0d25 \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d30\u0d47\u0d16\u0d15\u0d33\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d12\u0d30\u0d41 \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02 \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15"},seven:{title:"\u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d13\u0d2b\u0d4d\u0d32\u0d48\u0d28\u0d3e\u0d2f\u0d3f \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d2e\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d12\u0d30\u0d41 \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02 \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02?",content:{list_1:"(1) https://bhuvan.nrsc.gov.in/aadhaar/ \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d4b\u0d15\u0d41\u0d15",list_2:"(2) \u0d38\u0d2e\u0d40\u0d2a\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d, '\u0d38\u0d2e\u0d40\u0d2a\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e' \u0d0e\u0d28\u0d4d\u0d28 \u0d1f\u0d3e\u0d2c\u0d3f\u0d7d \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d4d\u0d25\u0d3e\u0d28 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d3f \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d3e\u0d23\u0d41\u0d15.",list_3:"(3) \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d3f\u0d7b \u0d15\u0d4b\u0d21\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33  \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d, '\u0d2a\u0d3f\u0d7b \u0d2a\u0d4d\u0d30\u0d15\u0d3e\u0d30\u0d02 \u0d24\u0d3f\u0d30\u0d2f\u0d41\u0d15' \u0d0e\u0d28\u0d4d\u0d28 \u0d1f\u0d3e\u0d2c\u0d3f\u0d7d \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. \u0d06 \u0d2a\u0d4d\u0d30\u0d26\u0d47\u0d36\u0d24\u0d4d\u0d24\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d3e\u0d23\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d3f\u0d7b \u0d15\u0d4b\u0d21\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d15."}},eight:{title:"\u0d30\u0d47\u0d16\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d28\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d24\u0d4d\u0d30\u0d2f\u0d3e\u0d23\u0d4d?",content:"2023 \u0d38\u0d46\u0d2a\u0d4d\u0d31\u0d4d\u0d31\u0d02\u0d2c\u0d7c 14 \u0d35\u0d30\u0d46 \u0d2e\u0d48 \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d32\u0d3f\u0d7d \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d38\u0d57\u0d1c\u0d28\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d. \u0d12\u0d30\u0d41 \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2c\u0d3e\u0d27\u0d15\u0d2e\u0d3e\u0d2f \u0d28\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d4d 50 \u0d30\u0d42\u0d2a\u0d2f\u0d3e\u0d23\u0d4d."},nine:{title:"\u0d0e\u0d2a\u0d4d\u0d2a\u0d4b\u0d34\u0d3e\u0d23\u0d4d \u0d1e\u0d3e\u0d7b \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d23\u0d4d\u0d1f\u0d24\u0d4d?",content:"\u0d1c\u0d40\u0d35\u0d3f\u0d24 \u0d38\u0d57\u0d15\u0d30\u0d4d\u0d2f\u0d02 \u0d0e\u0d33\u0d41\u0d2a\u0d4d\u0d2a\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02, \u0d2e\u0d46\u0d1a\u0d4d\u0d1a\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d38\u0d47\u0d35\u0d28 \u0d35\u0d3f\u0d24\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d06\u0d27\u0d3f\u0d15\u0d3e\u0d30\u0d3f\u0d15\u0d24 \u0d38\u0d3e\u0d27\u0d4d\u0d2f\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02  \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d2a\u0d41\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d05\u0d2d\u0d3f\u0d15\u0d3e\u0d2e\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d \u0d05\u0d24\u0d3f\u0d28\u0d3e\u0d7d, \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d24\u0d3e\u0d24\u0d4d\u0d2a\u0d30\u0d4d\u0d2f\u0d2a\u0d4d\u0d30\u0d15\u0d3e\u0d30\u0d2e\u0d3e\u0d23\u0d4d \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d2e\u0d41\u0d7b\u0d15\u0d42\u0d1f\u0d4d\u0d1f\u0d3f \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d."},ten:{title:"\u0d1e\u0d3e\u0d7b \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d35\u0d3e\u0d38\u0d3f \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d28\u0d3e\u0d23\u0d4d (\u0d0e\u0d7b\u0d06\u0d7c\u0d10). \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02?",content:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d3f\u0d7d \u0d06\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d7e  \u0d0e\u0d2a\u0d4d\u0d2a\u0d4b\u0d7e \u0d35\u0d47\u0d23\u0d2e\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02."}}},aadharUpdateHistory:{title1:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d02 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",label1:"\u0d30\u0d47\u0d16",label2:"\u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d/\u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d24\u0d40\u0d2f\u0d24\u0d3f",label3:"URN/EID",label4:"\u0d1f\u0d48\u0d2a\u0d4d\u0d2a\u0d4d",list1:"\u0d2a\u0d47\u0d30\u0d4d",list2:"\u0d2e\u0d4a\u0d2c\u0d48\u0d7d",list3:"\u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d",list4:"\u0d1c\u0d28\u0d3f\u0d1a\u0d4d\u0d1a \u0d26\u0d3f\u0d35\u0d38\u0d02",list5:"\u0d32\u0d3f\u0d02\u0d17\u0d2d\u0d47\u0d26\u0d02",list6:"\u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02"},ssup:{howItWorks:{title:"\u0d07\u0d24\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41",description:"\u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d2a\u0d4d\u0d30\u0d15\u0d4d\u0d30\u0d3f\u0d2f \u0d2e\u0d28\u0d38\u0d3f\u0d32\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d07\u0d28\u0d3f\u0d2a\u0d4d\u0d2a\u0d31\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d18\u0d1f\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d7e \u0d35\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d2a\u0d4d\u0d30\u0d4b\u0d38\u0d38\u0d4d\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4b \u0d28\u0d3f\u0d30\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4b \u0d15\u0d3e\u0d32\u0d24\u0d3e\u0d2e\u0d38\u0d02 \u0d12\u0d34\u0d3f\u0d35\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d35\u0d3f\u0d35\u0d3f\u0d27 \u0d18\u0d1f\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d28\u0d3f\u0d7c\u0d26\u0d4d\u0d26\u0d47\u0d36\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d19\u0d4d\u0d19\u0d7e \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d1f\u0d30\u0d41\u0d15",proceedToUpdateAadhaar:"\u0d06\u0d27\u0d3e\u0d7c \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d24\u0d41\u0d1f\u0d30\u0d41\u0d15",stepDescription:{one:"\u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d2b\u0d40\u0d7d\u0d21\u0d4d \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d08 \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d32\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02. \u0d2a\u0d47\u0d30\u0d4d, \u0d32\u0d3f\u0d02\u0d17\u0d2d\u0d47\u0d26\u0d02, DOB, \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c, \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d, \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02 \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",two:"\u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d28\u0d7d\u0d15\u0d41\u0d15. \u0d1a\u0d3f\u0d32 \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d21\u0d4d\u0d30\u0d4b\u0d2a\u0d4d\u0d2a\u0d4d\u0d21\u0d57\u0d7a \u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d7d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d. \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d28\u0d7d\u0d15\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d34\u0d4b \u0d21\u0d4d\u0d30\u0d4b\u0d2a\u0d4d\u0d2a\u0d4d\u0d21\u0d57\u0d7a \u0d13\u0d2a\u0d4d\u0d37\u0d28\u0d41\u0d15\u0d33\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d34\u0d4b \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d36\u0d4d\u0d30\u0d26\u0d4d\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",three:"\u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2f\u0d25\u0d3e\u0d7c\u0d24\u0d4d\u0d25 \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d3e \u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d4d\u0d15\u0d3e\u0d7b \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2a\u0d15\u0d7c\u0d2a\u0d4d\u0d2a\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d. \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d02 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d47\u0d30\u0d3f\u0d32\u0d3e\u0d23\u0d46\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d38\u0d3e\u0d27\u0d41\u0d24\u0d2f\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d3e\u0d23\u0d46\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d09\u0d31\u0d2a\u0d4d\u0d2a\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e UIDAI \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d7b\u0d21\u0d47\u0d7c\u0d21\u0d4d \u0d2b\u0d4b\u0d7c\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d32\u0d3e\u0d23\u0d4d \u0d38\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d31\u0d4d\u0d31\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d28\u0d3f\u0d30\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d12\u0d34\u0d3f\u0d35\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d7b, \u0d07\u0d37\u0d4d\u0d2f\u0d41 \u0d24\u0d40\u0d2f\u0d24\u0d3f, \u0d15\u0d4d\u0d30\u0d4b\u0d38\u0d4d\u0d21\u0d4d \u0d38\u0d48\u0d7b, \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b\u0d2f\u0d3f\u0d32\u0d41\u0d1f\u0d28\u0d40\u0d33\u0d02 \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d2e\u0d4d\u0d2a\u0d4d, \u0d13\u0d35\u0d7c\u0d31\u0d48\u0d31\u0d4d\u0d31\u0d3f\u0d02\u0d17\u0d4d \u0d07\u0d32\u0d4d\u0d32 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d28\u0d46\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d4a\u0d24\u0d41\u0d35\u0d3e\u0d2f \u0d24\u0d46\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",four:"\u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d2b\u0d40\u0d38\u0d3e\u0d2f\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u20b9 50 (\u0d30\u0d42\u0d2a \u0d05\u0d2e\u0d4d\u0d2a\u0d24\u0d4d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02) \u0d28\u0d7d\u0d15\u0d23\u0d02. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d15\u0d4d\u0d30\u0d46\u0d21\u0d3f\u0d31\u0d4d\u0d31\u0d4d / \u0d21\u0d46\u0d2c\u0d3f\u0d31\u0d4d\u0d31\u0d4d \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d28\u0d46\u0d31\u0d4d\u0d31\u0d4d \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d35\u0d34\u0d3f \u0d2a\u0d23\u0d2e\u0d1f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d3e\u0d02. \u0d08 \u0d24\u0d41\u0d15 \u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d46 \u0d28\u0d7d\u0d15\u0d3e\u0d28\u0d3e\u0d35\u0d3f\u0d32\u0d4d\u0d32. \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d7d, \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d41\u0d02 \u0d36\u0d4d\u0d30\u0d2e\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02.",five:"\u0d12\u0d30\u0d41 \u0d31\u0d2b\u0d31\u0d7b\u0d38\u0d3e\u0d2f\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d12\u0d30\u0d41 \u0d38\u0d47\u0d35\u0d28 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d28\u0d2e\u0d4d\u0d2a\u0d7c (SRN) \u0d28\u0d47\u0d1f\u0d41\u0d02. \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4b \u0d2f\u0d41\u0d10\u200c\u0d21\u0d3f\u200c\u0d0e\u0d10 \u0d39\u0d46\u0d7d\u0d2a\u0d4d\u0d2a\u0d4d\u0d21\u0d46\u0d38\u0d4d\u0d15\u0d41\u0d2e\u0d3e\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d2d\u0d3e\u0d35\u0d3f\u0d2f\u0d3f\u0d32\u0d46 \u0d06\u0d36\u0d2f\u0d35\u0d3f\u0d28\u0d3f\u0d2e\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4b \u0d08 \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d38\u0d02\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",six:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u200c\u0d24\u0d4d\u0d25\u0d28 \u0d1e\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d28\u0d4d\u0d24\u0d30\u0d3f\u0d15 \u0d17\u0d41\u0d23\u0d28\u0d3f\u0d32\u0d35\u0d3e\u0d30 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d28 \u0d13\u0d2a\u0d4d\u0d2a\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d7c\u200c\u0d2e\u0d3e\u0d7c\u200c \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02. \u0d08 \u0d18\u0d1f\u0d4d\u0d1f\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d28\u0d7d\u0d15\u0d3f\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d30\u0d47\u0d16\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f  \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02. \u0d2a\u0d4a\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d15\u0d4d\u0d15\u0d47\u0d1f\u0d4d \u0d09\u0d23\u0d4d\u0d1f\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d28\u0d3f\u0d30\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d3e\u0d7b \u0d38\u0d3e\u0d27\u0d4d\u0d2f\u0d24\u0d2f\u0d41\u0d23\u0d4d\u0d1f\u0d4d.",seven:"\u0d17\u0d41\u0d23\u0d28\u0d3f\u0d32\u0d35\u0d3e\u0d30 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d28 \u0d2a\u0d4d\u0d30\u0d15\u0d4d\u0d30\u0d3f\u0d2f \u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d3e\u0d15\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d7e, \u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d10\u0d21\u0d3f \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f \u0d12\u0d30\u0d41 \u0d0e\u0d38\u0d4d\u0d0e\u0d02\u0d0e\u0d38\u0d4d  \u0d05\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02.",eight:"\u0d15\u0d41\u0d31\u0d1a\u0d4d\u0d1a\u0d4d \u0d2e\u0d42\u0d32\u0d4d\u0d2f\u0d28\u0d3f\u0d7c\u0d23\u0d4d\u0d23\u0d2f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d36\u0d47\u0d37\u0d02,\u0d1e\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d46\u0d7b\u0d21\u0d4d \u0d38\u0d4b\u0d2b\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d35\u0d46\u0d2f\u0d7c   \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d2a\u0d4d\u0d30\u0d4b\u0d38\u0d38\u0d4d\u0d38\u0d3f\u0d02\u0d17\u0d4d \u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d3e\u0d15\u0d41\u0d02. \u0d2b\u0d32\u0d24\u0d4d\u0d24\u0d46\u0d15\u0d4d\u0d15\u0d41\u0d31\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d12\u0d30\u0d41 \u0d0e\u0d38\u0d4d \u0d0e\u0d02 \u0d0e\u0d38\u0d4d  \u0d05\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02.",nine:"\u0d38\u0d3e\u0d27\u0d3e\u0d30\u0d23\u0d2f\u0d3e\u0d2f\u0d3f \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 90% \u0d38\u0d47\u0d35\u0d28 \u0d2e\u0d3e\u0d28\u0d26\u0d23\u0d4d\u0d21\u0d19\u0d4d\u0d19\u0d33\u0d4b\u0d1f\u0d46 30 \u0d26\u0d3f\u0d35\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d7d \u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d3e\u0d15\u0d41\u0d02. \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d3e\u0d32\u0d41\u0d02, \u0d1e\u0d19\u0d4d\u0d19\u0d7e \u0d1e\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d19\u0d4d\u0d19\u0d7e \u0d2e\u0d46\u0d1a\u0d4d\u0d1a\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d15\u0d2f\u0d3e\u0d23\u0d4d, \u0d2e\u0d3f\u0d15\u0d4d\u0d15\u0d35\u0d3e\u0d31\u0d41\u0d02, \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d28\u0d47\u0d30\u0d24\u0d4d\u0d24\u0d46 \u0d38\u0d42\u0d1a\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a \u0d38\u0d2e\u0d2f\u0d24\u0d4d\u0d24\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d02. myaadhaar.uidai.gov.in \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d2a\u0d4d\u0d30\u0d4b\u0d38\u0d38\u0d4d\u0d38\u0d3f\u0d02\u0d17\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d28\u0d3f\u0d32 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02."}},updateSelectPage:{title:"\u0d06\u0d27\u0d3e\u0d7c \u0d13\u0d7a\u200c\u0d32\u0d48\u0d28\u0d3f\u0d7d  \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",selectFields:{smallDescription:"\u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d2b\u0d40\u0d7d\u0d21\u0d4d (\u0d15\u0d7e) \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15",longDescription:"\u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d07\u0d28\u0d3f\u0d2a\u0d4d\u0d2a\u0d31\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d0f\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d15\u0d4b\u0d33\u0d02 (\u0d19\u0d4d\u0d19\u0d7e) \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15",updatesLeft:" \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d05\u0d35\u0d36\u0d47\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41 ",noLimit:"\u0d2a\u0d30\u0d3f\u0d27\u0d3f\u0d2f\u0d3f\u0d32\u0d4d\u0d32",demoGraphics:{language:"\u0d2d\u0d3e\u0d37",name:"\u0d2a\u0d47\u0d30\u0d4d",dob:"\u0d1c\u0d28\u0d28\u0d24\u0d4d\u0d24\u0d40\u0d2f\u0d24\u0d3f",gender:"\u0d32\u0d3f\u0d02\u0d17\u0d2d\u0d47\u0d26\u0d02",hof:"\u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d7b (HOF) \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d",address:"\u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02"}},documentDescriptionLinkText:"\u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d41 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2a\u0d3f\u0d12\u0d10  / \u0d2a\u0d3f\u0d12 \u0d0e / \u0d2a\u0d3f\u0d12\u0d2c\u0d3f  \u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f  \u0d38\u0d3e\u0d27\u0d41\u0d35\u0d3e\u0d2f \u0d30\u0d47\u0d16\u0d15\u0d7e  \u0d15\u0d3e\u0d23\u0d41\u0d15",proceedToUpdateAadhaar:"\u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d24\u0d41\u0d1f\u0d30\u0d41\u0d15",faq:"\u0d2a\u0d24\u0d3f\u0d35\u0d3e\u0d2f\u0d3f \u0d1a\u0d4b\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d1a\u0d4b\u0d26\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e"},dashboard:"\u0d21\u0d3e\u0d37\u0d4d\u200c\u0d2c\u0d4b\u0d7c\u0d21",hof:{title:"\u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d7b (HOF) \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d",description:"\u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d7b \u0d05\u0d27\u0d3f\u0d37\u0d4d\u200c\u0d20\u0d3f\u0d24 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d35\u0d3e\u0d7b  \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.",howItWorks:{step1:"\u0d06\u0d27\u0d3e\u0d7c \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d3e\u0d2c\u0d47\u0d38\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d35\u0d3e\u0d7b  \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d28\u0d7d\u0d15\u0d41\u0d15. 18 \u0d35\u0d2f\u0d38\u0d4b \u0d05\u0d24\u0d3f\u0d7d \u0d15\u0d42\u0d1f\u0d41\u0d24\u0d32\u0d4b \u0d2a\u0d4d\u0d30\u0d3e\u0d2f\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d28\u0d3f\u0d35\u0d3e\u0d38\u0d3f\u0d15\u0d33\u0d46  \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 \u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d7b  \u0d06\u0d2f\u0d3f \u0d15\u0d23\u0d15\u0d4d\u0d15\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d35\u0d3e\u0d7b  \u0d15\u0d34\u0d3f\u0d2f\u0d42.",step2:'\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d47\u0d30\u0d41\u0d02 \u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d47\u0d30\u0d41\u0d02 \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d30\u0d3e\u0d2e\u0d7c\u0d36\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2c\u0d28\u0d4d\u0d27\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d24\u0d46\u0d33\u0d3f\u0d35\u0d41\u0d33\u0d4d\u0d33  (PoR) \u0d30\u0d47\u0d16 \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d2e\u0d3e\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d28\u0d4d\u0d31\u0d46 \u0d2c\u0d28\u0d4d\u0d27\u0d02 \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d09\u0d26\u0d3e\u0d39\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d \u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d7b  \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2d\u0d7c\u0d24\u0d4d\u0d24\u0d3e\u0d35\u0d3e\u0d23\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, "\u0d2d\u0d7c\u0d24\u0d4d\u0d24\u0d3e\u0d35\u0d4d" \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15.',step3:"\u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d2b\u0d40\u0d38\u0d3e\u0d2f\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u20b9 50 (\u0d05\u0d2e\u0d4d\u0d2a\u0d24\u0d4d \u0d30\u0d42\u0d2a \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02) \u0d28\u0d7d\u0d15\u0d23\u0d02. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d15\u0d4d\u0d30\u0d46\u0d21\u0d3f\u0d31\u0d4d\u0d31\u0d4d/\u0d21\u0d46\u0d2c\u0d3f\u0d31\u0d4d\u0d31\u0d4d \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d28\u0d46\u0d31\u0d4d\u0d31\u0d4d \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d35\u0d34\u0d3f \u0d2a\u0d23\u0d2e\u0d1f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d3e\u0d02. \u0d08 \u0d24\u0d41\u0d15 \u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d46 \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d3f\u0d32\u0d4d\u0d32.",step4:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d7b \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d2e\u0d48 \u0d06\u0d27\u0d3e\u0d7c  \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d32\u0d3f\u0d7d  \u0d32\u0d4b\u0d17\u0d3f\u0d7b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d7e, \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d05\u0d35\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02, \u0d05\u0d24\u0d4d \u0d05\u0d35\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d4d\u0d35\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d4b \u0d28\u0d3f\u0d30\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d4b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02. \u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d28\u0d4d\u0d31\u0d46 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d38\u0d4d\u0d35\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d35\u0d3e\u0d28\u0d41\u0d02 \u0d28\u0d3f\u0d30\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d35\u0d3e\u0d28\u0d41\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d08 \u0d13\u0d2a\u0d4d\u0d37\u0d7b \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d1a\u0d4d\u0d1a \u0d24\u0d40\u0d2f\u0d24\u0d3f \u0d2e\u0d41\u0d24\u0d7d 30 \u0d26\u0d3f\u0d35\u0d38\u0d24\u0d4d\u0d24\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d3e\u0d27\u0d41\u0d35\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02."},currentSection:{title:"\u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d4d \u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d28\u0d4d\u0d31\u0d46  \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d"},updateSection:{forms:{hofUid:{label:"\u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d28\u0d7d\u0d15\u0d41\u0d15"},mobileField:{label:"\u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d28\u0d4d\u0d31\u0d46 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c"},documentUpload:{label:"\u0d38\u0d3e\u0d27\u0d41\u0d35\u0d3e\u0d2f \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d3e \u0d30\u0d47\u0d16  \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15"},relationshipDropdown:{label:"\u0d05\u0d2a\u0d47\u0d15\u0d4d\u0d37\u0d15\u0d28\u0d41\u0d2e\u0d3e\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d28\u0d3e\u0d25\u0d28\u0d4d\u0d31\u0d46  \u0d2c\u0d28\u0d4d\u0d27\u0d02 \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15",values:{father:"\u0d05\u0d1a\u0d4d\u0d1b\u0d7b",mother:"\u0d05\u0d2e\u0d4d\u0d2e",husband:"\u0d2d\u0d7c\u0d24\u0d4d\u0d24\u0d3e\u0d35\u0d4d",wife:"\u0d2d\u0d3e\u0d30\u0d4d\u0d2f",guardian:"\u0d17\u0d3e\u0d7c\u0d21\u0d3f\u0d2f\u0d7b ",Others:"\u0d2e\u0d31\u0d4d\u0d31\u0d41\u0d33\u0d4d\u0d33\u0d35\u0d7c "}}}}},documentInfoPopup:{title:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d2a\u0d4d\u0d30\u0d4b\u0d38\u0d38\u0d4d\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d38\u0d3e\u0d27\u0d41\u0d35\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d02 \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",identityDocumentInfo:"\u0d30\u0d47\u0d16 \u0d10\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f \u0d2a\u0d4d\u0d30\u0d42\u0d2b\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d3e\u0d23\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d05\u0d24\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d47\u0d30\u0d3f\u0d32\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d02 \u0d15\u0d42\u0d1f\u0d3e\u0d24\u0d46 \u0d12\u0d30\u0d41 \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b\u0d2f\u0d41\u0d02 \u0d09\u0d23\u0d4d\u0d1f\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d02. \u0d2b\u0d4b\u0d2e\u0d3f\u0d7d \u0d2e\u0d41\u0d15\u0d33\u0d3f\u0d7d \u0d38\u0d42\u0d1a\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 '\u0d2a\u0d47\u0d30\u0d4d' \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d21\u0d4b\u0d15\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d3f\u0d32\u0d46 '\u0d2a\u0d47\u0d30\u0d4d' \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d4a\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d35\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",addressDocumentInfo:"\u0d30\u0d47\u0d16 \u0d05\u0d21\u0d4d\u0d30\u0d38\u0d4d \u0d2a\u0d4d\u0d30\u0d42\u0d2b\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d3e\u0d23\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d05\u0d24\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d47\u0d30\u0d3f\u0d32\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d02. \u0d2a\u0d19\u0d4d\u0d15\u0d3e\u0d33\u0d3f\u0d2f\u0d41\u0d1f\u0d46\u0d2f\u0d4b \u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d24\u0d3e\u0d35\u0d3f\u0d28\u0d4d\u0d31\u0d46\u0d2f\u0d4b \u0d2e\u0d3e\u0d24\u0d3e\u0d2a\u0d3f\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d33\u0d41\u0d1f\u0d46\u0d2f\u0d4b \u0d2a\u0d47\u0d30\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d38\u0d4d\u0d35\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3f\u0d32\u0d4d\u0d32. \u0d2b\u0d4b\u0d2e\u0d3f\u0d7d \u0d2e\u0d41\u0d15\u0d33\u0d3f\u0d7d \u0d38\u0d42\u0d1a\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a '\u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02' \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d21\u0d4b\u0d15\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d3f\u0d32\u0d46 '\u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02' \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d4a\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d35\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0