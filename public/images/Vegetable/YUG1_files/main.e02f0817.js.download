u0938\u0902\u092c\u0902\u0927\u0940 \u0905\u0936\u0941\u0926\u094d\u0927\u093f \u0915\u094b \u0920\u0940\u0915 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902 \u091c\u094b \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",acceptTermsText:"\u092e\u0948\u0902 \u090f\u0924\u0926\u094d\u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u092e\u0948\u0902\u0928\u0947 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u094b\u0902 \u0915\u094b \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u092a\u0922\u093c\u093e \u0939\u0948 \u0914\u0930 \u092e\u0947\u0930\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u094b \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u0917\u0908 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0938\u0924\u094d\u092f \u0914\u0930 \u0938\u0939\u0940 \u0939\u0948\u0964",acceptTermsText_p1:"\u092e\u0948\u0902 \u0907\u0938\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0941\u0937\u094d\u091f\u093f \u0914\u0930 \u0918\u094b\u0937\u0923\u093e \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0940 \u0917\u0908 \u0938\u092d\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0914\u0930 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u092e\u0947\u0930\u0940 \u0938\u0930\u094d\u0935\u094b\u0924\u094d\u0924\u092e \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0914\u0930 \u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0938\u0939\u0940 \u0939\u0948\u0902\u0964",acceptTermsText_p2:"\u092e\u0948\u0902 \u0938\u092e\u091d\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u092f\u0926\u093f \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u0918\u094b\u0937\u0923\u093e \u0917\u0932\u0924 \u092a\u093e\u0908 \u091c\u093e\u0924\u0940 \u0939\u0948, \u0924\u094b \u092e\u0947\u0930\u093e \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948 \u0914\u0930 \u0907\u0938\u0915\u0947 \u0905\u0932\u093e\u0935\u093e, \u0915\u093e\u0928\u0942\u0928 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092e\u0947\u0930\u0947 \u0916\u093f\u0932\u093e\u092b \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u092d\u0940 \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",acceptTermsText_p3:"\u092e\u0948\u0902 \u0938\u092e\u091d\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u093e \u0909\u092a\u092f\u094b\u0917, \u0916\u0941\u0932\u093e\u0938\u093e \u092f\u093e \u0938\u093e\u091d\u093e \u0906\u0927\u093e\u0930 (\u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0914\u0930 \u0905\u0928\u094d\u092f \u0938\u092c\u094d\u0938\u093f\u0921\u0940, \u0932\u093e\u092d \u0914\u0930 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u093e \u0932\u0915\u094d\u0937\u093f\u0924 \u0935\u093f\u0924\u0930\u0923) \u0905\u0927\u093f\u0928\u093f\u092f\u092e, 2016 \u0914\u0930 \u0909\u0938\u0915\u0947 \u0924\u0939\u0924 \u092c\u0928\u093e\u090f \u0917\u090f \u0928\u093f\u092f\u092e\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964",acceptTermsText_p4:"\u092e\u0948\u0902 \u0907\u0938 \u0924\u0930\u0939 \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0940 \u0924\u0948\u092f\u093e\u0930\u0940 \u092f\u093e \u0930\u0916\u0930\u0916\u093e\u0935 \u0938\u0947 \u0928\u093f\u092a\u091f\u0928\u0947 \u0935\u093e\u0932\u0947 \u0905\u0927\u093f\u0915\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u0947 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u0947 \u092a\u0939\u091a\u093e\u0928, \u092a\u0924\u093e, \u091c\u0928\u094d\u092e \u0914\u0930/\u092f\u093e \u0930\u093f\u0936\u094d\u0924\u0947 \u0915\u0947 \u092a\u094d\u0930\u092e\u093e\u0923 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0914\u0930 \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0914\u0930 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u094b \u0938\u0930\u0915\u093e\u0930\u0940 \u090f\u091c\u0947\u0902\u0938\u093f\u092f\u094b\u0902 \u0914\u0930/\u092f\u093e \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u0938\u0939\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0947 \u092a\u094d\u0930\u092f\u094b\u091c\u0928 \u0915\u0947 \u0932\u093f\u090f \u0910\u0938\u093e \u0915\u094b\u0908 \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u093e\u0930\u0940\u0964",acceptTermsText_p5:"\u092e\u0948\u0902 \u0907\u0938 \u0918\u094b\u0937\u0923\u093e \u0938\u0947 \u0938\u0939\u092e\u0924 \u0939\u0942\u0902\u0964",errorPop:{error:"\u0924\u094d\u0930\u0941\u091f\u093f!",close:"\u092c\u0902\u0926 \u0915\u0930\u0947"}}},payment:{paymentOptions:{text:"\u0915\u0943\u092a\u092f\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u0915\u0932\u094d\u092a \u091a\u0941\u0928\u0947\u0902"},makePayment:{welcomeText:"\u092a\u094d\u0930\u093f\u092f \u0928\u093f\u0935\u093e\u0938\u0940,",documentPaymentInfo:"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u092a\u0921\u0947\u091f \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0938\u0947 \u0930\u0941. {{paymentAmount}} \u0915\u093e \u0936\u0941\u0932\u094d\u0915 \u0932\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964",paymentInfo:" \u0906\u092a\u0938\u0947 50 \u0930\u0941\u092a\u092f\u0947 \u0932\u093f\u090f \u091c\u093e\u090f\u0902\u0917\u0947, \u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u092a\u0921\u0947\u091f \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964",linkText:"\u0906\u092a \u092f\u0939\u093e\u0902 \u092d\u0941\u0917\u0924\u093e\u0928/\u0930\u0926\u094d\u0926\u0940\u0915\u0930\u0923/\u0927\u0928\u0935\u093e\u092a\u0938\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0905\u0927\u093f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",acceptTerms:"\u092e\u0948\u0902 \u090f\u0924\u0926\u094d\u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0924\u093e/\u0915\u0930\u0924\u0940 \u0939\u0942\u0902 \u0915\u093f \u092e\u0948\u0902\u0928\u0947 \u092d\u0941\u0917\u0924\u093e\u0928/\u0930\u0926\u094d\u0926\u0940\u0915\u0930\u0923/\u0927\u0928\u0935\u093e\u092a\u0938\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094b \u092a\u0922\u093c \u0914\u0930 \u0938\u092e\u091d \u0932\u093f\u092f\u093e \u0939\u0948\u0964",poweredBy:"\u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0902\u091a\u093e\u0932\u093f\u0924"},paymentStatus:{transactionStatus:"\u0932\u0947\u0928-\u0926\u0947\u0928 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f",reason:"\u0915\u093e\u0930\u0923",dateAndTime:"\u092d\u0941\u0917\u0924\u093e\u0928 \u0924\u093f\u0925\u093f \u0914\u0930 \u0938\u092e\u092f",amount:"\u0930\u0915\u092e",failed:"\u0905\u0938\u092b\u0932 \u0939\u0941\u0906",success:"\u0938\u092b\u0932",downloadAckText:"\u092a\u093e\u0935\u0924\u0940 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964"},paymentPopup:{estTime:"\u0905\u0928\u0941\u092e\u093e\u0928\u093f\u0924 \u0938\u092e\u092f",description:"\u0915\u0943\u092a\u092f\u093e \u0924\u092c \u0924\u0915 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902 \u091c\u092c \u0924\u0915 \u0939\u092e \u0932\u0947\u0928-\u0926\u0947\u0928 \u092a\u0942\u0930\u093e \u0928\u0939\u0940\u0902 \u0915\u0930 \u0932\u0947\u0924\u0947 \u0914\u0930 \u092a\u093e\u0935\u0924\u0940 \u092a\u0930\u094d\u091a\u0940 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964"}}},myHofRequests:{title:"\u092e\u0947\u0930\u0947 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0947 \u092e\u0941\u0916\u093f\u092f\u093e (\u090f\u091a\u0913\u090f\u092b ) \u0905\u0928\u0941\u0930\u094b\u0927",description:"\u090f\u091a\u0913\u090f\u092b \u0906\u0927\u093e\u0930\u093f\u0924 \u090f\u0921\u094d\u0930\u0947\u0938 \u0936\u0947\u092f\u0930\u093f\u0902\u0917 \u0905\u0928\u0941\u0930\u094b\u0927\u094b\u0902 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902",forms:{title:"\u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u090f\u0938\u0906\u0930\u090f\u0928 \u091f\u093e\u0907\u092a \u0915\u0930\u0947\u0902 \u0914\u0930 \u0905\u0928\u0941\u0930\u094b\u0927 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902",label:"\u090f\u0938\u0906\u0930\u090f\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",buttons:{decline:"\u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u093e",accept:"\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u093e"},displayMsg:{case1:"\u0906\u092a\u0915\u094b \u092a\u0924\u093e \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f {{resident}} \u0938\u0947 \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u090f\u0938\u0906\u0930\u090f\u0928 \u092a\u0930 \u090f\u0915 \u0905\u0928\u0941\u0930\u094b\u0927 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u0941\u0906 \u0939\u0948\u0964",case2:"\u0906\u092a\u0928\u0947 {{resident}} \u0915\u0947 \u0938\u093e\u0925 \u0905\u092a\u0928\u093e \u092a\u0924\u093e \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u0915\u0940 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0926\u0940 \u0939\u0948\u0964",case3:"\u0906\u092a\u0928\u0947 {{resident}} \u0915\u0947 \u0938\u093e\u0925 \u0905\u092a\u0928\u093e \u092a\u0924\u093e \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u0938\u0947 \u092e\u0928\u093e \u0915\u0930 \u0926\u093f\u092f\u093e \u0939\u0948\u0964",case4:"\u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u090f\u0938\u0906\u0930\u090f\u0928 \u092a\u0930 \u0915\u094b\u0908 \u0905\u0928\u0941\u0930\u094b\u0927 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964"},acceptScreen:{acceptMsg:"\u0906\u092a\u0928\u0947 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0947 \u092e\u0941\u0916\u093f\u092f\u093e \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0905\u092a\u0928\u093e \u092a\u0924\u093e \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948\u0964",declineMsg:"\u0906\u092a\u0928\u0947 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0947 \u092e\u0941\u0916\u093f\u092f\u093e \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0905\u092a\u0928\u093e \u092a\u0924\u093e \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e \u0939\u0948\u0964"},confirmationPopUp:{rejectPrompt:"\u0915\u094d\u092f\u093e \u0906\u092a \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a \u092a\u0924\u0947 \u0915\u094b \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u090f\u091a\u0913\u090f\u092b \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?",acceptPrompt:"\u0915\u094d\u092f\u093e \u0906\u092a \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a \u092a\u0924\u0947 \u0915\u094b \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u090f\u091a\u0913\u090f\u092b \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"}}},pvc:{oauth:{preview:{sectionHeading:"\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0915\u0947 \u0932\u093f\u090f \u0911\u0930\u094d\u0921\u0930 \u0926\u0947\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0947 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0935\u093f\u0935\u0930\u0923 \u0915\u093e \u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u0947\u0902\u0964",sectionText:"\u092f\u0926\u093f \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u0915\u0947 \u0938\u093e\u0925 \u0915\u094b\u0908 \u0905\u0936\u0941\u0926\u094d\u0927\u093f/\u0917\u093e\u092f\u092c/\u092a\u0941\u0930\u093e\u0928\u0940/\u092a\u0941\u0930\u093e\u0928\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948, \u0924\u094b \u0906\u092a \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u091c\u093e\u0915\u0930 \u092f\u093e \u0907\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u0938\u0947 \u0905\u092a\u0921\u0947\u091f \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e \u0935\u093f\u0915\u0932\u094d\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u0915\u094b \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u093e \u0935\u093f\u0915\u0932\u094d\u092a \u091a\u0941\u0928 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",name:"\u0928\u093e\u092e",dob:"\u091c\u0928\u094d\u092e \u0924\u093f\u0925\u093f",gender:"\u0932\u093f\u0902\u0917",address:"\u092a\u0924\u093e"}},generic:{form:{selectLabel:"12 \u0905\u0902\u0915\u094b\u0902 \u0915\u0940 \u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e / 28 \u0905\u0902\u0915\u094b\u0902 \u0915\u0940 \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0906\u0908\u0921\u0940 \u091a\u0941\u0928\u0947\u0902\u0964",radioLabels:{uid:"\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930",eid:"\u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0906\u0908\u0921\u0940 \u0928\u0902\u092c\u0930"},textFields:{uid:"\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",eid:"14 \u0905\u0902\u0915\u0940\u092f \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0938\u0902\u0916\u094d\u092f\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",generic:"\u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0906\u0908\u0921\u0940, \u090f\u0938\u0906\u0930\u090f\u0928 \u092f\u093e \u092f\u0942\u0906\u0930\u090f\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",mobile:"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",otp:"\u0913\u091f\u0940\u092a\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",securityCode:"\u0915\u0948\u092a\u094d\u091a\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902"},checkBox:{mobile:"\u092e\u0947\u0930\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948",tnc:"\u0928\u093f\u092f\u092e \u0914\u0930 \u0936\u0930\u094d\u0924\u0947\u0902"},button:{otp:"\u0913\u091f\u0940\u092a\u0940\u092d\u0947\u091c\u0947\u0902",submit:"\u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0928\u093e"},modal:{mobile:"\u092f\u0926\u093f \u0906\u092a\u0915\u093e \u0906\u0927\u093e\u0930 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0939\u0948 \u0924\u094b \u0939\u092e \u0906\u092a\u0915\u094b myAadhaar (myaadhaar.uidai.gov.in) \u092a\u0930 \u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0928\u0947 \u0914\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0911\u0930\u094d\u0921\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u094b\u0924\u094d\u0938\u093e\u0939\u093f\u0924 \u0915\u0930\u0947\u0902\u0917\u0947\u0964",tnc:{heading:"\u0915\u0943\u092a\u092f\u093e \u0913\u090f\u0938\u0940 \u092a\u094b\u0930\u094d\u091f\u0932 \u092e\u0947\u0902 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u093f\u090f \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0905\u0928\u0941\u092e\u094b\u0926\u093f\u0924 '\u0928\u093f\u092f\u092e \u0914\u0930 \u0936\u0930\u094d\u0924\u0947\u0902' \u0928\u0940\u091a\u0947 \u0926\u0947\u0916\u0947\u0902:",t1:"\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0915\u0940 \u091b\u092a\u093e\u0908 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u0938\u0939\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964",t2:"\u092e\u0948\u0902 \u0938\u092e\u091d\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u092e\u0947\u0930\u093e \u092e\u0941\u0926\u094d\u0930\u093f\u0924 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u092e\u0947\u0930\u0947 \u092a\u0924\u0947 \u092a\u0930 \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e, \u091c\u094b \u0906\u0927\u093e\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0939\u0948 \u091c\u094b \u092a\u093f\u0928\u0915\u094b\u0921 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0942\u0930\u094d\u0923 \u0914\u0930 \u0938\u0939\u0940 \u0939\u0948\u0964",t3:"\u092e\u0948\u0902 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0938\u0947\u0935\u093e \u0915\u0947 \u0932\u093f\u090f \u0930\u0941. 50/- (\u091c\u0940\u090f\u0938\u091f\u0940 \u0938\u0939\u093f\u0924) \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u092e\u0924 \u0939\u0942\u0902\u0964",t4:"\u092e\u0948\u0902 \u0938\u092e\u091d\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u092d\u093e\u0930\u0924\u0940\u092f \u0921\u093e\u0915 \u0915\u0940 \u0938\u094d\u092a\u0940\u0921 \u092a\u094b\u0938\u094d\u091f \u0938\u0947\u0935\u093e \u0926\u094d\u0935\u093e\u0930\u093e \u0909\u0928\u0915\u0947 \u0935\u093f\u0924\u0930\u0923 \u092e\u093e\u0928\u0926\u0902\u0921\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0930\u0942\u092a \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0907\u0902\u0921\u093f\u092f\u093e \u092a\u094b\u0938\u094d\u091f \u0938\u094d\u091f\u0947\u091f\u0938 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u094b \u091f\u094d\u0930\u0948\u0915 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964"}}},payment:{welcomeText:"\u092a\u094d\u0930\u093f\u092f \u0928\u093f\u0935\u093e\u0938\u0940,",srnInfo:" \u0906\u092a\u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u090f\u0938\u0906\u0930\u090f\u0928 # \u0915\u0947 \u0938\u093e\u0925 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964",trackInfo:"\u0915\u0943\u092a\u092f\u093e \u0907\u0938 \u0928\u0902\u092c\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0911\u0930\u094d\u0921\u0930 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u0914\u0930 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0924\u094d\u0930\u093e\u091a\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u0915\u0930\u0947\u0902\u0964",paymentText:"\u092a\u0940\u0935\u0940\u0938\u0940 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0938\u0947 50/- \u0930\u0941\u092a\u092f\u0947 (\u091c\u0940\u090f\u0938\u091f\u0940 \u0914\u0930 \u0938\u094d\u092a\u0940\u0921 \u092a\u094b\u0938\u094d\u091f \u0936\u0941\u0932\u094d\u0915 \u0938\u0939\u093f\u0924) \u0936\u0941\u0932\u094d\u0915 \u0932\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964",redirectInfo:" \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0947\u0902 \u092c\u091f\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0906\u092a\u0915\u094b \u0911\u0928\u0932\u093e\u0907\u0928 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f PayU \u092d\u0941\u0917\u0924\u093e\u0928 \u0917\u0947\u091f\u0935\u0947 \u092a\u0930 \u092a\u0941\u0928\u0930\u094d\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0938\u092b\u0932 \u092d\u0941\u0917\u0924\u093e\u0928 \u092a\u0930 \u0906\u092a\u0915\u094b \u092a\u093e\u0935\u0924\u0940 \u092a\u0930\u094d\u091a\u0940 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u0935\u093e\u092a\u0938 \u092d\u0947\u091c \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u092f\u0926\u093f \u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u092b\u0932 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948 \u0924\u094b \u0906\u092a \u0915\u0908 \u092c\u093e\u0930 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u093e \u092a\u0941\u0928: \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",button:{cancel:"\u0928\u093f\u0930\u0938\u094d\u0924 \u0915\u0930\u0928\u093e",makePayment:"\u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0947\u0902"}}},status:{srnField:"\u090f\u0938\u0906\u0930\u090f\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",table:{srn:"\u090f\u0938\u0906\u0930\u090f\u0928",orderDate:"\u0906\u0926\u0947\u0936 \u0924\u093f\u0925\u093f",currentStatus:"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0938\u094d\u0925\u093f\u0924\u093f",awb:"\u090f\u092f\u0930 \u0935\u0947 \u092c\u093f\u0932 \u0928\u0902\u092c\u0930",dispatchDate:"\u092a\u094d\u0930\u0947\u0937\u0923 \u0915\u0940 \u0924\u093f\u0925\u093f",awb_subText:"\u0906\u092a \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 'www.indiapost.gov.in' \u092a\u0930 \u0905\u092a\u0928\u093e \u0911\u0930\u094d\u0921\u0930 \u091f\u094d\u0930\u0948\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902",demographic:"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0915\u093e\u0930\u0923\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923, \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u0947 \u0932\u093f\u090f \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940 \u0921\u0947\u091f\u093e \u0915\u093e \u0916\u0941\u0932\u093e\u0938\u093e \u0930\u093e\u091c\u094d\u092f \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0939\u093e\u0932\u093e\u0902\u0915\u093f, \u0911\u0930\u094d\u0921\u0930 \u0915\u093f\u090f \u0917\u090f \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u092e\u0947\u0902 \u0906\u0927\u093e\u0930 \u0915\u093e \u0932\u0947\u091f\u0947\u0938\u094d\u091f \u0921\u0947\u092e\u094b\u0917\u094d\u0930\u093e\u092b\u093f\u0915 \u0921\u093e\u091f\u093e \u0939\u094b\u0917\u093e \u0964"}}},aadharStatus:{title:"\u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0914\u0930 \u0905\u0926\u094d\u092f\u0924\u0928 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902",description:{one:"\u091c\u093e\u0902\u091a\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u093e \u0906\u0927\u093e\u0930 \u091c\u0928\u0930\u0947\u091f \u0939\u0941\u0906 \u0939\u0948 \u092f\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0964",twoEID:"\u0928\u093e\u092e\u093e\u0902\u0915\u0928/\u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0930\u0942\u092a \u0938\u0947 \u091c\u093e\u0928\u0947 \u092a\u0930 14 \u0905\u0902\u0915\u094b\u0902 \u0915\u0940 \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0938\u0902\u0916\u094d\u092f\u093e \u092a\u093e\u0935\u0924\u0940 \u092a\u0930\u094d\u091a\u0940 \u092a\u0930 \u092e\u0941\u0926\u094d\u0930\u093f\u0924 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948",twoSRN:"\u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u092a\u0921\u0947\u091f \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u092a\u093e\u0935\u0924\u0940 \u092a\u0930\u094d\u091a\u0940 \u092a\u0930 'S' \u0915\u0947 \u092c\u093e\u0926 13 \u0905\u0902\u0915 \u092e\u0941\u0926\u094d\u0930\u093f\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 ",twoURN:"\u090f\u092e\u0906\u0927\u093e\u0930 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0905\u092a\u0921\u0947\u091f \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u092a\u093e\u0935\u0924\u0940 \u092a\u0930\u094d\u091a\u0940 \u092a\u0930 \u092e\u0941\u0926\u094d\u0930\u093f\u0924 8 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u092f\u0942\u0906\u0930\u090f\u0928",twoSID:"\u2018S\u2019 followed by 27 digits, printed on acknowledgement slip while physically visiting Enrolment / Update center. Sample: S123456789123456789123456789",three:"\u092f\u0926\u093f \u0906\u092a\u0928\u0947 \u0908\u0906\u0908\u0921\u0940 \u0916\u094b \u0926\u0940 \u0939\u0948 \u0924\u094b \u0906\u092a \u0905\u092a\u0928\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0938\u0947 \u0916\u094b\u0908 \u0939\u0941\u0908 \u092f\u093e \u092d\u0942\u0932\u0940 \u0939\u0941\u0908 \u0908\u0906\u0908\u0921\u0940 \u0915\u094b \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},optionalMessage:"\u092a\u093e\u0935\u0924\u0940 \u092a\u0930\u094d\u091a\u0940 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0926\u093f\u0928\u093e\u0902\u0915 \u0914\u0930 \u0938\u092e\u092f \u0915\u093e \u0909\u0932\u094d\u0932\u0947\u0916 \u0915\u0930\u0947\u0902 (<b>\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915</b>)"},errorMessages:{slipApiFailed:"\u0939\u092e \u092a\u093e\u0935\u0924\u0940 \u092a\u0930\u094d\u091a\u0940 \u091c\u0928\u0930\u0947\u091f \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0924\u094d\u0930\u0941\u091f\u093f \u0915\u0947 \u0915\u093e\u0930\u0923 \u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u092e\u0930\u094d\u0925 \u0939\u0948\u0902\u0964 \u0915\u0943\u092a\u092f\u093e \u0915\u0941\u091b \u0938\u092e\u092f \u092c\u093e\u0926 \u092a\u0941\u0928: \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",exisitingDraft:"\u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u0947 \u0938\u093e\u0925 \u092a\u093f\u091b\u0932\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u093e \u090f\u0915 \u0938\u0915\u094d\u0930\u093f\u092f \u0921\u094d\u0930\u093e\u092b\u093c\u094d\u091f \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u0939\u0948. \u0906\u092a \u0921\u094d\u0930\u093e\u092b\u094d\u091f \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u0907\u0938\u0947 \u0930\u0926\u094d\u0926 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0928\u090f \u0938\u093f\u0930\u0947 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",fetchingRequests:"\u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902 \u091c\u092c \u0939\u092e \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u0947 \u0906\u092a\u0915\u0947 \u092a\u093f\u091b\u0932\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0932\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",fetchApiFailed:"Couldn't fetch user request data. Something went wrong.",fetchApiFailed1:"Something went wrong while fetching requests.",fetchApiFailed2:"No Record Found.",documentPOAApiFailed:"Couldn't get list of POA documents. Something went wrong.",documentPOBApiFailed:"Couldn't get list of POB documents. Something went wrong.",documentPOIApiFailed:"Couldn't get list of POI documents. Something went wrong.",oauthFailure:"Something went wrong.",oauthFailure1:"Invalid Token.",technicalError1:"\u0939\u092e\u093e\u0930\u0940 \u092c\u0948\u0915\u090f\u0902\u0921 \u0938\u0947\u0935\u093e\u0913\u0902 \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u0924\u094d\u0930\u0941\u091f\u093f\u092f\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0939\u092e \u0906\u092a\u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u092a\u0942\u0930\u093e \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0947\u0964 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094b \u092b\u093f\u0930 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u094b \u092e\u0941\u0916\u094d\u092f \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u092a\u0930 \u092a\u0941\u0928\u0903 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964",technicalError2:"\u0939\u092e\u093e\u0930\u0940 \u092c\u0948\u0915\u090f\u0902\u0921 \u0938\u0947\u0935\u093e\u0913\u0902 \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u0924\u094d\u0930\u0941\u091f\u093f\u092f\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0939\u092e \u0906\u092a\u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u092a\u0942\u0930\u093e \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0947\u0964",requestDeleted:"\u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0930\u0926\u094d\u0926 \u0915\u093f\u092f\u093e \u0917\u092f\u093e!"},complaintStatus:{title:"\u0936\u093f\u0915\u093e\u092f\u0924/\u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902",form:{complaintNumber:"\u0938\u0947\u0935\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u0902\u0916\u094d\u092f\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",QRCid:"Qrc Id",status:"\u0938\u094d\u0925\u093f\u0924\u093f",ComplaintNumber:"\u0936\u093f\u0915\u093e\u092f\u0924/\u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0902\u0916\u094d\u092f\u093e",ResolutionResponse:"\u0938\u0902\u0915\u0932\u094d\u092a \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e"}},fileComplaint:{title:"\u0936\u093f\u0915\u093e\u092f\u0924 \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e",description:"\u0905\u092a\u0928\u0940 \u0936\u093f\u0915\u093e\u092f\u0924 \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902",disclaimer:"\u0906\u0927\u093e\u0930, \u0938\u092c\u0938\u0947 \u0905\u0927\u093f\u0915 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u0921\u093f\u091c\u093f\u091f\u0932 \u092a\u0939\u091a\u093e\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902, \u0915\u0908 \u0938\u092c\u094d\u0938\u093f\u0921\u0940, \u0932\u093e\u092d \u0914\u0930 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u093e \u0932\u093e\u092d \u0909\u0920\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0940 \u0915\u0947 \u092e\u0926\u094d\u0926\u0947\u0928\u091c\u0930 \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0915\u0940 \u0938\u091f\u0940\u0915\u0924\u093e \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0928\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0914\u0930 \u0906\u0927\u093e\u0930 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u094b \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u0935\u093e\u092f\u0926 \u0936\u0941\u0930\u0942 \u0915\u0940 \u0925\u0940\u0964 \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0915\u094b \u0905\u0926\u094d\u092f\u0924\u0928 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928, \u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e \u0927\u093e\u0930\u0915\u094b\u0902 \u0915\u094b \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u0938\u0942\u091a\u0928\u093e\u090f\u0901 \u091c\u093e\u0930\u0940 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u0907\u0938 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u092f\u0939 \u0938\u094d\u092a\u0937\u094d\u091f \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u094b\u0908 \u092d\u0940 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0930\u0926\u094d\u0926 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948. \u092f\u0926\u093f \u0915\u093f\u0938\u0940 \u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e \u0927\u093e\u0930\u0915 \u0915\u094b \u0907\u0938 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0936\u093f\u0915\u093e\u092f\u0924 \u0939\u0948, \u0924\u094b \u0935\u0947 \u092f\u0939\u093e\u0902 \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0926\u0947 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0910\u0938\u0940 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0936\u093f\u0915\u093e\u092f\u0924 \u0915\u093e \u0909\u091a\u093f\u0924 \u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964",form:{heading:"\u0915\u0943\u092a\u092f\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0935\u093f\u0935\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",state:"\u0930\u093e\u091c\u094d\u092f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",enquirer:"(\u0938\u094d\u0935\u092f\u0902/\u0905\u0928\u094d\u092f) \u0915\u0947 \u0932\u093f\u090f \u0936\u093f\u0915\u093e\u092f\u0924/\u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e",complaintType:"\u0936\u093f\u0915\u093e\u092f\u0924/\u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",categoryType:"\u0936\u094d\u0930\u0947\u0923\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",uploadDocumentLabel:"\u0935\u093f\u0935\u0930\u0923 \u0926\u0947\u0916\u0947\u0902 \u0914\u0930 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902 (\u092f\u0926\u093f \u0915\u094b\u0908 \u0939\u094b)",statusField:"\u0908\u0906\u0908\u0921\u0940/\u090f\u0938\u0906\u0930\u090f\u0928/\u092f\u0942\u0906\u0930\u090f\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",placeholder:"\u092a\u094d\u0930\u093f\u092f \u0928\u093f\u0935\u093e\u0938\u0940, \u0906\u092a\u0938\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0939\u0948 \u0915\u093f \u0905\u092a\u0928\u0940 \u091a\u093f\u0902\u0924\u093e \u0915\u094b \u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0922\u0902\u0917 \u0938\u0947 \u0939\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f {{fields}} \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0947\u0902\u0964",error:{complaintType:"\u0936\u093f\u0915\u093e\u092f\u0924/\u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u091a\u092f\u0928\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948",categoryType:"\u0936\u094d\u0930\u0947\u0923\u0940 \u091a\u092f\u0928\u093f\u0924 \u0928\u0939\u0940\u0902",state:"\u0930\u093e\u091c\u094d\u092f \u091a\u092f\u0928\u093f\u0924 \u0928\u0939\u0940\u0902",enquirer:"\u092a\u0942\u091b\u0924\u093e\u091b\u0915\u0930\u094d\u0924\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u091a\u092f\u0928\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948"}},Complaintnote:"\u0906\u092a\u0915\u0940 \u0936\u093f\u0915\u093e\u092f\u0924 \u0915\u0947 \u0924\u094d\u0935\u0930\u093f\u0924 \u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u0940 \u0936\u093f\u0915\u093e\u092f\u0924/\u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0926\u0943\u0922\u093c\u0924\u093e \u0938\u0947 \u0938\u0932\u093e\u0939 \u0926\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0917\u0932\u0924 \u0936\u093f\u0915\u093e\u092f\u0924/\u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0906\u092a\u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u092f\u093e \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0926\u0947\u0930\u0940 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948",Categorynote:"\u0906\u092a\u0915\u0940 \u0936\u093f\u0915\u093e\u092f\u0924 \u0915\u0947 \u0924\u094d\u0935\u0930\u093f\u0924 \u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u0940 \u0936\u094d\u0930\u0947\u0923\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0926\u0943\u0922\u093c\u0924\u093e \u0938\u0947 \u0938\u0932\u093e\u0939 \u0926\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0917\u0932\u0924 \u0936\u094d\u0930\u0947\u0923\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0947 \u091a\u092f\u0928 \u0938\u0947 \u0906\u092a\u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u092f\u093e \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0926\u0947\u0930\u0940 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948",feedbackTextArea:" \u0915\u0943\u09