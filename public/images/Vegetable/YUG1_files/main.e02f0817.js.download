b\u0a3e\u0a08\u0a32 \u0a09\u0a2a\u0a30\u0a4b\u0a15\u0a24 \u0a38\u0a3c\u0a47\u0a05\u0a30 \u0a15\u0a4b\u0a21 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a2a\u0a3e\u0a38\u0a35\u0a30\u0a21 \u0a28\u0a3e\u0a32 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a05\u0a24 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a40\u0964 \u0a21\u0a3e\u0a09\u0a28\u0a32\u0a4b\u0a21 '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a28 '\u0a24\u0a47, \u0a2b\u0a3e\u0a08\u0a32 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a21\u0a3f\u0a35\u0a3e\u0a08\u0a38 / \u0a21\u0a48\u0a38\u0a15\u0a1f\u0a3e\u0a2a \u0a35\u0a3f\u0a71\u0a1a \u0a21\u0a3e\u0a0a\u0a28\u0a32\u0a4b\u0a21 \u0a39\u0a4b \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a40\u0964",placeholderText:"4 - \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a3e \u0a38\u0a3c\u0a47\u0a05\u0a30 \u0a15\u0a4b\u0a21 \u0a2c\u0a23\u0a3e\u0a07\u0a06 \u0a1c\u0a3e\u0a23\u0a3e \u0a39\u0a48"},success:{desc:"\u0a38\u0a47\u0a35\u0a3e \u0a26\u0a3e \u0a32\u0a3e\u0a2d \u0a32\u0a48\u0a23 \u0a32\u0a08 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a38\u0a3c\u0a47\u0a05\u0a30 \u0a15\u0a30\u0a4b",p1:"ZIP \u0a2b\u0a3e\u0a08\u0a32",p2:"\u0a38\u0a3c\u0a47\u0a05\u0a30 \u0a15\u0a4b\u0a21",p3:"\u0a38\u0a47\u0a35\u0a3e \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a24\u0a3e \u0a28\u0a3e\u0a32 \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30",summary:"\u0a07\u0a39 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a07\u0a15\u0a71\u0a20\u0a3e \u0a15\u0a30\u0a28 \u0a1c\u0a3e\u0a02 \u0a38\u0a1f\u0a4b\u0a30 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a24\u0a4b\u0a02 \u0a2c\u0a3f\u0a28\u0a3e\u0a02 \u0a38\u0a47\u0a35\u0a3e \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a24\u0a3e\u0a35\u0a3e\u0a02 / \u0a14\u0a2b\u0a32\u0a3e\u0a08\u0a28 \u0a35\u0a48\u0a30\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a38\u0a3c\u0a28 \u0a38\u0a40\u0a15\u0a3f\u0a70\u0a17 \u0a07\u0a15\u0a3e\u0a08 (OVSE) \u0a28\u0a42\u0a70 \u0a14\u0a2b\u0a32\u0a3e\u0a08\u0a28 \u0a06\u0a27\u0a3e\u0a30 \u0a35\u0a48\u0a30\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a38\u0a3c\u0a28 \u0a26\u0a40 \u0a38\u0a39\u0a42\u0a32\u0a24 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a47\u0a17\u0a3e\u0964"},descTextStep1:"\u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a47\u0a2a\u0a30 \u0a30\u0a39\u0a3f\u0a24 \u0a14\u0a2b\u0a32\u0a3e\u0a08\u0a28 \u0a08-\u0a15\u0a47\u0a35\u0a3e\u0a08\u0a38\u0a40 \u0a07\u0a71\u0a15 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a05\u0a24 \u0a05\u0a24\u0a47 \u0a38\u0a3e\u0a02\u0a1d\u0a3e \u0a15\u0a30\u0a28 \u0a2f\u0a4b\u0a17 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a39\u0a48 \u0a1c\u0a4b \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a2a\u0a1b\u0a3e\u0a23 \u0a26\u0a40 \u0a14\u0a2b\u0a32\u0a3e\u0a08\u0a28 \u0a24\u0a38\u0a26\u0a40\u0a15 \u0a32\u0a08 \u0a35\u0a30\u0a24\u0a3f\u0a06 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a28\u0a3e\u0a2e, \u0a2a\u0a24\u0a3e, \u0a2b\u0a4b\u0a1f\u0a4b, \u0a32\u0a3f\u0a70\u0a17, DoB, \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a3e \u0a39\u0a48\u0a38\u0a3c, \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a08\u0a2e\u0a47\u0a32, \u0a2a\u0a24\u0a3e \u0a05\u0a24\u0a47 \u0a39\u0a35\u0a3e\u0a32\u0a3e \u0a06\u0a08\u0a21\u0a40 \u0a26\u0a3e \u0a39\u0a48\u0a38\u0a3c \u0a38\u0a3c\u0a3e\u0a2e\u0a32 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e \u0a1c\u0a3f\u0a38 \u0a35\u0a3f\u0a71\u0a1a \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a47 \u0a06\u0a16\u0a30\u0a40 4 \u0a05\u0a70\u0a15 \u0a39\u0a4b\u0a23\u0a17\u0a47 \u0a05\u0a24\u0a47 \u0a07\u0a71\u0a15 \u0a21\u0a3f\u0a1c\u0a40\u0a1f\u0a32\u0a40 \u0a26\u0a38\u0a24\u0a16\u0a24 \u0a15\u0a40\u0a24\u0a47 XML \u0a35\u0a3f\u0a71\u0a1a \u0a1f\u0a3e\u0a08\u0a2e \u0a38\u0a1f\u0a48\u0a02\u0a2a \u0a39\u0a4b\u0a23\u0a17\u0a47\u0964",descTextStep2:"\u0a14\u0a2b\u0a32\u0a3e\u0a08\u0a28 eKYC \u0a32\u0a08 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 ZIP \u0a2b\u0a3e\u0a08\u0a32 \u0a38\u0a2b\u0a32\u0a24\u0a3e\u0a2a\u0a42\u0a30\u0a35\u0a15 \u0a21\u0a3e\u0a09\u0a28\u0a32\u0a4b\u0a21 \u0a15\u0a40\u0a24\u0a40 \u0a17\u0a08 \u0a39\u0a48"},lockUnlockBiometrics:{serviceCard:{errorMessage:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a09\u0a21\u0a40\u0a15 \u0a15\u0a30\u0a4b \u0a1c\u0a26\u0a4b\u0a02 \u0a24\u0a71\u0a15 \u0a05\u0a38\u0a40\u0a02 \u0a2e\u0a4c\u0a1c\u0a42\u0a26\u0a3e \u0a32\u0a4c\u0a15/\u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30\u0a26\u0a47 \u0a39\u0a3e\u0a02\u0964"},howItWorks:{title:"\u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 \u0a32\u0a4c\u0a15/\u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a15\u0a70\u0a2e \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48",description:"\u0a2c\u0a3e\u0a07\u0a13 \u0a32\u0a3e\u0a15/\u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e \u0a35\u0a38\u0a28\u0a40\u0a15 \u0a26\u0a47 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 \u0a21\u0a47\u0a1f\u0a3e \u0a26\u0a40 \u0a38\u0a70\u0a2d\u0a3e\u0a35\u0a3f\u0a24 \u0a26\u0a41\u0a30\u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a28\u0a42\u0a70 \u0a30\u0a4b\u0a15\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a32\u0a4c\u0a15 \u0a15\u0a40\u0a24\u0a47 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a08 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a28\u0a42\u0a70 \u0a30\u0a4b\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a07\u0a38 \u0a38\u0a47\u0a35\u0a3e \u0a26\u0a47 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 \u0a24\u0a4b\u0a02 \u0a07\u0a28\u0a15\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a30\u0a4b\u0a15\u0a23 \u0a32\u0a08 \u0a27\u0a3f\u0a06\u0a28 \u0a28\u0a3e\u0a32 \u0a05\u0a1c\u0a3f\u0a39\u0a3e \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a1a\u0a47\u0a24\u0a3e\u0a35\u0a28\u0a40 \u0a26\u0a3f\u0a71\u0a24\u0a40 \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48\u0964",infoData:{stepOneDescription:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a06\u0a2a\u0a23\u0a47 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 \u0a28\u0a42\u0a70 \u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a21\u0a48\u0a38\u0a3c\u0a2c\u0a4b\u0a30\u0a21 \u0a24\u0a4b\u0a02 \u0a07\u0a38 \u0a38\u0a47\u0a35\u0a3e \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a4b\u0964 \u0a1c\u0a26\u0a4b\u0a02 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a06\u0a2a\u0a23\u0a47 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 (\u0a2b\u0a3f\u0a70\u0a17\u0a30\u0a2a\u0a4d\u0a30\u0a3f\u0a70\u0a1f, \u0a06\u0a08\u0a30\u0a3f\u0a38 \u0a05\u0a24\u0a47 \u0a1a\u0a3f\u0a39\u0a30\u0a3e) \u0a28\u0a42\u0a70 \u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a26\u0a47 \u0a39\u0a4b \u0a24\u0a3e\u0a02 \u0a09\u0a39\u0a28\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a40\u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a28\u0a39\u0a40\u0a02 \u0a35\u0a30\u0a24\u0a3f\u0a06 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a39\u0a3e\u0a32\u0a3e\u0a02\u0a15\u0a3f, \u0a13\u0a1f\u0a40\u0a2a\u0a40-\u0a05\u0a27\u0a3e\u0a30\u0a3f\u0a24 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e, \u0a32\u0a4b\u0a5c \u0a05\u0a28\u0a41\u0a38\u0a3e\u0a30 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a39\u0a41\u0a70\u0a26\u0a40 \u0a30\u0a39\u0a47\u0a17\u0a40\u0964",stepTwoDescription:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a07\u0a38 \u0a2a\u0a70\u0a28\u0a47 '\u0a24\u0a47 \u0a35\u0a3e\u0a2a\u0a38 \u0a1c\u0a3e\u0a13 \u0a05\u0a24\u0a47 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a05\u0a71\u0a17\u0a47 \u0a35\u0a27\u0a4b\u0964 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 '\u0a24\u0a47 (\u0a2b\u0a3f\u0a70\u0a17\u0a30\u0a2a\u0a4d\u0a30\u0a3f\u0a70\u0a1f + \u0a06\u0a08\u0a30\u0a3f\u0a38 + \u0a1a\u0a3f\u0a39\u0a30\u0a3e) \u0a13\u0a1f\u0a40\u0a2a\u0a40 \u0a05\u0a27\u0a3e\u0a30\u0a24 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a40\u0a15\u0a30\u0a28 \u0a26\u0a47 \u0a28\u0a3e\u0a32 \u0a38\u0a2e\u0a30\u0a71\u0a25 \u0a39\u0a4b \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a3e\u0964"}},selectionScreen:{unlockCard:{heading:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a1a\u0a41\u0a23\u0a4b",consentText:"\u0a2e\u0a48\u0a02 \u0a38\u0a2e\u0a1d\u0a26\u0a3e/\u0a38\u0a2e\u0a1d\u0a26\u0a40 \u0a39\u0a3e\u0a02 \u0a15\u0a3f \u0a2e\u0a47\u0a30\u0a47 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15 \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26, \u0a2e\u0a48\u0a02 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e \u0a15\u0a30\u0a28 \u0a26\u0a47 \u0a2f\u0a4b\u0a17 \u0a39\u0a4b \u0a1c\u0a3e\u0a35\u0a3e\u0a02\u0a17\u0a3e\u0964",label:"\u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a4b"},lockCard:{heading:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a1a\u0a41\u0a23\u0a4b",consentText:"\u0a2e\u0a48\u0a02 \u0a38\u0a2e\u0a1d\u0a26\u0a3e/\u0a38\u0a2e\u0a1d\u0a26\u0a40 \u0a39\u0a3e\u0a02 \u0a15\u0a3f \u0a2e\u0a47\u0a30\u0a47 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15 \u0a28\u0a42\u0a70 \u0a32\u0a3e\u0a15 \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26, \u0a2e\u0a48\u0a02 \u0a09\u0a26\u0a4b\u0a02 \u0a24\u0a71\u0a15 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a40\u0a15\u0a30\u0a28 \u0a15\u0a30\u0a28 \u0a26\u0a47 \u0a2f\u0a4b\u0a17 \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a4b\u0a35\u0a3e\u0a02\u0a17\u0a3e \u0a1c\u0a26\u0a4b\u0a02 \u0a24\u0a71\u0a15 \u0a2e\u0a48\u0a02 \u0a06\u0a2a\u0a23\u0a47 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a28\u0a39\u0a40\u0a02 \u0a15\u0a30 \u0a32\u0a48\u0a02\u0a26\u0a3e\u0964",label:"\u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 \u0a28\u0a42\u0a70 \u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a4b"},selectOptionError:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a38\u0a3f\u0a30\u0a2b\u0a3c \u0a07\u0a71\u0a15 \u0a35\u0a3f\u0a15\u0a32\u0a2a \u0a1a\u0a41\u0a23\u0a4b\u0964",selectButton:{tempUnlock:"\u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 \u0a28\u0a42\u0a70 \u0a05\u0a38\u0a25\u0a3e\u0a08 \u0a24\u0a4c\u0a30 '\u0a24\u0a47 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a4b",tempUnlockInfo:"\u0a25\u0a4b\u0a5c\u0a4d\u0a39\u0a47 \u0a38\u0a2e\u0a47\u0a02 \u0a32\u0a08",unlock:"\u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 \u0a28\u0a42\u0a70 \u0a38\u0a25\u0a3e\u0a08 \u0a24\u0a4c\u0a30 '\u0a24\u0a47 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a4b",unlockInfo:"\u0a05\u0a17\u0a32\u0a40 \u0a35\u0a3e\u0a30 \u0a1c\u0a26\u0a4b\u0a02 \u0a24\u0a71\u0a15 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a4b"}},successScreen:{tempUnlockMessage:"\u0a1c\u0a47\u0a15\u0a30 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a38\u0a25\u0a3e\u0a08 \u0a24\u0a4c\u0a30 '\u0a24\u0a47 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a47 \u0a39\u0a4b, \u0a24\u0a3e\u0a02 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a21\u0a48\u0a38\u0a3c\u0a2c\u0a4b\u0a30\u0a21 \u0a24\u0a4b\u0a02 \u0a07\u0a38 \u0a38\u0a47\u0a35\u0a3e \u0a26\u0a40 \u0a2e\u0a41\u0a5c \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a4b\u0964"}},lockUnlockAadhaar:{howItWorks:{title:"\u0a06\u0a27\u0a3e\u0a30 \u0a32\u0a4c\u0a15/\u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a15\u0a70\u0a2e \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48",infoData:{stepOneLabel:"3 \u0a35\u0a3f\u0a71\u0a1a\u0a4b\u0a02 1 \u0a2a\u0a5c\u0a3e\u0a05: ",stepOneDescription:"\u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a32\u0a4c\u0a15 / \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02, \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 16-\u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a40 \u0a35\u0a30\u0a1a\u0a41\u0a05\u0a32 \u0a06\u0a08\u0a21\u0a40 (VID) \u0a2c\u0a23\u0a3e\u0a13, \u0a15\u0a3f\u0a09\u0a02\u0a15\u0a3f \u0a38\u0a3f\u0a30\u0a2b\u0a3c VID \u0a15\u0a4b\u0a32 \u0a39\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a32\u0a4c\u0a15/\u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a38\u0a2e\u0a30\u0a71\u0a25\u0a3e \u0a39\u0a48\u0964 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a21\u0a48\u0a38\u0a3c\u0a2c\u0a4b\u0a30\u0a21 \u0a24\u0a4b\u0a02 \u0a35\u0a30\u0a1a\u0a42\u0a05\u0a32 ID \u0a38\u0a47\u0a35\u0a3e \u0a38\u0a3f\u0a30\u0a1c\u0a23 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a1c\u0a3e\u0a02 1947 \u0a28\u0a42\u0a70 \u0a07\u0a71\u0a15 SMS \u0a2d\u0a47\u0a1c \u0a15\u0a47 \u0a06\u0a2a\u0a23\u0a3e VID \u0a2c\u0a23\u0a3e \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964 \u0a06\u0a30 \u0a35\u0a40 \u0a06\u0a08 \u0a21\u0a40 [UID \u0a26\u0a47 \u0a2a\u0a3f\u0a1b\u0a32\u0a47 4 \u0a1c\u0a3e\u0a02 8 \u0a05\u0a70\u0a15] {ex: RVID 1234}\u0964 ",stepOneLinkText:" VID \u0a1c\u0a28\u0a30\u0a47\u0a1f \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b",stepTwoLabel:"3 \u0a35\u0a3f\u0a71\u0a1a\u0a4b\u0a02 2 \u0a2a\u0a5c\u0a3e\u0a05: ",stepTwoDescription:"\u0a07\u0a71\u0a15 \u0a35\u0a3e\u0a30 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 VID \u0a1c\u0a28\u0a30\u0a47\u0a1f \u0a39\u0a4b \u0a1c\u0a3e\u0a23 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26, \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a07\u0a38 \u0a2a\u0a70\u0a28\u0a47 '\u0a24\u0a47 \u0a35\u0a3e\u0a2a\u0a38 \u0a1c\u0a3e\u0a13 \u0a05\u0a24\u0a47 \u0a06\u0a2a\u0a23\u0a47 VID \u0a28\u0a3e\u0a32 \u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a05\u0a71\u0a17\u0a47 \u0a35\u0a27\u0a4b, \u0a2b\u0a3f\u0a30 \u0a1c\u0a26\u0a4b\u0a02 \u0a35\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a4b\u0a35\u0a47 \u0a06\u0a2a\u0a23\u0a40 VID \u0a28\u0a3e\u0a32 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a24 \u0a15\u0a30\u0a4b, \u0a15\u0a3f\u0a09\u0a02\u0a15\u0a3f \u0a07\u0a71\u0a15 \u0a35\u0a3e\u0a30 \u0a32\u0a4c\u0a15 \u0a39\u0a4b\u0a23 '\u0a24\u0a47 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a40\u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a28\u0a3e \u0a05\u0a2f\u0a4b\u0a17 \u0a39\u0a4b \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a3e\u0964",stepThreeLabel:"3 \u0a35\u0a3f\u0a71\u0a1a\u0a4b\u0a02 3 \u0a2a\u0a5c\u0a3e\u0a05: ",stepThreeDescription:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a07\u0a38 \u0a2a\u0a70\u0a28\u0a47 '\u0a24\u0a47 \u0a35\u0a3e\u0a2a\u0a38 \u0a1c\u0a3e\u0a13 \u0a05\u0a24\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a05\u0a71\u0a17\u0a47 \u0a35\u0a27\u0a4b; \u0a38\u0a3f\u0a30\u0a2b\u0a3c VID \u0a15\u0a4b\u0a32 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a38\u0a2e\u0a30\u0a71\u0a25\u0a3e \u0a39\u0a48, \u0a1c\u0a26\u0a4b\u0a02 \u0a15\u0a3f \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30-\u0a05\u0a27\u0a3e\u0a30\u0a3f\u0a24 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a40\u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a35\u0a40 \u0a07\u0a1c\u0a3e\u0a1c\u0a3c\u0a24 \u0a26\u0a3f\u0a70\u0a26\u0a3e \u0a39\u0a48\u0964"}},formScreen:{title:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a32\u0a4c\u0a15/\u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a32\u0a4b\u0a5c\u0a40\u0a02\u0a26\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b",radioLabels:{lockAadhaar:"\u0a32\u0a4c\u0a15 \u0a05\u0a27\u0a3e\u0a30",unlockAadhaar:"\u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a4b"},consent:{lockConsent:"\u0a2e\u0a48\u0a02 \u0a38\u0a2e\u0a1d\u0a26\u0a3e/\u0a38\u0a2e\u0a1d\u0a26\u0a40 \u0a39\u0a3e\u0a02 \u0a15\u0a3f \u0a2e\u0a47\u0a30\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26, \u0a2e\u0a48\u0a02 \u0a38\u0a3f\u0a30\u0a2b\u0a3c \u0a35\u0a30\u0a1a\u0a41\u0a05\u0a32 \u0a06\u0a08.\u0a21\u0a40. (\u0a35\u0a40.\u0a06\u0a08.\u0a21\u0a40.) \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a40\u0a15\u0a30\u0a28 \u0a15\u0a30\u0a28 \u0a26\u0a47 \u0a2f\u0a4b\u0a17 \u0a39\u0a4b\u0a35\u0a3e\u0a02\u0a17\u0a3e \u0a28\u0a3e \u0a15\u0a3f \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a40\u0964",unlockConsent:"\u0a2e\u0a48\u0a02 \u0a38\u0a2e\u0a1d\u0a26\u0a3e/\u0a38\u0a2e\u0a1d\u0a26\u0a40 \u0a39\u0a3e\u0a02 \u0a15\u0a3f \u0a2e\u0a47\u0a30\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26, \u0a2e\u0a48\u0a02 \u0a3