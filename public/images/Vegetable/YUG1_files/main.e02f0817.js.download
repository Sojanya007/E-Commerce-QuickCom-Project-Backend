u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u093e",description:"\u0906\u0927\u093e\u0930\u0938\u0939 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0935 \u0908\u092e\u0947\u0932 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"},checkAadhaarValidity:{title:"\u0906\u0927\u093e\u0930\u091a\u0940 \u0935\u0948\u0927\u0924\u093e \u0924\u092a\u093e\u0938\u093e",description:"\u0906\u0927\u093e\u0930\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e."},orderPVCStatus:{title:"\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0911\u0930\u094d\u0921\u0930 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u093e",description:"\u0906\u0927\u0940\u092a\u093e\u0938\u0942\u0928 \u0911\u0930\u094d\u0921\u0930 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"},enrolmentAndUpdateStatus:{title:"\u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0935 \u0905\u0926\u094d\u092f\u0924\u0928 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u093e",description:"\u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0915\u093f\u0902\u0935\u093e \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0935\u093f\u0928\u0902\u0924\u0940 \u0924\u092a\u093e\u0938\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"},bookAppointment:{title:"\u0905\u092a\u0949\u0908\u0902\u091f\u092e\u0947\u0902\u091f \u092c\u0941\u0915 \u0915\u0930\u093e",description:"\u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u093f\u0902\u0935\u093e \u0905\u0926\u094d\u092f\u0924\u0928\u093e\u091a\u0940 \u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940 \u092c\u0941\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"},vidGenerator:{title:"\u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u091c\u0928\u0930\u0947\u091f\u0930",description:"\u0906\u092a\u0932\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u0936\u0940 \u0932\u093f\u0902\u0915 \u0915\u0947\u0932\u0947\u0932\u093e \u0967\u096c \u0905\u0902\u0915\u0940 \u0935\u094d\u0939\u0930\u094d\u091a\u094d\u092f\u0941\u0905\u0932 \u0906\u092f\u0921\u0940 (\u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940) \u0924\u092f\u093e\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"},lec:{title:"\u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u094b\u0927\u093e",description:"\u091c\u0935\u0933\u092a\u093e\u0938 \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u0947 \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"},lockUnlockAadhaar:{title:"\u0906\u0927\u093e\u0930 \u0932\u0949\u0915 / \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u093e",description:"\u0906\u092a\u0932\u093e \u0906\u0927\u093e\u0930 \u0924\u093e\u0924\u094d\u092a\u0941\u0930\u0924\u0947 \u0932\u0949\u0915 / \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. \u0915\u0943\u092a\u092f\u093e \u0939\u0940 \u0938\u0947\u0935\u093e \u0915\u093e\u0933\u091c\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u0935\u093e\u092a\u0930\u093e"},complaintStatus:{title:"\u0924\u0915\u094d\u0930\u093e\u0930 / \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u093e",description:"\u0924\u0915\u094d\u0930\u093e\u0930/\u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f\u093e\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"},fileComplaint:{title:"\u0924\u0915\u094d\u0930\u093e\u0930 \u0906\u0923\u093f \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f",description:"\u0924\u0941\u092e\u091a\u0940 \u0924\u0915\u094d\u0930\u093e\u0930 \u0906\u0923\u093f \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0928\u094b\u0902\u0926\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"}}}},documentUpdate:{intentPage:{title:"\u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u0926\u094d\u092f\u0924\u0928 \u0938\u0947\u0935\u0947\u091a\u0947 \u0909\u0926\u094d\u0926\u093f\u0937\u094d\u091f",p1:"\u092a\u094d\u0930\u093f\u092f \u0930\u0939\u093f\u0935\u093e\u0938\u0940,",p2:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e\u092c\u0947\u0938\u092e\u0927\u094d\u092f\u0947 \u0928\u0935\u0940\u0928 \u0913\u0933\u0916\u0940\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e (POI) \u0906\u0923\u093f \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e (POA) \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0942\u0928 \u0924\u0941\u092e\u091a\u093e \u0906\u0927\u093e\u0930 \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u093e \u0938\u0932\u094d\u0932\u093e \u0926\u093f\u0932\u093e \u091c\u093e\u0924\u094b. POI/POA \u0926\u0938\u094d\u0924\u0910\u0935\u091c\u093e\u0902\u092e\u0927\u0940\u0932 \u0924\u092a\u0936\u0940\u0932 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u092e\u0927\u094d\u092f\u0947 \u0928\u092e\u0942\u0926 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0924\u092a\u0936\u0940\u0932\u093e\u0902\u0936\u0940 \u091c\u0941\u0933\u0932\u0947 \u092a\u093e\u0939\u093f\u091c\u0947\u0924. \u0939\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e\u092c\u0947\u0938\u092e\u0927\u0940\u0932 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092e\u093e\u0939\u093f\u0924\u0940\u091a\u0940 \u0938\u0924\u0924 \u0905\u091a\u0942\u0915\u0924\u093e \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u092e\u0926\u0924 \u0915\u0930\u0947\u0932.",p3:"\u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0906\u0927\u093e\u0930 \u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u0915\u093f\u0902\u0935\u093e myAadhaar \u092a\u094b\u0930\u094d\u091f\u0932\u0926\u094d\u0935\u093e\u0930\u0947 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0906\u0927\u0940\u091a \u0905\u092a\u0921\u0947\u091f \u0915\u0947\u0932\u0940 \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0915\u0943\u092a\u092f\u093e \u0924\u094d\u092f\u093e\u091a\u0940 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u0940 \u0939\u094b\u0923\u094d\u092f\u093e\u091a\u0940 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u093e \u0905\u0928\u094d\u092f\u0925\u093e. \u0938\u092c\u092e\u093f\u091f \u0915\u0947\u0932\u0947\u0932\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0928\u093e\u0915\u093e\u0930\u0932\u094d\u092f\u093e\u0938, \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u092a\u0941\u0928\u094d\u0939\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u093e\u0935\u0947 \u0932\u093e\u0917\u0947\u0932.",p4:"\u091c\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u092e\u0927\u0940\u0932 \u092a\u0924\u094d\u0924\u093e \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0930\u093e\u092f\u091a\u093e \u0905\u0938\u0947\u0932 \u0924\u0930 \u0915\u0943\u092a\u092f\u093e \u092f\u0947\u0925\u0947",p5:"\u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e.",p6:"\u0938\u0947\u0935\u093e\u0902\u0938\u093e\u0920\u0940 25/- \u0928\u093e\u092e\u092e\u093e\u0924\u094d\u0930 \u0936\u0941\u0932\u094d\u0915 \u092d\u0930\u093e\u0935\u0947 \u0932\u093e\u0917\u0947\u0932, \u091c\u0947 \u092a\u0930\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u092f\u094b\u0917\u094d\u092f \u0928\u093e\u0939\u0940.",p7:"\u0939\u0940 \u0938\u0947\u0935\u093e 14/06/2025 \u092a\u0930\u094d\u092f\u0902\u0924 \u0935\u093f\u0928\u093e\u092e\u0942\u0932\u094d\u092f \u0906\u0939\u0947"},howItWorks:{description:"\u0915\u0943\u092a\u092f\u093e \u0916\u093e\u0932\u0940\u0932 \u091a\u0930\u0923 \u0915\u093e\u0933\u091c\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u0935\u093e\u091a\u093e. \u0935\u093f\u0928\u0902\u0924\u0940\u0935\u0930 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0915\u093f\u0902\u0935\u093e \u0928\u093e\u0915\u093e\u0930\u0923\u094d\u092f\u093e\u0924 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u0935\u093f\u0932\u0902\u092c \u091f\u093e\u0933\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u093f\u0935\u093f\u0927 \u091a\u0930\u0923\u093e\u0902\u0935\u0930 \u0938\u0941\u091a\u0935\u093f\u0932\u0947\u0932\u094d\u092f\u093e \u0915\u0943\u0924\u0940\u0902\u091a\u0947 \u0905\u0928\u0941\u0938\u0930\u0923 \u0915\u0930\u093e. \u091c\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u092e\u0927\u0940\u0932 \u092a\u0924\u094d\u0924\u093e \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0930\u093e\u092f\u091a\u093e \u0905\u0938\u0947\u0932 \u0924\u0930 \u0915\u0943\u092a\u092f\u093e \u092f\u0947\u0925\u0947",stepDescription:{one:"\u0924\u0941\u092e\u091a\u093e \u0913\u0933\u0916\u0940\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e (PoI) \u0906\u0923\u093f \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e (PoA) \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e",two:"\u092f\u093e \u091a\u0930\u0923\u093e\u0924, \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0935\u0948\u0927 POI/POA \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u093e\u0902\u0917\u093f\u0924\u0932\u0947 \u091c\u093e\u0908\u0932 \u091c\u094d\u092f\u093e\u0924 \u091a\u0930\u0923 1 \u092e\u0927\u094d\u092f\u0947 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0947\u0932\u0947\u0932\u0947 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0924\u092a\u0936\u0940\u0932 \u0906\u0939\u0947\u0924.",three:"\u092f\u093e \u0938\u0947\u0935\u0947\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0930\u0941 25 (\u0915\u0947\u0935\u0933 \u092a\u0902\u091a\u0935\u0940\u0938 \u0930\u0941\u092a\u092f\u0947) \u092d\u0930\u093e\u0935\u0947 \u0932\u093e\u0917\u0924\u0940\u0932. \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u094d\u0930\u0947\u0921\u093f\u091f/\u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u0915\u093f\u0902\u0935\u093e \u0928\u0947\u091f \u092c\u0901\u0915\u093f\u0902\u0917\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e. \u0939\u0940 \u0930\u0915\u094d\u0915\u092e \u092a\u0930\u0924 \u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u092f\u094b\u0917\u094d\u092f \u0906\u0939\u0947."},note:"\u091c\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0924\u0941\u092e\u091a\u0947 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0924\u092a\u0936\u0940\u0932 (\u0928\u093e\u0935, \u0921\u0940\u0913\u092c\u0940, \u0932\u093f\u0902\u0917 \u0915\u093f\u0902\u0935\u093e \u092a\u0924\u094d\u0924\u093e) \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0930\u093e\u092f\u091a\u0947 \u0905\u0938\u0924\u0940\u0932 \u0924\u0930 \u091c\u0935\u0933\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e \u0906\u0923\u093f \u0915\u0947\u0935\u0933 \u092a\u0924\u094d\u0924\u093e \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947",noteLink:"\u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e."},currentSection:{form:{title:"\u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u0947 \u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f \u0924\u092a\u0936\u0940\u0932 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u093e",name:"\u0928\u093e\u0935",gender:"\u0932\u093f\u0902\u0917",dob:"\u091c\u0928\u094d\u092e\u0924\u093e\u0930\u0940\u0916",address:"\u092a\u0924\u094d\u0924\u093e",consent:"\u0935\u0930\u0940\u0932 \u0924\u092a\u0936\u0940\u0932 \u092c\u0930\u094b\u092c\u0930 \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u0947 \u092e\u0940 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0924\u094b."},note:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0924\u092a\u0936\u0940\u0932\u093e\u0924 \u0935\u093f\u0938\u0902\u0917\u0924\u0940 \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u0947 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0924\u092a\u0936\u0940\u0932 (\u0928\u093e\u0935, \u092a\u0924\u094d\u0924\u093e, \u0921\u0940\u0913\u092c\u0940 \u0915\u093f\u0902\u0935\u093e \u0932\u093f\u0902\u0917) \u091c\u0935\u0933\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0935\u0930 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0930\u093e \u0906\u0923\u093f \u0915\u0947\u0935\u0933 \u092a\u0924\u094d\u0924\u093e \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947",noteLink:"\u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e."},uploadSection:{confirmationPopUp:{title:"\u0915\u0943\u092a\u092f\u093e \u0926\u0938\u094d\u0924\u0910\u0935\u091c\u093e\u0924\u0940\u0932 \u0924\u0941\u092e\u091a\u093e \u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f \u0924\u092a\u0936\u0940\u0932 \u0906\u0927\u093e\u0930\u092e\u0927\u0940\u0932 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u0947\u091a\u094d\u092f\u093e \u0924\u092a\u0936\u0940\u0932\u093e\u0936\u0940 \u0924\u0902\u0924\u094b\u0924\u0902\u0924 \u091c\u0941\u0933\u0924\u094b \u092f\u093e\u091a\u0940 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u093e"},stepper:{verify:"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u093e",upload:"\u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u093e"},guidelines:{title:"\u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0915 \u0924\u0924\u094d\u0924\u094d\u0935\u0947",l1:"\u0926\u0938\u094d\u0924\u0910\u0935\u091c\u093e\u091a\u093e \u0906\u0915\u093e\u0930 2 MB \u092a\u0947\u0915\u094d\u0937\u093e \u0915\u092e\u0940 \u0905\u0938\u093e\u0935\u093e",l2:"\u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u092b\u093e\u0907\u0932 \u0938\u094d\u0935\u0930\u0942\u092a\u0947 \u0906\u0939\u0947\u0924: <b>JPEG, PNG</b> \u0906\u0923\u093f <b>PDF</b>"},form:{poiTitle:"\u0915\u0943\u092a\u092f\u093e \u0913\u0933\u0916\u0940\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e (POI) \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u093e",poaTitle:"\u0915\u0943\u092a\u092f\u093e \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e (POA) \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u093e"},consent:"\u092e\u0940 \u092f\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u092e\u093e\u091d\u0940 \u0938\u0902\u092e\u0924\u0940 \u0926\u0947\u0924\u094b \u0915\u0940 \u092e\u093e\u091d\u094d\u092f\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0947\u0932\u0947\u0932\u0940/\u0905\u092a\u0932\u094b\u0921 \u0915\u0947\u0932\u0947\u0932\u0940 \u092e\u093e\u0939\u093f\u0924\u0940/\u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0938\u0930\u0915\u093e\u0930\u0915\u0921\u0942\u0928 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u091f\u092a\u094d\u092a\u094d\u092f\u093e\u0935\u0930 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u0915\u0947\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924\u093e\u0924."},faq:{card:{heading:"\u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924",description_1:"",description_2:""},guidelines:{heading_1:"\u0913\u0933\u0916 \u0906\u0923\u093f \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0938\u092e\u0930\u094d\u0925\u0928\u093e\u0930\u094d\u0925 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u093e",heading_2:"14/06/2025 \u092a\u0930\u094d\u092f\u0902\u0924 \u092e\u094b\u092b\u0924",question_1:{title:"\u0915\u093e\u092f \u0938\u093e\u0926\u0930 \u0915\u0930\u093e\u092f\u091a\u0947?",content:{line_1:"\u0936\u093f\u0927\u093e\u092a\u0924\u094d\u0930\u093f\u0915\u093e, \u092e\u0924\u0926\u093e\u0930 \u0913\u0933\u0916\u092a\u0924\u094d\u0930, \u0938\u0930\u0915\u093e\u0930\u0928\u0947 \u0926\u093f\u0932\u0947\u0932\u0947 \u0913\u0933\u0916\u092a\u0924\u094d\u0930/\u092a\u0924\u094d\u0924\u093e \u0905\u0938\u0932\u0947\u0932\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u0906\u0923\u093f \u092d\u093e\u0930\u0924\u0940\u092f \u092a\u093e\u0938\u092a\u094b\u0930\u094d\u091f \u0939\u0947 \u0913\u0933\u0916 \u0906\u0923\u093f \u092a\u0924\u094d\u0924\u093e \u092f\u093e \u0926\u094b\u0928\u094d\u0939\u0940\u0902\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e \u092e\u094d\u0939\u0923\u0942\u0928 \u0915\u093e\u092e \u0915\u0930\u0924\u093e\u0924.",line_2:"\u092a\u0945\u0928 \u0915\u093e\u0930\u094d\u0921, \u0935\u093e\u0939\u0928 \u091a\u093e\u0932\u0935\u0923\u094d\u092f\u093e\u091a\u093e \u092a\u0930\u0935\u093e\u0928\u093e, \u092e\u093e\u0927\u094d\u092f\u092e\u093f\u0915 \u0915\u093f\u0902\u0935\u093e \u0935\u0930\u093f\u0937\u094d\u0920 \u0936\u093e\u0933\u0947\u091a\u0947 \u0917\u0941\u0923\u092a\u0924\u094d\u0930\u0915/\u091b\u093e\u092f\u093e\u091a\u093f\u0924\u094d\u0930 \u0905\u0938\u0932\u0947\u0932\u0947 \u0936\u093e\u0933\u093e \u0938\u094b\u0921\u0923\u094d\u092f\u093e\u091a\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930, \u0938\u0930\u0915\u093e\u0930\u0928\u0947 \u091c\u093e\u0930\u0940 \u0915\u0947\u0932\u0947\u0932\u0947 \u0913\u0933\u0916\u092a\u0924\u094d\u0930/\u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930-\u0915\u0947\u0935\u0933 \u0913\u0933\u0916\u0940\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e \u092e\u094d\u0939\u0923\u0942\u0928 \u0915\u093e\u092e \u0915\u0930\u0924\u093e\u0924.",line_3:"\u0935\u0940\u091c/\u092a\u093e\u0923\u0940/\u0917\u0945\u0938 \u092c\u093f\u0932 (\u092e\u093e\u0917\u0940\u0932 3 \u092e\u0939\u093f\u0928\u0947), \u092c\u0901\u0915/\u092a\u094b\u0938\u094d\u091f \u0911\u092b\u093f\u0938 \u092a\u093e\u0938\u092c\u0941\u0915, \u092d\u093e\u0921\u0947/\u092d\u093e\u0921\u0947\u092a\u091f\u094d\u091f\u0940/\u0930\u091c\u093e \u0906\u0923\u093f \u092a\u0930\u0935\u093e\u0928\u093e \u0915\u0930\u093e\u0930 \u0939\u0947 \u0915\u0947\u0935\u0933 \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e \u092e\u094d\u0939\u0923\u0942\u0928 \u0915\u093e\u092e \u0915\u0930\u0924\u093e\u0924.",line_4:"\u0938\u094d\u0935\u0940\u0915\u093e\u0930\u093e\u0930\u094d\u0939 \u0913\u0933\u0916 \u0906\u0923\u093f \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u093e\u0902\u091a\u094d\u092f\u093e \u0924\u092a\u0936\u0940\u0932\u0935\u093e\u0930 \u092f\u093e\u0926\u0940\u0938\u093e\u0920\u0940, \u0915\u0943\u092a\u092f\u093e \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e.",line_5:" here"}},question_2:{title:"\u0915\u0938\u0947 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u093e\u0935\u0947?",content:{line_1:"\u0906\u0927\u093e\u0930 \u092a\u094b\u0930\u094d\u091f\u0932   \u0935\u0930 \u0911\u0928\u0932\u093e\u0908\u0928 \u0915\u093f\u0902\u0935\u093e \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0932\u093e \u092d\u0947\u091f \u0926\u0947\u090a\u0928 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0938\u093e\u0926\u0930 \u0915\u0947\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924\u093e\u0924.",line_2:"\u0911\u0928\u0932\u093e\u0908\u0928 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0938\u093e\u0926\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u091f\u092a\u094d\u092a\u094d\u092f\u093e\u091f\u092a\u094d\u092a\u094d\u092f\u093e\u0928\u0947 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u0947\u0938\u093e\u0920\u0940 \u0915\u0943\u092a\u092f\u093e \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e.",line_3:" here"}},main_content:{submit:"\u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e",title:"\u092e\u0926\u0924 \u092a\u093e\u0939\u093f\u091c\u0947 \u0915\u093e?",videoText:"\u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0915",knowMoreText:"\u0905\u0927\u093f\u0915 \u091c\u093e\u0923\u0942\u0928 \u0918\u094d\u092f\u093e?",callText:"\u091f\u094b\u0932-\u092b\u094d\u0930\u0940 \u0915\u0949\u0932 \u0915\u0930\u093e (1947)"}},one:{title:"\u092e\u0940 \u092e\u093e\u091d\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u0938\u093e\u0920\u0940 \u0913\u0933\u0916 \u0906\u0923\u093f \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u091a\u0940 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0915\u093e \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u093e\u0935\u0940?",content:"\u0906\u0927\u093e\u0930\u0938\u093e\u0920\u0940 \u0913\u0933\u0916 \u0906\u0923\u093f \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0906\u0927\u093e\u0930\u092d\u0942\u0924 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0930\u093e\u0939\u0923\u0940\u092e\u093e\u0928 \u0938\u0941\u0932\u092d, \u0909\u0924\u094d\u0924\u092e \u0938\u0947\u0935\u093e \u0935\u093f\u0924\u0930\u0923 \u0906\u0923\u093f \u0905\u091a\u0942\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e\u0924. \u0924\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0905\u0932\u0940\u0915\u0921\u0940\u0932 \u0913\u0933\u0916 \u0906\u0923\u093f \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u091a\u0940 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0938\u093e\u0926\u0930 \u0915\u0930\u0923\u0947 \u0939\u0947 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915\u093e\u091a\u094d\u092f\u093e \u0939\u093f\u0924\u093e\u091a\u0947 \u0906\u0939\u0947."},two:{title:"\u092e\u093e\u091d\u0940 \u0913\u0933\u0916 \u0906\u0923\u093f \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092e\u0940 \u0915\u094b\u0923\u0924\u0940 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0938\u093e\u0926\u0930 \u0915\u0930\u093e\u0935\u0940\u0924? \u0913\u0933\u0916 \u0906\u0923\u093f \u092a\u0924\u094d\u0924\u093e \u0926\u094b\u0928\u094d\u0939\u0940\u0938\u093e\u0920\u0940 \u0926\u0938\u094d\u0924\u0910\u0935\u091c:",content:{para_1:{heading_one:"\u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u092a\u0924\u0947 \u0926\u094b\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c :",list_1:"(a) \u0936\u093f\u0927\u093e\u092a\u0924\u094d\u0930\u093f\u0915\u093e",list_2:"(b) \u092e\u0924\u0926\u093e\u0930 \u0913\u0933\u0916\u092a\u0924\u094d\u0930",list_3:"(c) \u0915\u093f\u0938\u093e\u0928 \u092b\u094b\u091f\u094b \u092a\u093e\u0938\u092c\u0941\u0915",list_4:"(d) \u092d\u093e\u0930\u0924\u0940\u092f \u092a\u093e\u0938\u092a\u094b\u0930\u094d\u091f",list_5:"(e) \u0938\u0930\u0915\u093e\u0930\u0928\u0947 \u091c\u093e\u0930\u0940 \u0915\u0947\u0932\u0947\u0932\u0947 \u0913\u0933\u0916\u092a\u0924\u094d\u0930/\u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u09301, ST/SC/OBC \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u0915\u093f\u0902\u0935\u093e \u0935\u093f\u0935\u093e\u0939 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930, \u092b\u094b\u091f\u094b \u0905\u0938\u0932\u0947\u0932\u0947",list_6:"(f) \u0905\u092a\u0902\u0917\u0924\u094d\u0935 \u0913\u0933\u0916\u092a\u0924\u094d\u0930 / \u0905\u092a\u0902\u0917\u0924\u094d\u0935\u093e\u091a\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930",list_7:"(g) \u091f\u094d\u0930\u093e\u0928\u094d\u0938\u091c\u0947\u0902\u0921\u0930 \u0913\u0933\u0916\u092a\u0924\u094d\u0930/\u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930",list_8:"(h) \u0938\u0947\u0915\u094d\u0938 \u0935\u0930\u094d\u0915\u0930\u091a\u094d\u092f\u093e \u0938\u0902\u0926\u0930\u094d\u092d\u093e\u0924 UIDAI \u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u0938\u094d\u0935\u0930\u0942\u092a\u093e\u0924 \u091c\u093e\u0930\u0940 \u0915\u0947\u0932\u0947\u0932\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930",list_9:"(i) \u092e\u093e\u0928\u094d\u092f\u0924\u093e\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0928\u093f\u0935\u093e\u0930\u093e\u0917\u0943\u0939\u0947 \u0915\u093f\u0902\u0935\u093e \u0905\u0928\u093e\u0925\u093e\u0936\u094d\u0930\u092e\u093e\u0902\u0926\u094d\u0935\u093e\u0930\u0947 UIDAI \u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u0938\u094d\u0935\u0930\u0942\u092a\u093e\u0924 \u091c\u093e\u0930\u0940 \u0915\u0947\u0932\u0947\u0932\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930",list_10:"(j) \u0924\u0941\u0930\u0941\u0902\u0917 \u0905\u0927\u093f\u0915\u093e\u0931\u094d\u092f\u093e\u0928\u0947 \u091c\u093e\u0930\u0940 \u0915\u0947\u0932\u0947\u0932\u093e \u0915\u0948\u0926\u0940 \u0907\u0902\u0921\u0915\u094d\u0936\u0928 \u0926\u0938\u094d\u0924\u0910\u0935\u091c"},para_2:{heading_one:"\u0913\u0933\u0916\u0940\u0938\u093e\u0920\u0940 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930:",list_1:"(a) \u0936\u093e\u0933\u093e \u0938\u094b\u0921\u0932\u094d\u092f\u093e\u091a\u093e \u0926\u093e\u0916\u0932\u093e/\u091b\u093e\u092f\u093e\u091a\u093f\u0924\u094d\u0930\u093e\u0938\u0939 \u0936\u093e\u0933\u093e \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u0923 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930",list_2:"(b) \u092b\u094b\u091f\u094b\u0938\u0939 \u092e\u093e\u0928\u094d\u092f\u0924\u093e\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0936\u093f\u0915\u094d\u0937\u0923 \u092e\u0902\u0921\u0933 \u0915\u093f\u0902\u0935\u093e \u0935\u093f\u0926\u094d\u092f\u093e\u092a\u0940\u0920\u093e\u0928\u0947 \u091c\u093e\u0930\u0940 \u0915\u0947\u0932\u0947\u0932\u0947 \u092e\u093e\u0930\u094d\u0915\u0936\u0940\u091f/\u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930",list_3:"(c) \u092a\u0945\u0928/\u0908-\u092a\u0945\u0928 \u0915\u093e\u0930\u094d\u0921",list_4:"(d) \u0938\u0930\u0915\u093e\u0930\u0940/\u0935\u0948\u0927\u093e\u0928\u093f\u0915-\u0938\u0902\u0938\u094d\u0925\u093e/PSU-\u091c\u093e\u0930\u0940 \u0915\u0947\u0932\u0947\u0932\u0947 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940/\u092a\u0947\u0928\u094d\u0936\u0928\u0930 \u092b\u094b\u091f\u094b \u0913\u0933\u0916\u092a\u0924\u094d\u0930, \u092a\u0947\u0928\u094d\u0936\u0928 \u092a\u0947\u092e\u0947\u0902\u091f \u0911\u0930\u094d\u0921\u0930 \u0915\u093f\u0902\u0935\u093e \u092e\u0947\u0921\u0940-\u0915\u094d\u0932\u0947\u092e \u0915\u093e\u0930\u094d\u0921",list_5:"(e) \u0935\u093e\u0939\u0928 \u091a\u093e\u0932\u0935\u093f\u0923\u094d\u092f\u093e\u091a\u093e \u092a\u0930\u0935\u093e\u0928\u093e",list_6:"(f) \u0938\u094d\u0935\u093e\u0924\u0902\u0924\u094d\u0930\u094d\u092f \u0938\u0948\u0928\u093f\u0915 \u092b\u094b\u091f\u094b \u0913\u0933\u0916\u092a\u0924\u094d\u0930"},para_3:{heading_one:"\u092a\u0924\u094d\u0924\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930:",list_1:"(\u090f) \u0935\u0940\u091c, \u092a\u093e\u0923\u0940, \u0917\u0945\u0938 \u0915\u093f\u0902\u0935\u093e \u091f\u0947\u0932\u093f\u092b\u094b\u0928/\u092e\u094b\u092c\u093e\u0907\u0932/\u092c\u094d\u0930\u0949\u0921\u092c\u0901\u0921 \u092c\u093f\u0932 (\u0924\u0940\u0928 \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u0902\u092a\u0947\u0915\u094d\u0937\u093e \u091c\u0941\u0928\u0947 \u0928\u093e\u0939\u0940)",list_2:"(\u092c\u0940) \u092b\u094b\u091f\u094b\u0938\u0939 \u0905\u0928\u0941\u0938\u0942\u091a\u093f\u0924 \u0915\u092e\u0930\u094d\u0936\u093f\u092f\u0932 \u092c\u0901\u0915 / \u092a\u094b\u0938\u094d\u091f \u0911\u092b\u093f\u0938 \u092a\u093e\u0938\u092c\u0941\u0915\u0935\u0930 \u0930\u0940\u0924\u0938\u0930 \u0938\u094d\u0935\u093e\u0915\u094d\u0937\u0930\u0940 \u0906\u0923\u093f \u0936\u093f\u0915\u094d\u0915\u093e \u092e\u093e\u0930\u0932\u0947\u0932\u093e",list_3:"(\u0938\u0940) \u0930\u0940\u0924\u0938\u0930 \u0938\u094d\u0935\u093e\u0915\u094d\u0937\u0930\u0940 \u0915\u0947\u0932\u0947\u0932\u0940 \u0906\u0923\u093f \u0936\u093f\u0915\u094d\u0915\u093e \u092e\u093e\u0930\u0932\u0947\u0932\u0940 \u0936\u0947\u0921\u094d\u092f\u0942\u0932\u094d\u0921 \u0915\u092e\u0930\u094d\u0936\u093f\u092f\u0932 \u092c\u0901\u0915 / \u092a\u094b\u0938\u094d\u091f \u0911\u092b\u093f\u0938 \u0916\u093e\u0924\u0947/\u0915\u094d\u0930\u0947\u0921\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f (\u0924\u0940\u0928 \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u0902\u092a\u0947\u0915\u094d\u0937\u093e \u091c\u0941\u0928\u0947 \u0928\u093e\u0939\u0940)",list_4:"(\u0921\u0940) \u0935\u0948\u0927 \u092d\u093e\u0921\u0947, \u092d\u093e\u0921\u0947\u092a\u091f\u094d\u091f\u0940 \u0915\u093f\u0902\u0935\u093e \u0930\u091c\u093e \u0906\u0923\u093f \u092a\u0930\u0935\u093e\u0928\u093e \u0915\u0930\u093e\u0930",list_5:"(\u0908) \u0916\u093e\u0938\u0926\u093e\u0930, \u0906\u092e\u0926\u093e\u0930, MLC, \u0928\u0917\u0930\u092a\u0930\u093f\u0937\u0926, \u0917\u091f '\u0905' \u0915\u093f\u0902\u0935\u093e '\u092c' \u0930\u093e\u091c\u092a\u0924\u094d\u0930\u093f\u0924 \u0905\u0927\u093f\u0915\u093e\u0930\u0940, EPFO \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0915\u093f\u0902\u0935\u093e \u0924\u0939\u0938\u0940\u0932\u0926\u093e\u0930 \u092f\u093e\u0902\u0928\u0940 UIDAI \u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u0938\u094d\u0935\u0930\u0942\u092a\u093e\u0924 \u091c\u093e\u0930\u0940 \u0915\u0947\u0932\u0947\u0932\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930",list_6:"(\u090f\u092b) \u0917\u094d\u0930\u093e\u092e\u092a\u0902\u091a\u093e\u092f\u0924 \u092a\u094d\u0930\u092e\u0941\u0916/\u0938\u091a\u093f\u0935, \u0917\u094d\u0930\u093e\u092e \u092e\u0939\u0938\u0942\u0932 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0915\u093f\u0902\u0935\u093e \u0938\u092e\u0924\u0941\u0932\u094d\u092f (\u0917\u094d\u0930\u093e\u092e\u0940\u0923 \u092d\u093e\u0917\u093e\u0902\u0938\u093e\u0920\u0940) \u092f\u093e\u0902\u0928\u0940 UIDAI \u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u0938\u094d\u0935\u0930\u0942\u092a\u093e\u0924 \u091c\u093e\u0930\u0940 \u0915\u0947\u0932\u0947\u0932\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930",list_7:"(\u091c\u0940) \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092e\u093e\u0928\u094d\u092f\u0924\u093e\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0936\u0948\u0915\u094d\u0937\u0923\u093f\u0915 \u0938\u0902\u0938\u094d\u0925\u0947\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u092e\u0941\u0916\u093e\u0928\u0947 UIDAI \u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u0938\u094d\u0935\u0930\u0942\u092a\u093e\u0924 \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0932\u093e \u0926\u093f\u0932\u0947\u0932\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930",list_8:"(\u090f\u091a)  \u092e\u093e\u0932\u092e\u0924\u094d\u0924\u093e \u0915\u0930 \u092a\u093e\u0935\u0924\u0940 (\u090f\u0915 \u0935\u0930\u094d\u0937\u093e\u092a\u0947\u0915\u094d\u0937\u093e \u091c\u0941\u0928\u0940 \u0928\u093e\u0939\u0940)",list_9:"(\u0906\u0908) \u0935\u0948\u0927 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u0935\u093f\u0915\u094d\u0930\u0940 \u0915\u0930\u093e\u0930 \u0915\u093f\u0902\u0935\u093e \u092d\u0947\u091f \u0915\u0930\u093e\u0930",list_10:"(\u091c\u0947) \u0938\u0930\u0915\u093e\u0930/\u0935\u0948\u0927\u093e\u0928\u093f\u0915-\u0938\u0902\u0938\u094d\u0925\u093e/PSU-\u091c\u093e\u0930\u0940 \u0928\u093f\u0935\u093e\u0938 \u0935\u093e\u091f\u092a \u092a\u0924\u094d\u0930 (\u090f\u0915 \u0935\u0930\u094d\u0937\u093e\u092a\u0947\u0915\u094d\u0937\u093e \u091c\u0941\u0928\u0947 \u0928\u093e\u0939\u0940)",list_11:"(\u0915\u0947) \u091c\u0940\u0935\u0928 \u0915\u093f\u0902\u0935\u093e \u0935\u0948\u0926\u094d\u092f\u0915\u0940\u092f \u0935\u093f\u092e\u093e \u092a\u0949\u0932\u093f\u0938\u0940 (\u090f\u0915 \u0935\u0930\u094d\u0937\u093e\u092a\u0947\u0915\u094d\u0937\u093e \u091c\u0941\u0928\u0940 \u0928\u093e\u0939\u0940)"}}},three:{title:"\u092e\u0940 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0915\u0936\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u094b?",content:"myAadhaar \u092a\u094b\u0930\u094d\u091f\u0932 https://myaadhaar.uidai.gov.in/ \u0915\u093f\u0902\u0935\u093e \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0935\u0930 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u092c\u092e\u093f\u091f \u0915\u0947\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924\u093e\u0924."},four:{title:"\u092e\u0940 \u0911\u0928\u0932\u093e\u0907\u0928 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0915\u0936\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u094b?",content:{list_1:"(1) https://myaadhaar.uidai.gov.in/ \u0935\u0930 \u091c\u093e, \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u093e \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0935\u0930 \u092e\u093f\u0933\u093e\u0932\u0947\u0932\u093e \u0935\u0928-\u091f\u093e\u0907\u092e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 (OTP) \u0935\u093e\u092a\u0930\u0942\u0928 \u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u093e.",list_2:"(2) \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u092e\u0927\u094d\u092f\u0947 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0924\u0941\u092e\u091a\u0940 \u0913\u0933\u0916 \u0906\u0923\u093f \u092a\u0924\u094d\u0924\u093e \u0924\u092a\u0936\u0940\u0932 \u0924\u092a\u093e\u0938\u093e.",list_3:"(3) \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u092e\u0927\u094d\u092f\u0947 \u0926\u093e\u0916\u0935\u0932\u0947\u0932\u0947 \u0924\u092a\u0936\u0940\u0932 \u091a\u0941\u0915\u0940\u091a\u0947 \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0916\u093e\u0932\u0940\u0932 \u092a\u094d\u0930\u0936\u094d\u0928 \u096b \u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u093f\u0938\u093e\u0926\u093e\u0924 \u0935\u0930\u094d\u0923\u0928 \u0915\u0947\u0932\u094d\u092f\u093e\u092a\u094d\u0930\u092e\u093e\u0923\u0947 \u0915\u093e\u0930\u0935\u093e\u0908 \u0915\u0930\u093e.",list_4:"(4) \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u092e\u0927\u094d\u092f\u0947 \u0926\u093e\u0916\u0935\u0932\u0947\u0932\u0947 \u0924\u092a\u0936\u0940\u0932 \u092c\u0930\u094b\u092c\u0930 \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0915\u0943\u092a\u092f\u093e '\u092e\u0940 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0924\u094b \u0915\u0940 \u0935\u0930\u0940\u0932 \u0924\u092a\u0936\u0940\u0932 \u092c\u0930\u094b\u092c\u0930 \u0906\u0939\u0947\u0924' \u092f\u093e \u091f\u0945\u092c\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e.",list_5:"(5) \u0924\u0941\u092e\u094d\u0939\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0942 \u0907\u091a\u094d\u091b\u093f\u0924 \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0921\u094d\u0930\u0949\u092a-\u0921\u093e\u0909\u0928 \u092e\u0947\u0928\u0942\u092e\u0927\u0942\u0928 \u0913\u0933\u0916 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0928\u093f\u0935\u0921\u093e.",list_6:"(6) \u0924\u0941\u092e\u091a\u093e \u0913\u0933\u0916 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u093e (2 MB \u092a\u0947\u0915\u094d\u0937\u093e \u0915\u092e\u0940 \u0906\u0915\u093e\u0930; \u092b\u093e\u0907\u0932 \u092b\u0949\u0930\u092e\u0945\u091f JPEG, PNG \u0915\u093f\u0902\u0935\u093e PDF)",list_7:"(7) \u0924\u0941\u092e\u094d\u0939\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0942 \u0907\u091a\u094d\u091b\u093f\u0924 \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0921\u094d\u0930\u0949\u092a-\u0921\u093e\u0909\u0928 \u092e\u0947\u0928\u0942\u092e\u0927\u0942\u0928 \u092a\u0924\u094d\u0924\u093e \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0928\u093f\u0935\u0921\u093e.",list_8:"(8) \u0924\u0941\u092e\u091a\u093e \u092a\u0924\u094d\u0924\u093e \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u093e (2 MB \u092a\u0947\u0915\u094d\u0937\u093e \u0915\u092e\u0940 \u0906\u0915\u093e\u0930; \u092b\u093e\u0907\u0932 \u0938\u094d\u0935\u0930\u0942\u092a JPEG, PNG \u0915\u093f\u0902\u0935\u093e PDF).",list_9:"(9) \u0924\u0941\u092e\u091a\u0940 \u0938\u0902\u092e\u0924\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u093e."}},five:{title:"\u092e\u093e\u091d\u094d\u092f\u093e \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u092e\u0927\u094d\u092f\u0947 \u0926\u093e\u0916\u0935\u0932\u0947\u0932\u093e \u092a\u0924\u094d\u0924\u093e \u092e\u093e\u091d\u094d\u092f\u093e \u0938\u0927\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u0936\u0940 \u091c\u0941\u0933\u0924 \u0928\u0938\u0932\u094d\u092f\u093e\u0938, \u092e\u0940 \u0915\u093e\u092f \u0915\u0930\u093e\u0935\u0947?",content:{list_1:"(1) \u0915\u0943\u092a\u092f\u093e \u2018\u092a\u0924\u094d\u0924\u094d\u092f\u093e\u0924 \u0915\u093e\u0939\u0940 \u091c\u0941\u0933\u0924 \u0928\u0938\u0932\u094d\u092f\u093e\u0938, \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e\u2019, \u2018\u092e\u0940 \u0935\u0930\u0940\u0932 \u0924\u092a\u0936\u0940\u0932 \u092c\u0930\u094b\u092c\u0930 \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u0947 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0924\u094b\u2019 \u092f\u093e \u091f\u0945\u092c\u091a\u094d\u092f\u093e \u0916\u093e\u0932\u0940 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e.",list_2:"(2) \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u092b\u0949\u0930\u094d\u092e\u092e\u0927\u094d\u092f\u0947 \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u091a\u093e \u0924\u092a\u0936\u0940\u0932 \u092d\u0930\u093e.",list_3:"(3) \u0924\u0941\u092e\u094d\u0939\u0940 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0942 \u0907\u091a\u094d\u091b\u093f\u0924 \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0921\u094d\u0930\u0949\u092a-\u0921\u093e\u0909\u0928 \u092e\u0947\u0928\u0942\u092e\u0927\u0942\u0928 \u092a\u0924\u094d\u0924\u093e \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0928\u093f\u0935\u0921\u093e.",list_4:"(4) \u0924\u0941\u092e\u091a\u093e \u092a\u0924\u094d\u0924\u093e \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u093e (2 MB \u092a\u0947\u0915\u094d\u0937\u093e \u0915\u092e\u0940 \u0906\u0915\u093e\u0930; \u092b\u093e\u0907\u0932 \u0938\u094d\u0935\u0930\u0942\u092a JPEG, PNG \u0915\u093f\u0902\u0935\u093e PDF).",list_5:"(5) \u0906\u0935\u0936\u094d\u092f\u0915 \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0930\u093e.",list_6:"(6) \u0924\u0941\u092e\u091a\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u093e."}},six:{title:"\u091c\u0930 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u0913\u0933\u0916 \u0924\u092a\u0936\u0940\u0932 (\u0928\u093e\u0935, \u0932\u093f\u0902\u0917 \u0915\u093f\u0902\u0935\u093e \u091c\u0928\u094d\u092e\u0924\u093e\u0930\u0940\u0916) \u092e\u093e\u091d\u094d\u092f\u093e \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0913\u0933\u0916 \u0924\u092a\u0936\u0940\u0932\u093e\u0936\u0940 \u091c\u0941\u0933\u0924 \u0928\u0938\u0947\u0932 \u0924\u0930 \u092e\u0940 \u0915\u093e\u092f \u0915\u0930\u093e\u0935\u0947?",content:"\u0915\u0943\u092a\u092f\u093e https://uidai.gov.in/images/commdoc/List_of_Supporting_Document_for_Aadhaar_Enrolment_and_Update.pdf \u0935\u0930 \u0938\u0942\u091a\u0940\u092c\u0926\u094d\u0927 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0941\u0938\u093e\u0930 \u092e\u0942\u0933 \u0913\u0933\u0916 \u0926\u0938\u094d\u0924\u0910\u0935\u091c\u093e\u0902\u0938\u0939 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e."},seven:{title:"\u091c\u0930 \u092e\u0932\u093e \u0911\u092b\u0932\u093e\u0907\u0928 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u091c\u092e\u093e \u0915\u0930\u093e\u092f\u091a\u0940 \u0905\u0938\u0924\u0940\u0932, \u0924\u0930 \u092e\u0940 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u0938\u0947 \u0936\u094b\u0927\u0942 \u0936\u0915\u0924\u094b?",content:{list_1:"(\u0967) \u0915\u0943\u092a\u092f\u093e https://bhuvan.nrsc.gov.in/aadhaar/ \u0935\u0930 \u091c\u093e",list_2:"(\u0968) \u091c\u0935\u0933\u0940\u0932 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u0947 \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u2018\u0928\u091c\u0940\u0915\u091a\u0940 \u0915\u0947\u0902\u0926\u094d\u0930\u0947\u2019 \u091f\u0945\u092c\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. \u091c\u0935\u0933\u092a\u093e\u0938\u091a\u0940 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u0947 \u092a\u093e\u0939\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u0947 \u0938\u094d\u0925\u093e\u0928 \u0924\u092a\u0936\u0940\u0932 \u090f\u0902\u091f\u0930 \u0915\u0930\u093e.",list_3:"(\u0969) \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u093f\u0928 \u0915\u094b\u0921 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0924 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u0947 \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u2018\u092a\u093f\u0928 \u0915\u094b\u0921\u0926\u094d\u0935\u093e\u0930\u0947 \u0936\u094b\u0927\u093e\u2019 \u091f\u0945\u092c\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. \u0924\u094d\u092f\u093e \u092d\u093e\u0917\u093e\u0924\u0940\u0932 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u0947 \u092a\u093e\u0939\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u093e \u092a\u093f\u0928 \u0915\u094b\u0921 \u091f\u093e\u0915\u093e."}},eight:{title:"\u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0938\u093e\u0926\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u093f\u0924\u0940 \u0936\u0941\u0932\u094d\u0915 \u0906\u0915\u093e\u0930\u0932\u0947 \u091c\u093e\u0924\u0947?",content:"14 \u0938\u092a\u094d\u091f\u0947\u0902\u092c\u0930 2023 \u092a\u0930\u094d\u092f\u0902\u0924 myAadhaar \u092a\u094b\u0930\u094d\u091f\u0932\u0935\u0930 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0923\u0947 \u0935\u093f\u0928\u093e\u092e\u0942\u0932\u094d\u092f \u0906\u0939\u0947. \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0935\u0930 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0938\u093e\u0926\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0932\u093e\u0917\u0942 \u0936\u0941\u0932\u094d\u0915 \u0930\u0941. 50."},nine:{title:"\u092e\u0940 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0915\u0947\u0935\u094d\u0939\u093e \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u093e\u0935\u0940?",content:"\u0930\u093e\u0939\u0923\u0940\u092e\u093e\u0928 \u0938\u0941\u0932\u092d \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0909\u0924\u094d\u0924\u092e \u0938\u0947\u0935\u093e \u0935\u093f\u0924\u0930\u0923 \u0906\u0923\u093f \u0905\u091a\u0942\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0930\u0923\u0947 \u0907\u0937\u094d\u091f \u0906\u0939\u0947. \u0924\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0932\u0935\u0915\u0930\u093e\u0924 \u0932\u0935\u0915\u0930 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u091c\u092e\u093e \u0915\u0930\u0923\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0939\u093f\u0924\u093e\u091a\u0947 \u0906\u0939\u0947."},ten:{title:"\u092e\u0940 \u0905\u0928\u093f\u0935\u093e\u0938\u0940 \u092d\u093e\u0930\u0924\u0940\u092f (NRI) \u0906\u0939\u0947. \u092e\u0940 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0915\u0936\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u094b?",content:"\u0924\u0941\u092e\u094d\u0939\u0940 \u091c\u0947\u0935\u094d\u0939\u093e\u0939\u0940 \u092d\u093e\u0930\u0924\u093e\u0924 \u0905\u0938\u093e\u0932 \u0924\u0947\u0935\u094d\u0939\u093e \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e."}}},aadharUpdateHistory:{title1:"\u0924\u0941\u092e\u091a\u093e \u0906\u0927\u093e\u0930 \u0905\u092a\u0921\u0947\u091f\u0947\u0921 \u0907\u0924\u093f\u0939\u093e\u0938 \u0924\u092a\u093e\u0938\u093e",label1:"\u0935\u093f\u0915\u094d\u0930\u092e",label2:"\u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940/\u0905\u092a\u0921\u0947\u091f\u091a\u0940 \u0924\u093e\u0930\u0940\u0916",label3:"URN/EID",label4:"\u092a\u094d\u0930\u0915\u093e\u0930",list1:"\u0928\u093e\u0935",list2:"\u092e\u094b\u092c\u093e\u0908\u0932",list3:"\u0908\u092e\u0947\u0932",list4:"\u091c\u0928\u094d\u092e\u0924\u093e\u0930\u0940\u0916",list5:"\u0932\u093f\u0902\u0917",list6:"\u092a\u0924\u094d\u0924\u093e"},ssup:{howItWorks:{title:"\u0939\u0947 \u0915\u0938\u0947 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0924\u0947",description:"\u0915\u0943\u092a\u092f\u093e \u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u0926\u094d\u092f\u0924\u0928\u093e\u091a\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u092e\u091c\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0916\u093e\u0932\u0940\u0932 \u091a\u0930\u0923 \u0935\u093e\u091a\u093e. \u0935\u093f\u0928\u0902\u0924\u0940\u0935\u0930 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0915\u093f\u0902\u0935\u093e \u0928\u093e\u0915\u093e\u0930\u0923\u094d\u092f\u093e\u0924 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u0935\u093f\u0932\u0902\u092c \u0939\u094b\u090a \u0928\u092f\u0947 \u092e\u094d\u0939\u0923\u0942\u0928 \u0935\u093f\u0935\u093f\u0927 \u091a\u0930\u0923\u093e\u0902\u0935\u0930 \u0938\u0942\u091a\u093f\u0924 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0915\u094d\u0930\u093f\u092f\u093e\u0902\u091a\u0947 \u0905\u0928\u0941\u0938\u0930\u0923 \u0915\u0930\u093e",proceedToUpdateAadhaar:"\u0906\u0927\u093e\u0930 \u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0941\u0922\u0947 \u091c\u093e",stepDescription:{one:"\u0938\u0942\u091a\u0940\u092e\u0927\u0942\u0928 \u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0924\u094d\u0924\u093e \u092b\u0940\u0932\u094d\u0921 \u0928\u093f\u0935\u0921\u093e. \u092f\u093e \u0911\u0928\u0932\u093e\u0907\u0928 \u092a\u094b\u0930\u094d\u091f\u0932\u0926\u094d\u0935\u093e\u0930\u0947 \u0924\u0941\u092e\u094d\u0939\u0940 \u092a\u0924\u094d\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e. \u0928\u093e\u0935, \u0932\u093f\u0902\u0917, \u0921\u0940\u0913\u092c\u0940, \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930, \u0908\u092e\u0947\u0932 \u0906\u0923\u093f \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0921\u0947\u091f\u093e\u0938\u093e\u0920\u0940, \u0915\u0943\u092a\u092f\u093e \u091c\u0935\u0933\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e.",two:"\u0915\u0943\u092a\u092f\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0935\u093f\u0937\u092f\u0915 \u0921\u0947\u091f\u093e \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e. \u0915\u093e\u0939\u0940 \u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f \u0921\u0947\u091f\u093e \u0921\u094d\u0930\u0949\u092a\u0921\u093e\u0909\u0928 \u0938\u0942\u091a\u0940\u092e\u0927\u0942\u0928 \u0928\u093f\u0935\u0921 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947. \u0915\u0943\u092a\u092f\u093e \u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930 \u0921\u0947\u091f\u093e \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u0924\u093e\u0928\u093e \u0915\u093f\u0902\u0935\u093e \u0921\u094d\u0930\u0949\u092a\u0921\u093e\u0909\u0928 \u092a\u0930\u094d\u092f\u093e\u092f\u093e\u0902\u092e\u0927\u0942\u0928 \u0928\u093f\u0935\u0921 \u0915\u0930\u0924\u093e\u0928\u093e \u0915\u093e\u0933\u091c\u0940 \u0918\u094d\u092f\u093e.",three:"\u092a\u0924\u094d\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092e\u0942\u0933 \u0938\u092e\u0930\u094d\u0925\u0928 \u0926\u0938\u094d\u0924\u0910\u0935\u091c\u093e\u091a\u0940 \u0938\u094d\u0915\u0945\u0928 \u0915\u0947\u0932\u0947\u0932\u0940 \u092a\u094d\u0930\u0924 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947. \u0915\u0943\u092a\u092f\u093e \u0916\u093e\u0924\u094d\u0930\u0940 \u0915\u0930\u093e \u0915\u0940 \u0938\u0939\u093e\u092f\u094d\u092f\u0915 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0928\u093e\u0935\u093e\u0935\u0930 \u0906\u0939\u0947 \u0906\u0923\u093f \u0935\u0948\u0927 \u0906\u0939\u0947. \u0924\u0941\u092e\u094d\u0939\u0940 UIDAI \u092e\u093e\u0928\u0915 \u092b\u0949\u0930\u092e\u0945\u091f\u092e\u0927\u094d\u092f\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u0926\u0947\u0924 \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0915\u0943\u092a\u092f\u093e \u0935\u093f\u0928\u0902\u0924\u0940 \u0928\u093e\u0915\u093e\u0930\u0932\u0940 \u091c\u093e\u090a \u0928\u092f\u0947 \u092e\u094d\u0939\u0923\u0942\u0928 \u0907\u0936\u094d\u092f\u0942 \u0924\u093e\u0930\u0940\u0916, \u0915\u094d\u0930\u0949\u0938 \u0915\u0947\u0932\u0947\u0932\u0947 \u091a\u093f\u0928\u094d\u0939, \u092b\u094b\u091f\u094b\u0935\u0930 \u0938\u094d\u091f\u0945\u092e\u094d\u092a \u0906\u0923\u093f \u0913\u0935\u094d\u0939\u0930\u0930\u093e\u0908\u091f\u093f\u0902\u0917 \u0928\u093e\u0939\u0940 \u092f\u093e\u0938\u093e\u0930\u0916\u094d\u092f\u093e \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u091a\u0941\u0915\u093e \u0924\u092a\u093e\u0938\u093e.",four:"\u0911\u0928\u0932\u093e\u0908\u0928 \u0905\u0926\u094d\u092f\u0924\u0928 \u0936\u0941\u0932\u094d\u0915\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0930\u0941 50 (\u092b\u0915\u094d\u0924 \u092a\u0928\u094d\u0928\u093e\u0938 \u0930\u0941\u092a\u092f\u0947) \u0926\u094d\u092f\u093e\u0935\u0947 \u0932\u093e\u0917\u0947\u0932. \u0906\u092a\u0923 \u0915\u094d\u0930\u0947\u0921\u093f\u091f / \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u0915\u093f\u0902\u0935\u093e \u0928\u0947\u091f \u092c\u0901\u0915\u093f\u0902\u0917\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u0948\u0938\u0947 \u0926\u0947\u090a \u0936\u0915\u0924\u093e. \u0939\u0940 \u0930\u0915\u094d\u0915\u092e \u092a\u0930\u0924 \u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u092f\u094b\u0917\u094d\u092f \u0906\u0939\u0947. \u0926\u0947\u092f \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0906\u092a\u0923 \u092a\u0941\u0928\u094d\u0939\u093e \u0926\u0947\u092f \u0926\u0947\u0923\u094d\u092f\u093e\u091a\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.",five:"\u0906\u092a\u0932\u094d\u092f\u093e\u0932\u093e \u0938\u0902\u0926\u0930\u094d\u092d \u092e\u094d\u0939\u0923\u0942\u0928 \u0938\u0947\u0935\u093e \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 (\u090f\u0938\u0906\u0930\u090f\u0928) \u092e\u093f\u0933\u0947\u0932. \u0905\u0926\u094d\u092f\u0924\u0928 \u0935\u093f\u0928\u0902\u0924\u0940\u091a\u093e \u092e\u093e\u0917\u094b\u0935\u093e \u0918\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u093f\u0902\u0935\u093e \u092f\u0942\u0906\u092f\u0921\u0940\u090f\u0906\u092f \u0939\u0947\u0932\u094d\u092a\u0921\u0947\u0938\u094d\u0915\u0938\u0939 \u092d\u0935\u093f\u0937\u094d\u092f\u093e\u0924\u0940\u0932 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0938\u0902\u092a\u094d\u0930\u0947\u0937\u0923\u093e\u0938\u093e\u0920\u0940 \u0939\u093e \u0928\u0902\u092c\u0930 \u091c\u0924\u0928 \u0915\u0930\u093e.",six:"\u0906\u092a\u0932\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0906\u092e\u091a\u094d\u092f\u093e \u0905\u0902\u0924\u0930\u094d\u0917\u0924 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0924\u092a\u093e\u0938\u0923\u0940 \u0911\u092a\u0930\u0947\u091f\u0930\u0926\u094d\u0935\u093e\u0930\u0947 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0947\u0932\u0940 \u091c\u093e\u0908\u0932. \u092f\u093e \u091f\u092a\u094d\u092a\u094d\u092f\u093e\u0935\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0921\u0947\u092e\u094b\u0917\u094d\u0930\u093e\u092b\u093f\u0915\u094d\u0938 \u0921\u0947\u091f\u093e\u091a\u0947 \u0938\u092e\u0930\u094d\u0925\u0928 \u0926\u0938\u094d\u0924\u0910\u0935\u091c\u093e\u091a\u094d\u092f\u093e \u0935\u093f\u0930\u0942\u0926\u094d\u0927 \u0924\u092a\u093e\u0938\u0923\u0940 \u0915\u0947\u0932\u0940 \u091c\u093e\u0908\u0932. \u091c\u0930 \u0924\u0947\u0925\u0947 \u091c\u0941\u0933\u0924 \u0928\u093e\u0939\u0940 \u0924\u0930 \u0906\u092a\u0932\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0928\u093e\u0915\u093e\u0930\u0932\u0940 \u091c\u093e\u0923\u094d\u092f\u093e\u091a\u0940 \u0936\u0915\u094d\u092f\u0924\u093e \u0906\u0939\u0947.",seven:"\u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0924\u092a\u093e\u0938\u0923\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u0942\u0930\u094d\u0923 \u091d\u093e\u0932\u094d\u092f\u093e\u0935\u0930, \u0906\u092a\u0923\u093e\u0938 \u090f\u0928\u0930\u094b\u0932\u092e\u0947\u0902\u091f \u0906\u092f\u0921\u0940 \u0905\u0938\u0932\u0947\u0932\u0940 \u090f\u0915 \u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u0942\u091a\u0928\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0908\u0932.",eight:"\u0906\u092e\u091a\u094d\u092f\u093e \u092c\u0945\u0915\u090f\u0902\u0921 \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u0905\u0930\u0926\u094d\u0935\u093e\u0930\u0947 \u0906\u0923\u0916\u0940 \u0915\u093e\u0939\u0940 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923\u093e\u0928\u0902\u0924\u0930, \u0906\u092a\u0932\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u0942\u0930\u094d\u0923 \u0939\u094b\u0908\u0932. \u0906\u092a\u0932\u094d\u092f\u093e\u0932\u093e \u0928\u093f\u0915\u093e\u0932\u093e\u0935\u0930 \u090f\u0915 \u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u0942\u091a\u0928\u093e \u092e\u093f\u0933\u0947\u0932.",nine:"\u0938\u093e\u092e\u093e\u0928\u094d\u092f\u0924: \u0905\u092a\u0921\u0947\u091f \u0935\u093f\u0928\u0902\u0924\u0940 90% \u0938\u0947\u0935\u093e \u092e\u093e\u0928\u0915\u093e\u0902\u0938\u0939 30 \u0926\u093f\u0935\u0938\u093e\u0902\u091a\u094d\u092f\u093e \u0906\u0924 \u092a\u0942\u0930\u094d\u0923 \u0915\u0947\u0932\u0940 \u091c\u093e\u0924\u0947. \u0924\u0925\u093e\u092a\u093f, \u0906\u092e\u094d\u0939\u0940 \u0906\u092e\u091a\u094d\u092f\u093e \u0938\u093f\u0938\u094d\u091f\u092e \u0938\u0941\u0927\u093e\u0930\u0924 \u0906\u0939\u094b\u0924 \u0906\u0923\u093f \u092c\u0939\u0941\u0927\u093e \u0924\u0941\u092e\u091a\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0928\u092e\u0942\u0926 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0935\u0947\u0933\u0947\u091a\u094d\u092f\u093e \u0906\u0927\u0940 \u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0915\u0947\u0932\u0940 \u091c\u093e\u0908\u0932. \u0906\u092a\u0923 myaadhaar.uidai.gov.in \u0935\u0930 \u092d\u0947\u091f \u0926\u0947\u090a\u0928 \u0935\u093f\u0928\u0902\u0924\u0940\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u0947\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u0942 \u0936\u0915\u0924\u093e."}},updateSelectPage:{title:"\u0906\u0927\u093e\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0915\u0930\u093e",selectFields:{smallDescription:"\u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e \u092b\u0940\u0932\u094d\u0921 \u0928\u093f\u0935\u0921\u093e",longDescription:"\u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0916\u093e\u0932\u0940\u0932\u092a\u0948\u0915\u0940 \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e \u092b\u0940\u0932\u094d\u0921 \u0928\u093f\u0935\u0921\u093e",updatesLeft:" \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0921\u093e\u0935\u0940",noLimit:"\u092e\u0930\u094d\u092f\u093e\u0926\u093e \u0928\u093e\u0939\u0940",demoGraphics:{language:"\u092d\u093e\u0937\u093e",name:"\u0928\u093e\u0935",dob:"\u091c\u0928\u094d\u092e \u0924\u093e\u0930\u0940\u0916",gender:"\u0932\u093f\u0902\u0917",hof:"\u0915\u0941\u091f\u0941\u0902\u092c \u092a\u094d\u0930\u092e\u0941\u0916 (HOF) \u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u0924\u094d\u0924\u093e \u0905\u0926\u094d\u092f\u0924\u0928",address:"\u092a\u0924\u094d\u0924\u093e"}},documentDescriptionLinkText:"\u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0940\u0913\u0906\u092f / \u092a\u0940\u0913\u090f / \u092a\u0940\u0913\u092c\u0940 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0906\u0935\u0936\u094d\u092f\u0915 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u092a\u0939\u093e",proceedToUpdateAadhaar:"\u0906\u0927\u093e\u0930 \u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0941\u0922\u0947 \u091c\u093e",faq:"\u0938\u0924\u0924 \u0935\u093f\u091a\u093e\u0930\u0932\u0947 \u091c\u093e\u0923\u093e\u0930\u0947 \u092a\u094d\u0930\u0936\u094d\u0928"},dashboard:"\u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921",hof:{title:"\u0915\u0941\u091f\u0941\u0902\u092c \u092a\u094d\u0930\u092e\u0941\u0916 (HOF) \u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u0924\u094d\u0924\u093e \u0905\u0926\u094d\u092f\u0924\u0928",description:"\u0915\u0941\u091f\u0941\u0902\u092c \u092a\u094d\u0930\u092e\u0941\u0916 \u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0905\u0926\u094d\u092f\u0924\u0928\u093e\u0938\u0939 \u092a\u0941\u0922\u0947 \u091c\u093e\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e.",howItWorks:{step1:"\u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e\u092c\u0947\u0938\u092e\u0927\u0942\u0928 \u092a\u0924\u094d\u0924\u093e \u0906\u0923\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0915\u0941\u091f\u0941\u0902\u092c \u092a\u094d\u0930\u092e\u0941\u0916\u093e\u091a\u093e \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e. \u0915\u0947\u0935\u0933 18 \u0935\u0930\u094d\u0937\u0947 \u0915\u093f\u0902\u0935\u093e \u0924\u094d\u092f\u093e\u0939\u0942\u0928 \u0905\u0927\u093f\u0915 \u0935\u092f\u093e\u091a\u0947 \u0930\u0939\u093f\u0935\u093e\u0938\u0940 HoF \u092e\u094d\u0939\u0923\u0942\u0928 \u0917\u0923\u0932\u0947 \u091c\u093e\u090a \u0936\u0915\u0924\u093e\u0924.",step2:'\u0915\u0943\u092a\u092f\u093e \u0928\u093e\u0924\u094d\u092f\u093e\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e (PoR) \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u093e \u091c\u094d\u092f\u093e\u0924 \u0924\u0941\u092e\u091a\u0947 \u0928\u093e\u0935 \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0915\u0941\u091f\u0941\u0902\u092c \u092a\u094d\u0930\u092e\u0941\u0916\u093e\u091a\u094d\u092f\u093e \u0928\u093e\u0935\u093e\u091a\u093e \u0938\u094d\u092a\u0937\u094d\u091f \u0909\u0932\u094d\u0932\u0947\u0916 \u0906\u0939\u0947. \u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0938\u094b\u092c\u0924 HoF \u091a\u0947 \u0928\u093e\u0924\u0947 \u0928\u093f\u0935\u0921\u093e, \u0909\u0926\u093e\u0939\u0930\u0923\u093e\u0930\u094d\u0925 HoF \u0924\u0941\u092e\u091a\u093e \u092a\u0924\u0940 \u0905\u0938\u0932\u094d\u092f\u093e\u0938, "\u092a\u0924\u0940" \u0928\u093f\u0935\u0921\u093e.',step3:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u092a\u0921\u0947\u091f \u092b\u0940\u0938\u093e\u0920\u0940 \u20b9 \u096b\u0966 (\u0915\u0947\u0935\u0933 \u092a\u0928\u094d\u0928\u093e\u0938 \u0930\u0941\u092a\u092f\u0947) \u092d\u0930\u093e\u0935\u0947 \u0932\u093e\u0917\u0924\u0940\u0932. \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u094d\u0930\u0947\u0921\u093f\u091f/\u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u0915\u093f\u0902\u0935\u093e \u0928\u0947\u091f \u092c\u0901\u0915\u093f\u0902\u0917\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e. \u0939\u0940 \u0930\u0915\u094d\u0915\u092e \u092a\u0930\u0924 \u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u092f\u094b\u0917\u094d\u092f \u0906\u0939\u0947.",step4:"\u091c\u0947\u0935\u094d\u0939\u093e \u0924\u0941\u092e\u091a\u0947 \u0915\u0941\u091f\u0941\u0902\u092c \u092a\u094d\u0930\u092e\u0941\u0916 \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e myAadhaar \u092a\u094b\u0930\u094d\u091f\u0932\u0935\u0930 \u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0924\u093e\u0924, \u0924\u0947\u0935\u094d\u0939\u093e \u0924\u094d\u092f\u093e\u0902\u0928\u093e \u092a\u0924\u094d\u0924\u093e \u0936\u0947\u0905\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0908\u0932, \u091c\u0940 \u0924\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0942 \u0915\u093f\u0902\u0935\u093e \u0928\u093e\u0915\u093e\u0930\u0942 \u0936\u0915\u0924\u093e\u0924. HoF \u0926\u094d\u0935\u093e\u0930\u0947 \u0935\u093f\u0928\u0902\u0924\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0923\u094d\u092f\u093e\u091a\u093e/\u0928\u093e\u0915\u093e\u0930\u0923\u094d\u092f\u093e\u091a\u093e \u0939\u093e \u092a\u0930\u094d\u092f\u093e\u092f \u0935\u093f\u0928\u0902\u0924\u0940 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u094d\u092f\u093e\u092a\u093e\u0938\u0942\u0928 30 \u0926\u093f\u0935\u0938\u093e\u0902\u0938\u093e\u0920\u0940 \u0935\u0948\u0927 \u0905\u0938\u0947\u0932."},currentSection:{title:"\u0905\u0926\u094d\u092f\u0924\u0928\u093e\u0938\u093e\u0920\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 HoF \u091a\u0947 \u0924\u092a\u0936\u0940\u0932"},updateSection:{forms:{hofUid:{label:"HoF \u091a\u093e \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u091f\u093e\u0915\u093e"},mobileField:{label:"HoF \u091a\u093e \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930"},documentUpload:{label:"\u0935\u0948\u0927 \u0938\u0939\u093e\u092f\u094d\u092f\u0915 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u093e"},relationshipDropdown:{label:"\u0905\u0930\u094d\u091c\u0926\u093e\u0930\u093e\u0938\u0939 HoF \u0936\u0940 \u0938\u0902\u092c\u0902\u0927 \u0928\u093f\u0935\u0921\u093e.",values:{father:"\u0935\u0921\u0940\u0932",mother:"\u0906\u0908",husband:"\u0928\u0935\u0930\u093e",wife:"\u092c\u093e\u092f\u0915\u094b",guardian:"\u092a\u093e\u0932\u0915",Others:"\u0907\u0924\u0930"}}}}},documentInfoPopup:{title:"\u0915\u0943\u092a\u092f\u093e \u0906\u092a\u0932\u094d\u092f\u093e \u0935\u093f\u0928\u0902\u0924\u0940\u0935\u0930 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u090f\u0915 \u0935\u0948\u0927 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u093e",identityDocumentInfo:"\u091c\u0930 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0913\u0933\u0916\u0940\u091a\u094d\u092f\u093e \u092a\u0941\u0930\u093e\u0935\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0938\u0947\u0932 \u0924\u0930 \u0924\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0928\u093e\u0935\u093e\u0935\u0930 \u0905\u0938\u0932\u0947 \u092a\u093e\u0939\u093f\u091c\u0947 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u091a\u0947 \u091b\u093e\u092f\u093e\u091a\u093f\u0924\u094d\u0930 \u0905\u0938\u093e\u0935\u0947. \u0915\u0943\u092a\u092f\u093e \u092b\u0949\u0930\u094d\u092e\u092e\u0927\u094d\u092f\u0947 \u0935\u0930 \u0928\u092e\u0942\u0926 \u0915\u0947\u0932\u0947\u0932\u0947 '\u0928\u093e\u0935' \u0924\u0941\u092e\u094d\u0939\u0940 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0924 \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0926\u0938\u094d\u0924\u0910\u0935\u091c\u093e\u0924\u0940\u0932 '\u0928\u093e\u0935' \u0936\u0940 \u091c\u0941\u0933\u0924 \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u0947 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u093e.",addressDocumentInfo:"\u091c\u0930 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930 \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u0941\u0930\u093e\u0935\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0938\u0947\u0932 \u0924\u0930 \u0924\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0928\u093e\u0935\u093e\u0935\u0930 \u0905\u0938\u0932\u0947 \u092a\u093e\u0939\u093f\u091c\u0947. \u091c\u094b\u0921\u0940\u0926\u093e\u0930, \u092a\u093e\u0932\u0915 \u0915\u093f\u0902\u0935\u093e \u092a\u093e\u0932\u0915\u093e\u0902\u091a\u094d\u092f\u093e \u0928\u093e\u0935\u093e\u0935\u0930\u0940\u0932 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0932\u0940 \u091c\u093e\u0923\u093e\u0930 \u0928\u093e\u0939\u0940\u0924. \u0915\u0943\u092a\u092f\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u093e \u0915\u0940 \u0935\u0930 \u0928\u092e\u0942\u0926 \u0915\u0947\u0932\u0947\u0932\u093e '\u092a\u0924\u094d\u0924\u093e' \u0924\u0941\u092e\u094d\u0939\u0940 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0924 \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0926\u0938\u094d\u0924\u0910\u0935\u091c\u093e\u0924\u0940\u0932 '\u092a\u0924\u094d\u0924\u094d\u092f\u093e\u0936\u0940 \u091c\u0941\u0933\u0924\u094b.",close:"\u092c\u0902\u0926",continueToUpload:"\u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0923\u0947 \u0938\u0941\u0930\u0942 \u0920\u0947\u0935\u093e"},forms:{reUseDocText:"\u0906\u092a\u0923 \u0906\u0927\u0940\u092a\u093e\u0938\u0942\u0928 \u0905\u092a\u0932\u094b\u0921 \u0915\u0947\u0932\u0947\u0932\u0947 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u092a\u0941\u0928\u094d\u0939\u093e \u0935\u093e\u092a\u0930\u0942 \u0936\u0915\u0924\u093e.",stepper:{language:"\u092d\u093e\u0937\u093e",Name:"\u0928\u093e\u0935",dob:"\u091c\u0928\u094d\u092e \u0924\u093e\u0930\u0940\u0916",gender:"\u0932\u093f\u0902\u0917",address:"\u092a\u0924\u094d\u0924\u093e",preview:"\u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928",payment:"\u0926\u0947\u092f"},formButtons:{back:"\u092e\u093e\u0917\u0947",next:"\u092a\u0941\u0922\u0947",makePayment:"\u0926\u0947\u092f \u0926\u094d\u092f\u093e",retry:"\u0926\u0947\u092f \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e",goToDashboard:"\u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921\u0935\u0930 \u091c\u093e"},languageForm:{currentSection:{title:"\u0938\u0926\u094d\u092f \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u092d\u093e\u0937\u093e \u0924\u092a\u0936\u0940\u0932",fields:{currentLocalLanguage:"\u0938\u0926\u094d\u092f \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u092d\u093e\u0937\u093e"}},updateSection:{title:"\u0928\u0935\u0940\u0928 \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u092d\u093e\u0937\u093e \u0928\u093f\u0935\u0921\u093e",fields:{}}},nameForm:{currentSection:{title:"\u0938\u0926\u094d\u092f \u0924\u092a\u0936\u0940\u0932",fields:{currentLocalName:"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0928\u093e\u0935"}},updateSection:{title:"\u0924\u092a\u0936\u0940\u0932 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0947\u0932\u0947 \u091c\u093e\u0923\u0947",fields:{documentType:"\u0935\u0948\u0927 \u0938\u092a\u094b\u0930\u094d\u091f\u093f\u0902\u0917 \u0921\u0949\u0915\u094d\u092f\u0941\u092e\u0947\u0902\u091f \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u093e",documentTypeError:"\u0915\u093e\u0917\u0926\u091c\u0924\u094d\u0930 \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u093e \u0928\u093e\u0939\u0940",uploadDocumentLabel:"\u0924\u092a\u0936\u0940\u0932 \u0906\u0923\u093f \u0905\u092a\u0932\u094b\u0921 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u092a\u0939\u093e",clear:"\u0938\u093e\u092b \u0915\u0930\u093e",same_data_error:"\u0906\u0927\u093e\u0930 \u092e\u0927\u094d\u092f\u0947 \u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0915\u0947\u0932\u0947\u0932\u0947 \u0928\u093e\u0935 \u0906\u0923\u093f \u0935\u093f\u0926\u094d\u092f\u092e\u093e\u0928 \u0928\u093e\u0935 \u0938\u092e\u093e\u0928 \u0906\u0939\u0947! \u0939\u0947 \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u094d\u0939\u093e \u0924\u092a\u093e\u0938\u093e \u0906\u0923\u093f \u092f\u094b\u0917\u094d\u092f \u0928\u093e\u0935 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e."}}},dobForm:{currentSection:{title:"\u0938\u0926\u094d\u092f \u0924\u092a\u0936\u0940\u0932"},updateSection:{title:"\u0924\u092a\u0936\u0940\u0932 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0947\u0932\u0947 \u091c\u093e\u0923\u0947",fields:{documentType:"\u0935\u0948\u0927 \u0938\u092a\u094b\u0930\u094d\u091f\u093f\u0902\u0917 \u0921\u0949\u0915\u094d\u092f\u0941\u092e\u0947\u0902\u091f \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u093e",documentTypeError:"\u0915\u093e\u0917\u0926\u091c\u0924\u094d\u0930 \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u093e \u0928\u093e\u0939\u0940",uploadDocumentLabel:"\u0924\u092a\u0936\u0940\u0932 \u0906\u0923\u093f \u0905\u092a\u0932\u094b\u0921 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u092a\u0939\u093e",clear:"\u0938\u093e\u092b \u0915\u0930\u093e"}},confirmationPopUp:{heading:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0924\u0941\u092e\u091a\u0940 \u091c\u0928\u094d\u092e\u0924\u093e\u0930\u0940\u0916 {{- dob}} \u092e\u0927\u094d\u092f\u0947 \u092c\u0926\u0932\u093e\u092f\u091a\u0940 \u0906\u0939\u0947 \u092f\u093e\u091a\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0916\u093e\u0924\u094d\u0930\u0940 \u0906\u0939\u0947 \u0915\u093e?",description:"\u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 '\u0920\u0940\u0915 \u0906\u0939\u0947' \u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e."}},genderForm:{currentSection:{title:"\u0938\u0926\u094d\u092f \u0924\u092a\u0936\u0940\u0932",fields:{}},updateSection:{title:"\u0924\u092a\u0936\u0940\u0932 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0947\u0932\u0947 \u091c\u093e\u0923\u0947"},options:{male:"\u092a\u0941\u0930\u0942\u0937",female:"\u0938\u094d\u0924\u094d\u0930\u0940",transgender:"\u091f\u094d\u0930\u093e\u0928\u094d\u0938\u091c\u0947\u0902\u0921\u0930"},confirmationPopUp:{heading:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0924\u0941\u092e\u091a\u0947 \u0932\u093f\u0902\u0917 {{gender}} \u092e\u0927\u094d\u092f\u0947 \u092c\u0926\u0932\u093e\u092f\u091a\u0947 \u0906\u0939\u0947 \u092f\u093e\u091a\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0916\u093e\u0924\u094d\u0930\u0940 \u0906\u0939\u0947 \u0915\u093e?",description:"\u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 '\u0920\u0940\u0915 \u0906\u0939\u0947' \u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e."}},addressForm:{currentSection:{title:"\u0938\u0926\u094d\u092f \u0924\u092a\u0936\u0940\u0932",fields:{currentLocalAddress:"\u0938\u0927\u094d\u092f\u093e\u091a\u093e \u092a\u0924\u094d\u0924\u093e"}},updateSection:{title:"\u0924\u092a\u0936\u0940\u0932 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0947\u0932\u0947 \u091c\u093e\u0923\u0947",fields:{documentType:"\u0935\u0948\u0927 \u0938\u092a\u094b\u0930\u094d\u091f\u093f\u0902\u0917 \u0921\u0949\u0915\u094d\u092f\u0941\u092e\u0947\u0902\u091f \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u093e",documentTypeError:"\u0915\u093e\u0917\u0926\u091c\u0924\u094d\u0930 \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u093e \u0928\u093e\u0939\u0940",uploadDocumentLabel:"\u0924\u092a\u0936\u0940\u0932 \u0906\u0923\u093f \u0905\u092a\u0932\u094b\u0921 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u092a\u0939\u093e",clear:"\u0938\u093e\u092b \u0915\u0930\u093e"}}},preview:{fields:{newLocalName:"\u0928\u0935\u0940\u0928 \u0928\u093e\u0935",newLocalGender:"\u0928\u0935\u0940\u0928 \u0932\u093f\u0902\u0917",newLocalAddress:"\u0928\u0935\u0940\u0928 \u092a\u0924\u094d\u0924\u093e",updateLanguage:"\u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u092d\u093e\u0937\u093e \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u093e",updateName:"\u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0928\u093e\u0935 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u093e",updateDOB:"\u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u091c\u0928\u094d\u092e\u0924\u093e\u0930\u0940\u0916 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u093e",updateGender:"\u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0932\u093f\u0902\u0917 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u093e",updateAddress:"\u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u092a\u0924\u094d\u0924\u093e \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u093e"},edit:"\u0938\u0941\u0927\u093e\u0930\u0923\u0947",supportingDocuments:"\u0938\u0939\u093e\u092f\u094d\u092f\u0915 \u0926\u0938\u094d\u0924\u0910\u0935\u091c",dataFields:"\u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0921\u0947\u091f\u093e \u092b\u0940\u0932\u094d\u0921",transliterationText:"\u092f\u0942\u0906\u092f\u0921\u0940\u090f\u0906\u092f\u0932\u093e \u091d\u093e\u0932\u0947\u0932\u0940 \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0932\u093f\u092a\u094d\u092f\u0902\u0924\u0930\u0923 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0905\u0936\u0941\u0926\u094d\u0927\u0924\u093e \u0926\u0941\u0930\u0941\u0938\u094d\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0926\u094d\u092f\u093e.",acceptTermsText:"\u092e\u0940 \u092f\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u0924\u094b \u0915\u0940 \u092e\u0940 \u0938\u0942\u091a\u0928\u093e \u0915\u093e\u0933\u091c\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u0935\u093e\u091a\u0932\u094d\u092f\u093e \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u092e\u0940 \u092f\u0942\u0906\u092f\u0921\u0940\u090f\u0906\u092f\u0932\u093e \u092a\u0941\u0930\u0935\u093f\u0932\u0947\u0932\u094d\u092f\u093e \u092e\u093e\u0939\u093f\u0924\u0940 \u0938\u0924\u094d\u092f \u0906\u0923\u093f \u092f\u094b\u0917\u094d\u092f \u0906\u0939\u0947\u0924",acceptTermsText_p1:"\u092e\u0940 \u092f\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u0924\u094b \u0906\u0923\u093f \u0918\u094b\u0937\u093f\u0924 \u0915\u0930\u0924\u094b \u0915\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0947\u0932\u0947\u0932\u0940 \u0938\u0930\u094d\u0935 \u092e\u093e\u0939\u093f\u0924\u0940 \u0906\u0923\u093f \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u092e\u093e\u091d\u094d\u092f\u093e \u0938\u0930\u094d\u0935\u094b\u0924\u094d\u0924\u092e \u092e\u093e\u0939\u093f\u0924\u0940 \u0906\u0923\u093f \u0935\u093f\u0936\u094d\u0935\u093e\u0938\u093e\u0928\u0941\u0938\u093e\u0930 \u092c\u0930\u094b\u092c\u0930 \u0906\u0939\u0947\u0924.",acceptTermsText_p2:"\u092e\u0940 \u0938\u092e\u091c\u0924\u094b \u0915\u0940 \u0935\u0930\u0940\u0932 \u0918\u094b\u0937\u0923\u093e \u091a\u0941\u0915\u0940\u091a\u0940 \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u0947 \u0906\u0922\u0933\u0932\u094d\u092f\u093e\u0938, \u092e\u093e\u091d\u093e \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0915\u0947\u0932\u093e \u091c\u093e\u090a \u0936\u0915\u0924\u094b \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0935\u094d\u092f\u0924\u093f\u0930\u093f\u0915\u094d\u0924, \u092e\u093e\u091d\u094d\u092f\u093e\u0935\u0930 \u0915\u093e\u092f\u0926\u094d\u092f\u093e\u0928\u0941\u0938\u093e\u0930 \u0915\u093e\u0930\u0935\u093e\u0908 \u0915\u0947\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924\u0947.",acceptTermsText_p3:"\u092e\u0932\u093e \u0938\u092e\u091c\u0924\u0947 \u0915\u0940 \u0935\u0930\u0940\u0932 \u092e\u093e\u0939\u093f\u0924\u0940 \u0906\u0927\u093e\u0930 (\u0906\u0930\u094d\u0925\u093f\u0915 \u0906\u0923\u093f \u0907\u0924\u0930 \u0905\u0928\u0941\u0926\u093e\u0928\u093e\u0902\u091a\u0947 \u0932\u0915\u094d\u0937\u094d\u092f\u093f\u0924 \u0935\u093f\u0924\u0930\u0923, \u0932\u093e\u092d \u0906\u0923\u093f \u0938\u0947\u0935\u093e) \u0905\u0927\u093f\u0928\u093f\u092f\u092e, 2016 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0905\u0902\u0924\u0930\u094d\u0917\u0924 \u092c\u0928\u0935\u0932\u0947\u0932\u094d\u092f\u093e \u0928\u093f\u092f\u092e\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u0935\u093e\u092a\u0930\u0932\u0940, \u0909\u0918\u0921 \u0915\u093f\u0902\u0935\u093e \u0938\u093e\u092e\u093e\u092f\u093f\u0915 \u0915\u0947\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924\u0947.",acceptTermsText_p4:"\u0905\u0936\u093e \u092e\u093e\u0939\u093f\u0924\u0940\u091a\u0940 \u0924\u092f\u093e\u0930\u0940 \u0915\u093f\u0902\u0935\u093e \u0926\u0947\u0916\u092d\u093e\u0932 \u0915\u0930\u0923\u093e\u0931\u094d\u092f\u093e \u0905\u0927\u093f\u0915\u093e\u0931\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0921\u0947\u091f\u093e\u092c\u0947\u0938\u092e\u0927\u0942\u0928 \u0913\u0933\u0916, \u092a\u0924\u094d\u0924\u093e, \u091c\u0928\u094d\u092e \u0906\u0923\u093f/\u0915\u093f\u0902\u0935\u093e \u0938\u0902\u092c\u0902\u0927\u093e\u0902\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e \u0926\u0947\u0923\u093e\u0930\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u092a\u0926\u094d\u0927\u0924\u0940\u0928\u0947 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u0935\u0930\u0940\u0932 \u092e\u093e\u0939\u093f\u0924\u0940 \u0906\u0923\u093f \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0938\u0930\u0915\u093e\u0930\u0940 \u090f\u091c\u0928\u094d\u0938\u0940 \u0906\u0923\u093f/\u0915\u093f\u0902\u0935\u093e \u092f\u093e\u0902\u091a\u094d\u092f\u093e\u0936\u0940 \u0936\u0947\u0905\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092e\u0940 \u092f\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u092e\u093e\u091d\u0940 \u0938\u0902\u092e\u0924\u0940 \u0926\u0947\u0924\u094b. \u0905\u0938\u0947 \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923, \u092a\u0921\u0924\u093e\u0933\u0923\u0940\u091a\u094d\u092f\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u093e\u0928\u0947.",acceptTermsText_p5:"\u092e\u0940 \u092f\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u092f\u093e \u0918\u094b\u0937\u0923\u0947\u0936\u0940 \u0938\u0939\u092e\u0924 \u0906\u0939\u0947.",errorPop:{error:"\u0924\u094d\u0930\u0941\u091f\u0940!",close:"\u092c\u0902\u0926"}}},payment:{paymentOptions:{text:"\u0915\u0943\u092a\u092f\u093e \u092a\u0947\u092e\u0947\u0902\u091f \u092a\u0930\u094d\u092f\u093e\u092f \u0928\u093f\u0935\u0921\u093e"},makePayment:{welcomeText:"\u092a\u094d\u0930\u093f\u092f \u0930\u0939\u093f\u0935\u093e\u0938\u0940,",documentPaymentInfo:"\u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0921\u0947\u091f \u0935\u093f\u0928\u0902\u0924\u0940\u0935\u0930 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0915\u0921\u0942\u0928 {{paymentAmount}} \u0930\u0941\u092a\u092f\u0947 \u0906\u0915\u093e\u0930\u0932\u0947 \u091c\u093e\u0924\u0940\u0932.",paymentInfo:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0930\u0941. 50 \u0911\u0928\u0932\u093e\u0908\u0928 \u0905\u0926\u094d\u092f\u0924\u0928 \u0935\u093f\u0928\u0902\u0924\u0940\u0935\u0930 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940|",linkText:"\u0906\u092a\u0923 \u092f\u0947\u0925\u0947 \u0926\u0947\u092f\u0915\u0947 / \u0930\u0926\u094d\u0926\u092c\u093e\u0924\u0932 / \u092a\u0930\u0924\u093e\u0935\u093e \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u0947\u0935\u0930 \u0905\u0927\u093f\u0915 \u092e\u093e\u0939\u093f\u0924\u0940 \u0936\u094b\u0927\u0942 \u0936\u0915\u0924\u093e",acceptTerms:"\u092e\u0940 \u092f\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u0924\u094b \u0915\u0940 \u092e\u0940 \u0926\u0947\u092f\u0915 / \u0930\u0926\u094d\u0926\u092c\u093e\u0924\u0932 / \u092a\u0930\u0924\u093e\u0935\u093e \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0935\u093e\u091a\u0932\u0940 \u0906\u0939\u0947 \u0906\u0923\u093f \u092e\u0932\u093e \u0924\u0940 \u0938\u092e\u091c\u0932\u0940 \u0906\u0939\u0947|",poweredBy:"\u0926\u094d\u0935\u093e\u0930\u093e \u0938\u092e\u0930\u094d\u0925\u093f\u0924"},paymentStatus:{transactionStatus:"\u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0938\u094d\u0925\u093f\u0924\u0940",reason:"\u0915\u093e\u0930\u0923",dateAndTime:"\u0926\u0947\u092f \u0926\u093f\u0928\u093e\u0902\u0915 \u0906\u0923\u093f \u0935\u0947\u0933",amount:"\u0930\u0915\u094d\u0915\u092e",failed:"\u0905\u092f\u0936\u0938\u094d\u0935\u0940",success:"\u092f\u0936",downloadAckText:"\u092a\u093e\u0935\u0924\u0940 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u093e"},paymentPopup:{estTime:"\u0905\u0902\u0926\u093e\u091c\u0947 \u0935\u0947\u0933",description:"\u0915\u0943\u092a\u092f\u093e \u0906\u092e\u094d\u0939\u0940 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0947\u092a\u0930\u094d\u092f\u0902\u0924 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u093e \u0906\u0923\u093f \u092a\u094b\u091a\u092a\u093e\u0935\u0924\u0940 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e"}}},myHofRequests:{title:"\u092e\u093e\u091d\u0947 \u0915\u0941\u091f\u0941\u0902\u092c \u092a\u094d\u0930\u092e\u0941\u0916 (HoF) \u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e",description:"HoF \u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u0924\u094d\u0924\u093e \u0938\u093e\u092e\u093e\u092f\u093f\u0915\u0930\u0923 \u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e \u0924\u092a\u093e\u0938\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e",forms:{title:"\u0915\u0943\u092a\u092f\u093e SRN \u091f\u093e\u0907\u092a \u0915\u0930\u093e \u0906\u0923\u093f \u092a\u094d\u0930\u0924\u093f\u0938\u093e\u0926 \u0926\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0930\u093e",label:"SRN \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",buttons:{decline:"\u0928\u0915\u093e\u0930",accept:"\u0938\u094d\u0935\u0940\u0915\u093e\u0930\u093e"},displayMsg:{case1:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0935\u0930\u0940\u0932 SRN \u0935\u0930 {{resident}} \u0915\u0921\u0942\u0928 \u092a\u0924\u094d\u0924\u093e \u0938\u093e\u092e\u093e\u092f\u093f\u0915\u0930\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0935\u093f\u0928\u0902\u0924\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u091d\u093e\u0932\u0940 \u0906\u0939\u0947.",case2:"\u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u093e \u092a\u0924\u094d\u0924\u093e {{resident}} \u0938\u0939 \u0938\u093e\u092e\u093e\u092f\u093f\u0915\u0930\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u0926\u093f\u0932\u0940 \u0906\u0939\u0947.",case3:"\u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u093e \u092a\u0924\u094d\u0924\u093e {{resident}} \u0938\u0939 \u0938\u093e\u092e\u093e\u092f\u093f\u0915\u0930\u0923  \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0928\u0915\u093e\u0930 \u0926\u093f\u0932\u093e \u0906\u0939\u0947.",case4:"\u0935\u0930\u0940\u0932 SRN \u0935\u0930 \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0906\u0922\u0933\u0932\u0940 \u0928\u093e\u0939\u0940."},acceptScreen:{acceptMsg:"\u0924\u0941\u092e\u091a\u093e \u092a\u0924\u094d\u0924\u093e \u0938\u093e\u092e\u093e\u092f\u093f\u0915\u0930\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u0941\u091f\u0941\u0902\u092c \u092a\u094d\u0930\u092e\u0941\u0916 \u092e\u094d\u0939\u0923\u0942\u0928 \u0935\u093f\u0928\u0902\u0924\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0932\u0940 \u0906\u0939\u0947.",declineMsg:"\u0924\u0941\u092e\u091a\u093e \u092a\u0924\u094d\u0924\u093e \u0938\u093e\u092e\u093e\u092f\u093f\u0915\u0930\u0923  \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0941\u091f\u0941\u0902\u092c \u092a\u094d\u0930\u092e\u0941\u0916 \u092e\u094d\u0939\u0923\u0942\u0928 \u0924\u0941\u092e\u094d\u0939\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0928\u093e\u0915\u093e\u0930\u0932\u0940 \u0906\u0939\u0947."},confirmationPopUp:{rejectPrompt:"\u0924\u0941\u092e\u091a\u0940 \u0916\u093e\u0924\u094d\u0930\u0940 \u0906\u0939\u0947 \u0915\u0940 \u0924\u0941\u092e\u094d\u200d\u0939\u0940 \u092a\u0924\u094d\u200d\u0924\u093e  \u0938\u093e\u092e\u093e\u092f\u093f\u0915\u0930\u0923 \u0915\u0930\u0923\u094d\u200d\u092f\u093e\u0938\u093e\u0920\u0940 HoF \u092e\u094d\u0939\u0923\u0942\u0928 \u0935\u093f\u0928\u0902\u0924\u0940 \u0928\u093e\u0915\u093e\u0930\u0942 \u0907\u091a\u094d\u091b\u093f\u0924\u093e?",acceptPrompt:"\u0924\u0941\u092e\u094d\u200d\u0939\u093e\u0932\u093e \u0916\u093e\u0924\u094d\u0930\u0940 \u0906\u0939\u0947 \u0915\u0940 \u0924\u0941\u092e\u094d\u200d\u0939\u093e\u0932\u093e \u092a\u0924\u094d\u0924\u093e \u0938\u093e\u092e\u093e\u092f\u093f\u0915\u0930\u0923 \u0915\u0930\u0923\u094d\u200d\u092f\u093e\u0938\u093e\u0920\u0940 HoF \u092e\u094d\u200d\u0939\u0923\u0942\u0928 \u0935\u093f\u0928\u0902\u0924\u0940 \u0938\u094d\u200d\u0935\u0940\u0915\u093e\u0930\u093e\u092f\u091a\u0940 \u0906\u0939\u0947?"}}},pvc:{oauth:{preview:{sectionHeading:"\u0915\u0943\u092a\u092f\u093e \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921\u0938\u093e\u0920\u0940 \u0911\u0930\u094d\u0921\u0930 \u0926\u0947\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0906\u092a\u0932\u094d\u092f\u093e \u0932\u094b\u0915\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0924\u092a\u0936\u0940\u0932\u093e\u0902\u091a\u0947 \u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u093e",sectionText:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u093e\u092e\u0927\u094d\u092f\u0947 \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u091a\u0941\u0915\u0940\u091a\u0940 / \u0917\u0939\u093e\u0933 / \u091c\u0941\u0928\u0940 / \u091c\u0941\u0928\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0906\u0922\u0933\u0932\u094d\u092f\u093e\u0938, \u0924\u0941\u092e\u094d\u0939\u0940 \u0938\u0930\u094d\u0935\u093e\u0924 \u0906\u0927\u0940 \u0906\u0927\u093e\u0930 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0932\u093e \u092d\u0947\u091f \u0926\u0947\u090a\u0928 \u0915\u093f\u0902\u0935\u093e \u092f\u093e \u092a\u094b\u0930\u094d\u091f\u0932\u0935\u0930\u0942\u0928 \u201c\u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u093e\u201d \u092a\u0930\u094d\u092f\u093e\u092f\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u0906\u0927\u0940 \u0906\u092a\u0932\u093e \u0906\u0927\u093e\u0930 \u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0928\u093f\u0935\u0921 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.",name:"\u0928\u093e\u0935",dob:"\u091c\u0928\u094d\u092e \u0924\u093e\u0930\u0940\u0916",gender:"\u0932\u093f\u0902\u0917",address:"\u092a\u0924\u094d\u0924\u093e"}},generic:{form:{selectLabel:"\u0967\u0968 \u0905\u0902\u0915\u0940 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 / \u0ae8\u0aee \u0905\u0902\u0915\u0940 \u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0906\u092f\u0921\u0940 \u0928\u093f\u0935\u0921\u093e",radioLabels:{uid:"\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915",eid:"\u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0906\u092f\u0921\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915"},textFields:{uid:"\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",eid:"14 \u0905\u0902\u0915\u0940 \u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u091f\u093e\u0915\u093e",generic:"\u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0906\u092f\u0921\u0940, \u090f\u0938\u0906\u0930\u090f\u0928 \u0915\u093f\u0902\u0935\u093e \u092f\u0942\u0906\u0930\u090f\u0928 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",mobile:"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",otp:"\u0913\u091f\u0940\u092a\u0940 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",securityCode:"\u0915\u0945\u092a\u094d\u091a\u093e \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e"},checkBox:{mobile:"\u092e\u093e\u091d\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u0928\u093e\u0939\u0940",tnc:"\u0928\u093f\u092f\u092e \u0906\u0923\u093f \u0905\u091f\u0940"},button:{otp:"\u0913\u091f\u0940\u092a\u0940 \u092a\u093e\u0920\u0935\u093e",submit:"\u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0923\u0947"},modal:{mobile:"\u091c\u0930 \u0924\u0941\u092e\u091a\u093e \u0906\u0927\u093e\u0930 \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0938\u0939 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u0905\u0938\u0947\u0932 \u0924\u0930 \u0906\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u092e\u093e\u091d\u0947 \u0906\u0927\u093e\u0930 (myaadhaar.uidai.gov.in) \u0935\u0930 \u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921\u0938\u093e\u0920\u0940 \u0911\u0930\u094d\u0921\u0930 \u0926\u0947\u0923\u094d\u092f\u093e\u0938 \u092a\u094d\u0930\u094b\u0924\u094d\u0938\u093e\u0939\u093f\u0924 \u0915\u0930\u0942.",tnc:{heading:"\u0915\u0943\u092a\u092f\u093e \u0913\u090f\u0938\u0940 \u092a\u094b\u0930\u094d\u091f\u0932\u092e\u0927\u094d\u092f\u0947 \u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092e\u0902\u091c\u0942\u0930 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e '\u0928\u093f\u092f\u092e \u0935 \u0936\u0930\u094d\u0924\u0940' \u0916\u093e\u0932\u0940 \u0936\u094b\u0927\u093e:",t1:"\u092e\u0940 \u092f\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u092e\u093e\u091d\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921\u091a\u094d\u092f\u093e \u091b\u092a\u093e\u0908\u0938\u093e\u0920\u0940 \u0938\u0902\u092e\u0924\u0940 \u0926\u0947\u0924\u094b.",t2:"\u092e\u0932\u093e \u0938\u092e\u091c\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940 \u092e\u093e\u091d\u0947 \u092e\u0941\u0926\u094d\u0930\u093f\u0924 \u0915\u0947\u0932\u0947\u0932\u0947 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u092e\u093e\u091d\u094d\u092f\u093e \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u0935\u0930 \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u0940\u0932, \u0906\u0927\u093e\u0930 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u0906\u0939\u0947\u0924 \u091c\u0947 \u092a\u0942\u0930\u094d\u0923 \u0906\u0923\u093f \u092a\u093f\u0928\u0915\u094b\u0921 \u092c\u0930\u094b\u092c\u0930 \u092f\u094b\u0917\u094d\u092f \u0906\u0939\u0947\u0924.",t3:"\u092e\u0940 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0938\u0947\u0935\u0947\u0938\u093e\u0920\u0940 \u0911\u0930\u094d\u0921\u0930\u0938\u093e\u0920\u0940 \n\u0930\u0941.5\u0966 / - (\u0907\u0928\u0915 \u091c\u0940\u090f\u0938\u091f\u0940) \u0926\u0947\u0923\u094d\u092f\u093e\u0938 \u0938\u0939\u092e\u0924 \u0906\u0939\u0947.",t4:"\u092e\u0932\u093e \u0938\u092e\u091c\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u092a\u094b\u0939\u091a\u0923\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0928\u093f\u0915\u0937\u093e\u0902\u091a\u094d\u092f\u093e \u0905\u0928\u0941\u0937\u0902\u0917\u093e\u0928\u0947 \u0938\u094d\u092a\u0940\u0921 \u092a\u094b\u0938\u094d\u091f \u0907\u0902\u0921\u093f\u092f\u093e \u092a\u094b\u0938\u094d\u091f\u0926\u094d\u0935\u093e\u0930\u0947 \u0926\u093f\u0932\u0947 \u091c\u093e\u0908\u0932. \u0907\u0902\u0921\u093f\u092f\u093e \u092a\u094b\u0938\u094d\u091f \u0938\u094d\u091f\u0947\u091f\u0938 \u091f\u094d\u0930\u0945\u0915\u093f\u0902\u0917 \u0938\u0947\u0935\u093e \u0935\u093e\u092a\u0930\u0941\u0928 \u0935\u093f\u0924\u0930\u0923 \u0938\u094d\u0925\u093f\u0924\u0940\u091a\u093e \u092e\u093e\u0917\u094b\u0935\u093e \u0918\u0947\u0924\u0932\u093e \u091c\u093e\u090a \u0936\u0915\u0924\u094b."}}},payment:{welcomeText:"\u092a\u094d\u0930\u093f\u092f \u0930\u0939\u093f\u0935\u093e\u0938\u0940, ",srnInfo:"\u0906\u092a\u0932\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u090f\u0938\u0906\u0930\u090f\u0928 # \u0935\u0930 \u0928\u094b\u0902\u0926\u0935\u093f\u0932\u0940 \u0917\u0947\u0932\u0940 \u0906\u0939\u0947.",trackInfo:"\u0911\u0930\u094d\u0921\u0930 \u091f\u094d\u0930\u0945\u0915\u093f\u0902\u0917 \u0906\u0923\u093f \u092f\u0942\u0906\u092f\u0921\u0940\u090f\u0906\u092f\u0936\u0940 \u092a\u0924\u094d\u0930\u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0943\u092a\u092f\u093e \u0939\u093e \u0928\u0902\u092c\u0930 \u0935\u093e\u092a\u0930\u093e.",paymentText:"\u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \n\u0930\u0941.50 / - \u0930\u0941\u092a\u092f\u0947 (\u091c\u0940\u090f\u0938\u091f\u0940 \u0906\u0923\u093f \u0938\u094d\u092a\u0940\u0921 \u092a\u094b\u0938\u094d\u091f \u0936\u0941\u0932\u094d\u0915\u093e\u0938\u0939) \u0906\u0915\u093e\u0930\u0932\u0947 \u091c\u093e\u0908\u0932. ",redirectInfo:"\u0926\u0947\u092f \u0926\u094d\u092f\u093e \u092c\u091f\u0923\u093e\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0935\u0930, \u0906\u092a\u0932\u094d\u092f\u093e\u0932\u093e \u0911\u0928\u0932\u093e\u0907\u0928 \u0926\u0947\u092f\u0915\u093e\u0938\u093e\u0920\u0940 \u092a\u0947\u092f\u0942 \u092a\u0947\u092e\u0947\u0902\u091f \u0917\u0947\u091f\u0935\u0947\u0935\u0930 \u092a\u0941\u0928\u0930\u094d\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u0947\u0932\u0947 \u091c\u093e\u0908\u0932. \u092f\u0936\u0938\u094d\u0935\u0940 \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0947\u0932\u094d\u092f\u093e\u0935\u0930 \u0906\u092a\u0923\u093e\u0938 \u092a\u094b\u091a\u092a\u093e\u0935\u0924\u0940 \u0938\u094d\u0932\u093f\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u093e \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930 \u092a\u0930\u0924 \u092a\u093e\u0920\u0935\u093f\u0932\u0947 \u091c\u093e\u0908\u0932. \u0926\u0947\u092f\u0915 \u0905\u092f\u0936\u0938\u094d\u0935\u0940 \u091d\u093e\u0932\u094d\u092f\u093e\u0938 \u0906\u092a\u0923 \u0905\u0928\u0947\u0915 \u0935\u0947\u0933\u093e \u0926\u0947\u092f \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.",button:{cancel:"\u0930\u0926\u094d\u0926 \u0915\u0930\u093e",makePayment:"\u0926\u0947\u092f \u0926\u094d\u092f\u093e"}}},status:{srnField:"\u090f\u0938\u0906\u0930\u090f\u0928 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",table:{srn:"\u090f\u0938\u0906\u0930\u090f\u0928",orderDate:"\u0911\u0930\u094d\u0921\u0930 \u0924\u093e\u0930\u0940\u0916",currentStatus:"\u0938\u0927\u094d\u092f\u093e\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940",awb:"\u0939\u0935\u093e\u0908 \u092e\u093e\u0930\u094d\u0917 \u092c\u093f\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915",dispatchDate:"\u0921\u093f\u0938\u094d\u092a\u0945\u091a\u091a\u0940 \u0924\u093e\u0930\u0940\u0916",awb_subText:"\u0906\u092a\u0923 \u0935\u0930\u0940\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u091a\u093e \u0935\u093e\u092a\u0930 \u0915\u0930\u0942\u0928 'www.indiapost.gov.in' \u0935\u0930 \u0906\u092a\u0932\u0940 \u0911\u0930\u094d\u0921\u0930 \u091f\u094d\u0930\u0945\u0915 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e",demographic:"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u0947\u091a\u094d\u092f\u093e \u0915\u093e\u0930\u0923\u093e\u0938\u094d\u0924\u0935, \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0938\u093e\u0920\u0940 \u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u093e\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0930\u093e\u091c\u094d\u092f\u093e\u0924 \u0909\u0918\u0921 \u0915\u0947\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924 \u0928\u093e\u0939\u0940. \u0924\u0925\u093e\u092a\u093f, \u0911\u0930\u094d\u0921\u0930 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921\u092e\u0927\u094d\u092f\u0947 \u0906\u0927\u093e\u0930\u091a\u0940 \u0928\u0935\u0940\u0928\u0924\u092e \u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f \u092e\u093e\u0939\u093f\u0924\u0940 \u0905\u0938\u0947\u0932."}}},aadharStatus:{title:"\u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0906\u0923\u093f \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u093e",description:{one:"\u0924\u0941\u092e\u091a\u0947 \u0906\u0927\u093e\u0930 \u091c\u0928\u0930\u0947\u091f \u0915\u093f\u0902\u0935\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0947\u0932\u0947 \u0906\u0939\u0947 \u0915\u093e \u0924\u0947 \u0924\u092a\u093e\u0938\u093e .",twoEID:"14 \u0905\u0902\u0915\u0940 \u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915, \u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940/\u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0947\u0902\u0926\u094d\u0930 \u0928\u092e\u0941\u0928\u094d\u092f\u093e\u0932\u093e \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u092d\u0947\u091f \u0926\u0947\u0924\u093e\u0928\u093e \u092a\u093e\u0935\u0924\u0940 \u0938\u094d\u0932\u093f\u092a\u0935\u0930 \u091b\u093e\u092a\u0932\u0947\u0932\u093e\u0903 1234/12345/12345",twoSRN:"'\u090f\u0938' \u0928\u0902\u0924\u0930 13 \u0905\u0902\u0915, \u0911\u0928\u0932\u093e\u0908\u0928 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0935\u093f\u0928\u0902\u0924\u0940 \u0938\u093e\u0926\u0930 \u0915\u0930\u0924\u093e\u0928\u093e \u092a\u093e\u0935\u0924\u0940 \u0938\u094d\u0932\u093f\u092a\u0935\u0930 \u091b\u093e\u092a\u0932\u0947\u0932\u0947 \u0928\u092e\u0941\u0928\u0947\u0903 \u090f\u09381234567891234",twoURN:"'\u090f\u092e\u0906\u0927\u093e\u0930' \u0905\u0930\u094d\u091c\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0935\u093f\u0928\u0902\u0924\u0940 \u0938\u093e\u0926\u0930 \u0915\u0930\u0924\u093e\u0928\u093e \u092a\u093e\u0935\u0924\u0940 \u0938\u094d\u0932\u093f\u092a\u0935\u0930 \u091b\u093e\u092a\u0932\u0947\u0932\u093e 8 \u0905\u0902\u0915\u0940 \u092f\u0942\u0906\u0930\u090f\u0928 \u0928\u092e\u0941\u0928\u093e\u0903 12345678",twoSID:"\u2018S\u2019 followed by 27 digits, printed on acknowledgement slip while physically visiting Enrolment / Update center. Sample: S123456789123456789123456789",three:"\u091c\u0930 \u0924\u0941\u092e\u094d\u0939\u0940 EID \u0917\u092e\u093e\u0935\u0932\u093e \u0905\u0938\u0947\u0932 \u0924\u0930 \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u0939\u0930\u0935\u0932\u0947\u0932\u093e \u0915\u093f\u0902\u0935\u093e \u0935\u093f\u0938\u0930\u0932\u0947\u0932\u093e EID \u092e\u093f\u0933\u0935\u0942 \u0936\u0915\u0924\u093e."},optionalMessage:"\u092a\u094b\u091a\u0924\u0940 \u0938\u094d\u0932\u093f\u092a\u0928\u0941\u0938\u093e\u0930 \u0924\u093e\u0930\u0940\u0916 \u0906\u0923\u093f \u0935\u0947\u0933 \u0928\u092e\u0942\u0926 \u0915\u0930\u093e (<b>\u092a\u0930\u094d\u092f\u093e\u092f\u0940</b>)"},complaintStatus:{title:"\u0924\u0915\u094d\u0930\u093e\u0930 / \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u093e",form:{complaintNumber:"\u0938\u0947\u0935\u093e \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",QRCid:"Qrc Id",status:"\u0938\u094d\u0925\u093f\u0924\u0940",ComplaintNumber:"\u0924\u0915\u094d\u0930\u093e\u0930 / \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u0915\u094d\u0930\u092e\u093e\u0902\u0915",ResolutionResponse:"\u0920\u0930\u093e\u0935 \u092a\u094d\u0930\u0924\u093f\u0938\u093e\u0926"}},fileComplaint:{title:"\u0924\u0915\u094d\u0930\u093e\u0930 \u0906\u0923\u093f \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f",description:"\u0924\u0941\u092e\u091a\u0940 \u0924\u0915\u094d\u0930\u093e\u0930 \u0906\u0923\u093f \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0928\u094b\u0902\u0926\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e",disclaimer:"\u0906\u0927\u093e\u0930, \u0938\u0930\u094d\u0935\u093e\u0924 \u0938\u093e\u092e\u093e\u0928\u094d\u092f\u092a\u0923\u0947 \u0935\u093e\u092a\u0930\u0932\u0940 \u091c\u093e\u0923\u093e\u0930\u0940 \u0921\u093f\u091c\u093f\u091f\u0932 \u0913\u0933\u0916 \u092e\u094d\u0939\u0923\u0942\u0928, \u0905\u0928\u0947\u0915 \u0905\u0928\u0941\u0926\u093e\u0928\u0947, \u092b\u093e\u092f\u0926\u0947 \u0906\u0923\u093f \u0938\u0947\u0935\u093e\u0902\u091a\u093e \u0932\u093e\u092d \u0918\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u093e\u092a\u0930\u0932\u093e \u091c\u093e\u0924\u094b. \u0939\u0947 \u0932\u0915\u094d\u0937\u093e\u0924 \u0918\u0947\u090a\u0928, \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e\u092c\u0947\u0938\u091a\u0940 \u0905\u091a\u0942\u0915\u0924\u093e \u0930\u093e\u0916\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, UIDAI \u0928\u0947 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0906\u0923\u093f \u0906\u0927\u093e\u0930 \u092e\u093e\u0939\u093f\u0924\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u090f\u0915 \u0915\u0935\u093e\u092f\u0924 \u0938\u0941\u0930\u0942 \u0915\u0947\u0932\u0940 \u0939\u094b\u0924\u0940. \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0939\u093e\u0924\u0940 \u0918\u0947\u0924\u0932\u0947\u0932\u094d\u092f\u093e \u0909\u092a\u0915\u094d\u0930\u092e\u093e\u0902\u092e\u0927\u094d\u092f\u0947, \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915\u093e\u0902\u0928\u093e \u0935\u0947\u0933\u094b\u0935\u0947\u0933\u0940 \u0938\u0942\u091a\u0928\u093e \u0926\u093f\u0932\u094d\u092f\u093e \u091c\u093e\u0924\u093e\u0924. \u092f\u093e \u0938\u0902\u0926\u0930\u094d\u092d\u093e\u0924 \u0938\u094d\u092a\u0937\u094d\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940, \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0930\u0926\u094d\u0926 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947\u0932\u093e \u0928\u093e\u0939\u0940. \u091c\u0930 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915\u093e\u0932\u093e \u092f\u093e \u0938\u0902\u0926\u0930\u094d\u092d\u093e\u0924 \u0915\u093e\u0939\u0940 \u0924\u0915\u094d\u0930\u093e\u0930 \u0905\u0938\u0947\u0932 \u0924\u0930 \u0924\u0947 \u0924\u094d\u092f\u093e\u0902\u091a\u093e \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u092f\u0947\u0925\u0947 \u0938\u093e\u0926\u0930 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924. \u0905\u0936\u093e \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0924\u0915\u094d\u0930\u093e\u0930\u0940\u091a\u0940 \u092f\u094b\u0917\u094d\u092f \u0924\u0940 \u0926\u0916\u0932 \u0918\u0947\u0924\u0932\u0940 \u091c\u093e\u0908\u0932.",form:{heading:"\u0915\u0943\u092a\u092f\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0924\u092a\u0936\u0940\u0932 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",state:"\u0930\u093e\u091c\u094d\u092f \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",enquirer:"(\u0938\u094d\u0935\u0924\u0903/\u0907\u0924\u0930\u093e\u0902\u0938\u093e\u0920\u0940) \u0924\u0915\u094d\u0930\u093e\u0930 / \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f",complaintType:"\u0924\u0915\u094d\u0930\u093e\u0930 / \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u092a\u094d\u0930\u0915\u093e\u0930 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",categoryType:"\u0936\u094d\u0930\u0947\u0923\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",uploadDocumentLabel:"\u0924\u092a\u0936\u0940\u0932 \u092a\u0939\u093e \u0906\u0923\u093f \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u093e (\u0905\u0938\u0932\u094d\u092f\u093e\u0938)",statusField:"EID / SRN / URN \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",placeholder:"\u092a\u094d\u0930\u093f\u092f \u0930\u0939\u093f\u0935\u093e\u0938\u0940, \u0924\u0941\u092e\u091a\u0940 \u091a\u093f\u0902\u0924\u093e \u092a\u094d\u0930\u092d\u093e\u0935\u0940\u092a\u0923\u0947 \u0938\u094b\u0921\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e {{fields}} \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0947\u0932\u0940 \u091c\u093e\u0924\u0947.",error:{complaintType:"\u0924\u0915\u094d\u0930\u093e\u0930 / \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u093e \u0928\u093e\u0939\u0940",categoryType:"\u0936\u094d\u0930\u0947\u0923\u0940 \u0928\u093f\u0935\u0921\u0932\u0940 \u0928\u093e\u0939\u0940",state:"\u0930\u093e\u091c\u094d\u092f \u0928\u093f\u0935\u0921\u0932\u0947 \u0928\u093e\u0939\u0940",enquirer:"\u091a\u094c\u0915\u0936\u0940 \u0915\u0930\u0923\u093e\u0930\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u093e \u0928\u093e\u0939\u0940"}},Complaintnote:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0924\u0915\u094d\u0930\u093e\u0930\u0940\u091a\u0947 \u0924\u094d\u0935\u0930\u093f\u0924 \u0928\u093f\u0930\u093e\u0915\u0930\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u094b\u0917\u094d\u092f \u0924\u0915\u094d\u0930\u093e\u0930/\u092b\u0940\u0921\u092c\u0945\u0915 \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u0923\u094d\u092f\u093e\u091a\u093e \u0938\u0932\u094d\u0932\u093e \u0926\u093f\u0932\u093e \u091c\u093e\u0924\u094b. \u091a\u0941\u0915\u0940\u091a\u094d\u092f\u093e \u0924\u0915\u094d\u0930\u093e\u0930\u0940 / \u092b\u0940\u0921\u092c\u0945\u0915 \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u0932\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0935\u093f\u0928\u0902\u0924\u0940\u0935\u0930 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0915\u093f\u0902\u0935\u093e \u0930\u0926\u094d\u0926 \u0939\u094b\u0923\u094d\u092f\u093e\u0938 \u0935\u093f\u0932\u0902\u092c \u0939\u094b\u090a \u0936\u0915\u0924\u094b",Categorynote:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0924\u0915\u094d\u0930\u093e\u0930\u0940\u091a\u0947 \u0924\u094d\u0935\u0930\u093f\u0924 \u0928\u093f\u0930\u093e\u0915\u0930\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u094b\u0917\u094d\u092f \u0936\u094d\u0930\u0947\u0923\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u0923\u094d\u092f\u093e\u091a\u093e \u0938\u0932\u094d\u0932\u093e \u0926\u093f\u0932\u093e \u091c\u093e\u0924\u094b. \u091a\u0941\u0915\u0940\u091a\u094d\u092f\u093e \u0936\u094d\u0930\u0947\u0923\u0940 \u092a\u094d\u0930\u0915\u093e\u0930\u093e\u091a\u094d\u092f\u093e \u0928\u093f\u0935\u0921\u0940\u092e\u0941\u0933\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0935\u093f\u0928\u0902\u0924\u0940\u0935\u0930 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0915\u093f\u0902\u0935\u093e \u0930\u0926\u094d\u0926 \u0939\u094b\u0923\u094d\u092f\u093e\u0938 \u0935\u093f\u0932\u0902\u092c \u0939\u094b\u090a \u0936\u0915\u0924\u094b",feedbackTextArea:" \u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u093e \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u0936\u0947\u0905\u0930 \u0915\u0930\u093e",feedback:"\u0915\u0943\u092a\u092f\u093e \u0916\u093e\u0932\u0940 \u0930\u0947\u091f\u093f\u0902\u0917 \u0926\u0947\u090a\u0928 \u0924\u0941\u092e\u091a\u0940 \u0924\u0915\u094d\u0930\u093e\u0930 / \u0905\u092d\u093f\u092a\u094d\u0930\u093e\u092f \u0926\u093e\u0916\u0932 \u0915\u0930\u0924\u093e\u0928\u093e \u0924\u0941\u092e\u091a\u093e \u0905\u0928\u0941\u092d\u0935 \u0936\u0947\u0905\u0930 \u0915\u0930\u093e"},errorMessages:{slipApiFailed:"\u092a\u094b\u091a\u092a\u093e\u0935\u0924\u0940 \u0938\u094d\u0932\u093f\u092a \u0935\u094d\u092f\u0941\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0924\u094d\u0930\u0941\u091f\u0940 \u0906\u0932\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0906\u092e\u094d\u0939\u0940 \u092a\u0941\u0922\u0947 \u091c\u093e\u090a \u0936\u0915\u0932\u094b \u0928\u093e\u0939\u0940. \u0915\u0943\u092a\u092f\u093e \u0925\u094b\u0921\u094d\u092f\u093e \u0935\u0947\u0933\u093e\u0928\u0947 \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e.",exisitingDraft:"\u0906\u092a\u0932\u094d\u092f\u093e\u0915\u0921\u0947 \u092a\u094b\u0930\u094d\u091f\u0932\u0938\u0939 \u092e\u093e\u0917\u0940\u0932 \u092a\u0930\u0938\u094d\u092a\u0930\u0938\u0902\u0935\u093e\u0926\u093e\u091a\u093e \u0906\u0927\u0940\u092a\u093e\u0938\u0942\u0928\u091a \u0938\u0915\u094d\u0930\u093f\u092f \u092e\u0938\u0941\u0926\u093e \u0906\u0939\u0947. \u0906\u092a\u0923 \u092e\u0938\u0941\u0926\u093e \u0935\u093f\u0928\u0902\u0924\u0940 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e \u0915\u093f\u0902\u0935\u093e \u0930\u0926\u094d\u0926 \u0915\u0930\u093e \u0906\u0923\u093f 