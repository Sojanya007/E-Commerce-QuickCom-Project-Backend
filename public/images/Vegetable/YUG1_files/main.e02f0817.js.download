u0633\u06cc\u0646\u0679\u0631 \u062a\u0644\u0627\u0634 \u06a9\u0631\u06cc\u06ba",description:"\u0642\u0631\u06cc\u0628 \u0645\u06cc\u06ba \u0622\u062f\u06be\u0627\u0631 \u062e\u062f\u0645\u062a \u06a9\u06cc\u0646\u062f\u0631\u0633 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u0627\u0633 \u06a9\u0627 \u067e\u062a\u06c1 \u0644\u06af\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u06cc\u06c1\u0627\u06ba \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba"},lockUnlockAadhaar:{title:"\u0622\u062f\u06be\u0627\u0631 \u06a9\u0648 \u0644\u0627\u06a9 / \u0627\u0646\u0644\u0627\u06a9 \u06a9\u0631\u06cc\u06ba",description:"\u0627\u067e\u0646\u06d2 \u0622\u062f\u06be\u0627\u0631 \u06a9\u0648 \u0639\u0627\u0631\u0636\u06cc \u0637\u0648\u0631 \u067e\u0631 \u0644\u0627\u06a9 / \u0627\u0646\u0644\u0627\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u06cc\u06c1\u0627\u06ba \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 \u0628\u0631\u0627\u0626\u06d2 \u0645\u06c1\u0631\u0628\u0627\u0646\u06cc \u0627\u0633 \u062e\u062f\u0645\u062a \u06a9\u0648 \u0627\u062d\u062a\u06cc\u0627\u0637 \u0633\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba"},complaintStatus:{title:"\u0634\u06a9\u0627\u06cc\u062a / \u062a\u0627\u062b\u0631\u0627\u062a \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a \u06a9\u0648 \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",description:"\u0634\u06a9\u0627\u06cc\u0627\u062a/\u0641\u06cc\u0688 \u0628\u06cc\u06a9 \u06a9\u06cc \u06a9\u06cc\u0641\u06cc\u062a \u062c\u0627\u0646\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06cc\u06c1\u0627\u06ba \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4"},fileComplaint:{title:"\u0634\u06a9\u0627\u06cc\u062a \u0627\u0648\u0631 \u0631\u0627\u0626\u06d2",description:"\u0627\u067e\u0646\u06cc \u0634\u06a9\u0627\u06cc\u062a \u0627\u0648\u0631 \u0631\u0627\u0626\u06d2 \u062f\u0631\u062c \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06cc\u06c1\u0627\u06ba \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4"}}}},documentUpdate:{intentPage:{title:"\u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0627\u067e \u0688\u06cc\u0679 \u0633\u0631\u0648\u0633 \u06a9\u0627 \u0645\u0642\u0635\u062f",p1:"\u0639\u0632\u06cc\u0632 \u0631\u06c1\u0627\u0626\u0634\u06cc\u060c",p2:"\u0622\u067e \u06a9\u0648 \u0645\u0634\u0648\u0631\u06c1 \u062f\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0627\u067e\u0646\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0688\u06cc\u0679\u0627 \u0628\u06cc\u0633 \u0645\u06cc\u06ba \u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646 \u0634\u0646\u0627\u062e\u062a\u06cc \u062b\u0628\u0648\u062a (POI) \u0627\u0648\u0631 \u067e\u062a\u06c1 \u06a9\u0627 \u062b\u0628\u0648\u062a (POA) \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631 \u06a9\u06d2 \u0627\u067e\u0646\u06d2 \u0622\u062f\u06be\u0627\u0631 \u06a9\u0648 \u0645\u0636\u0628\u0648\u0637 \u06a9\u0631\u06cc\u06ba\u06d4 POI/POA \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u0645\u06cc\u06ba \u0645\u0648\u062c\u0648\u062f \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0622\u067e \u06a9\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0645\u06cc\u06ba \u062f\u0631\u062c \u0622\u067e \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0633\u06d2 \u0645\u0645\u0627\u062b\u0644 \u06c1\u0648\u0646\u06cc \u0686\u0627\u06c1\u0626\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0622\u062f\u06be\u0627\u0631 \u0688\u06cc\u0679\u0627 \u0628\u06cc\u0633 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06cc \u0645\u0633\u0644\u0633\u0644 \u062f\u0631\u0633\u062a\u06af\u06cc \u06a9\u0648 \u06cc\u0642\u06cc\u0646\u06cc \u0628\u0646\u0627\u0646\u06d2 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u06cc \u0645\u062f\u062f \u06a9\u0631\u06d2 \u06af\u0627\u06d4",p3:"\u0627\u06af\u0631 \u0622\u067e \u0646\u06d2 \u067e\u06c1\u0644\u06d2 \u06c1\u06cc \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0622\u062f\u06be\u0627\u0631 \u0627\u0646\u0631\u0648\u0644\u0645\u0646\u0679 \u0633\u06cc\u0646\u0679\u0631 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u06cc\u0627 myAadhaar \u067e\u0648\u0631\u0679\u0644 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc\u0627 \u06c1\u06d2\u060c \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u0633 \u06a9\u06cc \u0642\u0628\u0648\u0644\u06cc\u062a \u06a9\u0627 \u0627\u0646\u062a\u0638\u0627\u0631 \u06a9\u0631\u06cc\u06ba \u06cc\u0627 \u062f\u0648\u0633\u0631\u06cc \u0635\u0648\u0631\u062a \u0645\u06cc\u06ba\u06d4 \u062c\u0645\u0639 \u06a9\u0631\u0627\u0626\u06cc \u06af\u0626\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06d2 \u0645\u0633\u062a\u0631\u062f \u06c1\u0648\u0646\u06d2 \u06a9\u06cc \u0635\u0648\u0631\u062a \u0645\u06cc\u06ba\u060c \u0622\u067e \u06a9\u0648 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u0627 \u067e\u0691 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4",p4:"\u0627\u06af\u0631 \u0622\u067e \u0627\u067e\u0646\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0645\u06cc\u06ba \u0627\u06cc\u0688\u0631\u06cc\u0633 \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645",p5:"\u06cc\u06c1\u0627\u06ba \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba.",p6:"\u062e\u062f\u0645\u0627\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 25/- \u0631\u0648\u067e\u06d2 \u06a9\u0627 \u0645\u0639\u0645\u0648\u0644\u06cc \u0686\u0627\u0631\u062c \u0627\u062f\u0627 \u06a9\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u060c \u062c\u0648 \u0646\u0627\u0642\u0627\u0628\u0644 \u0648\u0627\u067e\u0633\u06cc \u06c1\u06d2\u06d4",p7:"\u06cc\u06c1 \u0633\u0631\u0648\u0633 14/06/2025 \u062a\u06a9 \u0645\u0641\u062a \u06c1\u06d2\u06d4"},howItWorks:{description:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u062f\u0631\u062c \u0630\u06cc\u0644 \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u06a9\u0648 \u063a\u0648\u0631 \u0633\u06d2 \u067e\u0691\u06be\u06cc\u06ba\u06d4 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u067e\u0631 \u06a9\u0627\u0631\u0631\u0648\u0627\u0626\u06cc \u06cc\u0627 \u0645\u0633\u062a\u0631\u062f \u06c1\u0648\u0646\u06d2 \u0645\u06cc\u06ba \u062a\u0627\u062e\u06cc\u0631 \u0633\u06d2 \u0628\u0686\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u062e\u062a\u0644\u0641 \u0645\u0631\u0627\u062d\u0644 \u0645\u06cc\u06ba \u062a\u062c\u0648\u06cc\u0632 \u06a9\u0631\u062f\u06c1 \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u067e\u0631 \u0639\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4 \u0627\u06af\u0631 \u0622\u067e \u0627\u067e\u0646\u0627 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645",stepDescription:{one:"\u0627\u067e\u0646\u06cc \u0634\u0646\u0627\u062e\u062a \u06a9\u0627 \u062b\u0628\u0648\u062a (\u067e\u06cc \u0627\u0648 \u0622\u0626\u06cc ) \u0627\u0648\u0631 \u067e\u062a\u06c1 \u06a9\u0627 \u062b\u0628\u0648\u062a (\u067e\u06cc \u0627\u0648 \u0627\u06d2 ) \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06cc\u06c1\u0627\u06ba \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",two:"\u0627\u0633 \u0645\u0631\u062d\u0644\u06d2 \u0645\u06cc\u06ba\u060c \u0622\u067e \u0633\u06d2 \u062f\u0631\u0633\u062a \u067e\u06cc \u0627\u0648 \u0622\u0626\u06cc /\u067e\u06cc \u0627\u0648 \u0627\u06d2  \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u0648 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u06c1\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u062c\u0646 \u0645\u06cc\u06ba \u0645\u0631\u062d\u0644\u06c1 1 \u0645\u06cc\u06ba \u062a\u0635\u062f\u06cc\u0642 \u0634\u062f\u06c1 \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0645\u0648\u062c\u0648\u062f \u06c1\u06cc\u06ba\u06d4",three:"\u0622\u067e \u06a9\u0648 \u0627\u0633 \u0633\u0631\u0648\u0633 \u06a9\u06d2 \u0644\u06cc\u06d2 \u20b9 \u0662\u0665  (\u0635\u0631\u0641 \u067e\u0686\u06cc\u0633 \u0631\u0648\u067e\u06d2) \u0627\u062f\u0627 \u06a9\u0631\u0646\u06d2 \u06c1\u0648\u06ba \u06af\u06d2\u06d4 \u0622\u067e \u06a9\u0631\u06cc\u0688\u0679/\u0688\u06cc\u0628\u0679 \u06a9\u0627\u0631\u0688 \u06cc\u0627 \u0646\u06cc\u0679 \u0628\u06cc\u0646\u06a9\u0646\u06af \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0631\u0642\u0645 \u0646\u0627\u0642\u0627\u0628\u0644 \u0648\u0627\u067e\u0633\u06cc \u06c1\u06d2\u06d4"},note:"\u0627\u06af\u0631 \u0622\u067e \u0627\u067e\u0646\u06cc \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a (\u0646\u0627\u0645\u060c \u0688\u06cc \u0627\u0648 \u0628\u06cc \u060c \u062c\u0646\u0633 \u06cc\u0627 \u067e\u062a\u06c1) \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u06cc\u06c1\u0627\u06ba \u0627\u067e\u0646\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06a9\u0648 \u0627\u067e ",noteLink:"\u0688\u06cc\u0679 \u06a9\u0631\u06cc\u06ba\u06d4"},currentSection:{form:{title:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u067e\u0646\u06cc \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06a9\u06cc \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u06cc\u06ba\u06d4",name:"\u0646\u0627\u0645",gender:"\u0635\u0646\u0641",dob:"\u067e\u06cc\u062f\u0627\u0626\u0634 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e",address:"\u067e\u062a\u06c1",consent:"\u0645\u06cc\u06ba \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u062a\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u0627\u0648\u067e\u0631 \u062f\u06cc \u06af\u0626\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u062f\u0631\u0633\u062a \u06c1\u06cc\u06ba\u06d4"},note:"\u0627\u06af\u0631 \u0622\u067e \u06a9\u06cc \u06a9\u0633\u06cc \u0628\u06be\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0645\u06cc\u06ba \u0645\u0645\u0627\u062b\u0644\u062a \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u06cc\u06c1\u0627\u06ba \u0627\u067e\u0646\u06cc \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a (\u0646\u0627\u0645\u060c \u067e\u062a\u06c1\u060c DoB \u06cc\u0627 \u062c\u0646\u0633) ",noteLink:"\u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u06cc\u06ba\u06d4"},uploadSection:{confirmationPopUp:{title:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0645\u06cc\u06ba \u0627\u067e\u0646\u06cc \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06a9\u06cc \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u06cc\u06ba \u062c\u0648 \u0622\u062f\u06be\u0627\u0631 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u06cc \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0633\u06d2 \u0628\u0627\u0644\u06a9\u0644 \u0645\u0645\u0627\u062b\u0644 \u06c1\u06d2\u06d4"},stepper:{verify:"\u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u06cc\u06ba",upload:"\u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba"},guidelines:{title:"\u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u062f\u0627\u06cc\u0627\u062a ",l1:"\u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u0627 \u0633\u0627\u0626\u0632 2 \u0627\u0645 \u0628\u06cc  \u0633\u06d2 \u06a9\u0645 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2\u06d4",l2:"\u0645\u0639\u0627\u0648\u0646 \u0641\u0627\u0626\u0644 \u0641\u0627\u0631\u0645\u06cc\u0679\u0633 \u06c1\u06cc\u06ba: \u062c\u06d2 \u067e\u06cc \u0627\u06d2 \u062c\u06cc \u060c \u067e\u06cc \u0627\u0646 \u062c\u06cc  \u0627\u0648\u0631 \u067e\u06cc \u0688\u06cc \u0627\u0641 "},form:{poiTitle:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0634\u0646\u0627\u062e\u062a \u06a9\u0627 \u062b\u0628\u0648\u062a (\u067e\u06cc \u0627\u0648 \u0622\u0626\u06cc ) \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba\u06d4",poaTitle:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u067e\u062a\u06d2 \u06a9\u0627 \u062b\u0628\u0648\u062a (\u067e\u06cc \u0627\u0648 \u0627\u06d2 ) \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"},consent:"\u0645\u06cc\u06ba \u0627\u0633 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u067e\u0646\u06cc \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u062f\u06cc\u062a\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u0645\u06cc\u0631\u06d2 \u0630\u0631\u06cc\u0639\u06c1 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062f\u06c1/\u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u062f\u06c1 \u0645\u0639\u0644\u0648\u0645\u0627\u062a/\u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062d\u06a9\u0648\u0645\u062a \u06a9\u06cc \u0637\u0631\u0641 \u0633\u06d2 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0645\u0631\u062d\u0644\u06d2 \u067e\u0631 \u062a\u0635\u062f\u06cc\u0642 \u0633\u06d2 \u0645\u0634\u0631\u0648\u0637 \u06c1\u0648\u0633\u06a9\u062a\u06cc \u06c1\u06cc\u06ba\u06d4"},faq:{card:{heading:"\u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u06cc \u062a\u0627\u0632\u06c1 \u06a9\u0627\u0631\u06cc",description_1:"",description_2:""},guidelines:{heading_1:"\u0634\u0646\u0627\u062e\u062a \u0627\u0648\u0631 \u067e\u062a\u06d2 \u06a9\u06cc \u062d\u0645\u0627\u06cc\u062a \u0645\u06cc\u06ba \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba",heading_2:"14/06/2025 \u062a\u06a9 \u0645\u0641\u062a",question_1:{title:"\u06a9\u06cc\u0627 \u062c\u0645\u0639 \u06a9\u0631\u0646\u0627 \u06c1\u06d2\u061f",content:{line_1:"\u0631\u0627\u0634\u0646 \u06a9\u0627\u0631\u0688\u060c \u0648\u0648\u0679\u0631 \u0634\u0646\u0627\u062e\u062a\u06cc \u06a9\u0627\u0631\u0688\u060c \u062d\u06a9\u0648\u0645\u062a \u06a9\u06cc \u0637\u0631\u0641 \u0633\u06d2 \u062c\u0627\u0631\u06cc \u06a9\u0631\u062f\u06c1 \u0634\u0646\u0627\u062e\u062a\u06cc \u06a9\u0627\u0631\u0688/ \u067e\u062a\u06c1 \u0648\u0627\u0644\u0627 \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679\u060c \u0627\u0648\u0631 \u06c1\u0646\u062f\u0648\u0633\u062a\u0627\u0646\u06cc \u067e\u0627\u0633\u067e\u0648\u0631\u0679 \u0634\u0646\u0627\u062e\u062a \u0627\u0648\u0631 \u067e\u062a\u06c1 \u062f\u0648\u0646\u0648\u06ba \u06a9\u06d2 \u062b\u0628\u0648\u062a \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u06a9\u0627\u0645 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",line_2:"\u067e\u06cc\u0646 \u06a9\u0627\u0631\u0688\u060c \u0688\u0631\u0627\u0626\u06cc\u0648\u0646\u06af \u0644\u0627\u0626\u0633\u0646\u0633\u060c \u0633\u06cc\u06a9\u0646\u0688\u0631\u06cc \u06cc\u0627 \u0633\u06cc\u0646\u0626\u0631 \u0627\u0633\u06a9\u0648\u0644 \u0645\u0627\u0631\u06a9 \u0634\u06cc\u0679/ \u0627\u0633\u06a9\u0648\u0644 \u0686\u06be\u0648\u0691\u0646\u06d2 \u06a9\u0627 \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679 \u062c\u0633 \u0645\u06cc\u06ba \u062a\u0635\u0648\u06cc\u0631 \u06c1\u06d2\u060c \u062d\u06a9\u0648\u0645\u062a \u06a9\u0627 \u062c\u0627\u0631\u06cc \u06a9\u0631\u062f\u06c1 \u0634\u0646\u0627\u062e\u062a\u06cc \u06a9\u0627\u0631\u0688/ \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679 - \u0634\u0646\u0627\u062e\u062a \u06a9\u06d2 \u0635\u0631\u0641 \u062b\u0628\u0648\u062a \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u06a9\u0627\u0645 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",line_3:"\u0628\u062c\u0644\u06cc/\u067e\u0627\u0646\u06cc/\u06af\u06cc\u0633 \u06a9\u0627 \u0628\u0644 (\u0622\u062e\u0631\u06cc 3 \u0645\u0627\u06c1)\u060c \u0628\u06cc\u0646\u06a9/ \u067e\u0648\u0633\u0679 \u0622\u0641\u0633 \u067e\u0627\u0633 \u0628\u06a9\u060c \u06a9\u0631\u0627\u06cc\u06c1/ \u0644\u06cc\u0632/ \u0686\u06be\u0679\u06cc \u0627\u0648\u0631 \u0644\u0627\u0626\u0633\u0646\u0633 \u06a9\u0627 \u0645\u0639\u0627\u06c1\u062f\u06c1 \u0635\u0631\u0641 \u067e\u062a\u06d2 \u06a9\u06d2 \u062b\u0628\u0648\u062a \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u06a9\u0627\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4",line_4:"\u0642\u0627\u0628\u0644 \u0642\u0628\u0648\u0644 \u0634\u0646\u0627\u062e\u062a \u0627\u0648\u0631 \u067e\u062a\u06d2 \u06a9\u06d2 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u06cc \u0641\u06c1\u0631\u0633\u062a \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",line_5:"\u06cc\u06c1\u0627\u06ba"}},question_2:{title:"\u06a9\u06cc\u0633\u06d2 \u062c\u0645\u0639 \u06a9\u0631\u0627\u0626\u06cc\u06ba\u061f",content:{line_1:"\u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a myAadhaar \u067e\u0648\u0631\u0679\u0644   \u067e\u0631 \u06cc\u0627 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0646\u0679\u0631 \u067e\u0631 \u062c\u0627 \u06a9\u0631 \u0622\u0646 \u0644\u0627\u0626\u0646 \u062c\u0645\u0639 \u06a9\u0631\u0627\u0626\u06d2 \u062c\u0627 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",line_2:"\u0622\u0646 \u0644\u0627\u0626\u0646 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u0631\u062d\u0644\u06c1 \u0648\u0627\u0631 \u0637\u0631\u06cc\u0642\u06c1 \u06a9\u0627\u0631 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",line_3:" \u06cc\u06c1\u0627\u06ba"}},main_content:{submit:"\u062c\u0645\u0639 \u06a9\u0631\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",title:"\u0645\u062f\u062f \u0686\u0627\u06c1\u06cc\u06d2\u061f",videoText:"\u0648\u06cc\u0688\u06cc\u0648 \u06af\u0627\u0626\u06cc\u0688",knowMoreText:"\u0632\u06cc\u0627\u062f\u06c1 \u062c\u0627\u0646\u0648\u061f",callText:"\u0679\u0648\u0644 \u0641\u0631\u06cc \u06a9\u0627\u0644 \u06a9\u0631\u06cc\u06ba (1947)"}},one:{title:"\u0645\u06cc\u06ba \u0627\u067e\u0646\u06d2 \u0622\u062f\u06be\u0627\u0631 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0634\u0646\u0627\u062e\u062a \u0627\u0648\u0631 \u067e\u062a\u06c1 \u06a9\u06d2 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u06cc\u0648\u06ba \u062c\u0645\u0639 \u06a9\u0631\u0648\u06ba\u061f",content:"\u0622\u062f\u06be\u0627\u0631 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0634\u0646\u0627\u062e\u062a \u0627\u0648\u0631 \u067e\u062a\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u062f\u06c1 \u0645\u0639\u0627\u0648\u0646 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u0632\u0646\u062f\u06af\u06cc \u0645\u06cc\u06ba \u0622\u0633\u0627\u0646\u06cc\u060c \u0628\u06c1\u062a\u0631 \u0633\u0631\u0648\u0633 \u0688\u06cc\u0644\u06cc\u0648\u0631\u06cc \u0627\u0648\u0631 \u062f\u0631\u0633\u062a \u062a\u0635\u062f\u06cc\u0642 \u06a9\u06d2 \u0642\u0627\u0628\u0644 \u0628\u0646\u0627\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0644\u06c1\u0630\u0627\u060c \u062d\u0627\u0644\u06cc\u06c1 \u0634\u0646\u0627\u062e\u062a \u0627\u0648\u0631 \u067e\u062a\u06d2 \u06a9\u06d2 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0627\u0646\u0627 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u06a9\u06d2 \u0645\u0641\u0627\u062f \u0645\u06cc\u06ba \u06c1\u06d2\u06d4"},two:{title:"\u0645\u062c\u06be\u06d2 \u0627\u067e\u0646\u06cc \u0634\u0646\u0627\u062e\u062a \u0627\u0648\u0631 \u067e\u062a\u06c1 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0648\u0646 \u0633\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0627\u0646\u06cc \u0686\u0627\u06c1\u0626\u06cc\u06ba\u061f",content:{para_1:{heading_one:"\u0634\u0646\u0627\u062e\u062a \u0627\u0648\u0631 \u067e\u062a\u06c1 \u062f\u0648\u0646\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632:",list_1:"(a) \u0631\u0627\u0634\u0646 \u06a9\u0627\u0631\u0688",list_2:"(b) \u0648\u0648\u0679\u0631 \u0634\u0646\u0627\u062e\u062a\u06cc \u06a9\u0627\u0631\u0688",list_3:"(c) \u06a9\u0633\u0627\u0646 \u0641\u0648\u0679\u0648 \u067e\u0627\u0633 \u0628\u06a9",list_4:"(d) \u06c1\u0646\u062f\u0648\u0633\u062a\u0627\u0646\u06cc \u067e\u0627\u0633\u067e\u0648\u0631\u0679",list_5:"(e) \u062d\u06a9\u0648\u0645\u062a \u06a9\u06cc \u0637\u0631\u0641 \u0633\u06d2 \u062c\u0627\u0631\u06cc \u06a9\u0631\u062f\u06c1 \u0634\u0646\u0627\u062e\u062a\u06cc \u06a9\u0627\u0631\u0688/\u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679\u060c ST/SC/OBC \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679 \u06cc\u0627 \u0634\u0627\u062f\u06cc \u06a9\u0627 \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679\u060c \u062a\u0635\u0648\u06cc\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be",list_6:"(f) \u0645\u0639\u0630\u0648\u0631\u06cc \u06a9\u0627 \u0634\u0646\u0627\u062e\u062a\u06cc \u06a9\u0627\u0631\u0688/\u0645\u0639\u0630\u0648\u0631\u06cc \u06a9\u0627 \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679",list_7:"(g) \u0679\u0631\u0627\u0646\u0633\u062c\u06cc\u0646\u0688\u0631 \u0634\u0646\u0627\u062e\u062a\u06cc \u06a9\u0627\u0631\u0688/\u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679",list_8:"(h) \u062c\u0646\u0633\u06cc \u06a9\u0627\u0631\u06a9\u0646 \u06a9\u06d2 \u0633\u0644\u0633\u0644\u06d2 \u0645\u06cc\u06ba UIDAI \u0645\u0639\u06cc\u0627\u0631\u06cc \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679 \u0641\u0627\u0631\u0645\u06cc\u0679 \u0645\u06cc\u06ba \u062c\u0627\u0631\u06cc \u06a9\u0631\u062f\u06c1 \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679",list_9:"(i) \u062a\u0633\u0644\u06cc\u0645 \u0634\u062f\u06c1 \u0634\u06cc\u0644\u0679\u0631 \u06c1\u0648\u0645\u0632 \u06cc\u0627 \u06cc\u062a\u06cc\u0645 \u062e\u0627\u0646\u0648\u06ba \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 UIDAI \u0645\u0639\u06cc\u0627\u0631\u06cc \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679 \u0641\u0627\u0631\u0645\u06cc\u0679 \u0645\u06cc\u06ba \u062c\u0627\u0631\u06cc \u06a9\u0631\u062f\u06c1 \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679",list_10:"(j) \u062c\u06cc\u0644 \u0627\u0641\u0633\u0631 \u06a9\u06cc \u0637\u0631\u0641 \u0633\u06d2 \u062c\u0627\u0631\u06cc \u06a9\u0631\u062f\u06c1 \u0642\u06cc\u062f\u06cc \u06a9\u06cc \u0634\u0645\u0648\u0644\u06cc\u062a \u06a9\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632"},para_2:{heading_one:"\u0634\u0646\u0627\u062e\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632:",list_1:"(a) \u0633\u06a9\u0648\u0644 \u0686\u06be\u0648\u0691\u0646\u06d2 \u06a9\u0627 \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679/ \u062a\u0635\u0648\u06cc\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0633\u06a9\u0648\u0644 \u0679\u0631\u0627\u0646\u0633\u0641\u0631 \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679",list_2:"(b) \u062a\u0635\u0648\u06cc\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062a\u0633\u0644\u06cc\u0645 \u0634\u062f\u06c1 \u0628\u0648\u0631\u0688 \u0622\u0641 \u0627\u06cc\u062c\u0648\u06a9\u06cc\u0634\u0646 \u06cc\u0627 \u06cc\u0648\u0646\u06cc\u0648\u0631\u0633\u0679\u06cc \u06a9\u06cc \u0637\u0631\u0641 \u0633\u06d2 \u062c\u0627\u0631\u06cc \u06a9\u0631\u062f\u06c1 \u0645\u0627\u0631\u06a9 \u0634\u06cc\u0679/\u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679",list_3:"(c) (PAN/e-PAN) \u06a9\u0627\u0631\u0688",list_4:"(d) \u062d\u06a9\u0648\u0645\u062a/\u0642\u0627\u0646\u0648\u0646\u06cc \u0627\u062f\u0627\u0631\u06c1/PSU \u0633\u06d2 \u062c\u0627\u0631\u06cc \u06a9\u0631\u062f\u06c1 \u0645\u0644\u0627\u0632\u0645/\u067e\u0646\u0634\u0646\u0631 \u0641\u0648\u0679\u0648 \u0634\u0646\u0627\u062e\u062a\u06cc \u06a9\u0627\u0631\u0688\u060c \u067e\u0646\u0634\u0646 \u06a9\u06cc \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0627 \u0622\u0631\u0688\u0631 \u06cc\u0627 \u0645\u06cc\u0688\u06cc \u06a9\u0644\u06cc\u0645 \u06a9\u0627\u0631\u0688",list_5:"(e) \u0688\u0631\u0627\u0626\u06cc\u0648\u0646\u06af \u0644\u0627\u0626\u0633\u0646\u0633",list_6:"(f) \u0641\u0631\u06cc\u0688\u0645 \u0641\u0627\u0626\u0679\u0631 \u0641\u0648\u0679\u0648 \u0634\u0646\u0627\u062e\u062a\u06cc \u06a9\u0627\u0631\u0688"},para_3:{heading_one:"\u0627\u06cc\u0688\u0631\u06cc\u0633 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632:",list_1:"(a) \u0628\u062c\u0644\u06cc\u060c \u067e\u0627\u0646\u06cc\u060c \u06af\u06cc\u0633 \u06cc\u0627 \u0679\u06cc\u0644\u06cc \u0641\u0648\u0646/\u0645\u0648\u0628\u0627\u0626\u0644/\u0628\u0631\u0627\u0688 \u0628\u06cc\u0646\u0688 \u0628\u0644 (\u062a\u06cc\u0646 \u0645\u0627\u06c1 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u067e\u0631\u0627\u0646\u0627 \u0646\u06c1\u06cc\u06ba)",list_2:"(b) \u062a\u0635\u0648\u06cc\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0634\u06cc\u0688\u0648\u0644\u0688 \u06a9\u0645\u0631\u0634\u0644 \u0628\u06cc\u0646\u06a9/\u067e\u0648\u0633\u0679 \u0622\u0641\u0633 \u067e\u0627\u0633 \u0628\u06a9 \u067e\u0631 \u062f\u0633\u062a\u062e\u0637 \u0634\u062f\u06c1 \u0627\u0648\u0631 \u0645\u06c1\u0631 \u0644\u06af\u06cc \u06c1\u0648\u0626\u06cc \u06c1\u06d2\u06d4",list_3:"(c) \u0628\u0627\u0642\u0627\u0639\u062f\u06c1 \u062f\u0633\u062a\u062e\u0637 \u0634\u062f\u06c1 \u0627\u0648\u0631 \u0645\u06c1\u0631 \u0644\u06af\u0627 \u06c1\u0648\u0627 \u0634\u06cc\u0688\u0648\u0644 \u06a9\u0645\u0631\u0634\u0644 \u0628\u06cc\u0646\u06a9 / \u067e\u0648\u0633\u0679 \u0622\u0641\u0633 \u0627\u06a9\u0627\u0624\u0646\u0679 / \u06a9\u0631\u06cc\u0688\u0679 \u06a9\u0627\u0631\u0688 \u0627\u0633\u0679\u06cc\u0679\u0645\u0646\u0679 (\u062a\u06cc\u0646 \u0645\u0627\u06c1 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u067e\u0631\u0627\u0646\u0627 \u0646\u06c1\u06cc\u06ba)",list_4:"(d) \u062f\u0631\u0633\u062a \u06a9\u0631\u0627\u06cc\u06c1\u060c \u0644\u06cc\u0632 \u06cc\u0627 \u0686\u06be\u0679\u06cc \u0627\u0648\u0631 \u0644\u0627\u0626\u0633\u0646\u0633 \u06a9\u0627 \u0645\u0639\u0627\u06c1\u062f\u06c1",list_5:"(e) \u0627\u06cc\u0645 \u067e\u06cc\u060c \u0627\u06cc\u0645 \u0627\u06cc\u0644 \u0627\u06d2\u060c \u0627\u06cc\u0645 \u0627\u06cc\u0644 \u0633\u06cc\u060c \u0645\u06cc\u0648\u0646\u0633\u067e\u0644 \u06a9\u0648\u0646\u0633\u0644\u0631\u060c \u06af\u0631\u0648\u067e '\u0627\u06d2' \u06cc\u0627 '\u0628\u06cc' \u06af\u0632\u06cc\u0679\u06cc\u0688 \u0622\u0641\u06cc\u0633\u0631\u060c \u0627\u06cc \u067e\u06cc \u0627\u06cc\u0641 \u0627\u0648 \u0622\u0641\u06cc\u0633\u0631 \u06cc\u0627 \u062a\u062d\u0635\u06cc\u0644\u062f\u0627\u0631 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 UIDAI \u0645\u0639\u06cc\u0627\u0631\u06cc \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679 \u0641\u0627\u0631\u0645\u06cc\u0679 \u0645\u06cc\u06ba \u062c\u0627\u0631\u06cc \u06a9\u0631\u062f\u06c1 \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679",list_6:"(f) \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u0645\u0639\u06cc\u0627\u0631\u06cc \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679 \u0641\u0627\u0631\u0645\u06cc\u0679 \u0645\u06cc\u06ba \u0648\u0644\u06cc\u062c \u067e\u0646\u0686\u0627\u06cc\u062a \u06a9\u06d2 \u0633\u0631\u0628\u0631\u0627\u06c1/ \u0633\u06a9\u0631\u06cc\u0679\u0631\u06cc\u060c \u0648\u0644\u06cc\u062c \u0631\u06cc\u0648\u0646\u06cc\u0648 \u0622\u0641\u06cc\u0633\u0631 \u06cc\u0627 \u0627\u0633 \u06a9\u06d2 \u0645\u0633\u0627\u0648\u06cc (\u062f\u06cc\u06c1\u06cc \u0639\u0644\u0627\u0642\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2) \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 \u062c\u0627\u0631\u06cc \u06a9\u0631\u062f\u06c1 \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679",list_7:"(g) \u0645\u062a\u0639\u0644\u0642\u06c1 \u062a\u0633\u0644\u06cc\u0645 \u0634\u062f\u06c1 \u062a\u0639\u0644\u06cc\u0645\u06cc \u0627\u062f\u0627\u0631\u06d2 \u06a9\u06d2 \u0633\u0631\u0628\u0631\u0627\u06c1 \u06a9\u06cc \u0637\u0631\u0641 \u0633\u06d2 UIDAI \u0645\u0639\u06cc\u0627\u0631\u06cc \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679 \u0641\u0627\u0631\u0645\u06cc\u0679 \u0645\u06cc\u06ba \u0637\u0627\u0644\u0628 \u0639\u0644\u0645 \u06a9\u0648 \u062c\u0627\u0631\u06cc \u06a9\u0631\u062f\u06c1 \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679",list_8:"(h) \u067e\u0631\u0627\u067e\u0631\u0679\u06cc \u0679\u06cc\u06a9\u0633 \u06a9\u06cc \u0631\u0633\u06cc\u062f (\u0627\u06cc\u06a9 \u0633\u0627\u0644 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u067e\u0631\u0627\u0646\u06cc \u0646\u06c1\u06cc\u06ba)",list_9:"(i) \u062f\u0631\u0633\u062a \u0631\u062c\u0633\u0679\u0631\u0688 \u0633\u06cc\u0644 \u0627\u06cc\u06af\u0631\u06cc\u0645\u0646\u0679 \u06cc\u0627 \u06af\u0641\u0679 \u0688\u06cc\u0688",list_10:"(j) \u062d\u06a9\u0648\u0645\u062a/\u0642\u0627\u0646\u0648\u0646\u06cc \u0627\u062f\u0627\u0631\u06c1/PSU \u06a9\u06cc \u0637\u0631\u0641 \u0633\u06d2 \u062c\u0627\u0631\u06cc \u06a9\u0631\u062f\u06c1 \u0631\u06c1\u0627\u0626\u0634 \u06a9\u0627 \u0627\u0644\u0627\u0679\u0645\u0646\u0679 \u0644\u06cc\u0679\u0631 (\u0627\u06cc\u06a9 \u0633\u0627\u0644 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u067e\u0631\u0627\u0646\u0627 \u0646\u06c1\u06cc\u06ba)",list_11:"(k) \u0644\u0627\u0626\u0641 \u06cc\u0627 \u0645\u06cc\u0688\u06cc\u06a9\u0644 \u0627\u0646\u0634\u0648\u0631\u0646\u0633 \u067e\u0627\u0644\u06cc\u0633\u06cc (\u0627\u06cc\u06a9 \u0633\u0627\u0644 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u067e\u0631\u0627\u0646\u06cc \u0646\u06c1\u06cc\u06ba)"}}},three:{title:"\u0645\u06cc\u06ba \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u06cc\u0633\u06d2 \u062c\u0645\u0639 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",content:"\u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u0648 myAadhaar \u067e\u0648\u0631\u0679\u0644 https://myaadhaar.uidai.gov.in/ \u06cc\u0627 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0622\u062f\u06be\u0627\u0631 \u0645\u0631\u06a9\u0632 \u067e\u0631 \u0622\u0646 \u0644\u0627\u0626\u0646 \u062c\u0645\u0639 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4"},four:{title:"\u0645\u06cc\u06ba \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u0622\u0646 \u0644\u0627\u0626\u0646 \u06a9\u06cc\u0633\u06d2 \u062c\u0645\u0639 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",content:{list_1:"(1) \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba\u060c \u0627\u0648\u0631 \u0627\u067e\u0646\u06d2 \u0631\u062c\u0633\u0679\u0631\u0688 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u067e\u0631 \u0645\u0648\u0635\u0648\u0644 \u06c1\u0648\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0627\u067e\u0646\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0627\u0648\u0631 \u0648\u0646 \u0679\u0627\u0626\u0645 \u067e\u0627\u0633 \u0648\u0631\u0688 (OTP) \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2 \u0644\u0627\u06af \u0627\u0646 \u06a9\u0631\u06cc\u06ba\u06d4 https://myaadhaar.uidai.gov.in/",list_2:"(2) \u0627\u067e\u0646\u06d2 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u0645\u06cc\u06ba \u062f\u06a9\u06be\u0627\u0626\u06d2 \u06af\u0626\u06d2 \u0627\u067e\u0646\u06cc \u0634\u0646\u0627\u062e\u062a \u0627\u0648\u0631 \u067e\u062a\u06d2 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",list_3:"(3) \u0627\u06af\u0631 \u0622\u067e \u06a9\u06d2 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u0645\u06cc\u06ba \u062f\u06a9\u06be\u0627\u0626\u06cc \u06af\u0626\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u063a\u0644\u0637 \u06c1\u06cc\u06ba \u062a\u0648\u060c \u0630\u06cc\u0644 \u0645\u06cc\u06ba \u0633\u0648\u0627\u0644 5 \u06a9\u06d2 \u062c\u0648\u0627\u0628 \u0645\u06cc\u06ba \u0628\u06cc\u0627\u0646 \u06a9\u0631\u062f\u06c1 \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u06a9\u0627\u0631\u0631\u0648\u0627\u0626\u06cc \u06a9\u0631\u06cc\u06ba\u06d4",list_4:"(4) \u0627\u06af\u0631 \u0622\u067e \u06a9\u06d2 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u0645\u06cc\u06ba \u062f\u06a9\u06be\u0627\u0626\u06cc \u06af\u0626\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u062f\u0631\u0633\u062a \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0679\u06cc\u0628 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba '\u0645\u06cc\u06ba \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u062a\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u0627\u0648\u067e\u0631 \u062f\u06cc \u06af\u0626\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u062f\u0631\u0633\u062a \u06c1\u06cc\u06ba'\u06d4",list_5:"(5) \u0688\u0631\u0627\u067e \u0688\u0627\u0624\u0646 \u0645\u06cc\u0646\u0648 \u0633\u06d2 \u0634\u0646\u0627\u062e\u062a\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u06cc\u06ba \u062c\u0633\u06d2 \u0622\u067e \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",list_6:"(6) \u0627\u067e\u0646\u06cc \u0634\u0646\u0627\u062e\u062a\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba (\u0633\u0627\u0626\u0632 2 MB \u0633\u06d2 \u06a9\u0645\u061b \u0641\u0627\u0626\u0644 \u0641\u0627\u0631\u0645\u06cc\u0679 JPEG\u060c PNG \u06cc\u0627 PDF)",list_7:"(7) \u0688\u0631\u0627\u067e \u0688\u0627\u0624\u0646 \u0645\u06cc\u0646\u0648 \u0633\u06d2 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u06a9\u0627 \u0648\u06c1 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba \u062c\u0633\u06d2 \u0622\u067e \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",list_8:"(8) \u0627\u067e\u0646\u0627 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba (\u0633\u0627\u0626\u0632 2 MB \u0633\u06d2 \u06a9\u0645\u061b \u0641\u0627\u0626\u0644 \u0641\u0627\u0631\u0645\u06cc\u0679 JPEG\u060c PNG \u06cc\u0627 PDF)\u06d4",list_9:"(9) \u0627\u067e\u0646\u06cc \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0626\u06cc\u06ba\u06d4"}},five:{title:"\u0627\u06af\u0631 \u0645\u06cc\u0631\u06d2 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u0645\u06cc\u06ba \u062f\u06a9\u06be\u0627\u06cc\u0627 \u06af\u06cc\u0627 \u067e\u062a\u06c1 \u0645\u06cc\u0631\u06d2 \u0645\u0648\u062c\u0648\u062f\u06c1 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0633\u06d2 \u0645\u06cc\u0644 \u0646\u06c1\u06cc\u06ba \u06a9\u06be\u0627\u062a\u0627\u060c \u062a\u0648 \u0645\u062c\u06be\u06d2 \u06a9\u06cc\u0627 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2\u061f",content:{list_1:"(1) \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 '\u0627\u06af\u0631 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0645\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u0645\u0645\u0627\u062b\u0644\u062a \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u062a\u0648 \u06cc\u06c1\u0627\u06ba \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba'\u060c '\u0645\u06cc\u06ba \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u062a\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u0627\u0648\u067e\u0631 \u062f\u06cc \u06af\u0626\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u062f\u0631\u0633\u062a \u06c1\u06cc\u06ba' \u0679\u06cc\u0628 \u06a9\u06d2 \u0646\u06cc\u0686\u06d2 \u062f\u06cc\u06d2 \u06af\u0626\u06d2 \u0644\u0646\u06a9 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",list_2:"(2) \u062f\u06a9\u06be\u0627\u0626\u06d2 \u06af\u0626\u06d2 \u0641\u0627\u0631\u0645 \u0645\u06cc\u06ba \u067e\u062a\u06d2 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u067e\u064f\u0631 \u06a9\u0631\u06cc\u06ba\u06d4",list_3:"(3) \u0688\u0631\u0627\u067e \u0688\u0627\u0624\u0646 \u0645\u06cc\u0646\u0648 \u0633\u06d2 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u06a9\u0627 \u0648\u06c1 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba \u062c\u0633\u06d2 \u0622\u067e \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",list_4:"(4) \u0627\u067e\u0646\u0627 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba (\u0633\u0627\u0626\u0632 2 MB \u0633\u06d2 \u06a9\u0645\u061b \u0641\u0627\u0626\u0644 \u0641\u0627\u0631\u0645\u06cc\u0679 JPEG\u060c PNG \u06cc\u0627 PDF)\u06d4",list_5:"(5) \u0636\u0631\u0648\u0631\u06cc \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0631\u06cc\u06ba\u06d4",list_6:"(6) \u0627\u067e\u0646\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0626\u06cc\u06ba\u06d4"}},six:{title:"\u0627\u06af\u0631 \u06a9\u0648\u0626\u06cc \u0634\u0646\u0627\u062e\u062a\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a (\u0646\u0627\u0645\u060c \u062c\u0646\u0633 \u06cc\u0627 \u062a\u0627\u0631\u06cc\u062e \u067e\u06cc\u062f\u0627\u0626\u0634) \u0645\u06cc\u0631\u06cc \u0627\u0635\u0644 \u0634\u0646\u0627\u062e\u062a \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0633\u06d2 \u0645\u06cc\u0644 \u0646\u06c1\u06cc\u06ba \u06a9\u06be\u0627\u062a\u06cc\u060c \u062a\u0648 \u0645\u062c\u06be\u06d2 \u06a9\u06cc\u0627 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2\u061f",content:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u0635\u0644 \u0634\u0646\u0627\u062e\u062a\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0622\u062f\u06be\u0627\u0631 \u0633\u0646\u0679\u0631 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba \u062c\u06cc\u0633\u0627 \u06a9\u06c1 https://uidai.gov.in/images/commdoc/List_of_Supporting_Document_for_Aadhaar_Enrolment_and_Update.pdf \u067e\u0631 \u062f\u0631\u062c \u06c1\u06d2\u06d4"},seven:{title:"\u0627\u06af\u0631 \u0645\u06cc\u06ba \u0622\u0641 \u0644\u0627\u0626\u0646 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0646\u0627 \u0686\u0627\u06c1\u062a\u0627 \u06c1\u0648\u06ba\u060c \u062a\u0648 \u0645\u06cc\u06ba \u0622\u062f\u06be\u0627\u0631 \u0645\u0631\u06a9\u0632 \u06a9\u0648 \u06a9\u06cc\u0633\u06d2 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",content:{list_1:"(1) \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 https://bhuvan.nrsc.gov.in/aadhaar/ \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba",list_2:"(2) \u0642\u0631\u06cc\u0628\u06cc \u0622\u062f\u06be\u0627\u0631 \u0645\u0631\u0627\u06a9\u0632 \u06a9\u0627 \u067e\u062a\u06c1 \u0644\u06af\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u2019\u0633\u0646\u0679\u0631\u0633 \u0646\u06cc\u0626\u0631 \u0628\u0627\u0626\u06cc\u2018 \u0679\u06cc\u0628 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 \u0642\u0631\u06cc\u0628\u06cc \u0622\u062f\u06be\u0627\u0631 \u0645\u0631\u0627\u06a9\u0632 \u06a9\u0648 \u062f\u06cc\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u067e\u0646\u06d2 \u0645\u0642\u0627\u0645 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4",list_3:"(3) \u0627\u067e\u0646\u06d2 PIN \u06a9\u0648\u0688 \u06a9\u06d2 \u0639\u0644\u0627\u0642\u06d2 \u0645\u06cc\u06ba \u0622\u062f\u06be\u0627\u0631 \u0645\u0631\u0627\u06a9\u0632 \u06a9\u0627 \u067e\u062a\u06c1 \u0644\u06af\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c 'Search by PIN Code' \u0679\u06cc\u0628 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 \u0627\u0633 \u0639\u0644\u0627\u0642\u06d2 \u0645\u06cc\u06ba \u0622\u062f\u06be\u0627\u0631 \u0645\u0631\u0627\u06a9\u0632 \u06a9\u0648 \u062f\u06cc\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u067e\u0646\u06d2 \u0639\u0644\u0627\u0642\u06d2 \u06a9\u0627 \u067e\u0646 \u06a9\u0648\u0688 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4"}},eight:{title:"\u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0627\u0646\u06d2 \u06a9\u0627 \u06a9\u06cc\u0627 \u0686\u0627\u0631\u062c \u06c1\u06d2\u061f",content:"myAadhaar \u067e\u0648\u0631\u0679\u0644 \u067e\u0631 14 \u0633\u062a\u0645\u0628\u0631 2023 \u062a\u06a9 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0646\u0627 \u0645\u0641\u062a \u06c1\u06d2\u06d4 \u0622\u062f\u06be\u0627\u0631 \u0633\u0646\u0679\u0631 \u067e\u0631 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0644\u0627\u06af\u0648 \u0686\u0627\u0631\u062c \u0631\u0648\u067e\u06d250 \u06c1\u06d2\u06d4"},nine:{title:"\u0645\u06cc\u06ba \u06a9\u0628 \u062a\u06a9 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0627\u0624\u06ba\u061f",content:"\u0631\u06c1\u0646 \u0633\u06c1\u0646 \u0645\u06cc\u06ba \u0622\u0633\u0627\u0646\u06cc\u060c \u0628\u06c1\u062a\u0631 \u0633\u0631\u0648\u0633 \u0688\u06cc\u0644\u06cc\u0648\u0631\u06cc \u0627\u0648\u0631 \u062f\u0631\u0633\u062a \u062a\u0635\u062f\u06cc\u0642 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u0627 \u0636\u0631\u0648\u0631\u06cc \u06c1\u06d2\u06d4 \u0644\u06c1\u0630\u0627\u060c \u06cc\u06c1 \u0622\u067e \u06a9\u06d2 \u0645\u0641\u0627\u062f \u0645\u06cc\u06ba \u06c1\u06d2 \u06a9\u06c1 \u062c\u0644\u062f \u0627\u0632 \u062c\u0644\u062f \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0627\u0626\u06cc\u06ba\u06d4"},ten:{title:"\u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u063a\u06cc\u0631 \u0645\u0642\u06cc\u0645 \u06c1\u0646\u062f\u0648\u0633\u062a\u0627\u0646\u06cc (NRI) \u06c1\u0648\u06ba\u06d4 \u0645\u06cc\u06ba \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u06a9\u06cc\u0633\u06d2 \u062c\u0645\u0639 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u0648\u06ba\u061f",content:"\u062c\u0628 \u0628\u06be\u06cc \u0622\u067e \u06c1\u0646\u062f\u0648\u0633\u062a\u0627\u0646 \u0645\u06cc\u06ba \u06c1\u0648\u06ba \u0622\u067e \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0627 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"}}},aadharUpdateHistory:{title1:"\u0627\u067e\u0646\u06cc \u0622\u062f\u06be\u0627\u0631 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",label1:"\u0631\u06cc\u06a9\u0627\u0631\u0688",label2:"\u0627\u0646\u062f\u0631\u0627\u062c/\u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e",label3:"URN/EID ",label4:"\u0642\u0633\u0645",list1:"\u0646\u0627\u0645",list2:"\u0645\u0648\u0628\u0627\u0626\u0644",list3:"\u0627\u06cc \u0645\u06cc\u0644",list4:"\u067e\u06cc\u062f\u0627\u0626\u0634 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e",list5:"\u0635\u0646\u0641",list6:"\u067e\u062a\u06c1"},ssup:{howItWorks:{title:"\u06cc\u06c1 \u06a9\u06cc\u0633\u06d2 \u06a9\u0627\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2",description:"\u0622\u0646 \u0644\u0627\u0626\u0646 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06d2 \u0639\u0645\u0644 \u06a9\u0648 \u0633\u0645\u062c\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u062f\u0631\u062c \u0630\u06cc\u0644  \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u067e\u0691\u06be\u06cc\u06ba\u06d4 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u067e\u0631 \u06a9\u0627\u0631\u0631\u0648\u0627\u0626\u06cc \u06cc\u0627 \u062a\u0627\u062e\u06cc\u0631 \u0645\u06cc\u06ba \u062a\u0627\u062e\u06cc\u0631 \u0633\u06d2 \u0628\u0686\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u0645\u062e\u062a\u0644\u0641 \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u067e\u0631 \u062a\u062c\u0648\u06cc\u0632 \u06a9\u0631\u062f\u06c1 \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u067e\u0631 \u0639\u0645\u0644 \u06a9\u0631\u06cc\u06ba",proceedToUpdateAadhaar:"\u0622\u062f\u06be\u0627\u0631 \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u0622\u06af\u06d2 \u0628\u0691\u06be\u06cc\u06ba",stepDescription:{one:"\u0641\u06c1\u0631\u0633\u062a \u0633\u06d2 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0641\u06cc\u0644\u0688 \u06a9\u0648 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4 \u0627\u0633 \u0622\u0646 \u0644\u0627\u0626\u0646 \u067e\u0648\u0631\u0679\u0644 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2\u060c \u0622\u067e \u0627\u06cc\u0688\u0631\u06cc\u0633 \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0646\u0627\u0645\u060c \u062c\u0646\u0633\u060c DOB\u060c \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631\u060c \u0627\u06cc \u0645\u06cc\u0644 \u0627\u0648\u0631 \u0628\u0627\u0626\u06cc\u0648 \u0645\u06cc\u0679\u0631\u06a9\u0633 \u0688\u06cc\u0679\u0627 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0642\u0631\u06cc\u0628\u06cc \u0622\u062f\u06be\u0627\u0631 \u0633\u06cc\u0648\u0627 \u06a9\u06cc\u0646\u062f\u0631 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba\u06d4",two:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0645\u0637\u0644\u0648\u0628\u06c1 \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u0688\u06cc\u0679\u0627 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4 \u06a9\u0686\u06be \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u0627\u0639\u062f\u0627\u062f \u0648 \u0634\u0645\u0627\u0631 \u06a9\u06d2 \u0644\u0626\u06d2 \u0688\u0631\u0627\u067e \u0688\u0627\u0624\u0646 \u0641\u06c1\u0631\u0633\u062a \u0645\u06cc\u06ba \u0633\u06d2 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u0648\u062a\u06cc \u06c1\u06d2\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u0627\u0639\u062f\u0627\u062f \u0648 \u0634\u0645\u0627\u0631 \u0645\u06cc\u06ba \u062f\u0627\u062e\u0644 \u06c1\u0648\u0646\u06d2 \u06cc\u0627 \u0688\u0631\u0627\u067e \u0688\u0627\u0624\u0646 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u0645\u06cc\u06ba \u0633\u06d2 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u062a\u06d2 \u0648\u0642\u062a \u0645\u062d\u062a\u0627\u0637 \u0631\u06c1\u06cc\u06ba\u06d4",three:"\u0627\u06cc\u0688\u0631\u06cc\u0633 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0635\u0644 \u0645\u0639\u0627\u0648\u0646 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u06cc \u0627\u0633\u06a9\u06cc\u0646 \u0634\u062f\u06c1 \u06a9\u0627\u067e\u06cc \u062f\u0631\u06a9\u0627\u0631 \u06c1\u06d2\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u06cc\u0642\u06cc\u0646\u06cc \u0628\u0646\u0627\u0626\u06cc\u06ba \u06a9\u06c1 \u0645\u0639\u0627\u0648\u0646 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0622\u067e \u06a9\u06d2 \u0646\u0627\u0645 \u067e\u0631 \u06c1\u06d2 \u0627\u0648\u0631 \u062f\u0631\u0633\u062a \u06c1\u06d2\u06d4 \u0627\u06af\u0631 \u0622\u067e UIDAI \u06a9\u06d2 \u0645\u0639\u06cc\u0627\u0631\u06cc \u0641\u0627\u0631\u0645\u06cc\u0679 \u0645\u06cc\u06ba \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0639\u0627\u0645 \u063a\u0644\u0637\u06cc\u0648\u06ba \u06a9\u0648 \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba \u062c\u06cc\u0633\u06d2 \u06a9\u06c1 \u062c\u0627\u0631\u06cc \u06c1\u0648\u0646\u06d2 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e\u060c \u06a9\u0631\u0627\u0633 \u0634\u062f\u06c1 \u0646\u0634\u0627\u0646\u060c \u062a\u0635\u0648\u06cc\u0631 \u067e\u0631 \u0645\u06c1\u0631 \u0627\u0648\u0631 \u06a9\u0648\u0626\u06cc \u0627\u0648\u0648\u0631 \u0631\u0627\u0626\u0679\u0646\u06af \u0646\u06c1\u06cc\u06ba \u062a\u0627\u06a9\u06c1 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0648 \u0645\u0633\u062a\u0631\u062f \u0646\u06c1 \u06a9\u06cc\u0627 \u062c\u0627\u0626\u06d2\u06d4",four:"\u0622\u0646 \u0644\u0627\u0626\u0646 \u0627\u067e \u0688\u06cc\u0679 \u0641\u06cc\u0633 \u06a9\u06d2 \u0644  \u06a9\u06cc \u0637\u0631\u0641  \u0622\u067e \u06a9\u0648 \u20b9 50 (\u0635\u0631\u0641 \u067e\u0686\u0627\u0633 \u0631\u0648\u067e\u06d2) \u0627\u062f\u0627 \u06a9\u0631\u0646\u0627 \u06c1\u0648\u06ba \u06af\u06d2\u06d4 \u0622\u067e \u06a9\u0631\u06cc\u0688\u0679 / \u0688\u06cc\u0628\u0679 \u06a9\u0627\u0631\u0688 \u06cc\u0627 \u0646\u06cc\u0679 \u0628\u06cc\u0646\u06a9\u0627\u0631\u06cc \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0631\u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0631\u0642\u0645 \u0646\u0627\u0642\u0627\u0628\u0644 \u0648\u0627\u067e\u0633\u06cc \u06c1\u06d2\u06d4 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06cc \u0635\u0648\u0631\u062a \u0645\u06cc\u06ba \u060c \u0622\u067e \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u067e\u0631 \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0648\u0634\u0634 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",five:"\u0622\u067e \u0628\u0637\u0648\u0631 \u062d\u0648\u0627\u0644\u06c1 \u062e\u062f\u0645\u062a \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0646\u0645\u0628\u0631 (SRN) \u062d\u0627\u0635\u0644 \u06a9\u0631\u06cc\u06ba \u06af\u06d2\u06d4 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0627 \u067e\u062a\u06c1 \u0644\u06af\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u06cc\u0627  \u06cc\u0648\u0688\u0627\u0626\u06cc  \u06c1\u06cc\u0644\u067e \u0688\u06cc\u0633\u06a9 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0622\u0626\u0646\u062f\u06c1 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0645\u0648\u0627\u0635\u0644\u062a \u06a9\u06d2 \u0644 \u06a9\u06d2 \u0644\u0626\u06d2 \u0627\u0633 \u0646\u0645\u0628\u0631 \u06a9\u0648 \u0645\u062d\u0641\u0648\u0638 \u0631\u06a9\u06be\u06cc\u06ba\u06d4",six:"\u0622\u067e \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06cc \u062a\u0635\u062f\u06cc\u0642 \u06c1\u0645\u0627\u0631\u06d2 \u062f\u0627\u062e\u0644\u06cc \u06a9\u0648\u0627\u0644\u0679\u06cc \u0686\u06cc\u06a9 \u0622\u067e\u0631\u06cc\u0679\u0631\u0632 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 \u06c1\u0648\u06af\u06cc\u06d4 \u0627\u0633 \u0645\u0631\u062d\u0644\u06d2 \u067e\u0631 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062f\u06c1 \u0688\u06cc\u0645\u0648\u06af\u0631\u0627\u0641\u06a9\u0633 \u0688\u06cc\u0679\u0627 \u06a9\u0648 \u0645\u0639\u0627\u0648\u0646 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u06d2 \u062e\u0644\u0627\u0641 \u0686\u06cc\u06a9 \u06a9\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u0627\u06af\u0631 \u06a9\u0648\u0626\u06cc \u0645\u0645\u0627\u062b\u0644\u062a \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u062a\u0648 \u060c \u0622\u067e \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0645\u0633\u062a\u0631\u062f \u06c1\u0648\u0646\u06d2 \u06a9\u0627 \u0627\u0645\u06a9\u0627\u0646 \u06c1\u06d2\u06d4",seven:"\u06a9\u0648\u0627\u0644\u0679\u06cc \u0686\u06cc\u06a9 \u067e\u0631\u0648\u0633\u06cc\u0633 \u06a9\u06cc \u062a\u06a9\u0645\u06cc\u0644 \u067e\u0631 \u060c \u0622\u067e \u06a9\u0648 \u0627\u06cc\u0633 \u0627\u06cc\u0645 \u0627\u06cc\u0633 \u06a9\u0627 \u0646\u0648\u0679\u06cc\u0641\u06cc\u06a9\u06cc\u0634\u0646 \u0645\u0644\u06d2 \u06af\u0627 \u062c\u0633 \u0645\u06cc\u06ba \u0627\u0646\u062f\u0631\u0627\u062c \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0627 \u0646\u062a\u06cc\u062c\u06c1 \u06c1\u0648\u06af\u0627\u06d4",eight:"\u06c1\u0645\u0627\u0631\u06d2 \u067e\u0633\u062f\u06cc\u062f \u0633\u0627\u0641\u0679 \u0648\u06cc\u0626\u0631 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 \u06a9\u0686\u06be \u0627\u0648\u0631 \u062a\u0648\u062b\u06cc\u0642 \u06a9\u06d2 \u0628\u0639\u062f \u060c \u0622\u067e \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u067e\u0631 \u06a9\u0627\u0631\u0631\u0648\u0627\u0626\u06cc \u0645\u06a9\u0645\u0644 \u06c1\u0648\u062c\u0627\u0626\u06d2 \u06af\u06cc\u06d4 \u0646\u062a\u0627\u0626\u062c \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0627\u06cc\u06a9 \u0627\u06cc\u0633 \u0627\u06cc\u0645 \u0627\u06cc\u0633 \u0627\u0637\u0644\u0627\u0639 \u0645\u0644\u06d2 \u06af\u06cc\u06d4",nine:"\u0639\u0627\u0645 \u0637\u0648\u0631 \u067e\u0631 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a 30 \u062f\u0646\u0648\u06ba \u06a9\u06d2 \u0627\u0646\u062f\u0631 90% \u0633\u0631\u0648\u0633 \u06a9\u06d2 \u0645\u0639\u06cc\u0627\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0645\u06a9\u0645\u0644 \u06c1\u0648 \u062c\u0627\u062a\u06cc \u06c1\u06d2\u06d4 \u062a\u0627\u06c1\u0645\u060c \u06c1\u0645 \u0627\u067e\u0646\u06d2 \u0633\u0633\u0679\u0645\u0632 \u06a9\u0648 \u0628\u06c1\u062a\u0631 \u06a9\u0631 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0632\u06cc\u0627\u062f\u06c1 \u062a\u0631 \u0627\u0645\u06a9\u0627\u0646 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0648 \u0645\u062a\u0630\u06a9\u0631\u06c1 \u0648\u0642\u062a \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631 \u062f\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u0622\u067e myaadhaar.uidai.gov.in \u067e\u0631 \u062c\u0627 \u06a9\u0631 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06cc \u067e\u0631\u0648\u0633\u06cc\u0633\u0646\u06af \u06a9\u06cc \u062d\u0627\u0644\u062a \u062f\u06cc\u06a9\u06be \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"}},updateSelectPage:{title:"\u0622\u062f\u06be\u0627\u0631 \u0622\u0646 \u0644\u0627\u0626\u0646 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u06cc\u06ba",selectFields:{smallDescription:"\u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc\u0644\u0626\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0688\u06cc\u0679\u0627 \u0641\u06cc\u0644\u0688 (\u0646) \u06a9\u0648 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba",longDescription:"\u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u062f\u0631\u062c \u0630\u06cc\u0644 \u0622\u062f\u06be\u0627\u0631 \u0688\u06cc\u0679\u0627 \u0641\u06cc\u0644\u0688 \u0645\u06cc\u06ba \u0633\u06d2 \u06a9\u0633\u06cc \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u06cc\u06ba",updatesLeft:" \u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646 \u0645\u0639\u0644\u0648\u0645\u0627\u062a",noLimit:"\u06a9\u0648\u0626\u06cc \u062d\u062f \u0646\u06c1\u06cc\u06ba",demoGraphics:{language:"\u0632\u0628\u0627\u0646",name:"\u0646\u0627\u0645",dob:"\u0688\u06cc \u0627\u0648 \u0628\u06cc",gender:"\u0635\u0646\u0641",hof:"\u062e\u0627\u0646\u062f\u0627\u0646 \u06a9\u06d2 \u0633\u0631\u0628\u0631\u0627\u06c1 (HOF) \u067e\u0631 \u0645\u0628\u0646\u06cc \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0627\u067e \u0688\u06cc\u0679",address:"\u067e\u062a\u06c1"}},documentDescriptionLinkText:"\u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc\u0644\u0626\u06d2 \u067e\u06cc \u0627\u0648 \u0622\u0626\u06cc / \u067e\u06cc \u0627\u0648 \u0627\u06d2 / \u067e\u06cc \u0627\u0648 \u0628\u06cc \u0633\u06d2 \u0645\u062a\u0639\u0644\u0642 \u0645\u0637\u0644\u0648\u0628\u06c1 \u062f\u0631\u0633\u062a \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062f\u06cc\u06a9\u06be\u06cc\u06ba",proceedToUpdateAadhaar:"\u0622\u062f\u06be\u0627\u0631 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u0622\u06af\u06d2 \u0628\u0691\u06be\u06cc\u06ba",faq:"\u0627\u06a9\u062b\u0631 \u067e\u0648\u0686\u06be\u06d2 \u062c\u0627\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0633\u0648\u0627\u0644\u0627\u062a"},dashboard:"\u0688\u06cc\u0634 \u0628\u0648\u0631\u0688 \u067e",hof:{title:"\u062e\u0627\u0646\u062f\u0627\u0646 \u06a9\u06d2 \u0633\u0631\u0628\u0631\u0627\u06c1 (HOF) \u067e\u0631 \u0645\u0628\u0646\u06cc \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0627\u067e \u0688\u06cc\u0679",description:"\u06c1\u06cc\u0688 \u0622\u0641 \u0641\u06cc\u0645\u0644\u06cc \u0628\u06cc\u0633\u0688 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0622\u06af\u06d2 \u0628\u0691\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06cc\u06c1\u0627\u06ba \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",howItWorks:{step1:"\u0622\u062f\u06be\u0627\u0631 \u0688\u06cc\u0679\u0627 \u0628\u06cc\u0633 \u0633\u06d2 \u067e\u062a\u06c1 \u062d\u0627\u0635\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u067e\u0646\u06d2 \u062e\u0627\u0646\u062f\u0627\u0646 \u06a9\u06d2 \u0633\u0631\u0628\u0631\u0627\u06c1 \u06a9\u0627 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4 \u0635\u0631\u0641 18 \u0633\u0627\u0644 \u06cc\u0627 \u0627\u0633 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u0639\u0645\u0631 \u06a9\u06d2 \u0631\u06c1\u0627\u0626\u0634\u06cc\u0648\u06ba \u06a9\u0648 \u06c1\u06cc HoF \u0633\u0645\u062c\u06be\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4",step2:'\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0631\u0634\u062a\u06c1 \u06a9\u0627 \u062b\u0628\u0648\u062a (PoR) \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba \u062c\u0633 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0627 \u0646\u0627\u0645 \u0627\u0648\u0631 \u0622\u067e \u06a9\u06d2 \u062e\u0627\u0646\u062f\u0627\u0646 \u06a9\u06d2 \u0633\u0631\u0628\u0631\u0627\u06c1 \u06a9\u0627 \u0646\u0627\u0645 \u0648\u0627\u0636\u062d \u0637\u0648\u0631 \u067e\u0631 \u062f\u0631\u062c \u06c1\u0648\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u067e\u0646\u06d2 \u0633\u0627\u062a\u06be HoF \u06a9\u0627 \u0631\u0634\u062a\u06c1 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u060c \u0645\u062b\u0627\u0644 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u0627\u06af\u0631 HoF \u0622\u067e \u06a9\u0627 \u0634\u0648\u06c1\u0631 \u06c1\u06d2\u060c \u062a\u0648 "\u0634\u0648\u06c1\u0631" \u06a9\u0648 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4',step3:"\u0622\u067e \u06a9\u0648 \u0622\u0646 \u0644\u0627\u0626\u0646 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u0641\u06cc\u0633 \u06a9\u06d2 \u0644\u06cc\u06d2 \u20b9 50 (\u0635\u0631\u0641 \u067e\u0686\u0627\u0633 \u0631\u0648\u067e\u06d2) \u0627\u062f\u0627 \u06a9\u0631\u0646\u06d2 \u06c1\u0648\u06ba \u06af\u06d2\u06d4 \u0622\u067e \u06a9\u0631\u06cc\u0688\u0679/\u0688\u06cc\u0628\u0679 \u06a9\u0627\u0631\u0688 \u06cc\u0627 \u0646\u06cc\u0679 \u0628\u06cc\u0646\u06a9\u0646\u06af \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0631\u0642\u0645 \u0646\u0627\u0642\u0627\u0628\u0644 \u0648\u0627\u067e\u0633\u06cc \u06c1\u06d2\u06d4",step4:"\u062c\u0628 \u0622\u067e \u06a9\u06d2 \u062e\u0627\u0646\u062f\u0627\u0646 \u06a9\u06d2 \u0633\u0631\u0628\u0631\u0627\u06c1 \u0627\u067e\u0646\u06d2 myAadhaar \u067e\u0648\u0631\u0679\u0644 \u067e\u0631 \u0644\u0627\u06af \u0627\u0646 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u0627\u0646\u06c1\u06cc\u06ba \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0634\u06cc\u0626\u0631\u0646\u06af \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0645\u0648\u0635\u0648\u0644 \u06c1\u0648\u06af\u06cc\u060c \u062c\u0633\u06d2 \u0648\u06c1 \u0642\u0628\u0648\u0644 \u06cc\u0627 \u0627\u0646\u06a9\u0627\u0631 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 HoF \u06a9\u06cc \u0637\u0631\u0641 \u0633\u06d2 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0648 \u0642\u0628\u0648\u0644 \u06a9\u0631\u0646\u06d2 / \u0645\u0633\u062a\u0631\u062f \u06a9\u0631\u0646\u06d2 \u06a9\u0627 \u06cc\u06c1 \u0627\u062e\u062a\u06cc\u0627\u0631 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06cc \u062a\u062e\u0644\u06cc\u0642 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e \u0633\u06d2 30 \u062f\u0646\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0627\u0631\u0622\u0645\u062f \u06c1\u0648\u06af\u0627\u06d4"},currentSection:{title:"\u0627\u067e \u0688\u06cc\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 HoF \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u062f\u0631\u06a9\u0627\u0631 \u06c1\u06cc\u06ba\u06d4"},updateSection:{forms:{hofUid:{label:"\u0627\u067e \u0688\u06cc\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 HoF \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u062f\u0631\u06a9\u0627\u0631 \u06c1\u06cc\u06ba\u06d4"},mobileField:{label:"HoF \u06a9\u0627 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631"},documentUpload:{label:"\u062f\u0631\u0633\u062a \u0645\u0639\u0627\u0648\u0646 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u06cc \u0642\u0633\u0645 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4"},relationshipDropdown:{label:"\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06af\u0632\u0627\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be HoF \u06a9\u0627 \u062a\u0639\u0644\u0642 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4",values:{father:"\u0628\u0627\u067e",mother:"\u0645\u0627\u06ba",husband:"\u0634\u0648\u06c1\u0631",wife:"\u0628\u06cc\u0648\u06cc",guardian:"\u0633\u0631\u067e\u0631\u0633\u062a",Others:"\u062f\u0648\u0633\u0631\u06d2"}}}}},documentInfoPopup:{title:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u067e\u0646\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u067e\u0631 \u06a9\u0627\u0631\u0631\u0648\u0627\u0626\u06cc \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u0627\u06cc\u06a9 \u062f\u0631\u0633\u062a \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba",identityDocumentInfo:"\u0627\u06af\u0631 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0634\u0646\u0627\u062e\u062a\u06cc \u062b\u0628\u0648\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u06d2\u060c \u062a\u0648 \u06cc\u06c1 \u0622\u067e \u06a9\u06d2 \u0646\u0627\u0645 \u067e\u0631 \u06c1\u0648\u0646\u06cc \u0686\u0627\u06c1\u06cc\u06d2 \u0627\u0648\u0631 \u0627\u0633 \u067e\u0631 \u0622\u067e  \u06a9\u06cc \u062a\u0635\u0648\u06cc\u0631 \u06c1\u0648\u0646\u06cc \u0686\u0627\u06c1\u06cc\u06d2\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u06cc\u06ba \u06a9\u06c1 \u0641\u0627\u0631\u0645 \u0645\u06cc\u06ba \u0627\u0648\u067e\u0631 \u0630\u06a9\u0631 \u06a9\u0631\u062f\u06c1 '\u0646\u0627\u0645' \u0622\u067e \u06a9\u06d2 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u062f\u06c1 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06a9\u06d2 '\u0646\u0627\u0645' \u0633\u06d2 \u0645\u0644\u062a\u0627 \u06c1\u06d2\u06d4",addressDocumentInfo:"\u0627\u06af\u0631 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u067e\u0631\u0648\u0641 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u06d2\u060c \u062a\u0648 \u06cc\u06c1 \u0622\u067e \u06a9\u06d2 \u0646\u0627\u0645 \u067e\u0631 \u06c1\u0648\u0646\u06cc \u0686\u0627\u06c1\u06cc\u06d2\u06d4 \u0634\u0631\u06cc\u06a9 \u062d\u06cc\u0627\u062a\u060c \u0633\u0631\u067e\u0631\u0633\u062a\u060c \u06cc\u0627 \u0648\u0627\u0644\u062f\u06cc\u0646 \u06a9\u06d2 \u0646\u0627\u0645 \u06a9\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u0642\u0628\u0648\u0644 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc \u062c\u0627\u0626\u06cc\u06ba \u06af\u06cc\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u06