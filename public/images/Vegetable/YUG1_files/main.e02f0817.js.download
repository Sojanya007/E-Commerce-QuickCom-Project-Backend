\u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40\u0b17\u0b41\u0b21\u0b3f\u0b15 \u0b38\u0b20\u0b3f\u0b15\u0b4d, \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b1f\u0b4d\u0b5f\u0b3e\u0b2c\u0b4d \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u2018\u0b2e\u0b41\u0b01 \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b15\u0b30\u0b47 \u0b2f\u0b47 \u0b09\u0b2a\u0b30\u0b4b\u0b15\u0b4d\u0b24 \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40\u0b17\u0b41\u0b21\u0b3f\u0b15 \u0b38\u0b20\u0b3f\u0b15\u0b4d\u2019 |",list_5:"(5) \u0b06\u0b2a\u0b23 \u0b1a\u0b3e\u0b39\u0b41\u0b01\u0b25\u0b3f\u0b2c\u0b3e \u0b2a\u0b30\u0b3f\u0b1a\u0b5f \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b15\u0b41  \u0b21\u0b4d\u0b30\u0b2a\u0b4d \u0b21\u0b3e\u0b09\u0b28\u0b4d \u0b2e\u0b47\u0b28\u0b41\u0b30\u0b41  \u0b1a\u0b5f\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 |",list_6:"(6) \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 \u0b2a\u0b30\u0b3f\u0b1a\u0b5f \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b4d \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 (\u0b06\u0b15\u0b3e\u0b30 2 MB \u0b30\u0b41 \u0b15\u0b2e\u0b4d; \u0b2b\u0b3e\u0b07\u0b32\u0b4d \u0b2b\u0b30\u0b4d\u0b2e\u0b3e\u0b1f\u0b4d JPEG, PNG \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e PDF) |",list_7:"(7) \u0b06\u0b2a\u0b23 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b1a\u0b3e\u0b39\u0b41\u0b01\u0b25\u0b3f\u0b2c\u0b3e \u0b21\u0b4d\u0b30\u0b2a\u0b4d \u0b21\u0b3e\u0b09\u0b28\u0b4d \u0b2e\u0b47\u0b28\u0b41\u0b30\u0b41 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b4d \u0b1a\u0b5f\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 |",list_8:"(8) \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b4d \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 (\u0b06\u0b15\u0b3e\u0b30 2 MB \u0b30\u0b41 \u0b15\u0b2e\u0b4d; \u0b2b\u0b3e\u0b07\u0b32\u0b4d \u0b2b\u0b30\u0b4d\u0b2e\u0b3e\u0b1f\u0b4d JPEG, PNG \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e PDF) |",list_9:"(9) \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 \u0b38\u0b2e\u0b4d\u0b2e\u0b24\u0b3f \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 |"}},five:{title:"\u0b2f\u0b26\u0b3f \u0b2e\u0b4b \u0b2a\u0b4d\u0b30\u0b4b\u0b2b\u0b3e\u0b07\u0b32\u0b30\u0b47 \u0b2a\u0b4d\u0b30\u0b26\u0b30\u0b4d\u0b36\u0b3f\u0b24 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b2e\u0b4b\u0b30 \u0b38\u0b3e\u0b2e\u0b4d\u0b2a\u0b4d\u0b30\u0b24\u0b3f\u0b15 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b38\u0b39\u0b3f\u0b24 \u0b2e\u0b47\u0b33 \u0b16\u0b3e\u0b09 \u0b28\u0b3e\u0b39\u0b3f\u0b01, \u0b24\u0b47\u0b2c\u0b47 \u0b2e\u0b41\u0b01 \u0b15\u2019\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b3f?",content:{list_1:"(1)\u2018\u0b2f\u0b26\u0b3f \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b2e\u0b47\u0b33 \u0b16\u0b3e\u0b09 \u0b28\u0b3e\u0b39\u0b3f\u0b01, \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f\u0b0f\u0b20\u0b3e\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u2019, \u2018\u0b2e\u0b41\u0b01 \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b15\u0b30\u0b47 \u0b2f\u0b47 \u0b09\u0b2a\u0b30\u0b4b\u0b15\u0b4d\u0b24 \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40\u0b17\u0b41\u0b21\u0b3f\u0b15 \u0b38\u0b20\u0b3f\u0b15\u0b4d\u2019 \u0b1f\u0b4d\u0b5f\u0b3e\u0b2c\u0b4d \u0b24\u0b33\u0b47 \u0b25\u0b3f\u0b2c\u0b3e \u0b32\u0b3f\u0b19\u0b4d\u0b15\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 |",list_2:"(2) \u0b2a\u0b4d\u0b30\u0b26\u0b30\u0b4d\u0b36\u0b3f\u0b24 \u0b2b\u0b30\u0b4d\u0b2e\u0b30\u0b47 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40 \u0b2a\u0b41\u0b30\u0b23 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 |",list_3:"(3) \u0b06\u0b2a\u0b23 \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b1a\u0b3e\u0b39\u0b41\u0b01\u0b25\u0b3f\u0b2c\u0b3e \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b4d \u0b21\u0b4d\u0b30\u0b2a\u0b4d \u0b21\u0b3e\u0b09\u0b28\u0b4d \u0b2e\u0b47\u0b28\u0b41\u0b30\u0b41  \u0b1a\u0b5f\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 |",list_4:"(4) \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b4d \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 (\u0b06\u0b15\u0b3e\u0b30 2 MB \u0b30\u0b41 \u0b15\u0b2e\u0b4d; \u0b2b\u0b3e\u0b07\u0b32\u0b4d \u0b2b\u0b30\u0b4d\u0b2e\u0b3e\u0b1f\u0b4d JPEG, PNG \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e PDF) |",list_5:"(5) \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15 \u0b26\u0b47\u0b5f \u0b26\u0b3f\u0b05 |",list_6:"(6) \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 |"}},six:{title:"\u0b2f\u0b26\u0b3f \u0b15\u0b4b\u0b23\u0b38\u0b3f \u0b2a\u0b30\u0b3f\u0b1a\u0b5f \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40 (\u0b28\u0b3e\u0b2e, \u0b32\u0b3f\u0b19\u0b4d\u0b17 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b1c\u0b28\u0b4d\u0b2e \u0b24\u0b3e\u0b30\u0b3f\u0b16) \u0b2e\u0b4b\u0b30 \u0b2a\u0b4d\u0b30\u0b15\u0b43\u0b24 \u0b2a\u0b30\u0b3f\u0b1a\u0b5f \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40 \u0b38\u0b39\u0b3f\u0b24 \u0b2e\u0b47\u0b33 \u0b16\u0b3e\u0b09 \u0b28\u0b3e\u0b39\u0b3f\u0b01, \u0b24\u0b47\u0b2c\u0b47 \u0b2e\u0b41\u0b01 \u0b15\u2019\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b3f?",content:"\u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f https://uidai.gov.in/images/commdoc/List_of_Supporting_Document_for_Aadhaar_Enrolment_and_Update.pdf \u0b30\u0b47 \u0b24\u0b3e\u0b32\u0b3f\u0b15\u0b3e\u0b2d\u0b41\u0b15\u0b4d\u0b24 \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b2a\u0b30\u0b3f \u0b2e\u0b42\u0b33 \u0b2a\u0b30\u0b3f\u0b1a\u0b5f \u0b26\u0b32\u0b3f\u0b32 \u0b38\u0b39\u0b3f\u0b24 \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 \u0b2a\u0b30\u0b3f\u0b26\u0b30\u0b4d\u0b36\u0b28 \u0b15\u0b30"},seven:{title:"\u0b2f\u0b26\u0b3f \u0b2e\u0b41\u0b01 \u0b05\u0b2b\u0b32\u0b3e\u0b07\u0b28\u0b30\u0b47 \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b1a\u0b3e\u0b39\u0b41\u0b01\u0b1b\u0b3f, \u0b24\u0b47\u0b2c\u0b47 \u0b2e\u0b41\u0b01 \u0b15\u0b3f\u0b2a\u0b30\u0b3f \u0b0f\u0b15 \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 \u0b16\u0b4b\u0b1c\u0b3f \u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b3f?",content:{list_1:"(1) \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f https://bhuvan.nrsc.gov.in/aadhaar/ \u0b15\u0b41 \u0b2f\u0b3e\u0b06\u0b28\u0b4d\u0b24\u0b41 |",list_2:"(2) \u0b28\u0b3f\u0b15\u0b1f\u0b38\u0b4d\u0b25 \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b17\u0b41\u0b21\u0b3f\u0b15 \u0b16\u0b4b\u0b1c\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01, \u2018\u0b38\u0b47\u0b23\u0b4d\u0b1f\u0b30\u0b4d\u0b38 \u0b28\u0b3f\u0b15\u0b1f\u0b38\u0b4d\u0b25\u2019 \u0b1f\u0b4d\u0b5f\u0b3e\u0b2c\u0b4d \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 | \u0b28\u0b3f\u0b15\u0b1f\u0b38\u0b4d\u0b25 \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b17\u0b41\u0b21\u0b3f\u0b15 \u0b26\u0b47\u0b16\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 \u0b05\u0b2c\u0b38\u0b4d\u0b25\u0b3e\u0b28 \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40 \u0b2a\u0b4d\u0b30\u0b2c\u0b47\u0b36 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 |",list_3:"(3) \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 \u0b2a\u0b3f\u0b28\u0b4d \u0b15\u0b4b\u0b21\u0b4d \u0b15\u0b4d\u0b37\u0b47\u0b24\u0b4d\u0b30 \u0b2e\u0b27\u0b4d\u0b5f\u0b30\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b17\u0b41\u0b21\u0b3f\u0b15 \u0b16\u0b4b\u0b1c\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01, \u2018\u0b38\u0b28\u0b4d\u0b27\u0b3e\u0b28 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b2a\u0b3f\u0b28\u0b4d \u0b15\u0b4b\u0b21\u0b4d\u2019 \u0b1f\u0b4d\u0b5f\u0b3e\u0b2c\u0b4d \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 | \u0b38\u0b47\u0b39\u0b3f \u0b05\u0b1e\u0b4d\u0b1a\u0b33\u0b30\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 \u0b26\u0b47\u0b16\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 \u0b15\u0b4d\u0b37\u0b47\u0b24\u0b4d\u0b30 PIN \u0b15\u0b4b\u0b21\u0b4d \u0b2a\u0b4d\u0b30\u0b2c\u0b47\u0b36 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 |"}},eight:{title:"\u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b4d \u0b26\u0b3e\u0b16\u0b32 \u0b2a\u0b3e\u0b07\u0b01 \u0b26\u0b47\u0b5f \u0b15\u2019\u0b23?",content:"14 \u0b38\u0b47\u0b2a\u0b4d\u0b1f\u0b47\u0b2e\u0b4d\u0b2c\u0b30 2023 \u0b2a\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b28\u0b4d\u0b24 myAadhaar \u0b2a\u0b4b\u0b30\u0b4d\u0b1f\u0b3e\u0b32\u0b30\u0b47 \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b4d \u0b26\u0b3e\u0b16\u0b32 \u0b2e\u0b3e\u0b17\u0b23\u0b3e | \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b30\u0b47 \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b26\u0b3e\u0b16\u0b32 \u0b2a\u0b3e\u0b07\u0b01 \u0b2a\u0b4d\u0b30\u0b2f\u0b41\u0b1c\u0b4d\u0b5f \u0b1a\u0b3e\u0b30\u0b4d\u0b1c \u0b39\u0b47\u0b09\u0b1b\u0b3f Rs.50 \u0b1f\u0b19\u0b4d\u0b15\u0b3e\u0964"},nine:{title:"\u0b15\u0b47\u0b24\u0b47\u0b2c\u0b47\u0b33\u0b47 \u0b2e\u0b41\u0b01 \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b4d \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3f\u0b2c\u0b3f?",content:"\u0b1c\u0b40\u0b2c\u0b28\u0b30 \u0b38\u0b39\u0b1c\u0b24\u0b3e, \u0b09\u0b28\u0b4d\u0b28\u0b24 \u0b38\u0b47\u0b2c\u0b3e \u0b2c\u0b3f\u0b24\u0b30\u0b23 \u0b0f\u0b2c\u0b02 \u0b38\u0b20\u0b3f\u0b15\u0b4d \u0b2a\u0b4d\u0b30\u0b3e\u0b2e\u0b3e\u0b23\u0b3f\u0b15\u0b3f\u0b15\u0b30\u0b23\u0b15\u0b41 \u0b38\u0b15\u0b4d\u0b37\u0b2e \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b17\u0b41\u0b21\u0b3f\u0b15 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0