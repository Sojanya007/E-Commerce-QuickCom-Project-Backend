7\u062f\u0627\u0631\u06d2 (OVSE) \u06a9\u0648 \u0622\u0641 \u0644\u0627\u0626\u0646 \u0622\u062f\u06be\u0627\u0631 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u06cc \u0633\u06c1\u0648\u0644\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u06d2 \u06af\u0627\u06d4."},descTextStep1:"\u0622\u062f\u06be\u0627\u0631 \u067e\u06cc\u067e\u0631 \u0644\u06cc\u0633 \u0622\u0641 \u0644\u0627\u0626\u0646 \u0627\u06cc-\u06a9\u06d2 \u0648\u0627\u0626\u06cc \u0633\u06cc \u0627\u06cc\u06a9 \u0645\u062d\u0641\u0648\u0638 \u0627\u0648\u0631 \u0642\u0627\u0628\u0644 \u0627\u0634\u062a\u0631\u0627\u06a9 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632 \u06c1\u06d2 \u062c\u0633\u06d2 \u06a9\u0648\u0626\u06cc \u0628\u06be\u06cc \u0622\u062f\u06be\u0627\u0631 \u06c1\u0648\u0644\u0688\u0631 \u0634\u0646\u0627\u062e\u062a \u06a9\u06cc \u0622\u0641 \u0644\u0627\u0626\u0646 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0645\u06cc\u06ba \u0646\u0627\u0645\u060c \u067e\u062a\u06c1\u060c \u062a\u0635\u0648\u06cc\u0631\u060c \u062c\u0646\u0633\u060c DOB\u060c \u0631\u062c\u0633\u0679\u0631\u0688 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u06a9\u0627 \u06c1\u06cc\u0634\u060c \u0631\u062c\u0633\u0679\u0631\u0688 \u0627\u06cc \u0645\u06cc\u0644 \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0627\u0648\u0631 \u062d\u0648\u0627\u0644\u06c1 \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0627 \u06c1\u06cc\u0634 \u06c1\u0648\u06af\u0627 \u062c\u0633 \u0645\u06cc\u06ba \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0622\u062e\u0631\u06cc 4 \u06c1\u0646\u062f\u0633\u06d2 \u06c1\u0648\u06ba \u06af\u06d2 \u062c\u0633 \u06a9\u06d2 \u0628\u0639\u062f \u0688\u06cc\u062c\u06cc\u0679\u0644 \u0637\u0648\u0631 \u067e\u0631 \u062f\u0633\u062a\u062e\u0637 \u0634\u062f\u06c1 XML \u0645\u06cc\u06ba \u0679\u0627\u0626\u0645 \u0627\u0633\u0679\u06cc\u0645\u067e \u06c1\u0648\u06af\u0627\u06d4",descTextStep2:"\u0622\u0641 \u0644\u0627\u0626\u0646 eKYC \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u067e \u06a9\u06cc \u0632\u067e \u0641\u0627\u0626\u0644 \u06a9\u0627\u0645\u06cc\u0627\u0628\u06cc \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06c1\u0648 \u06af\u0626\u06cc \u06c1\u06d2\u06d4"},lockUnlockBiometrics:{serviceCard:{errorMessage:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u0633 \u0648\u0642\u062a \u062a\u06a9 \u0627\u0646\u062a\u0638\u0627\u0631 \u06a9\u0631\u06cc\u06ba \u062c\u0628 \u062a\u06a9 \u06c1\u0645 \u0645\u0648\u062c\u0648\u062f\u06c1 \u0644\u0627\u06a9/\u0627\u0646\u0644\u0627\u06a9 \u0627\u0633\u0679\u06cc\u0679\u0633 \u062d\u0627\u0635\u0644 \u06a9\u0631 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba\u06d4"},howItWorks:{title:"\u0628\u0627\u06cc\u0648\u0645\u06cc\u0679\u0631\u06a9\u0633 \u0644\u0627\u06a9/\u0627\u0646\u0644\u0627\u06a9 \u06a9\u06cc\u0633\u06d2 \u06a9\u0627\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4",description:"\u0628\u0627\u0626\u06cc\u0648 \u0644\u0627\u06a9/\u0627\u0646 \u0644\u0627\u06a9 \u0641\u06cc\u0686\u0631 \u0631\u06cc\u0630\u06cc\u0688\u0646\u0679 \u06a9\u06d2 \u0628\u0627\u0626\u06cc\u0648 \u0645\u06cc\u0679\u0631\u06a9\u0633 \u0688\u06cc\u0679\u0627 \u06a9\u06d2 \u0645\u0645\u06a9\u0646\u06c1 \u063a\u0644\u0637 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0648 \u0631\u0648\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0644\u0627\u06a9 \u0634\u062f\u06c1 \u0628\u0627\u0626\u06cc\u0648 \u0645\u06cc\u0679\u0631\u06a9\u0633 \u062a\u0648\u062b\u06cc\u0642 \u06a9\u06d2 \u0644\u0626\u06d2 \u0628\u0627\u0626\u06cc\u0648 \u0645\u06cc\u0679\u0631\u06a9\u0633 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0648 \u0631\u0648\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u0633 \u0633\u0631\u0648\u0633 \u06a9\u06d2 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0645\u062a\u0646\u0628\u06c1 \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0648\u06c1 \u062a\u0648\u062b\u06cc\u0642\u06cc \u062e\u062f\u0645\u0627\u062a \u0633\u06d2 \u0627\u0646\u06a9\u0627\u0631 \u06a9\u0648 \u0631\u0648\u06a9\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u0627\u062d\u062a\u06cc\u0627\u0637 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u06cc\u0633\u0627 \u06a9\u0631\u06cc\u06ba\u06d4",infoData:{stepOneDescription:"\u0627\u067e\u0646\u06d2 \u0628\u0627\u0626\u06cc\u0648 \u0645\u06cc\u0679\u0631\u06a9\u0633 \u06a9\u0648 \u0644\u0627\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0688\u06cc\u0634 \u0628\u0648\u0631\u0688 \u0633\u06d2 \u0627\u0633 \u0633\u0631\u0648\u0633 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4 \u062c\u0628 \u0622\u067e \u0627\u067e\u0646\u06d2 \u0628\u0627\u0626\u06cc\u0648 \u0645\u06cc\u0679\u0631\u06a9\u0633 (\u0641\u0646\u06af\u0631 \u067e\u0631\u0646\u0679\u060c \u0627\u06cc\u0631\u0633 \u0627\u0648\u0631 \u0686\u06c1\u0631\u06c1) \u06a9\u0648 \u0644\u0627\u06a9 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u062a\u0648 \u0627\u0646\u06c1\u06cc\u06ba \u062a\u0635\u062f\u06cc\u0642 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u0632\u06cc\u062f \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u062a\u0627\u06c1\u0645\u060c \u0636\u0631\u0648\u0631\u062a \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 OTP \u067e\u0631 \u0645\u0628\u0646\u06cc \u062a\u0635\u062f\u06cc\u0642 \u062f\u0633\u062a\u06cc\u0627\u0628 \u0631\u06c1\u06d2 \u06af\u06cc\u06d4",stepTwoDescription:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u0633 \u0635\u0641\u062d\u06c1 \u067e\u0631 \u0648\u0627\u067e\u0633 \u062c\u0627\u0626\u06cc\u06ba \u0627\u0648\u0631 \u0628\u0627\u0626\u06cc\u0648 \u0645\u06cc\u0679\u0631\u06a9\u0633 \u06a9\u0648 \u063a\u06cc\u0631 \u0645\u0642\u0641\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u06af\u06d2 \u0628\u0691\u06be\u06cc\u06ba\u06d4 \u0622\u067e \u06a9\u06d2 \u0628\u0627\u06cc\u0648\u0645\u06cc\u0679\u0631\u06a9\u0633 \u06a9\u0648 \u063a\u06cc\u0631 \u0645\u0642\u0641\u0644 \u06a9\u0631\u0646\u06d2 \u067e\u0631 ( \u0641\u0646\u06af\u0631 \u067e\u0631\u0646\u0679 + \u0622\u0626\u06cc\u0631\u0633 + \u0686\u06c1\u0631\u06c1 ) OTP \u067e\u0631 \u0645\u0628\u0646\u06cc \u062a\u0648\u062b\u06cc\u0642 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0641\u0639\u0627\u0644 \u06c1\u0648\u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4"}},selectionScreen:{unlockCard:{heading:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u063a\u06cc\u0631 \u0645\u0642\u0641\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4",consentText:"\u0645\u06cc\u06ba \u0633\u0645\u062c\u06be\u062a\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u0627\u067e\u0646\u06d2 \u0628\u0627\u0626\u06cc\u0648 \u0645\u06cc\u0679\u0631\u06a9 \u06a9\u0648 \u063a\u06cc\u0631 \u0645\u0642\u0641\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f\u060c \u0645\u06cc\u06ba \u0628\u0627\u06cc\u0648\u0645\u06cc\u0679\u0631\u06a9 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0642\u0627\u0628\u0644 \u06c1\u0648 \u062c\u0627\u0624\u06ba \u06af\u0627\u06d4",label:"\u0628\u0627\u06cc\u0648\u0645\u06cc\u0679\u0631\u06a9\u0633 \u06a9\u0648 \u063a\u06cc\u0631 \u0645\u0642\u0641\u0644 \u06a9\u0631\u06cc\u06ba\u06d4"},lockCard:{heading:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0644\u0627\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4",consentText:"\u0645\u06cc\u06ba \u0633\u0645\u062c\u06be\u062a\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u0627\u067e\u0646\u06d2 \u0628\u0627\u0626\u06cc\u0648 \u0645\u06cc\u0679\u0631\u06a9 \u06a9\u0648 \u0644\u0627\u06a9 \u06a9\u063