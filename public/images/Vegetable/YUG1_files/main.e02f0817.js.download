0d02 \u0d28\u0d3f\u0d2c\u0d28\u0d4d\u0d27\u0d28\u0d15\u0d33\u0d41\u0d02"},button:{otp:"\u0d12\u0d31\u0d4d\u0d31\u0d3f\u0d2a\u0d3f \u0d05\u0d2f\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d41\u0d15",submit:"\u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15"},modal:{mobile:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7d \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d (myaadhaar.uidai.gov.in) \u0d32\u0d4b\u0d17\u0d3f\u0d7b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d13\u0d7c\u0d21\u0d7c \u0d28\u0d7d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d1e\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d46 \u0d2a\u0d4d\u0d30\u0d4b\u0d24\u0d4d\u0d38\u0d3e\u0d39\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02.",tnc:{heading:"\u0d12 \u0d0e \u0d38\u0d3f \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d32\u0d3f\u0d7d \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d05\u0d02\u0d17\u0d40\u0d15\u0d43\u0d24 '\u0d28\u0d3f\u0d2c\u0d28\u0d4d\u0d27\u0d28\u0d15\u0d33\u0d41\u0d02 \u0d35\u0d4d\u0d2f\u0d35\u0d38\u0d4d\u0d25\u0d15\u0d33\u0d41\u0d02' \u0d1a\u0d41\u0d35\u0d1f\u0d46 \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d41\u0d15:",t1:"\u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d05\u0d1a\u0d4d\u0d1a\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d1e\u0d3e\u0d7b \u0d07\u0d24\u0d3f\u0d28\u0d3e\u0d7d \u0d38\u0d2e\u0d4d\u0d2e\u0d24\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",t2:"\u0d05\u0d1a\u0d4d\u0d1a\u0d1f\u0d3f\u0d1a\u0d4d\u0d1a \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d21\u0d46\u0d32\u0d3f\u0d35\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d1e\u0d3e\u0d7b \u0d2e\u0d28\u0d38\u0d4d\u0d38\u0d3f\u0d32\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7d \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d3f\u0d7b\u200c\u0d15\u0d4b\u0d21\u0d4d \u0d2a\u0d42\u0d7c\u0d23\u0d4d\u0d23\u0d2e\u0d3e\u0d2f\u0d41\u0d02 \u0d36\u0d30\u0d3f\u0d2f\u0d3e\u0d23\u0d4d.",t3:"\u0d13\u0d7c\u0d21\u0d7c \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d38\u0d47\u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f 50 \u0d30\u0d42\u0d2a (\u0d1c\u0d3f\u0d0e\u0d38\u0d4d\u0d1f\u0d3f \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d46) \u0d28\u0d7d\u0d15\u0d3e\u0d2e\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d1e\u0d3e\u0d7b \u0d38\u0d2e\u0d4d\u0d2e\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",t4:"\u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d3e \u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d4d\u0d2a\u0d40\u0d21\u0d4d \u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d47\u0d35\u0d28\u0d2e\u0d3e\u0d23\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d35\u0d3f\u0d24\u0d30\u0d23\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d1e\u0d3e\u0d7b \u0d2e\u0d28\u0d38\u0d4d\u0d38\u0d3f\u0d32\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f \u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d31\u0d4d\u0d31\u0d38\u0d4d \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d21\u0d46\u0d32\u0d3f\u0d35\u0d31\u0d3f \u0d28\u0d3f\u0d32 \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02."}}},payment:{welcomeText:"\u0d2a\u0d4d\u0d30\u0d3f\u0d2f \u0d28\u0d3f\u0d35\u0d3e\u0d38\u0d3f\u0d15\u0d33\u0d47, ",srnInfo:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d0e\u0d38\u0d4d\u0d06\u0d7c\u0d0e\u0d7b# \u0d7d \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d41.",trackInfo:"\u0d13\u0d7c\u0d21\u0d7c \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d3f\u0d28\u0d41\u0d02 \u0d2f\u0d41\u0d10\u200c\u0d21\u0d3f\u200c\u0d0e\u0d10\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d24\u0d4d\u0d24\u0d3f\u0d1f\u0d2a\u0d3e\u0d1f\u0d41\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d08 \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",paymentText:"\u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d3e\u0d7c\u0d21\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d 50 \u0d30\u0d42\u0d2a (\u0d1c\u0d3f\u0d0e\u0d38\u0d4d\u0d1f\u0d3f, \u0d38\u0d4d\u0d2a\u0d40\u0d21\u0d4d \u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d3e\u0d7c\u0d1c\u0d41\u0d15\u0d7e \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d46) \u0d08\u0d1f\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d02. ",redirectInfo:"\u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d41\u0d15 \u0d2c\u0d1f\u0d4d\u0d1f\u0d7a \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d7e, \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d46 \u0d2a\u0d47\u0d2f\u0d41 \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d17\u0d47\u0d31\u0d4d\u0d31\u0d4d\u200c\u0d35\u0d47\u0d2f\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d31\u0d40\u0d21\u0d2f\u0d31\u0d15\u0d4d\u200c\u0d1f\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d02. \u0d35\u0d3f\u0d1c\u0d2f\u0d15\u0d30\u0d2e\u0d3e\u0d2f \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d3f\u0d7d, \u0d05\u0d02\u0d17\u0d40\u0d15\u0d3e\u0d30 \u0d38\u0d4d\u0d32\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d \u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d46 \u0d08 \u0d2a\u0d47\u0d1c\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d35\u0d3f\u0d1f\u0d41\u0d02. \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d2a\u0d30\u0d3e\u0d1c\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d3e\u0d7d, \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d12\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d27\u0d3f\u0d15\u0d02 \u0d24\u0d35\u0d23 \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d41\u0d02 \u0d36\u0d4d\u0d30\u0d2e\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02.",button:{cancel:"\u0d31\u0d26\u0d4d\u0d26\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15",makePayment:"\u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d41\u0d15"}}},status:{srnField:"\u0d0e\u0d38\u0d4d\u0d06\u0d7c\u0d0e\u0d7b \u0d28\u0d7d\u0d15\u0d41\u0d15",table:{srn:"\u0d0e\u0d38\u0d4d \u0d06\u0d7c \u0d0e\u0d7b",orderDate:"\u0d15\u0d4d\u0d30\u0d2e\u0d24\u0d40\u0d2f\u0d24\u0d3f",currentStatus:"\u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d32\u0d46 \u0d05\u0d35\u0d38\u0d4d\u0d25",awb:"\u0d0e\u0d2f\u0d7c \u0d35\u0d47 \u0d2c\u0d3f\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c",dispatchDate:"\u0d05\u0d2f\u0d1a\u0d4d\u0d1a \u0d24\u0d40\u0d2f\u0d24\u0d3f",awb_subText:"\u0d2e\u0d41\u0d15\u0d33\u0d3f\u0d7d \u0d2a\u0d31\u0d1e\u0d4d\u0d1e \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d 'www.indiapost.gov.in' \u0d0e\u0d28\u0d4d\u0d28 \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d13\u0d7c\u0d21\u0d7c \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02",demographic:"\u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d3e \u0d15\u0d3e\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d33\u0d3e\u0d7d, \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d28\u0d3e\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d35\u0d46\u0d33\u0d3f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d3f\u0d32\u0d4d\u0d32. \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d3e\u0d32\u0d41\u0d02, \u0d13\u0d7c\u0d21\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d3f\u0d7d \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d1c\u0d28\u0d38\u0d02\u0d16\u0d4d\u0d2f\u0d3e\u0d2a\u0d30\u0d2e\u0d3e\u0d2f \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d09\u0d23\u0d4d\u0d1f\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02."}}},aadharStatus:{title:"\u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d & \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d31\u0d4d\u0d31\u0d38\u0d4d \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",description:{one:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d24\u0d3e\u0d23\u0d4b \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d24\u0d3e\u0d23\u0d4b \u0d0e\u0d28\u0d4d\u0d28\u0d4d \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15 .",twoEID:"\u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d / \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d46\u0d7b\u0d4d\u0d31\u0d7c \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d7e \u0d05\u0d15\u0d4d\u200c\u0d28\u0d4b\u0d33\u0d1c\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d38\u0d4d\u0d32\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d2a\u0d4d\u0d30\u0d3f\u0d7b\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u200c\u0d24 14 \u0d05\u0d15\u0d4d\u0d15 \u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c",twoSRN:"\u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d7e \u0d05\u0d15\u0d4d\u200c\u0d28\u0d4b\u0d33\u0d1c\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d38\u0d4d\u0d32\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d\u0d05\u0d1a\u0d4d\u0d1a\u0d1f\u0d3f\u0d1a\u0d4d\u0d1a 'S'-\u0d28\u0d4d \u0d36\u0d47\u0d37\u0d02 13 \u0d05\u0d15\u0d4d\u0d15\u0d19\u0d4d\u0d19\u0d7e ",twoURN:"'mAadhaar' \u0d06\u0d2a\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d28\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d7e \u0d05\u0d15\u0d4d\u200c\u0d28\u0d4b\u0d33\u0d1c\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d38\u0d4d\u0d32\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d05\u0d1a\u0d4d\u0d1a\u0d1f\u0d3f\u0d1a\u0d4d\u0d1a 8 \u0d05\u0d15\u0d4d\u0d15 \u0d2f\u0d41\u0d06\u0d7c\u0d0e\u0d7b ",twoSID:"\u2018S\u2019 followed by 27 digits, printed on acknowledgement slip while physically visiting Enrolment / Update center. Sample: S123456789123456789123456789",three:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d EID \u0d28\u0d37\u0d4d\u0d1f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d3e\u0d7d, \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d35\u0d34\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d37\u0d4d\u0d1f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d24\u0d4b \u0d2e\u0d31\u0d28\u0d4d\u0d28\u0d24\u0d4b \u0d06\u0d2f EID \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02."},optionalMessage:"\u0d05\u0d15\u0d4d\u0d28\u0d4b\u0d33\u0d1c\u0d4d\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d38\u0d4d\u0d32\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d \u0d05\u0d28\u0d41\u0d38\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d24\u0d40\u0d2f\u0d24\u0d3f\u0d2f\u0d41\u0d02 \u0d38\u0d2e\u0d2f\u0d35\u0d41\u0d02 \u0d38\u0d42\u0d1a\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15 (<b>\u0d13\u0d2a\u0d4d\u0d37\u0d23\u0d7d</b>)"},complaintStatus:{title:"\u0d2a\u0d30\u0d3e\u0d24\u0d3f / \u0d2b\u0d40\u0d21\u0d4d\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d32 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",form:{complaintNumber:"\u0d38\u0d47\u0d35\u0d28 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d28\u0d7d\u0d15\u0d41\u0d15",QRCid:"Qrc Id",status:"\u0d2a\u0d26\u0d35\u0d3f",ComplaintNumber:"\u0d2a\u0d30\u0d3e\u0d24\u0d3f / \u0d2b\u0d40\u0d21\u0d4d\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c",ResolutionResponse:"\u0d31\u0d46\u0d38\u0d32\u0d4d\u0d2f\u0d42\u0d37\u0d7b \u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d15\u0d30\u0d23\u0d02"}},fileComplaint:{title:"\u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d2f\u0d41\u0d02 \u0d2b\u0d40\u0d21\u0d4d\u200c\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d02",description:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d2f\u0d41\u0d02 \u0d2b\u0d40\u0d21\u0d4d\u200c\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d2b\u0d2f\u0d7d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",disclaimer:"\u0d06\u0d27\u0d3e\u0d7c, \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d38\u0d3e\u0d27\u0d3e\u0d30\u0d23\u0d2f\u0d3e\u0d2f\u0d3f \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d21\u0d3f\u0d1c\u0d3f\u0d31\u0d4d\u0d31\u0d7d \u0d10\u0d21\u0d7b\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f \u0d0e\u0d28\u0d4d\u0d28 \u0d28\u0d3f\u0d32\u0d2f\u0d3f\u0d7d, \u0d28\u0d3f\u0d30\u0d35\u0d27\u0d3f \u0d38\u0d2c\u0d4d\u200c\u0d38\u0d3f\u0d21\u0d3f\u0d15\u0d7e, \u0d06\u0d28\u0d41\u0d15\u0d42\u0d32\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e, \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d07\u0d24\u0d4d \u0d15\u0d23\u0d15\u0d4d\u0d15\u0d3f\u0d32\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d4d, \u0d06\u0d27\u0d3e\u0d7c \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d3e\u0d2c\u0d47\u0d38\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d24 \u0d28\u0d3f\u0d32\u0d28\u0d3f\u0d7c\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d, \u0d30\u0d47\u0d16\u0d15\u0d33\u0d41\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d35\u0d4d\u0d2f\u0d3e\u0d2f\u0d3e\u0d2e\u0d02 \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d06\u0d30\u0d02\u0d2d\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d06\u0d27\u0d3e\u0d7c \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d3e\u0d2c\u0d47\u0d38\u0d4d \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d0f\u0d31\u0d4d\u0d31\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d, \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d15\u0d3e\u0d32\u0d3e\u0d15\u0d3e\u0d32\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d05\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e \u0d28\u0d7d\u0d15\u0d3e\u0d31\u0d41\u0d23\u0d4d\u0d1f\u0d4d. \u0d07\u0d24\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d31\u0d26\u0d4d\u0d26\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d3f\u0d1f\u0d4d\u0d1f\u0d3f\u0d32\u0d4d\u0d32\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d0f\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d07\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d0e\u0d28\u0d4d\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d2f\u0d41\u0d23\u0d4d\u0d1f\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d05\u0d35\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d2b\u0d40\u0d21\u0d4d\u200c\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02. \u0d05\u0d24\u0d4d\u0d24\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d0f\u0d24\u0d4a\u0d30\u0d41 \u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d2f\u0d41\u0d02 \u0d09\u0d1a\u0d3f\u0d24\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d30\u0d3f\u0d39\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02.",form:{heading:"\u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d15",state:"\u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d15",enquirer:"\u0d2a\u0d30\u0d3e\u0d24\u0d3f / \u0d2b\u0d40\u0d21\u0d4d\u200c\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d4d (\u0d38\u0d4d\u0d35\u0d2f\u0d02/\u0d2e\u0d31\u0d4d\u0d31\u0d41\u0d33\u0d4d\u0d33\u0d35\u0d7c)",complaintType:"\u0d2a\u0d30\u0d3e\u0d24\u0d3f / \u0d2b\u0d40\u0d21\u0d4d\u200c\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d24\u0d30\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d15",categoryType:"\u0d15\u0d3e\u0d31\u0d4d\u0d31\u0d17\u0d31\u0d3f \u0d24\u0d30\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d15",uploadDocumentLabel:"\u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d3e\u0d23\u0d41\u0d15 & \u0d21\u0d4b\u0d15\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15 (\u0d0e\u0d28\u0d4d\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d09\u0d23\u0d4d\u0d1f\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d)",statusField:"EID / SRN / URN \u0d28\u0d7d\u0d15\u0d41\u0d15",placeholder:"\u0d2a\u0d4d\u0d30\u0d3f\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d47, \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d36\u0d19\u0d4d\u0d15 \u0d2b\u0d32\u0d2a\u0d4d\u0d30\u0d26\u0d2e\u0d3e\