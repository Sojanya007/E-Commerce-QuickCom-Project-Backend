 \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0ac0 a\u0aaa\u0acb\u0a87\u0aa8\u0acd\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0aac\u0ac1\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb"},vidGenerator:{title:"\u0ab5\u0ac0\u0a86\u0a88\u0aa1\u0ac0 \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f\u0ab0",description:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0abe\u0aa5\u0ac7 \u0ab2\u0abf\u0a82\u0a95 16 \u0aa1\u0abf\u0a9c\u0abf\u0a9f\u0ab2 \u0ab5\u0ab0\u0acd\u0a9a\u0acd\u0aaf\u0ac1\u0a85\u0ab2 \u0a86\u0a88\u0aa1\u0ac0 (\u0ab5\u0ac0\u0a86\u0a88\u0aa1\u0ac0) \u0aac\u0aa8\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb"},lec:{title:"\u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0ab6\u0acb\u0aa7\u0acb",description:"\u0aa8\u0a9c\u0ac0\u0a95\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb \u0ab6\u0acb\u0aa7\u0ab5\u0abe \u0a85\u0aa8\u0ac7 \u0ab6\u0acb\u0aa7\u0ab5\u0abe \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb"},lockUnlockAadhaar:{title:"\u0ab2\u0ac9\u0a95 / \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a86\u0aa7\u0abe\u0ab0",description:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac7 \u0a85\u0ab8\u0acd\u0aa5\u0abe\u0aaf\u0ac0 \u0ab0\u0ac2\u0aaa\u0ac7 \u0ab2\u0ac9\u0a95 / \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a86 \u0ab8\u0ac7\u0ab5\u0abe\u0aa8\u0acb \u0a95\u0abe\u0ab3\u0a9c\u0ac0\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0acb"},complaintStatus:{title:"\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 / \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0aa4\u0aaa\u0abe\u0ab8\u0acb",description:"\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6/\u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6\u0aa8\u0ac0 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0aa4\u0aaa\u0abe\u0ab8\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb"},fileComplaint:{title:"\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6",description:"\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb"}}}},documentUpdate:{intentPage:{title:"\u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab8\u0ac7\u0ab5\u0abe\u0aa8\u0acb \u0a89\u0aa6\u0acd\u0aa6\u0ac7\u0ab6",p1:"\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0,",p2:"\u0aa4\u0aae\u0aa8\u0ac7 \u0ab8\u0ab2\u0abe\u0ab9 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a95\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0ac7\u0a9f\u0abe\u0aac\u0ac7\u0a9d\u0aae\u0abe\u0a82 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa8\u0ab5\u0ac0\u0aa8\u0aa4\u0aae \u0a93\u0ab3\u0a96\u0aa8\u0acb \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0acb (POI) \u0a85\u0aa8\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aa8\u0acb \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0acb (POA) \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac7 \u0aae\u0a9c\u0aac\u0ac2\u0aa4 \u0a95\u0ab0\u0acb. POI/POA \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb\u0aae\u0abe\u0a82\u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ac7\u0ab2 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab8\u0abe\u0aa5\u0ac7 \u0aae\u0ac7\u0ab3 \u0a96\u0abe\u0aa4\u0ac0 \u0ab9\u0acb\u0ab5\u0ac0 \u0a9c\u0acb\u0a88\u0a8f. \u0a86 \u0aa4\u0aae\u0aa8\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0ac7\u0a9f\u0abe\u0aac\u0ac7\u0a9d\u0aae\u0abe\u0a82 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0\u0aa8\u0ac0 \u0ab8\u0aa4\u0aa4 \u0a9a\u0acb\u0a95\u0ab8\u0abe\u0a88\u0aa8\u0ac0 \u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aae\u0aa6\u0aa6 \u0a95\u0ab0\u0ab6\u0ac7.",p3:"\u0a9c\u0acb \u0aa4\u0aae\u0ac7 \u0aaa\u0ab9\u0ac7\u0ab2\u0abe\u0aa5\u0ac0 \u0a9c \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a85\u0aa5\u0ab5\u0abe myAadhaar \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0a9b\u0ac7, \u0aa4\u0acb \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac0 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0ac3\u0aa4\u0abf\u0aa8\u0ac0 \u0ab0\u0abe\u0ab9 \u0a9c\u0ac1\u0a93 \u0a85\u0aa5\u0ab5\u0abe \u0a85\u0aa8\u0acd\u0aaf\u0aa5\u0abe. \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ac7\u0ab2\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0aa8\u0ac7 \u0aa8\u0a95\u0abe\u0ab0\u0ab5\u0abe\u0aa8\u0abe \u0a95\u0abf\u0ab8\u0acd\u0ab8\u0abe\u0aae\u0abe\u0a82, \u0aa4\u0aae\u0abe\u0ab0\u0ac7 \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0ac1\u0a82 \u0aaa\u0aa1\u0ab6\u0ac7.",p4:"\u0a9c\u0acb \u0aa4\u0aae\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0acb \u0a9b\u0acb, \u0aa4\u0acb \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7",p5:"\u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb.",p6:"\u0ab8\u0ac7\u0ab5\u0abe\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0ab0\u0ac2. 25/- \u0aa8\u0acb \u0aa8\u0a9c\u0ac0\u0ab5\u0acb \u0a9a\u0abe\u0ab0\u0acd\u0a9c \u0a9a\u0ac2\u0a95\u0ab5\u0ab5\u0acb \u0aaa\u0aa1\u0ab6\u0ac7, \u0a9c\u0ac7 \u0ab0\u0abf\u0aab\u0a82\u0aa1\u0aaa\u0abe\u0aa4\u0acd\u0ab0 \u0aa8\u0aa5\u0ac0.",p7:"\u0a86 \u0ab8\u0ac7\u0ab5\u0abe 14/06/2025 \u0ab8\u0ac1\u0aa7\u0ac0 \u0aae\u0aab\u0aa4 \u0a9b\u0ac7"},howItWorks:{description:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0abe \u0aaa\u0a97\u0ab2\u0abe\u0a82\u0a93 \u0a95\u0abe\u0ab3\u0a9c\u0ac0\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0ab5\u0abe\u0a82\u0a9a\u0acb. \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0a85\u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab5\u0abf\u0ab2\u0a82\u0aac\u0aa8\u0ac7 \u0a9f\u0abe\u0ab3\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0abf\u0ab5\u0abf\u0aa7 \u0aaa\u0a97\u0ab2\u0abe\u0a93 \u0aaa\u0ab0 \u0ab8\u0ac2\u0a9a\u0ab5\u0ac7\u0ab2 \u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0a93\u0aa8\u0ac7 \u0a85\u0aa8\u0ac1\u0ab8\u0ab0\u0acb. \u0a9c\u0acb \u0aa4\u0aae\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0acb \u0a9b\u0acb, \u0aa4\u0acb \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7, \u0aa4\u0acb \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7",stepDescription:{one:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a93\u0ab3\u0a96\u0aa8\u0abe \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0abe (PoI) \u0a85\u0aa8\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aa8\u0abe \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0abe (PoA) \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb.",two:"\u0a86 \u0aaa\u0a97\u0ab2\u0abe\u0aae\u0abe\u0a82, \u0aa4\u0aae\u0aa8\u0ac7 \u0aae\u0abe\u0aa8\u0acd\u0aaf POI/POA \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ab9\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7 \u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0aaa\u0a97\u0ab2\u0ac1\u0a82 1 \u0aae\u0abe\u0a82 \u0aaa\u0ac1\u0ab7\u0acd\u0a9f\u0abf \u0aa5\u0aaf\u0ac7\u0ab2 \u0a9a\u0a95\u0abe\u0ab8\u0abe\u0aaf\u0ac7\u0ab2 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab6\u0abe\u0aae\u0ac7\u0ab2 \u0a9b\u0ac7.",three:"\u0aa4\u0aae\u0abe\u0ab0\u0ac7 \u0a86 \u0ab8\u0ac7\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u20b9 25 (\u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0aaa\u0a9a\u0ac0\u0ab8 \u0ab0\u0ac2\u0aaa\u0abf\u0aaf\u0abe) \u0a9a\u0ac2\u0a95\u0ab5\u0ab5\u0abe \u0aaa\u0aa1\u0ab6\u0ac7. \u0aa4\u0aae\u0ac7 \u0a95\u0acd\u0ab0\u0ac7\u0aa1\u0abf\u0a9f/\u0aa1\u0ac7\u0aac\u0abf\u0a9f \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0a85\u0aa5\u0ab5\u0abe \u0aa8\u0ac7\u0a9f \u0aac\u0ac7\u0a82\u0a95\u0abf\u0a82\u0a97 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb. \u0a86 \u0ab0\u0a95\u0aae \u0aa8\u0acb\u0aa8-\u0ab0\u0ac0\u0aab\u0a82\u0aa1\u0aaa\u0abe\u0aa4\u0acd\u0ab0 \u0a9b\u0ac7."},note:"\u0a9c\u0acb \u0aa4\u0aae\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0ab5\u0abf\u0a97\u0aa4\u0acb (\u0aa8\u0abe\u0aae, DoB, \u0ab2\u0abf\u0a82\u0a97 \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82) \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0aa4\u0abe \u0ab9\u0acb, \u0aa4\u0acb \u0aa8\u0a9c\u0ac0\u0a95\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0acb \u0a85\u0aa8\u0ac7 \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aae\u0abe\u0a9f\u0ac7",noteLink:"\u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb."},currentSection:{form:{title:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0a9a\u0a95\u0abe\u0ab8\u0acb",name:"\u0aa8\u0abe\u0aae",gender:"\u0ab2\u0abf\u0a82\u0a97",dob:"\u0a9c\u0aa8\u0acd\u0aae \u0aa4\u0abe\u0ab0\u0ac0\u0a96",address:"\u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82",consent:"\u0ab9\u0ac1\u0a82 \u0a9a\u0a95\u0abe\u0ab8\u0acb \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0a89\u0aaa\u0ab0\u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab8\u0abe\u0a9a\u0ac0 \u0a9b\u0ac7."},note:"\u0a9c\u0acb \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab5\u0abf\u0a97\u0aa4\u0acb\u0aae\u0abe\u0a82 \u0aae\u0ac7\u0ab3 \u0a96\u0abe\u0aa4\u0acb \u0aa8\u0aa5\u0ac0, \u0aa4\u0acb \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa8\u0a9c\u0ac0\u0a95\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0aaa\u0ab0 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0ab5\u0abf\u0a97\u0aa4\u0acb (\u0aa8\u0abe\u0aae, \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82, \u0aa1\u0ac0\u0a93\u0aac\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0ab2\u0abf\u0a82\u0a97) \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0aab\u0a95\u0acd\u0aa4 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aae\u0abe\u0a9f\u0ac7",noteLink:"\u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb."},uploadSection:{confirmationPopUp:{title:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0aae\u0abe\u0a82\u0aa8\u0ac0 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0a86\u0aa7\u0abe\u0ab0\u0aae\u0abe\u0a82\u0aa8\u0ac0 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab8\u0abe\u0aa5\u0ac7 \u0aac\u0ab0\u0abe\u0aac\u0ab0 \u0aae\u0ac7\u0ab3 \u0a96\u0abe\u0aa4\u0ac0 \u0ab9\u0acb\u0ab5\u0abe\u0aa8\u0ac0 \u0aaa\u0ac1\u0ab7\u0acd\u0a9f\u0abf \u0a95\u0ab0\u0acb"},stepper:{verify:"\u0a9a\u0a95\u0abe\u0ab8\u0acb",upload:"\u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb"},guidelines:{title:"\u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0ac0 \u0aae\u0abe\u0ab0\u0acd\u0a97\u0aa6\u0ab0\u0acd\u0ab6\u0abf\u0a95\u0abe",l1:"\u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0aa8\u0ac1\u0a82 \u0a95\u0aa6 2 MB \u0a95\u0ab0\u0aa4\u0abe \u0a93\u0a9b\u0ac1\u0a82 \u0ab9\u0acb\u0ab5\u0ac1\u0a82 \u0a9c\u0acb\u0a88\u0a8f",l2:"\u0ab8\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aab\u0abe\u0a87\u0ab2 \u0aab\u0acb\u0ab0\u0acd\u0aae\u0ac7\u0a9f\u0acd\u0ab8 \u0a86 \u0a9b\u0ac7: <b>JPEG, PNG</b> \u0a85\u0aa8\u0ac7 <b>PDF</b>"},form:{poiTitle:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a93\u0ab3\u0a96\u0aa8\u0acb \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0acb (POI) \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb",poaTitle:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aa8\u0acb \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0acb (POA) \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb"},consent:"\u0ab9\u0ac1\u0a82 \u0a86\u0aa5\u0ac0 \u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0a86\u0aaa\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0aae\u0abe\u0ab0\u0abe \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a85\u0aaa\u0abe\u0aaf\u0ac7\u0ab2 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0/\u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0ab8\u0ab0\u0a95\u0abe\u0ab0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aa4\u0aac\u0a95\u0acd\u0a95\u0ac7 \u0a9a\u0a95\u0abe\u0ab8\u0aa3\u0ac0\u0aa8\u0ac7 \u0a86\u0aa7\u0ac0\u0aa8 \u0aa5\u0a88 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7."},faq:{card:{heading:"\u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0aa1\u0ac7\u0a9f ",description_1:"",description_2:""},guidelines:{heading_1:"\u0a93\u0ab3\u0a96 \u0a85\u0aa8\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aa8\u0abe \u0ab8\u0aae\u0ab0\u0acd\u0aa5\u0aa8\u0aae\u0abe\u0a82 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb",heading_2:"14/06/2025 \u0ab8\u0ac1\u0aa7\u0ac0 \u0aae\u0aab\u0aa4",question_1:{title:"\u0ab6\u0ac1\u0a82 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0ac1\u0a82?",content:{line_1:"\u0ab0\u0ac7\u0ab6\u0aa8\u0a95\u0abe\u0ab0\u0acd\u0aa1, \u0aae\u0aa4\u0aa6\u0abe\u0ab0 \u0a93\u0ab3\u0a96\u0aaa\u0aa4\u0acd\u0ab0, \u0ab8\u0ab0\u0a95\u0abe\u0ab0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9c\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0a93\u0ab3\u0a96\u0aaa\u0aa4\u0acd\u0ab0/\u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0aa7\u0ab0\u0abe\u0ab5\u0aa4\u0ac1\u0a82 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0 \u0a85\u0aa8\u0ac7 \u0aad\u0abe\u0ab0\u0aa4\u0ac0\u0aaf \u0aaa\u0abe\u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0a93\u0ab3\u0a96 \u0a85\u0aa8\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0aac\u0a82\u0aa8\u0ac7\u0aa8\u0abe \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0abe \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0a95\u0abe\u0aae \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.",line_2:"\u0aaa\u0abe\u0aa8 \u0a95\u0abe\u0ab0\u0acd\u0aa1, \u0aa1\u0acd\u0ab0\u0abe\u0a87\u0ab5\u0abf\u0a82\u0a97 \u0ab2\u0abe\u0a87\u0ab8\u0aa8\u0acd\u0ab8, \u0aae\u0abe\u0aa7\u0acd\u0aaf\u0aae\u0abf\u0a95 \u0a85\u0aa5\u0ab5\u0abe \u0ab5\u0ab0\u0abf\u0ab7\u0acd\u0aa0 \u0ab6\u0abe\u0ab3\u0abe \u0aae\u0abe\u0ab0\u0acd\u0a95\u0ab6\u0ac0\u0a9f/\u0aab\u0acb\u0a9f\u0acb\u0a97\u0acd\u0ab0\u0abe\u0aab \u0aa7\u0ab0\u0abe\u0ab5\u0aa4\u0ac1\u0a82 \u0ab6\u0abe\u0ab3\u0abe \u0a9b\u0acb\u0aa1\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0, \u0ab8\u0ab0\u0a95\u0abe\u0ab0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9c\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0a93\u0ab3\u0a96\u0aaa\u0aa4\u0acd\u0ab0/\u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0-\u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0a93\u0ab3\u0a96\u0aa8\u0abe \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0abe \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0a95\u0abe\u0aae \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.",line_3:"\u0ab5\u0ac0\u0a9c\u0ab3\u0ac0/\u0aaa\u0abe\u0aa3\u0ac0/\u0a97\u0ac7\u0ab8\u0aa8\u0ac1\u0a82 \u0aac\u0abf\u0ab2 (\u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0abe 3 \u0aae\u0ab9\u0abf\u0aa8\u0abe), \u0aac\u0ac7\u0a82\u0a95/\u0aaa\u0acb\u0ab8\u0acd\u0a9f \u0a93\u0aab\u0abf\u0ab8\u0aa8\u0ac0 \u0aaa\u0abe\u0ab8\u0aac\u0ac1\u0a95, \u0aad\u0abe\u0aa1\u0ac1\u0a82/\u0ab2\u0ac0\u0a9d/\u0ab0\u0a9c\u0abe \u0a85\u0aa8\u0ac7 \u0ab2\u0abe\u0a87\u0ab8\u0aa8\u0acd\u0ab8 \u0a95\u0ab0\u0abe\u0ab0 \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aa8\u0abe \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0abe \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0a95\u0abe\u0aae \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.",line_4:"\u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0acd\u0aaf \u0a93\u0ab3\u0a96 \u0a85\u0aa8\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aa8\u0abe \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb\u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0ab5\u0abe\u0ab0 \u0ab8\u0ac2\u0a9a\u0abf \u0aae\u0abe\u0a9f\u0ac7, \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb",line_5:" here"}},question_2:{title:"\u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0ac1\u0a82?",content:{line_1:"\u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2 \u0aaa\u0ab0 \u0a85\u0aa5\u0ab5\u0abe \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0a88\u0aa8\u0ac7 \u0a93\u0aa8\u0ab2\u0abe\u0a87\u0aa8 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.",line_2:"\u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0ac0 \u0aa4\u0aac\u0a95\u0acd\u0a95\u0abe\u0ab5\u0abe\u0ab0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb",line_3:" here"}},main_content:{submit:"\u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb",title:"\u0aae\u0aa6\u0aa6\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0a9b\u0ac7?",videoText:"\u0ab5\u0abf\u0aa1\u0abf\u0a93 \u0aae\u0abe\u0ab0\u0acd\u0a97\u0aa6\u0ab0\u0acd\u0ab6\u0abf\u0a95\u0abe",knowMoreText:"\u0ab5\u0aa7\u0ac1 \u0a9c\u0abe\u0aa3\u0acb \u0a9b\u0acb?",callText:"\u0a9f\u0acb\u0ab2-\u0aab\u0acd\u0ab0\u0ac0 \u0a95\u0ac9\u0ab2 \u0a95\u0ab0\u0acb (1947)"}},one:{title:"\u0ab6\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0abe\u0ab0\u0ac7 \u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0aae\u0abe\u0a9f\u0ac7 \u0a93\u0ab3\u0a96 \u0a85\u0aa8\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aa8\u0abe \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0a9c\u0acb\u0a88\u0a8f?",content:"\u0a86\u0aa7\u0abe\u0ab0 \u0aae\u0abe\u0a9f\u0ac7 \u0a93\u0ab3\u0a96 \u0a85\u0aa8\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0ab8\u0ab9\u0abe\u0aaf\u0a95 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a9c\u0ac0\u0ab5\u0aa8\u0aa8\u0ac0 \u0ab8\u0ab0\u0ab3\u0aa4\u0abe, \u0ab5\u0aa7\u0ac1 \u0ab8\u0abe\u0ab0\u0ac0 \u0ab8\u0ac7\u0ab5\u0abe \u0ab5\u0abf\u0aa4\u0ab0\u0aa3 \u0a85\u0aa8\u0ac7 \u0a9a\u0acb\u0a95\u0acd\u0a95\u0ab8 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3\u0aa8\u0ac7 \u0ab8\u0a95\u0acd\u0ab7\u0aae \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7. \u0aa4\u0ac7\u0aa5\u0ac0, \u0aa4\u0abe\u0a9c\u0ac7\u0aa4\u0ab0\u0aa8\u0abe \u0a93\u0ab3\u0a96 \u0a85\u0aa8\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aa8\u0abe \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0a8f \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95\u0aa8\u0abe \u0ab9\u0abf\u0aa4\u0aae\u0abe\u0a82 \u0a9b\u0ac7."},two:{title:"\u0aae\u0abe\u0ab0\u0ac0 \u0a93\u0ab3\u0a96 \u0a85\u0aa8\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0abe\u0ab0\u0ac7 \u0a95\u0aaf\u0abe \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0a9c\u0acb\u0a88\u0a8f?",content:{para_1:{heading_one:"\u0a93\u0ab3\u0a96 \u0a85\u0aa8\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0aac\u0a82\u0aa8\u0ac7 \u0aae\u0abe\u0a9f\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c:",list_1:"(a) \u0ab0\u0ac7\u0ab6\u0aa8 \u0a95\u0abe\u0ab0\u0acd\u0aa1",list_2:"(b) \u0aae\u0aa4\u0aa6\u0abe\u0ab0 \u0a93\u0ab3\u0a96 \u0a95\u0abe\u0ab0\u0acd\u0aa1",list_3:"(c) \u0a95\u0abf\u0ab8\u0abe\u0aa8 \u0aab\u0acb\u0a9f\u0acb \u0aaa\u0abe\u0ab8\u0aac\u0ac1\u0a95",list_4:"(d) \u0aad\u0abe\u0ab0\u0aa4\u0ac0\u0aaf \u0aaa\u0abe\u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f",list_5:"(e) \u0ab8\u0ab0\u0a95\u0abe\u0ab0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9c\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0a93\u0ab3\u0a96 \u0a95\u0abe\u0ab0\u0acd\u0aa1/\u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0, ST/SC/OBC \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0 \u0a85\u0aa5\u0ab5\u0abe \u0ab2\u0a97\u0acd\u0aa8\u0aa8\u0ac1\u0a82 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0, \u0aab\u0acb\u0a9f\u0acb\u0a97\u0acd\u0ab0\u0abe\u0aab \u0aa7\u0ab0\u0abe\u0ab5\u0aa4\u0ac1\u0a82",list_6:"(f) \u0ab5\u0abf\u0a95\u0ab2\u0abe\u0a82\u0a97\u0aa4\u0abe \u0a93\u0ab3\u0a96 \u0a95\u0abe\u0ab0\u0acd\u0aa1 / \u0ab5\u0abf\u0a95\u0ab2\u0abe\u0a82\u0a97\u0aa4\u0abe\u0aa8\u0ac1\u0a82 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0",list_7:"(g) \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0a9c\u0ac7\u0aa8\u0acd\u0aa1\u0ab0 \u0a93\u0ab3\u0a96 \u0a95\u0abe\u0ab0\u0acd\u0aa1/\u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0",list_8:"(h) \u0ab8\u0ac7\u0a95\u0acd\u0ab8 \u0ab5\u0ab0\u0acd\u0a95\u0ab0\u0aa8\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0aae\u0abe\u0a82 UIDAI \u0aae\u0abe\u0aa8\u0a95 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0 \u0aab\u0acb\u0ab0\u0acd\u0aae\u0ac7\u0a9f\u0aae\u0abe\u0a82 \u0a9c\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0",list_9:"(i) \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0ab6\u0ac7\u0ab2\u0acd\u0a9f\u0ab0 \u0ab9\u0acb\u0aae \u0a85\u0aa5\u0ab5\u0abe \u0a85\u0aa8\u0abe\u0aa5\u0abe\u0ab6\u0acd\u0ab0\u0aae \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe UIDAI \u0aae\u0abe\u0aa8\u0a95 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0 \u0aab\u0acb\u0ab0\u0acd\u0aae\u0ac7\u0a9f\u0aae\u0abe\u0a82 \u0a9c\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0",list_10:"(j) \u0a9c\u0ac7\u0ab2 \u0a85\u0aa7\u0abf\u0a95\u0abe\u0ab0\u0ac0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9c\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0a95\u0ac7\u0aa6\u0ac0\u0aa8\u0abe \u0a87\u0aa8\u0acd\u0aa1\u0a95\u0acd\u0ab6\u0aa8 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c"},para_2:{heading_one:"\u0a93\u0ab3\u0a96 \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0acb \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c:",list_1:"(a) \u0ab6\u0abe\u0ab3\u0abe \u0a9b\u0acb\u0aa1\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0 / \u0aab\u0acb\u0a9f\u0acb\u0a97\u0acd\u0ab0\u0abe\u0aab \u0ab8\u0abe\u0aa5\u0ac7 \u0ab6\u0abe\u0ab3\u0abe \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0",list_2:"(b) \u0aae\u0abe\u0ab0\u0acd\u0a95\u0ab6\u0ac0\u0a9f/\u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0 \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0ab6\u0abf\u0a95\u0acd\u0ab7\u0aa3 \u0aac\u0acb\u0ab0\u0acd\u0aa1 \u0a85\u0aa5\u0ab5\u0abe \u0aaf\u0ac1\u0aa8\u0abf\u0ab5\u0ab0\u0acd\u0ab8\u0abf\u0a9f\u0ac0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aab\u0acb\u0a9f\u0acb\u0a97\u0acd\u0ab0\u0abe\u0aab \u0ab8\u0abe\u0aa5\u0ac7 \u0a9c\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7",list_3:"(c) \u0aaa\u0abe\u0aa8/\u0a88-\u0aaa\u0abe\u0aa8 \u0a95\u0abe\u0ab0\u0acd\u0aa1",list_4:"(d) \u0ab8\u0ab0\u0a95\u0abe\u0ab0/\u0ab5\u0ac8\u0aa7\u0abe\u0aa8\u0abf\u0a95 \u0ab8\u0a82\u0ab8\u0acd\u0aa5\u0abe/\u0aaa\u0ac0\u0a8f\u0ab8\u0aaf\u0ac1 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9c\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0a95\u0ab0\u0acd\u0aae\u0a9a\u0abe\u0ab0\u0ac0/\u0aaa\u0ac7\u0aa8\u0acd\u0ab6\u0aa8\u0ab0 \u0aab\u0acb\u0a9f\u0acb \u0a93\u0ab3\u0a96 \u0a95\u0abe\u0ab0\u0acd\u0aa1, \u0aaa\u0ac7\u0aa8\u0acd\u0ab6\u0aa8 \u0aaa\u0ac7\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0a93\u0ab0\u0acd\u0aa1\u0ab0 \u0a85\u0aa5\u0ab5\u0abe \u0aae\u0ac7\u0aa1\u0ac0-\u0a95\u0acd\u0ab2\u0ac7\u0aae \u0a95\u0abe\u0ab0\u0acd\u0aa1",list_5:"(e) \u0aa1\u0acd\u0ab0\u0abe\u0a87\u0ab5\u0abf\u0a82\u0a97 \u0ab2\u0abe\u0a87\u0ab8\u0aa8\u0acd\u0ab8",list_6:"(f) \u0ab8\u0acd\u0ab5\u0aa4\u0a82\u0aa4\u0acd\u0ab0\u0aa4\u0abe \u0ab8\u0ac7\u0aa8\u0abe\u0aa8\u0ac0 \u0aab\u0acb\u0a9f\u0acb \u0a93\u0ab3\u0a96 \u0a95\u0abe\u0ab0\u0acd\u0aa1"},para_3:{heading_one:"\u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c:",list_1:"(a) \u0ab5\u0ac0\u0a9c\u0ab3\u0ac0, \u0aaa\u0abe\u0aa3\u0ac0, \u0a97\u0ac7\u0ab8 \u0a85\u0aa5\u0ab5\u0abe \u0a9f\u0ac7\u0ab2\u0abf\u0aab\u0acb\u0aa8/\u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2/\u0aac\u0acd\u0ab0\u0ac9\u0aa1\u0aac\u0ac7\u0aa8\u0acd\u0aa1 \u0aac\u0abf\u0ab2 (\u0aa4\u0acd\u0ab0\u0aa3 \u0aae\u0ab9\u0abf\u0aa8\u0abe \u0a95\u0ab0\u0aa4\u0abe\u0a82 \u0ab5\u0aa7\u0ac1 \u0a9c\u0ac2\u0aa8\u0ac1\u0a82 \u0aa8\u0ab9\u0ac0\u0a82)",list_2:"(\u0aac\u0ac0)  \u0aab\u0acb\u0a9f\u0acb \u0ab8\u0abe\u0aa5\u0ac7 \u0a85\u0aa8\u0ac1\u0ab8\u0ac2\u0a9a\u0abf\u0aa4 \u0ab5\u0abe\u0aa3\u0abf\u0a9c\u0acd\u0aaf\u0abf\u0a95 \u0aac\u0ac7\u0a82\u0a95/\u0aaa\u0acb\u0ab8\u0acd\u0a9f \u0a93\u0aab\u0abf\u0ab8\u0aa8\u0ac0 \u0aaa\u0abe\u0ab8\u0aac\u0ac1\u0a95 \u0aaa\u0ab0 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab9\u0ab8\u0acd\u0aa4\u0abe\u0a95\u0acd\u0ab7\u0ab0 \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0a9f\u0ac7\u0aae\u0acd\u0aaa \u0a95\u0ab0\u0acb.",list_3:"(\u0ab8\u0ac0)  \u0a85\u0aa8\u0ac1\u0ab8\u0ac2\u0a9a\u0abf\u0aa4 \u0ab5\u0abe\u0aa3\u0abf\u0a9c\u0acd\u0aaf\u0abf\u0a95 \u0aac\u0ac7\u0a82\u0a95/\u0aaa\u0acb\u0ab8\u0acd\u0a9f \u0a93\u0aab\u0abf\u0ab8 \u0a96\u0abe\u0aa4\u0ac1\u0a82/\u0a95\u0acd\u0ab0\u0ac7\u0aa1\u0abf\u0a9f-\u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0ab8\u0acd\u0a9f\u0ac7\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f (\u0aa4\u0acd\u0ab0\u0aa3 \u0aae\u0ab9\u0abf\u0aa8\u0abe\u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0a9c\u0ac2\u0aa8\u0ac1\u0a82 \u0aa8\u0ab9\u0ac0\u0a82) \u0aaa\u0ab0 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab9\u0ab8\u0acd\u0aa4\u0abe\u0a95\u0acd\u0ab7\u0ab0 \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0a9f\u0ac7\u0aae\u0acd\u0aaa \u0a95\u0ab0\u0ac7\u0ab2\u0ac1\u0a82 \u0ab9\u0acb\u0ab5\u0ac1\u0a82 \u0a9c\u0acb\u0a88\u0a8f.",list_4:"(\u0aa1\u0ac0) \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0aad\u0abe\u0aa1\u0ac1\u0a82, \u0ab2\u0ac0\u0a9d \u0a85\u0aa5\u0ab5\u0abe \u0ab0\u0a9c\u0abe \u0a85\u0aa8\u0ac7 \u0ab2\u0abe\u0a87\u0ab8\u0aa8\u0acd\u0ab8 \u0a95\u0ab0\u0abe\u0ab0",list_5:"(\u0a87) \u0ab8\u0abe\u0a82\u0ab8\u0aa6, \u0aa7\u0abe\u0ab0\u0abe\u0ab8\u0aad\u0acd\u0aaf, \u0a8f\u0aae\u0a8f\u0ab2\u0ab8\u0ac0, \u0aae\u0acd\u0aaf\u0ac1\u0aa8\u0abf\u0ab8\u0abf\u0aaa\u0ab2 \u0a95\u0abe\u0a89\u0aa8\u0acd\u0ab8\u0abf\u0ab2\u0ab0, \u0a97\u0acd\u0ab0\u0ac1\u0aaa '\u0a8f' \u0a85\u0aa5\u0ab5\u0abe '\u0aac\u0ac0' \u0a97\u0ac7\u0a9d\u0ac7\u0a9f\u0ac7\u0aa1 \u0a85\u0aa7\u0abf\u0a95\u0abe\u0ab0\u0ac0, \u0a87. \u0aaa\u0ac0. \u0a8f\u0aab. \u0a93. \u0a85\u0aa7\u0abf\u0a95\u0abe\u0ab0\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0aa4\u0ab9\u0ab8\u0ac0\u0ab2\u0aa6\u0abe\u0ab0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaf\u0ac1. \u0a86\u0a88. \u0aa1\u0ac0. \u0a8f. \u0a86\u0a88. \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aad\u0ac2\u0aa4 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0 \u0ab8\u0acd\u0ab5\u0ab0\u0ac2\u0aaa\u0aae\u0abe\u0a82 \u0a9c\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0",list_6:"(\u0a8f\u0aab)  \u0a97\u0acd\u0ab0\u0abe\u0aae \u0aaa\u0a82\u0a9a\u0abe\u0aaf\u0aa4 \u0ab5\u0aa1\u0abe/\u0ab8\u0a9a\u0abf\u0ab5, \u0a97\u0acd\u0ab0\u0abe\u0aae \u0aae\u0ab9\u0ac7\u0ab8\u0ac2\u0ab2 \u0a85\u0aa7\u0abf\u0a95\u0abe\u0ab0\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0aae\u0a95\u0a95\u0acd\u0ab7 (\u0a97\u0acd\u0ab0\u0abe\u0aae\u0ac0\u0aa3 \u0ab5\u0abf\u0ab8\u0acd\u0aa4\u0abe\u0ab0\u0acb \u0aae\u0abe\u0a9f\u0ac7) \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaf\u0ac1. \u0a86\u0a88. \u0aa1\u0ac0. \u0a8f. \u0a86\u0a88. \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aad\u0ac2\u0aa4 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0 \u0ab8\u0acd\u0ab5\u0ab0\u0ac2\u0aaa\u0aae\u0abe\u0a82 \u0a9c\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0",list_7:"(\u0a9c\u0ac0)  \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aae\u0abe\u0aa8\u0acd\u0aaf\u0aa4\u0abe \u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0ab6\u0ac8\u0a95\u0acd\u0ab7\u0aa3\u0abf\u0a95 \u0ab8\u0a82\u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0abe \u0ab5\u0aa1\u0abe \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaf\u0ac1. \u0a86\u0a88. \u0aa1\u0ac0. \u0a8f. \u0a86\u0a88. \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aad\u0ac2\u0aa4 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0 \u0ab8\u0acd\u0ab5\u0ab0\u0ac2\u0aaa\u0aae\u0abe\u0a82 \u0ab5\u0abf\u0aa6\u0acd\u0aaf\u0abe\u0ab0\u0acd\u0aa5\u0ac0\u0aa8\u0ac7 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0",list_8:"(\u0a8f\u0a9a) \u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0ab5\u0ac7\u0ab0\u0abe\u0aa8\u0ac0 \u0ab0\u0ab8\u0ac0\u0aa6 (\u0a8f\u0a95 \u0ab5\u0ab0\u0acd\u0ab7\u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0a9c\u0ac2\u0aa8\u0ac0 \u0aa8\u0ab9\u0ac0\u0a82)",list_9:"(\u0a86\u0a88 )\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0aaf\u0ac7\u0ab2 \u0ab5\u0ac7\u0a9a\u0abe\u0aa3 \u0a95\u0ab0\u0abe\u0ab0 \u0a85\u0aa5\u0ab5\u0abe \u0aad\u0ac7\u0a9f \u0a96\u0aa4",list_10:"(\u0a9c\u0ac7) \u0ab8\u0ab0\u0a95\u0abe\u0ab0/\u0ab5\u0ac8\u0aa7\u0abe\u0aa8\u0abf\u0a95 \u0ab8\u0a82\u0ab8\u0acd\u0aa5\u0abe/\u0aaa\u0ac0\u0a8f\u0ab8\u0aaf\u0ac1 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9c\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0a86\u0ab5\u0abe\u0ab8 \u0aab\u0abe\u0ab3\u0ab5\u0aa3\u0ac0 \u0aaa\u0aa4\u0acd\u0ab0 (\u0a8f\u0a95 \u0ab5\u0ab0\u0acd\u0ab7\u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0a9c\u0ac2\u0aa8\u0acb \u0aa8\u0ab9\u0ac0\u0a82)",list_11:"(\u0a95\u0ac7) \u0a9c\u0ac0\u0ab5\u0aa8 \u0a85\u0aa5\u0ab5\u0abe \u0aa4\u0aac\u0ac0\u0aac\u0ac0 \u0ab5\u0ac0\u0aae\u0abe \u0aaa\u0acb\u0ab2\u0abf\u0ab8\u0ac0 (\u0a8f\u0a95 \u0ab5\u0ab0\u0acd\u0ab7\u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0a9c\u0ac2\u0aa8\u0ac0 \u0aa8\u0ab9\u0ac0\u0a82)"}}},three:{title:"\u0ab9\u0ac1\u0a82 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0ab5\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",content:"\u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0aae\u0abe\u0aaf\u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2 https://myaadhaar.uidai.gov.in/\u0aaa\u0ab0 \u0a85\u0aa5\u0ab5\u0abe \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0aaa\u0ab0 \u0a93\u0aa8\u0ab2\u0abe\u0a87\u0aa8 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7."},four:{title:"\u0ab9\u0ac1\u0a82 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a93\u0aa8\u0ab2\u0abe\u0a87\u0aa8 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0ab5\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",content:{list_1:"(1) https://myaadhaar.uidai.gov.in/\u0aaa\u0ab0 \u0a9c\u0abe\u0a93 \u0a85\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0aaf\u0ac7\u0ab2\u0abe \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aaa\u0ab0 \u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0aa5\u0aaf\u0ac7\u0ab2\u0abe \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0a85\u0aa8\u0ac7 \u0ab5\u0aa8-\u0a9f\u0abe\u0a87\u0aae \u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1 (\u0a93. \u0a9f\u0ac0. \u0aaa\u0ac0.) \u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab2\u0acb\u0a97 \u0a87\u0aa8 \u0a95\u0ab0\u0acb.",list_2:"(2) \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2\u0aae\u0abe\u0a82 \u0aaa\u0acd\u0ab0\u0aa6\u0ab0\u0acd\u0ab6\u0abf\u0aa4 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a93\u0ab3\u0a96 \u0a85\u0aa8\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aa4\u0aaa\u0abe\u0ab8\u0acb.",list_3:"(3) \u0a9c\u0acb \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2\u0aae\u0abe\u0a82 \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ac7\u0ab2\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0a96\u0acb\u0a9f\u0ac0 \u0ab9\u0acb\u0aaf, \u0aa4\u0acb \u0aa8\u0ac0\u0a9a\u0ac7 \u0a86\u0aaa\u0ac7\u0ab2\u0abe \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8 5\u0aa8\u0abe \u0a9c\u0ab5\u0abe\u0aac\u0aae\u0abe\u0a82 \u0ab5\u0ab0\u0acd\u0aa3\u0ab5\u0acd\u0aaf\u0abe \u0aae\u0ac1\u0a9c\u0aac \u0aaa\u0a97\u0ab2\u0abe\u0a82 \u0ab2\u0acb.",list_4:"(4) \u0a9c\u0acb \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2\u0aae\u0abe\u0a82 \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ac7\u0ab2\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab8\u0abe\u0a9a\u0ac0 \u0ab9\u0acb\u0aaf, \u0aa4\u0acb \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 '\u0ab9\u0ac1\u0a82 \u0a9a\u0a95\u0abe\u0ab8\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0a89\u0aaa\u0ab0\u0acb\u0a95\u0acd\u0aa4 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab8\u0abe\u0a9a\u0ac0 \u0a9b\u0ac7' \u0a9f\u0ac7\u0aac \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb.",list_5:"(5) \u0aa4\u0aae\u0ac7 \u0a9c\u0ac7 \u0aa1\u0acd\u0ab0\u0acb\u0aaa-\u0aa1\u0abe\u0a89\u0aa8 \u0aae\u0ac7\u0aa8\u0ac1 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0acb \u0a9b\u0acb \u0aa4\u0ac7\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0a93\u0ab3\u0a96 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb.",list_6:"(6) \u0aa4\u0aae\u0abe\u0ab0\u0acb \u0a93\u0ab3\u0a96 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb (\u0a95\u0aa6 2 \u0a8f\u0aae\u0aac\u0ac0 \u0a95\u0ab0\u0aa4\u0abe \u0a93\u0a9b\u0ac1\u0a82; \u0aab\u0abe\u0a87\u0ab2 \u0aab\u0acb\u0ab0\u0acd\u0aae\u0ac7\u0a9f \u0a9c\u0ac7\u0aaa\u0ac0\u0a87\u0a9c\u0ac0, \u0aaa\u0ac0\u0a8f\u0aa8\u0a9c\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0aaa\u0ac0\u0aa1\u0ac0\u0a8f\u0aab)",list_7:"(7) \u0aa4\u0aae\u0ac7 \u0a9c\u0ac7 \u0aa1\u0acd\u0ab0\u0acb\u0aaa-\u0aa1\u0abe\u0a89\u0aa8 \u0aae\u0ac7\u0aa8\u0ac1 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0acb \u0a9b\u0acb \u0aa4\u0ac7\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0a82 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb.",list_8:"(8) \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb (\u0a95\u0aa6 2 \u0a8f\u0aae\u0aac\u0ac0 \u0a95\u0ab0\u0aa4\u0abe \u0a93\u0a9b\u0ac1\u0a82; \u0aab\u0abe\u0a87\u0ab2 \u0aab\u0acb\u0ab0\u0acd\u0aae\u0ac7\u0a9f \u0a9c\u0ac7\u0aaa\u0ac0\u0a87\u0a9c\u0ac0, \u0aaa\u0ac0\u0a8f\u0aa8\u0a9c\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0aaa\u0ac0\u0aa1\u0ac0\u0a8f\u0aab).",list_9:"(9) \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0ab0\u0a9c\u0ac2 \u0a95\u0ab0\u0acb."}},five:{title:"\u0a9c\u0acb \u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2\u0aae\u0abe\u0a82 \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ac7\u0ab2 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0abe \u0ab5\u0ab0\u0acd\u0aa4\u0aae\u0abe\u0aa8 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0abe\u0aa5\u0ac7 \u0aae\u0ac7\u0ab3 \u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0aa8\u0aa5\u0ac0, \u0aa4\u0acb \u0aae\u0abe\u0ab0\u0ac7 \u0ab6\u0ac1\u0a82 \u0a95\u0ab0\u0ab5\u0ac1\u0a82 \u0a9c\u0acb\u0a88\u0a8f?",content:{list_1:"(1) \u0aae\u0ab9\u0ac7\u0ab0\u0aac\u0abe\u0aa8\u0ac0 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 '\u0a9c\u0acb \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aae\u0abe\u0a82 \u0aae\u0ac7\u0ab3 \u0a96\u0abe\u0aa4\u0acb \u0aa8\u0aa5\u0ac0, \u0aa4\u0acb \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb' \u0aa8\u0ac0 \u0ab2\u0abf\u0a82\u0a95 \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb, '\u0ab9\u0ac1\u0a82 \u0a9a\u0a95\u0abe\u0ab8\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0a89\u0aaa\u0ab0\u0acb\u0a95\u0acd\u0aa4 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab8\u0abe\u0a9a\u0ac0 \u0a9b\u0ac7' \u0a9f\u0ac7\u0aac\u0aa8\u0ac0 \u0aa8\u0ac0\u0a9a\u0ac7.",list_2:"(2) \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ac7\u0ab2 \u0aab\u0acb\u0ab0\u0acd\u0aae\u0aae\u0abe\u0a82 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aad\u0ab0\u0acb. ",list_3:"(3) \u0aa4\u0aae\u0ac7 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0acb \u0a9b\u0acb \u0aa4\u0ac7 \u0aa1\u0acd\u0ab0\u0acb\u0aaa-\u0aa1\u0abe\u0a89\u0aa8 \u0aae\u0ac7\u0aa8\u0ac1\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0a82 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb.",list_4:"(4) \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb (\u0a95\u0aa6 2 \u0a8f\u0aae\u0aac\u0ac0 \u0a95\u0ab0\u0aa4\u0abe \u0a93\u0a9b\u0ac1\u0a82; \u0aab\u0abe\u0a87\u0ab2 \u0aab\u0acb\u0ab0\u0acd\u0aae\u0ac7\u0a9f \u0a9c\u0ac7\u0aaa\u0ac0\u0a87\u0a9c\u0ac0, \u0aaa\u0ac0\u0a8f\u0aa8\u0a9c\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0aaa\u0ac0\u0aa1\u0ac0\u0a8f\u0aab).",list_5:"(5) \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0a95\u0ab0\u0acb.",list_6:"(6) \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0acb."}},six:{title:"\u0a9c\u0acb \u0a95\u0acb\u0a88 \u0a93\u0ab3\u0a96\u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb (\u0aa8\u0abe\u0aae, \u0ab2\u0abf\u0a82\u0a97 \u0a85\u0aa5\u0ab5\u0abe \u0a9c\u0aa8\u0acd\u0aae \u0aa4\u0abe\u0ab0\u0ac0\u0a96) \u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0abe\u0ab8\u0acd\u0aa4\u0ab5\u0abf\u0a95 \u0a93\u0ab3\u0a96\u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab8\u0abe\u0aa5\u0ac7 \u0aae\u0ac7\u0ab3 \u0a96\u0abe\u0aa4\u0ac0 \u0aa8\u0aa5\u0ac0, \u0aa4\u0acb \u0aae\u0abe\u0ab0\u0ac7 \u0ab6\u0ac1\u0a82 \u0a95\u0ab0\u0ab5\u0ac1\u0a82 \u0a9c\u0acb\u0a88\u0a8f?",content:"\u0aae\u0ab9\u0ac7\u0ab0\u0aac\u0abe\u0aa8\u0ac0 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0ab8\u0ac2\u0a9a\u0abf\u0aac\u0aa6\u0acd\u0aa7 \u0aae\u0ac2\u0ab3 \u0a93\u0ab3\u0a96 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0ab8\u0abe\u0aa5\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0acb https://uidai.gov.in/images/commdoc/List_of_Supporting_Document_for_Aadhaar_Enrolment_and_Update.pdf."},seven:{title:"\u0a9c\u0acb \u0aae\u0abe\u0ab0\u0ac7 \u0a93\u0aab\u0ab2\u0abe\u0a87\u0aa8 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0ab5\u0ab5\u0abe \u0ab9\u0acb\u0aaf, \u0aa4\u0acb \u0ab9\u0ac1\u0a82 \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab6\u0acb\u0aa7\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",content:{list_1:"(1) \u0aae\u0ab9\u0ac7\u0ab0\u0aac\u0abe\u0aa8\u0ac0 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 https://bhuvan.nrsc.gov.in/aadhaar/\u0aaa\u0ab0 \u0a9c\u0abe\u0a93.",list_2:"(2) \u0aa8\u0a9c\u0ac0\u0a95\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb \u0ab6\u0acb\u0aa7\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, '\u0aa8\u0a9c\u0ac0\u0a95\u0aa8\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb' \u0a9f\u0ac7\u0aac \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb. \u0aa8\u0a9c\u0ac0\u0a95\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb \u0a9c\u0acb\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb.",list_3:"(3) \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aaa\u0abf\u0aa8 \u0a95\u0acb\u0aa1 \u0ab5\u0abf\u0ab8\u0acd\u0aa4\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb \u0ab6\u0acb\u0aa7\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, '\u0ab8\u0ab0\u0acd\u0a9a \u0aac\u0abe\u0aaf \u0aaa\u0abf\u0aa8 \u0a95\u0acb\u0aa1' \u0a9f\u0ac7\u0aac \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb. \u0aa4\u0ac7 \u0ab5\u0abf\u0ab8\u0acd\u0aa4\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb \u0a9c\u0acb\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0ab5\u0abf\u0ab8\u0acd\u0aa4\u0abe\u0ab0\u0aa8\u0acb \u0aaa\u0abf\u0aa8 \u0a95\u0acb\u0aa1 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb."}},eight:{title:"\u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ac7\u0a9f\u0ab2\u0acb \u0a9a\u0abe\u0ab0\u0acd\u0a9c \u0ab2\u0abe\u0a97\u0ac7 \u0a9b\u0ac7?",content:"14\u0aae\u0ac0 \u0ab8\u0aaa\u0acd\u0a9f\u0ac7\u0aae\u0acd\u0aac\u0ab0 2023 \u0ab8\u0ac1\u0aa7\u0ac0 \u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2 \u0aaa\u0ab0 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0aab\u0aa4 \u0a9b\u0ac7. \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0aaa\u0ab0 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab2\u0abe\u0a97\u0ac1 \u0aaa\u0aa1\u0aa4\u0acb \u0a9a\u0abe\u0ab0\u0acd\u0a9c \u0ab0\u0ac2. 50 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7."},nine:{title:"\u0aae\u0abe\u0ab0\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a95\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0ab5\u0ab5\u0abe \u0a9c\u0acb\u0a88\u0a8f?",content:"\u0a9c\u0ac0\u0ab5\u0aa8\u0aa8\u0ac0 \u0ab8\u0ab0\u0ab3\u0aa4\u0abe, \u0ab5\u0aa7\u0ac1 \u0ab8\u0abe\u0ab0\u0ac0 \u0ab8\u0ac7\u0ab5\u0abe \u0ab5\u0abf\u0aa4\u0ab0\u0aa3 \u0a85\u0aa8\u0ac7 \u0ab8\u0a9a\u0acb\u0a9f \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3\u0aa8\u0ac7 \u0ab8\u0a95\u0acd\u0ab7\u0aae \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0ac1\u0a82 \u0a87\u0a9a\u0acd\u0a9b\u0aa8\u0ac0\u0aaf \u0a9b\u0ac7. \u0aa4\u0ac7\u0aa5\u0ac0, \u0ab5\u0ab9\u0ac7\u0ab2\u0abe\u0aae\u0abe\u0a82 \u0ab5\u0ab9\u0ac7\u0ab2\u0ac0 \u0aa4\u0abe\u0ab0\u0ac0\u0a96\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0ab5\u0ab5\u0abe \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0ab9\u0abf\u0aa4\u0aae\u0abe\u0a82 \u0a9b\u0ac7."},ten:{title:"\u0ab9\u0ac1\u0a82 \u0a8f\u0a95 \u0aac\u0abf\u0aa8\u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 \u0aad\u0abe\u0ab0\u0aa4\u0ac0\u0aaf (NRI) \u0a9b\u0ac1\u0a82. \u0ab9\u0ac1\u0a82 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0ab5\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",content:"\u0aa4\u0aae\u0ac7 \u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aaa\u0aa3 \u0aad\u0abe\u0ab0\u0aa4\u0aae\u0abe\u0a82 \u0ab9\u0acb\u0ab5 \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0ab5\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb."}}},aadharUpdateHistory:{title1:"\u0aa4\u0aae\u0abe\u0ab0\u0acb \u0a86\u0aa7\u0abe\u0ab0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab9\u0abf\u0ab8\u0acd\u0a9f\u0acd\u0ab0\u0ac0 \u0aa4\u0aaa\u0abe\u0ab8\u0acb",label1:"\u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1",label2:"\u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0/\u0a85\u0aaa\u0aa1\u0ac7\u0a9f\u0aa8\u0ac0 \u0aa4\u0abe\u0ab0\u0ac0\u0a96",label3:"URN/EID",label4:"\u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0",list1:"\u0aa8\u0abe\u0aae",list2:"\u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2",list3:"\u0a88\u0aae\u0ac7\u0ab2",list4:" \u0aa1\u0ac0\u0a9c\u0aa8\u0acd\u0aae \u0aa4\u0abe\u0ab0\u0ac0\u0a96\u0a93\u0aac\u0ac0",list5:"\u0a9c\u0abe\u0aa4\u0abf",list6:"\u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82"},ssup:{howItWorks:{title:"\u0aa4\u0ac7 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a95\u0abe\u0aae \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7",description:"\u0a93\u0aa8\u0ab2\u0abe\u0a87\u0aa8 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0aa8\u0ac7 \u0ab8\u0aae\u0a9c\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0abe \u0aaa\u0a97\u0ab2\u0abe\u0a82 \u0ab5\u0abe\u0a82\u0a9a\u0acb. \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a85\u0aa5\u0ab5\u0abe \u0a85\u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab5\u0abf\u0ab2\u0a82\u0aac \u0aa8 \u0aa5\u0abe\u0aaf \u0aa4\u0ac7 \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0abf\u0ab5\u0abf\u0aa7 \u0aaa\u0a97\u0ab2\u0abe\u0a93 \u0aaa\u0ab0 \u0ab8\u0ac2\u0a9a\u0ab5\u0ac7\u0ab2 \u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0a93\u0aa8\u0ac1\u0a82 \u0aaa\u0abe\u0ab2\u0aa8 \u0a95\u0ab0\u0acb",proceedToUpdateAadhaar:"\u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0a86\u0a97\u0ab3 \u0ab5\u0aa7\u0acb",stepDescription:{one:"\u0aaf\u0abe\u0aa6\u0ac0\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0aab\u0ac0\u0ab2\u0acd\u0aa1 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb. \u0a86 \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe, \u0aa4\u0aae\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb. \u0aa8\u0abe\u0aae, \u0a9c\u0abe\u0aa4\u0abf, DOB, \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0, \u0a87\u0aae\u0ac7\u0a87\u0ab2 \u0a85\u0aa8\u0ac7 \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95\u0acd\u0ab8 \u0aa1\u0ac7\u0a9f\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa8\u0a9c\u0ac0\u0a95\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0acb.",two:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0aa1\u0ac7\u0a9f\u0abe \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb. \u0a95\u0ac7\u0a9f\u0ab2\u0abe\u0a95 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0aa1\u0ac7\u0a9f\u0abe\u0aa8\u0ac7 \u0aa1\u0acd\u0ab0\u0acb\u0aaa\u0aa1\u0abe\u0a89\u0aa8 \u0ab8\u0ac2\u0a9a\u0abf\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aaa\u0ab8\u0a82\u0aa6\u0a97\u0ac0\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0a9b\u0ac7. \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0aa1\u0ac7\u0a9f\u0abe \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0aa4\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7 \u0a85\u0aa5\u0ab5\u0abe \u0aa8\u0ac0\u0a9a\u0ac7 \u0a86\u0ab5\u0aa4\u0abe \u0ab5\u0abf\u0a95\u0ab2\u0acd\u0aaa\u0acb\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0aa4\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7 \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab8\u0abe\u0ab5\u0a9a\u0ac7\u0aa4 \u0ab0\u0ab9\u0acb.",three:"\u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0ac2\u0ab3 \u0ab8\u0ab9\u0abe\u0aaf\u0a95 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0aa8\u0ac0 \u0ab8\u0acd\u0a95\u0ac7\u0aa8 \u0a95\u0ab0\u0ac7\u0ab2\u0ac0 \u0aa8\u0a95\u0ab2\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0a9b\u0ac7. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a95\u0ab0\u0acb \u0a95\u0ac7 \u0ab8\u0ab9\u0abe\u0aaf\u0a95 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aa8\u0abe\u0aae\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0a9b\u0ac7. \u0a9c\u0acb \u0aa4\u0aae\u0ac7 UIDAI \u0aae\u0abe\u0aa8\u0a95 \u0aab\u0acb\u0ab0\u0acd\u0aae\u0ac7\u0a9f\u0aae\u0abe\u0a82 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aaa\u0aa4\u0acd\u0ab0 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0abe\u0a82 \u0a9b\u0acb, \u0aa4\u0acb \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0aa8\u0acb \u0a85\u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0 \u0a9f\u0abe\u0ab3\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0aad\u0ac2\u0ab2\u0acb \u0a9c\u0ac7\u0ab5\u0ac0 \u0a95\u0ac7 \u0a88\u0ab6\u0acd\u0aaf\u0ac1 \u0aa4\u0abe\u0ab0\u0ac0\u0a96, \u0a95\u0acd\u0ab0\u0acb\u0ab8 \u0ab8\u0abe\u0a88\u0aa8, \u0ab8\u0aae\u0a97\u0acd\u0ab0 \u0aab\u0acb\u0a9f\u0acb \u0aaa\u0ab0 \u0ab8\u0acd\u0a9f\u0ac7\u0aae\u0acd\u0aaa \u0a85\u0aa8\u0ac7 \u0a93\u0ab5\u0ab0\u0ab0\u0abe\u0a88\u0a9f\u0ac0\u0a82\u0a97 \u0aa8\u0aa5\u0ac0 \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aaa\u0abe\u0ab8\u0acb.",four:"\u0a93\u0aa8\u0ab2\u0abe\u0a87\u0aa8 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aab\u0ac0 \u0aa4\u0ab0\u0aab \u0aa4\u0aae\u0abe\u0ab0\u0ac7 \u20b9 50 (\u0aab\u0a95\u0acd\u0aa4 \u0aaa\u0a9a\u0abe\u0ab8 \u0ab0\u0ac2\u0aaa\u0abf\u0aaf\u0abe) \u0a9a\u0ac2\u0a95\u0ab5\u0ab5\u0abe \u0aaa\u0aa1\u0ab6\u0ac7. \u0aa4\u0aae\u0ac7 \u0a95\u0acd\u0ab0\u0ac7\u0aa1\u0abf\u0a9f / \u0aa1\u0ac7\u0aac\u0abf\u0a9f \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0a85\u0aa5\u0ab5\u0abe \u0aa8\u0ac7\u0a9f \u0aac\u0ac7\u0aa8\u0acd\u0a95\u0abf\u0a82\u0a97 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb. \u0a86 \u0ab0\u0a95\u0aae \u0aaa\u0ab0\u0aa4 \u0aa8\u0ab9\u0ac0\u0a82\u0aaa\u0abe\u0aa4\u0acd\u0ab0 \u0a9b\u0ac7. \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0\u0aa8\u0abe \u0a95\u0abf\u0ab8\u0acd\u0ab8\u0abe\u0aae\u0abe\u0a82, \u0aa4\u0aae\u0ac7 \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb.",five:"\u0aa4\u0aae\u0ac7 \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0ab8\u0ac7\u0ab5\u0abe \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0aa8\u0a82\u0aac\u0ab0 (\u0a8f\u0ab8\u0a86\u0ab0\u0a8f\u0aa8) \u0aae\u0ac7\u0ab3\u0ab5\u0ab6\u0acb. \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0aa8\u0ac7 \u0a9f\u0acd\u0ab0\u0ac7\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0aa5\u0ab5\u0abe \u0aaf\u0ac1\u0a86\u0a88\u0aa1\u0ac0\u0a8f\u0a86\u0a87 \u0ab9\u0ac7\u0ab2\u0acd\u0aaa\u0aa1\u0ac7\u0ab8\u0acd\u0a95 \u0ab8\u0abe\u0aa5\u0ac7\u0aa8\u0abe \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab8\u0a82\u0aa6\u0ac7\u0ab6\u0abe\u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0 \u0aae\u0abe\u0a9f\u0ac7 \u0a86 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0ac7 \u0ab8\u0abe\u0a9a\u0ab5\u0acb.",six:"\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a85\u0aae\u0abe\u0ab0\u0abe \u0a86\u0a82\u0aa4\u0ab0\u0abf\u0a95 \u0a97\u0ac1\u0aa3\u0ab5\u0aa4\u0acd\u0aa4\u0abe\u0aa8\u0abe \u0a9a\u0ac7\u0a95 \u0a93\u0aaa\u0ab0\u0ac7\u0a9f\u0ab0\u0acb \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9a\u0a95\u0abe\u0ab8\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0a86 \u0aa4\u0aac\u0a95\u0acd\u0a95\u0ac7 \u0aaa\u0ac2\u0ab0\u0abe \u0aaa\u0abe\u0aa1\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0aa4\u0abe \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0aa1\u0ac7\u0a9f\u0abe\u0aa8\u0ac7 \u0ab8\u0ab9\u0abe\u0aaf\u0a95 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0aa8\u0ac0 \u0ab5\u0abf\u0ab0\u0ac1\u0aa6\u0acd\u0aa7 \u0aa4\u0aaa\u0abe\u0ab8\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0a9c\u0acb \u0aa4\u0acd\u0aaf\u0abe\u0a82 \u0aae\u0ac7\u0ab3 \u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0aa8\u0aa5\u0ac0, \u0aa4\u0acb \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0aa8\u0ac7 \u0aa8\u0a95\u0abe\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0aa4\u0ac7\u0ab5\u0ac0 \u0ab8\u0a82\u0aad\u0abe\u0ab5\u0aa8\u0abe \u0a9b\u0ac7.",seven:"\u0a97\u0ac1\u0aa3\u0ab5\u0aa4\u0acd\u0aa4\u0abe \u0a9a\u0a95\u0abe\u0ab8\u0aa3\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aa5\u0ab5\u0abe \u0aaa\u0ab0, \u0aa4\u0aae\u0aa8\u0ac7 \u0a8f\u0a95 \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0a86\u0a88\u0aa1\u0ac0 \u0aae\u0ab3\u0ab6\u0ac7 \u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0a8f\u0aa8\u0ab0\u0acb\u0ab2\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0a86\u0a88\u0aa1\u0ac0 \u0aaa\u0ab0\u0abf\u0aa3\u0abe\u0aae \u0ab9\u0ab6\u0ac7.",eight:"\u0a85\u0aae\u0abe\u0ab0\u0abe \u0aac\u0ac7\u0a95\u0a8f\u0aa8\u0acd\u0aa1 \u0ab8\u0acb\u0aab\u0acd\u0a9f\u0ab5\u0ac7\u0ab0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa5\u0acb\u0aa1\u0abe \u0ab5\u0aa7\u0ac1 \u0aae\u0abe\u0aa8\u0acd\u0aaf\u0aa4\u0abe\u0a93 \u0aaa\u0a9b\u0ac0, \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aa5\u0ab6\u0ac7. \u0aaa\u0ab0\u0abf\u0aa3\u0abe\u0aae \u0aaa\u0ab0 \u0aa4\u0aae\u0aa8\u0ac7 \u0a8f\u0a95 \u0a8f\u0ab8\u0a8f\u0aae\u0a8f\u0ab8 \u0ab8\u0ac2\u0a9a\u0aa8\u0abe \u0aae\u0ab3\u0ab6\u0ac7.",nine:"\u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 90% \u0ab8\u0ac7\u0ab5\u0abe \u0aa7\u0acb\u0ab0\u0aa3\u0acb \u0ab8\u0abe\u0aa5\u0ac7 30 \u0aa6\u0abf\u0ab5\u0ab8\u0aae\u0abe\u0a82 \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7. \u0a9c\u0acb \u0a95\u0ac7, \u0a85\u0aae\u0ac7 \u0a85\u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0abf\u0ab8\u0acd\u0a9f\u0aae\u0acb\u0aae\u0abe\u0a82 \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0acb \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0abe \u0a9b\u0ac0\u0a8f \u0a85\u0aa8\u0ac7 \u0aae\u0acb\u0a9f\u0abe \u0aad\u0abe\u0a97\u0ac7, \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a89\u0ab2\u0acd\u0ab2\u0ac7\u0a96\u0abf\u0aa4 \u0ab8\u0aae\u0aaf \u0a95\u0ab0\u0aa4\u0abe\u0a82 \u0aaa\u0ab9\u0ac7\u0ab2\u0abe\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0aa4\u0aae\u0ac7 myaadhaar.uidai.gov.in \u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0a88\u0aa8\u0ac7 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe\u0aa8\u0ac0 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0a9a\u0a95\u0abe\u0ab8\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb."}},updateSelectPage:{title:"\u0a86\u0aa7\u0abe\u0ab0 \u0a93\u0aa8\u0ab2\u0abe\u0a87\u0aa8 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0acb",selectFields:{smallDescription:"\u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0ac7\u0a9f\u0abe \u0aab\u0ac0\u0ab2\u0acd\u0aa1 (\u0a93) \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb",longDescription:"\u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0abe \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0ac7\u0a9f\u0abe \u0a95\u0acd\u0ab7\u0ac7\u0aa4\u0acd\u0ab0 (\u0a93) \u0aa8\u0ac7 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb",updatesLeft:" \u0a85\u0aaa\u0aa1\u0ac7\u0a9f\u0acd\u0ab8 \u0aa1\u0abe\u0aac\u0ac7",noLimit:"\u0a95\u0acb\u0a88 \u0aae\u0ab0\u0acd\u0aaf\u0abe\u0aa6\u0abe \u0aa8\u0ab9\u0ac0",demoGraphics:{language:"\u0aad\u0abe\u0ab7\u0abe",name:"\u0aa8\u0abe\u0aae",dob:"\u0a9c\u0aa8\u0acd\u0aae \u0aa4\u0abe\u0ab0\u0ac0\u0a96",gender:"\u0ab2\u0abf\u0a82\u0a97",hof:"\u0a95\u0ac1\u0a9f\u0ac1\u0a82\u0aac\u0aa8\u0abe \u0ab5\u0aa1\u0abe (HOF) \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f",address:"\u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82"}},documentDescriptionLinkText:"\u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aaa\u0ac0\u0a93\u0a86\u0a87/ \u0aaa\u0ac0\u0a93\u0a8f/ \u0aaa\u0ac0\u0a93\u0aac\u0ac0 \u0aa5\u0ac0 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a9c\u0ac1\u0a93",proceedToUpdateAadhaar:"\u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0a86\u0a97\u0ab3 \u0ab5\u0aa7\u0acb",faq:"\u0ab5\u0abe\u0ab0\u0a82\u0ab5\u0abe\u0ab0 \u0aaa\u0ac2\u0a9b\u0abe\u0aa4\u0abe \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb"},dashboard:"\u0aa1\u0ac7\u0ab6\u0aac\u0acb\u0ab0\u0acd\u0aa1 ",hof:{title:"\u0a95\u0ac1\u0a9f\u0ac1\u0a82\u0aac\u0aa8\u0abe \u0ab5\u0aa1\u0abe (HOF) \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f",description:"\u0a95\u0ac1\u0a9f\u0ac1\u0a82\u0aac\u0aa8\u0abe \u0ab5\u0aa1\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab8\u0abe\u0aa5\u0ac7 \u0a86\u0a97\u0ab3 \u0ab5\u0aa7\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb.",howItWorks:{step1:"\u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0ac7\u0a9f\u0abe\u0aac\u0ac7\u0a9d\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a95\u0ac1\u0a9f\u0ac1\u0a82\u0aac\u0aa8\u0abe \u0ab5\u0aa1\u0abe\u0aa8\u0acb \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb. \u0aae\u0abe\u0aa4\u0acd\u0ab0 18 \u0ab5\u0ab0\u0acd\u0ab7 \u0a95\u0ac7 \u0aa4\u0ac7\u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0a89\u0a82\u0aae\u0ab0 \u0aa7\u0ab0\u0abe\u0ab5\u0aa4\u0abe \u0ab0\u0ab9\u0ac7\u0ab5\u0abe\u0ab8\u0ac0\u0a93\u0aa8\u0ac7 \u0a9c HoF \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0a97\u0aa3\u0ac0 \u0ab6\u0a95\u0abe\u0aaf.",step2:'\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0aa8\u0acb \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0acb (PoR) \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb \u0a95\u0ac7 \u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0aa8\u0abe\u0aae \u0a85\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a95\u0ac1\u0a9f\u0ac1\u0a82\u0aac\u0aa8\u0abe \u0ab5\u0aa1\u0abe\u0aa8\u0abe \u0aa8\u0abe\u0aae\u0aa8\u0acb \u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f \u0a89\u0ab2\u0acd\u0ab2\u0ac7\u0a96 \u0a9b\u0ac7. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0abe\u0aa5\u0ac7 HoF \u0aa8\u0acb \u0ab8\u0a82\u0aac\u0a82\u0aa7 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb, \u0a89\u0aa6\u0abe\u0ab9\u0ab0\u0aa3 \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0a9c\u0acb HoF \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aaa\u0aa4\u0abf \u0ab9\u0acb\u0aaf, \u0aa4\u0acb "\u0aaa\u0aa4\u0abf" \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb.',step3:"\u0aa4\u0aae\u0abe\u0ab0\u0ac7 \u0a91\u0aa8\u0ab2\u0abe\u0a87\u0aa8 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aab\u0ac0 \u0aae\u0abe\u0a9f\u0ac7 \u20b9 50 (\u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0aaa\u0a9a\u0abe\u0ab8 \u0ab0\u0ac2\u0aaa\u0abf\u0aaf\u0abe) \u0a9a\u0ac2\u0a95\u0ab5\u0ab5\u0abe \u0aaa\u0aa1\u0ab6\u0ac7. \u0aa4\u0aae\u0ac7 \u0a95\u0acd\u0ab0\u0ac7\u0aa1\u0abf\u0a9f/\u0aa1\u0ac7\u0aac\u0abf\u0a9f \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0a85\u0aa5\u0ab5\u0abe \u0aa8\u0ac7\u0a9f \u0aac\u0ac7\u0a82\u0a95\u0abf\u0a82\u0a97 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb. \u0a86 \u0ab0\u0a95\u0aae \u0aa8\u0acb\u0aa8-\u0ab0\u0ac0\u0aab\u0a82\u0aa1\u0aaa\u0abe\u0aa4\u0acd\u0ab0 \u0a9b\u0ac7.",step4:"\u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a95\u0ac1\u0a9f\u0ac1\u0a82\u0aac\u0aa8\u0abe \u0ab5\u0aa1\u0abe \u0aa4\u0ac7\u0aae\u0aa8\u0abe myAadhaar \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2 \u0aaa\u0ab0 \u0ab2\u0ac9\u0a97 \u0a87\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7, \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aa4\u0ac7\u0a93\u0aa8\u0ac7 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0a82\u0aa8\u0ac0 \u0ab5\u0ab9\u0ac7\u0a82\u0a9a\u0aa3\u0ac0 \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0aa5\u0ab6\u0ac7, \u0a9c\u0ac7\u0aa8\u0ac7 \u0aa4\u0ac7\u0a93 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0aa8\u0a95\u0abe\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. HoF \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0ab5\u0abe/\u0aa8\u0a95\u0abe\u0ab0\u0ab5\u0abe\u0aa8\u0acb \u0a86 \u0ab5\u0abf\u0a95\u0ab2\u0acd\u0aaa \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0aa8\u0ac0 \u0ab0\u0a9a\u0aa8\u0abe\u0aa8\u0ac0 \u0aa4\u0abe\u0ab0\u0ac0\u0a96\u0aa5\u0ac0 30 \u0aa6\u0abf\u0ab5\u0ab8 \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7."},currentSection:{title:"\u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 HoF \u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb"},updateSection:{forms:{hofUid:{label:"HoF \u0aa8\u0acb \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb"},mobileField:{label:"HoF \u0aa8\u0acb \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0"},documentUpload:{label:"\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0ab8\u0ab9\u0abe\u0aaf\u0a95 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0aa8\u0acb \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb"},relationshipDropdown:{label:"\u0a85\u0ab0\u0a9c\u0aa6\u0abe\u0ab0 \u0ab8\u0abe\u0aa5\u0ac7 HoF \u0aa8\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0aa8\u0ac7 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb",values:{father:"\u0aaa\u0abf\u0aa4\u0abe",mother:"\u0aae\u0abe\u0aa4\u0abe",husband:"\u0aaa\u0aa4\u0abf",wife:"\u0aaa\u0aa4\u0acd\u0aa8\u0ac0",guardian:"\u0ab5\u0abe\u0ab2\u0ac0",Others:"\u0a85\u0aa8\u0acd\u0aaf"}}}}},documentInfoPopup:{title:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0aaa\u0ab0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0acb\u0a88 \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb",identityDocumentInfo:"\u0a9c\u0acb \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a93\u0ab3\u0a96\u0aa8\u0abe \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a9b\u0ac7, \u0aa4\u0acb \u0aa4\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aa8\u0abe\u0aae\u0ac7 \u0ab9\u0acb\u0ab5\u0acb \u0a9c\u0acb\u0a88\u0a8f \u0a85\u0aa8\u0ac7 \u0aab\u0acb\u0a9f\u0acb\u0a97\u0acd\u0ab0\u0abe\u0aab \u0ab9\u0acb\u0ab5\u0acb \u0a9c\u0acb\u0a88\u0a8f. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a9a\u0a95\u0abe\u0ab8\u0acb \u0a95\u0ac7 \u0aab\u0acb\u0ab0\u0acd\u0aae\u0aae\u0abe\u0a82 \u0a89\u0aaa\u0ab0 \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ac7\u0ab2 '\u0aa8\u0abe\u0aae' \u0aa4\u0aae\u0ac7 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0abe\u0a82 \u0a9b\u0acb \u0aa4\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0aae\u0abe\u0a82\u0aa8\u0abe '\u0aa8\u0abe\u0aae' \u0ab8\u0abe\u0aa5\u0ac7 \u0aae\u0ac7\u0ab3 \u0a96\u0abe\u0aaf \u0a9b\u0ac7.",addressDocumentInfo:"\u0a9c\u0acb \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aa8\u0abe \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a9b\u0ac7, \u0aa4\u0acb \u0aa4\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aa8\u0abe\u0aae\u0ac7 \u0ab9\u0acb\u0ab5\u0acb \u0a9c\u0acb\u0a88\u0a8f. \u0a9c\u0ac0\u0ab5\u0aa8\u0ab8\u0abe\u0aa5\u0ac0, \u0ab5\u0abe\u0ab2\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0aae\u0abe\u0aa4\u0abe-\u0aaa\u0abf\u0aa4\u0abe\u0aa8\u0abe \u0aa8\u0abe\u0aae\u0aa8\u0abe \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7 \u0aa8\u0ab9\u0ac0\u0a82. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a9a\u0a95\u0abe\u0ab8\u0acb \u0a95\u0ac7 \u0aab\u0acb\u0ab0\u0acd\u0aae\u0aae\u0abe\u0a82 \u0a89\u0aaa\u0ab0 \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ac7\u0ab2 '\u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82' \u0aa4\u0aae\u0ac7 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0abe\u0a82 \u0a9b\u0acb \u0aa4\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0aae\u0abe\u0a82\u0aa8\u0abe '\u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82' \u0ab8\u0abe\u0aa5\u0ac7 \u0aae\u0ac7\u0ab3 \u0a96\u0abe\u0aaf \u0a9b\u0ac7.",close:"\u0aac\u0a82\u0aa7",continueToUpload:"\u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0a9a\u0abe\u0ab2\u0ac1 \u0ab0\u0abe\u0a96\u0acb"},forms:{reUseDocText:"\u0aa4\u0aae\u0ac7 \u0aaa\u0ab9\u0ac7\u0ab2\u0abe\u0aa5\u0ac0 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac7\u0ab2\u0abe \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb\u0aa8\u0acb \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb.",stepper:{language:"\u0aad\u0abe\u0ab7\u0abe",Name:"\u0aa8\u0abe\u0aae",dob:"\u0a9c\u0aa8\u0acd\u0aae \u0aa4\u0abe\u0ab0\u0ac0\u0a96",gender:"\u0ab2\u0abf\u0a82\u0a97",address:"\u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82",preview:"\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0abe\u0ab5\u0ab2\u0acb\u0a95\u0aa8",payment:"\u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0"},formButtons:{back:"\u0aaa\u0abe\u0a9b\u0ab3",next:"\u0a86\u0a97\u0ab3",makePayment:"\u0a9a\u0a