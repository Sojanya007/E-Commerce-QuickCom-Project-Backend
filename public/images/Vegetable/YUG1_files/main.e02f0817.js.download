u0935\u093e\u0917\u0924 \u0906\u0939\u0947",myAadhaar:"",description1:"\u0911\u0928\u0932\u093e\u0908\u0928 \u0921\u0947\u092e\u094b\u0917\u094d\u0930\u093e\u092b\u093f\u0915\u094d\u0938 \u0905\u092a\u0921\u0947\u091f \u0938\u0947\u0935\u093e, \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0911\u0930\u094d\u0921\u0930\u093f\u0902\u0917 \u0906\u0923\u093f \u091f\u094d\u0930\u0945\u0915\u093f\u0902\u0917 \u0906\u0923\u093f \u092f\u0942\u0906\u092f\u0921\u0940\u090f\u0906\u092f\u0926\u094d\u0935\u093e\u0930\u0947 \u0911\u092b\u0930 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0905\u0927\u093f\u0915 \u092e\u0942\u0932\u094d\u092f\u0935\u0930\u094d\u0927\u093f\u0924 \u0938\u0947\u0935\u093e \u090f\u0915\u094d\u0938\u092a\u094d\u0932\u094b\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0932\u0949\u0917\u093f\u0928 \u092c\u091f\u0923\u093e\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u093e \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0906\u0927\u093e\u0930\u0936\u0940 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u0905\u0938\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947.",description2:"",description3:"",loginCard:{loginText:"\u0932\u0949\u0917\u093f\u0928",desc:"\u0906\u0927\u093e\u0930 \u0906\u0923\u093f OTP \u0938\u0939 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u093e"},services:{description:"\u0906\u092a\u0932\u093e \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930 \u0906\u0927\u093e\u0930\u0938\u0939 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u0928\u0938\u0932\u094d\u092f\u093e\u0938 \u0915\u093f\u0902\u0935\u093e \u0906\u092a\u0923 \u0928\u0941\u0915\u0924\u093e\u091a \u091c\u0917\u093e\u091a\u094d\u092f\u093e \u0938\u0930\u094d\u0935\u093e\u0924 \u092e\u0