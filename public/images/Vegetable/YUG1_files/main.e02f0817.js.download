u0cc6",part2:"\u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6"}},aadhaar:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",descText:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0cc6"}},offlineEkyc:{title:"\u0c86\u0cab\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd eKYC",title1:"4 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 \u0cb7\u0cc7\u0cb0\u0cc1 \u0c95\u0ccb\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf",title2:"\u0c85\u0cad\u0cbf\u0ca8\u0c82\u0ca6\u0ca8\u0cc6\u0c97\u0cb3\u0cc1!!",stepper:{setCode:"\u0c95\u0ccb\u0ca1\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf",download:"\u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd"},button:{back:"\u0cb9\u0cbf\u0c82\u0ca6\u0cc6",download:"\u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd",goToDashboard:"\u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd \u0c97\u0cc6  \u0cb9\u0cc6\u0cc2\u0cd5\u0c97\u0cbf"},invalidShareCode:"Invalid Share Code! Please retry with correct share code.",shareCode:{title:"\u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cc6 \u0c95\u0ccb\u0ca1\u0ccd \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf",descText:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae eKYC \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5 ZIP \u0cab\u0cc8\u0cb2\u0ccd \u0cae\u0cc7\u0cb2\u0cc7 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0c82\u0ca1 \u0c95\u0ccb\u0ca1\u0ccd\u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c86\u0c97\u0cbf \u0cb0\u0cc7\u0cb8\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, \u0cab\u0cc8\u0cb2\u0ccd \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca1\u0cbf\u0cb5\u0cc8\u0cb8\u0ccd/ \u0ca1\u0cc6\u0cb8\u0ccd\u0c95\u0ccd\u200c\u0c9f\u0cbe\u0caa\u0ccd\u200c\u0c97\u0cc6 \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",placeholderText:"4 - \u0c85\u0c82\u0c95\u0cc6\u0c97\u0cb3 \u0cb7\u0cc7\u0cb0\u0cc1 \u0c95\u0ccb\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1"},success:{desc:"\u0cb8\u0cc7\u0cb5\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf",p1:"\u0c9c\u0cbf\u0caa\u0ccd \u0cab\u0cc8\u0cb2\u0ccd",p2:"\u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cc6 \u0c95\u0ccb\u0ca1\u0ccd",p3:"\u0cb8\u0cc7\u0cb5\u0cbe \u0caa\u0cc2\u0cb0\u0cc8\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",summary:"\u0c87\u0ca6\u0cc1 \u0cb8\u0cc7\u0cb5\u0cbe \u0caa\u0cc2\u0cb0\u0cc8\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cbf\u0c97\u0cc6 / \u0c86\u0cab\u0ccd \u0cb2\u0cc8\u0ca8\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0c95\u0ccb\u0cb0\u0cc1\u0cb5 \u0c98\u0c9f\u0c95\u0c97\u0cb3\u0cbf\u0c97\u0cc6 (OVSE) \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5 \u0c85\u0c97\u0ca4\u0ccd\u0caf \u0cac\u0cbe\u0cb0\u0ca6\u0cc6  \u0c86\u0cab\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cb8\u0ccc\u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."},descTextStep1:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cc7\u0caa\u0cb0\u0ccd\u200c\u0cb2\u0cc6\u0cb8\u0ccd \u0c86\u0cab\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0c87-\u0c95\u0cc6\u0cb5\u0cc8\u0cb8\u0cbf \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cb9\u0cc1\u0ca6\u0cbe\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1, \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c86\u0cab\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c87\u0ca6\u0cc1 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8, \u0cab\u0ccb\u0c9f\u0ccb, \u0cb2\u0cbf\u0c82\u0c97, DoB, \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0cb9\u0ccd\u0caf\u0cbe\u0cb6\u0ccd \u0cae\u0cbe\u0ca6\u0cbf\u0cb0\u0cbf, \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0cb9\u0ccd\u0caf\u0cbe\u0cb6\u0ccd \u0cae\u0cbe\u0ca6\u0cbf\u0cb0\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0c95\u0cca\u0ca8\u0cc6\u0caf 4 \u0c85\u0c82\u0c95\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0cb3\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb0\u0cc6\u0cab\u0cb0\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd \u0c90\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0cbf\u0c9c\u0cbf\u0c9f\u0cb2\u0ccd \u0cb8\u0cb9\u0cbf \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 XML \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cae\u0caf\u0ca6 \u0cb8\u0ccd\u0c9f\u0ccd\u0caf\u0cbe\u0c82\u0caa\u0ccd \u0c88 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0cb3\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",descTextStep2:"\u0c86\u0cab\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd eKYC \u0c97\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae ZIP \u0cab\u0cc8\u0cb2\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6"},lockUnlockBiometrics:{serviceCard:{errorMessage:"\u0ca8\u0cbe\u0cb5\u0cc1 \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0cb2\u0cbe\u0c95\u0ccd/\u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0cb5\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cbf."},howItWorks:{title:"\u0cb2\u0cbe\u0c95\u0ccd/\u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0cb9\u0cc7\u0c97\u0cc6 \u0c95\u0cc6\u0cb2\u0cb8 \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6",description:"\u0cac\u0caf\u0ccb \u0cb2\u0cbe\u0c95\u0ccd/\u0c85\u0ca8\u0ccd \u0cb2\u0cbe\u0c95\u0ccd \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0cb5\u0cc1 \u0cb0\u0cc6\u0cb8\u0cbf\u0ca1\u0cc6\u0c82\u0c9f\u0ccd\u0cb8\u0ccd \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe\u0ca6 \u0cb8\u0c82\u0cad\u0cbe\u0cb5\u0ccd\u0caf \u0ca6\u0cc1\u0cb0\u0cc1\u0caa\u0caf\u0ccb\u0c97\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3 \u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0ca3\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0ca1\u0cc6\u0c97\u0c9f\u0ccd\u0c9f\u0cb2\u0cc1 \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0cb9\u0cbe\u0c97\u0cc6 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0c82\u0ca4\u0cc6 \u0c88 \u0cb8\u0cc7\u0cb5\u0cc6\u0caf \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cbf\u0c97\u0cc6 \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6 \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",infoData:{stepOneDescription:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0c88 \u0cb8\u0cc7\u0cb5\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd\u0c85\u0ca8\u0ccd\u0ca8\u0cc1 (\u0cac\u0cc6\u0cb0\u0cb3\u0c9a\u0ccd\u0c9a\u0cc1, \u0c90\u0cb0\u0cbf\u0cb8\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cad\u0cbe\u0cb5\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0) \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6\u0cbe\u0c97, \u0c85\u0cb5\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0c86\u0ca6\u0cb0\u0cc6, OTP-\u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5\u0c82\u0ca4\u0cc6 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",stepTwoDescription:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c88 \u0caa\u0cc1\u0c9f\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cbf \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbf\u0cb0\u0cbf. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 (\u0cab\u0cbf\u0c82\u0c97\u0cb0\u0ccd\u200c\u0caa\u0ccd\u0cb0\u0cbf\u0c82\u0c9f\u0ccd + \u0c90\u0cb0\u0cbf\u0cb8\u0ccd + \u0cad\u0cbe\u0cb5\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0) OTP \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0ca6\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."}},selectionScreen:{unlockCard:{heading:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",consentText:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, \u0ca8\u0cbe\u0ca8\u0cc1 \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0c8e\u0c82\u0ca6\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c85\u0cb0\u0ccd\u0ca5\u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6.",label:"\u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},lockCard:{heading:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",consentText:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, \u0ca8\u0cbe\u0ca8\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2 \u0c8e\u0c82\u0ca6\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c85\u0cb0\u0ccd\u0ca5\u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6.",label:"\u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},selectOptionError:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c92\u0c82\u0ca6\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0cb0\u0cbf\u0cb8\u0cbf.",selectButton:{tempUnlock:"\u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbe\u0ca4\u0ccd\u0c95\u0cbe\u0cb2\u0cbf\u0c95\u0cb5\u0cbe\u0c97\u0cbf \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",tempUnlockInfo:"\u0c85\u0cb2\u0ccd\u0caa \u0c85\u0cb5\u0ca7\u0cbf\u0c97\u0cc6",unlock:"\u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb6\u0cbe\u0cb6\u0ccd\u0cb5\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",unlockInfo:"\u0cae\u0cc1\u0c82\u0ca6\u0cbf\u0ca8 \u0cac\u0cbe\u0cb0\u0cbf \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cb5\u0cb0\u0cc6\u0c97\u0cc6"}},successScreen:{tempUnlockMessage:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb6\u0cbe\u0cb6\u0ccd\u0cb5\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0c88 \u0cb8\u0cc7\u0cb5\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cc1\u0ca8\u0c83 \u0cad\u0cc7\u0c9f\u0cbf \u0cae\u0cbe\u0ca1\u0cbf."}},lockUnlockAadhaar:{howItWorks:{title:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb2\u0cbe\u0c95\u0ccd/\u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cb9\u0cc7\u0c97\u0cc6 \u0c95\u0cc6\u0cb2\u0cb8 \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6",infoData:{stepOneLabel:"\u0cb9\u0c82\u0ca4 3 \u0cb0\u0cb2\u0ccd\u0cb2\u0cbf 1: ",stepOneDescription:"\u0cb2\u0cbe\u0c95\u0ccd / \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u0c97\u0cc6 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 16-\u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 \u0cb5\u0cb0\u0ccd\u0c9a\u0cc1\u0cb5\u0cb2\u0ccd \u0c90\u0ca1\u0cbf (\u0cb5\u0cbf\u0c90\u0ca1\u0cbf) \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf, \u0c8f\u0c95\u0cc6\u0c82\u0ca6\u0cb0\u0cc6 \u0cb5\u0cbf\u0c90\u0ca1\u0cbf \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 / \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cb8\u0cbe\u0cae\u0cb0\u0ccd\u0ca5\u0ccd\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0ca6\u0cc6. \u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd \u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cbf\u0c82\u0ca6 \u0cb5\u0cb0\u0ccd\u0c9a\u0cc1\u0cb5\u0cb2\u0ccd ID \u0cb8\u0cc7\u0cb5\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c89\u0ca4\u0ccd\u0caa\u0cbe\u0ca6\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe 1947 \u0c95\u0ccd\u0c95\u0cc6 SMS \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cc0\u0cb5\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. RVID [UID \u0caf \u0c95\u0cca\u0ca8\u0cc6\u0caf 4 \u0c85\u0ca5\u0cb5\u0cbe 8 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3\u0cc1] {\u0c89\u0ca6\u0cbe: RVID 1234}. ",stepOneLinkText:" VID \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",stepTwoLabel:"\u0cb9\u0c82\u0ca4 3 \u0cb0\u0cb2\u0ccd\u0cb2\u0cbf 2: ",stepTwoDescription:"\u0c92\u0cae\u0ccd\u0cae\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c88 \u0caa\u0cc1\u0c9f\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae VID \u0caf\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbf\u0cb0\u0cbf, \u0ca8\u0c82\u0ca4\u0cb0 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0c97 \u0ca8\u0cbf\u0cae\u0ccd\u0cae VID \u0caf\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf, \u0c8f\u0c95\u0cc6\u0c82\u0ca6\u0cb0\u0cc6 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 \u0ca8\u0cbf\u0cb7\u0ccd\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",stepThreeLabel:"\u0cb9\u0c82\u0ca4 3 \u0cb0\u0cb2\u0ccd\u0cb2\u0cbf 3: ",stepThreeDescription:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c88 \u0caa\u0cc1\u0c9f\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbf\u0cb0\u0cbf; \u0c95\u0cc7\u0cb5\u0cb2 VID \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cb8\u0cbe\u0cae\u0cb0\u0ccd\u0ca5\u0ccd\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0ca6\u0cc6, \u0c86\u0ca6\u0cb0\u0cc6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cc1\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb9 \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."}},formScreen:{title:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd/\u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",radioLabels:{lockAadhaar:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",unlockAadhaar:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},consent:{lockConsent:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, \u0ca8\u0cbe\u0ca8\u0cc1 \u0c95\u0cc7\u0cb5\u0cb2 \u0cb5\u0cb0\u0ccd\u0c9a\u0cc1\u0cb5\u0cb2\u0ccd \u0c90\u0ca1\u0cbf (VID) \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0cbf\u0c82\u0ca6\u0cb2\u0ccd\u0cb2 \u0c8e\u0c82\u0ca6\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c85\u0cb0\u0ccd\u0ca5\u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6.",unlockConsent:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, \u0ca8\u0cbe\u0ca8\u0cc1 \u0cb5\u0cb0\u0ccd\u0c9a\u0cc1\u0cb5\u0cb2\u0ccd \u0c90\u0ca1\u0cbf (VID) \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c8e\u0cb0\u0ca1\u0ca8\u0ccd\u0ca8\u0cc2 \u0cac\u0cb3\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0c8e\u0c82\u0ca6\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c85\u0cb0\u0ccd\u0ca5\u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6."},textFields:{name:"\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",pincode:"\u0caa\u0cbf\u0ca8\u0ccd\u200c\u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf"}}},verifyEmailMobile:{desc:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c87\u0cae\u0cc7\u0cb2\u0ccd / \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",verifyMobile:"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",verifyEmail:"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",verifyEmailMobile:"\u0c87\u0cae\u0cc7\u0cb2\u0ccd/\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf"},bankLinkingStatus:{sectionTitle:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c9c\u0ccb\u0ca1\u0ca3\u0cc6 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",aadhaarNumber:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",bankLinkingStatus:"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c9c\u0ccb\u0ca1\u0ca3\u0cc6 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf",active:"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf",inactive:"\u0ca8\u0cbf\u0cb7\u0ccd\u0c95\u0ccd\u0cb0\u0cbf\u0caf",prevBankDetails:"\u0cb9\u0cbf\u0c82\u0ca6\u0cbf\u0ca8 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c9c\u0ccb\u0ca1\u0ca3\u0cc6\u0caf \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1",lastUpdatedDate:"\u0c95\u0cca\u0ca8\u0cc6\u0caf\u0ca6\u0cbe\u0c97\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95",failureMessage:"\u0c88 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0c97\u0cc6 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cae\u0ccd\u0caf\u0cbe\u0caa\u0cbf\u0c82\u0c97\u0ccd \u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0c95\u0c82\u0ca1\u0cc1\u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2",successMessage:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd-\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cae\u0ccd\u0caf\u0cbe\u0caa\u0cbf\u0c82\u0c97\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",disclaimer:"\u0c8e\u0ca8\u0ccd.\u0caa\u0cbf.\u0cb8\u0cbf.\u0c90 \u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd\u0ca8\u0cbf\u0c82\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0caa\u0cb0\u0cbf\u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf, \u0caa\u0ccd\u0cb0\u0ca6\u0cb0\u0ccd\u0cb6\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0c97\u0cc6 \u0caf\u0cc1.\u0c90.\u0ca1\u0cbf.\u0c8e.\u0c90 \u0c9c\u0cb5\u0cbe\u0cac\u0ccd\u0ca6\u0cbe\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0c87\u0ca6\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6, \u0caf\u0cc1.\u0c90.\u0ca1\u0cbf.\u0c8e.\u0c90 \u0c8e\u0ca8\u0ccd.\u0caa\u0cbf.\u0cb8\u0cbf.\u0c90 \u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd\u0ca8\u0cbf\u0c82\u0ca6 \u0caa\u0ca1\u0cc6\u0ca6 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.",noRecordsAvailable:"\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2",checkWithBank:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf"},bankSeedingStatus:{AadhaarNumber:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",BankName:"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1",BankSeedingStatus:"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb8\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf",LastUpdatedDate:"\u0c95\u0cca\u0ca8\u0cc6\u0caf\u0ca6\u0cbe\u0c97\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95",noRecordAlert:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",note:"\u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ccd\u0caf\u0cbe\u0cb7\u0ca8\u0cb2\u0ccd \u0caa\u0cc7\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0caa\u0cca\u0cb0\u0cc7\u0cb7\u0ca8\u0ccd \u0c86\u0cab\u0ccd \u0c87\u0c82\u0ca1\u0cbf\u0caf\u0cbe\u0ca6 (NPCI) \u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd\u0ca8\u0cbf\u0c82\u0ca6 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c85\u0ca6\u0cb0 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0cb5\u0cc1\u0ca6\u0c95\u0ccd\u0c95\u0cc6 UIDAI \u0c9c\u0cb5\u0cbe\u0cac\u0ccd\u0ca6\u0cbe\u0cb0\u0ca8\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0caa\u0ca1\u0cc6\u0ca6 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 UIDAI \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cbf\u0cb2\u0ccd\u0cb2.",ActiveText:"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf",InactiveText:"\u0ca8\u0cbf\u0cb7\u0ccd\u0c95\u0ccd\u0cb0\u0cbf\u0caf"},FAQ:{checkAadhaarPvcCardOrderStatus:[{question:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8 \u0cb5\u0cbf\u0cb5\u0cbf\u0ca7 \u0cb0\u0cc2\u0caa\u0c97\u0cb3\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0cb5\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0cb5\u0cc1\u0c97\u0cb3 \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0cb5\u0cc1?",answer:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8 \u0cb5\u0cbf\u0cb5\u0cbf\u0ca7 \u0cb0\u0cc2\u0caa\u0c97\u0cb3\u0cc6\u0c82\u0ca6\u0cb0\u0cc6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0ca4\u0ccd\u0cb0, \u0c86\u0ca7\u0cbe\u0cb0\u0ccd PVC \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd, eAadhaar \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 mAadhaar. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb0\u0cc2\u0caa\u0c97\u0cb3\u0cc1 \u0cb8\u0cae\u0cbe\u0ca8\u0cb5\u0cbe\u0c97\u0cbf \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cbe\u0cb0\u0cbe\u0cb0\u0ccd\u0cb9\u0cb5\u0cbe\u0c97\u0cbf\u0cb5\u0cc6."},{question:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb0\u0cc2\u0caa\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0cb3\u0cb8\u0cb2\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc7?",answer:"\u0cb9\u0ccc\u0ca6\u0cc1"},{question:"'\u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd PVC \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd' \u0cb8\u0cc7\u0cb5\u0cc6 \u0c8e\u0c82\u0ca6\u0cb0\u0cc7\u0ca8\u0cc1?",answer:"\u201c\u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd\u201d \u0caf\u0cc1\u0c90\u0ca1\u0cbf\u0c8e\u0c90 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf\u0ca6 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1, \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0ca8\u0cbe\u0cae\u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca4\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0ca8\u0cc1\u0c95\u0cc2\u0cb2\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."},{question:"'\u0c86\u0ca7\u0cbe\u0cb0\u0ccd PVC \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd' \u0ca8 \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0cb5\u0cc1?",answer:"'\u0c88 \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0cb3\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0cc6:\n1. \u0c9f\u0ccd\u0caf\u0cbe\u0c82\u0caa\u0cb0\u0ccd \u0caa\u0ccd\u0cb0\u0cc2\u0cab\u0ccd QR \u0c95\u0ccb\u0ca1\u0ccd\n2. \u0cb9\u0cca\u0cb2\u0cca\u0c97\u0ccd\u0cb0\u0cbe\u0cae\u0ccd\n3. \u0cb8\u0cc2\u0c95\u0ccd\u0cb7\u0ccd\u0cae \u0caa\u0ca0\u0ccd\u0caf\n4. \u0caa\u0ccd\u0cb0\u0cc7\u0ca4 \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\n5. \u0cb8\u0c82\u0c9a\u0cbf\u0c95\u0cc6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0ca3 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\n6. \u0c97\u0cbf\u0cb2\u0ccb\u0c9a\u0cc6 \u0caa\u0ccd\u0caf\u0cbe\u0c9f\u0cb0\u0ccd\u0ca8\u0ccd\n7. \u0c8e\u0c82\u0cac\u0ccb\u0cb8\u0ccd\u0ca1\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb2\u0ccb\u0c97\u0ccb'"},{question:"'\u0c86\u0ca7\u0cbe\u0cb0\u0ccd PVC \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd' \u0c97\u0cbe\u0c97\u0cbf \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cbe\u0ca6 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0cb5\u0cc1?",answer:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cbe\u0ca6 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0cc1 \u0cb0\u0cc2.50/- (\u0c9c\u0cbf\u0c8e\u0cb8\u0ccd\u0c9f\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0caa\u0cc0\u0ca1\u0ccd \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0cb3\u0c97\u0cca\u0c82\u0ca1\u0c82\u0ca4\u0cc6)."},{question:"'\u0c86\u0ca7\u0cbe\u0cb0\u0ccd PVC \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd' \u0c97\u0cbe\u0c97\u0cbf \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",answer:"UIDAI \u0c85\u0ca7\u0cbf\u0c95\u0cc3\u0ca4 \u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd (https://www.uidai.gov.in \u0c85\u0ca5\u0cb5\u0cbe https://myaadhaar.uidai.gov.in) \u0c85\u0ca5\u0cb5\u0cbe mAadhaar \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd\u200c\u0c97\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 ''\u0c86\u0ca7\u0cbe\u0cb0\u0ccd PVC \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd' \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1"},{question:"\u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1?",answer:"'1. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 https://uidai.gov.in \u0c85\u0ca5\u0cb5\u0cbe https://myaadhaar.uidai.gov.in/genricPVC \u0c97\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf.\n2. \u0ca8\u0cbf\u0cae\u0ccd\u0cae 12 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 (UID) \u0c85\u0ca5\u0cb5\u0cbe 28 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 \u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf \u0c90\u0ca1\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.\n3. \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf\n4. \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0caa\u0ca1\u0cc6\u0ca6 OTP \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.\n5. '\u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb7\u0cb0\u0ca4\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0cc1' \u0cb5\u0cbf\u0cb0\u0cc1\u0ca6\u0ccd\u0ca7 \u0c9a\u0cc6\u0c95\u0ccd \u0cac\u0cbe\u0c95\u0ccd\u0cb8\u0ccd \u0cae\u0cc7\u0cb2\u0cc6 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. (\u0c97\u0cae\u0ca8\u0cbf\u0cb8\u0cbf: \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ccb\u0ca1\u0cb2\u0cc1 \u0cb9\u0cc8\u0caa\u0cb0\u0ccd \u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf).\n6. OTP \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 '\u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cc1' \u0cac\u0c9f\u0ca8\u0ccd \u0cae\u0cc7\u0cb2\u0cc6 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.\n7. \u0cae\u0cc1\u0c82\u0ca6\u0cbf\u0ca8 \u0caa\u0cb0\u0ca6\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf, \u0cae\u0cb0\u0cc1\u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0c86\u0ca6\u0cc7\u0cb6\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cb3 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3 \u0caa\u0cc2\u0cb0\u0ccd\u0cb5\u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0ca3\u0cc6 \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\n8. '\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cbf' \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0c95\u0ccd\u0cb0\u0cc6\u0ca1\u0cbf\u0c9f\u0ccd/\u0ca1\u0cc6\u0cac\u0cbf\u0c9f\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd, \u0ca8\u0cc6\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 UPI \u0ca8\u0c82\u0ca4\u0cb9 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0c97\u0cc7\u0c9f\u0ccd\u200c\u0cb5\u0cc7 \u0caa\u0cc1\u0c9f\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cb0\u0cc1\u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cc7\u0cb6\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\n9. \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0caf \u0ca8\u0c82\u0ca4\u0cb0, \u0ca1\u0cbf\u0c9c\u0cbf\u0c9f\u0cb2\u0ccd \u0cb8\u0cb9\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb0\u0cb6\u0cc0\u0ca6\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c89\u0ca4\u0ccd\u0caa\u0cbe\u0ca6\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cb3\u0cc1 PDF \u0cb8\u0ccd\u0cb5\u0cb0\u0cc2\u0caa\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cb3\u0cc1 SMS \u0cae\u0cc2\u0cb2\u0c95 \u0cb8\u0cc7\u0cb5\u0cbe \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb9 \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6.\n10. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0cb0\u0cb5\u0cbe\u0ca8\u0cc6\u0caf\u0cbe\u0c97\u0cc1\u0cb5\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 SRN \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c9f\u0ccd\u0cb0\u0ccd\u0caf\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.\n11. \u0c8e\u0ca1\u0cac\u0ccd\u0cb2\u0ccd\u0caf\u0cc2\u0cac\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5 \u0c8e\u0cb8\u0ccd\u200c\u0c8e\u0c82\u0c8e\u0cb8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0cae\u0ccd\u0cae\u0cc6 \u0ca1\u0cbf\u0c92\u0caa\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. DoP \u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd\u200c\u0c97\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0ca1\u0cc6\u0cb2\u0cbf\u0cb5\u0cb0\u0cbf \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cb7\u0ccd\u0c9f\u0cc1 \u0c9f\u0ccd\u0cb0\u0ccd\u0caf\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1."},{question:"\u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4\u0cb5\u0cb2\u0ccd\u0cb2\u0ca6/\u0caa\u0cb0\u0ccd\u0caf\u0cbe\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1?",answer:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 https://uidai.gov.in \u0c97\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf \u0c85\u0ca5\u0cb5\u0cbe https://myaadhaar.uidai.gov.in/genricPVC '\u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd' \u0cb8\u0cc7\u0cb5\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe mAadhaar \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae 12 \u0c85\u0c82\u0c95\u0cc6\u0c97\u0cb3 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 (UID) \u0c85\u0ca5\u0cb5\u0cbe 28 \u0c85\u0c82\u0c95\u0cc6\u0c97\u0cb3 \u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf ID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf \u0c9a\u0cc6\u0c95\u0ccd \u0cac\u0cbe\u0c95\u0ccd\u0cb8\u0ccd \u0cae\u0cc7\u0cb2\u0cc6 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf '\u0ca8\u0cc0\u0cb5\u0cc1 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4\u0cb5\u0cb2\u0ccd\u0cb2\u0ca6 / \u0caa\u0cb0\u0ccd\u0caf\u0cbe\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c89\u0cb3\u0cbf\u0ca6 \u0cb9\u0c82\u0ca4\u0c97\u0cb3\u0cc1 \u0c92\u0c82\u0ca6\u0cc7 \u0c86\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6."},{question:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0caf\u0cbe\u0cb5 \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0c97\u0cb3\u0cc1 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6?",answer:"'\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4, \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0c97\u0cb3\u0cc1 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6:-\n\u0c95\u0ccd\u0cb0\u0cc6\u0ca1\u0cbf\u0c9f\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd\n\u0ca1\u0cc6\u0cac\u0cbf\u0c9f\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd\n\u0ca8\u0cc6\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0cbf\u0c82\u0c97\u0ccd\nUPI\nPayTM'"},{question:"SRN \u0c8e\u0c82\u0ca6\u0cb0\u0cc7\u0ca8\u0cc1?",answer:"SRN 14 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 \u0cb8\u0cc7\u0cb5\u0cbe \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1, \u0c87\u0ca6\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 '\u0caa\u0cc1\u0ca8\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cc1' \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0caf\u0cc1 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."},{question:"AWB \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c8e\u0c82\u0ca6\u0cb0\u0cc7\u0ca8\u0cc1?",answer:"\u0c8f\u0cb0\u0ccd\u200c\u0cb5\u0cc7 \u0cac\u0cbf\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0cc1 \u0c85\u0cb5\u0cb0\u0cc1 \u0cb5\u0cbf\u0ca4\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0ca8\u0cc6/\u0c89\u0ca4\u0ccd\u0caa\u0ca8\u0ccd\u0ca8\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf DoP \u0c85\u0c82\u0ca6\u0cb0\u0cc6 \u0c87\u0c82\u0ca1\u0cbf\u0caf\u0cbe \u0cb8\u0ccd\u0caa\u0cc0\u0ca1\u0ccd \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0c9f\u0ccd\u0cb0\u0ccd\u0caf\u0cbe\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6."},{question:"\u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cb3\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cae\u0c97\u0cc6 \u0cac\u0cc7\u0c95\u0cbe\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6 \u0c8f\u0ca8\u0cc1 \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0c95\u0cc1?",answer:"\u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cb3\u0cc1 \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbf\u0ca4 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0ca4\u0ccd\u0cb0 \u0c85\u0ca5\u0cb5\u0cbe PVC \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0caf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6, \u0ca8\u0c82\u0ca4\u0cb0 \u0c85\u0cb5\u0cb0\u0cc1 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca4\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb6\u0cbe\u0cb6\u0ccd\u0cb5\u0ca4 \u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0 \u0c85\u0ca5\u0cb5\u0cbe SSUP \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd\u200c\u0c97\u0cc6 (\u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd\u200c\u0c97\u0cc6 \u0c85\u0ca8\u0cc1\u0c97\u0cc1\u0ca3\u0cb5\u0cbe\u0c97\u0cbf) \u0cad\u0cc7\u0c9f\u0cbf \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0c82\u0ca4\u0cb0 \u0c88 \u0cb8\u0ccc\u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0c88 \u0cb8\u0ccc\u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd PVC \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd/\u0caa\u0ca4\u0ccd\u0cb0\u0ca6 \u0cb9\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c95\u0cbe\u0caa\u0cbf"},{question:"\u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 '\u0c86\u0ca7\u0cbe\u0cb0\u0ccd PVC \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd' \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c8e\u0cb7\u0ccd\u0c9f\u0cc1 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6?",answer:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cbf\u0c82\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd PVC \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cbe\u0c97\u0cbf \u0c86\u0ca6\u0cc7\u0cb6\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, UIDAI \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbf\u0ca4 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 5 \u0c95\u0cc6\u0cb2\u0cb8\u0ca6 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf (\u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0cb0\u0ca4\u0cc1\u0caa\u0ca1\u0cbf\u0cb8\u0cbf) DoP \u0c97\u0cc6 \u0cb9\u0cb8\u0ccd\u0ca4\u0cbe\u0c82\u0ca4\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe\u0cac\u0cc7\u0cb8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0c95\u0ccd\u0c95\u0cc6 \u0c85\u0cb8\u0ccd\u0ca4\u0cbf\u0ca4\u0ccd\u0cb5\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb5\u0cbf\u0ca4\u0cb0\u0ca3\u0cbe \u0cae\u0cbe\u0ca8\u0ca6\u0c82\u0ca1\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c85\u0ca8\u0cc1\u0c97\u0cc1\u0ca3\u0cb5\u0cbe\u0c97\u0cbf \u0cad\u0cbe\u0cb0\u0ca4\u0cc0\u0caf \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd\u200c\u0ca8 \u0cb8\u0ccd\u0caa\u0cc0\u0ca1\u0ccd \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cb2\u0cc1\u0caa\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 https://www.indiapost.gov.in/_layouts/15/dop.portal.track \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf DoP \u0c9f\u0ccd\u0cb0\u0ccd\u0caf\u0cbe\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0ca1\u0cc6\u0cb2\u0cbf\u0cb5\u0cb0\u0cbf \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c9f\u0ccd\u0cb0\u0ccd\u0caf\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1"}],verifyEmailMobile:[{question:"\u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd\u200c\u0c97\u0cc6 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0cb5\u0cbf\u0ca6\u0cc6\u0caf\u0cc7?",answer:"\u0cb9\u0ccc\u0ca6\u0cc1, \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb0\u0cc2. 50/- (GST \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6\u0c82\u0ca4\u0cc6)."}],orderAadhaarPvcCard:[{question:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0c87-\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbf\u0c82\u0ca6 \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",answer:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 UIDAI \u0ca8 MyAadhaar \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cbe- https://myaadhaar.uidai.gov.in \u0c97\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cab\u0ccb\u0ca8\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf mAadhaar \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0cac\u0cb3\u0cb8\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0c87-\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1."}],retrieveEidAadhaarNumber:[{question:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c8e\u0cb7\u0ccd\u0c9f\u0cc1 \u0cac\u0cbe\u0cb0\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",answer:"'\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cc6 \u0c88 \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 \u0cae\u0cbf\u0ca4\u0cbf\u0c97\u0cb3\u0cc1 \u0c85\u0ca8\u0ccd\u0cb5\u0caf\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6: \n\u2022 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1: \u0c9c\u0cc0\u0cb5\u0cbf\u0ca4\u0cbe\u0cb5\u0ca7\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0c8e\u0cb0\u0ca1\u0cc1 \u0cac\u0cbe\u0cb0\u0cbf \n\u2022 \u0cb2\u0cbf\u0c82\u0c97: \u0c9c\u0cc0\u0cb5\u0ca8\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c92\u0cae\u0ccd\u0cae\u0cc6 \n\u2022 \u0cb9\u0cc1\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95: \u0c9c\u0cc0\u0cb5\u0ca8\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c92\u0cae\u0ccd\u0cae\u0cc6'"},{question:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ca8\u0ccd\u0ca8 \u0cb9\u0cc6\u0cb8\u0cb0\u0cbf\u0c97\u0cc6 \u0ca8\u0cbe\u0ca8\u0cc1 \u0caf\u0cbe\u0cb5 \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",answer:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cc6\u0cb8\u0cb0\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0ca3\u0ccd\u0ca3\u0caa\u0cc1\u0c9f\u0ccd\u0c9f \u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1\u0caa\u0ca1\u0cbf\u0c97\u0cb3\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0c97\u0cbe\u0c97\u0cbf, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c95\u0ccd\u0c95\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf."},{question:"\u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cc6 \u0caf\u0cbe\u0cb5 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6?",answer:"\u0caa\u0ccb\u0cb7\u0c95 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0caf \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0 POA \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6. https://uidai.gov.in \u0c97\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf."},{question:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0cb5\u0cc1?",answer:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cbe\u0ca6 \u0caa\u0ccb\u0cb7\u0c95 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0cb8\u0cc2\u0c95\u0ccd\u0ca4\u0cb5\u0cbe\u0ca6 \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0ca1\u0cc7\u0c9f\u0cbe \u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1\u0caa\u0ca1\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cc8\u0c97\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5\u0cbe\u0c97 \u0c85\u0ca6\u0cb0 \u0cb8\u0ccd\u0c95\u0ccd\u0caf\u0cbe\u0ca8\u0ccd/\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cbf."},{question:"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0caf \u0cb8\u0c82\u0ca6\u0cb0\u0ccd\u0cad\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ca8\u0ccd\u0ca8 \u0caa\u0ccb\u0cb7\u0c95 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",answer:"\u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf pdf \u0c85\u0ca5\u0cb5\u0cbe jpeg \u0cb8\u0ccd\u0cb5\u0cb0\u0cc2\u0caa\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0caa\u0ccb\u0cb7\u0c95 \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd\u200c\u0ca8 \u0cb8\u0ccd\u0c95\u0ccd\u0caf\u0cbe\u0ca8\u0ccd/\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cc7\u0cb3\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0caa\u0ccb\u0cb7\u0c95 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd, \u0cac\u0cbe\u0ca1\u0cbf\u0c97\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c86\u0cb8\u0ccd\u0ca4\u0cbf \u0c92\u0caa\u0ccd\u0caa\u0c82\u0ca6\u0ca6\u0c82\u0ca4\u0cb9 \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf, \u0cac\u0cb9\u0cc1 \u0caa\u0cc1\u0c9f\u0c97\u0cb3 \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0ca6 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6."},{question:"\u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cbe\u0ca8\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0cad\u0cbe\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc7?",answer:"\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0cad\u0cbe\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2."},{question:"\u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cbe\u0ca8\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0c9c\u0ca8\u0ccd\u0cae \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc7?",answer:"\u0c87\u0cb2\u0ccd\u0cb2, \u0c9c\u0ca8\u0ccd\u0cae \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 (DoB) \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 DoB \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c95\u0ccd\u0c95\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf."},{question:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0c88\u0c97\u0cbe\u0c97\u0cb2\u0cc7 \u0ca8\u0ca8\u0ccd\u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c9c\u0ca8\u0ccd\u0cae \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0cae\u0ccd\u0cae\u0cc6 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6. \u0ca8\u0cbe\u0ca8\u0cc1 \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc7 / \u0cb8\u0cb0\u0cbf\u0caa\u0ca1\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc7?",answer:"\u0c87\u0cb2\u0ccd\u0cb2. \u0ca8\u0cc0\u0cb5\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9c\u0ca8\u0ccd\u0cae \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 (DoB) \u0c92\u0cae\u0ccd\u0cae\u0cc6 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c85\u0cb8\u0cbe\u0ca7\u0cbe\u0cb0\u0ca3 \u0cb8\u0c82\u0ca6\u0cb0\u0ccd\u0cad\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0c9c\u0ca8\u0ccd\u0cae \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 (DoB) \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1, \u0c88 \u0ca8\u0cbf\u0c9f\u0ccd\u0c9f\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 1947 \u0c97\u0cc6 \u0c95\u0cb0\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf."},{question:"\u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0c95\u0cc6\u0caf\u0cc1 \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c96\u0cbe\u0ca4\u0cb0\u0cbf\u0caa\u0ca1\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6\u0caf\u0cc7?",answer:"\u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0c95\u0cc6\u0caf\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe\u0ca6 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c96\u0cbe\u0ca4\u0cb0\u0cbf\u0caa\u0ca1\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 UIDAI \u0caf\u0cbf\u0c82\u0ca6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c8a\u0cb0\u0ccd\u0c9c\u0cbf\u0ca4\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5\u0cbf\u0c95\u0cc6\u0c97\u0cc6 \u0c92\u0cb3\u0caa\u0ca1\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0ccc\u0cb2\u0ccd\u0caf\u0cc0\u0c95\u0cb0\u0ca3\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0caf \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd\u200c\u0c97\u0cbe\u0c97\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cb7\u0ccd\u0c9f\u0cc1 \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."},{question:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cb3\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6/ \u0ca8\u0cbe\u0ca8\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca8\u0ca8\u0ccd\u0ca8 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1?",answer:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c95\u0cb3\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6/\u0c87\u0cb2\u0ccd\u0cb2\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c95\u0ccd\u0c95\u0cc6 \u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95\u0cb5\u0cbe\u0c97\u0cbf \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cac\u0cc7\u0c95\u0cc1."},{question:"\u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 \u0ca8\u0ca8\u0ccd\u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6\u0caf\u0cc7?",answer:"\u0c87\u0cb2\u0ccd\u0cb2, \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0\u0cb5\u0cc2 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c92\u0c82\u0ca6\u0cc7 \u0c86\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."},{question:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6. \u0ca8\u0cbe\u0ca8\u0cc1 \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6\u0caf\u0cc7?",answer:"\u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0ca8\u0ca8\u0ccd\u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 '\u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cb3\u0cc1' \u0c9c\u0cbe\u0c97\u0ca6\u0cbf\u0c82\u0ca6 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6, \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf\u0ca6 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 21 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0cae\u0cb0\u0cc1\u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."},{question:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ccb\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1? ",answer:"\u0cae\u0cc8\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 '\u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cb3\u0cc1' \u0c9c\u0cbe\u0c97\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cca\u0cac\u0ccd\u0cac\u0cb0\u0cc1 \u0c85\u0cb5\u0ca8/\u0c85\u0cb5\u0cb3 \u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1."},{question:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0ca4\u0c82\u0ca6\u0cc6\u0caf / \u0c97\u0c82\u0ca1\u0ca8 \u0cb9\u0cc6\u0cb8\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1?",answer:"\u0cb8\u0c82\u0cac\u0c82\u0ca7\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0c95\u0ccd\u0cb7\u0cc7\u0ca4\u0ccd\u0cb0\u0ca6 \u0c92\u0c82\u0ca6\u0cc1 \u0cad\u0cbe\u0c97\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 C/o (\u0c95\u0cc7\u0cb0\u0ccd \u0c86\u0cab\u0ccd) \u0c97\u0cc6 \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cad\u0cb0\u0ccd\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95."}],eaadhaarDownload:[{question:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c8e\u0c82\u0ca6\u0cb0\u0cc7\u0ca8\u0cc1?",answer:"\u0c87-\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0c8e\u0cb2\u0cc6\u0c95\u0ccd\u0c9f\u0ccd\u0cb0\u0cbe\u0ca8\u0cbf\u0c95\u0ccd \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1, UIDAI \u0ca8\u0cbf\u0c82\u0ca6 \u0ca1\u0cbf\u0c9c\u0cbf\u0c9f\u0cb2\u0ccd \u0cb8\u0cb9\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6."},{question:"\u0c87-\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0c8e\u0cb2\u0cc6\u0c95\u0ccd\u0c9f\u0ccd\u0cb0\u0cbe\u0ca8\u0cbf\u0c95\u0ccd \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1, UIDAI \u0ca8\u0cbf\u0c82\u0ca6 \u0ca1\u0cbf\u0c9c\u0cbf\u0c9f\u0cb2\u0ccd \u0cb8\u0cb9\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.",answer:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cbe\u0caf\u0cbf\u0ca6\u0cc6\u0caf \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0, \u0c87-\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c89\u0ca6\u0ccd\u0ca6\u0cc7\u0cb6\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8 \u0cad\u0ccc\u0ca4\u0cbf\u0c95 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0caf\u0c82\u0ca4\u0cc6 \u0cb8\u0cae\u0cbe\u0ca8\u0cb5\u0cbe\u0c97\u0cbf \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. eAadhaar \u0ca8 \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0ca4\u0cc6\u0c97\u0cbe\u0c97\u0cbf, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 UIDAI \u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ccb\u0cb2\u0cc6\u0c97\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf- https://uidai.gov.in/images/ uidai_om_on_e_aadhaar_validit"},{question:"\u0cae\u0cbe\u0cb8\u0ccd\u0c95\u0ccd\u0ca1\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c8e\u0c82\u0ca6\u0cb0\u0cc7\u0ca8\u0cc1?",answer:"\u0cae\u0cbe\u0cb8\u0ccd\u0c95\u0ccd\u0ca1\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0cae\u0cca\u0ca6\u0cb2 8 \u0c85\u0c82\u0c95\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 'xxxx-xxxx' \u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc2\u0c9a\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0c86\u0ca6\u0cb0\u0cc6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0c95\u0cca\u0ca8\u0cc6\u0caf 4 \u0c85\u0c82\u0c95\u0cc6\u0c97\u0cb3\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0c97\u0ccb\u0c9a\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6."},{question:"\u0c87-\u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca1\u0cbf\u0c9c\u0cbf\u0c9f\u0cb2\u0ccd \u0cb8\u0cb9\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0ccc\u0cb2\u0ccd\u0caf\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6?",answer:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd YouTube \u0c9a\u0cbe\u0ca8\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 https://youtu.be/aVNfUNIccZs?si=ByW1O6BIPMwc0seL \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c9f\u0ccd\u0caf\u0cc1\u0c9f\u0ccb\u0cb0\u0cbf\u0caf\u0cb2\u0ccd \u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cbf"},{question:"\u0c87-\u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c8e\u0c82\u0ca6\u0cb0\u0cc7\u0ca8\u0cc1?",answer:"\u0c87\u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c95\u0ccd\u0caf\u0cbe\u0caa\u0cbf\u0c9f\u0cb2\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8 \u0cb9\u0cc6\u0cb8\u0cb0\u0cbf\u0ca8 \u0cae\u0cca\u0ca6\u0cb2 4 \u0c85\u0c95\u0ccd\u0cb7\u0cb0\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0cc1\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6 \u0cb5\u0cb0\u0ccd\u0cb7 (YYYY) \u0cb8\u0c82\u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.\n\u0c89\u0ca6\u0cbe\u0cb9\u0cb0\u0ca3\u0cc6\u0c97\u0cc6:\n\u0c89\u0ca6\u0cbe\u0cb9\u0cb0\u0ca3\u0cc6 1\n\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 : \u0cb8\u0cc1\u0cb0\u0cc7\u0cb6\u0ccd \u0c95\u0cc1\u0cae\u0cbe\u0cb0\u0ccd\n\u0cb9\u0cc1\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6 \u0cb5\u0cb0\u0ccd\u0cb7: 1990\n\u0caa\u0cbe\u0cb8\u0ccd\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd: SURE1990\n\u0c89\u0ca6\u0cbe\u0cb9\u0cb0\u0ca3\u0cc6 2\n\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 : \u0cb8\u0cbe\u0caf\u0cbf \u0c95\u0cc1\u0cae\u0cbe\u0cb0\u0ccd\n\u0cb9\u0cc1\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6 \u0cb5\u0cb0\u0ccd\u0cb7: 1990\n\u0caa\u0cbe\u0cb8\u0ccd\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd: SAIK1990\n\u0c89\u0ca6\u0cbe\u0cb9\u0cb0\u0ca3\u0cc6 3\n\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 : \u0caa\u0cbf. \u0c95\u0cc1\u0cae\u0cbe\u0cb0\u0ccd\n\u0cb9\u0cc1\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6 \u0cb5\u0cb0\u0ccd\u0cb7: 1990\n\u0caa\u0cbe\u0cb8\u0ccd\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd: P.KU1990\n\u0c89\u0ca6\u0cbe\u0cb9\u0cb0\u0ca3\u0cc6 4\n\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1: RIA\n\u0cb9\u0cc1\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6 \u0cb5\u0cb0\u0ccd\u0cb7: 1990\n\u0caa\u0cbe\u0cb8\u0ccd\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd: RIA1990"},{question:"\u0c87-\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cb2\u0cc1 \u0caf\u0cbe\u0cb5 \u0cac\u0cc6\u0c82\u0cac\u0cb2 \u0cb8\u0cbe\u0cab\u0ccd\u0c9f\u0ccd\u200c\u0cb5\u0cc7\u0cb0\u0ccd \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6?",answer:"'\u0c87-\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cb3\u0cbf\u0c97\u0cc6 '\u0c85\u0ca1\u0ccb\u0cac\u0ccd \u0cb0\u0cc0\u0ca1\u0cb0\u0ccd' \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0cbf\u0cb8\u0ccd\u0c9f\u0c82\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cc0\u0cb5\u0cc1 '\u0c85\u0ca1\u0ccb\u0cac\u0ccd \u0cb0\u0cc0\u0ca1\u0cb0\u0ccd' \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0ca5\u0cbe\u0caa\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf. \u0cb8\u0cbf\u0cb8\u0ccd\u0c9f\u0c82\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c85\u0ca1\u0ccb\u0cac\u0ccd \u0cb0\u0cc0\u0ca1\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0ca5\u0cbe\u0caa\u0cbf\u0cb8\u0cb2\u0cc1\nhttps://get.adobe.com/reader/ \u0c97\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf"},{question:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0c87-\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",answer:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0cae\u0cc2\u0cb0\u0cc1 \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0cc1\u0cb8\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0c87-\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.\n\u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95:\n\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cac\u0cb3\u0cb8\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95:\nVID \u0cac\u0cb3\u0cb8\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95:\n\u0c87\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c92\u0c9f\u0cbf\u0caa\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0c97\u0cc6 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."}],bookAnAppointment:[{question:"UIDAI \u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8 \u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb0\u0ca3\u0cbe \u0c9a\u0cbe\u0ca8\u0cc6\u0cb2\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0cb5\u0cc1?",answer:"\u0cb5\u0ccd\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c97\u0cb3\u0cc1 \u0caf\u0cc1\u0c90\u0ca1\u0cbf\u0c8e\u0c90 \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb9\u0cc1 \u0c9a\u0cbe\u0ca8\u0cc6\u0cb2\u0ccd\u200c\u0c97\u0cb3 \u0cae\u0cc2\u0cb2\u0c95 \u0ca4\u0cb2\u0cc1\u0caa\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cab\u0ccb\u0ca8\u0ccd, \u0c87\u0cae\u0cc7\u0cb2\u0ccd, \u0c9a\u0cbe\u0c9f\u0ccd, \u0caa\u0ca4\u0ccd\u0cb0/\u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd, \u0cb5\u0cc6\u0cac\u0ccd \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd, \u0cb5\u0cbe\u0c95\u0ccd \u0c87\u0ca8\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0cb5\u0cb0 \u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 \u0caa\u0cb0\u0cbf\u0cb9\u0cbe\u0cb0\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0cb8\u0cbe\u0cae\u0cbe\u0c9c\u0cbf\u0c95 \u0cae\u0cbe\u0ca7\u0ccd\u0caf\u0cae.\n\u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0c9a\u0cbe\u0ca8\u0cb2\u0ccd\u200c\u0c97\u0cb3 \u0c95\u0cc1\u0cb0\u0cbf\u0ca4\u0cc1 \u0cb5\u0cbf\u0cb5\u0cb0\u0cb5\u0cbe\u0ca6 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0cc1 \u0c95\u0cc6\u0cb3\u0c95\u0c82\u0ca1\u0c82\u0ca4\u0cbf\u0ca6\u0cc6:\n1. \u0cab\u0ccb\u0ca8\u0ccd \u0c95\u0cb0\u0cc6 (\u0c9f\u0ccb\u0cb2\u0ccd \u0cab\u0ccd\u0cb0\u0cc0 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6) -\n\u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0c97\u0cc6 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0cb8\u0cbf\u0ca6 \u0c95\u0cbe\u0cb3\u0c9c\u0cbf\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0cb5\u0ccd\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c97\u0cb3\u0cc1 UIDAI \u0c9f\u0ccb\u0cb2\u0ccd \u0cab\u0ccd\u0cb0\u0cc0 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 (1947) \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. UIDAI \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cb5\u0cc1 \u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0cb8\u0cc7\u0cb5\u0cbe IVRS (\u0c87\u0c82\u0c9f\u0cb0\u0cbe\u0c95\u0ccd\u0c9f\u0cbf\u0cb5\u0ccd \u0cb5\u0cbe\u0caf\u0ccd\u0cb8\u0ccd \u0cb0\u0cc6\u0cb8\u0ccd\u0caa\u0cbe\u0ca8\u0ccd\u0cb8\u0ccd \u0cb8\u0cbf\u0cb8\u0ccd\u0c9f\u0cae\u0ccd) \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0cac\u0cc6\u0c82\u0cac\u0cb2 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cbe\u0cb9\u0c95 \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0cb8\u0cb9\u0cbe\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0cb3\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0cc6. \u0cb5\u0ccd\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0caf\u0cc1 \u0ca4\u0cae\u0ccd\u0cae \u0cb8\u0cc1\u0cb2\u0cad\u0c95\u0ccd\u0c95\u0cc6 \u0c85\u0ca8\u0cc1\u0c97\u0cc1\u0ca3\u0cb5\u0cbe\u0c97\u0cbf \u0cb8\u0c82\u0cb5\u0cb9\u0ca8\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0c95\u0cc6\u0cb3\u0c97\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf\u0ca6 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cad\u0cbe\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.\n1. \u0cb9\u0cbf\u0c82\u0ca6\u0cbf\n5. \u0c95\u0ca8\u0ccd\u0ca8\u0ca1\n9. \u0c97\u0cc1\u0c9c\u0cb0\u0cbe\u0ca4\u0cbf\n2. \u0c87\u0c82\u0c97\u0ccd\u0cb2\u0cc0\u0cb7\u0ccd\n6. \u0cae\u0cb2\u0caf\u0cbe\u0cb3\u0c82\n10. \u0cae\u0cb0\u0cbe\u0ca0\u0cbf\n3. \u0ca4\u0cc6\u0cb2\u0cc1\u0c97\u0cc1\n7. \u0c85\u0cb8\u0ccd\u0cb8\u0cbe\u0cae\u0cbf\n11. \u0caa\u0c82\u0c9c\u0cbe\u0cac\u0cbf\n4. \u0ca4\u0cae\u0cbf\u0cb3\u0cc1\n8. \u0cac\u0cc6\u0c82\u0c97\u0cbe\u0cb2\u0cbf\n12. \u0c92\u0ca1\u0cbf\u0caf\u0cbe\n\u0cb8\u0cae\u0caf\u0c97\u0cb3\u0cc1:"},{question:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb8\u0cc7\u0cb5\u0cbe \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0cc1 \u0cb5\u0cbf\u0cad\u0cbf\u0ca8\u0ccd\u0ca8\u0cb5\u0cbe\u0c97\u0cbf\u0cb5\u0cc6\u0caf\u0cc7?",answer:"\u0c87\u0cb2\u0ccd\u0cb2, \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c97\u0cb3\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6\u0c82\u0ca4\u0cc6 \u0ca6\u0cc7\u0cb6\u0ca6 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0cc1 \u0c92\u0c82\u0ca6\u0cc7 \u0c86\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.\n\u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0ccb\u0ca1\u0cbf: \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0cc1"},{question:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0c85\u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc1\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc7/ \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc7?",answer:"\u0cb9\u0ccc\u0ca6\u0cc1, \u0ca8\u0cc0\u0cb5\u0cc1 \u0c85\u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0c85\u0ca6\u0cc7 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6/\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0c90\u0ca1\u0cbf\u0caf\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb2\u0cbe\u0c97\u0ccd \u0c87\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 24 \u0c97\u0c82\u0c9f\u0cc6\u0c97\u0cb3 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0c85\u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc1\u0ca8\u0cbf\u0c97\u0ca6\u0cbf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 (\u0cb9\u0cbf\u0c82\u0ca6\u0cc6 \u0ca8\u0cc0\u0ca1\u0cbf\u0ca6\u0c82\u0ca4\u0cc6)."},{question:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0ca6\u0cbf\u0c82\u0ca6 \u0ca8\u0cbe\u0ca8\u0cc1 \u0caf\u0cbe\u0cb5 \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",answer:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c97\u0cb3\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb0\u0cc0\u0ca4\u0cbf\u0caf \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6\n1. \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb5\u0caf\u0ccb\u0cae\u0cbe\u0ca8\u0ca6\u0cb5\u0cb0\u0cbf\u0c97\u0cc6 \u0cb9\u0cca\u0cb8 \u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf.\n2. \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 (\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8, \u0cb2\u0cbf\u0c82\u0c97, \u0cb9\u0cc1\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95, \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0c90\u0ca1\u0cbf).\n3. \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 (\u0cab\u0ccb\u0c9f\u0ccb, \u0cab\u0cbf\u0c82\u0c97\u0cb0\u0ccd\u200c\u0caa\u0ccd\u0cb0\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c90\u0cb0\u0cbf\u0cb8\u0ccd \u0cb8\u0ccd\u0c95\u0ccd\u0caf\u0cbe\u0ca8\u0ccd\u200c\u0c97\u0cb3\u0cc1) .\n4. \u0cae\u0c95\u0ccd\u0c95\u0cb3 \u0c95\u0ca1\u0ccd\u0ca1\u0cbe\u0caf \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd \u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd (5 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 15 \u0cb5\u0cb0\u0ccd\u0cb7 \u0cb5\u0caf\u0cb8\u0ccd\u0cb8\u0cbf\u0ca8\u0cb5\u0cb0\u0cc1).\n5.\u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 (POI \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 POA) .\n6.\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbf\u0cb8\u0cbf."},{question:"UIDAI ASK \u0c97\u0cb3 (\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c97\u0cb3\u0cc1) \u0cb8\u0cae\u0caf\u0c97\u0cb3\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0cb5\u0cc1?",answer:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c97\u0cb3\u0cc1 \u0cb0\u0cbe\u0cb7\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0caf/\u0caa\u0ccd\u0cb0\u0cbe\u0ca6\u0cc7\u0cb6\u0cbf\u0c95 \u0cb0\u0c9c\u0cbe\u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0cb0\u0ca4\u0cc1\u0caa\u0ca1\u0cbf\u0cb8\u0cbf \u0cb5\u0cbe\u0cb0\u0ca6 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe 7 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cc1 \u0ca4\u0cc6\u0cb0\u0cc6\u0ca6\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6. \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf \u0c87\u0ca6\u0cc1 9:30 AM \u0ca8\u0cbf\u0c82\u0ca6 5:30 PM (IST) \u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\nUIDAI ASK\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0cb0\u0ca4\u0cc1\u0caa\u0ca1\u0cbf\u0cb8\u0cbf \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c97\u0cb3\u0cc1 \u0c86\u0caf\u0cbe \u0cb0\u0cbf\u0c9c\u0cbf\u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cbe\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb5\u0ccd\u0caf\u0cbe\u0c96\u0ccd\u0caf\u0cbe\u0ca8\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb8\u0cae\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0cc1\u0cb8\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6. \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0cb5 \u0cb5\u0ccd\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c97\u0cb3\u0cc1/ \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0ca4\u0cae\u0ccd\u0cae \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1."},{question:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0 (ASK) \u0c8e\u0c82\u0ca6\u0cb0\u0cc7\u0ca8\u0cc1?",answer:"'\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0' \u0c85\u0ca5\u0cb5\u0cbe ASK \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c92\u0c82\u0ca6\u0cc7-\u0ca8\u0cbf\u0cb2\u0cc1\u0c97\u0ca1\u0cc6 \u0ca4\u0cbe\u0ca3\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. ASK \u0c85\u0ca4\u0ccd\u0caf\u0cbe\u0ca7\u0cc1\u0ca8\u0cbf\u0c95 \u0caa\u0cb0\u0cbf\u0cb8\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cae\u0cc0\u0cb8\u0cb2\u0cbe\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cb5\u0cc1 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c86\u0cb0\u0cbe\u0cae\u0ca6\u0cbe\u0caf\u0c95 \u0cb9\u0cb5\u0cbe\u0ca8\u0cbf\u0caf\u0c82\u0ca4\u0ccd\u0cb0\u0cbf\u0ca4 \u0cb5\u0cbe\u0ca4\u0cbe\u0cb5\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe ASK \u0c97\u0cb3\u0cc1 \u0c97\u0cbe\u0cb2\u0cbf\u0c95\u0cc1\u0cb0\u0ccd\u0c9a\u0cbf \u0cb8\u0ccd\u0ca8\u0cc7\u0cb9\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0caf\u0cb8\u0ccd\u0cb8\u0cbe\u0ca6\u0cb5\u0cb0\u0cbf\u0c97\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0cb6\u0cc7\u0cb7\u0cb5\u0cbe\u0c97\u0cbf \u0cb8\u0cae\u0cb0\u0ccd\u0ca5\u0cb0\u0cbf\u0c97\u0cc6 \u0cb8\u0cc7\u0cb5\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb5\u0cbf\u0cb6\u0cc7\u0cb7 \u0ca8\u0cbf\u0cac\u0c82\u0ca7\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb5\u0cc6. ASK \u0c97\u0cb3 \u0c95\u0cc1\u0cb0\u0cbf\u0ca4\u0cc1 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6: uidai.gov.in \u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd."},{question:"UIDAI ASK \u0c97\u0cb3 (\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c97\u0cb3\u0cc1) \u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",answer:"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cbe\u0ca4\u0ccd\u0cae\u0c95 ASK \u0c97\u0cb3 \u0c8f\u0c95\u0cc0\u0c95\u0cc3\u0ca4 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6: \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf\n\u0c88\u0c97\u0cbe\u0c97\u0cb2\u0cc7 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd\u200c\u0c97\u0cb3\u0cc1, \u0c85\u0c82\u0c9a\u0cc6 \u0c95\u0c9a\u0cc7\u0cb0\u0cbf\u0c97\u0cb3\u0cc1, CSC, BSNL \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb0\u0cbe\u0c9c\u0ccd\u0caf \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0c97\u0cb3\u0cc1 \u0ca8\u0ca1\u0cc6\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0cc1\u0cb5 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0c88 ASK \u0c97\u0cb3\u0cc1 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb5\u0cc6."}],checkEnrolmentUpdateStatus:[{question:"\u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cbe\u0ca8\u0cc1 \u0caf\u0cbe\u0cb5 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",answer:"\u0c88 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd \u0cae\u0cc2\u0cb2\u0c95, \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c87\u0ca4\u0cb0 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c95\u0ccd\u0c95\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf."}],checkAadhaarValidity:[{question:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd PVC \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0ca4\u0ccd\u0cb0\u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 \u0cb9\u0cc7\u0c97\u0cc6 \u0cad\u0cbf\u0ca8\u0ccd\u0ca8\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6?",answer:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0ca4\u0ccd\u0cb0\u0cb5\u0cc1 \u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cbf\u0c97\u0cc6 \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0ca6 \u0cb2\u0ccd\u0caf\u0cbe\u0cae\u0cbf\u0ca8\u0cc7\u0c9f\u0cc6\u0ca1\u0ccd \u0caa\u0cc7\u0caa\u0cb0\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd PVC \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd PVC \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0cac\u0cbe\u0cb3\u0cbf\u0c95\u0cc6 \u0cac\u0cb0\u0cc1\u0cb5 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0cb9\u0cc1 \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cbe\u0c97\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cc1\u0cb2\u0cad\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd PVC \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0cb8\u0cae\u0cbe\u0ca8\u0cb5\u0cbe\u0c97\u0cbf \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."}],lockUnlockAadhaar:[{question:"\u0c85\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0ca8\u0ca8\u0ccd\u0ca8 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbf\u0cb0\u0cb8\u0ccd\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c87\u0ca6\u0cb0 \u0c85\u0cb0\u0ccd\u0ca5\u0cb5\u0cc7\u0ca8\u0cc1?",answer:"'\u0ca8\u0cc0\u0cb5\u0cc1 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0cac\u0cb3\u0cb8\u0cc1\u0cb5 \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0cb9\u0cc0\u0c97\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1:\n\u2022 https://uidai.gov.in \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0 \u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd.\n\u2022 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf \u0cb9\u0cc6\u0cb8\u0cb0\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cc6.\n\u2022 \u0c85\u0caa\u0ccd\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0cb5\u0cc1 \u0cae\u0cc2\u0cb2 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf \u0cb8\u0ccd\u0caa\u0cb7\u0ccd\u0c9f \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0ca3\u0ccd\u0ca3\u0ca6 \u0cb8\u0ccd\u0c95\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0c86\u0c97\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1.\n\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb9\u0cca\u0cb8 \u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cae\u0cc7\u0cb2\u0cbf\u0ca8\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0cc1\u0cb8\u0cb0\u0cbf\u0cb8\u0cbf\u0cb0\u0cc1\u0cb5\u0cbf\u0cb0\u0cbe \u0c8e\u0c82\u0ca6\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf.'"},{question:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd (UID) \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0c8e\u0c82\u0ca6\u0cb0\u0cc7\u0ca8\u0cc1?",answer:"'\u0c92\u0cac\u0ccd\u0cac \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cc6, \u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0ca1\u0cc7\u0c9f\u0cbe\u0ca6 \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cc6 \u0caf\u0cbe\u0cb5\u0cbe\u0c97\u0cb2\u0cc2 \u0caa\u0ccd\u0cb0\u0cbe\u0ca5\u0cae\u0cbf\u0c95 \u0c95\u0cbe\u0cb3\u0c9c\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c85\u0cb5\u0ca8/\u0c85\u0cb5\u0cb3 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb2\u0caa\u0ca1\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cc6 \u0ca8\u0cbf\u0caf\u0c82\u0ca4\u0ccd\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cb2\u0cc1, UIDAI \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 (UID) \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\n\u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 UIDAI \u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd www.myaadhaar.uidai.gov.in \u0cae\u0cc2\u0cb2\u0c95 \u0c85\u0ca5\u0cb5\u0cbe mAadhaar \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0ca4\u0ca8\u0ccd\u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd (UID) \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.\n\u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cc1\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 UID, UID \u0c9f\u0ccb\u0c95\u0ca8\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd, \u0ca1\u0cc6\u0cae\u0cca\u0c97\u0ccd\u0cb0\u0cbe\u0cab\u0cbf\u0c95\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 OTP \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0cac\u0cb3\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb0\u0cc0\u0ca4\u0cbf\u0caf \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2\n\u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 UID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6 \u0c85\u0cb5\u0ca8\u0cc1/\u0c85\u0cb5\u0cb3\u0cc1 UIDAI \u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd \u0c85\u0ca5\u0cb5\u0cbe mAadhaar \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0c87\u0ca4\u0ccd\u0ca4\u0cc0\u0c9a\u0cbf\u0ca8 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0cb9\u0cbe\u0c97\u0cc6 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.\n\u0c86\u0ca7\u0cbe\u0cb0\u0ccd (\u0caf\u0cc1\u0c90\u0ca1\u0cbf) \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 \u0caf\u0cc1\u0c90\u0ca1\u0cbf, \u0caf\u0cc1\u0c90\u0ca1\u0cbf \u0c9f\u0ccb\u0c95\u0ca8\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0c90\u0ca1\u0cbf \u0cac\u0cb3\u0cb8\u0cbf \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.'"},{question:"\u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf UID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",answer:"'UID \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1, \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 16 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 VID \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c87\u0ca6\u0cc1 \u0caa\u0cc2\u0cb0\u0ccd\u0cb5\u0cbe\u0caa\u0cc7\u0c95\u0ccd\u0cb7\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. VID \u0c87\u0cb2\u0ccd\u0cb2\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cb3\u0cc1 SMS \u0cb8\u0cc7\u0cb5\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe UIDAI \u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd (www.myaadhaar.uidai.gov.in) \u0cae\u0cc2\u0cb2\u0c95 \u0cb0\u0c9a\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.\nSMS \u0cb8\u0cc7\u0cb5\u0cc6. UID \u0caf \u0c95\u0cca\u0ca8\u0cc6\u0caf 4 \u0c85\u0ca5\u0cb5\u0cbe 8 \u0c85\u0c82\u0c95\u0cbf\u0caf GVID \u0cb8\u0ccd\u0caa\u0cc7\u0cb8\u0ccd. 1947. Ex-GVID 1234 \u0c97\u0cc6 SMS.\n\u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 UIDAI \u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd https://resident.uidai.gov.in/aadhaar-lockunlock \u0c97\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c9f\u0ccd\u0caf\u0cbe\u0cac\u0ccd \u0c85\u0ca1\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf, \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3 \u0cae\u0cc7\u0cb2\u0cc6 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. UID \u0cb2\u0cbe\u0c95\u0ccd \u0cb0\u0cc7\u0ca1\u0cbf\u0caf\u0ccb \u0cac\u0c9f\u0ca8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c87\u0ca4\u0ccd\u0ca4\u0cc0\u0c9a\u0cbf\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0c82\u0ca4\u0cc6 UID \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6, \u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0c95\u0ccb\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf. Send OTP \u0cae\u0cc7\u0cb2\u0cc6 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 submit \u0cae\u0cc7\u0cb2\u0cc6 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0ca8\u0cbf\u0cae\u0ccd\u0cae UID \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cb2\u0cbe\u0c95\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.'"},{question:"\u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf UID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",answer:"'UID \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c87\u0ca4\u0ccd\u0ca4\u0cc0\u0c9a\u0cbf\u0ca8 16 \u0c85\u0c82\u0c95\u0cbf\u0caf VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf 16 \u0c85\u0c82\u0c95\u0cbf\u0caf VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc6\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6 \u0c85\u0cb5\u0cb0\u0cc1 SMS \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3 \u0cae\u0cc2\u0cb2\u0c95 \u0c87\u0ca4\u0ccd\u0ca4\u0cc0\u0c9a\u0cbf\u0ca8 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cbf\u0c82\u0caa\u0ca1\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.\nRVID \u0cb8\u0ccd\u0caa\u0cc7\u0cb8\u0ccd UID \u0caf \u0c95\u0cca\u0ca8\u0cc6\u0caf 4 \u0c85\u0ca5\u0cb5\u0cbe 8 \u0c85\u0c82\u0c95\u0cc6. SMS \u0c97\u0cc6 1947. Ex- RVID 1234\nUID \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1, \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf UIDAI \u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd https://resident.uidai.gov.in/aadhaar-lockunlock \u0c97\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1, \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cb0\u0cc7\u0ca1\u0cbf\u0caf\u0ccb \u0cac\u0c9f\u0ca8\u0ccd \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf, \u0c87\u0ca4\u0ccd\u0ca4\u0cc0\u0c9a\u0cbf\u0ca8 VID \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0c95\u0ccb\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 Send OTP \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cc1 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0ca8\u0cbf\u0cae\u0ccd\u0cae UID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\n\u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cb3\u0cc1 mAadhaar \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb2\u0cbe\u0c95\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.'"}],grievanceAndFeedback:[],generateOrRetrieveVid:[{question:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0cb5\u0cbf\u0c90\u0ca1\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc6\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6. UID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0caa\u0ca1\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",answer:"'\u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc6\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6 UID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 16 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cbf\u0c82\u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 SMS \u0cb8\u0cc7\u0cb5\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 \u0c85\u0cb5\u0ca8/\u0c85\u0cb5\u0cb3 \u0cb0\u0cbf\u0c9c\u0cbf\u0cb8\u0ccd\u0c9f\u0cb0\u0ccd \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0ca8\u0cc6.\n\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb0\u0cbf\u0c9c\u0cbf\u0cb8\u0ccd\u0c9f\u0cb0\u0ccd \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0cbf\u0c82\u0ca6 1947 \u0c97\u0cc6 SMS \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf,\nRVID \u0cb8\u0ccd\u0caa\u0cc7\u0cb8\u0ccd UID \u0caf \u0c95\u0cca\u0ca8\u0cc6\u0caf 4 \u0c85\u0ca5\u0cb5\u0cbe 8 \u0c85\u0c82\u0c95\u0cc6.\n\u0c89\u0ca6\u0cbe:- RVID 1234'"},{question:"\u0cb5\u0cb0\u0ccd\u0c9a\u0cc1\u0cb5\u0cb2\u0ccd \u0c90\u0ca1\u0cbf (VID) \u0c8e\u0c82\u0ca6\u0cb0\u0cc7\u0ca8\u0cc1?",answer:"VID \u0c8e\u0c82\u0cac\u0cc1\u0ca6\u0cc1 \u0ca4\u0cbe\u0ca4\u0ccd\u0c95\u0cbe\u0cb2\u0cbf\u0c95, \u0cb9\u0cbf\u0c82\u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cb9\u0cc1\u0ca6\u0cbe\u0ca6 16-\u0c85\u0c82\u0c95\u0cbf\u0caf \u0caf\u0cbe\u0ca6\u0cc3\u0c9a\u0ccd\u0c9b\u0cbf\u0c95 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1, \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cae\u0ccd\u0caf\u0cbe\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0c85\u0ca5\u0cb5\u0cbe \u0c87-\u0c95\u0cc6\u0cb5\u0cc8\u0cb8\u0cbf \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cbf\u0ca6\u0cbe\u0c97 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0c97\u0cc6 \u0cac\u0ca6\u0cb2\u0cbe\u0c97\u0cbf VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cc1\u0cb5 \u0cb0\u0cc0\u0ca4\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cb5\u0cbf\u0c90\u0ca1\u0cbf \u0cac\u0cb3\u0cb8\u0cbf \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cb5\u0cbf\u0c90\u0ca1\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2."},{question:"\u0c92\u0cac\u0ccd\u0cac \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0ca8\u0cc6?",answer:"'VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cb0\u0c9a\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c85\u0cb5\u0cb0\u0cc1 \u0c95\u0cbe\u0cb2\u0c95\u0cbe\u0cb2\u0c95\u0ccd\u0c95\u0cc6 \u0ca4\u0cae\u0ccd\u0cae VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 (\u0cb9\u0cca\u0cb8 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1). \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb8\u0cae\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0c97\u0cc6 \u0c92\u0c82\u0ca6\u0cc1 VID \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. UIDAI \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0c97\u0cc6 \u0cb5\u0cbf\u0cb5\u0cbf\u0ca7 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0ca4\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0c90\u0ca1\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cc1, \u0c85\u0cb5\u0cb0\u0cc1 \u0cae\u0cb0\u0cc6\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c85\u0cb5\u0cb0 \u0cb5\u0cbf\u0c90\u0ca1\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cbf\u0c82\u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0cb5\u0cb0 \u0cb5\u0cbf\u0c90\u0ca1\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0cb8 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c88 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caf\u0cc1\u0c90\u0ca1\u0cbf\u0c8e\u0c90 \u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd (www.myaadhaar.uidai.gov.in) , eAadhaar \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd, mAadhaar \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0cb5\u0c82\u0ca4\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd, \u0c87\u0ca4\u0ccd\u0caf\u0cbe\u0ca6\u0cbf.\n\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cb9\u0cbe\u0caf\u0cb5\u0cbe\u0ca3\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 1947 \u0c97\u0cc6 SMS \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb9 \u0cb0\u0c9a\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 'GVID \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0c95\u0cca\u0ca8\u0cc6\u0caf 4 \u0c85\u0c82\u0c95\u0cc6\u0c97\u0cb3\u0cc1' \u0c8e\u0c82\u0ca6\u0cc1 \u0c9f\u0cc8\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0c95\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 1947 \u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1.'"},{question:"\u0ca8\u0ca8\u0c97\u0cc6 \u0cac\u0cc7\u0cb0\u0cc6 \u0caf\u0cbe\u0cb0\u0cbe\u0ca6\u0cb0\u0cc2 VID \u0cb0\u0c9a\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc7?",answer:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0 \u0caa\u0cb0\u0cb5\u0cbe\u0c97\u0cbf AUA/KUA \u0ca8\u0c82\u0ca4\u0cb9 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c98\u0c9f\u0c95\u0cb5\u0cc1 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0cb8\u0ccd\u0cb5\u0ca4\u0c83/\u0c85\u0cb5\u0cb3\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cb0\u0c9a\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0c97\u0cc6 SMS \u0cae\u0cc2\u0cb2\u0c95 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6."},{question:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc6\u0ca4\u0cb0\u0cc6 \u0c8f\u0ca8\u0cc1? \u0c85\u0cb5\u0ca8\u0cc1/\u0c85\u0cb5\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ca1\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc7?",answer:"'\u0cb9\u0ccc\u0ca6\u0cc1, UIDAI \u0cb9\u0cca\u0cb8 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1/\u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cbf\u0c82\u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0c85\u0ca8\u0cc7\u0c95 \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c88 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0c97\u0cb3\u0cc1 UIDAI \u0ca8 \u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd (www.myaadhaar.uidai.gov.in) , eAadhaar, mAadhaar \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd, SMS, \u0c87\u0ca4\u0ccd\u0caf\u0cbe\u0ca6\u0cbf\u0c97\u0cb3 \u0cae\u0cc2\u0cb2\u0c95 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.\nVID \u0cae\u0cb0\u0cc1\u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0cb5\u0cbf\u0c95\u0cc6\u0c97\u0cbe\u0c97\u0cbf, \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cb9\u0cbe\u0caf\u0cb5\u0cbe\u0ca3\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 1947 \u0c97\u0cc6 SMS \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 'RVID \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0c95\u0cca\u0ca8\u0cc6\u0caf 4 \u0c85\u0c82\u0c95\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1' \u0c9f\u0cc8\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0c95\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 1947 \u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1.'"},{question:"VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 OTP \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc7?",answer:"\u0cb9\u0ccc\u0ca6\u0cc1. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0cac\u0ca6\u0cb2\u0cbf\u0c97\u0cc6 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1."},{question:"VID \u0caf \u0cb8\u0c82\u0ca6\u0cb0\u0ccd\u0cad\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf, \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0ca8\u0cbe\u0ca8\u0cc1 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c97\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cac\u0cc7\u0c95\u0cc7?",answer:"\u0cb9\u0ccc\u0ca6\u0cc1, VID \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cc6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0 \u0cb8\u0cae\u0ccd\u0cae\u0ca4\u0cbf \u0c85\u0c97\u0ca4\u0ccd\u0caf. \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0ca6 \u0c89\u0ca6\u0ccd\u0ca6\u0cc7\u0cb6\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cbf\u0c97\u0cc6 \u0ca4\u0cbf\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0ccd\u0caa\u0cb7\u0ccd\u0c9f \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c97\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0c8f\u0c9c\u0cc6\u0ca8\u0ccd\u0cb8\u0cbf \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6."},{question:"\u0c8f\u0c9c\u0cc6\u0ca8\u0ccd\u0cb8\u0cbf VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc7?",answer:"\u0c87\u0cb2\u0ccd\u0cb2. VID \u0ca4\u0cbe\u0ca4\u0ccd\u0c95\u0cbe\u0cb2\u0cbf\u0c95\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0cb5\u0cc1\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cbe\u0ca6 \u0c95\u0cbe\u0cb0\u0ca3, VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cae\u0ccc\u0cb2\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2. \u0c8f\u0c9c\u0cc6\u0ca8\u0ccd\u0cb8\u0cbf\u0c97\u0cb3\u0cc1 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0ca1\u0cc7\u0c9f\u0cbe\u0cac\u0cc7\u0cb8\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0cb2\u0cbe\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cac\u0cbe\u0cb0\u0ca6\u0cc1."},{question:"VID \u0caf \u0cae\u0cb0\u0cc1-\u0c89\u0ca4\u0ccd\u0caa\u0cbe\u0ca6\u0ca8\u0cc6\u0caf\u0cc1 \u0c85\u0ca6\u0cc7 VID \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0cc7\u0cb0\u0cc6 VID \u0c97\u0cc6 \u0c95\u0cbe\u0cb0\u0ca3\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6\u0caf\u0cc7?",answer:"'\u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0c85\u0cb5\u0ca7\u0cbf\u0caf \u0ca8\u0c82\u0ca4\u0cb0 (\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 1 \u0c95\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0c82\u0ca1\u0cb0\u0ccd \u0ca6\u0cbf\u0ca8 \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0ca7\u0ccd\u0caf\u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf 12 \u0cb0 \u0ca8\u0c82\u0ca4\u0cb0 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6), \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0cb9\u0cca\u0cb8 VID \u0caf \u0caa\u0cc1\u0ca8\u0cb0\u0cc1\u0ca4\u0ccd\u0caa\u0cbe\u0ca6\u0ca8\u0cc6\u0c97\u0cc6 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c88 \u0cb0\u0cc0\u0ca4\u0cbf\u0caf\u0cbe\u0c97\u0cbf, \u0cb9\u0cca\u0cb8 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0cbf\u0c82\u0ca6\u0cbf\u0ca8 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb7\u0ccd\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\n\u0c92\u0c82\u0ca6\u0cc1 \u0cb5\u0cc7\u0cb3\u0cc6, \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf VID \u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cbf\u0c82\u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0c86\u0cb0\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cb0\u0cc6, \u0c95\u0cca\u0ca8\u0cc6\u0caf \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 SMS \u0cae\u0cc2\u0cb2\u0c95 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cbf\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0caf\u0cc1 'RVID \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0c95\u0cca\u0ca8\u0cc6\u0caf 4 \u0c85\u0c82\u0c95\u0cc6\u0c97\u0cb3\u0cc1' \u0c8e\u0c82\u0ca6\u0cc1 \u0c9f\u0cc8\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0c95\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 1947 \u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1.'"}],checkGrievanceFeedbackStatus:[{question:"VID \u0caf \u0cae\u0cc1\u0c95\u0ccd\u0ca4\u0cbe\u0caf \u0c85\u0cb5\u0ca7\u0cbf \u0c8f\u0ca8\u0cc1?",answer:"\u0c88 \u0cb8\u0cae\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf VID \u0c97\u0cbe\u0c97\u0cbf \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cae\u0cc1\u0c95\u0ccd\u0ca4\u0cbe\u0caf \u0c85\u0cb5\u0ca7\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0ccd\u0caf\u0cbe\u0c96\u0ccd\u0caf\u0cbe\u0ca8\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0cb2\u0ccd\u0cb2. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0cb9\u0cca\u0cb8 VID \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cc1\u0cb5\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 VID \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."}]}}},ml_IN:{translation:{dashboard:{header:{title:"\u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d27\u0d3e\u0d7c",profile:{aadhaarTagLine:"\u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d27\u0d3e\u0d7c , \u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d10\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f",clickToFlip:"\u0d2b\u0d4d\u0d32\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d3e\u0d7c\u0d21\u0d4d",logOut:"\u0d32\u0d4b\u0d17\u0d57\u0d1f\u0d4d\u0d1f\u0d4d"}},services:{title:"\u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e",description:"\u0d07\u0d28\u0d3f\u0d2a\u0d4d\u0d2a\u0d31\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d13\u0d7a\u200c\u0d32\u0d48\u0d7b \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e \u0d06\u0d15\u0d4d\u200c\u0d38\u0d38\u0d4d\u0d38\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d. \u0d38\u0d47\u0d35\u0d28 \u0d28\u0d3f\u0d7c\u0d26\u0d4d\u0d26\u0d3f\u0d37\u0d4d\u0d1f \u0d2a\u0d47\u0d1c\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3e\u0d35\u0d3f\u0d17\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d35\u0d3e\u0d7b \u0d1f\u0d3e\u0d2c\u0d3f\u0d7d \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",serviceCards:{downloadAadhaar:{title:"\u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d4d \u0d06\u0d27\u0d3e\u0d7c",description:"\u0d21\u0d3f\u0d1c\u0d3f\u0d31\u0d4d\u0d31\u0d32\u0d3e\u0d2f\u0d3f \u0d12\u0d2a\u0d4d\u0d2a\u0d3f\u0d1f\u0d4d\u0d1f\u0d24\u0d41\u0d02 \u0d2a\u0d3e\u0d38\u0d4d\u200c\u0d35\u0d47\u0d21\u0d4d \u0d2a\u0d30\u0d3f\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d24\u0d35\u0d41\u0d2e\u0d3e\u0d2f \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d07\u0d32\u0d15\u0d4d\u0d1f\u0d4d\u0d30\u0d4b\u0d23\u0d3f\u0d15\u0d4d \u0d2a\u0d15\u0d7c\u0d2a\u0d4d\u0d2a\u0d4d \u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d35\u0d3e\u0d7b \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},orderPVC:{title:"\u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d13\u0d7c\u0d21\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",description:"\u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d24\u0d35\u0d41\u0d02 \u0d35\u0d3e\u0d32\u0d31\u0d4d\u0d31\u0d4d \u0d35\u0d32\u0d41\u0d2a\u0d4d\u0d2a\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d41\u0d2e\u0d3e\u0d2f \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d13\u0d7c\u0d21\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},updateAadhaarOnline:{updateAadhaarOnline:"\u0d06\u0d27\u0d3e\u0d7c \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",updateAadhaar:"\u0d06\u0d27\u0d3e\u0d7c \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",headerTitle:"\u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d06\u0d27\u0d3e\u0d7c \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d24\u0d30\u0d02 \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15",title:"\u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d",description:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. \u0d2e\u0d31\u0d4d\u0d31\u0d47\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d3e\u0d2f\u0d3f, \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02 \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15"},bankLinkingStatus:{title:"\u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d4d \u0d32\u0d3f\u0d19\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d28\u0d3f\u0d32",description:"\u0d06\u0d27\u0d3e\u0d7c, \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d4d \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d32\u0d3f\u0d19\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d28\u0d3f\u0d32 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},generateVirtualID:{title:"\u0d35\u0d46\u0d7c\u0d1a\u0d4d\u0d35\u0d7d \u0d10\u0d21\u0d3f \u0d38\u0d43\u0d37\u0d4d\u200c\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",description:"\u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d28\u0d4d \u0d2a\u0d15\u0d30\u0d2e\u0d3e\u0d2f\u0d3f \u0d35\u0d46\u0d7c\u0d1a\u0d4d\u0d35\u0d7d \u0d10\u0d21\u0d3f (\u0d35\u0d3f\u0d10\u0d21\u0d3f) \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02. 16 \u0d05\u0d15\u0d4d\u0d15 \u0d15\u0d4d\u0d30\u0d2e\u0d30\u0d39\u0d3f\u0d24\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},offlineEkyc:{title:"\u0d13\u0d2b\u0d4d\u200c\u0d32\u0d48\u0d7b \u0d07 \u0d15\u0d46\u0d35\u0d48\u0d38\u0d3f",description:"\u0d13\u0d2b\u0d4d\u200c\u0d32\u0d48\u0d7b \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d7d \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d28\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d24\u0d35\u0d41\u0d02 \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d3e\u0d35\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d41\u0d2e\u0d3e\u0d2f \u0d07 \u0d15\u0d46\u0d35\u0d48\u0d38\u0d3f \u0d30\u0d47\u0d16 \u0d06\u0d15\u0d4d\u0d38\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},lockUnlockBiometrics:{title:"\u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d / \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",description:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d24\u0d3e\u0d7d\u0d15\u0d4d\u0d15\u0d3e\u0d32\u0d3f\u0d15\u0d2e\u0d3e\u0d2f\u0d3f \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d / \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},lockUnlockAadhaar:{title:"\u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d / \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",description:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d24\u0d3e\u0d7d\u200c\u0d15\u0d4d\u0d15\u0d3e\u0d32\u0d3f\u0d15\u0d2e\u0d3e\u0d2f\u0d3f \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d / \u0d05\u0d7a\u200c\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. \u0d08 \u0d38\u0d47\u0d35\u0d28\u0d02 \u0d36\u0d4d\u0d30\u0d26\u0d4d\u0d27\u0d3e\u0d2a\u0d42\u0d7c\u0d35\u0d4d\u0d35\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15"},paymentHistory:{title:"\u0d2a\u0d47\u0d2f\u0d4d\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d02",description:"\u0d2a\u0d47\u0d2f\u0d4d\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d41\u0d02 \u0d31\u0d40\u0d2b\u0d23\u0d4d\u0d1f\u0d4d \u0d28\u0d3f\u0d32\u0d2f\u0d41\u0d02 \u0d15\u0d3e\u0d23\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},aadharUpdateHistory:{title:"\u0d06\u0d27\u0d3e\u0d7c \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d02",description:"\u0d28\u0d3f\u0d19\u0d4d\u0d1