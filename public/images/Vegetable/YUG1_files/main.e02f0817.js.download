15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f"},bookAppointment:{title:"\u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c2c\u0c41\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",description:"\u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c2c\u0c41\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f"},vidGenerator:{title:"VID \u0c1c\u0c28\u0c30\u0c47\u0c1f\u0c30\u0c4d",description:"\u0c2e\u0c40 \u0c05\u0c28\u0c41\u0c38\u0c02\u0c27\u0c3e\u0c28\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 16-\u0c05\u0c02\u0c15\u0c46\u0c32 \u0c35\u0c30\u0c4d\u0c1a\u0c41\u0c35\u0c32\u0c4d ID (VID) \u0c28\u0c41 \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f"},lec:{title:"\u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c4d\u0c30\u0c47\u0c37\u0c28\u0c4d \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c02\u0c21\u0c3f",description:"\u0c38\u0c2e\u0c40\u0c2a\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c3f \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f"},lockUnlockAadhaar:{title:"\u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c32\u0c3e\u0c15\u0c4d / \u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",description:"\u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c24\u0c3e\u0c24\u0c4d\u0c15\u0c3e\u0c32\u0c3f\u0c15\u0c02\u0c17\u0c3e \u0c32\u0c3e\u0c15\u0c4d / \u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c08 \u0c38\u0c47\u0c35\u0c28\u0c41 \u0c1c\u0c3e\u0c17\u0c4d\u0c30\u0c24\u0c4d\u0c24\u0c17\u0c3e \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f"},complaintStatus:{title:"\u0c17\u0c4d\u0c30\u0c40\u0c35\u0c46\u0c28\u0c4d\u0c38\u0c4d / \u0c2b\u0c40\u0c21\u0c4d\u200c\u0c2c\u0c4d\u0c2f\u0c3e\u0c15\u0c4d \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",description:"\u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41 / \u0c2b\u0c40\u0c21\u0c4d\u200c\u0c2c\u0c4d\u0c2f\u0c3e\u0c15\u0c4d \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f"},fileComplaint:{title:"\u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c2d\u0c3f\u0c2a\u0c4d\u0c30\u0c3e\u0c2f\u0c02",description:"\u0c2e\u0c40 \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c2d\u0c3f\u0c2a\u0c4d\u0c30\u0c3e\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2b\u0c48\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f"}}}},documentUpdate:{intentPage:{title:"\u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c32\u0c15\u0c4d\u0c37\u0c4d\u0c2f\u0c02",p1:"\u0c2a\u0c4d\u0c30\u0c3f\u0c2f\u0c2e\u0c48\u0c28 \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f,",p2:"\u0c24\u0c3e\u0c1c\u0c3e \u0c2a\u0c4d\u0c30\u0c42\u0c2b\u0c4d \u0c06\u0c2b\u0c4d \u0c10\u0c21\u0c46\u0c02\u0c1f\u0c3f\u0c1f\u0c40 (POI) \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c4d\u0c30\u0c42\u0c2b\u0c4d \u0c06\u0c2b\u0c4d \u0c05\u0c21\u0c4d\u0c30\u0c38\u0c4d (POA) \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c21\u0c47\u0c1f\u0c3e\u0c2c\u0c47\u0c38\u0c4d\u200c\u0c32\u0c4b\u0c28\u0c3f \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c2c\u0c32\u0c4b\u0c2a\u0c47\u0c24\u0c02 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c3e\u0c32\u0c28\u0c3f \u0c2e\u0c40\u0c15\u0c41 \u0c38\u0c32\u0c39\u0c3e \u0c07\u0c35\u0c4d\u0c35\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. POI/POA \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c4d\u0c32\u0c4b\u0c28\u0c3f \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c24\u0c2a\u0c4d\u0c2a\u0c28\u0c3f\u0c38\u0c30\u0c3f\u0c17\u0c3e \u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c32\u0c4b \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c2e\u0c40 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c24\u0c4b \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c32\u0c3e\u0c32\u0c3f. \u0c07\u0c26\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c21\u0c47\u0c1f\u0c3e\u0c2c\u0c47\u0c38\u0c4d\u200c\u0c32\u0c4b \u0c2e\u0c40 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c28\u0c3f\u0c30\u0c02\u0c24\u0c30 \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c24\u0c4d\u0c35\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c02\u0c32\u0c4b \u0c2e\u0c40\u0c15\u0c41 \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",p3:"\u0c2e\u0c40\u0c30\u0c41 \u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c47 \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c0e\u0c28\u0c4d\u200c\u0c30\u0c4b\u0c32\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c38\u0c46\u0c02\u0c1f\u0c30\u0c4d\u200c\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c32\u0c47\u0c26\u0c3e myAadhaar \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c38\u0c3f \u0c09\u0c02\u0c1f\u0c47, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c26\u0c3e\u0c28\u0c3f \u0c05\u0c02\u0c17\u0c40\u0c15\u0c3e\u0c30\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c35\u0c47\u0c1a\u0c3f \u0c09\u0c02\u0c21\u0c02\u0c21\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c35\u0c47\u0c30\u0c47 \u0c35\u0c3f\u0c27\u0c02\u0c17\u0c3e \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c24\u0c3f\u0c30\u0c38\u0c4d\u0c15\u0c30\u0c23\u0c15\u0c41 \u0c17\u0c41\u0c30\u0c48\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47, \u0c2e\u0c40\u0c30\u0c41 \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c4d\u0c38\u0c3f \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f.",p4:"\u0c2e\u0c40\u0c30\u0c41 \u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c32\u0c4b \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c28\u0c41 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c3f \u0c1a\u0c42\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f",p5:"\u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c28\u0c4a\u0c15\u0c4d\u0c15\u0c02\u0c21\u0c3f.",p6:"\u0c38\u0c47\u0c35\u0c32\u0c15\u0c41 \u0c30\u0c42. 25/- \u0c28\u0c3e\u0c2e\u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2a\u0c41 \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f, \u0c07\u0c26\u0c3f \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c26\u0c41.",p7:"\u0c08 \u0c38\u0c47\u0c35 14/06/2025 \u0c35\u0c30\u0c15\u0c41 \u0c09\u0c1a\u0c3f\u0c24\u0c02"},howItWorks:{description:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26\u0c3f \u0c26\u0c36\u0c32\u0c28\u0c41 \u0c1c\u0c3e\u0c17\u0c4d\u0c30\u0c24\u0c4d\u0c24\u0c17\u0c3e \u0c1a\u0c26\u0c35\u0c02\u0c21\u0c3f. \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2a\u0c4d\u0c30\u0c3e\u0c38\u0c46\u0c38\u0c3f\u0c02\u0c17\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c24\u0c3f\u0c30\u0c38\u0c4d\u0c15\u0c30\u0c23\u0c32\u0c4b \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c1c\u0c3e\u0c2a\u0c4d\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3f\u0c35\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c3f\u0c35\u0c3f\u0c27 \u0c26\u0c36\u0c32\u0c32\u0c4b \u0c38\u0c42\u0c1a\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c1a\u0c30\u0c4d\u0c2f\u0c32\u0c28\u0c41 \u0c05\u0c28\u0c41\u0c38\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c32\u0c4b \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c28\u0c41 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c3f \u0c1a\u0c42\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f",stepDescription:{one:"\u0c2e\u0c40 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c30\u0c41\u0c1c\u0c41\u0c35\u0c41 (PoI) \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c30\u0c41\u0c1c\u0c41\u0c35\u0c41 (PoA) \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",two:"\u0c08 \u0c26\u0c36\u0c32\u0c4b, \u0c2e\u0c40\u0c30\u0c41 \u0c26\u0c36 1\u0c32\u0c4b \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c28\u0c4d\u0c28 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c2f\u0c4d\u0c2f\u0c47 POI/POA \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c2e\u0c28\u0c3f \u0c05\u0c21\u0c17\u0c2c\u0c21\u0c24\u0c3e\u0c30\u0c41.",three:"\u0c2e\u0c40\u0c30\u0c41 \u0c08 \u0c38\u0c47\u0c35 \u0c15\u0c4b\u0c38\u0c02 \u20b9 25 (\u0c07\u0c30\u0c35\u0c48 \u0c10\u0c26\u0c41 \u0c30\u0c42\u0c2a\u0c3e\u0c2f\u0c32\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47) \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c15\u0c4d\u0c30\u0c46\u0c21\u0c3f\u0c1f\u0c4d/\u0c21\u0c46\u0c2c\u0c3f\u0c1f\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c46\u0c1f\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c08 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c26\u0c41."},note:"\u0c2e\u0c40\u0c30\u0c41 \u0c2e\u0c40 \u0c1c\u0c28\u0c3e\u0c2d\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 (\u0c2a\u0c47\u0c30\u0c41, DoB, \u0c32\u0c3f\u0c02\u0c17\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e) \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c3f \u0c1a\u0c42\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c07\u0c15\u0c4d\u0c15\u0c21 ",noteLink:"\u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f."},currentSection:{form:{title:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c1c\u0c28\u0c3e\u0c2d\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",name:"\u0c2a\u0c47\u0c30\u0c41",gender:"\u0c32\u0c3f\u0c02\u0c17\u0c02",dob:"\u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c3f",address:"\u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e",consent:"\u0c2a\u0c48 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c38\u0c30\u0c48\u0c28\u0c35\u0c28\u0c3f \u0c28\u0c47\u0c28\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41."},note:"\u0c2e\u0c40 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c32\u0c4b \u0c26\u0c47\u0c28\u0c3f\u0c32\u0c4b\u0c28\u0c48\u0c28\u0c3e \u0c05\u0c38\u0c2e\u0c24\u0c41\u0c32\u0c4d\u0c2f\u0c24 \u0c09\u0c02\u0c1f\u0c47, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c1c\u0c28\u0c3e\u0c2d\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 (\u0c2a\u0c47\u0c30\u0c41, \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e, DoB \u0c32\u0c47\u0c26\u0c3e \u0c32\u0c3f\u0c02\u0c17\u0c02) \u0c07\u0c15\u0c4d\u0c15\u0c21 ",noteLink:"\u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f."},uploadSection:{confirmationPopUp:{title:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c32\u0c4b\u0c28\u0c3f \u0c2e\u0c40 \u0c1c\u0c28\u0c28\u0c3e\u0c02\u0c15\u0c3f\u0c15 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c24\u0c4b \u0c38\u0c30\u0c3f\u0c17\u0c4d\u0c17\u0c3e \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c32\u0c41\u0c24\u0c41\u0c28\u0c4d\u0c28 \u0c2a\u0c24\u0c4d\u0c30\u0c02\u0c32\u0c4b \u0c2e\u0c40 \u0c1c\u0c28\u0c28\u0c3e\u0c02\u0c15\u0c3f\u0c15 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f"},stepper:{verify:"\u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",upload:"\u0c05\u0c2a\u0c4d\u0c32\u0c4b\u0c21\u0c4d"},guidelines:{title:"\u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c3e\u0c30\u0c4d\u0c17\u0c26\u0c30\u0c4d\u0c36\u0c15\u0c3e\u0c32\u0c41",l1:"\u0c2a\u0c24\u0c4d\u0c30\u0c02 \u0c2a\u0c30\u0c3f\u0c2e\u0c3e\u0c23\u0c02 2 MB \u0c15\u0c02\u0c1f\u0c47 \u0c24\u0c15\u0c4d\u0c15\u0c41\u0c35\u0c17\u0c3e \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f",l2:"\u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c09\u0c28\u0c4d\u0c28 \u0c2b\u0c48\u0c32\u0c4d \u0c2b\u0c3e\u0c30\u0c4d\u0c2e\u0c3e\u0c1f\u0c4d\u200c\u0c32\u0c41: <b>JPEG, PNG</b> \u0c2e\u0c30\u0c3f\u0c2f\u0c41 <b>PDF</b>"},form:{poiTitle:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c30\u0c41\u0c1c\u0c41\u0c35\u0c41 (POI) \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",poaTitle:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c30\u0c41\u0c1c\u0c41\u0c35\u0c41 (POA) \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f"},consent:"\u0c28\u0c47\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3f\u0c28/\u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02/\u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c41 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c02 \u0c0f \u0c26\u0c36\u0c32\u0c4b\u0c28\u0c48\u0c28\u0c3e \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23\u0c15\u0c41 \u0c32\u0c4b\u0c2c\u0c21\u0c3f \u0c09\u0c02\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c28\u0c3f \u0c28\u0c47\u0c28\u0c41 \u0c07\u0c02\u0c26\u0c41\u0c2e\u0c42\u0c32\u0c02\u0c17\u0c3e \u0c28\u0c3e \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c28\u0c3f \u0c24\u0c46\u0c32\u0c3f\u0c2f\u0c1c\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41."},faq:{card:{heading:"\u0c2a\u0c24\u0c4d\u0c30\u0c02 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23",description_1:"",description_2:""},guidelines:{heading_1:"\u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c15\u0c41 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41\u0c17\u0c3e \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",heading_2:"14/06/2025 \u0c35\u0c30\u0c15\u0c41 \u0c09\u0c1a\u0c3f\u0c24\u0c02",question_1:{title:"\u0c0f\u0c2e\u0c3f \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f?",content:{line_1:"\u0c30\u0c47\u0c37\u0c28\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d, \u0c13\u0c1f\u0c30\u0c41 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d,\xa0\u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c02 \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41/ \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c15\u0c32\u0c3f\u0c17\u0c3f\u0c28 \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2d\u0c3e\u0c30\u0c24\u0c40\u0c2f \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c4d \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c30\u0c46\u0c02\u0c21\u0c3f\u0c02\u0c1f\u0c3f\u0c15\u0c3f \u0c30\u0c41\u0c1c\u0c41\u0c35\u0c41\u0c17\u0c3e \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c2a\u0c21\u0c24\u0c3e\u0c2f\u0c3f.",line_2:"\u0c2a\u0c3e\u0c28\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d, \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c3f\u0c02\u0c17\u0c4d \u0c32\u0c48\u0c38\u0c46\u0c28\u0c4d\u0c38\u0c4d, \u0c38\u0c46\u0c15\u0c02\u0c21\u0c30\u0c40 \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c40\u0c28\u0c3f\u0c2f\u0c30\u0c4d \u0c38\u0c4d\u0c15\u0c42\u0c32\u0c4d \u0c2e\u0c3e\u0c30\u0c4d\u0c15\u0c4d \u0c37\u0c40\u0c1f\u0c4d/ \u0c2b\u0c4b\u0c1f\u0c4b\u0c17\u0c4d\u0c30\u0c3e\u0c2b\u0c4d  \u0c15\u0c32\u0c3f\u0c17\u0c3f\u0c28 \u0c38\u0c4d\u0c15\u0c42\u0c32\u0c4d \u0c32\u0c40\u0c35\u0c3f\u0c02\u0c17\u0c4d \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d , \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c02 \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41/ \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c46\u0c1f\u0c4d - \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c30\u0c41\u0c1c\u0c41\u0c35\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c2a\u0c21\u0c24\u0c3e\u0c2f\u0c3f. ",line_3:"\u0c35\u0c3f\u0c26\u0c4d\u0c2f\u0c41\u0c24\u0c4d/\u0c28\u0c40\u0c30\u0c41/\u0c17\u0c4d\u0c2f\u0c3e\u0c38\u0c4d \u0c2c\u0c3f\u0c32\u0c4d\u0c32\u0c41 (\u0c17\u0c24 3 \u0c28\u0c46\u0c32\u0c32\u0c41),  \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d/\u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c3e\u0c2b\u0c40\u0c38\u0c41 \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c2c\u0c41\u0c15\u0c4d,  \u0c05\u0c26\u0c4d\u0c26\u0c46/\u0c32\u0c40\u0c1c\u0c41/ \u0c38\u0c46\u0c32\u0c35\u0c41 & \u0c32\u0c48\u0c38\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c12\u0c2a\u0c4d\u0c2a\u0c02\u0c26\u0c02 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c15\u0c41 \u0c30\u0c41\u0c1c\u0c41\u0c35\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c2a\u0c21\u0c24\u0c3e\u0c2f\u0c3f.",line_4:"\u0c06\u0c2e\u0c4b\u0c26\u0c2f\u0c4b\u0c17\u0c4d\u0c2f\u0c2e\u0c48\u0c28 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32 \u0c35\u0c3f\u0c35\u0c30\u0c23\u0c3e\u0c24\u0c4d\u0c2e\u0c15 \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e \u0c15\u0c4b\u0c38\u0c02, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f",line_5:" \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c28\u0c4a\u0c15\u0c4d\u0c15\u0c02\u0c21\u0c3f"}},question_2:{title:"\u0c0e\u0c32\u0c3e \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f?",content:{line_1:"\u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d\u200c\u0c32\u0c4b myAadhaar \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d \u0c32\u0c4b  \u0c32\u0c47\u0c26\u0c3e \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. ",line_2:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d\u200c\u0c32\u0c4b \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c26\u0c36\u0c32 \u0c35\u0c3e\u0c30\u0c40 \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02 \u0c15\u0c4b\u0c38\u0c02 ",line_3:" \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c28\u0c4a\u0c15\u0c4d\u0c15\u0c02\u0c21\u0c3f"}},main_content:{submit:"\u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",title:"\u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3e?",videoText:"\u0c35\u0c40\u0c21\u0c3f\u0c2f\u0c4b \u0c17\u0c48\u0c21\u0c4d",knowMoreText:"\u0c2e\u0c30\u0c3f\u0c02\u0c24 \u0c24\u0c46\u0c32\u0c41\u0c38\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f?",callText:"\u0c1f\u0c4b\u0c32\u0c4d \u0c2b\u0c4d\u0c30\u0c40 (1947) \u0c15\u0c3f \u0c15\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f"}},one:{title:"\u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c0e\u0c02\u0c26\u0c41\u0c15\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f?",content:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c32\u0c4b \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c38\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32 \u0c35\u0c32\u0c28 \u0c1c\u0c40\u0c35\u0c28 \u0c38\u0c4c\u0c32\u0c2d\u0c4d\u0c2f\u0c02, \u0c2e\u0c46\u0c30\u0c41\u0c17\u0c48\u0c28 \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c21\u0c46\u0c32\u0c3f\u0c35\u0c30\u0c40 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c2e\u0c48\u0c28 \u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23\u0c15\u0c41 \u0c35\u0c40\u0c32\u0c41 \u0c15\u0c32\u0c4d\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f. \u0c15\u0c3e\u0c2c\u0c1f\u0c4d\u0c1f\u0c3f, \u0c07\u0c1f\u0c40\u0c35\u0c32\u0c3f \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c06\u0c38\u0c15\u0c4d\u0c24\u0c3f \u0c2c\u0c1f\u0c4d\u0c1f\u0c3f \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f."},two:{title:"\u0c28\u0c3e \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c15\u0c4b\u0c38\u0c02 \u0c28\u0c47\u0c28\u0c41 \u0c0f \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f?",content:{para_1:{heading_one:"\u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c30\u0c46\u0c02\u0c21\u0c3f\u0c02\u0c1f\u0c3f\u0c15\u0c40 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d:",list_1:"(\u0c0e)   \u0c30\u0c47\u0c37\u0c28\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d",list_2:"(\u0c2c\u0c3f)   \u0c13\u0c1f\u0c30\u0c41 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41",list_3:"(\u0c38\u0c3f)   \u0c15\u0c3f\u0c38\u0c3e\u0c28\u0c4d \u0c2b\u0c4b\u0c1f\u0c4b \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c2c\u0c41\u0c15\u0c4d",list_4:"(\u0c21\u0c3f)   \u0c2d\u0c3e\u0c30\u0c24\u0c40\u0c2f \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c4d",list_5:"(\u0c07)   \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c02 \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41/\u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d[1], ST/SC/OBC \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c35\u0c3f\u0c35\u0c3e\u0c39 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c2a\u0c24\u0c4d\u0c30\u0c02, \u0c2b\u0c4b\u0c1f\u0c4b \u0c15\u0c32\u0c3f\u0c17\u0c3f\u0c35\u0c41\u0c28\u0c4d\u0c28\u0c26\u0c3f",list_6:"(f)    \u0c35\u0c48\u0c15\u0c32\u0c4d\u0c2f\u0c02 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41 / \u0c35\u0c48\u0c15\u0c32\u0c4d\u0c2f\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d",list_7:"(g)   \u0c32\u0c3f\u0c02\u0c17\u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c3f\u0c21\u0c3f \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41/\u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d",list_8:"(h)   \u0c38\u0c46\u0c15\u0c4d\u0c38\u0c4d \u0c35\u0c30\u0c4d\u0c15\u0c30\u0c4d\u200c\u0c15\u0c3f \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f UIDAI \u0c38\u0c4d\u0c1f\u0c3e\u0c02\u0c21\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c46\u0c1f\u0c4d \u0c2b\u0c3e\u0c30\u0c4d\u0c2e\u0c3e\u0c1f\u0c4d\u200c\u0c32\u0c4b \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d[4]",list_9:"(i)    \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c28 \u0c37\u0c46\u0c32\u0c4d\u0c1f\u0c30\u0c4d \u0c39\u0c4b\u0c2e\u0c4d\u200c\u0c32\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c05\u0c28\u0c3e\u0c25 \u0c36\u0c30\u0c23\u0c3e\u0c32\u0c2f\u0c3e\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e UIDAI \u0c38\u0c4d\u0c1f\u0c3e\u0c02\u0c21\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d \u0c2b\u0c3e\u0c30\u0c4d\u0c2e\u0c3e\u0c1f\u0c4d\u200c\u0c32\u0c4b \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d",list_10:"(j)    \u0c1c\u0c48\u0c32\u0c41 \u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c3f \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c16\u0c48\u0c26\u0c40 \u0c07\u0c02\u0c21\u0c15\u0c4d\u0c37\u0c28\u0c4d \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d"},para_2:{heading_one:"\u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c4b\u0c38\u0c02 \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d:",list_1:"(\u0c0e)   \u0c38\u0c4d\u0c15\u0c42\u0c32\u0c4d \u0c32\u0c40\u0c35\u0c3f\u0c02\u0c17\u0c4d \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d / \u0c2b\u0c4b\u0c1f\u0c4b\u0c24\u0c4b \u0c15\u0c42\u0c21\u0c3f\u0c28 \u0c38\u0c4d\u0c15\u0c42\u0c32\u0c4d \u0c2c\u0c26\u0c3f\u0c32\u0c40 \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d",list_2:"(\u0c2c\u0c3f)   \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c28 \u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c4d \u0c06\u0c2b\u0c4d \u0c0e\u0c21\u0c4d\u0c2f\u0c41\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c2b\u0c4b\u0c1f\u0c4b\u0c24\u0c4b \u0c15\u0c42\u0c21\u0c3f\u0c28 \u0c2f\u0c42\u0c28\u0c3f\u0c35\u0c30\u0c4d\u0c36\u0c3f\u0c1f\u0c40  \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c2e\u0c3e\u0c30\u0c4d\u0c15\u0c4d\u200c\u0c37\u0c40\u0c1f\u0c4d/\u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d",list_3:"(\u0c38\u0c3f)   PAN/e-PAN \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d",list_4:"(\u0c21\u0c3f)   \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c02/\u0c1a\u0c1f\u0c4d\u0c1f\u0c2c\u0c26\u0c4d\u0c27\u0c2e\u0c48\u0c28 \u0c38\u0c02\u0c38\u0c4d\u0c25/PSU \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c09\u0c26\u0c4d\u0c2f\u0c4b\u0c17\u0c3f/\u0c2a\u0c46\u0c28\u0c4d\u0c37\u0c28\u0c30\u0c4d \u0c2b\u0c4b\u0c1f\u0c4b \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d, \u0c2a\u0c46\u0c28\u0c4d\u0c37\u0c28\u0c4d \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c46\u0c21\u0c3f-\u0c15\u0c4d\u0c32\u0c46\u0c2f\u0c3f\u0c2e\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d",list_5:"(\u0c07)   \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c3f\u0c02\u0c17\u0c4d \u0c32\u0c48\u0c38\u0c46\u0c28\u0c4d\u0c38\u0c4d",list_6:"(\u0c0e\u0c2b\u0c4d) \u0c38\u0c4d\u0c35\u0c3e\u0c24\u0c02\u0c24\u0c4d\u0c30\u0c4d\u0c2f \u0c38\u0c2e\u0c30\u0c2f\u0c4b\u0c27\u0c41\u0c32 \u0c2b\u0c4b\u0c1f\u0c4b \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41"},para_3:{heading_one:"\u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c15\u0c4b\u0c38\u0c02 \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d:",list_1:"(\u0c0e)   \u0c35\u0c3f\u0c26\u0c4d\u0c2f\u0c41\u0c24\u0c4d, \u0c28\u0c40\u0c30\u0c41, \u0c17\u0c4d\u0c2f\u0c3e\u0c38\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c1f\u0c46\u0c32\u0c3f\u0c2b\u0c4b\u0c28\u0c4d/\u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d/\u0c2c\u0c4d\u0c30\u0c3e\u0c21\u0c4d\u200c\u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c21\u0c4d \u0c2c\u0c3f\u0c32\u0c4d\u0c32\u0c41 (\u0c2e\u0c42\u0c21\u0c41 \u0c28\u0c46\u0c32\u0c32 \u0c15\u0c02\u0c1f\u0c47 \u0c2a\u0c3e\u0c24\u0c26\u0c3f \u0c15\u0c3e\u0c26\u0c41)",list_2:"(\u0c2c\u0c3f)  \u0c35\u0c3f\u0c27\u0c3f\u0c17\u0c3e \u0c38\u0c02\u0c24\u0c15\u0c02 \u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c4d\u0c1f\u0c3e\u0c02\u0c2a\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c37\u0c46\u0c21\u0c4d\u0c2f\u0c42\u0c32\u0c4d\u0c21\u0c4d \u0c15\u0c2e\u0c30\u0c4d\u0c37\u0c3f\u0c2f\u0c32\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d / \u0c2b\u0c4b\u0c1f\u0c4b\u0c24\u0c4b \u0c15\u0c42\u0c21\u0c3f\u0c28 \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c06\u0c2b\u0c40\u0c38\u0c4d \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c2c\u0c41\u0c15\u0c4d",list_3:"(\u0c38\u0c3f)   \u0c37\u0c46\u0c21\u0c4d\u0c2f\u0c42\u0c32\u0c4d\u0c21\u0c4d \u0c15\u0c2e\u0c30\u0c4d\u0c37\u0c3f\u0c2f\u0c32\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d / \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c06\u0c2b\u0c40\u0c38\u0c4d \u0c16\u0c3e\u0c24\u0c3e/\u0c15\u0c4d\u0c30\u0c46\u0c21\u0c3f\u0c1f\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c4d\u0c1f\u0c47\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d (\u0c2e\u0c42\u0c21\u0c41 \u0c28\u0c46\u0c32\u0c32 \u0c15\u0c02\u0c1f\u0c47 \u0c2a\u0c3e\u0c24\u0c26\u0c3f \u0c15\u0c3e\u0c26\u0c41) \u0c35\u0c3f\u0c27\u0c3f\u0c17\u0c3e \u0c38\u0c02\u0c24\u0c15\u0c02 \u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c4d\u0c1f\u0c3e\u0c02\u0c2a\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f",list_4:"(\u0c21\u0c3f)   \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c2f\u0c4d\u0c2f\u0c47 \u0c05\u0c26\u0c4d\u0c26\u0c46, \u0c32\u0c40\u0c1c\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c32\u0c40\u0c1c\u0c41 & \u0c32\u0c48\u0c38\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c12\u0c2a\u0c4d\u0c2a\u0c02\u0c26\u0c02",list_5:"(\u0c07)   MP, MLA, MLC, \u0c2e\u0c41\u0c28\u0c4d\u0c38\u0c3f\u0c2a\u0c32\u0c4d \u0c15\u0c4c\u0c28\u0c4d\u0c38\u0c3f\u0c32\u0c30\u0c4d, \u0c17\u0c4d\u0c30\u0c42\u0c2a\u0c4d 'A' \u0c32\u0c47\u0c26\u0c3e 'B' \u0c17\u0c46\u0c1c\u0c3f\u0c1f\u0c46\u0c21\u0c4d \u0c06\u0c2b\u0c40\u0c38\u0c30\u0c4d, EPFO \u200b\u200b\u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c24\u0c39\u0c36\u0c40\u0c32\u0c4d\u0c26\u0c3e\u0c30\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e UIDAI \u0c38\u0c4d\u0c1f\u0c3e\u0c02\u0c21\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d \u0c2b\u0c3e\u0c30\u0c4d\u0c2e\u0c3e\u0c1f\u0c4d\u200c\u0c32\u0c4b \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d",list_6:"(\u0c0e\u0c2b\u0c4d)   UIDAI \u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c3f\u0c15 \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d \u0c2b\u0c3e\u0c30\u0c4d\u0c2e\u0c3e\u0c1f\u0c4d\u200c\u0c32\u0c4b \u0c17\u0c4d\u0c30\u0c3e\u0c2e \u0c2a\u0c02\u0c1a\u0c3e\u0c2f\u0c24\u0c40 \u0c39\u0c46\u0c21\u0c4d/\u0c38\u0c46\u0c15\u0c4d\u0c30\u0c1f\u0c30\u0c40, \u0c17\u0c4d\u0c30\u0c3e\u0c2e \u0c30\u0c46\u0c35\u0c46\u0c28\u0c4d\u0c2f\u0c42 \u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c24\u0c24\u0c4d\u0c38\u0c2e\u0c3e\u0c28\u0c02 (\u0c17\u0c4d\u0c30\u0c3e\u0c2e\u0c40\u0c23 \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c3e\u0c32\u0c15\u0c41) \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d",list_7:"(g)    UIDAI \u0c38\u0c4d\u0c1f\u0c3e\u0c02\u0c21\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d \u0c2b\u0c3e\u0c30\u0c4d\u0c2e\u0c3e\u0c1f\u0c4d\u200c\u0c32\u0c4b \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c28 \u0c35\u0c3f\u0c26\u0c4d\u0c2f\u0c3e \u0c38\u0c02\u0c38\u0c4d\u0c25 \u0c05\u0c27\u0c3f\u0c2a\u0c24\u0c3f \u0c35\u0c3f\u0c26\u0c4d\u0c2f\u0c3e\u0c30\u0c4d\u0c25\u0c3f\u0c15\u0c3f \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d",list_8:"(h)   \u0c06\u0c38\u0c4d\u0c24\u0c3f \u0c2a\u0c28\u0c4d\u0c28\u0c41 \u0c30\u0c38\u0c40\u0c26\u0c41 (\u0c12\u0c15 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02 \u0c15\u0c02\u0c1f\u0c47 \u0c0e\u0c15\u0c4d\u0c15\u0c41\u0c35 \u0c15\u0c3e\u0c26\u0c41)",list_9:"(i)   \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c2f\u0c4d\u0c2f\u0c47 \u0c28\u0c2e\u0c4b\u0c26\u0c3f\u0c24 \u0c35\u0c3f\u0c15\u0c4d\u0c30\u0c2f \u0c12\u0c2a\u0c4d\u0c2a\u0c02\u0c26\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c2c\u0c39\u0c41\u0c2e\u0c24\u0c3f \u0c26\u0c38\u0c4d\u0c24\u0c3e\u0c35\u0c47\u0c1c\u0c41",list_10:"(j)    \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c02/\u0c1a\u0c1f\u0c4d\u0c1f\u0c2c\u0c26\u0c4d\u0c27\u0c2e\u0c48\u0c28 \u0c38\u0c02\u0c38\u0c4d\u0c25/PSU \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c35\u0c38\u0c24\u0c3f \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c2a\u0c41 \u0c32\u0c47\u0c16 (\u0c12\u0c15 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02 \u0c15\u0c02\u0c1f\u0c47 \u0c0e\u0c15\u0c4d\u0c15\u0c41\u0c35 \u0c15\u0c3e\u0c26\u0c41)",list_11:"(k)    \u0c1c\u0c40\u0c35\u0c3f\u0c24 \u0c32\u0c47\u0c26\u0c3e \u0c35\u0c48\u0c26\u0c4d\u0c2f \u0c2c\u0c40\u0c2e\u0c3e \u0c2a\u0c3e\u0c32\u0c38\u0c40 (\u0c12\u0c15 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02 \u0c15\u0c02\u0c1f\u0c47 \u0c0e\u0c15\u0c4d\u0c15\u0c41\u0c35 \u0c15\u0c3e\u0c26\u0c41) "}}},three:{title:"\u0c28\u0c47\u0c28\u0c41 \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c42\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u0c32\u0c28\u0c41  \u0c0e\u0c32\u0c3e \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c17\u0c32\u0c28\u0c41?",content:"\u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d\u200c\u0c32\u0c4b myAadhaar \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d https://myaadhaar.uidai.gov.in/ \u0c32\u0c47\u0c26\u0c3e \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c46\u0c02\u0c1f\u0c30\u0c4d\u200c\u0c32\u0c4b \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41."},four:{title:"\u0c28\u0c47\u0c28\u0c41 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d\u200c\u0c32\u0c4b \u0c0e\u0c32\u0c3e \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c17\u0c32\u0c28\u0c41? ",content:{list_1:"(1)     https://myaadhaar.uidai.gov.in/\u0c15\u0c3f \u0c35\u0c46\u0c33\u0c4d\u0c32\u0c3f, \u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c40 \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c35\u0c1a\u0c4d\u0c1a\u0c3f\u0c28  \u0c35\u0c28\u0c4d-\u0c1f\u0c48\u0c2e\u0c4d \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d (OTP)\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",list_2:"(2)     \u0c2e\u0c40 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d\u200c\u0c32\u0c4b \u0c2a\u0c4d\u0c30\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c2e\u0c40 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",list_3:"(3)     \u0c2e\u0c40 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d\u200c\u0c32\u0c4b \u0c2a\u0c4d\u0c30\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c24\u0c2a\u0c4d\u0c2a\u0c41\u0c17\u0c3e \u0c09\u0c28\u0c4d\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47, \u0c26\u0c3f\u0c17\u0c41\u0c35 5\u0c35 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c15\u0c41 \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c28\u0c17\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c3f\u0c27\u0c02\u0c17\u0c3e \u0c1a\u0c30\u0c4d\u0c2f \u0c24\u0c40\u0c38\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.",list_4:"(4)     \u0c2e\u0c40 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d\u200c\u0c32\u0c4b \u0c2a\u0c4d\u0c30\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c38\u0c30\u0c48\u0c28\u0c35\u0c3f \u0c05\u0c2f\u0c3f\u0c24\u0c47, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u2018\u0c2a\u0c48\u0c28 \u0c09\u0c28\u0c4d\u0c28 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c38\u0c30\u0c48\u0c28\u0c35\u0c28\u0c3f \u0c28\u0c47\u0c28\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c28\u0c41\u2019 \u0c05\u0c28\u0c47 \u0c1f\u0c4d\u0c2f\u0c3e\u0c2c\u0c4d\u200c\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",list_5:"(5)     \u0c2e\u0c40\u0c30\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28 \u0c21\u0c4d\u0c30\u0c3e\u0c2a\u0c4d-\u0c21\u0c4c\u0c28\u0c4d \u0c2e\u0c46\u0c28\u0c41 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.",list_6:"(6)     \u0c2e\u0c40 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f (\u0c2a\u0c30\u0c3f\u0c2e\u0c3e\u0c23\u0c02 2 MB \u0c15\u0c02\u0c1f\u0c47 \u0c24\u0c15\u0c4d\u0c15\u0c41\u0c35; \u0c2b\u0c48\u0c32\u0c4d \u0c2b\u0c3e\u0c30\u0c4d\u0c2e\u0c3e\u0c1f\u0c4d JPEG, PNG \u0c32\u0c47\u0c26\u0c3e PDF)",list_7:"(7)     \u0c2e\u0c40\u0c30\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28 \u0c21\u0c4d\u0c30\u0c3e\u0c2a\u0c4d-\u0c21\u0c4c\u0c28\u0c4d \u0c2e\u0c46\u0c28\u0c41 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.",list_8:"(8)     \u0c2e\u0c40 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f (\u0c2a\u0c30\u0c3f\u0c2e\u0c3e\u0c23\u0c02 2 MB \u0c15\u0c02\u0c1f\u0c47 \u0c24\u0c15\u0c4d\u0c15\u0c41\u0c35; \u0c2b\u0c48\u0c32\u0c4d \u0c2b\u0c3e\u0c30\u0c4d\u0c2e\u0c3e\u0c1f\u0c4d JPEG, PNG \u0c32\u0c47\u0c26\u0c3e PDF).",list_9:"(9)     \u0c2e\u0c40 \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c28\u0c3f \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f."}},five:{title:"\u0c28\u0c3e \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d\u200c\u0c32\u0c4b \u0c2a\u0c4d\u0c30\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c2e\u0c40 \u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c24\u0c4b \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c32\u0c15\u0c2a\u0c4b\u0c24\u0c47, \u0c28\u0c47\u0c28\u0c41 \u0c0f\u0c2e\u0c3f \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c3f?",content:{list_1:"(1)\xa0\xa0\xa0\xa0 \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f '\u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c32\u0c4b \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c32\u0c28\u0c3f \u0c2a\u0c15\u0c4d\u0c37\u0c02\u0c32\u0c4b, \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f', '\u0c2a\u0c48\u0c28 \u0c09\u0c28\u0c4d\u0c28 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c38\u0c30\u0c48\u0c28\u0c35\u0c28\u0c3f \u0c28\u0c47\u0c28\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41' \u0c1f\u0c4d\u0c2f\u0c3e\u0c2c\u0c4d\u200c\u0c32\u0c4b\u0c28\u0c3f \u0c32\u0c3f\u0c02\u0c15\u0c4d\u200c\u0c28\u0c41 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",list_2:"(2)\xa0\xa0\xa0\xa0 \u0c2a\u0c4d\u0c30\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c47 \u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u200c\u0c32\u0c4b \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c2a\u0c42\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",list_3:"(3)\xa0\xa0\xa0\xa0 \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28 \u0c21\u0c4d\u0c30\u0c3e\u0c2a\u0c4d-\u0c21\u0c4c\u0c28\u0c4d \u0c2e\u0c46\u0c28\u0c41 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.",list_4:"(4)\xa0\xa0\xa0\xa0 \u0c2e\u0c40 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f (\u0c2a\u0c30\u0c3f\u0c2e\u0c3e\u0c23\u0c02 2 MB \u0c15\u0c02\u0c1f\u0c47 \u0c24\u0c15\u0c4d\u0c15\u0c41\u0c35; \u0c2b\u0c48\u0c32\u0c4d \u0c2b\u0c3e\u0c30\u0c4d\u0c2e\u0c3e\u0c1f\u0c4d\xa0JPEG, PNG\xa0\u0c32\u0c47\u0c26\u0c3e\xa0PDF).",list_5:"(5)\xa0\xa0\xa0\xa0 \u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",list_6:"(6) \u0c2e\u0c40 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f."}},six:{title:"\u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 (\u0c2a\u0c47\u0c30\u0c41, \u0c32\u0c3f\u0c02\u0c17\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c40) \u0c28\u0c3e \u0c35\u0c3e\u0c38\u0c4d\u0c24\u0c35 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c24\u0c4b \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c32\u0c15\u0c2a\u0c4b\u0c24\u0c47, \u0c28\u0c47\u0c28\u0c41 \u0c0f\u0c2e\u0c3f \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c3f? ",content:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f https://uidai.gov.in/images/commdoc/List_of_Supporting_Document_for_Aadhaar_Enrolment_and_Update.pdf \u0c32\u0c4b \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c05\u0c38\u0c32\u0c48\u0c28 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c24\u0c4b \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f."},seven:{title:"\u0c28\u0c47\u0c28\u0c41 \u0c06\u0c2b\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d\u200c\u0c32\u0c4b \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c47, \u0c28\u0c47\u0c28\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c32\u0c3e \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c17\u0c32\u0c28\u0c41?",content:{list_1:"(1)     \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f https://bhuvan.nrsc.gov.in/aadhaar/\u0c15\u0c3f \u0c35\u0c46\u0c33\u0c4d\u0c32\u0c02\u0c21\u0c3f",list_2:"(2)     \u0c38\u0c2e\u0c40\u0c2a\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c15\u0c4b\u0c38\u0c02, \u2018\u0c38\u0c2e\u0c40\u0c2a \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c41\u2019 \u0c1f\u0c4d\u0c2f\u0c3e\u0c2c\u0c4d\u200c\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c38\u0c2e\u0c40\u0c2a\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c40 \u0c38\u0c4d\u0c25\u0c3e\u0c28 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",list_3:"(3) \u0c2e\u0c40 \u0c2a\u0c3f\u0c28\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c02\u0c32\u0c4b \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c15\u0c4b\u0c38\u0c02, \u2018\u0c2a\u0c3f\u0c28\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c36\u0c4b\u0c27\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f\u2019 \u0c1f\u0c4d\u0c2f\u0c3e\u0c2c\u0c4d\u200c\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c06 \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c40 \u0c0f\u0c30\u0c3f\u0c2f\u0c3e \u0c2a\u0c3f\u0c28\u0c4d \u0c15\u0c4b\u0c21\u0c4d\u200c\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f"}},eight:{title:"\u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40 \u0c0e\u0c02\u0c24?",content:"14 \u0c38\u0c46\u0c2a\u0c4d\u0c1f\u0c46\u0c02\u0c2c\u0c30\u0c4d 2023 \u0c35\u0c30\u0c15\u0c41 myAadhaar \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d\u200c\u0c32\u0c4b \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c23 \u0c09\u0c1a\u0c3f\u0c24\u0c02. \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c02\u0c32\u0c4b \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c35\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c47 \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40 \u0c30\u0c42. 50."},nine:{title:"\u0c28\u0c47\u0c28\u0c41 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c0e\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f \u0c35\u0c30\u0c15\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f?",content:"\u0c1c\u0c40\u0c35\u0c28 \u0c38\u0c4c\u0c32\u0c2d\u0c4d\u0c2f\u0c02, \u0c2e\u0c46\u0c30\u0c41\u0c17\u0c48\u0c28 \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c21\u0c46\u0c32\u0c3f\u0c35\u0c30\u0c40 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c2e\u0c48\u0c28 \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c15\u0c4b\u0c38\u0c02 \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c2e\u0c02\u0c1a\u0c3f\u0c26\u0c3f.  \u0c05\u0c02\u0c26\u0c41\u0c35\u0c32\u0c4d\u0c32, \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c2e\u0c41\u0c02\u0c26\u0c38\u0c4d\u0c24\u0c41 \u0c24\u0c47\u0c26\u0c40\u0c32\u0c4b \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c2e\u0c40 \u0c06\u0c38\u0c15\u0c4d\u0c24\u0c3f \u0c2c\u0c1f\u0c4d\u0c1f\u0c3f \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f."},ten:{title:"\u0c28\u0c47\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c35\u0c3e\u0c38 \u0c2d\u0c3e\u0c30\u0c24\u0c40\u0c2f\u0c41\u0c21\u0c3f\u0c28\u0c3f (NRI). \u0c28\u0c47\u0c28\u0c41 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c0e\u0c32\u0c3e \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c17\u0c32\u0c28\u0c41?",content:"\u0c2e\u0c40\u0c30\u0c41 \u0c2d\u0c3e\u0c30\u0c24\u0c26\u0c47\u0c36\u0c02\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c0e\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c48\u0c28\u0c3e \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41."}}},aadharUpdateHistory:{title1:"\u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c39\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c40\u0c28\u0c3f \u0c1a\u0c46\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",label1:"\u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",label2:"\u0c28\u0c2e\u0c4b\u0c26\u0c41/\u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c24\u0c47\u0c26\u0c40",label3:"URN/EID",label4:"\u0c1f\u0c48\u0c2a\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",list1:"\u0c2a\u0c47\u0c30\u0c41",list2:"\u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d",list3:"\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d",list4:"\u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c3f",list5:"\u0c32\u0c3f\u0c02\u0c17\u0c02",list6:"\u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e"},ssup:{howItWorks:{title:"\u0c05\u0c26\u0c3f \u0c0e\u0c32\u0c3e \u0c2a\u0c28\u0c3f \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f",description:"\u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c2a\u0c41\u0c28\u0c30\u0c41\u0c26\u0c4d\u0c27\u0c30\u0c23 \u0c2a\u0c4d\u0c30\u0c15\u0c4d\u0c30\u0c3f\u0c2f\u0c28\u0c41 \u0c05\u0c30\u0c4d\u0c25\u0c02 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26\u0c3f \u0c26\u0c36\u0c32\u0c28\u0c41 \u0c1a\u0c26\u0c35\u0c02\u0c21\u0c3f. \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c38\u0c46\u0c38\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c02\u0c32\u0c4b \u0c32\u0c47\u0c26\u0c3e \u0c24\u0c3f\u0c30\u0c38\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c02\u0c32\u0c4b \u0c06\u0c32\u0c38\u0c4d\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3f\u0c35\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c3f\u0c35\u0c3f\u0c27 \u0c26\u0c36\u0c32\u0c32\u0c4b \u0c38\u0c3f\u0c2b\u0c3e\u0c30\u0c4d\u0c38\u0c41 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c26\u0c36\u0c32\u0c28\u0c41 \u0c05\u0c28\u0c41\u0c38\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",proceedToUpdateAadhaar:"\u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c15\u0c41 \u0c35\u0c46\u0c33\u0c4d\u0c32\u0c02\u0c21\u0c3f",stepDescription:{one:"\u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c2b\u0c40\u0c32\u0c4d\u0c21\u0c4d\u200c\u0c28\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f. \u0c08 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e, \u0c2e\u0c40\u0c30\u0c41 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c28\u0c41 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c2a\u0c47\u0c30\u0c41, \u0c32\u0c3f\u0c02\u0c17\u0c02, DOB, \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d, \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2c\u0c2f\u0c4b\u0c2e\u0c46\u0c1f\u0c4d\u0c30\u0c3f\u0c15\u0c4d \u0c21\u0c47\u0c1f\u0c3e \u0c15\u0c4b\u0c38\u0c02, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c2e\u0c40\u0c2a\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",two:"\u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c1c\u0c28\u0c28\u0c3e\u0c02\u0c15\u0c3f\u0c15 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c21\u0c4d\u0c30\u0c3e\u0c2a\u0c4d-\u0c21\u0c4c\u0c28\u0c4d \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c1c\u0c28\u0c3e\u0c2d\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c3e\u0c32\u0c3f. \u0c1c\u0c28\u0c3e\u0c2d\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c38\u0c47\u0c1f\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c21\u0c4d\u0c30\u0c3e\u0c2a\u0c4d-\u0c21\u0c4c\u0c28\u0c4d \u0c0e\u0c02\u0c2a\u0c3f\u0c15\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c41\u0c28\u0c47\u0c1f\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c1c\u0c3e\u0c17\u0c4d\u0c30\u0c24\u0c4d\u0c24\u0c17\u0c3e \u0c09\u0c02\u0c21\u0c02\u0c21\u0c3f.",three:"\u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23\u0c15\u0c41 \u0c05\u0c38\u0c32\u0c48\u0c28 \u0c38\u0c39\u0c3e\u0c2f\u0c15 \u0c2a\u0c24\u0c4d\u0c30\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c38\u0c4d\u0c15\u0c3e\u0c28\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c15\u0c3e\u0c2a\u0c40 \u0c05\u0c35\u0c38\u0c30\u0c02. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c2e\u0c40 \u0c2a\u0c47\u0c30\u0c41 \u0c2e\u0c40\u0c26 \u0c09\u0c02\u0c26\u0c28\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c2f\u0c4d\u0c2f\u0c47\u0c32\u0c3e \u0c1a\u0c42\u0c38\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f. \u0c2e\u0c40\u0c30\u0c41 UIDAI \u0c38\u0c4d\u0c1f\u0c3e\u0c02\u0c21\u0c30\u0c4d\u0c21\u0c4d \u0c2b\u0c3e\u0c30\u0c4d\u0c2e\u0c3e\u0c1f\u0c4d\u200c\u0c32\u0c4b \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c46\u0c1f\u0c4d\u200c\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c1c\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c1f\u0c47, \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c24\u0c3f\u0c30\u0c38\u0c4d\u0c15\u0c30\u0c23\u0c28\u0c41 \u0c28\u0c3f\u0c35\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c07\u0c37\u0c4d\u0c2f\u0c42 \u0c24\u0c47\u0c26\u0c40, \u0c15\u0c4d\u0c30\u0c3e\u0c38\u0c4d\u0c21\u0c4d \u0c38\u0c48\u0c28\u0c4d, \u0c2b\u0c4b\u0c1f\u0c4b \u0c05\u0c02\u0c24\u0c1f\u0c3e \u0c38\u0c4d\u0c1f\u0c3e\u0c02\u0c2a\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c13\u0c35\u0c30\u0c4d\u200c\u0c30\u0c48\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c35\u0c02\u0c1f\u0c3f \u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23 \u0c24\u0c2a\u0c4d\u0c2a\u0c41\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",four:"\u0c2e\u0c40\u0c30\u0c41 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c30\u0c41\u0c38\u0c41\u0c2e\u0c41\u0c15\u0c3f \u20b9 50 (\u0c30\u0c42\u0c2a\u0c3e\u0c2f\u0c3f \u0c2f\u0c3e\u0c2d\u0c48 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47) \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c15\u0c4d\u0c30\u0c46\u0c21\u0c3f\u0c1f\u0c4d / \u0c21\u0c46\u0c2c\u0c3f\u0c1f\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c46\u0c1f\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c08 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c26\u0c41. \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c37\u0c2f\u0c02\u0c32\u0c4b, \u0c2e\u0c40\u0c30\u0c41 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41\u0c28\u0c41 \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",five:"\u0c2e\u0c40\u0c30\u0c41 \u0c38\u0c47\u0c35\u0c3e \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c38\u0c02\u0c16\u0c4d\u0c2f (SRN) \u0c28\u0c41 \u0c38\u0c42\u0c1a\u0c28\u0c17\u0c3e \u0c2a\u0c4a\u0c02\u0c26\u0c41\u0c24\u0c3e\u0c30\u0c41. \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c32\u0c47\u0c26\u0c3e UIDAI \u0c39\u0c46\u0c32\u0c4d\u0c2a\u0c4d\u200c\u0c21\u0c46\u0c38\u0c4d\u0c15\u0c4d\u200c\u0c24\u0c4b \u0c2d\u0c35\u0c3f\u0c37\u0c4d\u0c2f\u0c24\u0c4d\u0c24\u0c41\u0c32\u0c4b \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c08 \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c28\u0c41 \u0c2d\u0c26\u0c4d\u0c30\u0c2a\u0c30\u0c1a\u0c02\u0c21\u0c3f",six:"\u0c2e\u0c40 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c2e\u0c3e \u0c05\u0c02\u0c24\u0c30\u0c4d\u0c17\u0c24 \u0c28\u0c3e\u0c23\u0c4d\u0c2f\u0c24 \u0c1a\u0c46\u0c15\u0c4d \u0c06\u0c2a\u0c30\u0c47\u0c1f\u0c30\u0c4d\u0c32\u0c1a\u0c47 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c08 \u0c26\u0c36\u0c32\u0c4b \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c1c\u0c28\u0c28\u0c3e\u0c02\u0c15\u0c3f\u0c15 \u0c21\u0c47\u0c1f\u0c3e \u0c38\u0c39\u0c3e\u0c2f\u0c15 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c28\u0c41\u0c17\u0c41\u0c23\u0c02\u0c17\u0c3e \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c05\u0c38\u0c2e\u0c24\u0c41\u0c32\u0c4d\u0c2f\u0c24 \u0c09\u0c02\u0c1f\u0c47, \u0c2e\u0c40 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c24\u0c3f\u0c30\u0c38\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c47 \u0c05\u0c35\u0c15\u0c3e\u0c36\u0c02 \u0c09\u0c02\u0c26\u0c3f.",seven:"\u0c28\u0c3e\u0c23\u0c4d\u0c2f\u0c24 \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c2a\u0c4d\u0c30\u0c15\u0c4d\u0c30\u0c3f\u0c2f \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c2f\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, \u0c2e\u0c40\u0c30\u0c41 \u0c0e\u0c28\u0c4d\u200c\u0c30\u0c4b\u0c32\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c10\u0c21\u0c3f\u0c28\u0c3f \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c28\u0c4d\u0c28 SMS \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d\u200c\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c3e\u0c30\u0c41.",eight:"\u0c2e\u0c3e \u0c2c\u0c4d\u0c2f\u0c3e\u0c15\u0c46\u0c02\u0c21\u0c4d \u0c38\u0c3e\u0c2b\u0c4d\u0c1f\u0c4d\u200c\u0c35\u0c47\u0c30\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c30\u0c3f\u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c27\u0c4d\u0c30\u0c41\u0c35\u0c40\u0c15\u0c30\u0c23\u0c32 \u0c24\u0c30\u0c41\u0c35\u0c3e\u0c24, \u0c2e\u0c40 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c2a\u0c4d\u0c30\u0c3e\u0c38\u0c46\u0c38\u0c3f\u0c02\u0c17\u0c4d \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c2b\u0c32\u0c3f\u0c24\u0c02\u0c2a\u0c48 \u0c2e\u0c40\u0c15\u0c41 SMS \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c35\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",nine:"\u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23\u0c02\u0c17\u0c3e \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 90% \u0c38\u0c47\u0c35\u0c3e \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c3e\u0c32\u0c24\u0c4b 30 \u0c30\u0c4b\u0c1c\u0c41\u0c32\u0c4d\u0c32\u0c4b \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c05\u0c2f\u0c3f\u0c28\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c40, \u0c2e\u0c47\u0c2e\u0c41 \u0c2e\u0c3e \u0c38\u0c3f\u0c38\u0c4d\u0c1f\u0c2e\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c2e\u0c46\u0c30\u0c41\u0c17\u0c41\u0c2a\u0c30\u0c41\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c2e\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3e\u0c32\u0c3e \u0c2e\u0c1f\u0c41\u0c15\u0c41, \u0c2e\u0c40 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c38\u0c2e\u0c2f\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c41\u0c02\u0c26\u0c47 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c2e\u0c40\u0c30\u0c41 myaadhaar.uidai.gov.in \u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c2a\u0c4d\u0c30\u0c3e\u0c38\u0c46\u0c38\u0c3f\u0c02\u0c17\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41."}},updateSelectPage:{title:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c41 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d\u200c\u0c32\u0c4b \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",selectFields:{smallDescription:"\u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c21\u0c47\u0c1f\u0c3e \u0c2b\u0c40\u0c32\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",longDescription:"\u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c15\u0c3f\u0c02\u0c26\u0c3f \u0c35\u0c3e\u0c1f\u0c3f\u0c32\u0c4b \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c21\u0c47\u0c1f\u0c3e \u0c2b\u0c40\u0c32\u0c4d\u0c21\u0c4d (\u0c32) \u0c28\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",updatesLeft:" \u0c2e\u0c3f\u0c17\u0c3f\u0c32\u0c3f\u0c28 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23\u0c32\u0c41",noLimit:"\u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24\u0c3f \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c3e",demoGraphics:{language:"\u0c2d\u0c3e\u0c37",name:"\u0c2a\u0c47\u0c30\u0c41",dob:"\u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c3f",gender:"\u0c32\u0c3f\u0c02\u0c17\u0c02",hof:"\u0c15\u0c41\u0c1f\u0c41\u0c02\u0c2c \u0c2a\u0c46\u0c26\u0c4d\u0c26 (HOF) \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23",address:"\u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e"}},documentDescriptionLinkText:"\u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f PoI / PoA / PoB \u0c15\u0c3f \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c2f\u0c4d\u0c2f\u0c47 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c1a\u0c42\u0c21\u0c02\u0c21\u0c3f",proceedToUpdateAadhaar:"\u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c35\u0c46\u0c33\u0c4d\u0c32\u0c02\u0c21\u0c3f",faq:"\u0c24\u0c30\u0c1a\u0c41\u0c17\u0c3e \u0c05\u0c21\u0c41\u0c17\u0c41 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c41"},dashboard:"\u0c21\u0c3e\u0c37\u0c4d\u200c\u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c4d\u200c",hof:{title:"\u0c15\u0c41\u0c1f\u0c41\u0c02\u0c2c \u0c2a\u0c46\u0c26\u0c4d\u0c26 (HOF) \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23",description:"\u0c15\u0c41\u0c1f\u0c41\u0c02\u0c2c \u0c2a\u0c46\u0c26\u0c4d\u0c26 \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23\u0c24\u0c4b \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",howItWorks:{step1:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c21\u0c47\u0c1f\u0c3e\u0c2c\u0c47\u0c38\u0c4d \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c15\u0c41\u0c1f\u0c41\u0c02\u0c2c \u0c2a\u0c46\u0c26\u0c4d\u0c26 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. 18 \u0c0f\u0c33\u0c4d\u0c32\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c05\u0c02\u0c24\u0c15\u0c02\u0c1f\u0c47 \u0c0e\u0c15\u0c4d\u0c15\u0c41\u0c35 \u0c35\u0c2f\u0c38\u0c4d\u0c38\u0c41 \u0c09\u0c28\u0c4d\u0c28 \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f\u0c24\u0c41\u0c32\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 HoF\u0c17\u0c3e \u0c2a\u0c30\u0c3f\u0c17\u0c23\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c30\u0c41.",step2:'\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c2a\u0c47\u0c30\u0c41\u0c24\u0c4b \u0c2a\u0c3e\u0c1f\u0c41 \u0c2e\u0c40 \u0c15\u0c41\u0c1f\u0c41\u0c02\u0c2c \u0c2a\u0c46\u0c26\u0c4d\u0c26 \u0c2a\u0c47\u0c30\u0c41\u0c28\u0c41 \u0c38\u0c4d\u0c2a\u0c37\u0c4d\u0c1f\u0c02\u0c17\u0c3e \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c30\u0c3f\u0c32\u0c47\u0c37\u0c28\u0c4d\u0c37\u0c3f\u0c2a\u0c4d \u0c30\u0c41\u0c1c\u0c41\u0c35\u0c41 (PoR) \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40\u0c24\u0c4b HoF \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f, \u0c09\u0c26\u0c3e\u0c39\u0c30\u0c23\u0c15\u0c41 HoF \u0c2e\u0c40 \u0c2d\u0c30\u0c4d\u0c24 \u0c05\u0c2f\u0c3f\u0c24\u0c47, "\u0c2d\u0c30\u0c4d\u0c24"\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.',step3:"\u0c2e\u0c40\u0c30\u0c41 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c30\u0c41\u0c38\u0c41\u0c2e\u0c41  \u20b9 50 (\u0c30\u0c42. \u0c2f\u0c3e\u0c2d\u0c48 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47) \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c15\u0c4d\u0c30\u0c46\u0c21\u0c3f\u0c1f\u0c4d/\u0c21\u0c46\u0c2c\u0c3f\u0c1f\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c46\u0c1f\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c08 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c26\u0c41.",step4:"\u0c2e\u0c40 \u0c15\u0c41\u0c1f\u0c41\u0c02\u0c2c \u0c2a\u0c46\u0c26\u0c4d\u0c26 myAadhaar \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d\u200c\u0c32\u0c4b\u0c15\u0c3f \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c05\u0c2f\u0c3f\u0c28\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41, \u0c35\u0c3e\u0c30\u0c41 \u0c05\u0c21\u0c4d\u0c30\u0c38\u0c4d \u0c37\u0c47\u0c30\u0c3f\u0c02\u0c17\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c12\u0c15 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c38\u0c4d\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41, \u0c26\u0c3e\u0c28\u0c3f\u0c28\u0c3f \u0c35\u0c3e\u0c30\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c24\u0c3f\u0c30\u0c38\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. HoF \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c06\u0c2e\u0c4b\u0c26\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f / \u0c24\u0c3f\u0c30\u0c38\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c08 \u0c0e\u0c02\u0c2a\u0c3f\u0c15 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c40 \u0c28\u0c41\u0c02\u0c21\u0c3f 30 \u0c30\u0c4b\u0c1c\u0c41\u0c32 \u0c35\u0c30\u0c15\u0c41 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f."},currentSection:{title:"\u0c05\u0c2a\u0c4d \u0c21\u0c47\u0c1f\u0c4d  \u0c15\u0c4b\u0c38\u0c02 HoF \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c05\u0c35\u0c38\u0c30\u0c02"},updateSection:{forms:{hofUid:{label:"HoF \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f"},mobileField:{label:"HoF \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d"},documentUpload:{label:"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c2f\u0c4d\u0c2f\u0c47 \u0c38\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c30\u0c15\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f"},relationshipDropdown:{label:"\u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41\u0c26\u0c3e\u0c30\u0c41\u0c24\u0c4b HoF \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",values:{father:"\u0c24\u0c02\u0c21\u0c4d\u0c30\u0c3f",mother:"\u0c24\u0c32\u0c4d\u0c32\u0c3f",husband:"\u0c2d\u0c30\u0c4d\u0c24",wife:"\u0c2d\u0c3e\u0c30\u0c4d\u0c2f",guardian:"\u0c38\u0c02\u0c30\u0c15\u0c4d\u0c37\u0c15\u0c41\u0c21\u0c41",Others:"\u0c07\u0c24\u0c30\u0c41\u0c32\u0c41"}}}}},documentInfoPopup:{title:"\u0c2e\u0c40 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c38\u0c46\u0c38\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c30\u0c48\u0c28 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",identityDocumentInfo:"\u0c2a\u0c24\u0c4d\u0c30\u0c02 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c30\u0c41\u0c1c\u0c41\u0c35\u0c41 \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c2f\u0c3f\u0c24\u0c47, \u0c05\u0c26\u0c3f \u0c2e\u0c40 \u0c2a\u0c47\u0c30\u0c41 \u0c2e\u0c40\u0c26 \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2b\u0c4b\u0c1f\u0c4b\u0c17\u0c4d\u0c30\u0c3e\u0c2b\u0c4d \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u200c\u0c32\u0c4b \u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 '\u0c2a\u0c47\u0c30\u0c41' \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28 \u0c2a\u0c24\u0c4d\u0c30\u0c02\u0c32\u0c4b\u0c28\u0c3f '\u0c2a\u0c47\u0c30\u0c41'\u0c24\u0c4b \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c32\u0c41\u0c24\u0c41\u0c02\u0c26\u0c28\u0c3f \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",addressDocumentInfo:"\u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c30\u0c41\u0c1c\u0c41\u0c35\u0c41 \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c2f\u0c3f\u0c24\u0c47, \u0c05\u0c26\u0c3f \u0c2e\u0c40 \u0c2a\u0c47\u0c30\u0c41 \u0c2e\u0c40\u0c26 \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f. \u0c1c\u0c40\u0c35\u0c3f\u0c24 \u0c2d\u0c3e\u0c17\u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c3f, \u0c38\u0c02\u0c30\u0c15\u0c4d\u0c37\u0c15\u0c41\u0c32\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c24\u0c32\u0c4d\u0c32\u0c3f\u0c26\u0c02\u0c21\u0c4d\u0c30\u0c41\u0c32 \u0c2a\u0c47\u0c30\u0c3f\u0c1f \u0c09\u0c28\u0c4d\u0c28 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c41 \u0c06\u0c2e\u0c4b\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c35\u0c41. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u200c\u0c32\u0c4b \u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 '\u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e' \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28 \u0c2a\u0c24\u0c4d\u0c30\u0c02\u0c32\u0c4b\u0c28\u0c3f '\u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e'\u0c24\u0c4b \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c32\u0c41\u0c24\u0c41\u0c02\u0c26\u0c28\u0c3f \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",close:"\u0c35\u0c4a\u0c2a\u0c4d\u0c2a\u0c41\u0c1f",continueToUpload:"\u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f"},forms:{reUseDocText:"\u0c2e\u0c40\u0c30\u0c41 \u0c15\u0c3f\u0c02\u0c26\u0c3f \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",stepper:{language:"\u0c2d\u0c3e\u0c37",Name:"\u0c2a\u0c47\u0c30\u0c41",dob:"\u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c3f",gender:"\u0c32\u0c3f\u0c02\u0c17\u0c02",address:"\u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e",preview:"\u0c2a\u0c30\u0c3f\u0c26\u0c43\u0c36\u0c4d\u0c2f\u0c02 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",payment:"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41"},formButtons:{back:"\u0c35\u0c46\u0c28\u0c15\u0c4d\u0c15\u0c3f  \u0c05\u0c28\u0c41\u0c38\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",next:"\u0c24\u0c30\u0c41\u0c35\u0c3e\u0c24",makePayment:"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",retry:"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41\u0c28\u0c41 \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",goToDashboard:"\u0c21\u0c3e\u0c37\u0c4d\u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c4d \u0c15\u0c41 \u0c35\u0c46\u0c33\u0c4d\u0c33\u0c02\u0c21\u0c3f"},languageForm:{currentSection:{title:"\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24 \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3f\u0c15 \u0c2d\u0c3e\u0c37 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41",fields:{currentLocalLanguage:"\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24 \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3f\u0c15 \u0c2d\u0