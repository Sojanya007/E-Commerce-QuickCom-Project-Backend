f\u0aa4 \u0a95\u0ab0\u0acb",updateDOB:"\u0a9c\u0aa8\u0acd\u0aae \u0aa4\u0abe\u0ab0\u0ac0\u0a96 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0acb",updateGender:"\u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac7\u0ab2 \u0ab2\u0abf\u0a82\u0a97 \u0ab8\u0a82\u0aaa\u0abe\u0aa6\u0abf\u0aa4 \u0a95\u0ab0\u0acb",updateAddress:"\u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac7\u0ab2\u0ac1\u0a82 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0ab8\u0a82\u0aaa\u0abe\u0aa6\u0abf\u0aa4 \u0a95\u0ab0\u0acb"},edit:"\u0ab8\u0a82\u0aaa\u0abe\u0aa6\u0abf\u0aa4 \u0a95\u0ab0\u0acb",supportingDocuments:"\u0ab8\u0ab9\u0abe\u0aaf\u0a95 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c",dataFields:"\u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aa1\u0ac7\u0a9f\u0abe \u0aab\u0ac0\u0ab2\u0acd\u0aa1\u0acd\u0ab8",transliterationText:"\u0aaf\u0ac1\u0a86\u0a88\u0aa1\u0ac0\u0a8f\u0a86\u0a88\u0aa8\u0ac7 \u0aa5\u0a88 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 \u0aa4\u0ac7 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab2\u0abf\u0ab5\u0acd\u0aaf\u0a82\u0aa4\u0ab0\u0aa3 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0a85\u0a9a\u0acb\u0a95\u0acd\u0a95\u0ab8\u0aa4\u0abe\u0aa8\u0ac7 \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0aae\u0a82\u0a9c\u0ac2\u0ab0\u0ac0 \u0a86\u0aaa\u0acb.",acceptTermsText:"\u0ab9\u0ac1\u0a82 \u0a86 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaa\u0ac1\u0ab7\u0acd\u0a9f\u0abf \u0a86\u0aaa\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0aae\u0ac7\u0a82 \u0ab8\u0ac2\u0a9a\u0aa8\u0abe\u0a93\u0aa8\u0ac7 \u0a95\u0abe\u0ab3\u0a9c\u0ac0\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0ab5\u0abe\u0a82\u0a9a\u0acd\u0aaf\u0abe \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aaf\u0ac1\u0a86\u0a87\u0aa1\u0ac0\u0a8f\u0a86\u0a87\u0aa8\u0ac7 \u0aae\u0abe\u0ab0\u0abe \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0ab8\u0abe\u0a9a\u0ac0 \u0a85\u0aa8\u0ac7 \u0ab8\u0abe\u0a9a\u0ac0 \u0a9b\u0ac7",acceptTermsText_p1:"\u0ab9\u0ac1\u0a82 \u0a86\u0aa5\u0ac0 \u0aaa\u0ac1\u0ab7\u0acd\u0a9f\u0abf \u0a95\u0ab0\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a85\u0aa8\u0ac7 \u0a9c\u0abe\u0ab9\u0ac7\u0ab0 \u0a95\u0ab0\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0ac0 \u0aa4\u0aae\u0abe\u0aae \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0a85\u0aa8\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0aae\u0abe\u0ab0\u0ac0 \u0ab6\u0acd\u0ab0\u0ac7\u0ab7\u0acd\u0aa0 \u0a9c\u0abe\u0aa3 \u0a85\u0aa8\u0ac7 \u0aae\u0abe\u0aa8\u0acd\u0aaf\u0aa4\u0abe \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac7 \u0ab8\u0abe\u0a9a\u0abe \u0a9b\u0ac7.",acceptTermsText_p2:"\u0ab9\u0ac1\u0a82 \u0ab8\u0aae\u0a9c\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0a9c\u0acb \u0a89\u0aaa\u0ab0\u0acb\u0a95\u0acd\u0aa4 \u0a98\u0acb\u0ab7\u0aa3\u0abe \u0a96\u0acb\u0a9f\u0ac0 \u0ab9\u0acb\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0a9c\u0aa3\u0abe\u0aaf\u0ac1\u0a82, \u0aa4\u0acb \u0aae\u0abe\u0ab0\u0acb \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa8\u0abf\u0ab7\u0acd\u0a95\u0acd\u0ab0\u0abf\u0aaf \u0aa5\u0a88 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0ab5\u0aa7\u0ac1\u0aae\u0abe\u0a82, \u0a95\u0abe\u0aaf\u0aa6\u0abe \u0aae\u0ac1\u0a9c\u0aac \u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0abe\u0aae\u0ac7 \u0aaa\u0a97\u0ab2\u0abe\u0a82 \u0ab2\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.",acceptTermsText_p3:"\u0ab9\u0ac1\u0a82 \u0ab8\u0aae\u0a9c\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0a89\u0aaa\u0ab0\u0acb\u0a95\u0acd\u0aa4 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a86\u0aa7\u0abe\u0ab0 (\u0aa8\u0abe\u0aa3\u0abe\u0a95\u0ac0\u0aaf \u0a85\u0aa8\u0ac7 \u0a85\u0aa8\u0acd\u0aaf \u0ab8\u0aac\u0ab8\u0abf\u0aa1\u0ac0\u0a9d, \u0ab2\u0abe\u0aad\u0acb \u0a85\u0aa8\u0ac7 \u0ab8\u0ac7\u0ab5\u0abe\u0a93\u0aa8\u0ac0 \u0ab2\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0ab5\u0abf\u0aa4\u0ab0\u0aa3) \u0a85\u0aa7\u0abf\u0aa8\u0abf\u0aaf\u0aae, 2016 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aa8\u0abe \u0ab9\u0ac7\u0aa0\u0ab3 \u0aac\u0aa8\u0abe\u0ab5\u0ac7\u0ab2\u0abe \u0aa8\u0abf\u0aaf\u0aae\u0acb \u0a85\u0aa8\u0ac1\u0ab8\u0abe\u0ab0 \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7, \u0a9c\u0abe\u0ab9\u0ac7\u0ab0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7 \u0a85\u0aa5\u0ab5\u0abe \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.",acceptTermsText_p4:"\u0ab9\u0ac1\u0a82 \u0a86\u0aa5\u0ac0 \u0a86\u0ab5\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0\u0aa8\u0ac0 \u0aa4\u0ac8\u0aaf\u0abe\u0ab0\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0a9c\u0abe\u0ab3\u0ab5\u0aa3\u0ac0 \u0ab8\u0abe\u0aa5\u0ac7 \u0a95\u0abe\u0aae \u0a95\u0ab0\u0aa4\u0abe \u0a85\u0aa7\u0abf\u0a95\u0abe\u0ab0\u0ac0\u0a93\u0aa8\u0abe \u0aa1\u0ac7\u0a9f\u0abe\u0aac\u0ac7\u0a9d\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0a93\u0ab3\u0a96, \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82, \u0a9c\u0aa8\u0acd\u0aae \u0a85\u0aa8\u0ac7/\u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0aa8\u0acb \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0acb \u0a86\u0aaa\u0aa4\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0a87\u0ab2\u0ac7\u0a95\u0acd\u0a9f\u0acd\u0ab0\u0acb\u0aa8\u0abf\u0a95 \u0ab0\u0ac0\u0aa4\u0ac7 \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0aa8\u0ac7 \u0a89\u0aaa\u0ab0\u0acb\u0a95\u0acd\u0aa4 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0a85\u0aa8\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0a8f\u0a9c\u0aa8\u0acd\u0ab8\u0ac0\u0a93 \u0a85\u0aa8\u0ac7/\u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0abe\u0aa5\u0ac7 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0a86\u0aaa\u0ac1\u0a82 \u0a9b\u0ac1\u0a82. \u0a86\u0ab5\u0ac0 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab8\u0aa4\u0acd\u0aa4\u0abe, \u0a9a\u0a95\u0abe\u0ab8\u0aa3\u0ac0\u0aa8\u0abe \u0ab9\u0ac7\u0aa4\u0ac1 \u0aae\u0abe\u0a9f\u0ac7.",acceptTermsText_p5:"\u0ab9\u0ac1\u0a82 \u0a86\u0aa5\u0ac0 \u0a98\u0acb\u0ab7\u0aa3\u0abe \u0ab8\u0abe\u0aa5\u0ac7 \u0ab8\u0a82\u0aae\u0aa4 \u0a9b\u0ac1\u0a82.",errorPop:{error:"\u0aad\u0ac2\u0ab2!",close:"\u0aac\u0a82\u0aa7"}}},payment:{paymentOptions:{text:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0ab5\u0abf\u0a95\u0ab2\u0acd\u0aaa \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb"},makePayment:{welcomeText:"\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0,",documentPaymentInfo:"\u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0aaa\u0ab0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u0ab0\u0ac2 {{paymentAmount}} \u0ab2\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7.",paymentInfo:"\u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0aaa\u0ab0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u0ab0\u0ac2\u0aaa\u0abf\u0aaf\u0abe \u0aeb\u0ae6 \u0ab6\u0ac1\u0ab2\u0acd\u0a95 \u0ab2\u0ac7\u0ab5\u0abe\u0ab6\u0ac7",linkText:"\u0aa4\u0aae\u0ac7 \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0\u0a93 / \u0ab0\u0aa6 / \u0ab0\u0ac0\u0aab\u0a82\u0aa1 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0aaa\u0ab0 \u0ab5\u0aa7\u0ac1 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0aae\u0ac7\u0ab3\u0ab5\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb",acceptTerms:"\u0ab9\u0ac1\u0a82 \u0a86 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaa\u0ac1\u0ab7\u0acd\u0a9f\u0abf \u0a86\u0aaa\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0aae\u0ac7\u0a82 \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 / \u0ab0\u0aa6 / \u0ab0\u0ac0\u0aab\u0a82\u0aa1 \u0aaa\u0ac