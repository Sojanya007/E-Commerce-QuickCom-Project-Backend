\u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 \u0b2c\u0b4d\u0b5f\u0b3e\u0b19\u0b4d\u0b15 \u0b38\u0b39\u0b3f\u0b24 \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 |",note:"\u0b0f\u0b39\u0b3f \u0b32\u0b3f\u0b19\u0b4d\u0b15 \u0b1c\u0b30\u0b3f\u0b06\u0b30\u0b47 \u0b26\u0b3f\u0b06\u0b5f\u0b3e\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b38\u0b42\u0b1a\u0b28\u0b3e \u0b28\u0b4d\u0b5f\u0b3e\u0b38\u0b28\u0b3e\u0b32 \u0b2a\u0b47\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b15\u0b30\u0b4d\u0b2a\u0b4b\u0b30\u0b47\u0b38\u0b28 \u0b05\u0b2b \u0b07\u0b23\u0b4d\u0b21\u0b3f\u0b06 (\u0b0f\u0b28\u0b2a\u0b3f\u0b38\u0b3f\u0b06\u0b07)\u0b30 \u0b38\u0b30\u0b4d\u0b2d\u0b30\u0b30\u0b41 \u0b28\u0b3f\u0b06\u0b5f\u0b3e\u0b09\u0b1b\u0b3f\u0964 \u0b0f\u0b39\u0b3e\u0b30 \u0b38\u0b20\u0b3f\u0b15\u0b24\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b26\u0b3e\u0b5f\u0b40 \u0b28\u0b41\u0b39\u0b47\u0b01\u0964 \u0b2e\u0b3f\u0b33\u0b3f\u0b25\u0b3f\u0b2c\u0b3e \u0b24\u0b25\u0b4d\u0b5f\u0b15\u0b41 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b38\u0b02\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 ",ActiveText:"\u0b38\u0b15\u0b4d\u0b30\u0b3f\u0b5f |",InactiveText:"\u0b28\u0b3f\u0b37\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b5f |"},FAQ:{checkAadhaarPvcCardOrderStatus:[{question:"\u0b06\u0b27\u0b3e\u0b30\u0b30 \u0b2c\u0b3f\u0b2d\u0b3f\u0b28\u0b4d\u0b28 \u0b30\u0b42\u0b2a \u0b15'\u0b23 \u0b0f\u0b2c\u0b02 \u0b38\u0b47\u0b17\u0b41\u0b5c\u0b3f\u0b15\u0b30 \u0b2c\u0b48\u0b36\u0b3f\u0b37\u0b4d\u0b1f\u0b4d\u0b5f \u0b15'\u0b23?",answer:"\u0b06\u0b27\u0b3e\u0b30\u0b30 \u0b2c\u0b3f\u0b2d\u0b3f\u0b28\u0b4d\u0b28 \u0b30\u0b42\u0b2a \u0b39\u0b47\u0b09\u0b1b\u0b3f \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b24\u0b4d\u0b30, \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21, \u0b07\u0b06\u0b27\u0b3e\u0b30 \u0b0f\u0b2c\u0b02 \u0b0f\u0b2e\u0b06\u0b27\u0b3e\u0b30 \u0964 \u0b06\u0b27\u0b3e\u0b30\u0b30 \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b2a\u0b4d\u0b30\u0b15\u0b3e\u0b30 \u0b38\u0b2e\u0b3e\u0b28 \u0b2c\u0b48\u0b27 \u0b0f\u0b2c\u0b02 \u0b17\u0b4d\u0b30\u0b39\u0b23\u0b40\u0b5f \u0964"},{question:"\u0b2e\u0b41\u0b01 \u0b06\u0b27\u0b3e\u0b30\u0b30 \u0b2f\u0b47\u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b30\u0b42\u0b2a \u0b28\u0b47\u0b2c\u0b3e \u0b0f\u0b2c\u0b02 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b1a\u0b5f\u0b28 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b3f \u0b15\u0b3f?",answer:"\u0b39\u0b01"},{question:"'\u0b05\u0b30\u0b4d\u0b21\u0b30 \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21' \u0b38\u0b47\u0b2c\u0b3e \u0b15'\u0b23?",answer:"'\u0b05\u0b30\u0b4d\u0b21\u0b30 \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21' \u0b39\u0b47\u0b09\u0b1b\u0b3f \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b06\u0b30\u0b2e\u0b4d\u0b2d \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b0f\u0b15 \u0b05\u0b28\u0b32\u0b3e\u0b07\u0b28 \u0b38\u0b47\u0b2c\u0b3e \u0b2f\u0b3e\u0b39\u0b3e \u0b06\u0b27\u0b3e\u0b30 \u0b27\u0b3e\u0b30\u0b15\u0b19\u0b4d\u0b15\u0b41 \u0b28\u0b3e\u0b2e\u0b2e\u0b3e\u0b24\u0b4d\u0b30 \u0b36\u0b41\u0b33\u0b4d\u0b15 \u0b26\u0b47\u0b07 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21\u0b30\u0b47 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b30 \u0b06\u0b27\u0b3e\u0b30 \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40 \u0b2a\u0b4d\u0b30\u0b3f\u0b23\u0b4d\u0b1f \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b30 \u0b38\u0b41\u0b2c\u0b3f\u0b27\u0b3e \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b47 |"},{question:"\u0b15'\u0b23 \u0b30\u0b39\u0b3f\u0b1b\u0b3f \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21\u0b30 \u0b38\u0b3f\u0b15\u0b4d\u0b5f\u0b41\u0b30\u0b3f\u0b1f\u0b3f \u0b2b\u0b3f\u0b1a\u0b30\u0b4d\u0b38?",answer:"\u0b0f\u0b39\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21\u0b30\u0b47 \u0b28\u0b3f\u0b2e\u0b4d\u0b28\u0b32\u0b3f\u0b16\u0b3f\u0b24 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b2c\u0b48\u0b36\u0b3f\u0b37\u0b4d\u0b1f\u0b4d\u0b5f \u0b30\u0b39\u0b3f\u0b1b\u0b3f:\n1. \u0b1f\u0b4d\u0b5f\u0b3e\u0b2e\u0b4d\u0b2a\u0b30 \u0b2a\u0b4d\u0b30\u0b41\u0b2b\u0b4d \u0b15\u0b4d\u0b5f\u0b41\u0b06\u0b30\u0b4d \u0b15\u0b4b\u0b21\u0b4d\n2. \u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b32\u0b47\u0b16\n3. \u0b38\u0b42\u0b15\u0b4d\u0b37\u0b4d\u0b2e \u0b2a\u0b3e\u0b20\u0b4d\u0b5f\n4. \u0b2d\u0b42\u0b24 \u0b2a\u0b4d\u0b30\u0b24\u0b3f\u0b2e\u0b42\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3f\n5. \u0b24\u0b3e\u0b30\u0b3f\u0b16 \u0b0f\u0b2c\u0b02 \u0b2e\u0b41\u0b26\u0b4d\u0b30\u0b23 \u0b24\u0b3e\u0b30\u0b3f\u0b16 \u0b1c\u0b3e\u0b30\u0b3f \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\n6. \u0b17\u0b41\u0b07\u0b32\u0b4b\u0b1a\u0b47 \u0b22\u0b3e\u0b1e\u0b4d\u0b1a\u0b3e\n7. \u0b07\u0b2e\u0b4d\u0b2c\u0b4b\u0b38\u0b21\u0b4d \u0b06\u0b27\u0b3e\u0b30 \u0b32\u0b4b\u0b17\u0b4b"},{question:"\u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b2a\u0b3e\u0b07\u0b01 \u0b26\u0b47\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b21\u0b3f\u0b2c \u0b15\u0b47\u0b24\u0b47 \u0b1f\u0b19\u0b4d\u0b15\u0b3e?",answer:"50 \u0b1f\u0b19\u0b4d\u0b15\u0b3e \u0b36\u0b41\u0b33\u0b4d\u0b15 \u0b26\u0b47\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b21\u0b3f\u0b2c 50 \u0b1f\u0b19\u0b4d\u0b15\u0b3e (\u0b1c\u0b3f\u0b0f\u0b38\u0b1f\u0b3f \u0b0f\u0b2c\u0b02 \u0b38\u0b4d\u0b2a\u0b3f\u0b21 \u0b2a\u0b4b\u0b37\u0b4d\u0b1f \u0b36\u0b41\u0b33\u0b4d\u0b15\u0b15\u0b41 \u0b2e\u0b3f\u0b36\u0b3e\u0b07)\u0964"},{question:"\u0b1c\u0b23\u0b47 \u0b15\u0b3f\u0b2a\u0b30\u0b3f \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b2a\u0b3e\u0b07\u0b01 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b09\u0b20\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c?",answer:"\u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b2a\u0b3e\u0b07\u0b01 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07\u0b30 \u0b05\u0b2b\u0b3f\u0b38\u0b3f\u0b06\u0b32 \u0b2c\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f (https://www.uidai.gov.in \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e https://myaadhaar.uidai.gov.in) \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e mAadhaar \u0b06\u0b2a\u0b4d\u0b32\u0b3f\u0b15\u0b47\u0b38\u0b28\u0b30\u0b47 \u0b2f\u0b3e\u0b07 \u0b06\u0b2c\u0b47\u0b26\u0b28 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47"},{question:"\u0b2a\u0b1e\u0b4d\u0b1c\u0b3f\u0b15\u0b43\u0b24 \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b1c\u0b23\u0b3e\u0b07\u0b2c\u0b47 \u0b15\u0b3f?",answer:"1. \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b2a\u0b30\u0b3f\u0b26\u0b30\u0b4d\u0b36\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 https://uidai.gov.in \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e https://myaadhaar.uidai.gov.in/genricPVC\u0964\n2. \u0b28\u0b3f\u0b1c\u0b30 12 \u0b05\u0b19\u0b4d\u0b15 \u0b2c\u0b3f\u0b36\u0b3f\u0b37\u0b4d\u0b1f \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 (\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f) \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e 28 \u0b05\u0b19\u0b4d\u0b15 \u0b2c\u0b3f\u0b36\u0b3f\u0b37\u0b4d\u0b1f \u0b0f\u0b28\u0b30\u0b4b\u0b32\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b06\u0b07\u0b21\u0b3f \u0b26\u0b3f\u0b05\u0b28\u0b4d\u0b24\u0b41\u0964\n3. \u0b0f\u0b39\u0b3e\u0b2a\u0b30\u0b47 \u0b38\u0b3f\u0b15\u0b4d\u0b5f\u0b41\u0b30\u0b3f\u0b1f\u0b3f \u0b15\u0b4b\u0b21 \u0b26\u0b3f\u0b05\u0b28\u0b4d\u0b24\u0b41\n4. \u0b30\u0b47\u0b1c\u0b3f\u0b37\u0b4d\u0b1f\u0b30 \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b30\u0b47 \u0b06\u0b38\u0b3f\u0b25\u0b3f\u0b2c\u0b3e \u0b13\u0b1f\u0b3f\u0b2a\u0b3f\u0b15\u0b41 \u0b0f\u0b23\u0b4d\u0b1f\u0b30 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964\n5. \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24 \u0b0f\u0b2c\u0b02 \u0b38\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3e\u0b2c\u0b33\u0b40 \u0b2c\u0b3f\u0b30\u0b41\u0b26\u0b4d\u0b27\u0b30\u0b47 \u0b1a\u0b47\u0b15\u0b4d \u0b2c\u0b15\u0b4d\u0b38 \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964 (\u0b26\u0b4d\u0b30\u0b37\u0b4d\u0b1f\u0b2c\u0b4d\u0b5f): \u0b38\u0b2c\u0b3f\u0b36\u0b47\u0b37 \u0b24\u0b25\u0b4d\u0b5f \u0b26\u0b47\u0b16\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b39\u0b3e\u0b07\u0b2a\u0b30 \u0b32\u0b3f\u0b19\u0b4d\u0b15 \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41)\u0964\n6. \u0b13\u0b1f\u0b3f\u0b2a\u0b3f \u0b2d\u0b47\u0b30\u0b3f\u0b2b\u0b3f\u0b15\u0b47\u0b38\u0b28\u0b4d \u0b2a\u0b42\u0b30\u0b3e \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 Submit \u0b2c\u0b1f\u0b28\u0b4d \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964\n7. \u0b2a\u0b30\u0b2c\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b40 \u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b28\u0b30\u0b47, \u0b2a\u0b41\u0b28\u0b30\u0b4d\u0b2e\u0b41\u0b26\u0b4d\u0b30\u0b23 \u0b2a\u0b3e\u0b07\u0b01 \u0b05\u0b30\u0b4d\u0b21\u0b30 \u0b26\u0b47\u0b2c\u0b3e \u0b2a\u0b42\u0b30\u0b4d\u0b2c\u0b30\u0b41 \u0b06\u0b27\u0b3e\u0b30 \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40\u0b30 \u0b2a\u0b4d\u0b30\u0b3f\u0b2d\u0b3f\u0b09 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b19\u0b4d\u0b15 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b2a\u0b3e\u0b07\u0b01 \u0b2a\u0b4d\u0b30\u0b26\u0b30\u0b4d\u0b36\u0b3f\u0b24 \u0b39\u0b47\u0b2c\u0964\n8. \u0b38\u0b47\u0b20\u0b3e\u0b30\u0b47 '\u0b2e\u0b47\u0b15\u0b4d \u0b2a\u0b47\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b4d' \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b41 \u0b2a\u0b47\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b17\u0b47\u0b1f\u0b2c\u0b47 \u0b2a\u0b47\u0b1c\u0b15\u0b41 \u0b15\u0b4d\u0b30\u0b47\u0b21\u0b3f\u0b1f\u0b4d/\u0b21\u0b47\u0b2c\u0b3f\u0b1f \u0b15\u0b3e\u0b30\u0b4d\u0b21, \u0b28\u0b47\u0b1f\u0b4d \u0b2c\u0b4d\u0b5f\u0b3e\u0b19\u0b4d\u0b15\u0b3f\u0b19\u0b4d\u0b17\u0b4d \u0b0f\u0b2c\u0b02 \u0b5f\u0b41\u0b2a\u0b3f\u0b06\u0b07 \u0b2d\u0b33\u0b3f \u0b2a\u0b47\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b2c\u0b3f\u0b15\u0b33\u0b4d\u0b2a \u0b38\u0b39\u0b3f\u0b24 \u0b30\u0b3f-\u0b21\u0b3e\u0b07\u0b30\u0b47\u0b15\u0b4d\u0b1f \u0b15\u0b30\u0b3e\u0b5f\u0b3f\u0b2c\u0964\n9. \u0b38\u0b2b\u0b33 \u0b2a\u0b47\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b2a\u0b30\u0b47 \u0b21\u0b3f\u0b1c\u0b3f\u0b1f\u0b3e\u0b32 \u0b38\u0b3f\u0b17\u0b28\u0b47\u0b1a\u0b30 \u0b25\u0b3f\u0b2c\u0b3e \u0b30\u0b38\u0b3f\u0b26 \u0b1c\u0b47\u0b28\u0b47\u0b30\u0b47\u0b1f \u0b39\u0b47\u0b2c \u0b2f\u0b3e\u0b39\u0b3e\u0b15\u0b41 \u0b2a\u0b3f\u0b21\u0b3f\u0b0f\u0b2b \u0b2b\u0b30\u0b4d\u0b2e\u0b3e\u0b1f\u0b30\u0b47 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e \u0b21\u0b3e\u0b09\u0b28\u0b32\u0b4b\u0b21 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964 \u0b0f\u0b23\u0b3f\u0b15\u0b3f \u0b17\u0b4d\u0b30\u0b3e\u0b39\u0b15\u0b19\u0b4d\u0b15\u0b41 \u0b0f\u0b38\u0b4d\u0b0f\u0b2e\u0b4d\u0b0f\u0b38\u0b4d \u0b1c\u0b30\u0b3f\u0b06\u0b30\u0b47 \u0b38\u0b30\u0b4d\u0b2d\u0b3f\u0b38\u0b4d \u0b30\u0b3f\u0b15\u0b4d\u0b71\u0b47\u0b37\u0b4d\u0b1f\u0b4d \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2e\u0b27\u0b4d\u0b5f \u0b2e\u0b3f\u0b33\u0b3f\u0b2c\u0964\n10. \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b27\u0b3e\u0b30\u0b15 \u0b1a\u0b47\u0b15\u0b4d \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b3e\u0b30\u0b4d\u0b21\u0b30 \u0b38\u0b4d\u0b25\u0b3f\u0b24\u0b3f \u0b09\u0b2a\u0b30\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b2a\u0b20\u0b3e\u0b07\u0b2c\u0b3e \u0b2a\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b28\u0b4d\u0b24 \u0b0f\u0b38\u0b06\u0b30\u0b0f\u0b28\u0b30 \u0b38\u0b4d\u0b25\u0b3f\u0b24\u0b3f\u0b15\u0b41 \u0b1f\u0b4d\u0b30\u0b3e\u0b15 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964\n11. DoP\u0b30\u0b41 \u0b2a\u0b20\u0b3e\u0b07\u0b2c\u0b3e \u0b2a\u0b30\u0b47 AWB \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b25\u0b3f\u0b2c\u0b3e \u0b0f\u0b38\u0b4d\u0b0f\u0b2e\u0b4d\u0b0f\u0b38\u0b4d \u0b2e\u0b27\u0b4d\u0b5f \u0b2a\u0b20\u0b3e\u0b5f\u0b3f\u0b2c\u0964 \u0b06\u0b27\u0b3e\u0b30 \u0b27\u0b3e\u0b30\u0b15 DoP \u0b2c\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f\u0b15\u0b41 \u0b2f\u0b3e\u0b07 \u0b21\u0b47\u0b32\u0b3f\u0b2d\u0b30\u0b3f \u0b38\u0b4d\u0b25\u0b3f\u0b24\u0b3f\u0b15\u0b41 \u0b1f\u0b4d\u0b30\u0b3e\u0b15\u0b4d \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964"},{question:"\u0b05\u0b23-\u0b2a\u0b1e\u0b4d\u0b1c\u0b3f\u0b15\u0b43\u0b24 / \u0b2c\u0b3f\u0b15\u0b33\u0b4d\u0b2a \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b15\u0b3f\u0b2a\u0b30\u0b3f \u0b09\u0b20\u0b3e\u0b07\u0b2c\u0b47?",answer:"\u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f https://uidai.gov.in \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e https://myaadhaar.uidai.gov.in/genricPVC \u0b15\u0b41 \u0b2f\u0b3e\u0b06\u0b28\u0b4d\u0b24\u0b41 '\u0b05\u0b30\u0b4d\u0b21\u0b30 \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e mAadhaar \u0b06\u0b2c\u0b47\u0b26\u0b28 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 12 \u0b05\u0b19\u0b4d\u0b15 \u0b2c\u0b3f\u0b36\u0b3f\u0b37\u0b4d\u0b1f \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 (\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f) \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e 28 \u0b05\u0b19\u0b4d\u0b15 \u0b2c\u0b3f\u0b36\u0b3f\u0b37\u0b4d\u0b1f \u0b0f\u0b28\u0b30\u0b4b\u0b32\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b06\u0b07\u0b21\u0b3f \u0b26\u0b3f\u0b05\u0b28\u0b4d\u0b24\u0b41' \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b38\u0b3f\u0b15\u0b4d\u0b5f\u0b41\u0b30\u0b3f\u0b1f\u0b3f \u0b15\u0b4b\u0b21\u0b4d \u0b0f\u0b23\u0b4d\u0b1f\u0b30 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b1a\u0b47\u0b15\u0b4d \u0b2c\u0b15\u0b4d\u0b38 \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b2f\u0b26\u0b3f \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b2a\u0b3e\u0b16\u0b30\u0b47 \u0b30\u0b47\u0b1c\u0b3f\u0b37\u0b4d\u0b1f\u0b30\u0b4d\u0b21 \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b28\u0b3e\u0b39\u0b3f\u0b01, \u0b24\u0b47\u0b2c\u0b47 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b2c\u0b15\u0b4d\u0b38\u0b30\u0b47 \u0b1a\u0b47\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b05\u0b23-\u0b2a\u0b1e\u0b4d\u0b1c\u0b3f\u0b15\u0b43\u0b24 / \u0b2c\u0b3f\u0b15\u0b33\u0b4d\u0b2a \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2d\u0b30\u0b23 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b05\u0b23-\u0b2a\u0b1e\u0b4d\u0b1c\u0b3f\u0b15\u0b43\u0b24 \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f \u0b05\u0b30\u0b4d\u0b21\u0b30 \u0b26\u0b47\u0b09\u0b25\u0b3f\u0b2c\u0b3e \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b19\u0b4d\u0b15 \u0b2a\u0b3e\u0b07\u0b01 \u0b2a\u0b4d\u0b30\u0b3f\u0b2d\u0b3f\u0b09 \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 \u0b39\u0b47\u0b2c \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 \u0b05\u0b30\u0b4d\u0b21\u0b30 \u0b2a\u0b3e\u0b07\u0b01 \u0b2c\u0b3e\u0b15\u0b3f \u0b2a\u0b26\u0b15\u0b4d\u0b37\u0b47\u0b2a \u0b38\u0b2e\u0b3e\u0b28 \u0b30\u0b39\u0b3f\u0b1b\u0b3f\u0964"},{question:"\u0b15\u0b47\u0b09\u0b01 \u0b2e\u0b4b\u0b21\u0b30\u0b47 \u0b2e\u0b3f\u0b33\u0b3f\u0b2c \u0b2a\u0b47\u0b2e\u0b47\u0b23\u0b4d\u0b1f?",answer:"\u0b2c\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b2e\u0b3e\u0b28 \u0b28\u0b3f\u0b2e\u0b4d\u0b28\u0b4b\u0b15\u0b4d\u0b24 \u0b05\u0b28\u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b2a\u0b47\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b2c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b25\u0b3e\u0b30\u0b47 \u0b2a\u0b47\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b2c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b25\u0b3e \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 \u0b30\u0b39\u0b3f\u0b1b\u0b3f\n\u0b15\u0b4d\u0b30\u0b47\u0b21\u0b3f\u0b1f\u0b4d \u0b15\u0b3e\u0b30\u0b4d\u0b21\n\u0b21\u0b47\u0b2c\u0b3f\u0b1f\u0b4d \u0b15\u0b3e\u0b30\u0b4d\u0b21\n\u0b28\u0b47\u0b1f\u0b4d \u0b2c\u0b4d\u0b5f\u0b3e\u0b19\u0b4d\u0b15\u0b3f\u0b19\u0b4d\u0b17\u0b4d\n\u0b5f\u0b41\u0b2a\u0b3f\u0b06\u0b07\nPayTM"},{question:"SRN \u0b15'\u0b23?",answer:"SRN \u0b39\u0b47\u0b09\u0b1b\u0b3f 14 \u0b05\u0b19\u0b4d\u0b15 \u0b2c\u0b3f\u0b36\u0b3f\u0b37\u0b4d\u0b1f \u0b38\u0b30\u0b4d\u0b2d\u0b3f\u0b38 \u0b30\u0b3f\u0b15\u0b4d\u0b71\u0b47\u0b37\u0b4d\u0b1f \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2f\u0b3e\u0b39\u0b3e \u0b06\u0b27\u0b3e\u0b30 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b2a\u0b3e\u0b07\u0b01 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b30\u0b47 \u0b09\u0b24\u0b4d\u0b2a\u0b28\u0b4d\u0b28 \u0b39\u0b4b\u0b07\u0b25\u0b3e\u0b0f\u0964 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b2a\u0b24\u0b4d\u0b30 \u0b26\u0b47\u0b2c\u0b3e \u0b06\u0b30\u0b2e\u0b4d\u0b2d \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b30\u0b47 \u0b0f\u0b39\u0b3e \u0b1c\u0b28\u0b30\u0b47\u0b1f \u0b39\u0b4b\u0b07\u0b5f\u0b3f\u0b2c\u0964 \u0b1f\u0b4d\u0b30\u0b3e\u0b1e\u0b4d\u0b1c\u0b3e\u0b15\u0b4d\u0b38\u0b28\u0b4d \u0b36\u0b47\u0b37 \u0b39\u0b47\u0b2c\u0b3e \u0b2a\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b28\u0b4d\u0b24 '\u0b30\u0b3f\u0b1c\u0b4d\u0b5f\u0b41\u0b2e\u0b4d' \u0b2c\u0b3f\u0b15\u0b33\u0b4d\u0b2a \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 \u0b30\u0b39\u0b3f\u0b2c\u0964"},{question:"AWB \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b15'\u0b23?",answer:"\u0b0f\u0b5f\u0b3e\u0b30\u0b2c\u0b47 \u0b2c\u0b3f\u0b32\u0b4d \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b39\u0b47\u0b09\u0b1b\u0b3f \u0b1f\u0b4d\u0b30\u0b3e\u0b15\u0b3f\u0b02 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2f\u0b3e\u0b39\u0b3e DoP \u0b05\u0b30\u0b4d\u0b25\u0b3e\u0b24 \u0b07\u0b23\u0b4d\u0b21\u0b3f\u0b06 \u0b38\u0b4d\u0b2a\u0b3f\u0b21 \u0b2a\u0b4b\u0b37\u0b4d\u0b1f \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b2a\u0b4d\u0b30\u0b38\u0b4d\u0b24\u0b41\u0b24 \u0b39\u0b4b\u0b07\u0b25\u0b3e\u0b0f\u0964"},{question:"\u0b2f\u0b26\u0b3f \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b2e\u0b3e\u0b28\u0b47 \u0b1a\u0b3e\u0b39\u0b3f\u0b01\u0b2c\u0b47 \u0b2f\u0b47 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b47 \u0b1a\u0b3e\u0b39\u0b41\u0b01\u0b25\u0b3f\u0b2c\u0b3e \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40 \u0b38\u0b39\u0b3f\u0b24 \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b2a\u0b4d\u0b30\u0b3f\u0b23\u0b4d\u0b1f \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b1a\u0b3e\u0b39\u0b41\u0b01\u0b1b\u0b28\u0b4d\u0b24\u0b3f?",answer:"\u0b2f\u0b26\u0b3f \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b2e\u0b3e\u0b28\u0b47 \u0b2e\u0b41\u0b26\u0b4d\u0b30\u0b3f\u0b24 \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b24\u0b4d\u0b30 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21\u0b30 \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40\u0b30\u0b47 \u0b15\u0b3f\u0b1b\u0b3f \u0b2a\u0b30\u0b3f\u0b2c\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b28 \u0b1a\u0b3e\u0b39\u0b41\u0b01\u0b1b\u0b28\u0b4d\u0b24\u0b3f, \u0b0f\u0b39\u0b3e\u0b2a\u0b30\u0b47 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b41 \u0b2a\u0b4d\u0b30\u0b25\u0b2e\u0b47 \u0b2a\u0b30\u0b2e\u0b3e\u0b28\u0b47\u0b23\u0b4d\u0b1f \u0b0f\u0b28\u0b30\u0b4b\u0b32\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b38\u0b47\u0b23\u0b4d\u0b1f\u0b30 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b0f\u0b38\u0b0f\u0b38\u0b5f\u0b41\u0b2a\u0b3f \u0b2a\u0b4b\u0b30\u0b4d\u0b1f\u0b3e\u0b32\u0b15\u0b41 \u0b2f\u0b3e\u0b07 (\u0b05\u0b2a\u0b21\u0b47\u0b1f \u0b09\u0b2a\u0b30\u0b47 \u0b28\u0b3f\u0b30\u0b4d\u0b2d\u0b30 \u0b15\u0b30\u0b3f) \u0b28\u0b3f\u0b1c\u0b30 \u0b06\u0b27\u0b3e\u0b30\u0b15\u0b41 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b21\u0b3f\u0b2c \u0b0f\u0b2c\u0b02 \u0b2a\u0b30\u0b47 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27\u0b15\u0b41 \u0b09\u0b20\u0b3e\u0b07\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b2a\u0b21\u0b3f\u0b2c \u0b15\u0b3e\u0b30\u0b23 \u0b0f\u0b39\u0b3f \u0b38\u0b41\u0b2c\u0b3f\u0b27\u0b3e \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21/\u0b32\u0b47\u0b1f\u0b30\u0b30 \u0b39\u0b3e\u0b30\u0b4d\u0b21 \u0b15\u0b2a\u0b3f \u0b2a\u0b3e\u0b07\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c"},{question:"\u0b38\u0b2b\u0b33 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b30\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b2a\u0b3e\u0b07\u0b2c\u0b3e\u0b15\u0b41 \u0b15\u0b47\u0b24\u0b47 \u0b26\u0b3f\u0b28 \u0b32\u0b3e\u0b17\u0b3f\u0b2c?",answer:"\u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b27\u0b3e\u0b30\u0b40\u0b19\u0b4d\u0b15 \u0b20\u0b3e\u0b30\u0b41 \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b2a\u0b3e\u0b07\u0b01 \u0b05\u0b30\u0b4d\u0b21\u0b30 \u0b2a\u0b3e\u0b07\u0b2c\u0b3e \u0b2a\u0b30\u0b47, \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 5 \u0b15\u0b3e\u0b30\u0b4d\u0b5f\u0b4d\u0b5f \u0b26\u0b3f\u0b2c\u0b38 \u0b2e\u0b27\u0b4d\u0b5f\u0b30\u0b47 (\u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27\u0b30 \u0b24\u0b3e\u0b30\u0b3f\u0b16\u0b15\u0b41 \u0b1b\u0b3e\u0b5c\u0b3f) \u0b2e\u0b41\u0b26\u0b4d\u0b30\u0b3f\u0b24 \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b3e\u0b30\u0b4d\u0b21\u0b15\u0b41 DoP\u0b15\u0b41 \u0b39\u0b38\u0b4d\u0b24\u0b3e\u0b28\u0b4d\u0b24\u0b30 \u0b15\u0b30\u0b3f\u0b25\u0b3e\u0b0f\u0964 \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b2d\u0b3e\u0b30\u0b24\u0b40\u0b5f \u0b21\u0b3e\u0b15 \u0b2c\u0b3f\u0b2d\u0b3e\u0b17\u0b30 SPEED POST \u0b38\u0b30\u0b4d\u0b2d\u0b3f\u0b38 \u0b1c\u0b30\u0b3f\u0b06\u0b30\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b21\u0b3e\u0b1f\u0b3e\u0b2c\u0b47\u0b38\u0b30\u0b47 \u0b2a\u0b1e\u0b4d\u0b1c\u0b3f\u0b15\u0b43\u0b24 \u0b20\u0b3f\u0b15\u0b23\u0b3e\u0b15\u0b41 \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07\u0b25\u0b3e\u0b0f\u0964 \u0b1c\u0b23\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b27\u0b3e\u0b30\u0b15 https://www.indiapost.gov.in/_layouts/15/dop.portal.track.\u0b30\u0b47 DoP \u0b1f\u0b4d\u0b30\u0b3e\u0b15\u0b3f\u0b02 \u0b38\u0b30\u0b4d\u0b2d\u0b3f\u0b38 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f \u0b21\u0b47\u0b32\u0b3f\u0b2d\u0b30\u0b3f \u0b38\u0b4d\u0b25\u0b3f\u0b24\u0b3f \u0b1f\u0b4d\u0b30\u0b3e\u0b15 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47"}],verifyEmailMobile:[{question:"\u0b1c\u0b28\u0b38\u0b19\u0b4d\u0b16\u0b4d\u0b5f\u0b3e \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40\u0b30 \u0b05\u0b28\u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b2a\u0b3e\u0b07\u0b01 \u0b15'\u0b23 \u0b15\u0b3f\u0b1b\u0b3f \u0b36\u0b41\u0b33\u0b4d\u0b15 \u0b1c\u0b5c\u0b3f\u0b24 \u0b05\u0b1b\u0b3f \u0b15\u0b3f?",answer:"\u0b39\u0b01, \u0b21\u0b47\u0b2e\u0b4b\u0b17\u0b4d\u0b30\u0b3e\u0b2b\u0b3f\u0b15 \u0b38\u0b42\u0b1a\u0b28\u0b3e\u0b30 \u0b05\u0b28\u0b4d\u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b05\u0b2a\u0b4d\u0b21\u0b47\u0b1f\u0b4d \u0b2a\u0b3e\u0b07\u0b01 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b41 \u0b26\u0b47\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b5c\u0b3f\u0b2c \u0b26\u0b47\u0b5d \u0b32\u0b15\u0b4d\u0b37 \u0b1f\u0b19\u0b4d\u0b15\u0b3e\u0964 50\u0b1f\u0b19\u0b4d\u0b15\u0b3e (\u0b1c\u0b3f\u0b0f\u0b38\u0b4d\u0b1f\u0b3f \u0b38\u0b2e\u0b47\u0b24) \u0b26\u0b47\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b5c\u0b3f\u0b2c\u0964"}],orderAadhaarPvcCard:[{question:"\u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b27\u0b3e\u0b30\u0b40 \u0b15\u0b47\u0b09\u0b01\u0b20\u0b3e\u0b30\u0b41 \u0b07-\u0b06\u0b27\u0b3e\u0b30 \u0b21\u0b3e\u0b09\u0b28\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47?",answer:"\u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b27\u0b3e\u0b30\u0b40 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07\u0b30 MyAadhaar \u0b2a\u0b4b\u0b30\u0b4d\u0b1f\u0b3e- https://myaadhaar.uidai.gov.in\u0b15\u0b41 \u0b2f\u0b3e\u0b07 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32\u0b4d \u0b2b\u0b4b\u0b28\u0b4d \u0b2a\u0b3e\u0b07\u0b01 mAadhaar \u0b06\u0b2a\u0b4d \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f \u0b07-\u0b06\u0b27\u0b3e\u0b30 \u0b21\u0b3e\u0b09\u0b28\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964"}],retrieveEidAadhaarNumber:[{question:"\u0b06\u0b27\u0b3e\u0b30 \u0b24\u0b25\u0b4d\u0b5f\u0b15\u0b41 \u0b15\u0b47\u0b24\u0b47 \u0b25\u0b30 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c?",answer:"\u0b06\u0b27\u0b3e\u0b30 \u0b24\u0b25\u0b4d\u0b5f \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b2a\u0b3e\u0b07\u0b01 \u0b28\u0b3f\u0b2e\u0b4d\u0b28\u0b32\u0b3f\u0b16\u0b3f\u0b24 \u0b38\u0b40\u0b2e\u0b3e \u0b32\u0b3e\u0b17\u0b41 \u0b39\u0b4b\u0b07\u0b25\u0b3e\u0b0f:\n\u2022 \u0b28\u0b3e\u0b2e: \u0b1c\u0b40\u0b2c\u0b28 \u0b15\u0b3e\u0b33\u0b30\u0b47 \u0b26\u0b41\u0b07\u0b25\u0b30\n\u2022 \u0b32\u0b3f\u0b19\u0b4d\u0b17: \u0b32\u0b3e\u0b07\u0b2b\u0b4d \u0b1f\u0b3e\u0b07\u0b2e\u0b4d \u0b30\u0b47 \u0b25\u0b30\u0b47\n\u2022 \u0b1c\u0b28\u0b4d\u0b2e \u0b24\u0b3e\u0b30\u0b3f\u0b16: \u0b1c\u0b40\u0b2c\u0b28\u0b30\u0b47 \u0b25\u0b30\u0b47"},{question:"\u0b06\u0b27\u0b3e\u0b30\u0b30\u0b47 \u0b2e\u0b4b \u0b28\u0b3e\u0b2e\u0b30\u0b47 \u0b15'\u0b23 \u0b2a\u0b30\u0b3f\u0b2c\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b28 \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c?",answer:"\u0b28\u0b3f\u0b1c \u0b28\u0b3e\u0b01\u0b30\u0b47 \u0b38\u0b3e\u0b2e\u0b3e\u0b28\u0b4d\u0b5f \u0b38\u0b02\u0b36\u0b4b\u0b27\u0b28 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b28\u0b3e\u0b01 \u0b2a\u0b30\u0b3f\u0b2c\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b28 \u0b2a\u0b3e\u0b07\u0b01 \u0b28\u0b3f\u0b15\u0b1f\u0b38\u0b4d\u0b25 \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b15\u0b41 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b2f\u0b3e\u0b06\u0b28\u0b4d\u0b24\u0b41\u0964"},{question:"\u0b05\u0b28\u0b4d\u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b2a\u0b3e\u0b07\u0b01 \u0b15\u0b47\u0b09\u0b01 \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15?",answer:"\u0b38\u0b39\u0b3e\u0b5f\u0b15 \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c \u0b24\u0b3e\u0b32\u0b3f\u0b15\u0b3e \u0b05\u0b28\u0b41\u0b5f\u0b3e\u0b5f\u0b40 \u0b2a\u0b3f\u0b13\u0b0f \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15 \u0b39\u0b47\u0b2c\u0964 https://uidai.gov.in \u0b15\u0b41 \u0b2f\u0b3e\u0b06\u0b28\u0b4d\u0b24\u0b41\u0964"},{question:"\u0b06\u0b27\u0b3e\u0b30 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b15\u0b47\u0b09\u0b01 \u0b15\u0b47\u0b09\u0b01 \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f\u0b30 \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15\u0b24\u0b3e \u0b30\u0b39\u0b3f\u0b1b\u0b3f?",answer:"\u0b38\u0b39\u0b3e\u0b5f\u0b15 \u0b26\u0b32\u0b3f\u0b32\u0b17\u0b41\u0b5c\u0b3f\u0b15\u0b30 \u0b24\u0b3e\u0b32\u0b3f\u0b15\u0b3e \u0b2f\u0b3e\u0b39\u0b3e\u0b15\u0b41 \u0b06\u0b2a\u0b23 \u0b1a\u0b5f\u0b28 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47, \u0b0f\u0b20\u0b3e\u0b30\u0b47 \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 \u0b05\u0b1b\u0b3f\u0964 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b24\u0b3e\u0b32\u0b3f\u0b15\u0b3e\u0b30\u0b41 \u0b09\u0b2a\u0b5f\u0b41\u0b15\u0b4d\u0b24 \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c\u0b15\u0b41 \u0b1a\u0b5f\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b1c\u0b28\u0b38\u0b19\u0b4d\u0b16\u0b4d\u0b5f\u0b3e \u0b24\u0b25\u0b4d\u0b5f \u0b38\u0b02\u0b36\u0b4b\u0b27\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b0f\u0b39\u0b3e\u0b30 \u0b0f\u0b15 \u0b38\u0b4d\u0b15\u0b3e\u0b28/\u0b1a\u0b3f\u0b24\u0b4d\u0b30 \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964"},{question:"\u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b05\u0b26\u0b4d\u0b5f\u0b24\u0b28 \u0b05\u0b28\u0b32\u0b3e\u0b07\u0b28 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b4d\u0b37\u0b47\u0b24\u0b4d\u0b30\u0b30\u0b47 \u0b2e\u0b41\u0b01 \u0b15\u0b3f\u0b2a\u0b30\u0b3f \u0b2e\u0b4b\u0b30 \u0b38\u0b39\u0b3e\u0b5f\u0b15 \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b3f?",answer:"\u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b05\u0b28\u0b4d \u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b38\u0b47\u0b2c\u0b3e\u0b30\u0b47 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b41 \u0b2a\u0b3f\u0b21\u0b3f\u0b0f\u0b2b\u0b4d \u0b15\u0b3f\u0b2e\u0b4d\u0b71\u0b3e jpeg \u0b2b\u0b30\u0b4d\u0b2e\u0b3e\u0b1f\u0b30\u0b47 \u0b38\u0b2e\u0b30\u0b4d\u0b25\u0b15 \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c\u0b30 \u0b38\u0b4d\u0b15\u0b3e\u0b28\u0b4d /\u0b2b\u0b1f\u0b4b \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b15\u0b30\u0b3e\u0b2f\u0b3f\u0b2c\u0964 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b2a\u0b4d\u0b30\u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e\u0b15\u0b30\u0b23 \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b20\u0b3f\u0b15\u0b4d \u0b38\u0b2e\u0b30\u0b4d\u0b25\u0b15 \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b2a\u0b3e\u0b38\u0b2a\u0b4b\u0b30\u0b4d\u0b1f, \u0b2d\u0b21\u0b3c\u0b3e \u0b0f\u0b2c\u0b02 \u0b38\u0b2e\u0b4d\u0b2a\u0b24\u0b4d\u0b24\u0b3f \u0b1a\u0b41\u0b15\u0b4d\u0b24\u0b3f \u0b2d\u0b33\u0b3f \u0b15\u0b3f\u0b1b\u0b3f \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c \u0b2a\u0b3e\u0b07\u0b01 \u0b0f\u0b15\u0b3e\u0b27\u0b3f\u0b15 \u0b2a\u0b43\u0b37\u0b4d\u0b20\u0b3e\u0b30 \u0b2b\u0b1f\u0b4b \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15 \u0b39\u0b47\u0b2c\u0964"},{question:"\u0b2e\u0b41\u0b01 \u0b2e\u0b4b\u0b30 \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b40\u0b5f \u0b2d\u0b3e\u0b37\u0b3e\u0b15\u0b41 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b06\u0b27\u0b3e\u0b30 \u0b05\u0b28\u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b38\u0b47\u0b2c\u0b3e \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b3f \u0b15\u0b3f?",answer:"\u0b2c\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b2e\u0b3e\u0b28 \u0b06\u0b2a\u0b23 \u0b05\u0b28\u0b32\u0b3e\u0b07\u0b28 \u0b2a\u0b4b\u0b30\u0b4d\u0b1f\u0b3e\u0b32 \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b40\u0b5f \u0b2d\u0b3e\u0b37\u0b3e \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964"},{question:"\u0b06\u0b27\u0b3e\u0b30 \u0b05\u0b28\u0b4d \u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b38\u0b47\u0b2c\u0b3e \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b2e\u0b41\u0b01 \u0b2e\u0b4b\u0b30 \u0b1c\u0b28\u0b4d\u0b2e \u0b24\u0b3e\u0b30\u0b3f\u0b16 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b3f \u0b15\u0b3f?",answer:"\u0b28\u0b3e, \u0b1c\u0b28\u0b4d\u0b2e \u0b24\u0b3e\u0b30\u0b3f\u0b16 (\u0b21\u0b3f\u0b13\u0b2c\u0b3f) \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b21\u0b3f\u0b13\u0b2c\u0b3f \u0b2a\u0b4d\u0b30\u0b2e\u0b3e\u0b23 \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c \u0b38\u0b39\u0b3f\u0b24 \u0b28\u0b3f\u0b15\u0b1f\u0b38\u0b4d\u0b25 \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b15\u0b41 \u0b2f\u0b3e\u0b06\u0b28\u0b4d\u0b24\u0b41\u0964"},{question:"\u0b2e\u0b41\u0b01 \u0b2a\u0b42\u0b30\u0b4d\u0b2c\u0b30\u0b41 \u0b25\u0b30\u0b47 \u0b2e\u0b4b \u0b30 \u0b06\u0b27\u0b3e\u0b30\u0b30\u0b47 \u0b1c\u0b28\u0b4d\u0b2e \u0b24\u0b3e\u0b30\u0b3f\u0b16 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3f\u0b38\u0b3e\u0b30\u0b3f\u0b1b\u0b3f \u0964 \u0b2e\u0b41\u0b01 \u0b0f\u0b39\u0b3e\u0b15\u0b41 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d / \u0b38\u0b02\u0b36\u0b4b\u0b27\u0b28 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b3f \u0b15\u0b3f?"},{question:"\u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b26\u0b3e\u0b16\u0b32 \u0b1c\u0b28\u0b38\u0b19\u0b4d\u0b16\u0b4d\u0b5f\u0b3e \u0b38\u0b42\u0b1a\u0b28\u0b3e\u0b30 \u0b17\u0b4d\u0b5f\u0b3e\u0b30\u0b47\u0b23\u0b4d\u0b1f\u0b3f \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b47 \u0b15\u0b3f?",answer:"\u0b38\u0b42\u0b1a\u0b28\u0b3e \u0b26\u0b3e\u0b16\u0b32 \u0b06\u0b27\u0b3e\u0b30 \u0b21\u0b3e\u0b1f\u0b3e \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b39\u0b47\u0b2c\u0b3e\u0b30 \u0b17\u0b4d\u0b5f\u0b3e\u0b30\u0b47\u0b23\u0b4d\u0b1f\u0b3f \u0b26\u0b3f\u0b0f \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b06\u0b27\u0b3e\u0b30 \u0b05\u0b28\u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b38\u0b47\u0b2c\u0b3e \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b26\u0b3e\u0b16\u0b32 \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b2a\u0b30\u0b3f\u0b2c\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b28\u0b17\u0b41\u0b21\u0b3f\u0b15 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b0f\u0b2c\u0b02 \u0b2c\u0b48\u0b27\u0b24\u0b3e \u0b05\u0b27\u0b40\u0b28\u0b30\u0b47 \u0b05\u0b1f\u0b47 \u0b0f\u0b2c\u0b02 \u0b2c\u0b48\u0b27\u0b24\u0b3e \u0b2a\u0b30\u0b47 \u0b15\u0b47\u0b2c\u0b33 \u0b06\u0b27\u0b3e\u0b30 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b2a\u0b3e\u0b07\u0b01 \u0b2a\u0b30\u0b3f\u0b2c\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b28 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b2a\u0b4d\u0b30\u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b0f \u0964"},{question:"\u0b2e\u0b41\u0b01 \u0b2e\u0b4b \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32\u0b4d \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b39\u0b30\u0b3e\u0b07\u0b1b\u0b3f / \u0b2e\u0b41\u0b01 \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b39\u0b3f\u0b24 \u0b28\u0b3e\u0b2e \u0b32\u0b47\u0b16\u0b3e\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b30\u0b16 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 \u0b2e\u0b41\u0b01 \u0b15\u0b3f\u0b2a\u0b30\u0b3f \u0b2e\u0b4b\u0b30 \u0b05\u0b26\u0b4d\u0b5f\u0b24\u0b28 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3f\u0b2c\u0b3f?",answer:"\u0b2f\u0b26\u0b3f \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b2a\u0b3e\u0b16\u0b30\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b39 \u0b2a\u0b1e\u0b4d\u0b1c\u0b40\u0b15\u0b43\u0b24 \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32  \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b39\u0b1c\u0b3f\u0b2f\u0b3e\u0b07\u0b1b\u0b3f/\u0b28\u0b3e\u0b39\u0b3f\u0b01, \u0b24\u0b47\u0b2c\u0b47 \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32\u0b4d \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b41 \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b17\u0b24 \u0b2d\u0b3e\u0b2c\u0b47 \u0b28\u0b3f\u0b15\u0b1f\u0b38\u0b4d\u0b25 \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b15\u0b41 \u0b2f\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b21\u0b3c\u0b3f\u0b2c\u0964"},{question:"\u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b39\u0b47\u0b2c\u0b3e \u0b2a\u0b30\u0b47 \u0b2c\u0b26\u0b33\u0b3f\u0b5f\u0b3f\u0b2c \u0b15\u0b3f \u0b2e\u0b4b \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30?",answer:"\u0b28\u0b3e, \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b2a\u0b30\u0b47 \u0b2e\u0b27\u0b4d\u0b5f \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b38\u0b2e\u0b3e\u0b28 \u0b30\u0b39\u0b3f\u0b2c\u0964"},{question:"\u0b2e\u0b41\u0b01 \u0b05\u0b26\u0b4d\u0b5f\u0b24\u0b28 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27\u0b15\u0b41 \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b1a\u0b3e\u0b39\u0b41\u0b01\u0b1b\u0b3f\u0964 \u0b15'\u0b23 \u0b2e\u0b41\u0b01 \u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b3f?",answer:"\u0b05\u0b27\u0b3f\u0b15 \u0b2a\u0b4d\u0b30\u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e\u0b15\u0b30\u0b23 \u0b2a\u0b3e\u0b07\u0b01 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b28 \u0b09\u0b20\u0b3e\u0b07\u0b2c\u0b3e \u0b2a\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b28\u0b4d\u0b24 \u0b1c\u0b23\u0b47 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e \u0b2e\u0b4b\u0b06\u0b27\u0b3e\u0b30 \u0b21\u0b4d\u0b5f\u0b3e\u0b38\u0b2c\u0b4b\u0b30\u0b4d\u0b21\u0b30\u0b47 \u0b25\u0b3f\u0b2c\u0b3e '\u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27' \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b30\u0b41 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27\u0b15\u0b41 \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964 \u0b2f\u0b26\u0b3f \u0b0f\u0b39\u0b3e \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b39\u0b41\u0b0f \u0b24\u0b47\u0b2c\u0b47 \u0b68\u0b67 \u0b26\u0b3f\u0b28 \u0b2e\u0b27\u0b4d\u0b5f\u0b30\u0b47 \u0b06\u0b15\u0b3e\u0b09\u0b23\u0b4d\u0b1f\u0b15\u0b41 \u0b1f\u0b19\u0b4d\u0b15\u0b3e \u0b2b\u0b47\u0b30\u0b38\u0b4d\u0b24 \u0b39\u0b4b\u0b07\u0b2f\u0b3f\u0b2c \u0964"},{question:"\u0b2e\u0b41\u0b01 \u0b2e\u0b4b\u0b30 \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b15\u0b47\u0b09\u0b01\u0b20\u0b3e\u0b30\u0b47 \u0b26\u0b47\u0b16\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b3f? ",answer:"\u0b1c\u0b23\u0b47 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e \u0b2e\u0b4b\u0b06\u0b27\u0b3e\u0b30 \u0b21\u0b4d\u0b5f\u0b3e\u0b38\u0b2c\u0b4b\u0b30\u0b4d\u0b21 \u0b2d\u0b3f\u0b24\u0b30\u0b47 \u0b25\u0b3f\u0b2c\u0b3e '\u0b30\u0b3f\u0b15\u0b4d\u0b71\u0b47\u0b37\u0b4d\u0b1f' \u0b38\u0b4d\u0b2a\u0b47\u0b38\u0b4d \u0b2d\u0b3f\u0b24\u0b30\u0b47 \u0b28\u0b3f\u0b1c\u0b30 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b26\u0b47\u0b16\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964"},{question:"\u0b2e\u0b41\u0b01 \u0b2e\u0b4b \u0b20\u0b3f\u0b15\u0b23\u0b3e\u0b30\u0b47 \u0b2e\u0b4b \u0b2c\u0b3e\u0b2a\u0b3e/ \u0b38\u0b4d\u0b71\u0b3e\u0b2e\u0b40\u0b19\u0b4d\u0b15 \u0b28\u0b3e\u0b2e \u0b15\u0b3f\u0b2a\u0b30\u0b3f \u0b2f\u0b4b\u0b21\u0b3f\u0b2c\u0b3f?",answer:"\u0b38\u0b2e\u0b4d\u0b2a\u0b30\u0b4d\u0b15 \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40 \u0b06\u0b27\u0b3e\u0b30\u0b30\u0b47 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b15\u0b4d\u0b37\u0b47\u0b24\u0b4d\u0b30\u0b30 \u0b0f\u0b15 \u0b05\u0b02\u0b36 \u0b05\u0b1f\u0b47 \u0964 \u0b0f\u0b39\u0b3e\u0b15\u0b41 \u0b38\u0b3f/\u0b13 (\u0b15\u0b47\u0b5f\u0b3e\u0b30 \u0b05\u0b2b\u0b4d) \u0b30\u0b47 \u0b2e\u0b3e\u0b28\u0b4d\u0b5f\u0b24\u0b3e \u0b26\u0b3f\u0b06\u0b2f\u0b3e\u0b07\u0b1b\u0b3f\u0964 \u0b0f\u0b39\u0b3e\u0b15\u0b41 \u0b2a\u0b42\u0b30\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2c\u0b3f\u0b15\u0b33\u0b4d\u0b2a \u0b05\u0b1f\u0b47 \u0964"}],eaadhaarDownload:[{question:"\u0b07-\u0b06\u0b27\u0b3e\u0b30 \u0b15'\u0b23?",answer:"\u0b07-\u0b06\u0b27\u0b3e\u0b30 \u0b39\u0b47\u0b09\u0b1b\u0b3f \u0b06\u0b27\u0b3e\u0b30\u0b30 \u0b0f\u0b15 \u0b2a\u0b3e\u0b38\u0b71\u0b3e\u0b30\u0b4d\u0b21 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b07\u0b32\u0b47\u0b15\u0b4d\u0b1f\u0b4d\u0b30\u0b4b\u0b28\u0b3f\u0b15\u0b4d \u0b15\u0b2a\u0b3f, \u0b2f\u0b3e\u0b39\u0b3e \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b21\u0b3f\u0b1c\u0b3f\u0b1f\u0b3e\u0b32 \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b38\u0b4d\u0b71\u0b3e\u0b15\u0b4d\u0b37\u0b30\u0b3f\u0b24"},{question:"\u0b06\u0b27\u0b3e\u0b30\u0b30 \u0b2b\u0b3f\u0b1c\u0b3f\u0b15\u0b3e\u0b32 \u0b15\u0b2a\u0b3f \u0b2d\u0b33\u0b3f \u0b07-\u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b2e\u0b3e\u0b28 \u0b2c\u0b48\u0b27 \u0b15\u0b3f?",answer:"\u0b06\u0b27\u0b3e\u0b30 \u0b06\u0b07\u0b28 \u0b05\u0b28\u0b41\u0b38\u0b3e\u0b30\u0b47 \u0b07-\u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b2c\u0b41 \u0b15\u0b3e\u0b2e \u0b2a\u0b3e\u0b07\u0b01 \u0b06\u0b27\u0b3e\u0b30\u0b30 \u0b2b\u0b3f\u0b1c\u0b3f\u0b15\u0b3e\u0b32 \u0b15\u0b2a\u0b3f \u0b2d\u0b33\u0b3f \u0b38\u0b2e\u0b3e\u0b28 \u0b2d\u0b3e\u0b2c\u0b47 \u0b2c\u0b48\u0b27\u0964 \u0b07-\u0b06\u0b27\u0b3e\u0b30\u0b30 \u0b2c\u0b48\u0b27\u0b24\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f UIDAI \u0b38\u0b30\u0b4d\u0b15\u0b41\u0b32\u0b3e\u0b30- https://uidai.gov.in/images/ uidai_om_on_e_aadhaar_validity.pdf \u0b15\u0b41 \u0b2f\u0b3e\u0b06\u0b28\u0b4d\u0b24\u0b41"},{question:"\u0b2e\u0b3e\u0b38\u0b4d\u0b15 \u0b2f\u0b41\u0b15\u0b4d\u0b24 \u0b06\u0b27\u0b3e\u0b30 \u0b15'\u0b23?",answer:"\u0b2e\u0b41\u0b16\u0b3e\u0b2a\u0b3f\u0b28\u0b4d\u0b27\u0b3e \u0b06\u0b27\u0b3e\u0b30 \u0b30 \u0b05\u0b30\u0b4d\u0b25 \u0b39\u0b47\u0b09\u0b1b\u0b3f \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b30 \u0b2a\u0b4d\u0b30\u0b25\u0b2e \u0b6e \u0b05\u0b19\u0b4d\u0b15\u0b15\u0b41 'xxxx-xxxx' \u0b38\u0b39\u0b3f\u0b24 \u0b2c\u0b26\u0b33\u0b3e\u0b07\u0b2c\u0b3e \u0b0f\u0b2c\u0b02 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b30 \u0b15\u0b47\u0b2c\u0b33 \u0b36\u0b47\u0b37 \u0b6a \u0b05\u0b19\u0b4d\u0b15 \u0b26\u0b43\u0b36\u0b4d\u0b5f\u0b2e\u0b3e\u0b28 \u0b39\u0b47\u0b09\u0b1b\u0b3f \u0964"},{question:"\u0b07-\u0b06\u0b27\u0b3e\u0b30\u0b30\u0b47 \u0b21\u0b3f\u0b1c\u0b3f\u0b1f\u0b3e\u0b32 \u0b38\u0b3f\u0b17\u0b4d\u0b28\u0b47\u0b1a\u0b30\u0b15\u0b41 \u0b15\u0b47\u0b2e\u0b3f\u0b24\u0b3f \u0b15\u0b30\u0b3f\u0b2c\u0b47 \u0b2c\u0b48\u0b27\u0b24\u0b3e?",answer:"\u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b06\u0b27\u0b3e\u0b30 \u0b5f\u0b41\u0b1f\u0b4d\u0b5f\u0b41\u0b2c \u0b1a\u0b4d\u0b5f\u0b3e\u0b28\u0b47\u0b32\u0b15\u0b41 \u0b2f\u0b3e\u0b06\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 https://youtu.be/aVNfUNIccZs?si=ByW1O6BIPMwc0seL \u0b30\u0b47 \u0b1f\u0b4d\u0b5f\u0b41\u0b1f\u0b4b\u0b30\u0b3f\u0b06\u0b32\u0b4d \u0b32\u0b3f\u0b19\u0b4d\u0b15\u0b4d \u0b26\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41"},{question:"\u0b07-\u0b06\u0b27\u0b3e\u0b30\u0b30 \u0b2a\u0b3e\u0b38\u0b71\u0b3e\u0b30\u0b4d\u0b21 \u0b15'\u0b23?",answer:"\u0b07\u0b06\u0b27\u0b3e\u0b30\u0b30 \u0b2a\u0b3e\u0b38\u0b71\u0b3e\u0b30\u0b4d\u0b21 \u0b39\u0b47\u0b09\u0b1b\u0b3f \u0b15\u0b4d\u0b5f\u0b3e\u0b2a\u0b3f\u0b1f\u0b3e\u0b32\u0b30\u0b47 \u0b2a\u0b4d\u0b30\u0b25\u0b2e \u0b6a\u0b1f\u0b3f \u0b28\u0b3e\u0b2e \u0b05\u0b15\u0b4d\u0b37\u0b30 \u0b0f\u0b2c\u0b02 \u0b1c\u0b28\u0b4d\u0b2e \u0b2c\u0b30\u0b4d\u0b37 (YYYY)\u0b30 \u0b2e\u0b3f\u0b36\u0b4d\u0b30\u0b23 \u0964\n\u0b09\u0b26\u0b3e\u0b39\u0b30\u0b23 \u0b2a\u0b3e\u0b07\u0b01:\n\u0b09\u0b26\u0b3e\u0b39\u0b30\u0b23 1\n\u0b28\u0b3e\u0b2e: \u0b38\u0b41\u0b30\u0b47\u0b36 \u0b15\u0b41\u0b2e\u0b3e\u0b30\n\u0b1c\u0b28\u0b4d\u0b2e \u0b2c\u0b30\u0b4d\u0b37: \u0b67\u0b6f\u0b6f\u0b66\n\u0b2a\u0b3e\u0b38\u0b71\u0b3e\u0b30\u0b4d\u0b21: SURE1990\n\u0b09\u0b26\u0b3e\u0b39\u0b30\u0b23 2\n\u0b28\u0b3e\u0b2e: \u0b38\u0b3e\u0b07 \u0b15\u0b41\u0b2e\u0b3e\u0b30\n\u0b1c\u0b28\u0b4d\u0b2e \u0b2c\u0b30\u0b4d\u0b37: \u0b67\u0b6f\u0b6f\u0b66\n\u0b2a\u0b3e\u0b38\u0b71\u0b3e\u0b30\u0b4d\u0b21: SAIK1990\n\u0b09\u0b26\u0b3e\u0b39\u0b30\u0b23 3\n\u0b28\u0b3e\u0b2e: \u0b2a\u0b3f.\n\u0b1c\u0b28\u0b4d\u0b2e \u0b2c\u0b30\u0b4d\u0b37: \u0b67\u0b6f\u0b6f\u0b66\n\u0b2a\u0b3e\u0b38\u0b71\u0b3e\u0b30\u0b4d\u0b21: P.KU1990\n\u0b09\u0b26\u0b3e\u0b39\u0b30\u0b23 4\n\u0b28\u0b3e\u0b2e: \u0b06\u0b30\u0b06\u0b07\u0b0f\n\u0b1c\u0b28\u0b4d\u0b2e \u0b2c\u0b30\u0b4d\u0b37: \u0b67\u0b6f\u0b6f\u0b66\n\u0b2a\u0b3e\u0b38\u0b71\u0b3e\u0b30\u0b4d\u0b21: RIA1990"},{question:"\u0b07-\u0b06\u0b27\u0b3e\u0b30 \u0b16\u0b4b\u0b32\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b15'\u0b23 \u0b38\u0b39\u0b3e\u0b5f\u0b15 \u0b38\u0b2b\u0b4d\u0b1f\u0b71\u0b47\u0b5f\u0b3e\u0b30 \u0b26\u0b30\u0b15\u0b3e\u0b30?",answer:"\u0b07-\u0b06\u0b27\u0b3e\u0b30 \u0b26\u0b47\u0b16\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b19\u0b4d\u0b15\u0b41 '\u0b06\u0b21\u0b4b\u0b2c \u0b30\u0b3f\u0b21\u0b30\u0b4d'\u0b30 \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15\u0b24\u0b3e \u0b30\u0b39\u0b3f\u0b1b\u0b3f\u0964 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b38\u0b3f\u0b37\u0b4d\u0b1f\u0b2e\u0b4d \u0b30\u0b47 '\u0b06\u0b21\u0b4b\u0b2c\u0b4d \u0b30\u0b3f\u0b21\u0b30\u0b4d' \u0b38\u0b02\u0b38\u0b4d\u0b25\u0b3e\u0b2a\u0b3f\u0b24 \u0b39\u0b4b\u0b07\u0b1b\u0b3f\u0964 \u0b38\u0b3f\u0b37\u0b4d\u0b1f\u0b2e\u0b30\u0b47 \u0b06\u0b21\u0b4b\u0b2c \u0b30\u0b3f\u0b21\u0b30\u0b4d \u0b38\u0b02\u0b38\u0b4d\u0b25\u0b3e\u0b2a\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 https://get.adobe.com/reader/ \u0b2a\u0b30\u0b3f\u0b26\u0b30\u0b4d\u0b36\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41"},{question:"\u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b27\u0b3e\u0b30\u0b40 \u0b07-\u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b47\u0b2e\u0b3f\u0b24\u0b3f \u0b21\u0b3e\u0b09\u0b28\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47?",answer:"\u0b1c\u0b23\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b27\u0b3e\u0b30\u0b40 \u0b24\u0b3f\u0b28\u0b3f\u0b1f\u0b3f \u0b09\u0b2a\u0b3e\u0b5f \u0b05\u0b2c\u0b32\u0b2e\u0b4d\u0b2c\u0b28 \u0b15\u0b30\u0b3f \u0b07-\u0b06\u0b27\u0b3e\u0b30 \u0b21\u0b3e\u0b09\u0b28\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964\nEnrollment \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f :\n\u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f :\n\u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f:\n\u0b07\u0b06\u0b27\u0b3e\u0b30 \u0b21\u0b3e\u0b09\u0b28\u0b4d \u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b13\u0b1f\u0b3f\u0b2a\u0b3f \u0b2a\u0b1e\u0b4d\u0b1c\u0b40\u0b15\u0b43\u0b24 \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32\u0b4d \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b30\u0b47 \u0b06\u0b38\u0b3f\u0b2c\u0964"}],bookAnAppointment:[{question:"\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07\u0b30\u0b47 \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17 \u0b38\u0b2e\u0b3e\u0b27\u0b3e\u0b28 \u0b1a\u0b4d\u0b5f\u0b3e\u0b28\u0b47\u0b32\u0b17\u0b41\u0b5c\u0b3f\u0b15 \u0b15'\u0b23?",answer:"\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07\u0b30 \u0b2c\u0b3f\u0b2d\u0b3f\u0b28\u0b4d\u0b28 \u0b1a\u0b4d\u0b5f\u0b3e\u0b28\u0b47\u0b32 \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b2e\u0b3e\u0b28\u0b47 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07\u0b30\u0b47 \u0b2a\u0b39\u0b1e\u0b4d\u0b1a\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17\u0b30 \u0b38\u0b2e\u0b3e\u0b27\u0b3e\u0b28 \u0b2a\u0b3e\u0b07\u0b01 \u0b2b\u0b4b\u0b28\u0b4d, \u0b07-\u0b2e\u0b47\u0b32\u0b4d, \u0b1a\u0b3e\u0b1f\u0b4d, \u0b32\u0b47\u0b1f\u0b30/\u0b2a\u0b4b\u0b37\u0b4d\u0b1f, \u0b2c\u0b47\u0b2c\u0b4d \u0b2a\u0b4b\u0b30\u0b4d\u0b1f\u0b3e\u0b32\u0b4d, \u0b2c\u0b3e\u0b15\u0b4d \u0b07\u0b28\u0b4d \u0b0f\u0b2c\u0b02 \u0b38\u0b4b\u0b38\u0b3f\u0b06\u0b32\u0b4d \u0b2e\u0b3f\u0b21\u0b3f\u0b06\u0964\n\u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 \u0b1a\u0b4d\u0b5f\u0b3e\u0b28\u0b47\u0b32 \u0b38\u0b2e\u0b4d\u0b2a\u0b30\u0b4d\u0b15\u0b30\u0b47 \u0b2c\u0b3f\u0b38\u0b4d\u0b24\u0b43\u0b24 \u0b38\u0b42\u0b1a\u0b28\u0b3e \u0b28\u0b3f\u0b2e\u0b4d\u0b28\u0b30\u0b47 \u0b26\u0b3f\u0b06\u0b17\u0b32\u0b3e\n1. \u0b2b\u0b4b\u0b28 \u0b15\u0b32 (\u0b1f\u0b4b\u0b32 \u0b2b\u0b4d\u0b30\u0b3f \u0b28\u0b2e\u0b4d\u0b2c\u0b30) -\n\u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b39 \u0b1c\u0b21\u0b3f\u0b24 \u0b38\u0b2e\u0b38\u0b4d\u0b5f\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b2c\u0b3f\u0b36\u0b47\u0b37 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b1f\u0b4b\u0b32 \u0b2b\u0b4d\u0b30\u0b3f \u0b28\u0b2e\u0b4d\u0b2c\u0b30 (1947)\u0b30\u0b47 \u0b2f\u0b4b\u0b17\u0b3e\u0b5f\u0b4b\u0b17 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b2f\u0b4b\u0b17\u0b3e\u0b5f\u0b4b\u0b17 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b30\u0b47 \u0b0f\u0b15 \u0b38\u0b47\u0b32\u0b4d\u0b2b \u0b38\u0b30\u0b4d\u0b2d\u0b3f\u0b38 \u0b06\u0b07\u0b2d\u0b3f\u0b06\u0b30\u0b0f\u0b38 (\u0b07\u0b23\u0b4d\u0b1f\u0b30\u0b06\u0b15\u0b4d\u0b1f\u0b3f\u0b2d \u0b2d\u0b0f\u0b38 \u0b30\u0b47\u0b38\u0b2a\u0b28\u0b4d\u0b38 \u0b38\u0b3f\u0b37\u0b4d\u0b1f\u0b2e) \u0b0f\u0b2c\u0b02 \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b17\u0b24 \u0b38\u0b39\u0b3e\u0b5f\u0b24\u0b3e \u0b15\u0b3e\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b28\u0b3f\u0b30\u0b4d\u0b2c\u0b3e\u0b39\u0b40 \u0b06\u0b27\u0b3e\u0b30\u0b3f\u0b24 \u0b38\u0b39\u0b3e\u0b5f\u0b24\u0b3e \u0b30\u0b39\u0b3f\u0b1b\u0b3f\u0964 \u0b28\u0b3f\u0b1c \u0b38\u0b41\u0b2c\u0b3f\u0b27\u0b3e \u0b05\u0b28\u0b41\u0b38\u0b3e\u0b30\u0b47 \u0b2f\u0b4b\u0b17\u0b3e\u0b5f\u0b4b\u0b17 \u0b2a\u0b3e\u0b07\u0b01 \u0b28\u0b3f\u0b2e\u0b4d\u0b28\u0b30\u0b47 \u0b09\u0b32\u0b4d\u0b32\u0b47\u0b16 \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b2d\u0b3e\u0b37\u0b3e \u0b2e\u0b27\u0b4d\u0b5f\u0b30\u0b41 \u0b2f\u0b47\u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2d\u0b3e\u0b37\u0b3e\u0b15\u0b41 \u0b1a\u0b5f\u0b28 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964\n1. \u0b39\u0b3f\u0b28\u0b4d\u0b26\u0b40\n5. \u0b15\u0b28\u0b4d\u0b28\u0b21\n9. \u0b17\u0b41\u0b1c\u0b3e\u0b30\u0b3e\u0b24\u0b3f\n2. \u0b07\u0b02\u0b30\u0b3e\u0b1c\u0b40\n6. \u0b2e\u0b3e\u0b32\u0b3e\u0b5f\u0b32\u0b2e\n10. \u0b2e\u0b30\u0b3e\u0b20\u0b40\n3. \u0b24\u0b47\u0b32\u0b41\u0b17\u0b41\n7. \u0b06\u0b38\u0b3e\u0b2e\u0b40\n11. \u0b2a\u0b1e\u0b4d\u0b1c\u0b3e\u0b2c\u0b40\n4. \u0b24\u0b3e\u0b2e\u0b3f\u0b32\n8. \u0b2c\u0b19\u0b4d\u0b17\u0b3e\u0b33\u0b40\n12. \u0b13\u0b5c\u0b3f\u0b06\n\u0b38\u0b2e\u0b5f :\n(\u0b15) \u0b06\u0b07\u0b2d\u0b3f\u0b06\u0b30\u0b0f\u0b38 \u0b1c\u0b30\u0b3f\u0b06\u0b30\u0b47 \u0b38\u0b4d\u0b71\u0b5f\u0b02 \u0b38\u0b47\u0b2c\u0b3e\u0b30 \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27\u0b24\u0b3e: 24x7 \u0b06\u0b27\u0b3e\u0b30\u0b30\u0b47 \u0b38\u0b47\u0b32\u0b4d\u0b2b \u0b38\u0b30\u0b4d\u0b2d\u0b3f\u0b38 \u0b2e\u0b4b\u0b21\u0b30\u0b47 \u0b06\u0b07\u0b2d\u0b3f\u0b06\u0b30\u0b0f\u0b38 \u0b1c\u0b30\u0b3f\u0b06\u0b30\u0b47 \u0b38\u0b47\u0b2c\u0b3e \u0b17\u0b4d\u0b30\u0b39\u0b23 \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0964\n\u0b16) \u0b15\u0b3e\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b28\u0b3f\u0b30\u0b4d\u0b2c\u0b3e\u0b39\u0b40 \u0b38\u0b39\u0b3e\u0b5f\u0b24\u0b3e\u0b15\u0b41 \u0b38\u0b2e\u0b30\u0b4d\u0b25\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e: \u0b38\u0b4b\u0b2e\u0b2c\u0b3e\u0b30\u0b30\u0b41 \u0b36\u0b28\u0b3f\u0b2c\u0b3e\u0b30 \u0b2a\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b28\u0b4d\u0b24 \u0b0f\u0b39\u0b3f \u0b38\u0b47\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47: \u0b38\u0b15\u0b3e\u0b33 7\u0b1f\u0b3e\u0b30\u0b41 \u0b30\u0b3e\u0b24\u0b3f 11\u0b1f\u0b3e, \u0b30\u0b2c\u0b3f\u0b2c\u0b3e\u0b30: \u0b38\u0b15\u0b3e\u0b33 8\u0b1f\u0b3e\u0b30\u0b41 \u0b38\u0b28\u0b4d\u0b27\u0b4d\u0b5f\u0b3e 5\u0b1f\u0b3e \u0b2a\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b28\u0b4d\u0b24.. . \u0b2b\u0b3f\u0b1a\u0b30 \u0b13\u0b5c\u0b3f\u0b36\u0b3e \u0b38\u0b2e\u0b4d\u0b2c\u0b3e\u0b26 \u0b2c\u0b4d\u0b5f\u0b41\u0b30\u0b4b -.\n\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b05\u0b28\u0b41\u0b2e\u0b4b\u0b26\u0b3f\u0b24 \u0b37\u0b4d\u0b1f\u0b3e\u0b23\u0b4d\u0b21\u0b3e\u0b30\u0b4d\u0b21 \u0b30\u0b47\u0b38\u0b2a\u0b28\u0b4d\u0b38 \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b15\u0b23\u0b4d\u0b1f\u0b3e\u0b15\u0b4d\u0b1f \u0b38\u0b47\u0b23\u0b4d\u0b1f\u0b30 \u0b0f\u0b15\u0b4d\u0b1c\u0b3f\u0b15\u0b4d\u0b5f\u0b41\u0b1f\u0b3f\u0b2d\u0b4d \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b38\u0b3e\u0b27\u0b3e\u0b30\u0b23 \u0b2a\u0b4d\u0b30\u0b36\u0b4d\u0b28\u0b30 \u0b38\u0b2e\u0b3e\u0b27\u0b3e\u0b28 \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07\u0b25\u0b3e\u0b0f \u0b0f\u0b2c\u0b02 \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17\u0b17\u0b41\u0b5c\u0b3f\u0b15\u0b41 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07\u0b30 \u0b38\u0b2e\u0b4d\u0b2a\u0b43\u0b15\u0b4d\u0b24 \u0b21\u0b3f\u0b2d\u0b3f\u0b1c\u0b28 / \u0b06\u0b1e\u0b4d\u0b1a\u0b33\u0b3f\u0b15 \u0b15\u0b3e\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b3e\u0b33\u0b5f\u0b15\u0b41 \u0b2a\u0b4d\u0b30\u0b15\u0b43\u0b24 \u0b38\u0b2e\u0b5f \u0b06\u0b27\u0b3e\u0b30\u0b30\u0b47 \u0b26\u0b3f\u0b06\u0b5f\u0b3e\u0b0f\u0964 \u0b0f\u0b39\u0b3f \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17\u0b17\u0b41\u0b5c\u0b3f\u0b15\u0b41 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07\u0b30 \u0b38\u0b2e\u0b4d\u0b2a\u0b43\u0b15\u0b4d\u0b24 \u0b21\u0b3f\u0b2d\u0b3f\u0b1c\u0b28/\u0b06\u0b1e\u0b4d\u0b1a\u0b33\u0b3f\u0b15 \u0b15\u0b3e\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b3e\u0b33\u0b5f\u0b30\u0b47 \u0b06\u0b2d\u0b4d\u0b5f\u0b28\u0b4d\u0b24\u0b30\u0b40\u0b23 \u0b2d\u0b3e\u0b2c\u0b47 \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07\u0b25\u0b3e\u0b0f, \u0b2f\u0b3e\u0b39\u0b3e \u0b2b\u0b33\u0b30\u0b47 \u0b0f\u0b39\u0b3e\u0b30 \u0b2a\u0b4d\u0b30\u0b2d\u0b3e\u0b2c\u0b40 \u0b38\u0b2e\u0b3e\u0b27\u0b3e\u0b28 \u0b0f\u0b2c\u0b02 \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b19\u0b4d\u0b15 \u0b38\u0b39\u0b3f\u0b24 \u0b2f\u0b4b\u0b17\u0b3e\u0b5f\u0b4b\u0b17 \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0964\n2. \u0b1a\u0b3e\u0b1f\u0b2c\u0b1f (\u0b06\u0b27\u0b3e\u0b30 \u0b2e\u0b3f\u0b24\u0b4d\u0b30) - \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b2e\u0b3e\u0b28\u0b47 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b1a\u0b3e\u0b1f\u0b2c\u0b1f \u0b38\u0b47\u0b2c\u0b3e '\u0b06\u0b27\u0b3e\u0b30 \u0b2e\u0b3f\u0b24\u0b4d\u0b30' \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b39 \u0b1c\u0b21\u0b3f\u0b24 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b30 \u0b1a\u0b3f\u0b28\u0b4d\u0b24\u0b3e\u0b15\u0b41 \u0b09\u0b20\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 \u0b2f\u0b3e\u0b39\u0b3e \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07\u0b30 \u0b05\u0b2b\u0b3f\u0b38\u0b3f\u0b06\u0b32 \u0b2c\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f\u0b30\u0b47 \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 \u0b0f\u0b39\u0b3f \u0b1a\u0b3e\u0b1f\u0b2c\u0b1f \u0b2a\u0b4d\u0b30\u0b36\u0b4d\u0b28\u0b30 \u0b09\u0b24\u0b4d\u0b24\u0b30 \u0b26\u0b47\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b2a\u0b4d\u0b30\u0b36\u0b3f\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b0f\u0b2c\u0b02 \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b17\u0b24 \u0b05\u0b28\u0b41\u0b2d\u0b2c\u0b30\u0b47 \u0b09\u0b28\u0b4d\u0b28\u0b24\u0b3f \u0b06\u0b23\u0b3f\u0b2c\u0b3e \u0b32\u0b15\u0b4d\u0b37\u0b4d\u0b5f\u0b30\u0b47 \u0b30\u0b39\u0b3f\u0b1b\u0b3f\u0964\n3. \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b2c\u0b47\u0b2c \u0b2a\u0b4b\u0b30\u0b4d\u0b1f\u0b3e\u0b32 - \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b2e\u0b3e\u0b28\u0b47 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b2c\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f\u0b30\u0b47 \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17 \u0b0f\u0b2c\u0b02 \u0b2b\u0b3f\u0b21\u0b2c\u0b4d\u0b5f\u0b3e\u0b15\u0b4d \u0b0f\u0b2c\u0b02 \u0b1a\u0b47\u0b15\u0b4d \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17 / \u0b2b\u0b3f\u0b21\u0b2c\u0b4d\u0b5f\u0b3e\u0b15\u0b4d \u0b37\u0b4d\u0b1f\u0b3e\u0b1f\u0b38\u0b4d \u0b05\u0b28\u0b4d\u0b24\u0b30\u0b4d\u0b17\u0b24 \u0b2f\u0b25\u0b3e\u0b15\u0b4d\u0b30\u0b2e\u0b47 \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17 \u0b0f\u0b2c\u0b02 \u0b2b\u0b3f\u0b21\u0b2c\u0b4d\u0b5f\u0b3e\u0b15\u0b4d \u0b37\u0b4d\u0b1f\u0b3e\u0b1f\u0b38\u0b4d \u0b26\u0b3e\u0b16\u0b32 \u0b0f\u0b2c\u0b02 \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964\n4. \u0b07-\u0b2e\u0b47\u0b32\u0b4d - \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b2e\u0b4d\u0b2a\u0b30\u0b4d\u0b15\u0b3f\u0b24 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2a\u0b4d\u0b30\u0b36\u0b4d\u0b28 \u0b13 \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17 \u0b2a\u0b3e\u0b07\u0b01 \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b2c\u0b3f\u0b36\u0b47\u0b37 help@uidai.gov.in \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b30\u0b47 \u0b07-\u0b2e\u0b47\u0b32\u0b4d \u0b2a\u0b20\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964\n5. \u0b06\u0b1e\u0b4d\u0b1a\u0b33\u0b3f\u0b15 \u0b15\u0b3e\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b3e\u0b33\u0b5f\u0b30\u0b47 \u0b2c\u0b3e\u0b15\u0b4d-\u0b07\u0b28\u0b4d: \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b2e\u0b3e\u0b28\u0b47 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b2a\u0b4d\u0b30\u0b36\u0b4d\u0b28\u0b30 \u0b38\u0b2e\u0b3e\u0b27\u0b3e\u0b28 \u0b2a\u0b3e\u0b07\u0b01 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b2e\u0b4d\u0b2a\u0b30\u0b4d\u0b15\u0b3f\u0b24 \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b28\u0b3f\u0b1c \u0b30\u0b3e\u0b1c\u0b4d\u0b5f \u0b05\u0b28\u0b41\u0b5f\u0b3e\u0b5f\u0b40 \u0b38\u0b2e\u0b4d\u0b2a\u0b43\u0b15\u0b4d\u0b24 \u0b06\u0b1e\u0b4d\u0b1a\u0b33\u0b3f\u0b15 \u0b15\u0b3e\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b3e\u0b33\u0b5f\u0b15\u0b41 \u0b38\u0b3f\u0b27\u0b3e\u0b38\u0b33\u0b16 \u0b2f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964\n6. \u0b2a\u0b4b\u0b37\u0b4d\u0b1f\u0b4d/\u0b32\u0b47\u0b1f\u0b30\u0b4d: \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b2e\u0b41\u0b16\u0b4d\u0b5f\u0b3e\u0b33\u0b5f \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b06\u0b1e\u0b4d\u0b1a\u0b33\u0b3f\u0b15 \u0b15\u0b3e\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b3e\u0b33\u0b5f\u0b30\u0b47 \u0b21\u0b3e\u0b15 \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b2e\u0b3e\u0b28\u0b47 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b28\u0b3f\u0b1c \u0b39\u0b3e\u0b24\u0b30\u0b47 \u0b06\u0b2c\u0b47\u0b26\u0b28 \u0b2a\u0b24\u0b4d\u0b30 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964 \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17\u0b30 \u0b38\u0b2e\u0b3e\u0b27\u0b3e\u0b28 \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b2e\u0b4d\u0b2a\u0b43\u0b15\u0b4d\u0b24 \u0b06\u0b1e\u0b4d\u0b1a\u0b33\u0b3f\u0b15 \u0b15\u0b3e\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b3e\u0b33\u0b5f/\u0b21\u0b3f\u0b2d\u0b3f\u0b1c\u0b28 \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15\u0b40\u0b5f \u0b2a\u0b26\u0b15\u0b4d\u0b37\u0b47\u0b2a \u0b17\u0b4d\u0b30\u0b39\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b47\u0964\n7. \u0b2d\u0b3e\u0b30\u0b24 \u0b38\u0b30\u0b15\u0b3e\u0b30\u0b19\u0b4d\u0b15 \u0b1c\u0b28 \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17 \u0b2a\u0b4b\u0b30\u0b4d\u0b1f\u0b3e\u0b32 (\u0b38\u0b3f\u0b2a\u0b3f\u0b1c\u0b3f\u0b06\u0b30\u0b0f\u0b0f\u0b2e\u0b0f\u0b38) : \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07\u0b30\u0b47 \u0b38\u0b47\u0b23\u0b4d\u0b1f\u0b4d\u0b30\u0b3e\u0b32\u0b3e\u0b07\u0b1c\u0b21\u0b4d \u0b2a\u0b2c\u0b4d\u0b32\u0b3f\u0b15 \u0b17\u0b4d\u0b30\u0b40\u0b2d\u0b3e\u0b28\u0b4d\u0b38 \u0b30\u0b3f\u0b21\u0b4d\u0b30\u0b47\u0b38 \u0b06\u0b23\u0b4d\u0b21 \u0b2e\u0b28\u0b3f\u0b1f\u0b30\u0b3f\u0b02 \u0b38\u0b3f\u0b37\u0b4d\u0b1f\u0b2e (\u0b38\u0b3f\u0b2a\u0b3f\u0b1c\u0b3f\u0b06\u0b30\u0b0f\u0b0f\u0b2e\u0b0f\u0b38) \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0964 \u0b0f\u0b39\u0b3e \u0b0f\u0b15 \u0b05\u0b28\u0b32\u0b3e\u0b07\u0b28 \u0b2a\u0b4d\u0b32\u0b3e\u0b1f\u0b2b\u0b30\u0b4d\u0b2e \u0b2f\u0b3e\u0b39\u0b3e \u0b28\u0b3e\u0b17\u0b30\u0b3f\u0b15\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b2a\u0b3e\u0b07\u0b01 24x7 \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27\u0964\n8. \u0b38\u0b4b\u0b38\u0b3f\u0b06\u0b32 \u0b2e\u0b3f\u0b21\u0b3f\u0b06 : \u0b1f\u0b4d\u0b71\u0b3f\u0b1f\u0b30, \u0b2b\u0b47\u0b38\u0b2c\u0b41\u0b15, \u0b5f\u0b41\u0b1f\u0b4d\u0b5f\u0b41\u0b2c, \u0b07\u0b28\u0b37\u0b4d\u0b1f\u0b3e\u0b17\u0b4d\u0b30\u0b3e\u0b2e \u0b07\u0b24\u0b4d\u0b5f\u0b3e\u0b26\u0b3f \u0b2c\u0b3f\u0b2d\u0b3f\u0b28\u0b4d\u0b28 \u0b38\u0b4b\u0b38\u0b3f\u0b06\u0b32 \u0b2e\u0b3f\u0b21\u0b3f\u0b06 \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0964 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b21\u0b3f\u0b0f\u0b2e\u0b15\u0b41 \u0b1f\u0b4d\u0b5f\u0b3e\u0b17 \u0b15\u0b30\u0b3f \u0b28\u0b3f\u0b1c\u0b30 \u0b1a\u0b3f\u0b28\u0b4d\u0b24\u0b3e/\u0b05\u0b2d\u0b3f\u0b5f\u0b4b\u0b17 \u0b38\u0b2e\u0b4d\u0b2c\u0b28\u0b4d\u0b27\u0b40\u0b5f \u0b0f\u0b15 \u0b2a\u0b4b\u0b37\u0b4d\u0b1f\u0b15\u0b41 \u0b2c\u0b3f\u0b2d\u0b3f\u0b28\u0b4d\u0b28 \u0b38\u0b4b\u0b38\u0b3f\u0b06\u0b32 \u0b2e\u0b3f\u0b21\u0b3f\u0b06 \u0b37\u0b4d\u0b1f\u0b4d\u0b30\u0b3f\u0b2e\u0b30\u0b47 \u0b05\u0b2a\u0b32\u0b4b\u0b21 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964"},{question:"\u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b47\u0b2c\u0b3e \u0b36\u0b41\u0b33\u0b4d\u0b15 \u0b2d\u0b3f\u0b28\u0b4d\u0b28 \u0b15\u0b3f?",answer:"\u0b28\u0b3e, \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 \u0b38\u0b2e\u0b47\u0b24 \u0b26\u0b47\u0b36\u0b30 \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b30\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b36\u0b41\u0b33\u0b4d\u0b15 \u0b38\u0b2e\u0b3e\u0b28 \u0b30\u0b39\u0b3f\u0b1b\u0b3f\u0964\n\u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b1e\u0b4d\u0b1c\u0b40\u0b15\u0b30\u0b23 \u0b0f\u0b2c\u0b02 \u0b05\u0b26\u0b4d\u0b5f\u0b24\u0b28 \u0b36\u0b41\u0b33\u0b4d\u0b15 \u0b2a\u0b3e\u0b07\u0b01 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b26\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41"},{question:"\u0b2e\u0b41\u0b01 \u0b2e\u0b4b \u0b28\u0b3f\u0b5f\u0b41\u0b15\u0b4d\u0b24\u0b3f\u0b15\u0b41 \u0b2a\u0b41\u0b28\u0b03 \u0b28\u0b3f\u0b30\u0b4d\u0b26\u0b4d\u0b27\u0b3e\u0b30\u0b23/ \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b3f \u0b15\u0b3f?",answer:"\u0b39\u0b01, \u0b06\u0b2a\u0b23 24 \u0b18\u0b23\u0b4d\u0b1f\u0b3e \u0b2a\u0b42\u0b30\u0b4d\u0b2c\u0b30\u0b41 \u0b05\u0b2a\u0b4b\u0b07\u0b23\u0b4d\u0b1f\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b2a\u0b4b\u0b30\u0b4d\u0b1f\u0b3e\u0b32\u0b30\u0b47 \u0b32\u0b17\u0b4d \u0b07\u0b28\u0b4d \u0b15\u0b30\u0b3f \u0b38\u0b47\u0b39\u0b3f \u0b38\u0b2e\u0b3e\u0b28 \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32\u0b4d \u0b28\u0b2e\u0b4d\u0b2c\u0b30/\u0b07\u0b2e\u0b47\u0b32\u0b4d \u0b06\u0b07\u0b21\u0b3f (\u0b06\u0b17\u0b30\u0b41 \u0b26\u0b3f\u0b06\u0b5f\u0b3e\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b2a\u0b30\u0b3f) \u0b26\u0b47\u0b07 \u0b05\u0b2a\u0b4b\u0b07\u0b23\u0b4d\u0b1f\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b30\u0b3f-\u0b36\u0b3f\u0b21\u0b4d\u0b5f\u0b41\u0b32\u0b4d \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964"},{question:"\u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b30\u0b41 \u0b2e\u0b41\u0b01 \u0b15\u0b47\u0b09\u0b01 \u0b15\u0b47\u0b09\u0b01 \u0b38\u0b47\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b3f?",answer:"\u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b17\u0b41\u0b21\u0b3f\u0b15 \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b2a\u0b4d\u0b30\u0b15\u0b3e\u0b30 \u0b30 \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b3f\u0b25\u0b3e\u0b0f \u0b2f\u0b47\u0b2a\u0b30\u0b3f\u0b15\u0b3f\n1. \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b2c\u0b5f\u0b38 \u0b2c\u0b30\u0b4d\u0b17 \u0b2a\u0b3e\u0b07\u0b01 \u0b28\u0b42\u0b24\u0b28 \u0b28\u0b3e\u0b2e\u0b32\u0b47\u0b16\u0b3e\u0964\n2. \u0b2f\u0b47\u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b1c\u0b28\u0b38\u0b02\u0b16\u0b4d\u0b5f\u0b3e \u0b17\u0b24 \u0b38\u0b42\u0b1a\u0b28\u0b3e (\u0b28\u0b3e\u0b2e, \u0b20\u0b3f\u0b15\u0b23\u0b3e, \u0b32\u0b3f\u0b19\u0b4d\u0b17, \u0b1c\u0b28\u0b4d\u0b2e \u0b24\u0b3e\u0b30\u0b3f\u0b16, \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32\u0b4d \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b0f\u0b2c\u0b02 \u0b07\u0b2e\u0b47\u0b32\u0b4d \u0b06\u0b07\u0b21\u0b3f)\u0b30 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964\n3. \u0b2c\u0b3e\u0b5f\u0b4b\u0b2e\u0b47\u0b1f\u0b4d\u0b30\u0b3f\u0b15\u0b4d \u0b38\u0b42\u0b1a\u0b28\u0b3e\u0b30 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d (\u0b2b\u0b1f\u0b4b, \u0b2b\u0b3f\u0b19\u0b4d\u0b17\u0b30\u0b2a\u0b4d\u0b30\u0b3f\u0b23\u0b4d\u0b1f\u0b0f\u0b2c\u0b02 \u0b06\u0b07\u0b30\u0b3f\u0b38\u0b4d \u0b38\u0b4d\u0b15\u0b3e\u0b28\u0b4d) \u0964\n\u0b6a. \u0b36\u0b3f\u0b36\u0b41\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b2c\u0b3e\u0b27\u0b4d\u0b5f\u0b24\u0b3e\u0b2e\u0b42\u0b33\u0b15 \u0b2c\u0b3e\u0b5f\u0b4b\u0b2e\u0b47\u0b1f\u0b4d\u0b30\u0b3f\u0b15\u0b4d \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d (\u0b2c\u0b5f\u0b38 \u0b6b \u0b13 \u0b67\u0b6b \u0b2c\u0b30\u0b4d\u0b37)\u0964\n5. \u0b21\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d (POI \u0b0f\u0b2c\u0b02 POA) \u0964\n6. \u0b06\u0b27\u0b3e\u0b30 \u0b16\u0b4b\u0b1c\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b2a\u0b4d\u0b30\u0b3f\u0b23\u0b4d\u0b1f \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964"},{question:"\u0b15'\u0b23 \u0b30\u0b39\u0b3f\u0b1b\u0b3f \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 ASKs(\u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30)\u0b30 \u0b38\u0b2e\u0b5f?",answer:"\u0b1c\u0b3e\u0b24\u0b40\u0b5f/\u0b06\u0b1e\u0b4d\u0b1a\u0b33\u0b3f\u0b15 \u0b1b\u0b41\u0b1f\u0b3f\u0b15\u0b41 \u0b2c\u0b3e\u0b26\u0b4d \u0b26\u0b47\u0b32\u0b47 \u0b38\u0b2a\u0b4d\u0b24\u0b3e\u0b39\u0b30 7 \u0b26\u0b3f\u0b28 \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 \u0b16\u0b4b\u0b32\u0b3e \u0b30\u0b39\u0b3f\u0b1b\u0b3f\u0964 \u0b38\u0b3e\u0b27\u0b3e\u0b30\u0b23\u0b24\u0b03 \u0b0f\u0b39\u0b3e \u0b2d\u0b3e\u0b30\u0b24\u0b40\u0b5f \u0b38\u0b2e\u0b5f \u0b05\u0b28\u0b41\u0b38\u0b3e\u0b30\u0b47 \u0b38\u0b15\u0b3e\u0b33 9:30\u0b30\u0b41 \u0b38\u0b28\u0b4d\u0b27\u0b4d\u0b5f\u0b3e 5:30 \u0b2a\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b28\u0b4d\u0b24 \u0b15\u0b3e\u0b30\u0b4d\u0b5f\u0b4d\u0b5f \u0b15\u0b30\u0b3f\u0b25\u0b3e\u0b0f\u0964\n\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b2c\u0b4d\u0b5f\u0b24\u0b40\u0b24 \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b1e\u0b4d\u0b1c\u0b40\u0b15\u0b30\u0b23 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 ASKs \u0b28\u0b3f\u0b1c \u0b28\u0b3f\u0b1c \u0b30\u0b47\u0b1c\u0b3f\u0b37\u0b4d\u0b1f\u0b4d\u0b30\u0b3e\u0b30\u0b19\u0b4d\u0b15 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b28\u0b3f\u0b30\u0b4d\u0b26\u0b4d\u0b27\u0b3e\u0b30\u0b3f\u0b24 \u0b38\u0b2e\u0b5f\u0b15\u0b41 \u0b05\u0b28\u0b41\u0b38\u0b30\u0b23 \u0b15\u0b30\u0b3f\u0b25\u0b3e\u0b0f\u0964 \u0b28\u0b3e\u0b2e\u0b32\u0b47\u0b16\u0b3e \u0b16\u0b4b\u0b1c\u0b41\u0b25\u0b3f\u0b2c\u0b3e \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b2c\u0b3f\u0b36\u0b47\u0b37/ \u0b05\u0b27\u0b3f\u0b15 \u0b38\u0b42\u0b1a\u0b28\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b27\u0b3e\u0b30\u0b40\u0b2e\u0b3e\u0b28\u0b47 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b28\u0b3f\u0b15\u0b1f\u0b38\u0b4d\u0b25 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b3e\u0b2e\u0b32\u0b47\u0b16\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b30\u0b47 \u0b2f\u0b4b\u0b17\u0b3e\u0b5f\u0b4b\u0b17 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964"},{question:"\u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 (\u0b0f\u0b0f\u0b38\u0b4d\u0b15\u0b47) \u0b15'\u0b23?",answer:"\u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30' \u0b2c\u0b3e \u0b0f\u0b0f\u0b38\u0b4d\u0b15\u0b47 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b19\u0b4d\u0b15 \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e\u0b30 \u0b38\u0b3f\u0b19\u0b4d\u0b17\u0b32\u0b4d \u0b37\u0b4d\u0b1f\u0b2a\u0b4d \u0b21\u0b47\u0b37\u0b4d\u0b1f\u0b3f\u0b28\u0b47\u0b38\u0b28\u0b4d\u0964 ASK \u0b0f\u0b15 \u0b05\u0b24\u0b4d\u0b5f\u0b3e\u0b27\u0b41\u0b28\u0b3f\u0b15 \u0b2a\u0b30\u0b3f\u0b2c\u0b47\u0b36\u0b30\u0b47 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b41 \u0b38\u0b2e\u0b30\u0b4d\u0b2a\u0b3f\u0b24 \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b1e\u0b4d\u0b1c\u0b40\u0b15\u0b30\u0b23 \u0b0f\u0b2c\u0b02 \u0b05\u0b26\u0b4d\u0b5f\u0b24\u0b28 \u0b38\u0b47\u0b2c\u0b3e \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b3f\u0b25\u0b3e\u0b0f\u0964 \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b30\u0b47 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b19\u0b4d\u0b15\u0b41 \u0b36\u0b40\u0b24\u0b24\u0b3e\u0b2a \u0b28\u0b3f\u0b5f\u0b28\u0b4d\u0b24\u0b4d\u0b30\u0b3f\u0b24 \u0b06\u0b30\u0b3e\u0b2e\u0b26\u0b3e\u0b5f\u0b15 \u0b2a\u0b30\u0b3f\u0b2c\u0b47\u0b36 \u0b2f\u0b4b\u0b17\u0b3e\u0b07 \u0b26\u0b3f\u0b06\u0b5f\u0b3e\u0b09\u0b1b\u0b3f\u0964 \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b0f\u0b0f\u0b38\u0b15\u0b47 \u0b39\u0b4d\u0b71\u0b3f\u0b32\u0b4d \u0b1a\u0b47\u0b5f\u0b3e\u0b30 \u0b05\u0b28\u0b41\u0b15\u0b42\u0b33 \u0b0f\u0b2c\u0b02 \u0b0f\u0b25\u0b3f\u0b30\u0b47 \u0b2c\u0b5f\u0b38\u0b4d\u0b15 \u0b0f\u0b2c\u0b02 \u0b38\u0b4d\u0b71\u0b24\u0b28\u0b4d\u0b24\u0b4d\u0b30 \u0b2d\u0b3e\u0b2c\u0b47 \u0b38\u0b15\u0b4d\u0b37\u0b2e \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b19\u0b4d\u0b15 \u0b38\u0b47\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b4d\u0b71\u0b24\u0b28\u0b4d\u0b24\u0b4d\u0b30 \u0b2c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b25\u0b3e \u0b30\u0b39\u0b3f\u0b1b\u0b3f\u0964 ASKs \u0b30\u0b47 \u0b05\u0b27\u0b3f\u0b15 \u0b38\u0b42\u0b1a\u0b28\u0b3e \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 \u0b05\u0b1b\u0b3f here: uidai.gov.in website\u0964"},{question:"UIDAI ASKs (\u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30) \u0b30 \u0b24\u0b3e\u0b32\u0b3f\u0b15\u0b3e \u0b2e\u0b41\u0b01 \u0b15\u0b47\u0b09\u0b01\u0b20\u0b3f \u0b2a\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b3f?",answer:"\u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b15\u0b3e\u0b30\u0b4d\u0b5f\u0b4d\u0b5f\u0b15\u0b4d\u0b37\u0b2e ASKs\u0b30 \u0b0f\u0b15 \u0b38\u0b2e\u0b28\u0b4d\u0b71\u0b3f\u0b24 \u0b24\u0b3e\u0b32\u0b3f\u0b15\u0b3e \u0b28\u0b3f\u0b2e\u0b4d\u0b28\u0b30\u0b47 \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27: \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 \u0b24\u0b3e\u0b32\u0b3f\u0b15\u0b3e\n\u0b2c\u0b4d\u0b5f\u0b3e\u0b19\u0b4d\u0b15, \u0b21\u0b3e\u0b15\u0b18\u0b30, \u0b38\u0b3f\u0b0f\u0b38\u0b38\u0b3f, \u0b2c\u0b3f\u0b0f\u0b38\u0b4d\u0b0f\u0b28\u0b4d\u0b0f\u0b32\u0b4d \u0b0f\u0b2c\u0b02 \u0b30\u0b3e\u0b1c\u0b4d\u0b5f \u0b38\u0b30\u0b15\u0b3e\u0b30\u0b19\u0b4d\u0b15 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b2a\u0b42\u0b30\u0b4d\u0b2c\u0b30\u0b41 \u0b2a\u0b30\u0b3f\u0b1a\u0b3e\u0b33\u0b3f\u0b24 \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b1e\u0b4d\u0b1c\u0b40\u0b15\u0b30\u0b23 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 \u0b2c\u0b4d\u0b5f\u0b24\u0b40\u0b24 \u0b0f\u0b39\u0b3f ASKs \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 \u0b30\u0b39\u0b3f\u0b1b\u0b3f\u0964"}],checkEnrolmentUpdateStatus:[{question:"\u0b05\u0b2a\u0b4d\u0b21\u0b47\u0b1f\u0b4d \u0b06\u0b27\u0b3e\u0b30 \u0b05\u0b28\u0b4d\u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b38\u0b30\u0b4d\u0b2d\u0b3f\u0b38\u0b4d \u0b1c\u0b30\u0b3f\u0b06\u0b30\u0b47 \u0b2e\u0b41\u0b01 \u0b15'\u0b23 \u0b24\u0b25\u0b4d\u0b5f \u0b05\u0b2a\u0b4d\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b3f?",answer:"\u0b0f\u0b39\u0b3f \u0b05\u0b28\u0b32\u0b3e\u0b07\u0b28 \u0b2a\u0b4b\u0b30\u0b4d\u0b1f\u0b3e\u0b32 \u0b1c\u0b30\u0b3f\u0b06\u0b30\u0b47 \u0b06\u0b2a\u0b23 \u0b15\u0b47\u0b2c\u0b33 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b0f\u0b2c\u0b02 \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c \u0b05\u0b2a\u0b21\u0b47\u0b1f \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964 \u0b05\u0b28\u0b4d\u0b5f \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b2a\u0b3e\u0b07\u0b01 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b28\u0b3f\u0b15\u0b1f\u0b38\u0b4d\u0b25 \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b15\u0b41 \u0b2f\u0b3e\u0b06\u0b28\u0b4d\u0b24\u0b41\u0964"}],checkAadhaarValidity:[{question:"\u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b06\u0b27\u0b3e\u0b30 \u0b32\u0b47\u0b1f\u0b30 \u0b20\u0b3e\u0b30\u0b41 \u0b15\u0b47\u0b2e\u0b3f\u0b24\u0b3f \u0b05\u0b32\u0b17\u0b3e?",answer:"\u0b06\u0b27\u0b3e\u0b30 \u0b32\u0b47\u0b1f\u0b30 \u0b39\u0b47\u0b09\u0b1b\u0b3f \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b27\u0b3e\u0b30\u0b40\u0b19\u0b4d\u0b15\u0b41 \u0b2a\u0b1e\u0b4d\u0b1c\u0b3f\u0b15\u0b30\u0b23 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b05\u0b26\u0b4d\u0b5f\u0b24\u0b28 \u0b2a\u0b30\u0b47 \u0b1c\u0b3e\u0b30\u0b3f \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b15\u0b3e\u0b17\u0b1c \u0b06\u0b27\u0b3e\u0b30\u0b3f\u0b24 \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c\u0964 \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b06\u0b27\u0b3e\u0b30\u0b3f\u0b24 \u0b26\u0b40\u0b30\u0b4d\u0b18\u0b38\u0b4d\u0b25\u0b3e\u0b5f\u0b40 \u0b0f\u0b2c\u0b02 \u0b0f\u0b15\u0b3e\u0b27\u0b3f\u0b15 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b2c\u0b48\u0b36\u0b3f\u0b37\u0b4d\u0b1f\u0b4d\u0b5f \u0b25\u0b3f\u0b2c\u0b3e \u0b15\u0b3e\u0b30\u0b4d\u0b21 \u0b2c\u0b39\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b38\u0b39\u0b1c\u0964 \u0b06\u0b27\u0b3e\u0b30 \u0b2a\u0b3f\u0b2d\u0b3f\u0b38\u0b3f \u0b15\u0b3e\u0b30\u0b4d\u0b21\u0b30 \u0b2e\u0b27\u0b4d\u0b5f \u0b38\u0b2e\u0b3e\u0b28 \u0b2c\u0b48\u0b27\u0b24\u0b3e \u0b30\u0b39\u0b3f\u0b1b\u0b3f\u0964"}],lockUnlockAadhaar:[{question:"\u0b05\u0b2c\u0b48\u0b27 \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c \u0b2a\u0b3e\u0b07\u0b01 \u0b2e\u0b4b\u0b30 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b2a\u0b4d\u0b30\u0b24\u0b4d\u0b5f\u0b3e\u0b16\u0b4d\u0b5f\u0b3e\u0b28 \u0b39\u0b4b\u0b07\u0b1b\u0b3f\u0964 \u0b0f\u0b39\u0b3e\u0b30 \u0b05\u0b30\u0b4d\u0b25 \u0b15'\u0b23?",answer:"\u0b05\u0b28\u0b4d \u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b2a\u0b3e\u0b07\u0b01 \u0b06\u0b2a\u0b23 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b41\u0b25\u0b3f\u0b2c\u0b3e \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c\u0b4d \u0b1f\u0b3f \u0b39\u0b47\u0b2c\u0b3e \u0b09\u0b1a\u0b3f\u0b24\u0b4d:\n\u2022 https://uidai.gov.in \u0b05\u0b28\u0b41\u0b2f\u0b3e\u0b5f\u0b40 \u0b2c\u0b48\u0b27 \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c\u0964\n\u2022 \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b19\u0b4d\u0b15 \u0b28\u0b3e\u0b2e\u0b30\u0b47 \u0b30\u0b39\u0b3f\u0b1b\u0b3f \u0964\n\u2022 \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b2b\u0b1f\u0b4b \u0b2e\u0b42\u0b33 \u0b26\u0b38\u0b4d\u0b24\u0b3e\u0b2c\u0b3f\u0b1c\u0b30 \u0b38\u0b4d\u0b2a\u0b37\u0b4d\u0b1f \u0b0f\u0b2c\u0b02 \u0b30\u0b19\u0b4d\u0b17\u0b40\u0b28 \u0b38\u0b4d\u0b15\u0b3e\u0b28\u0b4d \u0b39\u0b47\u0b2c\u0b3e \u0b09\u0b1a\u0b3f\u0b24\u0b4d \u0964\n\u0b06\u0b2a\u0b23 \u0b0f\u0b15 \u0b28\u0b42\u0b24\u0b28 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b42\u0b30\u0b4d\u0b2c\u0b30\u0b41 \u0b09\u0b2a\u0b30\u0b4b\u0b15\u0b4d\u0b24 \u0b05\u0b28\u0b41\u0b38\u0b30\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b28\u0b3f\u0b36\u0b4d\u0b1a\u0b3f\u0b24 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964"},{question:"\u0b06\u0b27\u0b3e\u0b30 (\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f) \u0b32\u0b15\u0b4d \u0b0f\u0b2c\u0b02 \u0b05\u0b28\u0b32\u0b15\u0b4d \u0b15'\u0b23?",answer:"\u0b1c\u0b23\u0b47 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b19\u0b4d\u0b15 \u0b2a\u0b3e\u0b07\u0b01, \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b17\u0b24 \u0b21\u0b3e\u0b1f\u0b3e\u0b30 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b0f\u0b2c\u0b02 \u0b17\u0b4b\u0b2a\u0b28\u0b40\u0b5f\u0b24\u0b3e \u0b38\u0b30\u0b4d\u0b2c\u0b26\u0b3e \u0b0f\u0b15 \u0b2a\u0b4d\u0b30\u0b3e\u0b25\u0b2e\u0b3f\u0b15 \u0b1a\u0b3f\u0b28\u0b4d\u0b24\u0b3e \u0964 \u0b28\u0b3f\u0b1c\u0b30 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b30 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e\u0b15\u0b41 \u0b38\u0b41\u0b26\u0b43\u0b22\u0b3c \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b0f\u0b2c\u0b02 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b19\u0b4d\u0b15\u0b41 \u0b28\u0b3f\u0b5f\u0b28\u0b4d\u0b24\u0b4d\u0b30\u0b23 \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 (\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f) \u0b32\u0b15\u0b4d \u0b0f\u0b2c\u0b02 \u0b05\u0b28\u0b32\u0b15\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b30 \u0b2c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b25\u0b3e \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b3f\u0b25\u0b3e\u0b0f\u0964\n\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b71\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f\u0b4d www.myaadhaar.uidai.gov.in \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b06\u0b27\u0b3e\u0b30 \u0b06\u0b2a\u0b4d \u0b1c\u0b30\u0b3f\u0b06\u0b30\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b32\u0b15\u0b4d \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964\n\u0b0f\u0b39\u0b3e \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e \u0b2c\u0b3e\u0b5f\u0b4b\u0b2e\u0b47\u0b1f\u0b4d\u0b30\u0b3f\u0b15\u0b4d\u0b38, \u0b1c\u0b28\u0b38\u0b02\u0b16\u0b4d\u0b5f\u0b3e \u0b0f\u0b2c\u0b02 \u0b13\u0b1f\u0b3f\u0b2a\u0b3f \u0b2e\u0b4b\u0b21\u0b3e\u0b32\u0b3f\u0b1f\u0b3f \u0b2a\u0b3e\u0b07\u0b01 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f, \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f \u0b1f\u0b4b\u0b15\u0b28 \u0b0f\u0b2c\u0b02 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2a\u0b4d\u0b30\u0b15\u0b3e\u0b30\u0b30 \u0b2a\u0b4d\u0b30\u0b2e\u0b3e\u0b23\u0b40\u0b15\u0b30\u0b23 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 \u0b28\u0b3e\u0b39\u0b3f\u0b01\n\u0b2f\u0b26\u0b3f \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f \u0b05\u0b28\u0b32\u0b15\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b1a\u0b3e\u0b39\u0b41\u0b01\u0b1b\u0b28\u0b4d\u0b24\u0b3f \u0b24\u0b47\u0b2c\u0b47 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b71\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f\u0b4d \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b0f\u0b2e\u0b06\u0b27\u0b3e\u0b30 \u0b06\u0b2a\u0b4d \u0b1c\u0b30\u0b3f\u0b06\u0b30\u0b47 \u0b05\u0b24\u0b4d\u0b5f\u0b3e\u0b27\u0b41\u0b28\u0b3f\u0b15 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f \u0b0f\u0b39\u0b3e \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 \u0964\n\u0b06\u0b27\u0b3e\u0b30 (\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f) \u0b05\u0b28\u0b32\u0b15\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b30\u0b47, \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f, \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f \u0b1f\u0b4b\u0b15\u0b28 \u0b0f\u0b2c\u0b02 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f \u0b2a\u0b4d\u0b30\u0b2e\u0b3e\u0b23\u0b40\u0b15\u0b30\u0b23 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 \u0964"},{question:"\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f  \u0b32\u0b15\u0b4d \u0b15\u0b47\u0b2e\u0b3f\u0b24\u0b3f \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 ?",answer:"\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f \u0b32\u0b15 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b30\u0b47\u0b1c\u0b3f\u0b37\u0b4d\u0b1f\u0b47\u0b23\u0b4d\u0b21\u0b30\u0b30\u0b47 16 \u0b21\u0b3f\u0b1c\u0b3f\u0b1f \u0b2c\u0b3f\u0b36\u0b3f\u0b37\u0b4d\u0b1f \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b30\u0b39\u0b3f\u0b2c\u0b3e \u0b1c\u0b30\u0b41\u0b30\u0b40\u0964 \u0b2f\u0b26\u0b3f \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b19\u0b4d\u0b15 \u0b2a\u0b3e\u0b16\u0b30\u0b47 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b28\u0b3e\u0b39\u0b3f\u0b01, \u0b24\u0b47\u0b2c\u0b47 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b47 \u0b0f\u0b38\u0b4d\u0b0f\u0b2e\u0b4d\u0b0f\u0b38\u0b4d \u0b38\u0b30\u0b4d\u0b2d\u0b3f\u0b38\u0b4d \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b2c\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f\u0b4d (www.myaadhaar.uidai.gov.in) \u0b1c\u0b30\u0b3f\u0b06\u0b30\u0b47 \u0b0f\u0b39\u0b3f \u0b38\u0b41\u0b2c\u0b3f\u0b27\u0b3e \u0b2a\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964\n\u0b0f\u0b38\u0b4d\u0b0f\u0b2e\u0b4d\u0b0f\u0b38\u0b4d \u0b38\u0b47\u0b2c\u0b3e\u0964 GVID \u0b38\u0b4d\u0b25\u0b3e\u0b28 UID \u0b30 \u0b36\u0b47\u0b37 4 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e 8 \u0b05\u0b19\u0b4d\u0b15\u0964 1947\u0b15\u0b41 \u0b0f\u0b38\u0b4d\u0b0f\u0b2e\u0b4d\u0b0f\u0b38\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964 Ex-GVID 1234\u0964\n\u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b2c\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f\u0b4d https://resident.uidai.gov.in/aadhaar-lockunlock. \u0b15\u0b41 \u0b2f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 '\u0b2e\u0b4b \u0b06\u0b27\u0b3e\u0b30' \u0b1f\u0b4d\u0b5f\u0b3e\u0b2c\u0b4d \u0b24\u0b33\u0b47 '\u0b06\u0b27\u0b3e\u0b30 \u0b32\u0b15\u0b4d \u0b06\u0b23\u0b4d\u0b21\u0b4d \u0b05\u0b28\u0b4d\u0b32\u0b15\u0b4d \u0b38\u0b30\u0b4d\u0b2d\u0b3f\u0b38\u0b4d' \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f \u0b32\u0b15 \u0b30\u0b47\u0b21\u0b3f\u0b13 \u0b2c\u0b1f\u0b28\u0b15\u0b41 \u0b1a\u0b5f\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f \u0b28\u0b2e\u0b4d\u0b2c\u0b30, \u0b38\u0b2e\u0b4d\u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b28\u0b3e\u0b2e \u0b0f\u0b2c\u0b02 \u0b2a\u0b3f\u0b28 \u0b15\u0b4b\u0b21\u0b15\u0b41 \u0b38\u0b30\u0b4d\u0b2c\u0b36\u0b47\u0b37 \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40 \u0b05\u0b28\u0b41\u0b5f\u0b3e\u0b5f\u0b40 \u0b0f\u0b23\u0b4d\u0b1f\u0b30 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b38\u0b3f\u0b15\u0b4d\u0b5f\u0b41\u0b30\u0b3f\u0b1f\u0b3f \u0b15\u0b4b\u0b21 \u0b0f\u0b23\u0b4d\u0b1f\u0b30 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b38\u0b47\u0b23\u0b4d\u0b21\u0b4d \u0b13\u0b1f\u0b3f\u0b2a\u0b3f \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b3f \u0b38\u0b2c\u0b2e\u0b3f\u0b1f\u0b4d \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 UID \u0b15\u0b41 \u0b38\u0b2b\u0b33\u0b24\u0b3e\u0b30 \u0b38\u0b39\u0b3f\u0b24 \u0b2c\u0b28\u0b4d\u0b26 \u0b15\u0b30\u0b3f\u0b26\u0b3f\u0b06\u0b5f\u0b3f\u0b2c\u0964"},{question:"\u0b15\u0b47\u0b2e\u0b3f\u0b24\u0b3f \u0b15\u0b30\u0b3f\u0b2c\u0b47 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f \u0b05\u0b28\u0b4d\u0b32\u0b15\u0b4d?",answer:"\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f \u0b05\u0b28\u0b4d\u0b32\u0b15\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b19\u0b4d\u0b15 \u0b28\u0b3f\u0b15\u0b1f\u0b30\u0b47 \u0b38\u0b26\u0b4d\u0b5f\u0b24\u0b2e 16 \u0b05\u0b19\u0b4d\u0b15 \u0b2c\u0b3f\u0b36\u0b3f\u0b37\u0b4d\u0b1f \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b30\u0b39\u0b3f\u0b2c\u0b3e \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15 \u0b0f\u0b2c\u0b02 \u0b2f\u0b26\u0b3f \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e 16 \u0b05\u0b19\u0b4d\u0b15 \u0b2c\u0b3f\u0b36\u0b3f\u0b37\u0b4d\u0b1f \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2d\u0b41\u0b32\u0b3f \u0b2f\u0b3e\u0b07\u0b1b\u0b28\u0b4d\u0b24\u0b3f \u0b24\u0b47\u0b2c\u0b47 \u0b38\u0b47 \u0b0f\u0b38\u0b4d\u0b0f\u0b2e\u0b4d\u0b0f\u0b38\u0b4d \u0b38\u0b47\u0b2c\u0b3e \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b38\u0b26\u0b4d\u0b5f\u0b24\u0b2e \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b39\u0b3e\u0b38\u0b32 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\nRVID \u0b38\u0b4d\u0b25\u0b3e\u0b28 UID \u0b30 \u0b36\u0b47\u0b37 4 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e 8 \u0b05\u0b19\u0b4d\u0b15\u0964 1947 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b15\u0b41 \u0b2e\u0b47\u0b38\u0b47\u0b1c\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b0f\u0b15\u0b4d\u0b38- \u0b06\u0b30\u0b2d\u0b3f\u0b21\u0b4d 1234\n\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f \u0b05\u0b28\u0b32\u0b15 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01, \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b2c\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f\u0b4d https://resident.uidai.gov.in/aadhaar-lockunlock \u0b15\u0b41 \u0b2f\u0b3e\u0b07, \u0b05\u0b28\u0b32\u0b15 \u0b30\u0b47\u0b21\u0b3f\u0b13 \u0b2c\u0b1f\u0b28\u0b4d \u0b1a\u0b5f\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41, \u0b38\u0b30\u0b4d\u0b2c\u0b36\u0b47\u0b37 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b0f\u0b2c\u0b02 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b15\u0b4b\u0b21 \u0b26\u0b3f\u0b05\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b2a\u0b20\u0b3e\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b13\u0b1f\u0b3f\u0b2a\u0b3f \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b38\u0b2c\u0b2e\u0b3f\u0b1f \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b15\u0b41 \u0b38\u0b2b\u0b33\u0b24\u0b3e\u0b30 \u0b38\u0b39 \u0b16\u0b4b\u0b32\u0b3f \u0b26\u0b3f\u0b06\u0b5f\u0b3f\u0b2c\u0964\n\u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b2e\u0b3e\u0b28\u0b47 mAadhaar \u0b06\u0b2a\u0b4d \u0b1c\u0b30\u0b3f\u0b06\u0b30\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b32\u0b15 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b05\u0b28\u0b32\u0b15\u0b4d \u0b38\u0b47\u0b2c\u0b3e \u0b2e\u0b27\u0b4d\u0b5f \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964"}],grievanceAndFeedback:[],generateOrRetrieveVid:[{question:"\u0b2e\u0b41\u0b01 \u0b2e\u0b4b\u0b30 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2d\u0b41\u0b32\u0b3f\u0b5f\u0b3e\u0b07\u0b1b\u0b3f\u0964 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b15\u0b41 \u0b32\u0b15\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b30\u0b47 \u0b2e\u0b41\u0b01 \u0b0f\u0b39\u0b3e\u0b15\u0b41 \u0b15\u0b3f\u0b2a\u0b30\u0b3f \u0b2a\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b3f?",answer:"\u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f \u0b32\u0b15\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b30\u0b47 \u0b2f\u0b26\u0b3f \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2d\u0b41\u0b32\u0b3f\u0b2f\u0b3e\u0b06\u0b28\u0b4d\u0b24\u0b3f, \u0b24\u0b47\u0b2c\u0b47 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e \u0b67\u0b6c \u0b05\u0b19\u0b4d\u0b15 \u0b2c\u0b3f\u0b36\u0b3f\u0b37\u0b4d\u0b1f \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2a\u0b41\u0b28\u0b30\u0b41\u0b26\u0b4d\u0b27\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b0f\u0b38\u0b0f\u0b2e\u0b0f\u0b38 \u0b38\u0b47\u0b2c\u0b3e \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 | \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e \u0b24\u0b3e\u0b19\u0b4d\u0b15 \u0b2a\u0b1e\u0b4d\u0b1c\u0b40\u0b15\u0b43\u0b24 \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b30\u0b47 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2a\u0b3e\u0b07\u0b2c\u0b47 |\n\u0b06\u0b27\u0b3e\u0b30 \u0b30\u0b47\u0b1c\u0b3f\u0b37\u0b4d\u0b1f\u0b30 \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b30\u0b41 \u0b67\u0b6f\u0b6a\u0b6d\u0b15\u0b41 \u0b0f\u0b38\u0b0f\u0b2e\u0b0f\u0b38 \u0b2a\u0b20\u0b3e\u0b28\u0b4d\u0b24\u0b41,\n\u0b06\u0b30\u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b38\u0b4d\u0b2a\u0b47\u0b38\u0b4d \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b30 \u0b36\u0b47\u0b37 \u0b6a \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b6e \u0b05\u0b19\u0b4d\u0b15 \u0b2c\u0b3f\u0b36\u0b3f\u0b37\u0b4d\u0b1f \u0964\n\u0b09\u0b26\u0b3e\u0b39\u0b30\u0b23:- RVID 1234"},{question:"\u0b2d\u0b30\u0b4d\u0b1a\u0b41\u0b06\u0b32 \u0b06\u0b07\u0b21\u0b3f (\u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f) \u0b15'\u0b23?",answer:"\u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b39\u0b47\u0b09\u0b1b\u0b3f \u0b0f\u0b15 \u0b05\u0b38\u0b4d\u0b25\u0b3e\u0b5f\u0b40, \u0b2a\u0b41\u0b28\u0b30\u0b41\u0b26\u0b4d\u0b27\u0b3e\u0b30\u0b2f\u0b4b\u0b17\u0b4d\u0b5f \u0b67\u0b6c \u0b05\u0b19\u0b4d\u0b15 \u0b2c\u0b3f\u0b36\u0b3f\u0b37\u0b4d\u0b1f \u0b30\u0b3e\u0b23\u0b4d\u0b21\u0b2e\u0b4d \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2f\u0b3e\u0b39\u0b3e\u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b38\u0b39\u0b3f\u0b24 \u0b2e\u0b4d\u0b5f\u0b3e\u0b2a\u0b4d \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b1b\u0b3f \u0964 \u0b2a\u0b4d\u0b30\u0b2e\u0b3e\u0b23\u0b40\u0b15\u0b30\u0b23 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b07-\u0b15\u0b47\u0b71\u0b3e\u0b07\u0b38\u0b3f \u0b38\u0b47\u0b2c\u0b3e \u0b38\u0b2e\u0b4d\u0b2a\u0b3e\u0b26\u0b28 \u0b15\u0b30\u0b3e\u0b17\u0b32\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2c\u0b26\u0b33\u0b30\u0b47 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c \u0964 \u0b2a\u0b4d\u0b30\u0b2e\u0b3e\u0b23\u0b40\u0b15\u0b30\u0b23 VID \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f \u0b38\u0b2e\u0b3e\u0b28 \u0b22\u0b19\u0b4d\u0b17\u0b30\u0b47 \u0b38\u0b2e\u0b4d\u0b2a\u0b3e\u0b26\u0b28 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b47"},{question:"\u0b1c\u0b23\u0b47 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e \u0b15\u0b3f\u0b2a\u0b30\u0b3f \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2a\u0b4d\u0b30\u0b3e\u0b2a\u0b4d\u0b24 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b3f?",answer:"\u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b15\u0b47\u0b2c\u0b33 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b27\u0b3e\u0b30\u0b15\u0b19\u0b4d\u0b15 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c \u0964 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b47 \u0b38\u0b2e\u0b5f \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b30 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b15\u0b41 \u0b2c\u0b26\u0b33\u0b3e\u0b07 \u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 (\u0b0f\u0b15 \u0b28\u0b42\u0b24\u0b28 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47)\u0964 \u0b2f\u0b47\u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2a\u0b3e\u0b07\u0b01 \u0b15\u0b47\u0b2c\u0b33 \u0b17\u0b4b\u0b1f\u0b3f\u0b0f \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2c\u0b48\u0b27 \u0b39\u0b47\u0b2c\u0964 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b27\u0b3e\u0b30\u0b15\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b41 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b30 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b15\u0b30\u0b3f\u0b2c\u0b3e, \u0b2d\u0b41\u0b32\u0b3f\u0b17\u0b32\u0b47 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2a\u0b41\u0b28\u0b30\u0b41\u0b26\u0b4d\u0b27\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b0f\u0b2c\u0b02 \u0b38\u0b47\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f\u0b15\u0b41 \u0b0f\u0b15 \u0b28\u0b42\u0b24\u0b28 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b38\u0b39\u0b3f\u0b24 \u0b2c\u0b26\u0b33\u0b3e\u0b07\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b2c\u0b3f\u0b2d\u0b3f\u0b28\u0b4d\u0b28 \u0b2c\u0b3f\u0b15\u0b33\u0b4d\u0b2a \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b3f\u0b25\u0b3e\u0b0f \u0964 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07\u0b30 \u0b71\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f (www.myaadhaar.uidai.gov.in), \u0b07\u0b06\u0b27\u0b3e\u0b30 \u0b21\u0b3e\u0b09\u0b28\u0b32\u0b4b\u0b21, \u0b0f\u0b2e\u0b06\u0b27\u0b3e\u0b30 \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32 \u0b06\u0b2a\u0b4d\u0b32\u0b3f\u0b15\u0b47\u0b38\u0b28 \u0b07\u0b24\u0b4d\u0b5f\u0b3e\u0b26\u0b3f \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b0f\u0b39\u0b3f \u0b2c\u0b3f\u0b15\u0b33\u0b4d\u0b2a \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 \u0b39\u0b47\u0b2c \u0964\n\u0b06\u0b27\u0b3e\u0b30 \u0b39\u0b47\u0b32\u0b4d\u0b2a\u0b32\u0b3e\u0b07\u0b28 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b67\u0b6f\u0b6a\u0b6d\u0b15\u0b41 \u0b0f\u0b38\u0b0f\u0b2e\u0b0f\u0b38 \u0b2a\u0b20\u0b3e\u0b07 \u0b2e\u0b27\u0b4d\u0b5f \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b1c\u0b47\u0b28\u0b47\u0b30\u0b47\u0b1f \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c \u0964 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b19\u0b4d\u0b15\u0b41 '\u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b30 \u0b6a \u0b05\u0b19\u0b4d\u0b15' \u0b1f\u0b3e\u0b07\u0b2a\u0b4d \u0b15\u0b30\u0b3f \u0b2a\u0b1e\u0b4d\u0b1c\u0b40\u0b15\u0b43\u0b24 \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b67\u0b6f\u0b6a\u0b6d \u0b15\u0b41 \u0b2a\u0b20\u0b3e\u0b07\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b21\u0b3f\u0b2c \u0964"},{question:"\u0b05\u0b28\u0b4d\u0b5f \u0b15\u0b47\u0b39\u0b3f \u0b2e\u0b4b \u0b2a\u0b3e\u0b07\u0b01 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 \u0b15\u0b3f?",answer:"\u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b27\u0b3e\u0b30\u0b15\u0b19\u0b4d\u0b15 \u0b24\u0b30\u0b2b\u0b30\u0b41 \u0b0f\u0b5f\u0b41\u0b0f/\u0b15\u0b47\u0b5f\u0b41\u0b0f \u0b2d\u0b33\u0b3f \u0b05\u0b28\u0b4d\u0b5f \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b38\u0b02\u0b38\u0b4d\u0b25\u0b3e \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b27\u0b3e\u0b30\u0b15 \u0b15\u0b47\u0b2c\u0b33 \u0b28\u0b3f\u0b1c\u0b47 \u0b39\u0b3f\u0b01 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 \u0964 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b27\u0b3e\u0b30\u0b15 \u0b2a\u0b1e\u0b4d\u0b1c\u0b40\u0b15\u0b43\u0b24 \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b30\u0b47 \u0b0f\u0b38\u0b0f\u0b2e\u0b0f\u0b38 \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2a\u0b3e\u0b07\u0b2c\u0b47 \u0964"},{question:"\u0b2f\u0b26\u0b3f \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b27\u0b3e\u0b30\u0b15 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2d\u0b41\u0b32\u0b3f \u0b2f\u0b3e\u0b07\u0b1b\u0b28\u0b4d\u0b24\u0b3f \u0b24\u0b47\u0b2c\u0b47 \u0b15'\u0b23 \u0b39\u0b47\u0b2c? \u0b38\u0b47 \u0b2a\u0b41\u0b28\u0b30\u0b4d\u0b2c\u0b3e\u0b30 \u0b2a\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 \u0b15\u0b3f?",answer:"\u0b39\u0b01, \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07 \u0b28\u0b42\u0b24\u0b28 \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b0f\u0b2c\u0b02 / \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2c\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b2e\u0b3e\u0b28\u0b30 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f\u0b15\u0b41 \u0b09\u0b26\u0b4d\u0b27\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b0f\u0b15\u0b3e\u0b27\u0b3f\u0b15 \u0b09\u0b2a\u0b3e\u0b5f \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b47\u0964 \u0b5f\u0b41\u0b06\u0b07\u0b21\u0b3f\u0b0f\u0b06\u0b07\u0b30 \u0b2c\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f (www.myaadhaar.uidai.gov.in), eAadhaar, mAadhaar \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32 \u0b06\u0b2a\u0b4d\u0b32\u0b3f\u0b15\u0b47\u0b38\u0b28\u0b4d, \u0b0f\u0b38\u0b4d\u0b0f\u0b2e\u0b4d\u0b0f\u0b38\u0b4d \u0b06\u0b26\u0b3f \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b0f\u0b39\u0b3f \u0b2c\u0b3f\u0b15\u0b33\u0b4d\u0b2a\u0b17\u0b41\u0b5c\u0b3f\u0b15 \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 \u0b39\u0b47\u0b09\u0b1b\u0b3f\u0964"},{question:"OTP \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2c\u0b3e\u0b5f\u0b4b\u0b2e\u0b47\u0b1f\u0b4d\u0b30\u0b3f\u0b15\u0b4d\u0b38 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b21\u0b47\u0b2e\u0b4b\u0b17\u0b4d\u0b30\u0b3e\u0b2b\u0b3f\u0b15\u0b4d\u0b38 \u0b2a\u0b4d\u0b30\u0b2e\u0b3e\u0b23\u0b40\u0b15\u0b30\u0b23 \u0b2a\u0b3e\u0b07\u0b01 VID \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3e\u0b5f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c \u0b15\u0b3f?",answer:"\u0b39\u0b01\u0964 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2c\u0b26\u0b33\u0b30\u0b47 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f \u0b06\u0b27\u0b3e\u0b30 \u0b05\u0b25\u0b47\u0b23\u0b4d\u0b1f\u0b3f\u0b15\u0b47\u0b38\u0b28 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964"},{question:"VID \u0b15\u0b4d\u0b37\u0b47\u0b24\u0b4d\u0b30\u0b30\u0b47, \u0b2a\u0b4d\u0b30\u0b2e\u0b3e\u0b23\u0b40\u0b15\u0b30\u0b23 \u0b2a\u0b3e\u0b07\u0b01 \u0b2e\u0b4b\u0b24\u0b47 \u0b38\u0b2e\u0b4d\u0b2e\u0b24\u0b3f \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b21\u0b3f\u0b2c \u0b15\u0b3f?",answer:"\u0b39\u0b01, \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b06\u0b27\u0b3e\u0b30\u0b3f\u0b24 \u0b2a\u0b4d\u0b30\u0b2e\u0b3e\u0b23\u0b40\u0b15\u0b30\u0b23 \u0b2a\u0b3e\u0b07\u0b01 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b27\u0b3e\u0b30\u0b40\u0b19\u0b4d\u0b15 \u0b38\u0b39\u0b2e\u0b24\u0b3f \u0b1c\u0b30\u0b41\u0b30\u0b40\u0964 \u0b0f\u0b1c\u0b47\u0b28\u0b4d\u0b38\u0b3f \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b27\u0b3e\u0b30\u0b15\u0b19\u0b4d\u0b15\u0b41 \u0b2a\u0b4d\u0b30\u0b2e\u0b3e\u0b23\u0b40\u0b15\u0b30\u0b23\u0b30 \u0b09\u0b26\u0b4d\u0b26\u0b47\u0b36\u0b4d\u0b5f \u0b2c\u0b3f\u0b37\u0b5f\u0b30\u0b47 \u0b38\u0b42\u0b1a\u0b28\u0b3e \u0b26\u0b47\u0b2c\u0b3e \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15 \u0b0f\u0b2c\u0b02 \u0b2a\u0b4d\u0b30\u0b2e\u0b3e\u0b23\u0b40\u0b15\u0b30\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b4d\u0b2a\u0b37\u0b4d\u0b1f \u0b38\u0b2e\u0b4d\u0b2e\u0b24\u0b3f \u0b38\u0b19\u0b4d\u0b17\u0b4d\u0b30\u0b39 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15\u0964"},{question:"\u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b0f\u0b1c\u0b47\u0b28\u0b4d\u0b38\u0b3f \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b37\u0b4d\u0b1f\u0b4b\u0b30 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c \u0b15\u0b3f?",answer:"\u0b28\u0b3e\u0964 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b05\u0b38\u0b4d\u0b25\u0b3e\u0b5f\u0b40 \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e\u0b30\u0b41 \u0b0f\u0b2c\u0b02 \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b27\u0b3e\u0b30\u0b40 \u0b0f\u0b39\u0b3e\u0b15\u0b41 \u0b2c\u0b26\u0b33\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47, \u0b24\u0b47\u0b23\u0b41 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f\u0b15\u0b41 \u0b37\u0b4d\u0b1f\u0b4b\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b30 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2e\u0b42\u0b32\u0b4d\u0b5f \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 \u0b0f\u0b1c\u0b47\u0b28\u0b4d\u0b38\u0b3f\u0b2e\u0b3e\u0b28\u0b47 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f\u0b15\u0b41 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b21\u0b3e\u0b1f\u0b3e\u0b2c\u0b47\u0b38\u0b4d \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b32\u0b17\u0b30\u0b47 \u0b37\u0b4d\u0b1f\u0b4b\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b09\u0b1a\u0b3f\u0b24 \u0b28\u0b41\u0b39\u0b47\u0b01\u0964"},{question:"\u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f\u0b30 \u0b2a\u0b41\u0b28\u0b03 \u0b09\u0b24\u0b4d\u0b2a\u0b3e\u0b26\u0b28 \u0b38\u0b2e\u0b3e\u0b28 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2d\u0b3f\u0b28\u0b4d\u0b28 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f\u0b15\u0b41 \u0b28\u0b47\u0b07\u0b5f\u0b3f\u0b2c \u0b15\u0b3f?",answer:"\u0b38\u0b30\u0b4d\u0b2c\u0b28\u0b3f\u0b2e\u0b4d\u0b28 \u0b2c\u0b48\u0b27\u0b24\u0b3e \u0b05\u0b2c\u0b27\u0b3f \u0b2a\u0b30\u0b47 (\u0b2c\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b2e\u0b3e\u0b28 1 \u0b15\u0b4d\u0b5f\u0b3e\u0b32\u0b47\u0b23\u0b4d\u0b21\u0b30 \u0b26\u0b3f\u0b28 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2e\u0b27\u0b4d\u0b5f\u0b30\u0b3e\u0b24\u0b4d\u0b30\u0b3f 12 \u0b2a\u0b30\u0b47) \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b27\u0b3e\u0b30\u0b40 \u0b0f\u0b15 \u0b28\u0b42\u0b24\u0b28 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f\u0b30 \u0b2a\u0b41\u0b28\u0b30\u0b41\u0b26\u0b4d\u0b27\u0b3e\u0b30 \u0b2a\u0b3e\u0b07\u0b01 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964 \u0b0f\u0b39\u0b3f \u0b09\u0b2a\u0b3e\u0b5f\u0b30\u0b47 \u0b28\u0b42\u0b06 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b39\u0b47\u0b2c \u0b0f\u0b2c\u0b02 \u0b2a\u0b42\u0b30\u0b4d\u0b2c \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b28\u0b3f\u0b37\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b5f \u0b39\u0b4b\u0b07\u0b2f\u0b3f\u0b2c \u0964\n\u0b2f\u0b26\u0b3f \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e \u0b2e\u0b3e\u0b28\u0b47 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2a\u0b41\u0b28\u0b30\u0b41\u0b26\u0b4d\u0b27\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b38\u0b28\u0b4d\u0b26 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b3f, \u0b24\u0b47\u0b2c\u0b47 \u0b36\u0b47\u0b37 \u0b38\u0b15\u0b4d\u0b30\u0b3f\u0b5f \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b27\u0b3e\u0b30\u0b15\u0b19\u0b4d\u0b15\u0b41 \u0b0f\u0b38\u0b0f\u0b2e\u0b0f\u0b38 \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b2a\u0b20\u0b3e\u0b2f\u0b3f\u0b2c \u0964 \u0b2c\u0b3e\u0b38\u0b3f\u0b28\u0b4d\u0b26\u0b3e\u0b19\u0b4d\u0b15\u0b41 '\u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30\u0b30 \u0b6a \u0b05\u0b19\u0b4d\u0b15' \u0b1f\u0b3e\u0b07\u0b2a\u0b4d \u0b15\u0b30\u0b3f \u0b2a\u0b1e\u0b4d\u0b1c\u0b40\u0b15\u0b43\u0b24 \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b67\u0b6f\u0b6a\u0b6d \u0b15\u0b41 \u0b2a\u0b20\u0b3e\u0b07\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b21\u0b3f\u0b2c \u0964"}],checkGrievanceFeedbackStatus:[{question:"\u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f\u0b30 \u0b38\u0b2e\u0b3e\u0b2a\u0b4d\u0b24\u0b3f \u0b05\u0b2c\u0b27\u0b3f \u0b15'\u0b23?",answer:"\u0b0f\u0b39\u0b3f \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2a\u0b3e\u0b07\u0b01 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b05\u0b2c\u0b27\u0b3f \u0b28\u0b3f\u0b30\u0b4d\u0b26\u0b4d\u0b27\u0b3e\u0b30\u0b23 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b28\u0b3e\u0b39\u0b3f\u0b01 | \u0b06\u0b27\u0b3e\u0b30 \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b27\u0b3e\u0b30\u0b15\u0b19\u0b4d\u0b15 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b28\u0b42\u0b24\u0b28 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b39\u0b47\u0b2c\u0b3e \u0b2a\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b28\u0b4d\u0b24 \u0b2d\u0b3f\u0b06\u0b07\u0b21\u0b3f \u0b2c\u0b48\u0b27 \u0b30\u0b39\u0b3f\u0b2c |"}]}}},pa_IN:{translation:{dashboard:{header:{title:"\u0a2e\u0a47\u0a30\u0a3e \u0a06\u0a27\u0a3e\u0a30",profile:{aadhaarTagLine:"\u0a2e\u0a47\u0a30\u0a3e \u0a05\u0a27\u0a3e\u0a30, \u0a2e\u0a47\u0a30\u0a40 \u0a2a\u0a1b\u0a3e\u0a23",clickToFlip:"\u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a3e\u0a30\u0a21 \u0a2b\u0a32\u0a3f\u0a71\u0a2a \u0a15\u0a30\u0a4b",logOut:"\u0a32\u0a3e\u0a71\u0a17 \u0a06\u0a0a\u0a1f"}},services:{title:"\u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02",description:"\u0a06\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a3e \u0a39\u0a47\u0a20\u0a32\u0a3e \u0a17\u0a41\u0a32\u0a26\u0a38\u0a24\u0a3e \u0a10\u0a15\u0a38\u0a48\u0a38 \u0a32\u0a08 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a39\u0a48\u0964 \u0a38\u0a47\u0a35\u0a3e-\u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c \u0a2a\u0a70\u0a28\u0a47 \u0a24\u0a47 \u0a1c\u0a3e\u0a23 \u0a32\u0a08 \u0a1f\u0a48\u0a2c \u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a15 \u0a15\u0a30\u0a4b",serviceCards:{downloadAadhaar:{title:"\u0a21\u0a3e\u0a0a\u0a28\u0a32\u0a4b\u0a21 \u0a06\u0a27\u0a3e\u0a30",description:"\u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a40 \u0a21\u0a3f\u0a1c\u0a40\u0a1f\u0a32 \u0a26\u0a38\u0a24\u0a16\u0a24 \u0a15\u0a40\u0a24\u0a47 \u0a05\u0a24\u0a47 \u0a2a\u0a3e\u0a38\u0a35\u0a30\u0a21 \u0a28\u0a3e\u0a32 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a05\u0a24 \u0a07\u0a32\u0a48\u0a15\u0a1f\u0a4d\u0a30\u0a3e\u0a28\u0a3f\u0a15 \u0a15\u0a3e\u0a71\u0a2a\u0a40 \u0a21\u0a3e\u0a09\u0a28\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b"},orderPVC:{title:"\u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21 \u0a06\u0a30\u0a21\u0a30 \u0a15\u0a30\u0a4b",description:"\u0a07\u0a71\u0a15 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a05\u0a24, \u0a35\u0a3e\u0a32\u0a3f\u0a1f-\u0a05\u0a15\u0a3e\u0a30 \u0a26\u0a3e \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a3e\u0a30\u0a21 \u0a06\u0a30\u0a21\u0a30 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b"},updateAadhaarOnline:{updateAadhaarOnline:"\u0a06\u0a27\u0a3e\u0a30 \u0a06\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a4b",updateAadhaar:"\u0a06\u0a27\u0a3e\u0a30 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a4b",headerTitle:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a06\u0a27\u0a3e\u0a30 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a26\u0a40 \u0a15\u0a3f\u0a38\u0a2e \u0a1a\u0a41\u0a23\u0a4b",title:"\u0a2a\u0a24\u0a3e \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f",description:"\u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a3e \u0a2a\u0a24\u0a3e \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964 \u0a15\u0a3f\u0a38\u0a47 \u0a39\u0a4b\u0a30 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08, \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a28\u0a1c\u0a3c\u0a26\u0a40\u0a15\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30 '\u0a24\u0a47 \u0a1c\u0a3e\u0a13"},bankLinkingStatus:{title:"\u0a2c\u0a48\u0a02\u0a15 \u0a32\u0a3f\u0a70\u0a15\u0a3f\u0a70\u0a17 \u0a38\u0a25\u0a3f\u0a24\u0a40",description:"\u0a06\u0a27\u0a3e\u0a30 \u0a05\u0a24\u0a47 \u0a2c\u0a48\u0a02\u0a15 \u0a16\u0a3e\u0a24\u0a47 \u0a28\u0a42\u0a70 \u0a1c\u0a4b\u0a5c\u0a28 \u0a26\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b"},generateVirtualID:{title:"\u0a35\u0a30\u0a1a\u0a41\u0a05\u0a32 \u0a06\u0a08\u0a21\u0a40 \u0a24\u0a3f\u0a06\u0a30 \u0a15\u0a30\u0a4b",description:"\u0a35\u0a30\u0a1a\u0a41\u0a05\u0a32 \u0a06\u0a08