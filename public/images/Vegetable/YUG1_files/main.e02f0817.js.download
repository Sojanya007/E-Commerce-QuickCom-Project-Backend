0995\u09cd\u09a4\u09bf \u098f\u09ac\u0982 \u0986\u09aa\u09a1\u09c7\u099f \u099a\u09be\u09b0\u09cd\u099c",AadhaarEnrolmentUpdateChargesForm:"\u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf \u098f\u09ac\u0982 \u0986\u09aa\u09a1\u09c7\u099f \u09ab\u09b0\u09cd\u09ae",ListofDocs:"\u0986\u09a7\u09be\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf \u098f\u09ac\u0982 \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09b9\u09be\u09af\u09bc\u0995 \u09a8\u09a5\u09bf\u0997\u09c1\u09b2\u09bf\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09f7",serviceCards:{downloadAadhaar:{title:"\u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0986\u09a7\u09be\u09b0",description:"\u09a1\u09bf\u099c\u09bf\u099f\u09be\u09b2\u09bf \u09b8\u09cd\u09ac\u09be\u0995\u09cd\u09b7\u09b0\u09bf\u09a4 \u098f\u09ac\u0982 \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09bf\u09a4 \u0986\u09a7\u09be\u09b0\u09c7\u09b0 \u09ac\u09c8\u09a6\u09cd\u09af\u09c1\u09a4\u09bf\u09a8 \u0985\u09a8\u09c1\u09b2\u09bf\u09aa\u09bf \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},orderPVC:{title:"\u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0986\u09a7\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1",description:"\u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09bf\u09a4, \u09ae\u09be\u09a8\u09bf\u09ac\u09cd\u09af\u09be\u0997\u09c7\u09b0 \u0986\u0995\u09be\u09b0\u09c7\u09b0 \u0986\u09a7\u09be\u09b0 \u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0995\u09be\u09b0\u09cd\u09a1 \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},retrieveEID:{title:"\u0987\u0986\u0987\u09a1\u09bf / \u0986\u09a7\u09be\u09f0 \u09a8\u09ae\u09cd\u09ac\u09f0 \u0989\u09a6\u09cd\u09a7\u09be\u09f0 \u0995\u09f0\u0995",description:"\u0986\u09a7\u09be\u09f0 \u09a8\u09ae\u09cd\u09ac\u09f0 \u09ac\u09be \u09a8\u09be\u09ae\u09ad\u09f0\u09cd\u09a4\u09bf \u0986\u0987\u09a1\u09bf (\u0987\u0986\u0987\u09a1\u09bf) \u099c\u09be\u09a8\u09bf\u09ac\u09b2\u09c8 \u0987\u09af\u09bc\u09be\u09a4 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09f0\u0995\u0964"},verifyMobile:{title:"\u0987\u09ae\u09c7\u09b2 / \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8",description:"\u0986\u09a7\u09be\u09b0\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u098f\u09ac\u0982 \u0987\u09ae\u09c7\u09b2 \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},checkAadhaarValidity:{title:"\u0986\u09a7\u09be\u09b0 \u09ac\u09c8\u09a7\u09a4\u09be \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8",description:"\u0986\u09a7\u09be\u09b0 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09be\u09b8 \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\u0964"},orderPVCStatus:{title:"\u0986\u09a7\u09be\u09b0 \u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0995\u09be\u09b0\u09cd\u09a1 \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8",description:"\u0987\u09a4\u09bf\u09ae\u09a7\u09cd\u09af\u09c7 \u0986\u09a6\u09c7\u09b6 \u0995\u09b0\u09be \u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0995\u09be\u09b0\u09cd\u09a1\u09c7\u09b0 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},enrolmentAndUpdateStatus:{title:"\u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf \u098f\u09ac\u0982 \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8",description:"\u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf \u09ac\u09be \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u09c7\u09b0 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},bookAppointment:{title:"\u0985\u09cd\u09af\u09be\u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09ae\u09c7\u09a8\u09cd\u099f \u09ac\u09c1\u0995 \u0995\u09b0\u09c1\u09a8",description:"\u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf \u09ac\u09be \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09cd\u09af\u09be\u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09ae\u09c7\u09a8\u09cd\u099f \u09ac\u09c1\u0995 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},vidGenerator:{title:"\u09ad\u09bf\u0986\u0987\u09a1\u09bf \u099c\u09c7\u09a8\u09be\u09b0\u09c7\u099f\u09b0",description:"\u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u0982\u09af\u09c1\u0995\u09cd\u09a4 \u09e7\u09ec \u0985\u0999\u09cd\u0995\u09c7\u09b0 \u09ad\u09be\u09b0\u09cd\u099a\u09c1\u09af\u09bc\u09be\u09b2 \u0986\u0987\u09a1\u09bf (\u09ad\u09bf\u0986\u0987\u09a1\u09bf) \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},lec:{title:"\u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u09c7\u09b0 \u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0995\u09b0\u09c1\u09a8",description:"\u09a8\u09bf\u0995\u099f\u09b8\u09cd\u09a5 \u0986\u09a7\u09be\u09b0 \u09b8\u09c7\u09ac\u09be \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u0997\u09c1\u09b2\u09bf \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u098f\u09ac\u0982 \u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},lockUnlockAadhaar:{title:"\u09b2\u0995 / \u0986\u09a8\u09b2\u0995 \u0986\u09a7\u09be\u09b0",description:"\u0985\u09b8\u09cd\u09a5\u09be\u09af\u09bc\u09c0\u09ad\u09be\u09ac\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0\u099f\u09bf\u0995\u09c7 \u09b2\u0995 / \u0986\u09a8\u09b2\u0995 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\u0964 \u098f\u0987 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u099f\u09bf \u09b8\u09be\u09ac\u09a7\u09be\u09a8\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8"},complaintStatus:{title:"\u0985\u09ad\u09bf\u09af\u09cb\u0997/\u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u09b0 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8",description:"\u0985\u09ad\u09bf\u09af\u09cb\u0997/\u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u09b0 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},fileComplaint:{title:"\u0985\u09ad\u09bf\u09af\u09cb\u0997 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be",description:"\u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09ad\u09bf\u09af\u09cb\u0997 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09ab\u09be\u0987\u09b2 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"}}}},documentUpdate:{intentPage:{title:"\u09a1\u0995\u09c1\u09ae\u09c7\u09a8\u09cd\u099f \u0986\u09aa\u09a1\u09c7\u099f \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af",p1:"\u09aa\u09cd\u09b0\u09bf\u09af\u09bc \u09ac\u09be\u09b8\u09bf\u09a8\u09cd\u09a6\u09be,",p2:"\u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09aa\u09cd\u09b0\u09c1\u09ab \u0985\u09ab \u0986\u0987\u09a1\u09c7\u09a8\u09cd\u099f\u09bf\u099f\u09bf (POI) \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09c1\u09ab \u0985\u09ab \u0985\u09cd\u09af\u09be\u09a1\u09cd\u09b0\u09c7\u09b8 (POA) \u09a8\u09a5\u09bf \u099c\u09ae\u09be \u09a6\u09bf\u09af\u09bc\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0 \u09a1\u09be\u099f\u09be\u09ac\u09c7\u09b8\u09c7 \u09a8\u09a5\u09bf \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0\u0995\u09c7 \u09b6\u0995\u09cd\u09a4\u09bf\u09b6\u09be\u09b2\u09c0 \u0995\u09b0\u09be\u09b0 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u099a\u09cd\u099b\u09c7\u09f7 POI/POA \u09a8\u09a5\u09bf\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3 \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0\u09c7 \u0989\u09b2\u09cd\u09b2\u09bf\u0996\u09bf\u09a4 \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ae\u09c7\u09b2\u09c7\u0964 \u098f\u099f\u09bf \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0986\u09a7\u09be\u09b0 \u09a1\u09be\u099f\u09be\u09ac\u09c7\u09b8\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09a4\u09a5\u09cd\u09af\u09c7\u09b0 \u0995\u09cd\u09b0\u09ae\u09be\u0997\u09a4 \u09a8\u09bf\u09b0\u09cd\u09ad\u09c1\u09b2\u09a4\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09a4\u09c7 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0995\u09b0\u09ac\u09c7\u0964",p3:"\u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u0987\u09a4\u09bf\u09ae\u09a7\u09cd\u09af\u09c7\u0987 \u0995\u09cb\u09a8\u0993 \u0986\u09a7\u09be\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09ac\u09be myAadhaar \u09aa\u09cb\u09b0\u09cd\u099f\u09be\u09b2\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09a8\u09a5\u09bf\u0997\u09c1\u09b2\u09bf \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09c7 \u09a5\u09be\u0995\u09c7\u09a8 \u09a4\u09ac\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u098f\u099f\u09bf\u09b0 \u0997\u09cd\u09b0\u09b9\u09a3\u09af\u09cb\u0997\u09cd\u09af\u09a4\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8 \u09ac\u09be \u0985\u09a8\u09cd\u09af\u09a5\u09be\u09af\u09bc\u09f7 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u0996\u09cd\u09af\u09be\u09a8\u09c7\u09b0 \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09c7, \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0986\u09ac\u09be\u09b0 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964",p4:"\u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0\u09c7 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8, \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7",p5:"\u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8.",p6:"\u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u09b0 \u099c\u09a8\u09cd\u09af 25/- \u099f\u09be\u0995\u09be \u09a8\u09be\u09ae\u09ae\u09be\u09a4\u09cd\u09b0 \u099a\u09be\u09b0\u09cd\u099c \u09a6\u09bf\u09a4\u09c7 \u09b9\u09ac\u09c7, \u09af\u09be \u09ab\u09c7\u09b0\u09a4\u09af\u09cb\u0997\u09cd\u09af \u09a8\u09af\u09bc\u0964",p7:"\u098f\u0987 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u099f\u09bf 14/06/2025 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09ac\u09bf\u09a8\u09be\u09ae\u09c2\u09b2\u09cd\u09af\u09c7"},howItWorks:{description:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09a8\u09bf\u099a\u09c7\u09b0 \u09a7\u09be\u09aa\u0997\u09c1\u09b2\u09cb \u09b8\u09be\u09ac\u09a7\u09be\u09a8\u09c7 \u09aa\u09a1\u09bc\u09c1\u09a8\u0964 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u09c7\u09b0 \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u0995\u09b0\u09a3 \u09ac\u09be \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u0996\u09cd\u09af\u09be\u09a8\u09c7 \u0995\u09cb\u09a8\u09cb \u09ac\u09bf\u09b2\u09ae\u09cd\u09ac \u098f\u09a1\u09bc\u09be\u09a4\u09c7 \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09a7\u09be\u09aa\u09c7 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09be\u09ac\u09bf\u09a4 \u09aa\u09a6\u0995\u09cd\u09b7\u09c7\u09aa\u0997\u09c1\u09b2\u09bf \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09c1\u09a8\u0964 \u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0\u09c7 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8, \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7",stepDescription:{one:"\u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09b0\u09bf\u099a\u09df\u09c7\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a8 (\u09aa\u09bf\u0993\u0986\u0987) \u098f\u09ac\u0982 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a8  (\u09aa\u09bf\u0993\u098f) \u09a1\u0995\u09c1\u09ae\u09c7\u09a8\u09cd\u099f \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\u09f7",two:"\u098f\u0987 \u09a7\u09be\u09aa\u09c7, \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09ac\u09c8\u09a7 \u09aa\u09bf\u0993\u0986\u0987 /\u09aa\u09bf\u0993\u098f \u09a8\u09a5\u09bf\u0997\u09c1\u09b2\u09bf \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09a4\u09c7 \u09ac\u09b2\u09be \u09b9\u09ac\u09c7 \u09af\u09be\u09a4\u09c7 \u09a7\u09be\u09aa \u09e7-\u098f \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u09b9\u0993\u09af\u09bc\u09be \u09af\u09be\u099a\u09be\u0987\u0995\u09c3\u09a4 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964",three:"\u098f\u0987 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u20b9 \u09e8\u09eb (\u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09aa\u0981\u099a\u09bf\u09b6 \u099f\u09be\u0995\u09be) \u09a6\u09bf\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u0986\u09aa\u09a8\u09bf \u0995\u09cd\u09b0\u09c7\u09a1\u09bf\u099f/\u09a1\u09c7\u09ac\u09bf\u099f \u0995\u09be\u09b0\u09cd\u09a1 \u09ac\u09be \u09a8\u09c7\u099f \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995\u09bf\u0982\u09af\u09bc\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0985\u09b0\u09cd\u09a5\u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u098f\u0987 \u0985\u09b0\u09cd\u09a5 \u0985 \u09ab\u09c7\u09b0\u09a4\u09af\u09cb\u0997\u09cd\u09af."},note:"\u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09a4\u09be\u09a4\u09cd\u09a4\u09cd\u09ac\u09bf\u0995 \u09ac\u09bf\u09ac\u09b0\u09a3 (\u09a8\u09be\u09ae, \u099c\u09a8\u09cd\u09ae\u09a4\u09bf\u09a5\u09bf, \u09b2\u09bf\u0999\u09cd\u0997 \u09ac\u09be \u09a0\u09bf\u0995\u09be\u09a8\u09be) \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8 \u09a4\u09ac\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09bf\u09b6\u09a6 ",noteLink:"\u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09c1\u09a8\u0964"},currentSection:{form:{title:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09a4\u09be\u09a4\u09cd\u09a4\u09cd\u09ac\u09bf\u0995 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8",name:"\u09a8\u09be\u09ae",gender:"\u09b2\u09bf\u0999\u09cd\u0997",dob:"\u099c\u09a8\u09cd\u09ae \u09a4\u09be\u09b0\u09bf\u0996",address:"\u09a0\u09bf\u0995\u09be\u09a8\u09be",consent:"\u0986\u09ae\u09bf \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09bf\u09a4 \u0995\u09b0\u099b\u09bf \u09af\u09c7 \u0989\u09aa\u09b0\u09cb\u0995\u09cd\u09a4  \u09ac\u09bf\u09ac\u09b0\u09a3 \u09b8\u09a0\u09bf\u0995\u0964"},note:"\u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09cb\u09a8\u09cb \u09ac\u09bf\u09ac\u09b0\u09a3\u09c7 \u0985\u09ae\u09bf\u09b2 \u09a5\u09be\u0995\u09c7, \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09b8\u0982\u0996\u09cd\u09af\u09be\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3 (\u09a8\u09be\u09ae, \u09a0\u09bf\u0995\u09be\u09a8\u09be, DoB \u09ac\u09be \u09b2\u09bf\u0999\u09cd\u0997) \u098f\u0996\u09be\u09a8\u09c7 ",noteLink:"\u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09c1\u09a8\u0964"},uploadSection:{confirmationPopUp:{title:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09a8\u09a5\u09bf\u09a4\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09a4\u09be\u09a4\u09cd\u09a4\u09cd\u09ac\u09bf\u0995 \u09ac\u09bf\u09ac\u09b0\u09a3 \u0986\u09a7\u09be\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09a4\u09be\u09a4\u09cd\u09a4\u09cd\u09ac\u09bf\u0995 \u09ac\u09bf\u09ac\u09b0\u09a3\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b9\u09c1\u09ac\u09b9\u09c1 \u09ae\u09bf\u09b2\u09c7 \u09af\u09be\u09af\u09bc \u09a4\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8\u09f7"},stepper:{verify:"\u09af\u09be\u099a\u09be\u0987",upload:"\u0986\u09aa\u09b2\u09cb\u09a1"},guidelines:{title:"\u09a8\u09a5\u09bf \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09bf\u0995\u09be",l1:"\u09a8\u09a5\u09bf\u09b0 \u0986\u0995\u09be\u09b0 2 MB \u098f\u09b0 \u09a5\u09c7\u0995\u09c7 \u0995\u09ae \u09b9\u0993\u09af\u09bc\u09be \u0989\u099a\u09bf\u09a4",l2:"\u09b8\u09ae\u09b0\u09cd\u09a5\u09bf\u09a4 \u09ab\u09be\u0987\u09b2 \u09ab\u09b0\u09ae\u09cd\u09af\u09be\u099f\u0997\u09c1\u09b2\u09bf \u09b9\u09b2: <b>JPEG, PNG</b> \u098f\u09ac\u0982 <b>PDF</b>"},form:{poiTitle:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09aa\u09b0\u09bf\u099a\u09df\u09c7\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a8 (\u09aa\u09bf\u0993\u0986\u0987) \u09a1\u0995\u09c1\u09ae\u09c7\u09a8\u09cd\u099f \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8",poaTitle:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a8 (\u09aa\u09bf\u0993\u098f) \u09a1\u0995\u09c1\u09ae\u09c7\u09a8\u09cd\u099f \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8"},consent:"\u0986\u09ae\u09bf \u098f\u09a4\u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0986\u09ae\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u09a6\u09bf\u099a\u09cd\u099b\u09bf \u09af\u09c7 \u0986\u09ae\u09be\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09aa\u09cd\u09b0\u09a6\u09a4\u09cd\u09a4/\u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u09a4\u09a5\u09cd\u09af/\u09a6\u09b8\u09cd\u09a4\u09be\u09ac\u09c7\u099c \u09b8\u09b0\u0995\u09be\u09b0 \u09af\u09c7 \u0995\u09cb\u09a8\u09cb \u09aa\u09b0\u09cd\u09af\u09be\u09af\u09bc\u09c7 \u09af\u09be\u099a\u09be\u0987-\u09ac\u09be\u099b\u09be\u0987 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964"},faq:{card:{heading:"\u09a1\u0995\u09c1\u09ae\u09c7\u09a8\u09cd\u099f \u0986\u09aa\u09a1\u09c7\u099f",description_1:"",description_2:""},guidelines:{heading_1:"\u09aa\u09b0\u09bf\u099a\u09af\u09bc \u098f\u09ac\u0982 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09b8\u09ae\u09b0\u09cd\u09a5\u09bf\u09a4 \u09a8\u09a5\u09bf\u09aa\u09a4\u09cd\u09b0 \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8",heading_2:"14/06/2025 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09ac\u09bf\u09a8\u09be\u09ae\u09c2\u09b2\u09cd\u09af\u09c7",question_1:{title:"\u0995\u09bf \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u09b9\u09ac\u09c7?",content:{line_1:"\u09b0\u09c7\u09b6\u09a8 \u0995\u09be\u09b0\u09cd\u09a1, \u09ad\u09cb\u099f\u09be\u09b0 \u0986\u0987\u09a1\u09c7\u09a8\u09cd\u099f\u09bf\u099f\u09bf \u0995\u09be\u09b0\u09cd\u09a1, \u09b8\u09b0\u0995\u09be\u09b0 \u0995\u09b0\u09cd\u09a4\u09c3\u0995 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09a8\u09bf\u09b0\u09cd\u0997\u09a4 \u0995\u09b0\u09be \u09aa\u09b0\u09bf\u099a\u09af\u09bc\u09aa\u09a4\u09cd\u09b0/ \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09b8\u09ae\u09cd\u09ac\u09b2\u09bf\u09a4 \u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0 \u098f\u09ac\u0982 \u09ad\u09be\u09b0\u09a4\u09c0\u09af\u09bc \u09aa\u09be\u09b8\u09aa\u09cb\u09b0\u09cd\u099f, \u09aa\u09b0\u09bf\u099a\u09af\u09bc \u098f\u09ac\u0982 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u0989\u09ad\u09af\u09bc\u09c7\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09c7\u0964",line_2:"\u09aa\u09cd\u09af\u09be\u09a8 \u0995\u09be\u09b0\u09cd\u09a1, \u09a1\u09cd\u09b0\u09be\u0987\u09ad\u09bf\u0982 \u09b2\u09be\u0987\u09b8\u09c7\u09a8\u09cd\u09b8, \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09bf\u0995 \u09ac\u09be \u09b8\u09bf\u09a8\u09bf\u09af\u09bc\u09b0 \u09b8\u09cd\u0995\u09c1\u09b2\u09c7\u09b0 \u09ae\u09be\u09b0\u09cd\u0995\u09b6\u09bf\u099f/ \u099b\u09ac\u09bf \u09b8\u09b9 \u09ac\u09bf\u09a6\u09cd\u09af\u09be\u09b2\u09df \u09aa\u09b0\u09bf\u09a4\u09cd\u09af\u09be\u0997\u09c7\u09b0 \u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0, \u09b8\u09b0\u0995\u09be\u09b0-\u09aa\u09cd\u09b0\u09a6\u09a4\u09cd\u09a4 \u09aa\u09b0\u09bf\u099a\u09af\u09bc\u09aa\u09a4\u09cd\u09b0/ \u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0 - \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09aa\u09b0\u09bf\u099a\u09af\u09bc\u09c7\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09c7\u0964",line_3:"\u09ac\u09bf\u09a6\u09cd\u09af\u09c1\u09ce/\u099c\u09b2/\u0997\u09cd\u09af\u09be\u09b8 \u09ac\u09bf\u09b2 (\u0997\u09a4 \u09e9 \u09ae\u09be\u09b8\u09c7\u09b0), \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995/\u09aa\u09cb\u09b8\u09cd\u099f \u0985\u09ab\u09bf\u09b8 \u09aa\u09be\u09b8\u09ac\u09c1\u0995, \u09ad\u09be\u09a1\u09bc\u09be/\u09b2\u09bf\u099c/ \u09b2\u09bf\u09ad \u098f\u09ac\u0982 \u09b2\u09be\u0987\u09b8\u09c7\u09a8\u09cd\u09b8 \u099a\u09c1\u0995\u09cd\u09a4\u09bf \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09c7\u0964",line_4:"\u0997\u09cd\u09b0\u09b9\u09a3\u09af\u09cb\u0997\u09cd\u09af \u09aa\u09b0\u09bf\u099a\u09af\u09bc \u0993 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09a8\u09a5\u09bf\u09b0 \u09ac\u09bf\u09b8\u09cd\u09a4\u09be\u09b0\u09bf\u09a4 \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09b0 \u099c\u09a8\u09cd\u09af, \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8",line_5:" \u098f\u0996\u09be\u09a8\u09c7"}},question_2:{title:"\u0995\u09bf \u09ad\u09be\u09ac\u09c7 \u099c\u09ae\u09be \u0995\u09b0\u09ac\u09c7\u09a8?",content:{line_1:"\u09a8\u09a5\u09bf\u0997\u09c1\u09b2\u09bf \u0985\u09a8\u09b2\u09be\u0987\u09a8\u09c7\xa0myAadhaar \u09aa\u09cb\u09b0\u09cd\u099f\u09be\u09b2\xa0\u098f \u09ac\u09be \u09af\u09c7 \u0995\u09cb\u09a8\u09cb \u0986\u09a7\u09be\u09b0 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0 \u09aa\u09b0\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8 \u0995\u09b0\u09c7 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964",line_2:"\u0985\u09a8\u09b2\u09be\u0987\u09a8\u09c7 \u09a8\u09a5\u09bf \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u09a7\u09be\u09aa\u09c7 \u09a7\u09be\u09aa\u09c7 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8",line_3:" \u098f\u0996\u09be\u09a8\u09c7"}},main_content:{submit:"\u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8",title:"\u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u09a6\u09b0\u0995\u09be\u09b0?",videoText:"\u09ad\u09bf\u09a1\u09bf\u0993 \u0997\u09be\u0987\u09a1",knowMoreText:"\u0986\u09b0\u0993 \u099c\u09be\u09a8\u09a4\u09c7?",callText:"\u099f\u09cb\u09b2 \u09ab\u09cd\u09b0\u09bf \u0995\u09b2 \u0995\u09b0\u09c1\u09a8 (\u09e7\u09ef\u09ea\u09ed)"}},one:{title:"\u0995\u09c7\u09a8\u09cb \u0986\u09ae\u09be\u0995\u09c7 \u0986\u09a7\u09be\u09b0\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09b0\u09bf\u099a\u09af\u09bc \u098f\u09ac\u0982 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09a8\u09a5\u09bf\u09aa\u09a4\u09cd\u09b0  \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u09b9\u09ac\u09c7 ?",content:"\u099c\u09a8\u09cd\u09af \u09aa\u09b0\u09bf\u099a\u09af\u09bc \u098f\u09ac\u0982 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09b9\u09be\u09af\u09bc\u0995 \u09a8\u09a5\u09bf\u0997\u09c1\u09b2\u09bf \u099c\u09c0\u09ac\u09a8\u09af\u09be\u09a4\u09cd\u09b0\u09be\u09b0 \u09b8\u09b9\u099c, \u0986\u09b0\u0993 \u09ad\u09be\u09b2 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u09b8\u09b0\u09ac\u09b0\u09be\u09b9 \u098f\u09ac\u0982 \u09b8\u09a0\u09bf\u0995 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u0995\u09c7 \u09b8\u0995\u09cd\u09b7\u09ae \u0995\u09b0\u09c7\u0964 \u0985\u09a4\u098f\u09ac, \u09b8\u09be\u09ae\u09cd\u09aa\u09cd\u09b0\u09a4\u09bf\u0995 \u09aa\u09b0\u09bf\u099a\u09af\u09bc \u098f\u09ac\u0982 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09a8\u09a5\u09bf\u09aa\u09a4\u09cd\u09b0 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09a7\u09be\u09b0\u0995\u09c7\u09b0 \u09b8\u09cd\u09ac\u09be\u09b0\u09cd\u09a5\u09c7\u0964 "},two:{title:"\u0986\u09ae\u09be\u0995\u09c7 \u0986\u09ae\u09be\u09b0 \u09aa\u09b0\u09bf\u099a\u09af\u09bc \u098f\u09ac\u0982 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09cb\u09a8-\u0995\u09cb\u09a8 \u09a8\u09a5\u09bf \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u0989\u099a\u09bf\u09a4? ? ",content:{para_1:{heading_one:"\u09aa\u09b0\u09bf\u099a\u09af\u09bc \u098f\u09ac\u0982 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u0989\u09ad\u09af\u09bc\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u09a5\u09bf\u09aa\u09a4\u09cd\u09b0:",list_1:"(a) \u09b0\u09c7\u09b6\u09a8 \u0995\u09be\u09b0\u09cd\u09a1",list_2:"(b) \u09ad\u09cb\u099f\u09be\u09b0 \u09aa\u09b0\u09bf\u099a\u09af\u09bc \u09aa\u09a4\u09cd\u09b0",list_3:"(c) \u0995\u09bf\u09b7\u09be\u09a3 \u099b\u09ac\u09bf\u09b0 \u09aa\u09be\u09b8\u09ac\u09c1\u0995",list_4:"(d) \u09ad\u09be\u09b0\u09a4\u09c0\u09af\u09bc \u09aa\u09be\u09b8\u09aa\u09cb\u09b0\u09cd\u099f",list_5:"(e) \u09b8\u09b0\u0995\u09be\u09b0-\u09aa\u09cd\u09b0\u09a6\u09a4\u09cd\u09a4 \u09aa\u09b0\u09bf\u099a\u09af\u09bc\u09aa\u09a4\u09cd\u09b0/\u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0, \u098f\u09b8\u099f\u09bf/\u098f\u09b8\u09b8\u09bf/\u0993\u09ac\u09bf\u09b8\u09bf \u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0 \u09ac\u09be \u09ac\u09bf\u09af\u09bc\u09c7\u09b0 \u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0, \u099b\u09ac\u09bf \u09b8\u09b9",list_6:"(f) \u09aa\u09cd\u09b0\u09a4\u09bf\u09ac\u09a8\u09cd\u09a7\u09c0 \u09aa\u09b0\u09bf\u099a\u09af\u09bc\u09aa\u09a4\u09cd\u09b0/\u09aa\u09cd\u09b0\u09a4\u09bf\u09ac\u09a8\u09cd\u09a7\u09c0\u09a4\u09be\u09b0 \u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0",list_7:"(g) \u099f\u09cd\u09b0\u09be\u09a8\u09cd\u09b8\u099c\u09c7\u09a8\u09cd\u09a1\u09be\u09b0 \u09aa\u09b0\u09bf\u099a\u09af\u09bc\u09aa\u09a4\u09cd\u09b0/\u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0",list_8:"(h) \u098f\u0995\u099c\u09a8 \u09af\u09cc\u09a8\u0995\u09b0\u09cd\u09ae\u09c0\u09b0 \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09c7 \u0987\u0989\u0986\u0987\u09a1\u09bf\u098f\u0986\u0987-\u098f\u09b0 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09be\u09b0\u09cd\u09a1 \u09b8\u09be\u09b0\u09cd\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u099f \u09ac\u09bf\u09a8\u09cd\u09af\u09be\u09b8\u09c7 \u09a8\u09bf\u09b0\u09cd\u0997\u09a4 \u0995\u09b0\u09be \u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0",list_9:"(i) \u09b8\u09cd\u09ac\u09c0\u0995\u09c3\u09a4 \u0986\u09b6\u09cd\u09b0\u09af\u09bc\u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0 \u09ac\u09be \u0985\u09a8\u09be\u09a5 \u0986\u09b6\u09cd\u09b0\u09ae \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0987\u0989\u0986\u0987\u09a1\u09bf\u098f\u0986\u0987-\u098f\u09b0 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09be\u09b0\u09cd\u09a1 \u09b8\u09be\u09b0\u09cd\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u099f \u09ac\u09bf\u09a8\u09cd\u09af\u09be\u09b8\u09c7 \u09a8\u09bf\u09b0\u09cd\u0997\u09a4 \u0995\u09b0\u09be \u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0",list_10:"(j) \u09aa\u09cd\u09b0\u09bf\u099c\u09a8 \u0995\u09b0\u09cd\u09ae\u0995\u09b0\u09cd\u09a4\u09be\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09a8\u09bf\u09b0\u09cd\u0997\u09a4 \u0995\u09b0\u09be \u09ac\u09a8\u09cd\u09a6\u09c0 \u0986\u09a8\u09be\u09b0 \u09a8\u09a5\u09bf "},para_2:{heading_one:" \u09aa\u09b0\u09bf\u099a\u09af\u09bc\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u09a5\u09bf:",list_1:"(a) \u099b\u09ac\u09bf \u09b8\u09b9 \u09b8\u09cd\u0995\u09c1\u09b2 \u09aa\u09b0\u09bf\u09a4\u09cd\u09af\u09be\u0997\u09c7\u09b0 \u09b8\u09be\u09b0\u09cd\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u099f/\u09b8\u09cd\u0995\u09c1\u09b2 \u099f\u09cd\u09b0\u09be\u09a8\u09cd\u09b8\u09ab\u09be\u09b0 \u09b8\u09be\u09b0\u09cd\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u099f",list_2:"(b) \u099b\u09ac\u09bf \u09b8\u09b9 \u09b8\u09cd\u09ac\u09c0\u0995\u09c3\u09a4 \u09b6\u09bf\u0995\u09cd\u09b7\u09be \u09ac\u09cb\u09b0\u09cd\u09a1 \u09ac\u09be \u09ac\u09bf\u09b6\u09cd\u09ac\u09ac\u09bf\u09a6\u09cd\u09af\u09be\u09b2\u09df \u0995\u09b0\u09cd\u09a4\u09c3\u0995 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09a8\u09bf\u09b0\u09cd\u0997\u09a4 \u0995\u09b0\u09be \u09ae\u09be\u09b0\u09cd\u0995\u09b6\u09bf\u099f/\u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0",list_3:"(c) \u09aa\u09cd\u09af\u09be\u09a8/\u0987-\u09aa\u09cd\u09af\u09be\u09a8 \u0995\u09be\u09b0\u09cd\u09a1 ",list_4:"(d)\u09b8\u09b0\u0995\u09be\u09b0/\u09b8\u0982\u09ac\u09bf\u09a7\u09bf\u09ac\u09a6\u09cd\u09a7 \u09b8\u0982\u09b8\u09cd\u09a5\u09be/\u09aa\u09bf\u098f\u09b8\u0987\u0989-\u0987\u09b8\u09cd\u09af\u09c1\u0995\u09c3\u09a4 \u0995\u09b0\u09cd\u09ae\u099a\u09be\u09b0\u09c0/\u09aa\u09c7\u09a8\u09b6\u09a8\u09be\u09b0 \u09ab\u099f\u09cb \u0986\u0987\u09a1\u09c7\u09a8\u09cd\u099f\u09bf\u099f\u09bf \u0995\u09be\u09b0\u09cd\u09a1,   \u09aa\u09c7\u09a8\u09b6\u09a8 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u09ac\u09be \u09ae\u09c7\u09a1\u09bf-\u0995\u09cd\u09b2\u09c7\u09ae \u0995\u09be\u09b0\u09cd\u09a1",list_5:"(e) \u09a1\u09cd\u09b0\u09be\u0987\u09ad\u09bf\u0982 \u09b2\u09be\u0987\u09b8\u09c7\u09a8\u09cd\u09b8",list_6:"(f) \u09b8\u09cd\u09ac\u09be\u09a7\u09c0\u09a8\u09a4\u09be \u09b8\u0982\u0997\u09cd\u09b0\u09be\u09ae\u09c0 \u09ab\u099f\u09cb \u0986\u0987\u09a1\u09c7\u09a8\u09cd\u099f\u09bf\u099f\u09bf \u0995\u09be\u09b0\u09cd\u09a1"},para_3:{heading_one:"\u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u09a5\u09bf:",list_1:"(a) \u09ac\u09bf\u09a6\u09cd\u09af\u09c1\u09ce, \u099c\u09b2, \u0997\u09cd\u09af\u09be\u09b8 \u09ac\u09be \u099f\u09c7\u09b2\u09bf\u09ab\u09cb\u09a8/\u09ae\u09cb\u09ac\u09be\u0987\u09b2/\u09ac\u09cd\u09b0\u09a1\u09ac\u09cd\u09af\u09be\u09a8\u09cd\u09a1 \u09ac\u09bf\u09b2 (\u09a4\u09bf\u09a8 \u09ae\u09be\u09b8\u09c7\u09b0 \u099a\u09c7\u09df\u09c7 \u09ac\u09c7\u09b6\u09bf \u09aa\u09c1\u09b0\u09be\u09a8\u09cb \u09a8\u09be)",list_2:"(b)  \u099b\u09ac\u09bf \u09b8\u09b9 \u09af\u09a5\u09be\u09af\u09a5\u09ad\u09be\u09ac\u09c7 \u09b8\u09cd\u09ac\u09be\u0995\u09cd\u09b7\u09b0\u09bf\u09a4 \u098f\u09ac\u0982 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u09ae\u09cd\u09aa\u09af\u09c1\u0995\u09cd\u09a4 \u09a4\u09ab\u09b8\u09bf\u09b2\u09bf \u09ac\u09be\u09a3\u09bf\u099c\u09cd\u09af\u09bf\u0995 \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995/\u09aa\u09cb\u09b8\u09cd\u099f \u0985\u09ab\u09bf\u09b8 \u09aa\u09be\u09b8\u09ac\u09c1\u0995",list_3:"(c)  \u09af\u09a5\u09be\u09af\u09a5\u09ad\u09be\u09ac\u09c7 \u09b8\u09cd\u09ac\u09be\u0995\u09cd\u09b7\u09b0\u09bf\u09a4 \u098f\u09ac\u0982 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u09ae\u09cd\u09aa\u09af\u09c1\u0995\u09cd\u09a4 \u09a4\u09ab\u09b8\u09bf\u09b2\u09bf \u09ac\u09be\u09a3\u09bf\u099c\u09cd\u09af\u09bf\u0995 \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995/\u09aa\u09cb\u09b8\u09cd\u099f \u0985\u09ab\u09bf\u09b8 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f/\u0995\u09cd\u09b0\u09c7\u09a1\u09bf\u099f-\u0995\u09be\u09b0\u09cd\u09a1 \u09b8\u09cd\u099f\u09c7\u099f\u09ae\u09c7\u09a8\u09cd\u099f (\u09a4\u09bf\u09a8 \u09ae\u09be\u09b8\u09c7\u09b0 \u099a\u09c7\u09df\u09c7 \u09ac\u09c7\u09b6\u09bf \u09aa\u09c1\u09b0\u09be\u09a8\u09cb \u09a8\u09df) ",list_4:"(d) \u09ac\u09c8\u09a7 \u09ad\u09be\u09a1\u09bc\u09be, \u09b2\u09bf\u099c \u09ac\u09be \u09aa\u09b0\u09bf\u09a4\u09cd\u09af\u09be\u0997 \u098f\u09ac\u0982 \u09b2\u09be\u0987\u09b8\u09c7\u09a8\u09cd\u09b8 \u099a\u09c1\u0995\u09cd\u09a4\u09bf | ",list_5:"(e) \u098f\u09ae\u09aa\u09bf, \u098f\u09ae\u098f\u09b2\u098f, \u098f\u09ae\u098f\u09b2\u09b8\u09bf, \u09aa\u09cc\u09b0 \u0995\u09be\u0989\u09a8\u09cd\u09b8\u09bf\u09b2\u09b0, \u0997\u09cd\u09b0\u09c1\u09aa '\u098f' \u09ac\u09be '\u09ac\u09bf' \u0997\u09c7\u099c\u09c7\u099f\u09c7\u09a1 \u0985\u09ab\u09bf\u09b8\u09be\u09b0, \u0987\u09aa\u09bf\u098f\u09ab\u0993 \u0985\u09ab\u09bf\u09b8\u09be\u09b0 \u09ac\u09be \u09a4\u09b9\u09b8\u09bf\u09b2\u09a6\u09be\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0987\u0989\u0986\u0987\u09a1\u09bf\u098f\u0986\u0987-\u098f\u09b0 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09be\u09b0\u09cd\u09a1 \u09b8\u09be\u09b0\u09cd\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u099f \u09ac\u09bf\u09a8\u09cd\u09af\u09be\u09b8\u09c7 \u09a8\u09bf\u09b0\u09cd\u0997\u09a4 \u0995\u09b0\u09be \u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0 |",list_6:"(f) \u0997\u09cd\u09b0\u09be\u09ae \u09aa\u099e\u09cd\u099a\u09be\u09af\u09bc\u09c7\u09a4 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8/\u09b8\u099a\u09bf\u09ac, \u0997\u09cd\u09b0\u09be\u09ae \u09b0\u09be\u099c\u09b8\u09cd\u09ac \u0985\u09ab\u09bf\u09b8\u09be\u09b0 \u09ac\u09be \u09b8\u09ae\u09a4\u09c1\u09b2\u09cd\u09af (\u0997\u09cd\u09b0\u09be\u09ae\u09c0\u09a3 \u0985\u099e\u09cd\u099a\u09b2\u09c7\u09b0 \u099c\u09a8\u09cd\u09af) \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0987\u0989\u0986\u0987\u09a1\u09bf\u098f\u0986\u0987-\u098f\u09b0 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09be\u09b0\u09cd\u09a1 \u09b8\u09be\u09b0\u09cd\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u099f \u09ac\u09bf\u09a8\u09cd\u09af\u09be\u09b8\u09c7 \u09a8\u09bf\u09b0\u09cd\u0997\u09a4 \u0995\u09b0\u09be \u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0 |",list_7:"(g) \u09b8\u09cd\u09ac\u09c0\u0995\u09c3\u09a4 \u09b6\u09bf\u0995\u09cd\u09b7\u09be \u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09be\u09a8\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u0995\u09b0\u09cd\u09a4\u09c3\u0995 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09b8\u0982\u09b6\u09cd\u09b2\u09bf\u09b7\u09cd\u099f \u099b\u09be\u09a4\u09cd\u09b0\u0995\u09c7 \u0987\u0989\u0986\u0987\u09a1\u09bf\u098f\u0986\u0987-\u098f\u09b0 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09be\u09b0\u09cd\u09a1  \u09b8\u09be\u09b0\u09cd\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u099f \u09ac\u09bf\u09a8\u09cd\u09af\u09be\u09b8\u09c7 \u09a8\u09bf\u09b0\u09cd\u0997\u09a4 \u0995\u09b0\u09be \u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0 |",list_8:"(h)  \u09b8\u09ae\u09cd\u09aa\u09a4\u09cd\u09a4\u09bf \u0995\u09b0\u09c7\u09b0 \u09b0\u09b8\u09bf\u09a6 (\u098f\u0995 \u09ac\u099b\u09b0\u09c7\u09b0 \u099a\u09c7\u09df\u09c7 \u09ac\u09c7\u09b6\u09bf \u09aa\u09c1\u09b0\u09be\u09a8\u09cb \u09a8\u09af\u09bc)",list_9:"(i)\u09ac\u09c8\u09a7 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u09ac\u09bf\u0995\u09cd\u09b0\u09af\u09bc \u099a\u09c1\u0995\u09cd\u09a4\u09bf \u09ac\u09be \u0989\u09aa\u09b9\u09be\u09b0 \u09a6\u09b2\u09bf\u09b2",list_10:"(j) \u09b8\u09b0\u0995\u09be\u09b0/\u09b8\u0982\u09ac\u09bf\u09a7\u09bf\u09ac\u09a6\u09cd\u09a7 \u09b8\u0982\u09b8\u09cd\u09a5\u09be/\u09aa\u09bf\u098f\u09b8\u0987\u0989 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09aa\u09cd\u09b0\u09a6\u09a4\u09cd\u09a4 \u0986\u09ac\u09be\u09b8\u09a8\u09c7\u09b0 \u09ac\u09b0\u09be\u09a6\u09cd\u09a6\u09aa\u09a4\u09cd\u09b0 (\u098f\u0995 \u09ac\u099b\u09b0\u09c7\u09b0 \u099a\u09c7\u09df\u09c7 \u09ac\u09c7\u09b6\u09bf \u09aa\u09c1\u09b0\u09be\u09a8\u09cb \u09a8\u09af\u09bc)",list_11:"(k) \u099c\u09c0\u09ac\u09a8 \u09ac\u09be \u099a\u09bf\u0995\u09bf\u09ce\u09b8\u09be \u09ac\u09c0\u09ae\u09be \u09aa\u09b2\u09bf\u09b8\u09bf (\u098f\u0995 \u09ac\u099b\u09b0\u09c7\u09b0 \u099a\u09c7\u09df\u09c7 \u09ac\u09c7\u09b6\u09bf \u09aa\u09c1\u09b0\u09be\u09a8\u09cb \u09a8\u09af\u09bc)"}}},three:{title:"\u0986\u09ae\u09bf \u0995\u09bf \u09ad\u09be\u09ac\u09c7 \u09a8\u09a5\u09bf\u09aa\u09a4\u09cd\u09b0\u0997\u09c1\u09b2\u09bf \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf? ",content:"\u09a8\u09a5\u09bf\u09aa\u09a4\u09cd\u09b0\u0997\u09c1\u09b2\u09bf \u0985\u09a8\u09b2\u09be\u0987\u09a8\u09c7 myAadhaar \u09aa\u09cb\u09b0\u09cd\u099f\u09be\u09b2 https://myaadhaar.uidai.gov.in/ \u09ac\u09be \u09af\u09c7 \u0995\u09cb\u09a8\u09cb \u0986\u09a7\u09be\u09b0 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u09c7 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964"},four:{title:"\u0986\u09ae\u09bf \u0995\u09c0 \u09ad\u09be\u09ac\u09c7 \u0985\u09a8\u09b2\u09be\u0987\u09a8\u09c7 \u09a8\u09a5\u09bf\u09aa\u09a4\u09cd\u09b0 \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf?",content:{list_1:"(1) https://myaadhaar.uidai.gov.in/-\u09aa\u09b0\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8 \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a8\u09ae\u09cd\u09ac\u09b0\u09c7 \u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09a4 \u0993\u09af\u09bc\u09be\u09a8-\u099f\u09be\u0987\u09ae \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 (\u0993\u099f\u09bf\u09aa\u09bf) \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0  \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7 \u09b2\u0997 \u0987\u09a8 \u0995\u09b0\u09c1\u09a8\u0964",list_2:"(2) \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2\u09c7 \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09bf\u09a4 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09b0\u09bf\u099a\u09af\u09bc \u098f\u09ac\u0982 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8\u0964",list_3:"(3) \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2\u09c7 \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09bf\u09a4 \u09ac\u09bf\u09b6\u09a6 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09ad\u09c1\u09b2 \u09b9\u09b2\u09c7, \u09a8\u09c0\u099a\u09c7\u09b0 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u09eb \u098f\u09b0 \u0989\u09a4\u09cd\u09a4\u09b0\u09c7 \u09ac\u09b0\u09cd\u09a3\u09bf\u09a4 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u09aa\u09a6\u0995\u09cd\u09b7\u09c7\u09aa \u09a8\u09bf\u09a8\u0964",list_4:"(4) \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2\u09c7 \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09bf\u09a4 \u09ac\u09bf\u09b6\u09a6\u0997\u09c1\u09b2\u09bf \u09b8\u09a0\u09bf\u0995 \u09b9\u09b2\u09c7, \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 '\u0986\u09ae\u09bf \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u099b\u09bf \u09af\u09c7 \u0989\u09aa\u09b0\u09c7\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3\u0997\u09c1\u09b2\u09bf \u09b8\u09a0\u09bf\u0995' \u099f\u09cd\u09af\u09be\u09ac\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8 \u0964",list_5:"(5) \u09a1\u09cd\u09b0\u09aa-\u09a1\u09be\u0989\u09a8 \u09ae\u09c7\u09a8\u09c1 \u09a5\u09c7\u0995\u09c7 \u09aa\u09b0\u09bf\u099a\u09df\u09c7\u09b0 \u09a8\u09a5\u09bf\u099f\u09bf \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8 \u09af\u09be \u0986\u09aa\u09a8\u09bf \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u099a\u09be\u09a8\u0964",list_6:"(6) \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09b0\u09bf\u099a\u09df\u09c7\u09b0 \u09a8\u09a5\u09bf\u099f\u09bf \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8 (\u09b8\u09be\u0987\u099c 2 MB \u098f\u09b0 \u09a5\u09c7\u0995\u09c7 \u0995\u09ae ; \u09ab\u09be\u0987\u09b2 \u09ab\u09b0\u09ae\u09cd\u09af\u09be\u099f JPEG, PNG \u09ac\u09be PDF)",list_7:"(7) \u09a1\u09cd\u09b0\u09aa-\u09a1\u09be\u0989\u09a8 \u09ae\u09c7\u09a8\u09c1 \u09a5\u09c7\u0995\u09c7 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09a8\u09a5\u09bf\u099f\u09bf \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8 \u09af\u09be \u0986\u09aa\u09a8\u09bf \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u099a\u09be\u09a8\u0964",list_8:"(8) \u0986\u09aa\u09a8\u09be\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09a8\u09a5\u09bf\u099f\u09bf \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8 (\u09b8\u09be\u0987\u099c 2 MB \u098f\u09b0 \u09a5\u09c7\u0995\u09c7 \u0995\u09ae ; \u09ab\u09be\u0987\u09b2 \u09ab\u09b0\u09ae\u09cd\u09af\u09be\u099f JPEG, PNG \u09ac\u09be PDF)",list_9:"(9) \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u099c\u09ae\u09be \u09a6\u09bf\u09a8."}},five:{title:"\u09af\u09a6\u09bf \u0986\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2\u09c7 \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09bf\u09a4 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u099f\u09bf \u0986\u09ae\u09be\u09b0 \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09b8\u09be\u09a5\u09c7  \u0985\u09ae\u09bf\u09b2 \u09b9\u09df , \u09a4\u09be\u09b9\u09b2\u09c7 \u0986\u09ae\u09be\u09b0 \u0995\u09c0 \u0995\u09b0\u09be \u0989\u099a\u09bf\u09a4?",content:{list_1:"(1) \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 '\u09a0\u09bf\u0995\u09be\u09a8\u09be\u09af\u09bc \u0985\u09ae\u09bf\u09b2 \u09a5\u09be\u0995\u09b2\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8','\u0986\u09ae\u09bf \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c7\u099b\u09bf \u09af\u09c7 \u0989\u09aa\u09b0\u09c7\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3\u0997\u09c1\u09b2\u09cb \u09b8\u09a0\u09bf\u0995' \u099f\u09cd\u09af\u09be\u09ac\u09c7\u09b0 \u09a8\u09bf\u099a\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\u0964",list_2:"(2)\u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09bf\u09a4 \u09ab\u09b0\u09cd\u09ae\u09c7 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09aa\u09c2\u09b0\u09a3 \u0995\u09b0\u09c1\u09a8\u0964",list_3:"(3) \u09a1\u09cd\u09b0\u09aa-\u09a1\u09be\u0989\u09a8 \u09ae\u09c7\u09a8\u09c1 \u09a5\u09c7\u0995\u09c7 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09a8\u09a5\u09bf\u099f\u09bf \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8 \u09af\u09be \u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8\u0964",list_4:"(4) \u0986\u09aa\u09a8\u09be\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09a8\u09a5\u09bf\u099f\u09bf \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8 (\u09b8\u09be\u0987\u099c 2 MB \u098f\u09b0 \u09a5\u09c7\u0995\u09c7 \u0995\u09ae ; \u09ab\u09be\u0987\u09b2 \u09ab\u09b0\u09ae\u09cd\u09af\u09be\u099f JPEG, PNG \u09ac\u09be PDF)",list_5:"(5) \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u0985\u09b0\u09cd\u09a5 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c1\u09a8\u0964",list_6:"(6) \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u099c\u09ae\u09be \u09a6\u09bf\u09a8."}},six:{title:"\u09af\u09a6\u09bf \u0995\u09cb\u09a8\u09cb \u09aa\u09b0\u09bf\u099a\u09af\u09bc \u09ac\u09bf\u09ac\u09b0\u09a3 (\u09a8\u09be\u09ae, \u09b2\u09bf\u0999\u09cd\u0997 \u09ac\u09be \u099c\u09a8\u09cd\u09ae\u09a4\u09bf\u09a5\u09bf) \u0986\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u0995\u09c3\u09a4 \u09aa\u09b0\u09bf\u099a\u09af\u09bc \u09ac\u09bf\u09ac\u09b0\u09a3\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7  \u09a8\u09be \u09ae\u09c7\u09b2\u09c7, \u09a4\u09be\u09b9\u09b2\u09c7 \u0986\u09ae\u09be\u09b0 \u0995\u09c0 \u0995\u09b0\u09be \u0989\u099a\u09bf\u09a4?",content:"https://uidai.gov.in/images/commdoc/List_of_Supporting_Document_for_Aadhaar_Enrolment_and_Update.pdf. \u098f \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4 \u09aa\u09b0\u09bf\u099a\u09af\u09df\u09c7\u09b0 \u09ae\u09c2\u09b2 \u09a8\u09a5\u09bf \u09b8\u09b9, \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u098f\u0995\u099f\u09bf \u0986\u09a7\u09be\u09b0 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0 \u09aa\u09b0\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8 \u0995\u09b0\u09c1\u09a8 \u09f7"},seven:{title:"\u0986\u09ae\u09bf \u09af\u09a6\u09bf \u0985\u09ab\u09b2\u09be\u0987\u09a8\u09c7 \u09a8\u09a5\u09bf \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u099a\u09be\u0987, \u09a4\u09be\u09b9\u09b2\u09c7 \u0986\u09ae\u09bf \u0995\u09c0 \u09ad\u09be\u09ac\u09c7 \u098f\u0995\u099f\u09bf \u0986\u09a7\u09be\u09b0 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0 \u0996\u09c1\u0981\u099c\u09c7 \u09aa\u09be\u09ac\u09cb?",content:{list_1:"(1) \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 https://bhuvan.nrsc.gov.in/aadhaar/ \u098f \u09af\u09be\u09a8",list_2:"(2) \u09a8\u09bf\u0995\u099f\u09ac\u09b0\u09cd\u09a4\u09c0 \u0986\u09a7\u09be\u09b0 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u0997\u09c1\u09b2\u09bf \u09b8\u09a8\u09be\u0995\u09cd\u09a4 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af, '\u09a8\u09bf\u0995\u099f\u09ac\u09b0\u09cd\u09a4\u09c0 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u0997\u09c1\u09b2\u09bf' \u099f\u09cd\u09af\u09be\u09ac\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\u09f7  \u09a8\u09bf\u0995\u099f\u09ac\u09b0\u09cd\u09a4\u09c0 \u0986\u09a7\u09be\u09b0 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u0997\u09c1\u09b2\u09bf \u09a6\u09c7\u0996\u09a4\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8\u09c7\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c1\u09a8 \u09f7",list_3:"(3) \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09bf\u09a8 \u0995\u09cb\u09a1 \u098f\u09b2\u09be\u0995\u09be\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u0985\u09ac\u09b8\u09cd\u09a5\u09bf\u09a4 \u0986\u09a7\u09be\u09b0 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u0997\u09c1\u09b2\u09bf \u09b8\u09a8\u09be\u0995\u09cd\u09a4 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af, '\u09aa\u09bf\u09a8 \u0995\u09cb\u09a1 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0995\u09b0\u09c1\u09a8' \u099f\u09cd\u09af\u09be\u09ac\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\u0964 \u09b8\u09c7\u0987 \u098f\u09b2\u09be\u0995\u09be\u09b0 \u0986\u09a7\u09be\u09b0 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u0997\u09c1\u09b2\u09bf \u09a6\u09c7\u0996\u09a4\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u098f\u09b2\u09be\u0995\u09be\u09b0 \u09aa\u09bf\u09a8 \u0995\u09cb\u09a1 \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c1\u09a8 \u0964"}},eight:{title:"\u09a8\u09a5\u09bf\u09aa\u09a4\u09cd\u09b0\u0997\u09c1\u09b2\u09bf \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u099a\u09be\u09b0\u09cd\u099c \u0995\u09bf ?",content:"\u09e7\u09ea\u0987 \u09b8\u09c7\u09aa\u09cd\u099f\u09c7\u09ae\u09cd\u09ac\u09b0 \u09e8\u09e6\u09e8\u09e9 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 myAadhaar \u09aa\u09cb\u09b0\u09cd\u099f\u09be\u09b2\u09c7 \u09a8\u09a5\u09bf\u09aa\u09a4\u09cd\u09b0 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09ac\u09bf\u09a8\u09be\u09ae\u09c2\u09b2\u09cd\u09af\u09c7\u0964 \u098f\u0995\u099f\u09bf \u0986\u09a7\u09be\u09b0 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u09c7 \u09a8\u09a5\u09bf\u09aa\u09a4\u09cd\u09b0 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af, \u09aa\u09cd\u09b0\u09af\u09cb\u099c\u09cd\u09af \u099a\u09be\u09b0\u09cd\u099c \u09eb\u09e6/-\u099f\u09be\u0995\u09be\u0964 "},nine:{title:"\u0995\u0996\u09a8 \u0986\u09ae\u09bf \u09a8\u09a5\u09bf \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf?",content:"\u099c\u09c0\u09ac\u09a8\u09af\u09be\u09a4\u09cd\u09b0\u09be\u09b0 \u09b8\u09cd\u09ac\u09be\u099a\u09cd\u099b\u09a8\u09cd\u09a6\u09cd\u09af, \u0989\u09a8\u09cd\u09a8\u09a4 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u098f\u09ac\u0982 \u09b8\u09a0\u09bf\u0995 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u09b8\u0995\u09cd\u09b7\u09ae \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u09a5\u09bf\u0997\u09c1\u09b2\u09bf \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be \u09ac\u09be\u099e\u09cd\u099b\u09a8\u09c0\u09af\u09bc \u0964 \u0985\u09a4\u098f\u09ac, \u09a4\u09be\u09a1\u09bc\u09be\u09a4\u09be\u09a1\u09bc\u09bf \u09a4\u09be\u09b0\u09bf\u0996\u09c7 \u09a8\u09a5\u09bf \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u09ac\u09be\u09b0\u09cd\u09a5\u09c7\u0964"},ten:{title:"\u0986\u09ae\u09bf \u098f\u0995\u099c\u09a8 \u0985\u09a8\u09be\u09ac\u09be\u09b8\u09c0 \u09ad\u09be\u09b0\u09a4\u09c0\u09af\u09bc (\u098f\u09a8\u0986\u09b0\u0986\u0987)\u0964 \u0986\u09ae\u09bf \u0995\u09bf\u09ad\u09be\u09ac\u09c7 \u09a8\u09a5\u09bf \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf?",content:"\u0986\u09aa\u09a8\u09bf \u09af\u0996\u09a8\u0987 \u09ad\u09be\u09b0\u09a4\u09c7 \u09a5\u09be\u0995\u09ac\u09c7\u09a8 \u09a4\u0996\u09a8\u0987 \u0986\u09aa\u09a8\u09bf \u09a8\u09a5\u09bf \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964"}}},aadharUpdateHistory:{title1:"\u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0 \u0986\u09aa\u09a1\u09c7\u099f \u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u099a\u09c7\u0995 \u0995\u09b0\u09c1\u09a8",label1:"\u09b0\u09c7\u0995\u09b0\u09cd\u09a1",label2:"\u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf\u09b0 \u09a4\u09be\u09b0\u09bf\u0996/\u0986\u09aa\u09a1\u09c7\u099f",label3:"URN/EID",label4:"T\u099f\u09be\u0987\u09aa",list1:"\u09a8\u09be\u09ae",list2:"\u09ae\u09c1\u09a0\u09cb\u09ab\u09cb\u09a8",list3:"\u0987\u09ae\u09c7\u0987\u09b2",list4:"\u099c\u09a8\u09cd\u09ae \u09a4\u09be\u09b0\u09bf\u0996",list5:"\u09b2\u09bf\u0999\u09cd\u0997",list6:"\u09a0\u09bf\u0995\u09be\u09a8\u09be"},ssup:{howItWorks:{title:"\u0995\u09bf \u09ad\u09be\u09ac\u09c7 \u098f\u099f\u09be \u0995\u09be\u099c \u0995\u09b0\u09c7",description:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u0986\u09aa\u09a1\u09c7\u099f \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u099f\u09bf \u09ac\u09c1\u099d\u09a4\u09c7  \u09a8\u09bf\u09ae\u09cd\u09a8\u09b2\u09bf\u0996\u09bf\u09a4 \u09aa\u09a6\u0995\u09cd\u09b7\u09c7\u09aa\u0997\u09c1\u09b2\u09bf \u09aa\u09a1\u09bc\u09c1\u09a8\u0964 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u0995\u09b0\u09a3 \u09ac\u09be \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u0996\u09cd\u09af\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u0995\u09cb\u09a8\u09cb \u09ac\u09bf\u09b2\u09ae\u09cd\u09ac \u098f\u09a1\u09bc\u09be\u09a4\u09c7 \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09aa\u09a6\u0995\u09cd\u09b7\u09c7\u09aa\u09c7 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09be\u09ac\u09bf\u09a4 \u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u0997\u09c1\u09b2\u09bf \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09c1\u09a8",proceedToUpdateAadhaar:"\u0986\u09a7\u09be\u09b0 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8",stepDescription:{one:"\u09a4\u09be\u09b2\u09bf\u0995\u09be \u09a5\u09c7\u0995\u09c7 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\u0964 \u098f\u0987 \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u09aa\u09cb\u09b0\u09cd\u099f\u09be\u09b2\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7, \u0986\u09aa\u09a8\u09bf \u09a0\u09bf\u0995\u09be\u09a8\u09be \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u09a8\u09be\u09ae, \u09b2\u09bf\u0999\u09cd\u0997, DOB, \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a8\u09ae\u09cd\u09ac\u09b0, \u0987\u09ae\u09c7\u09b2 \u098f\u09ac\u0982 \u09ac\u09be\u09af\u09bc\u09cb\u09ae\u09c7\u099f\u09cd\u09b0\u09bf\u0995\u09cd\u09b8 \u09a1\u09c7\u099f\u09be\u09b0 \u099c\u09a8\u09cd\u09af, \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09a8\u09bf\u0995\u099f\u09b8\u09cd\u09a5 \u0986\u09a7\u09be\u09b0 \u09b8\u09c7\u09ac\u09be \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u09c7 \u09af\u09be\u09a8\u0964",two:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u099c\u09a8\u09a4\u09be\u09a4\u09cd\u09a4\u09cd\u09ac\u09bf\u0995 \u09a4\u09a5\u09cd\u09af \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f  \u0995\u09b0\u09c1\u09a8\u0964\u0995\u09bf\u099b\u09c1\u09ae\u09be\u09a8 \u099c\u09a8\u09a4\u09be\u09a4\u09cd\u09a4\u09cd\u09ac\u09bf\u0995 \u09a4\u09a5\u09cd\u09af \u09a1\u09cd\u09b0\u09aa\u09a1\u09be\u0989\u09a8 \u09a4\u09be\u09b2\u09bf\u0995\u09be \u09a5\u09c7\u0995\u09c7 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09be\u09b0  \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u09b9\u09df \u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u099c\u09a8\u09a4\u09be\u09a4\u09cd\u09a4\u09cd\u09ac\u09bf\u0995 \u09a4\u09a5\u09cd\u09af \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f  \u0995\u09b0\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u09ac\u09be \u09a1\u09cd\u09b0\u09aa\u09a1\u09be\u0989\u09a8 \u09ac\u09bf\u0995\u09b2\u09cd\u09aa\u0997\u09c1\u09b2\u09bf \u09a5\u09c7\u0995\u09c7 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u09b8\u09be\u09ac\u09a7\u09be\u09a8 \u09b9\u09a8\u0964",three:"\u09a0\u09bf\u0995\u09be\u09a8\u09be \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ae\u09c2\u09b2 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8\u0995\u09be\u09b0\u09c0 \u09a8\u09a5\u09bf\u09b0 \u09b8\u09cd\u0995\u09cd\u09af\u09be\u09a8 \u0995\u09aa\u09bf \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8 \u09af\u09c7 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8\u0995\u09be\u09b0\u09c0 \u09a8\u09a5\u09bf\u099f\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09be\u09ae\u09c7 \u098f\u09ac\u0982 \u09ac\u09c8\u09a7\u0964 \u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf UIDAI \u09b8\u09cd\u099f\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09be\u09b0\u09cd\u09a1 \u09ab\u09b0\u09ae\u09cd\u09af\u09be\u099f\u09c7 \u098f\u0995\u099f\u09bf \u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c7\u09a8, \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09ad\u09c1\u09b2 \u09af\u09c7\u09ae\u09a8 \u0987\u09b8\u09cd\u09af\u09c1 \u09a4\u09be\u09b0\u09bf\u0996, \u0995\u09cd\u09b0\u09b8\u09a1 \u09b8\u09be\u0987\u09a8, \u09ab\u099f\u09cb \u099c\u09c1\u09a1\u09bc\u09c7 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u09ae\u09cd\u09aa \u098f\u09ac\u0982 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u0996\u09cd\u09af\u09be\u09a8 \u098f\u09a1\u09bc\u09be\u09a4\u09c7 \u0993\u09ad\u09be\u09b0\u09b0\u09be\u0987\u099f\u09bf\u0982 \u09a8\u09af\u09bc \u09a4\u09be \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8\u0964",four:"\u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u0986\u09aa\u09a1\u09c7\u099f \u09b6\u09c1\u09b2\u0995\u09c7\u09b0 \u099c\u09a8\u09cd\u09af  50  (\u0995\u09c7\u09ac\u09b2 \u09aa\u099e\u09cd\u099a\u09be\u09b6 \u099f\u09be\u0995\u09be) \u09a6\u09bf\u09a4\u09c7 \u09b9\u09ac\u09c7 | \u0986\u09aa\u09a8\u09bf \u0995\u09cd\u09b0\u09c7\u09a1\u09bf\u099f / \u09a1\u09c7\u09ac\u09bf\u099f \u0995\u09be\u09b0\u09cd\u09a1 \u09ac\u09be \u09a8\u09c7\u099f \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995\u09bf\u0982\u09af\u09bc\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0985\u09b0\u09cd\u09a5 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964\u098f\u0987 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3\u099f\u09bf \u09ab\u09c7\u09b0\u09a4\u09af\u09cb\u0997\u09cd\u09af \u09a8\u09af\u09bc\u0964\u0985\u09b0\u09cd\u09a5 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8\u09c7\u09b0 \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09c7, \u0986\u09aa\u09a8\u09bf \u0985\u09b0\u09cd\u09a5 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8\u09c7\u09b0 \u09aa\u09c1\u09a8\u09b0\u09be\u09df \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964",five:"\u0986\u09aa\u09a8\u09bf \u09b0\u09c7\u09ab\u09be\u09b0\u09c7\u09a8\u09cd\u09b8 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u098f\u0995\u099f\u09bf \u09b8\u09c7\u09ac\u09be \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09a8\u09ae\u09cd\u09ac\u09b0 (\u098f\u09b8\u0986\u09b0\u098f\u09a8) \u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09a4 \u0995\u09b0\u09ac\u09c7\u09a8\u0964\u0986\u09aa\u09a1\u09c7\u099f \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u099f\u09bf \u099f\u09cd\u09b0\u09cd\u09af\u09be\u0995 \u0995\u09b0\u09a4\u09c7 \u09ac\u09be \u0987\u0989\u0986\u0987\u09a1\u09bf\u098f\u0986\u0987 \u09b9\u09c7\u09b2\u09cd\u09aa\u09a1\u09c7\u09b8\u09cd\u0995\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ad\u09ac\u09bf\u09b7\u09cd\u09af\u09a4\u09c7 \u0995\u09cb\u09a8\u09cb \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0987 \u09a8\u09ae\u09cd\u09ac\u09b0\u099f\u09bf \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09c1\u09a8\u0964",six:"\u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u099f\u09bf \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0985\u09ad\u09cd\u09af\u09a8\u09cd\u09a4\u09b0\u09c0\u09a3 \u09ae\u09be\u09a8\u09a6\u09a8\u09cd\u09a1 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0985\u09aa\u09be\u09b0\u09c7\u099f\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09be \u09b9\u09ac\u09c7\u0964\u098f\u0987 \u09aa\u09b0\u09cd\u09af\u09be\u09af\u09bc\u09c7 \u09b8\u09b0\u09ac\u09b0\u09be\u09b9 \u0995\u09b0\u09be \u099c\u09a8\u09a4\u09be\u09a4\u09cd\u09a4\u09cd\u09ac\u09bf\u0995 \u09a4\u09a5\u09cd\u09af \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8\u0995\u09be\u09b0\u09c0 \u09a8\u09a5\u09bf\u09b0 \u09ac\u09bf\u09b0\u09c1\u09a6\u09cd\u09a7\u09c7 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09be \u09b9\u09ac\u09c7\u0964\u09af\u09a6\u09bf \u0995\u09cb\u09a8\u09cb \u0985\u09ae\u09bf\u09b2 \u09a5\u09be\u0995\u09c7 \u09a4\u09ac\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u099f\u09bf \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u0996\u09be\u09a4 \u09b9\u0993\u09af\u09bc\u09be\u09b0 \u09b8\u09ae\u09cd\u09ad\u09be\u09ac\u09a8\u09be \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964",seven:"\u0997\u09c1\u09a3\u09ae\u09be\u09a8 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be  \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u099f\u09bf \u09b8\u09ae\u09cd\u09aa\u09c1\u09b0\u09cd\u09a8 \u09b9\u0993\u09af\u09bc\u09be\u09b0 \u09aa\u09b0\u09c7, \u0986\u09aa\u09a8\u09bf \u09ab\u09b2\u09be\u09ab\u09b2 \u09b8\u09cd\u09ac\u09b0\u09c2\u09aa \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09ad\u09c1\u0995\u09cd\u09a4\u09bf \u0986\u0987\u09a1\u09bf \u09b8\u09b9 \u098f\u0995\u099f\u09bf \u098f\u09b8\u098f\u09ae\u098f\u09b8 \u09ac\u09bf\u099c\u09cd\u099e\u09aa\u09cd\u09a4\u09bf \u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09a4 \u0995\u09b0\u09ac\u09c7\u09a8 |",eight:"\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09ac\u09cd\u09af\u09be\u0995\u098f\u09a8\u09cd\u09a1 \u09b8\u09ab\u09cd\u099f\u0993\u09af\u09bc\u09cd\u09af\u09be\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0986\u09b0\u0993 \u0995\u09af\u09bc\u09c7\u0995\u099f\u09bf \u09ac\u09c8\u09a7\u09a4\u09be\u09b0 \u09aa\u09b0\u09c7, \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u099f\u09bf\u09b0  \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u0995\u09b0\u09a3 \u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8 \u09b9\u09ac\u09c7\u0964\u09ab\u09b2\u09be\u09ab\u09b2\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09bf \u098f\u0995\u099f\u09bf \u098f\u09b8\u098f\u09ae\u098f\u09b8 \u09ac\u09bf\u099c\u09cd\u099e\u09aa\u09cd\u09a4\u09bf \u09aa\u09be\u09ac\u09c7\u09a8\u0964",nine:"\u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 90% \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u09b0 \u09ae\u09be\u09a8 \u09b8\u09b9 30 \u09a6\u09bf\u09a8\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u09b9\u09af\u09bc \u0964 \u09a4\u09ac\u09c7 , \u0986\u09ae\u09b0\u09be \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae\u0997\u09c1\u09b2\u09bf\u0995\u09c7 \u0989\u09a8\u09cd\u09a8\u09a4\u09bf\u09b6\u09c0\u09b2  \u0995\u09b0\u099b\u09bf \u098f\u09ac\u0982 \u0996\u09c1\u09ac \u09b8\u09ae\u09cd\u09ad\u09ac\u09a4 \u09ac\u09c7\u09b6\u09bf\u09b0\u09ad\u09be\u0997 \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u099f\u09bf \u0989\u09b2\u09cd\u09b2\u09bf\u0996\u09bf\u09a4 \u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u0986\u0997\u09c7 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be \u09b9\u09ac\u09c7\u0964 \u0986\u09aa\u09a8\u09bf myaadhaar.uidai.gov.in \u09aa\u09b0\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8 \u0995\u09b0\u09c7  \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u099c\u09be\u09a4\u0995\u09b0\u09a3\u09c7\u09b0 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964"}},updateSelectPage:{title:"\u0986\u09a7\u09be\u09b0 \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09c1\u09a8",selectFields:{smallDescription:"\u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u0986\u09a7\u09be\u09b0 \u09a4\u09a5\u09cd\u09af \u09ab\u09bf\u09b2\u09cd\u09a1 (\u0997\u09c1\u09b2\u09bf) \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8",longDescription:"\u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u09a8\u09bf\u09ae\u09cd\u09a8\u09b2\u09bf\u0996\u09bf\u09a4 \u09af\u09c7 \u0995\u09cb\u09a8\u09cb \u0986\u09a7\u09be\u09b0 \u09a4\u09a5\u09cd\u09af \u09ab\u09bf\u09b2\u09cd\u09a1 (\u0997\u09c1\u09b2\u09bf) \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8",updatesLeft:" \u0986\u09aa\u09a1\u09c7\u099f \u09ac\u09be\u0995\u09bf",noLimit:"\u09b8\u09c0\u09ae\u09be\u09b9\u09c0\u09a8",demoGraphics:{language:"\u09ad\u09be\u09b7\u09be",name:"\u09a8\u09be\u09ae",dob:"\u099c\u09a8\u09cd\u09ae\u09a4\u09bf\u09a5\u09bf",gender:"\u09b2\u09bf\u0999\u09cd\u0997",hof:"\u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 (\u098f\u0987\u099a\u0993\u098f\u09ab) \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u0986\u09aa\u09a1\u09c7\u099f",address:"\u09a0\u09bf\u0995\u09be\u09a8\u09be"}},documentDescriptionLinkText:"\u0986\u09aa\u09b2\u09cb\u09a1\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09bf\u0993\u0986\u0987/ \u09aa\u09bf\u0993\u098f/ \u09aa\u09bf\u0993\u09ac\u09bf \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u09ac\u09c8\u09a7 \u09a8\u09a5\u09bf\u09aa\u09a4\u09cd\u09b0\u0997\u09c1\u09b2\u09bf \u09a6\u09c7\u0996\u09c1\u09a8",proceedToUpdateAadhaar:"\u0986\u09a7\u09be\u09b0 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8",faq:"\u09aa\u09cd\u09b0\u09be\u09af\u09bc\u09b6\u0987 \u099c\u09bf\u099c\u09cd\u099e\u09be\u09b8\u09bf\u09a4 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8\u09be\u09ac\u09b2\u09c0"},dashboard:"\u09a1\u09cd\u09af\u09be\u09b6\u09ac\u09cb\u09b0\u09cd\u09a1\u09c7\u09b0",hof:{title:"\u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 (\u098f\u0987\u099a\u0993\u098f\u09ab) \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u0986\u09aa\u09a1\u09c7\u099f",description:"\u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09c7\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8",howItWorks:{step1:"\u0986\u09a7\u09be\u09b0 \u09a1\u09be\u099f\u09be\u09ac\u09c7\u09b8 \u09a5\u09c7\u0995\u09c7 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09a4 \u0995\u09b0\u09a4\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8\u09c7\u09b0  \u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c1\u09a8 \u0964 \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09e7\u09ee \u09ac\u099b\u09b0 \u09ac\u09be \u09a4\u09be\u09b0 \u09ac\u09c7\u09b6\u09bf \u09ac\u09af\u09bc\u09b8 \u0985\u09b0\u09cd\u099c\u09a8\u0995\u09be\u09b0\u09c0 \u0985\u09a7\u09bf\u09ac\u09be\u09b8\u09c0\u09b0\u09be \u098f\u0987\u099a\u098f\u09ab \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u09ac\u09bf\u09ac\u09c7\u099a\u09bf\u09a4 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964",step2:'\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a8( \u09aa\u09bf\u0993\u0986\u09b0) \u09a8\u09a5\u09bf\u09aa\u09a4\u09cd\u09b0 \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8 ,\u09af\u09be\u09a4\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8\u09c7\u09b0 \u09a8\u09be\u09ae \u09b8\u09b9 \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09be\u09ae \u09b8\u09cd\u09aa\u09b7\u09cd\u099f\u09ad\u09be\u09ac\u09c7 \u0989\u09b2\u09cd\u09b2\u09bf\u0996\u09bf\u09a4 \u09b0\u09af\u09bc\u09c7\u099b\u09c7 | \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u098f\u0987\u099a\u0993\u098f\u09ab \u098f\u09b0 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u099f\u09bf \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8 , \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa \u09af\u09a6\u09bf \u098f\u0987\u099a\u0993\u098f\u09ab \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u09ac\u09be\u09ae\u09c0 \u09b9\u09af\u09bc \u09a4\u09ac\u09c7 "\u09b8\u09cd\u09ac\u09be\u09ae\u09c0" \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\u0964',step3:"\u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u09b6\u09c1\u09b2\u09cd\u0995 \u09b8\u09cd\u09ac\u09b0\u09c2\u09aa \u09eb\u09e6 \u099f\u09be\u0995\u09be (\u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09aa\u099e\u09cd\u099a\u09be\u09b6 \u099f\u09be\u0995\u09be) \u09a6\u09bf\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964\u0986\u09aa\u09a8\u09bf \u0995\u09cd\u09b0\u09c7\u09a1\u09bf\u099f/\u09a1\u09c7\u09ac\u09bf\u099f \u0995\u09be\u09b0\u09cd\u09a1 \u09ac\u09be \u09a8\u09c7\u099f \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995\u09bf\u0982\u09af\u09bc\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0985\u09b0\u09cd\u09a5\u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964\u098f\u0987 \u0985\u09b0\u09cd\u09a5\u099f\u09bf \u0985-\u09ab\u09c7\u09b0\u09a4\u09af\u09cb\u0997\u09cd\u09af.",step4:"\u09af\u0996\u09a8 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09a4\u09be\u09b9\u09be\u09b0 myAadhaar \u09aa\u09cb\u09b0\u09cd\u099f\u09be\u09b2\u09c7 \u09b2\u0997 \u0987\u09a8 \u0995\u09b0\u09ac\u09c7\u09a8, \u09a4\u0996\u09a8 \u0989\u09a8\u09bf \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09b6\u09c7\u09df\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099f\u09bf \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09aa\u09be\u09ac\u09c7\u09a8, \u09af\u09c7\u099f\u09be \u0989\u09a8\u09bf \u0997\u09cd\u09b0\u09b9\u09a3 \u09ac\u09be \u0985\u09b8\u09cd\u09ac\u09c0\u0995\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964\u098f\u0987\u099a\u0993\u098f\u09ab \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u0997\u09cd\u09b0\u09b9\u09a3 / \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u0996\u09cd\u09af\u09be\u09a8 \u0995\u09b0\u09be\u09b0 \u098f\u0987 \u09ac\u09bf\u0995\u09b2\u09cd\u09aa\u099f\u09bf \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09a4\u09c8\u09b0\u09bf\u09b0 \u09a4\u09be\u09b0\u09bf\u0996 \u09a5\u09c7\u0995\u09c7 \u09e9\u09e6\u09a6\u09bf\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09c8\u09a7 \u09b9\u09ac\u09c7\u0964"},currentSection:{title:"\u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u098f\u0987\u099a\u0993\u098f\u09ab-\u098f\u09b0 \u09ac\u09bf\u09b6\u09a6 \u09ac\u09bf\u09ac\u09b0\u09a3"},updateSection:{forms:{hofUid:{label:"\u098f\u0987\u099a\u0993\u098f\u09ab-\u098f\u09b0 \u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c1\u09a8 "},mobileField:{label:"\u098f\u0987\u099a\u0993\u098f\u09ab-\u098f\u09b0 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a8\u09ae\u09cd\u09ac\u09b0"},documentUpload:{label:"\u09ac\u09c8\u09a7 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8\u0995\u09be\u09b0\u09c0 \u09a8\u09a5\u09bf\u09b0 \u09aa\u09cd\u09b0\u0995\u09be\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8"},relationshipDropdown:{label:"\u0986\u09ac\u09c7\u09a6\u09a8\u0995\u09be\u09b0\u09c0\u09b0 \u09b8\u09be\u09a5\u09c7 \u098f\u0987\u099a\u0993\u098f\u09ab-\u098f\u09b0 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8",values:{father:"\u09aa\u09bf\u09a4\u09be ",mother:"\u09ae\u09be ",husband:"\u09b8\u09cd\u09ac\u09be\u09ae\u09c0",wife:"\u09b8\u09cd\u09a4\u09cd\u09b0\u09c0",guardian:"\u0985\u09ad\u09bf\u09ad\u09be\u09ac\u0995",Others:"\u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af"}}}}},documentInfoPopup:{title:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u0995\u09b0\u09a4\u09c7 \u098f\u0995\u099f\u09bf \u09ac\u09c8\u09a7 \u09a8\u09a5\u09bf \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8",identityDocumentInfo:"\u09af\u09a6\u09bf \u09a8\u09a5\u09bf\u099f\u09bf \u09aa\u09b0\u09bf\u099a\u09af\u09bc \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b9\u09af\u09bc \u09a4\u09ac\u09c7 \u098f\u099f\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09be\u09ae\u09c7 \u09b9\u0993\u09af\u09bc\u09be \u0989\u099a\u09bf\u09a4 \u098f\u09ac\u0982 \u098f\u0995\u099f\u09bf \u099b\u09ac\u09bf \u09a5\u09be\u0995\u09be \u0989\u099a\u09bf\u09a4\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8 \u09af\u09c7 \u09ab\u09b0\u09cd\u09ae\u09c7 \u0989\u09b2\u09cd\u09b2\u09bf\u0996\u09bf\u09a4 '\u09a8\u09be\u09ae' \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u09a8\u09a5\u09bf\u09a4\u09c7 '\u09a8\u09be\u09ae'-\u098f\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ae\u09c7\u09b2 \u0996\u09be\u099a\u09cd\u099b\u09c7 \u0964",addressDocumentInfo:"\u09af\u09a6\u09bf \u09a8\u09a5\u09bf\u099f\u09bf \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b9\u09af\u09bc \u09a4\u09ac\u09c7 \u098f\u099f\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09be\u09ae\u09c7 \u09b9\u0993\u09af\u09bc\u09be \u0989\u099a\u09bf\u09a4\u0964\u09b8\u09cd\u09a4\u09cd\u09b0\u09c0, \u0985\u09ad\u09bf\u09ad\u09be\u09ac\u0995 \u09ac\u09be \u09aa\u09bf\u09a4\u09be\u09ae\u09be\u09a4\u09be\u09b0 \u09a8\u09be\u09ae\u09c7 \u09a8\u09a5\u09bf \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09be \u09b9\u09ac\u09c7 \u09a8\u09be\u0964\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8 \u09af\u09c7 \u09ab\u09b0\u09cd\u09ae\u09c7 \u0989\u09aa\u09b0\u09c7 \u0989\u09b2\u09cd\u09b2\u09bf\u0996\u09bf\u09a4 '\u09a0\u09bf\u0995\u09be\u09a8\u09be' \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u09a8\u09a5\u09bf\u09a4\u09c7 '\u09a0\u09bf\u0995\u09be\u09a8\u09be'-\u098f\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ae\u09c7\u09b2 \u0996\u09be\u099a\u09cd\u099b\u09c7 \u0964",close:"\u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09c1\u09a8",continueToUpload:"\u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u099a\u09be\u09b2\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8"},forms:{reUseDocText:"\u0986\u09aa\u09a8\u09bf \u0987\u09a4\u09bf\u09ae\u09a7\u09cd\u09af\u09c7 \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u09a8\u09bf\u09ae\u09cd\u09a8\u09b2\u09bf\u0996\u09bf\u09a4 \u09a6\u09b8\u09cd\u09a4\u09be\u09ac\u09c7\u099c\u0997\u09c1\u09b2\u09bf \u09aa\u09c1\u09a8\u09b0\u09be\u09af\u09bc \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964",stepper:{language:"\u09ad\u09be\u09b7\u09be",Name:"\u09a8\u09be\u09ae",dob:"\u099c\u09a8\u09cd\u09ae\u09a4\u09bf\u09a5\u09bf",gender:"\u09b2\u09bf\u0999\u09cd\u0997",address:"\u09a0\u09bf\u0995\u09be\u09a8\u09be",preview:"\u09aa\u09c2\u09b0\u09cd\u09ac\u09a6\u09b0\u09cd\u09b6\u09a8",payment:"\u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f"},formButtons:{back:"\u09aa\u09bf\u099b\u09a8\u09c7",next:"\u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0",makePayment:"\u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u0995\u09b0\u09c1\u09a8",retry:"\u09aa\u09c1\u09a8\u09b0\u09be\u09af\u09bc \u0985\u09b0\u09cd\u09a5 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8\u09c7\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8",goToDashboard:"\u09a1\u09cd\u09af\u09be\u09b6\u09ac\u09cb\u09b0\u09cd\u09a1\u09c7 \u09af\u09be\u09a8"},languageForm:{currentSection:{title:"\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09b8\u09cd\u09a5\u09be\u09a8\u09c0\u09af\u09bc \u09ad\u09be\u09b7\u09be \u09ac\u09bf\u09ac\u09b0\u09a3",fields:{currentLocalLanguage:"\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09b8\u09cd\u09a5\u09be\u09a8\u09c0\u09af\u09bc \u09ad\u09be\u09b7\u09be"}},updateSection:{title:"\u09a8\u09a4\u09c1\u09a8 \u09b8\u09cd\u09a5\u09be\u09a8\u09c0\u09af\u09bc \u09ad\u09be\u09b7\u09be \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0