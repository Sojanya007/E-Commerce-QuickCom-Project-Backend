928\u093e\u092e\u093e\u0902\u0915\u0928 \u0914\u0930 \u0905\u0926\u094d\u092f\u0924\u0928) \u0935\u093f\u0928\u093f\u092f\u092e, 2016 \u0915\u0947 \u0935\u093f\u0928\u093f\u092f\u092e 27 \u0915\u0947 \u0924\u0939\u0924 \u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e",part2:"\u0915\u094b \u0930\u0926\u094d\u0926 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948"}},aadhaar:"\u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e ",descText:"\u0906\u0927\u093e\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u092a\u0942\u0930\u094d\u0923"}},offlineEkyc:{title:"\u0911\u092b\u093c\u0932\u093e\u0907\u0928 eKYC",title1:"4 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0936\u0947\u092f\u0930 \u0915\u094b\u0921 \u092c\u0928\u093e\u090f\u0902",title2:"\u092c\u0927\u093e\u0908 \u0939\u094b!!",stepper:{setCode:"\u0915\u094b\u0921 \u0938\u0947\u091f \u0915\u0930\u0947\u0902",download:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921"},button:{back:"\u0935\u093e\u092a\u0938",download:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921",goToDashboard:"\u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u092a\u0930 \u091c\u093e\u090f\u0902"},invalidShareCode:"Invalid Share Code! Please retry with correct share code.",shareCode:{title:"\u090f\u0915 \u0936\u0947\u092f\u0930 \u0915\u094b\u0921 \u092c\u0928\u093e\u090f\u0902",descText:"\u0906\u092a\u0915\u0947 eKYC \u0935\u093e\u0932\u0940 \u090f\u0915 \u091c\u093c\u093f\u092a \u092b\u093c\u093e\u0907\u0932 \u0915\u094b \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u0936\u0947\u092f\u0930 \u0915\u094b\u0921 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0924\u0947 \u0939\u0940 \u092b\u093e\u0907\u0932 \u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938/\u0921\u0947\u0938\u094d\u0915\u091f\u0949\u092a \u092e\u0947\u0902 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0939\u094b \u091c\u093e\u090f\u0917\u0940\u0964",placeholderText:"4 - \u0921\u093f\u091c\u093f\u091f \u0936\u0947\u092f\u0930 \u0915\u094b\u0921 \u092c\u0928\u093e\u092f\u093e \u091c\u093e\u0928\u093e \u0939\u0948"},success:{desc:"\u0938\u0947\u0935\u093e \u0915\u093e \u0932\u093e\u092d \u0909\u0920\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0936\u0947\u092f\u0930 \u0915\u0930\u0947\u0902",p1:"\u091c\u093c\u093f\u092a \u092b\u093c\u093e\u0907\u0932",p2:"\u0915\u094b\u0921 \u0936\u0947\u092f\u0930 \u0915\u0930\u0947",p3:"\u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0926\u093e\u0924\u093e \u0915\u0947 \u0938\u093e\u0925 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930",summary:"\u092f\u0939 \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0926\u093e\u0924\u093e\u0913\u0902 / \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0940 \u092e\u093e\u0902\u0917 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0940 \u0938\u0902\u0938\u094d\u0925\u093e (OVSE) \u0915\u094b \u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0928\u0947 \u092f\u093e \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0915\u0947 \u092c\u093f\u0928\u093e \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u0906\u0927\u093e\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0938\u0941\u0935\u093f\u0927\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0947\u0917\u093e\u0964"},descTextStep1:"\u0906\u0927\u093e\u0930 \u092a\u0947\u092a\u0930\u0932\u0947\u0938 \u0911\u092b\u0932\u093e\u0907\u0928 \u0908-\u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u090f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0914\u0930 \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u092f\u094b\u0917\u094d\u092f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u0939\u0948 \u091c\u093f\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0906\u0927\u093e\u0930 \u0927\u093e\u0930\u0915 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0939\u091a\u093e\u0928 \u0915\u0947 \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0935\u093f\u0935\u0930\u0923 \u092e\u0947\u0902 \u0928\u093e\u092e, \u092a\u0924\u093e, \u092b\u094b\u091f\u094b, \u0932\u093f\u0902\u0917, \u091c\u0928\u094d\u092e \u0924\u093f\u0925\u093f, \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0915\u093e \u0939\u0948\u0936, \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0908\u092e\u0947\u0932 \u092a\u0924\u0947 \u0915\u093e \u0939\u0948\u0936 \u0914\u0930 \u0938\u0902\u0926\u0930\u094d\u092d \u0906\u0908\u0921\u0940 \u0939\u094b\u0917\u093e \u091c\u093f\u0938\u092e\u0947\u0902 \u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u0947 \u0905\u0902\u0924\u093f\u092e 4 \u0905\u0902\u0915 \u0939\u094b\u0902\u0917\u0947 \u0914\u0930 \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 \u0921\u093f\u091c\u093f\u091f\u0932 \u0930\u0942\u092a \u0938\u0947 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930\u093f\u0924 \u090f\u0915\u094d\u0938\u090f\u092e\u090f\u0932 \u092e\u0947\u0902 \u091f\u093e\u0907\u092e \u0938\u094d\u091f\u0948\u0902\u092a \u0939\u094b\u0917\u093e\u0964",descTextStep2:"\u0911\u092b\u093c\u0932\u093e\u0907\u0928 eKYC \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0940 \u091c\u093c\u093f\u092a \u092b\u093c\u093e\u0907\u0932 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930 \u0932\u0940 \u0917\u0908 \u0939\u0948"},lockUnlockBiometrics:{serviceCard:{errorMessage:"\u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902 \u091c\u092c \u0924\u0915 \u0939\u092e \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0938\u094d\u0925\u093f\u0924\u093f \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"},howItWorks:{title:"\u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u092c\u0949\u092f\u094b\u092e\u0940\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0915\u0948\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948",description:"\u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0938\u0941\u0935\u093f\u0927\u093e \u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u0947 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0921\u0947\u091f\u093e \u0915\u0947 \u0938\u0902\u092d\u093e\u0935\u093f\u0924 \u0926\u0941\u0930\u0941\u092a\u092f\u094b\u0917 \u0915\u094b \u0930\u094b\u0915\u0924\u0940 \u0939\u0948\u0964 \u0932\u0949\u0915 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u094b \u0930\u094b\u0915\u0924\u093e \u0939\u0948\u0964 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0938\u0947\u0935\u093e\u0913\u0902 \u0938\u0947 \u0907\u0928\u0915\u093e\u0930 \u0915\u094b \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938 \u0938\u0947\u0935\u093e \u0915\u0947 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0938\u093e\u0935\u0927\u093e\u0928\u0940 \u0938\u0947 \u0910\u0938\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u093e\u0935\u0927\u093e\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",infoData:{stepOneDescription:"\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0947 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0915\u094b \u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0938\u0947 \u0907\u0938 \u0938\u0947\u0935\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964 \u091c\u092c \u0906\u092a \u0905\u092a\u0928\u0947 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 (\u092b\u093c\u093f\u0902\u0917\u0930\u092a\u094d\u0930\u093f\u0902\u091f, \u0906\u0908\u0930\u093f\u0938 \u0914\u0930 \u091a\u0947\u0939\u0930\u0947) \u0915\u094b \u0932\u0949\u0915 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0909\u0928\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0939\u093e\u0932\u093e\u0901\u0915\u093f, \u0913\u091f\u0940\u092a\u0940-\u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e\u0928\u0941\u0938\u093e\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0930\u0939\u0947\u0917\u093e\u0964",stepTwoDescription:"\u0915\u0943\u092a\u092f\u093e \u0907\u0938 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u0935\u093e\u092a\u0938 \u0932\u094c\u091f\u0947\u0902 \u0914\u0930 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0917\u0947 \u092c\u0922\u093c\u0947\u0902\u0964 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0906\u092a\u0915\u093e \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 (\u092b\u093f\u0902\u0917\u0930\u092a\u094d\u0930\u093f\u0902\u091f + \u0906\u0908\u0930\u093f\u0938 + \u092b\u0947\u0938) \u0913\u091f\u0940\u092a\u0940 \u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0915\u094d\u0937\u092e \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964"}},selectionScreen:{unlockCard:{heading:"\u0915\u0943\u092a\u092f\u093e \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091a\u092f\u0928 \u0915\u0930\u0947\u0902",consentText:"\u092e\u0948\u0902 \u0938\u092e\u091d\u0924\u093e/\u0938\u092e\u091d\u0924\u0940 \u0939\u0942\u0902 \u0915\u093f \u0905\u092a\u0928\u093e \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092e\u0948\u0902 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930 \u0938\u0915\u0942\u0902\u0917\u093e.",label:"\u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u0902"},lockCard:{heading:"\u0915\u0943\u092a\u092f\u093e \u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091a\u0941\u0928\u0947\u0902",consentText:"\u092e\u0948\u0902 \u0938\u092e\u091d\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0905\u092a\u0928\u093e \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u091c\u092c \u0924\u0915 \u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e, \u0924\u092c \u0924\u0915 \u092e\u0948\u0902 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0928\u0939\u0940\u0902 \u0915\u0930 \u092a\u093e\u090a\u0902\u0917\u093e\u0964",label:"\u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0932\u0949\u0915 \u0915\u0930\u0947"},selectOptionError:"\u0915\u0943\u092a\u092f\u093e \u0915\u0947\u0935\u0932 \u090f\u0915 \u0935\u093f\u0915\u0932\u094d\u092a \u091a\u0941\u0928\u0947\u0902",selectButton:{tempUnlock:"\u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0915\u094b \u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u0902",tempUnlockInfo:"\u0915\u092e \u0938\u092e\u092f \u0905\u0935\u0927\u093f \u0915\u0947 \u0932\u093f\u090f",unlock:"\u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0915\u094b \u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u0902",unlockInfo:"\u0905\u0917\u0932\u0940 \u092c\u093e\u0930 \u091c\u092c \u0924\u0915 \u0906\u092a \u0932\u0949\u0915 \u0928 \u0915\u0930\u0947\u0902"}},successScreen:{tempUnlockMessage:"\u092f\u0926\u093f \u0906\u092a \u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0938\u0947 \u0907\u0938 \u0938\u0947\u0935\u093e \u092a\u0930 \u092b\u093f\u0930 \u0938\u0947 \u091c\u093e\u090f\u0902\u0964"}},lockUnlockAadhaar:{howItWorks:{title:"\u0906\u0927\u093e\u0930 \u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0915\u0948\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948",infoData:{stepOneLabel:"\u091a\u0930\u0923 1/3: ",stepOneDescription:"\u0906\u0927\u093e\u0930 \u0915\u094b \u0932\u0949\u0915 / \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947, \u0915\u0943\u092a\u092f\u093e 16 \u0905\u0902\u0915\u094b\u0902 \u0915\u0940 \u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0906\u0908\u0921\u0940 (\u0935\u0940\u0906\u0908\u0921\u0940) \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0930\u0947\u0902, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0915\u0947\u0935\u0932 \u0935\u0940\u0906\u0908\u0921\u0940 \u092e\u0947\u0902 \u0906\u0927\u093e\u0930 \u0915\u094b \u0932\u0949\u0915 / \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0939\u0948\u0964 \u0906\u092a \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0938\u0947 \u091c\u0928\u0930\u0947\u091f \u0935\u0930\u094d\u091a\u0941\u0905\u0932 ID \u0938\u0947\u0935\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u092f\u093e 1947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 SMS \u092d\u0947\u091c\u0915\u0930 \u0905\u092a\u0928\u0947 VID \u091c\u0928\u0930\u0947\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 RVID [UID \u0915\u0947 \u0905\u0902\u0924\u093f\u092e 4 \u092f\u093e 8 \u0905\u0902\u0915] {\u0909\u0926\u093e.: RVID 1234}. ",stepOneLinkText:" \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902",stepTwoLabel:"\u091a\u0930\u0923 2/3: ",stepTwoDescription:"\u090f\u0915 \u092c\u093e\u0930 \u0906\u092a\u0915\u093e \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u092c\u0928 \u091c\u093e\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u0915\u0943\u092a\u092f\u093e \u0907\u0938 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u0935\u093e\u092a\u0938 \u0906\u090f\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u0915\u094b \u0905\u092a\u0928\u0947 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0938\u0947 \u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0917\u0947 \u092c\u0922\u093c\u0947\u0902, \u092b\u093f\u0930 \u091c\u092c \u092d\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u094b, \u0905\u092a\u0928\u0947 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0938\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0915\u0930\u0947\u0902, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0947 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0932\u0949\u0915 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0905\u0915\u094d\u0937\u092e \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964",stepThreeLabel:"\u091a\u0930\u0923 3/3: ",stepThreeDescription:"\u0915\u0943\u092a\u092f\u093e \u0907\u0938 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u0935\u093e\u092a\u0938 \u0906\u090f\u0902 \u0914\u0930 \u0906\u0927\u093e\u0930 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0917\u0947 \u092c\u0922\u093c\u0947\u0902; \u0915\u0947\u0935\u0932 VID \u092e\u0947\u0902 \u0906\u0927\u093e\u0930 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0939\u0948, \u091c\u092c\u0915\u093f \u0906\u0927\u093e\u0930 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092d\u0940 \u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e-\u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964"}},formScreen:{title:"\u0906\u0927\u093e\u0930 \u0915\u094b \u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0935\u093f\u0935\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",radioLabels:{lockAadhaar:"\u0906\u0927\u093e\u0930 \u0932\u0949\u0915 \u0915\u0930\u0947\u0902",unlockAadhaar:"\u0906\u0927\u093e\u0930 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u0902"},consent:{lockConsent:"\u092e\u0948\u0902 \u0938\u092e\u091d\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0905\u092a\u0928\u093e \u0906\u0927\u093e\u0930 \u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u092e\u0948\u0902 \u0915\u0947\u0935\u0932 \u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0906\u0908\u0921\u0940 (\u0935\u0940\u0906\u0908\u0921\u0940) \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930 \u092a\u093e\u090a\u0902\u0917\u093e, \u0928 \u0915\u093f \u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u093e\u0964",unlockConsent:"\u092e\u0948\u0902 \u0938\u092e\u091d\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0905\u092a\u0928\u093e \u0906\u0927\u093e\u0930 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u092e\u0948\u0902 \u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0906\u0908\u0921\u0940 (\u0935\u0940\u0906\u0908\u0921\u0940) \u0914\u0930 \u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e \u0926\u094b\u0928\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u0939\u094b \u091c\u093e\u090a\u0902\u0917\u093e\u0964"},textFields:{name:"\u092a\u0942\u0930\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",pincode:"\u092a\u093f\u0928\u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902"}}},verifyEmailMobile:{desc:"\u0915\u0943\u092a\u092f\u093e \u0908\u092e\u0947\u0932 / \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u0935\u093f\u0935\u0930\u0923 \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",verifyMobile:"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902",verifyEmail:"\u0908\u092e\u0947\u0932 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902",verifyEmailMobile:"\u0908\u092e\u0947\u0932/\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902"},bankLinkingStatus:{sectionTitle:"\u0906\u0927\u093e\u0930 \u092c\u0948\u0902\u0915 \u0932\u093f\u0902\u0915\u093f\u0902\u0917 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902",aadhaarNumber:"\u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e ",bankLinkingStatus:"\u092c\u0948\u0902\u0915 \u0932\u093f\u0902\u0915\u093f\u0902\u0917 \u0938\u094d\u0925\u093f\u0924\u093f",active:"\u0938\u0915\u094d\u0930\u093f\u092f",inactive:"\u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f",prevBankDetails:"\u092a\u093f\u091b\u0932\u093e \u092c\u0948\u0902\u0915 \u0932\u093f\u0902\u0915\u093f\u0902\u0917 \u0935\u093f\u0935\u0930\u0923",lastUpdatedDate:"\u0905\u0902\u0924\u093f\u092e \u0905\u0926\u094d\u092f\u0924\u0928 \u0924\u093f\u0925\u093f",failureMessage:"\u0907\u0938 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u092c\u0948\u0902\u0915 \u092e\u0948\u092a\u093f\u0902\u0917 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e",successMessage:"\u0906\u092a\u0915\u093e \u0906\u0927\u093e\u0930-\u092c\u0948\u0902\u0915 \u092e\u0948\u092a\u093f\u0902\u0917 \u0939\u094b \u0917\u092f\u093e \u0939\u0948",disclaimer:"\u0906\u0927\u093e\u0930 \u0932\u093f\u0902\u0915\u093f\u0902\u0917 \u0938\u094d\u0925\u093f\u0924\u093f \u090f\u0928\u092a\u0940\u0938\u0940\u0906\u0908 \u0938\u0930\u094d\u0935\u0930 \u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902, \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0940 \u0936\u0941\u0926\u094d\u0927\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u092f\u093e \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u093e\u0964 \u0907\u0938\u0915\u0947 \u0905\u0932\u093e\u0935\u093e \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u090f\u0928\u092a\u0940\u0938\u0940\u0906\u0908 \u0938\u0930\u094d\u0935\u0930 \u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u093f\u0938\u0940 \u092d\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u094b \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964",noRecordsAvailable:"\u0915\u094b\u0908 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902",checkWithBank:"\u0905\u092a\u0928\u093e \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0905\u092a\u0928\u0947 \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u0947 \u0938\u0947 \u0932\u093f\u0902\u0915 \u0915\u0930\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0947 \u092c\u0948\u0902\u0915 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902"},bankSeedingStatus:{AadhaarNumber:"\u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e",BankName:"\u092c\u0948\u0902\u0915 \u0915\u093e \u0928\u093e\u092e",BankSeedingStatus:"\u092c\u0948\u0902\u0915 \u0938\u0940\u0921\u093f\u0902\u0917 \u0938\u094d\u0925\u093f\u0924\u093f",LastUpdatedDate:"\u0905\u0902\u0924\u093f\u092e \u0905\u0926\u094d\u092f\u0924\u0928 \u0924\u093f\u0925\u093f",noRecordAlert:"\u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u094b \u0905\u092a\u0928\u0947 \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u0947 \u0938\u0947 \u091c\u094b\u0921\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0947 \u092c\u0948\u0902\u0915 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902",note:"\u0932\u093f\u0902\u0915 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u0917\u0908 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0928\u0947\u0936\u0928\u0932 \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0949\u0930\u092a\u094b\u0930\u0947\u0936\u0928 \u0911\u092b \u0907\u0902\u0921\u093f\u092f\u093e (\u090f\u0928\u092a\u0940\u0938\u0940\u0906\u0908) \u0915\u0947 \u0938\u0930\u094d\u0935\u0930 \u0938\u0947 \u0932\u0940 \u0917\u0908 \u0939\u0948\u0964 \u0907\u0938\u0915\u0940 \u0936\u0941\u0926\u094d\u0927\u0924\u093e \u0915\u0947 \u0932\u093f\u090f UIDAI \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948. \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0928\u0939\u0940\u0902 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964",ActiveText:"\u0938\u0915\u094d\u0930\u093f\u092f",InactiveText:"\u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f"},FAQ:{checkAadhaarPvcCardOrderStatus:[{question:"\u0906\u0927\u093e\u0930 \u0915\u0947 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0930\u0942\u092a \u0915\u094d\u092f\u093e \u0939\u0948\u0902 \u0914\u0930 \u0909\u0928\u0915\u0940 \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u090f\u0902 \u0915\u094d\u092f\u093e \u0939\u0948\u0902?",answer:"\u0906\u0927\u093e\u0930 \u0915\u0947 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0930\u0942\u092a \u0906\u0927\u093e\u0930 \u092a\u0924\u094d\u0930, \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921, \u0908-\u0906\u0927\u093e\u0930 \u0914\u0930 \u090f\u092e-\u0906\u0927\u093e\u0930 \u0939\u0948\u0902\u0964 \u0906\u0927\u093e\u0930 \u0915\u0947 \u0938\u092d\u0940 \u0930\u0942\u092a \u0938\u092e\u093e\u0928 \u0930\u0942\u092a \u0938\u0947 \u0935\u0948\u0927 \u0914\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u094d\u092f \u0939\u0948\u0902\u0964"},{question:"\u0915\u094d\u092f\u093e \u092e\u0948\u0902 \u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0947 \u0906\u0927\u093e\u0930 \u0915\u094b \u0930\u0916\u0928\u0947 \u0914\u0930 \u0909\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?",answer:"\u0939\u093e\u0901\u0964"},{question:"\u0911\u0930\u094d\u0921\u0930 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921' \u0938\u0947\u0935\u093e \u0915\u094d\u092f\u093e \u0939\u0948?",answer:"'\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0911\u0930\u094d\u0921\u0930' \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0926\u094d\u0935\u093e\u0930\u093e \u0936\u0941\u0930\u0942 \u0915\u0940 \u0917\u0908 \u090f\u0915 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u093e \u0939\u0948 \u091c\u094b \u0906\u0927\u093e\u0930 \u0927\u093e\u0930\u0915 \u0915\u094b \u0928\u093e\u092e\u092e\u093e\u0924\u094d\u0930 \u0936\u0941\u0932\u094d\u0915 \u0915\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u092a\u0930 \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u0935\u093f\u0935\u0930\u0923 \u0915\u094b \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u092a\u0930 \u092e\u0941\u0926\u094d\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964"},{question:"'\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921' \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u090f\u0902 \u0939\u0948\u0902",answer:"\u0907\u0938 \u0915\u093e\u0930\u094d\u0921 \u092e\u0947\u0902 \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u090f\u0902 \u0939\u0948\u0902 :\n \u091b\u0947\u0921\u093c\u091b\u093e\u0921\u093c \u0930\u0939\u093f\u0924 \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921\n \u0939\u094b\u0932\u094b\u0917\u094d\u0930\u093e\u092e\n \u0938\u0942\u0915\u094d\u0937\u094d\u092e \u092a\u093e\u0920\n \u0918\u094b\u0938\u094d\u091f \u0907\u092e\u0947\u091c \n \u0928\u093f\u0930\u094d\u0917\u092e \u0924\u093f\u0925\u093f \u0914\u0930 \u092e\u0941\u0926\u094d\u0930\u0923 \u0924\u093f\u0925\u093f \n \u0917\u093f\u0932\u094b\u091a \u092a\u0948\u091f\u0930\u094d\u0928\n \u0909\u092d\u0930\u093e \u0939\u0941\u0906 \u0906\u0927\u093e\u0930 \u0932\u094b\u0917\u094b"},{question:"'\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921' \u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u092f\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0936\u0941\u0932\u094d\u0915 \u0939\u0948\u0902?",answer:"\u092d\u0941\u0917\u0924\u093e\u0928 \u0936\u0941\u0932\u094d\u0915 50/- \u0930\u0941\u092a\u090f (\u091c\u0940\u090f\u0938\u091f\u0940 \u0914\u0930 \u0938\u094d\u092a\u0940\u0921 \u092a\u094b\u0938\u094d\u091f \u0936\u0941\u0932\u094d\u0915 \u0938\u0939\u093f\u0924) \u0939\u0948\u0964"},{question:"\u0915\u094b\u0908 \u0935\u094d\u092f\u0915\u094d\u0924\u093f '\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921' \u0915\u0947 \u0932\u093f\u090f \u0915\u0948\u0938\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948?",answer:"'\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921'' \u0915\u0947 \u0932\u093f\u090f \u0905\u0928\u0941\u0930\u094b\u0927 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u0940 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0935\u0947\u092c\u0938\u093e\u0907\u091f (https://www.uidai.gov.in \u092f\u093e https://myaadhaar.uidai.gov.in/genricPVC ) \u092f\u093e \u090f\u092e\u0906\u0927\u093e\u0930 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},{question:"\u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0915\u0947 \u091c\u0930\u093f\u090f \u0915\u0948\u0938\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0947\u0902?",answer:"\u0915\u0943\u092a\u092f\u093e https://uidai.gov.in \u092f\u093e https://myaadhaar.uidai.gov.in/genricPVC \u092a\u0930 \u091c\u093e\u090f\u0902 '\u0911\u0930\u094d\u0921\u0930 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921' \u0938\u0947\u0935\u093e \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964\n\u0905\u092a\u0928\u093e 12 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 (\u092f\u0942\u0906\u0908\u0921\u0940) \u092f\u093e 16 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u092a\u0939\u091a\u093e\u0928 \u0928\u0902\u092c\u0930 (\u0935\u0940\u0906\u0908\u0921\u0940) \u092f\u093e 28 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0906\u0908\u0921\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964\n\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\n\u092f\u0926\u093f \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u091f\u0940\u0913\u091f\u0940\u092a\u0940 \u0939\u0948, \u0924\u094b \u091a\u0947\u0915 \u092c\u0949\u0915\u094d\u0938 \u092e\u0947\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0915\u0947 \u0935\u093f\u0915\u0932\u094d\u092a '\u092e\u0947\u0930\u0947 \u092a\u093e\u0938 \u091f\u0940\u0913\u091f\u0940\u092a\u0940 \u0939\u0948' \u091a\u0941\u0928\u0947\u0902 \u0905\u0928\u094d\u092f\u0925\u093e '\u0913\u091f\u0940\u092a\u0940 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0947\u0902' \u092c\u091f\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964\n\u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0913\u091f\u0940\u092a\u0940/\u091f\u0940\u0913\u091f\u0940\u092a\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964\n'\u0928\u093f\u092f\u092e \u090f\u0935\u0902 \u0936\u0930\u094d\u0924\u0947\u0902' \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u091a\u0947\u0915 \u092c\u0949\u0915\u094d\u0938 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 (\u0928\u094b\u091f: \u0935\u093f\u0935\u0930\u0923 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u093e\u0907\u092a\u0930 \u0932\u093f\u0902\u0915 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902)\u0964\n\u0913\u091f\u0940\u092a\u0940/\u091f\u0940\u0913\u091f\u0940\u092a\u0940 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u092a\u0942\u0930\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f '\u0938\u092c\u092e\u093f\u091f' \u092c\u091f\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964\n\u0905\u0917\u0932\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930, \u092a\u0941\u0928\u0930\u094d\u092e\u0941\u0926\u094d\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0911\u0930\u094d\u0921\u0930 \u0926\u0947\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0928\u093f\u0935\u093e\u0938\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0947 \u0932\u093f\u090f \u0906\u0927\u093e\u0930 \u0935\u093f\u0935\u0930\u0923 \u0915\u093e \u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0917\u093e\u0964\n\u201c\u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0947\u0902\u201d \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u0906\u092a\u0915\u094b \u0915\u094d\u0930\u0947\u0921\u093f\u091f/\u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921, \u0928\u0947\u091f \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0914\u0930 \u092f\u0942\u092a\u0940\u0906\u0908 \u091c\u0948\u0938\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u0915\u0932\u094d\u092a\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0947\u092e\u0947\u0902\u091f \u0917\u0947\u091f\u0935\u0947 \u092a\u0947\u091c \u092a\u0930 \u092a\u0941\u0928\u0903 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964\n\u0938\u092b\u0932 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0947 \u092c\u093e\u0926, \u0921\u093f\u091c\u093f\u091f\u0932 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930 \u0935\u093e\u0932\u0940 \u0930\u0938\u0940\u0926 \u0924\u0948\u092f\u093e\u0930 \u0939\u094b \u091c\u093e\u090f\u0917\u0940 \u091c\u093f\u0938\u0947 \u0928\u093f\u0935\u093e\u0938\u0940 \u092a\u0940\u0921\u0940\u090f\u092b \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u092e\u0947\u0902 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u094b \u090f\u0938\u090f\u092e\u090f\u0938 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0938\u0947\u0935\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0928\u0902\u092c\u0930 \u092d\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u093e\u0964\n\u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902, \u092a\u0930 \u0928\u093f\u0935\u093e\u0938\u0940 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u092d\u0947\u091c\u0947 \u091c\u093e\u0928\u0947 \u0924\u0915 \u090f\u0938\u0906\u0930\u090f\u0928 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u094b \u091f\u094d\u0930\u0948\u0915 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n\u0921\u0940\u0913\u092a\u0940 \u0938\u0947 \u092d\u0947\u091c\u0947 \u091c\u093e\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u090f\u0921\u092c\u094d\u0932\u094d\u092f\u0942 \u0928\u0902\u092c\u0930 \u0935\u093e\u0932\u093e \u090f\u0938\u090f\u092e\u090f\u0938 \u092d\u0940 \u092d\u0947\u091c\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0928\u093f\u0935\u093e\u0938\u0940 \u0921\u0940\u0913\u092a\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u091c\u093e\u0915\u0930 \u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u094b \u091f\u094d\u0930\u0948\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},{question:"\u0917\u0948\u0930-\u092a\u0902\u091c\u0940\u0915\u0943\u0924/\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0948\u0938\u0947 \u0915\u0930\u0947\u0902\u0964",answer:"\u0915\u0943\u092a\u092f\u093e https://uidai.gov.in \u092f\u093e https://myaadhaar.uidai.gov.in/genricPVC \u092a\u0930 \u091c\u093e\u090f\u0902 ' \u0911\u0930\u094d\u0921\u0930 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921' \u0938\u0947\u0935\u093e \u092f\u093e \u090f\u092e\u0906\u0927\u093e\u0930 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902, \u0905\u092a\u0928\u093e 12 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 (\u092f\u0942\u0906\u0908\u0921\u0940) \u092f\u093e 28 \u0905\u0902\u0915\u094b\u0902 \u0915\u0940 \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0906\u0908\u0921\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\n\u091a\u0947\u0915 \u092c\u0949\u0915\u094d\u0938 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902 '\u092f\u0926\u093f \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u092c\u0949\u0915\u094d\u0938 \u092e\u0947\u0902 \u091a\u0947\u0915 \u0915\u0930\u0947\u0902'\u0964 \u0915\u0943\u092a\u092f\u093e \u0917\u0948\u0930-\u092a\u0902\u091c\u0940\u0915\u0943\u0924/\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964 \u0917\u0948\u0930-\u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0915\u0947 \u091c\u0930\u093f\u090f \u0911\u0930\u094d\u0921\u0930 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0928\u093f\u0935\u093e\u0938\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u093e\u0964 \u0911\u0930\u094d\u0921\u0930 \u0926\u0947\u0928\u0947 \u0915\u0947 \u092c\u093e\u0915\u0940 \u091a\u0930\u0923 \u0935\u0939\u0940 \u0939\u0948\u0902\u0964'"},{question:"\u0915\u093f\u0928 \u0924\u0930\u0940\u0915\u094b\u0902 \u0938\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948?",answer:"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902, \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0924\u0930\u0940\u0915\u094b\u0902 \u0938\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948:-\n\u0915\u094d\u0930\u0947\u0921\u093f\u091f \u0915\u093e\u0930\u094d\u0921\n\u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921\n\u0928\u0947\u091f \u092c\u0948\u0902\u0915\u093f\u0902\u0917\n\u092f\u0942\u092a\u0940\u0906\u0908\n\u092a\u0947\u091f\u0940\u090f\u092e"},{question:"\u090f\u0938\u0906\u0930\u090f\u0928 \u0915\u094d\u092f\u093e \u0939\u0948?",answer:"\u090f\u0938\u0906\u0930\u090f\u0928 14 \u0905\u0902\u0915\u094b\u0902 \u0915\u0940 \u0938\u0947\u0935\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u0902\u0916\u094d\u092f\u093e \u0939\u0948 \u091c\u094b \u0906\u0927\u093e\u0930 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0947 \u0932\u093f\u090f \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0938\u0943\u091c\u093f\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0924\u092c \u0938\u0943\u091c\u093f\u0924 \u0939\u094b\u0917\u0940 \u091c\u092c \u0906\u092a \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0917\u0947\u0964 \u0938\u0902\u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0915\u0947 \u092a\u0942\u0930\u094d\u0923 \u0939\u094b\u0928\u0947 \u0924\u0915 \u2018\u0930\u093f\u091c\u094d\u092f\u0942\u092e\u2019 \u0935\u093f\u0915\u0932\u094d\u092a \u0909\u092a\u0932\u092c\u094d\u0927 \u0930\u0939\u0947\u0917\u093e\u0964"},{question:"\u090f\u0921\u092c\u094d\u0932\u094d\u092f\u0942\u092c\u0940 \u0928\u0902\u092c\u0930 \u0915\u094d\u092f\u093e \u0939\u0948?",answer:"\u090f\u092f\u0930\u0935\u0947 \u092c\u093f\u0932 \u0928\u0902\u092c\u0930 \u090f\u0915 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u0928\u0902\u092c\u0930 \u0939\u0948 \u091c\u093f\u0938\u0947 \u0921\u0940\u0913\u092a\u0940 \u0905\u0930\u094d\u0925\u093e\u0924\u094d \u0907\u0902\u0921\u093f\u092f\u093e \u0938\u094d\u092a\u0940\u0921 \u092a\u094b\u0938\u094d\u091f \u0926\u094d\u0935\u093e\u0930\u093e \u0909\u0928\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u093f\u090f \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0905\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f/\u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u0947 \u0932\u093f\u090f \u0938\u0943\u091c\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"},{question:"\u0915\u094d\u092f\u093e \u0939\u094b\u0917\u093e \u092f\u0926\u093f \u0928\u093f\u0935\u093e\u0938\u0940 \u0905\u092a\u0928\u0947 \u0907\u091a\u094d\u091b\u093f\u0924 \u0935\u093f\u0935\u0930\u0923 \u0915\u0947 \u0938\u093e\u0925 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u092e\u0941\u0926\u094d\u0930\u093f\u0924 \u0915\u0930\u0935\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?",answer:"\u092f\u0926\u093f \u0928\u093f\u0935\u093e\u0938\u0940 \u092e\u0941\u0926\u094d\u0930\u093f\u0924 \u0906\u0927\u093e\u0930 \u092a\u0924\u094d\u0930 \u092f\u093e \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0915\u0947 \u0935\u093f\u0935\u0930\u0923 \u092e\u0947\u0902 \u0915\u0941\u091b \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0948, \u0924\u094b \u0909\u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u094d\u0925\u093e\u092f\u0940 \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0915\u0947\u0902\u0926\u094d\u0930 \u092f\u093e \u090f\u0938\u090f\u0938\u092f\u0942\u092a\u0940 \u092a\u094b\u0930\u094d\u091f\u0932 (\u0905\u092a\u0921\u0947\u091f \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930) \u092a\u0930 \u091c\u093e\u0915\u0930 \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u0915\u094b \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e \u0914\u0930 \u0905\u092a\u0921\u0947\u091f \u0938\u092b\u0932 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0939\u0940 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0915\u0947 \u0932\u093f\u090f \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964"},{question:"\u0938\u092b\u0932 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0947 \u092c\u093e\u0926 '\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921' \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0915\u093f\u0924\u0928\u0947 \u0926\u093f\u0928 \u0932\u0917\u0947\u0902\u0917\u0947?",answer:"\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0915\u0947 \u0932\u093f\u090f \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0926\u094d\u0935\u093e\u0930\u093e \u0911\u0930\u094d\u0921\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 5 \u0915\u093e\u0930\u094d\u092f \u0926\u093f\u0935\u0938 (\u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0940 \u0924\u093e\u0930\u0940\u0916 \u0915\u094b \u091b\u094b\u0921\u093c\u0915\u0930) \u0915\u0947 \u092d\u0940\u0924\u0930 \u092e\u0941\u0926\u094d\u0930\u093f\u0924 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u0921\u093e\u0915 \u0935\u093f\u092d\u093e\u0917 (\u0921\u0940\u0913\u092a\u0940) \u0915\u0947 \u0938\u0941\u092a\u0941\u0930\u094d\u0926 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0921\u093e\u0915 \u0935\u093f\u092d\u093e\u0917 \u0915\u0947 \u0935\u093f\u0924\u0930\u0923 \u092e\u093e\u0928\u0926\u0902\u0921\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0930\u0942\u092a \u092d\u093e\u0930\u0924\u0940\u092f \u0921\u093e\u0915 \u0915\u0940 \u0938\u094d\u092a\u0940\u0921 \u092a\u094b\u0938\u094d\u091f \u0938\u0947\u0935\u093e \u0915\u0947 \u091c\u0930\u093f\u090f \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0915\u094b \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u092e\u0947\u0902 \u0909\u0928\u0915\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092a\u0924\u0947 \u092a\u0930 \u0928\u093f\u0935\u093e\u0938\u093f\u092f\u094b\u0902 \u0915\u094b \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 https://www.indiapost.gov.in/_layouts/15/dop. portal.tracking/ trackconsignment.aspx \u092a\u0930 \u0921\u0940\u0913\u092a\u0940 \u0938\u094d\u091f\u0947\u091f\u0938 \u091f\u094d\u0930\u0948\u0915 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0926\u094d\u0935\u093e\u0930\u093e \u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"}],verifyEmailMobile:[{question:"\u0915\u094d\u092f\u093e \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0935\u093f\u0935\u0930\u0923 \u0915\u094b \u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0936\u0941\u0932\u094d\u0915 \u0926\u0947\u0928\u093e \u0939\u094b\u0917\u093e?",answer:"\u091c\u0940 \u0939\u093e\u0902, \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u094b \u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u094b 50/- \u0930\u0941\u092a\u090f (\u091c\u0940\u090f\u0938\u091f\u0940 \u0938\u0939\u093f\u0924) \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964"}],orderAadhaarPvcCard:[{question:"\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0915\u0939\u093e\u0902 \u0938\u0947 \u0908-\u0906\u0927\u093e\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948?",answer:"\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u0947 \u092e\u093e\u0908\u0906\u0927\u093e\u0930 \u092a\u094b\u0930\u094d\u091f\u0932 - https://myaadhaar.uidai.gov.in \u092a\u0930 \u091c\u093e\u0915\u0930 \u092f\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u092b\u094b\u0928 \u0915\u0947 \u0932\u093f\u090f \u090f\u092e\u0906\u0927\u093e\u0930 \u0910\u092a \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0926\u094d\u0935\u093e\u0930\u093e \n\u0908-\u0906\u0927\u093e\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"}],retrieveEidAadhaarNumber:[{question:"\u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e \u0915\u094b \u0915\u093f\u0924\u0928\u0940 \u092c\u093e\u0930 \u0905\u0926\u094d\u092f\u0924\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948?",answer:"\u0906\u0927\u093e\u0930 \u0938\u0942\u091a\u0928\u093e \u0915\u0947 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0938\u0940\u092e\u093e\u090f\u0902 \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0939\u0948\u0902 :\n\u0928\u093e\u092e : \u091c\u0940\u0935\u0928 \u0915\u093e\u0932 \u092e\u0947\u0902 \u0926\u094b \u092c\u093e\u0930\n\u0932\u093f\u0902\u0917 : \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u090f\u0915 \u092c\u093e\u0930\n\u091c\u0928\u094d\u092e\u0924\u093f\u0925\u093f : \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u090f\u0915 \u092c\u093e\u0930"},{question:"\u0915\u094d\u092f\u093e \u092e\u0948\u0902 \u0906\u0927\u093e\u0930 \u092e\u0947\u0902 \u0905\u092a\u0928\u0947 \u0928\u093e\u092e \u092e\u0947\u0902 \u092c\u0926\u0932\u093e\u0935 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0902?",answer:"\u0905\u092a\u0928\u0947 \u0928\u093e\u092e \u092e\u0947\u0902 \u092e\u093e\u092e\u0942\u0932\u0940 \u0938\u0941\u0927\u093e\u0930 \u092f\u093e \u0928\u093e\u092e \u092e\u0947\u0902 \u092c\u0926\u0932\u093e\u0935 \u0915\u0947 \u0932\u093f\u090f, \u0915\u0943\u092a\u092f\u093e \u0928\u093f\u0915\u091f\u0924\u092e \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u091c\u093e\u090f\u0902\u0964"},{question:"\u0911\u0928\u0932\u093e\u0907\u0928 \u092a\u0924\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0947 \u0932\u093f\u090f \u0915\u094c\u0928 \u0938\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0902?",answer:"\u0938\u0939\u093e\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0940 \u0938\u0942\u091a\u0940 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092a\u0940\u0913\u090f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0917\u0940\u0964 https://uidai.gov.in \u092a\u0930 \u091c\u093e\u090f\u0902"},{question:"\u0906\u0927\u093e\u0930 \u092a\u0924\u0947 \u092e\u0947\u0902 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0947 \u0932\u093f\u090f \u0915\u094c\u0928 \u0938\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948?",answer:"\u0938\u0939\u093e\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u0940 \u0938\u0942\u091a\u0940 \u092f\u0939\u093e\u0902 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948, \u091c\u093f\u0928\u092e\u0947\u0902 \u0938\u0947 \u0906\u092a \u091a\u092f\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \n\u0915\u0943\u092a\u092f\u093e \u0938\u0942\u091a\u0940 \u0938\u0947 \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0921\u0947\u091f\u093e \u0938\u0941\u0927\u093e\u0930 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0909\u0938\u0915\u0940 \u0938\u094d\u0915\u0948\u0928/\u091b\u0935\u093f \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0947\u0902\u0964"},{question:"\u092a\u0924\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u093e \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902, \u092e\u0948\u0902 \u0915\u093f\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u0905\u092a\u0928\u0947 \u0938\u0939\u093e\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u0915\u094b \u091c\u092e\u093e \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?",answer:"\u0906\u092a\u0915\u094b \u0905\u0926\u094d\u092f\u0924\u0928 \u092a\u0924\u093e \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u093e \u092e\u0947\u0902 \u0938\u0939\u093e\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0940 \u0938\u094d\u0915\u0948\u0928/\u091b\u0935\u093f \u0915\u094b \u092a\u0940\u0921\u0940\u090f\u092b \u092f\u093e \u091c\u0947\u092a\u0940\u0908\u091c\u0940 \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u092e\u0947\u0902 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0939\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0905\u092a\u0928\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u092a\u0930 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0938\u0939\u0940 \u0938\u0939\u093e\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964 \u092a\u093e\u0938\u092a\u094b\u0930\u094d\u091f, \u0915\u093f\u0930\u093e\u092f\u093e \u0914\u0930 \u0938\u0902\u092a\u0924\u094d\u0924\u093f \u0905\u0928\u0941\u092c\u0902\u0927 \u091c\u0948\u0938\u0947 \u0915\u0941\u091b \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f, \u090f\u0915\u093e\u0927\u093f\u0915 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u0915\u0940 \u091b\u0935\u093f \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0917\u0940\u0964"},{question:"\u0915\u094d\u092f\u093e \u092e\u0948\u0902 \u0905\u0926\u094d\u092f\u0924\u0928 \u0906\u0927\u093e\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u093e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0905\u092a\u0928\u0940 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092d\u093e\u0937\u093e \u0915\u094b \u0905\u0926\u094d\u092f\u0924\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0902?",answer:"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0906\u092a \u0911\u0928\u0932\u093e\u0907\u0928 \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0905\u092a\u0928\u0940 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092d\u093e\u0937\u093e \u0915\u094b \u0905\u092a\u0921\u0947\u091f \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},{question:"\u0915\u094d\u092f\u093e \u092e\u0948\u0902 \u0906\u0927\u093e\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u093e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0905\u092a\u0928\u0940 \u091c\u0928\u094d\u092e\u0924\u093f\u0925\u093f \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0902?",answer:"\u0928\u0939\u0940\u0902, \u091c\u0928\u094d\u092e\u0924\u093f\u0925\u093f (\u0921\u0940\u0913\u092c\u0940) \u0905\u0926\u094d\u092f\u0924\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0921\u0940\u0913\u092c\u0940 \u092a\u094d\u0930\u092e\u093e\u0923 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0947 \u0938\u093e\u0925 \u0928\u093f\u0915\u091f\u0924\u092e \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u091c\u093e\u090f\u0902\u0964"},{question:"\u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u092e\u0947\u0902 \u091c\u0928\u094d\u092e\u0924\u093f\u0925\u093f \u090f\u0915 \u092c\u093e\u0930 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930 \u0932\u0940 \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u092e\u0948\u0902 \u0907\u0938\u0947 \u0905\u0926\u094d\u092f\u0924\u093f\u0924/ \u0938\u0939\u0940 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?",answer:"\u0928\u0939\u0940\u0902\u0964 \u0906\u092a \u0905\u092a\u0928\u0940 \u091c\u0928\u094d\u092e\u0924\u093f\u0925\u093f (\u0921\u0940\u0913\u092c\u0940) \u0915\u094b \u0915\u0947\u0935\u0932 \u090f\u0915 \u092c\u093e\u0930 \u0939\u0940 \u0905\u0926\u094d\u092f\u0924\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938\u0915\u0947 \u0905\u0932\u093e\u0935\u093e \u091c\u0928\u094d\u092e\u0924\u093f\u0925\u093f (\u0921\u0940\u0913\u092c\u0940) \u0915\u094b \u0905\u0938\u093e\u0927\u093e\u0930\u0923 \u092a\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u092c\u0926\u0932\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948, \u0915\u0943\u092a\u092f\u093e \u0907\u0938 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 1947 \u092a\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902\u0964"},{question:"\u0915\u094d\u092f\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0928\u0947 \u0938\u0947 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0938\u0942\u091a\u0928\u093e \u0915\u0947 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0940 \u0917\u093e\u0930\u0902\u091f\u0940 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948?",answer:"\u0938\u0942\u091a\u0928\u093e \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0928\u093e \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e \u0915\u0947 \u0905\u092a\u0921\u0947\u091f \u0915\u0940 \u0917\u093e\u0930\u0902\u091f\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964\u0905\u0926\u094d\u092f\u0924\u0928 \u0906\u0927\u093e\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u093e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u093f\u0924 \u0921\u0947\u091f\u093e \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0914\u0930 \u092a\u0941\u0937\u094d\u091f\u093f\u0915\u0930\u0923 \u0915\u0947 \u0905\u0927\u094d\u092f\u0927\u0940\u0928 \u0939\u0948 \u0914\u0930 \u092a\u0941\u0937\u094d\u091f\u093f\u0915\u0930\u0923 \u0915\u0947 \u092c\u093e\u0926 \u0939\u0940 \u0906\u0927\u093e\u0930 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0906\u0917\u0947 \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"},{question:"\u092e\u0947\u0930\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0917\u0941\u092e \u0939\u094b \u0917\u092f\u093e \u0939\u0948/\u092e\u0947\u0930\u0947 \u092a\u093e\u0938 \u0905\u092c \u0935\u0939 \u0928\u0902\u092c\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948 \u091c\u093f\u0938\u0947 \u092e\u0948\u0902\u0928\u0947 \u0906\u0927\u093e\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u092e\u0948\u0902 \u0915\u093f\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u0905\u092a\u0928\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?",answer:"\u0906\u0927\u093e\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0916\u094b\u0928\u0947/\u0905\u092c \u0905\u092a\u0928\u0947 \u092a\u093e\u0938 \u0928 \u0939\u094b\u0928\u0947 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902, \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0930\u0942\u092a \u0938\u0947 \u0928\u093f\u0915\u091f\u0924\u092e \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u091c\u093e\u0928\u093e \u0939\u094b\u0917\u093e\u0964"},{question:"\u0915\u094d\u092f\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0947 \u092c\u093e\u0926 \u092e\u0947\u0930\u093e \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u092c\u0926\u0932 \u091c\u093e\u090f\u0917\u093e?",answer:"\u091c\u0940 \u0928\u0939\u0940\u0902, \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0947 \u092c\u093e\u0926 \u092d\u0940 \u0906\u092a\u0915\u093e \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0935\u0939\u0940 \u0930\u0939\u0947\u0917\u093e\u0964"},{question:"\u092e\u0948\u0902 \u0905\u0926\u094d\u092f\u0924\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902\u0964 \u0915\u094d\u092f\u093e \u092e\u0948\u0902 \u0910\u0938\u093e \u0915\u0930 \u092a\u093e\u090a\u0902\u0917\u093e?",answer:"\u0915\u094b\u0908 \u0928\u093f\u0935\u093e\u0938\u0940 \u092e\u093e\u0908\u0906\u0927\u093e\u0930 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u092e\u0947\u0902 \u2018\u0905\u0928\u0941\u0930\u094b\u0927\u2019 \u0916\u0902\u0921 \u0938\u0947 \u0905\u0926\u094d\u092f\u0924\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0924\u092c \u0924\u0915 \u0930\u0926\u094d\u0926 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948 \u091c\u092c \u0924\u0915 \u0909\u0938\u0947 \u0905\u0917\u0932\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947 \u0932\u093f\u090f \u0906\u0917\u0947 \u0928\u0939\u0940\u0902 \u092c\u0922\u093c\u093e\u092f\u093e \u091c\u093e\u0924\u093e\u0964 \u092f\u0926\u093f \u0907\u0938\u0947 \u0930\u0926\u094d\u0926 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u0924\u094b \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0940 \u0917\u0908 \u0930\u093e\u0936\u093f 21 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u0935\u093e\u092a\u0938 \u0915\u0930 \u0926\u0940 \u091c\u093e\u090f\u0917\u0940\u0964"},{question:"\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0938\u092d\u0940 \u0905\u0926\u094d\u092f\u0924\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0939\u093e\u0901 \u0926\u0947\u0916 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?",answer:"\u090f\u0915 \u0928\u093f\u0935\u093e\u0938\u0940 \u0905\u092a\u0928\u0947 \u0905\u0926\u094d\u092f\u0924\u0928 \u0905\u0928\u0941\u0930\u094b\u0927\u094b\u0902 \u0915\u094b \u092e\u093e\u0908\u0906\u0927\u093e\u0930 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0915\u0947 \u0905\u0902\u0926\u0930 '\u0905\u0928\u0941\u0930\u094b\u0927' \u0916\u0902\u0921 \u0915\u0947 \u0905\u0902\u0926\u0930 \u0926\u0947\u0916 \u0938\u0915\u0924\u093e \u0939\u0948\u0964"},{question:"\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u092a\u0924\u0947 \u092e\u0947\u0902 \u0905\u092a\u0928\u0947 \u092a\u093f\u0924\u093e/\u092a\u0924\u093f \u0915\u093e \u0928\u093e\u092e \u0915\u0948\u0938\u0947 \u091c\u094b\u0921\u093c \u0938\u0915\u0924\u093e \u0939\u0942\u0902?",answer:"\u0906\u0927\u093e\u0930 \u092e\u0947\u0902 \u0938\u0902\u092c\u0902\u0927 \u0915\u093e \u0935\u093f\u0935\u0930\u0923, \u092a\u0924\u0947 \u0915\u093e \u090f\u0915 \u0905\u0902\u0936 \u0939\u0948\u0964 \u0907\u0938\u0947 \u092e\u093e\u0930\u094d\u092b\u0924 (\u0938\u0940/\u0913) \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092e\u093e\u0928\u0915\u0940\u0915\u0943\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0907\u0938\u0947 \u092d\u0930\u0928\u093e \u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u0939\u0948\u0964"}],bookAnAppointment:[{question:"\u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u092e\u0947\u0902 \u0936\u093f\u0915\u093e\u092f\u0924 \u0928\u093f\u0935\u093e\u0930\u0923 \u091a\u0948\u0928\u0932 \u0915\u094d\u092f\u093e \u0939\u0948\u0902?",answer:"\u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0905\u092a\u0928\u0940 \u0936\u093f\u0915\u093e\u092f\u0924 \u0915\u0947 \u0928\u093f\u0935\u093e\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u0947 \u0915\u0908 \u092e\u093e\u0927\u094d\u092f\u092e\u094b\u0902 \u091c\u0948\u0938\u0947 \u092b\u094b\u0928, \u0908\u092e\u0947\u0932, \u091a\u0948\u091f, \u092a\u0924\u094d\u0930/\u092a\u094b\u0938\u094d\u091f, \u0935\u0947\u092c \u092a\u094b\u0930\u094d\u091f\u0932, \u0935\u0949\u0915-\u0907\u0928 \u0914\u0930 \u0938\u094b\u0936\u0932 \u092e\u0940\u0921\u093f\u092f\u093e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n\u0909\u092a\u0932\u092c\u094d\u0927 \u091a\u0948\u0928\u0932\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0928\u093f\u092e\u094d\u0928 \u092a\u094d\u0930\u0915\u093e\u0930 \u0939\u0948:\n\u092b\u093c\u094b\u0928 \u0915\u0949\u0932 (\u091f\u094b\u0932 \u092b\u094d\u0930\u0940 \u0928\u0902\u092c\u0930) -\n\u0906\u0927\u093e\u0930 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u091f\u094b\u0932 \u092b\u094d\u0930\u0940 \u0928\u0902\u092c\u0930 (1947) \u092a\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0947\u0902\u0926\u094d\u0930 \u092e\u0947\u0902 \u0938\u094d\u0935\u092f\u0902 \u0938\u0947\u0935\u093e \u0906\u0908\u0935\u0940\u0906\u0930\u090f\u0938 (\u0907\u0902\u091f\u0930\u090f\u0915\u094d\u091f\u093f\u0935 \u0935\u0949\u092f\u0938 \u0930\u093f\u0938\u094d\u092a\u093e\u0902\u0938 \u0938\u093f\u0938\u094d\u091f\u092e) \u0914\u0930 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u093e\u0930\u094d\u092f\u0915\u093e\u0930\u0940 \u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u0939\u093e\u092f\u0924\u093e \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0964 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0905\u092a\u0928\u0940 \u0938\u0939\u091c\u0924\u093e \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0938\u0902\u091a\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u0928\u0940\u091a\u0947 \u0926\u0940 \u0917\u0908 \u0915\u093f\u0938\u0940 \u092d\u0940 \u092d\u093e\u0937\u093e \u0915\u093e \u091a\u092f\u0928 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n\u0939\u093f\u0902\u0926\u0940\n\u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940\n\u0924\u0947\u0932\u0941\u0917\u0941\n\u0924\u092e\u093f\u0932\n\u0915\u0928\u094d\u0928\u0921\u093c\n\u092e\u0932\u092f\u093e\u0932\u092e\n\u0905\u0938\u092e\u093f\u092f\u093e\n\u092c\u0902\u0917\u0932\u093e\n\u0917\u0941\u091c\u0930\u093e\u0924\u0940\n\u092e\u0930\u093e\u0920\u0940 \n\u092a\u0902\u091c\u093e\u092c\u0940\n\u0913\u0921\u093f\u092f\u093e \n\u0938\u092e\u092f :\n\u0915) \u0906\u0908\u0935\u0940\u0906\u0930\u090f\u0938 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0938\u094d\u0935\u092f\u0902 \u0938\u0947\u0935\u093e \u0915\u093e \u0932\u093e\u092d \u0909\u0920\u093e\u0928\u093e : \u0906\u0908\u0935\u0940\u0906\u0930\u090f\u0938 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0938\u0947\u0935\u093e\u090f\u0902 24X7 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0938\u094d\u0935\u092f\u0902 \u0938\u0947\u0935\u093e \u0935\u093f\u0927\u093f \u092e\u0947\u0902 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0902\u0964\n\u0916) \u0915\u093e\u0930\u094d\u092f\u0915\u093e\u0930\u0940 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0947\u0902 : \u0907\u0938 \u0938\u0947\u0935\u093e \u0915\u093e \u0932\u093e\u092d \u0938\u094b\u092e\u0935\u093e\u0930 \u0938\u0947 \u0936\u0928\u093f\u0935\u093e\u0930 : \u0938\u0941\u092c\u0939 7 \u092c\u091c\u0947 \u0938\u0947 \u0930\u093e\u0924 11 \u092c\u091c\u0947 \u0924\u0915, \u0930\u0935\u093f\u0935\u093e\u0930 : \u0938\u0941\u092c\u0939 8 \u092c\u091c\u0947 \u0938\u0947 \u0936\u093e\u092e 5 \u092c\u091c\u0947 \u0924\u0915 \u0932\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u093e \u0938\u092e\u093e\u0927\u093e\u0928 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0928\u0941\u092e\u094b\u0926\u093f\u0924 \u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e\u0913\u0902 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u093e\u0930\u094d\u092f\u0915\u093e\u0930\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0936\u093f\u0915\u093e\u092f\u0924\u094b\u0902 \u0915\u094b \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0938\u092e\u092f \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092a\u094d\u0930\u092d\u093e\u0917\u094b\u0902/\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f\u094b\u0902 \u0915\u094b \u0938\u094c\u0902\u092a\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0928 \u0936\u093f\u0915\u093e\u092f\u0924\u094b\u0902 \u0915\u0947 \u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092a\u094d\u0930\u092d\u093e\u0917/\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f\u094b\u0902 \u092e\u0947\u0902 \u0906\u0902\u0924\u0930\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u091c\u093e\u0902\u091a \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948 \u0914\u0930 \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u094b \u0938\u0942\u091a\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n2. \u091a\u0948\u091f\u092c\u0949\u091f (\u0906\u0927\u093e\u0930 \u092e\u093f\u0924\u094d\u0930) - \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u091a\u0948\u091f\u092c\u0949\u091f \u0938\u0947\u0935\u093e '\u0906\u0927\u093e\u0930 \u092e\u093f\u0924\u094d\u0930' \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0906\u0927\u093e\u0930 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0905\u092a\u0928\u0947 \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u094b \u0909\u0920\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u091c\u094b \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u0940 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964 \u0907\u0938 \u091a\u0948\u091f\u092c\u0949\u091f \u0915\u094b \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u093e \u0909\u0924\u094d\u0924\u0930 \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u0907\u0938\u0915\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0905\u0928\u0941\u092d\u0935 \u0915\u094b \u092c\u0947\u0939\u0924\u0930 \u092c\u0928\u093e\u0928\u093e \u0939\u0948\u0964\n \n3. \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0935\u0947\u092c \u092a\u094b\u0930\u094d\u091f\u0932 - \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u0936\u093f\u0915\u093e\u092f\u0924 \u0914\u0930 \u092b\u0940\u0921\u092c\u0948\u0915 \u090f\u0935\u0902 \u0936\u093f\u0915\u093e\u092f\u0924/\u092b\u0940\u0921\u092c\u0948\u0915 \u0915\u0940 \u091c\u093e\u0902\u091a \u0916\u0902\u0921 \u0915\u0947 \u0924\u0939\u0924 \u0905\u092a\u0928\u0940 \u0936\u093f\u0915\u093e\u092f\u0924 \u0926\u0930\u094d\u091c \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0909\u0938\u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n4. \u0908\u092e\u0947\u0932 - \u0906\u0927\u093e\u0930 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u094d\u0930\u0936\u094d\u0928 \u0914\u0930 \u0936\u093f\u0915\u093e\u092f\u0924 \u0915\u0947 \u0932\u093f\u090f \u0935\u094d\u092f\u0915\u094d\u0924\u093f help@uidai.gov.in \u092a\u0930 \u0908\u092e\u0947\u0932 \u092d\u0947\u091c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n \n5. \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f\u094b\u0902 \u092e\u0947\u0902 \u0935\u0949\u0915-\u0907\u0928: \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0905\u092a\u0928\u0947 \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u0947 \u0938\u092e\u093e\u0927\u093e\u0928 \u092f\u093e \u0906\u0927\u093e\u0930 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0936\u093f\u0915\u093e\u092f\u0924\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u0930\u093e\u091c\u094d\u092f \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0938\u0940\u0927\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f\u094b\u0902 \u092e\u0947\u0902 \u091c\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n6. \u092a\u094b\u0938\u094d\u091f/\u092a\u0924\u094d\u0930 : \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0905\u092a\u0928\u0940 \u0936\u093f\u0915\u093e\u092f\u0924\u0947\u0902 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u092a\u094d\u0930\u0927\u093e\u0928 \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u092f\u093e \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f\u094b\u0902 \u092e\u0947\u0902 \u0921\u093e\u0915 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0926\u0930\u094d\u091c \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u0939\u093e\u0925 \u0938\u0947 \u0906\u0935\u0947\u0926\u0928 \u091c\u092e\u093e \u0915\u0930\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f/\u092a\u094d\u0930\u092d\u093e\u0917 \u0936\u093f\u0915\u093e\u092f\u0924 \u0915\u0947 \u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930\u0947\u0917\u093e\u0964\n7. \u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930 \u0915\u093e \u0932\u094b\u0915 \u0936\u093f\u0915\u093e\u092f\u0924 \u092a\u094b\u0930\u094d\u091f\u0932 (\u0938\u0940\u092a\u0940\u091c\u0940\u0906\u0930\u090f\u090f\u092e\u090f\u0938) : \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u0915\u0943\u0924 \u0932\u094b\u0915 \u0936\u093f\u0915\u093e\u092f\u0924 \u0928\u093f\u0935\u093e\u0930\u0923 \u0914\u0930 \u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 (\u0938\u0940\u092a\u0940\u091c\u0940\u0906\u0930\u090f\u090f\u092e\u090f\u0938) \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u092e\u0947\u0902 \u0936\u093f\u0915\u093e\u092f\u0924\u0947\u0902 \u0926\u0930\u094d\u091c \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f 24x7 \u0909\u092a\u0932\u092c\u094d\u0927 \u090f\u0915 \u0911\u0928\u0932\u093e\u0907\u0928 \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0939\u0948\u0964\n \n8. \u0938\u094b\u0936\u0932 \u092e\u0940\u0921\u093f\u092f\u093e : \u0936\u093f\u0915\u093e\u092f\u0924\u0947\u0902 \u091f\u094d\u0935\u093f\u091f\u0930, \u092b\u0947\u0938\u092c\u0941\u0915, \u092f\u0942\u091f\u094d\u092f\u0942\u092c, \u0907\u0902\u0938\u094d\u091f\u093e\u0917\u094d\u0930\u093e\u092e \u0906\u0926\u093f \u091c\u0948\u0938\u0947 \u0915\u0908 \u0938\u094b\u0936\u0932 \u092e\u0940\u0921\u093f\u092f\u093e \u092a\u094d\u0932\u0947\u091f\u092b\u093e\u0930\u094d\u092e\u094b\u0902 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0926\u0930\u094d\u091c \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0902\u0964 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0905\u092a\u0928\u0947 \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902/\u0936\u093f\u0915\u093e\u092f\u0924\u094b\u0902 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092a\u094b\u0938\u094d\u091f \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u094b \u091f\u0948\u0917 \u0915\u0930\u0915\u0947 \u092f\u093e \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0938\u094b\u0936\u0932 \u092e\u0940\u0921\u093f\u092f\u093e \u0938\u094d\u091f\u094d\u0930\u0940\u092e \u092a\u0930 \u0938\u0939\u093e\u092f\u0924\u093e \u092a\u0943\u0937\u094d\u0920 \u0915\u094b \u0921\u0940\u090f\u092e \u0915\u0930\u0915\u0947 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},{question:"\u0915\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u0947\u0935\u093e \u0936\u0941\u0932\u094d\u0915 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0939\u0948\u0902?",answer:"\u091c\u0940 \u0928\u0939\u0940\u0902, \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u094b\u0902 \u0938\u0939\u093f\u0924 \u0926\u0947\u0936 \u0915\u0947 \u0938\u092d\u0940 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u094b\u0902 \u092a\u0930 \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u0947 \u0936\u0941\u0932\u094d\u0915 \u090f\u0915 \u0938\u092e\u093e\u0928 \u0939\u0948\u0964\n\u0936\u0941\u0932\u094d\u0915 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e : https://uidai.gov.in/images/ Aadhaar_Enrolment_and_Update_-_English.pdf \u0926\u0947\u0916\u0947\u0902\u0964"},{question:"\u0915\u094d\u092f\u093e \u092e\u0948\u0902 \u0905\u092a\u0928\u0940 \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u0915\u094b \u092a\u0941\u0928\u0930\u094d\u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924/\u0930\u0926\u094d\u0926 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?",answer:"\u091c\u0940 \u0939\u093e\u0902, \u0906\u092a \u0909\u0938\u0940 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930/\u0908\u092e\u0947\u0932 \u0906\u0908\u0921\u0940 (\u091c\u0948\u0938\u093e \u0915\u093f \u092a\u0939\u0932\u0947 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948) \u0915\u0947 \u0938\u093e\u0925 \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u092a\u094b\u0930\u094d\u091f\u0932 \u092a\u0930 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0915\u0947 24 \u0918\u0902\u091f\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u0915\u094b \u092a\u0941\u0928\u0930\u094d\u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},{question:"\u092e\u0948\u0902 \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0947 \u0915\u094c\u0928 \u0938\u0940 \u0938\u0947\u0935\u093e\u090f\u0902 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0902?",answer:"\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u092d\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0940 \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e\u090f\u0902 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u091c\u0948\u0938\u0947 \u0915\u093f\n1. \u0938\u092d\u0940 \u0906\u092f\u0941 \u0935\u0930\u094d\u0917 \u0915\u0947 \u0932\u093f\u090f \u0928\u092f\u093e \u0928\u093e\u092e\u093e\u0902\u0915\u0928\u0964\n2. \u0915\u093f\u0938\u0940 \u092d\u0940 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0938\u0942\u091a\u0928\u093e (\u0928\u093e\u092e, \u092a\u0924\u093e, \u0932\u093f\u0902\u0917, \u091c\u0928\u094d\u092e \u0924\u093f\u0925\u093f, \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0914\u0930 \u0908\u092e\u0947\u0932 \u0906\u0908\u0921\u0940) \u0915\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930\u0928\u093e\u0964\n3. \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u0938\u0942\u091a\u0928\u093e (\u092b\u094b\u091f\u094b, \u092b\u093f\u0902\u0917\u0930\u092a\u094d\u0930\u093f\u0902\u091f \u0914\u0930 \u0906\u0908\u0930\u093f\u0938 \u0938\u094d\u0915\u0948\u0928) \u0915\u093e \u0905\u0926\u094d\u092f\u0924\u0928\u0964\n4. \u092c\u091a\u094d\u091a\u094b\u0902 \u0915\u093e \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915 (5 \u0914\u0930 15 \u0935\u0930\u094d\u0937 \u0915\u0940 \u0906\u092f\u0941 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u092a\u0930) \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930\u0928\u093e\u0964\n5. \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u0926\u094d\u092f\u0924\u0928 (\u092a\u0940\u0913\u0906\u0908 \u0914\u0930 \u092a\u0940\u0913\u090f)\u0964\n6.\u0906\u0927\u093e\u0930 \u0916\u094b\u091c\u0947\u0902 \u0914\u0930 \u092a\u094d\u0930\u093f\u0902\u091f \u0915\u0930\u0947\u0902\u0964"},{question:"\u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u090f\u090f\u0938\u0915\u0947 (\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930) \u0915\u0940 \u0915\u094d\u092f\u093e \u0938\u092e\u092f-\u0938\u093e\u0930\u0923\u0940 \u0939\u0948?",answer:"\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f/\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u091b\u0941\u091f\u094d\u091f\u093f\u092f\u094b\u0902 \u0915\u094b \u091b\u094b\u0921\u093c\u0915\u0930 \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u0947 \u0938\u092d\u0940 7 \u0926\u093f\u0928 \u0916\u0941\u0932\u0947 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092e \u0924\u094c\u0930 \u092a\u0930 \u092f\u0939 \u0938\u0941\u092c\u0939 9:30 \u092c\u091c\u0947 \u0938\u0947 \u0936\u093e\u092e 5:30 \u092c\u091c\u0947 \u0924\u0915 (\u0906\u0908\u090f\u0938\u091f\u0940) \u0915\u094d\u0930\u093f\u092f\u093e\u0936\u0940\u0932 \u0930\u0939\u0924\u093e \u0939\u0948\u0964\n\u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u090f\u090f\u0938\u0915\u0947 \u0915\u0947 \u0905\u0932\u093e\u0935\u093e \u0905\u0928\u094d\u092f \u0906\u0927\u093e\u0930 \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0915\u0947\u0902\u0926\u094d\u0930 \u0905\u092a\u0928\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0930\u091c\u093f\u0938\u094d\u091f\u094d\u0930\u093e\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0938\u092e\u092f \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u091a\u093e\u0939\u0928\u0947 \u0935\u093e\u0932\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f/\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0905\u0927\u093f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u0928\u091c\u0926\u0940\u0915\u0940 \u0906\u0927\u093e\u0930 \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},{question:"\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 (\u090f\u090f\u0938\u0915\u0947) \u0915\u094d\u092f\u093e \u0939\u0948?",answer:"\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930' \u092f\u093e \u090f\u090f\u0938\u0915\u0947 \u0928\u093f\u0935\u093e\u0938\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u092d\u0940 \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u093f\u0902\u0917\u0932-\u0938\u094d\u091f\u0949\u092a \u0917\u0902\u0924\u0935\u094d\u092f \u0939\u0948\u0964 \u090f\u090f\u0938\u0915\u0947 \u0928\u093f\u0935\u093e\u0938\u093f\u092f\u094b\u0902 \u0915\u094b \u0905\u0924\u094d\u092f\u093e\u0927\u0941\u0928\u093f\u0915 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u092e\u0947\u0902 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0906\u0927\u093e\u0930 \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0914\u0930 \u0905\u0926\u094d\u092f\u0924\u0928 \u0938\u0947\u0935\u093e\u090f\u0901 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0928\u093f\u0935\u093e\u0938\u093f\u092f\u094b\u0902 \u0915\u094b \u0906\u0930\u093e\u092e\u0926\u093e\u092f\u0915 \u0935\u093e\u0924\u093e\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0938\u092d\u0940 \u090f\u090f\u0938\u0915\u0947 \u0935\u094d\u0939\u0940\u0932\u091a\u0947\u092f\u0930 \u0915\u0947 \u0905\u0928\u0941\u0915\u0942\u0932 \u0939\u0948\u0902 \u0914\u0930 \u092c\u0941\u091c\u0941\u0930\u094d\u0917\u094b\u0902 \u0914\u0930 \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 \u0935\u093f\u0915\u0932\u093e\u0902\u0917 \u0932\u094b\u0917\u094b\u0902 \u0915\u0940 \u0938\u0947\u0935\u093e \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u0936\u0947\u0937 \u092a\u094d\u0930\u093e\u0935\u0927\u093e\u0928 \u0939\u0948\u0902\u0964 \u090f\u090f\u0938\u0915\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0905\u0927\u093f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 https://uidai.gov.in/ \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964"},{question:"\u092e\u0941\u091d\u0947 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u090f\u090f\u0938\u0915\u0947 (\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930) \u0915\u0940 \u0938\u0942\u091a\u0940 \u0915\u0939\u093e\u0902 \u092e\u093f\u0932 \u0938\u0915\u0924\u0940 \u0939\u0948?",answer:"\u0938\u092d\u0940 \u0915\u093e\u0930\u094d\u092f\u093e\u0924\u094d\u092e\u0915 \u090f\u090f\u0938\u0915\u0947 \u0915\u0940 \u090f\u0915 \u0938\u092e\u0947\u0915\u093f\u0924 \u0938\u0942\u091a\u0940 \u092f\u0939 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948 : \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0942\u091a\u0940\n\u092f\u0947 \u090f\u090f\u0938\u0915\u0947 \u092c\u0948\u0902\u0915\u094b\u0902, \u0921\u093e\u0915\u0918\u0930\u094b\u0902, \u0938\u0940\u090f\u0938\u0938\u0940, \u092c\u0940\u090f\u0938\u090f\u0928\u090f\u0932 \u0914\u0930 \u0930\u093e\u091c\u094d\u092f \u0938\u0930\u0915\u093e\u0930\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0939\u0932\u0947 \u0938\u0947 \u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0906\u0927\u093e\u0930 \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0915\u0947\u0902\u0926\u094d\u0930\u094b\u0902 \u0915\u0947 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0902\u0964"}],checkEnrolmentUpdateStatus:[{question:"\u092e\u0948\u0902 \u0906\u0927\u093e\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u093e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0915\u093f\u0928 \u0935\u093f\u0935\u0930\u0923 \u0915\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0902?",answer:"\u0907\u0938 \u0911\u0928\u0932\u093e\u0907\u0928 \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947, \u0906\u092a \u0915\u0947\u0935\u0932 \u092a\u0924\u093e \u0914\u0930 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0905\u0928\u094d\u092f \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0947 \u0932\u093f\u090f, \u0915\u0943\u092a\u092f\u093e \u0928\u093f\u0915\u091f\u0924\u092e \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u091c\u093e\u090f\u0902\u0964"}],eaadhaarDownload:[{question:"\u0908-\u0906\u0927\u093e\u0930 \u0915\u094d\u092f\u093e \u0939\u0948?",answer:"\u0908-\u0906\u0927\u093e\u0930, \u0906\u0927\u093e\u0930 \u090f\u0915 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0902\u0930\u0915\u094d\u0937\u093f\u0924 \u090f\u0915 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u092a\u094d\u0930\u0924\u093f \u0939\u0948, \u091c\u093f\u0938 \u092a\u0930 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u0947 \u0938\u0915\u094d\u0937\u092e \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u093e\u0930\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0921\u093f\u091c\u093f\u091f\u0932 \u0930\u0942\u092a \u0938\u0947 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930 \u0915\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"},{question:"\u0915\u094d\u092f\u093e \u0908-\u0906\u0927\u093e\u0930, \u0906\u0927\u093e\u0930 \u0915\u0940 \u092d\u094c\u0924\u093f\u0915 \u092a\u094d\u0930\u0924\u093f \u0915\u0940 \u0924\u0930\u0939 \u0939\u0940 \u0935\u0948\u0927 \u0939\u0948?",answer:"\u0906\u0927\u093e\u0930 \u0905\u0927\u093f\u0928\u093f\u092f\u092e \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930, \u0908-\u0906\u0927\u093e\u0930 \u0938\u092d\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u0927\u093e\u0930 \u0915\u0940 \u092d\u094c\u0924\u093f\u0915 \u092a\u094d\u0930\u0924\u093f \u0915\u0940 \u0924\u0930\u0939 \u0938\u092e\u093e\u0928 \u0930\u0942\u092a \u0938\u0947 \u0935\u0948\u0927 \u0939\u0948\u0964 \u0908-\u0906\u0927\u093e\u0930 \u0915\u0940 \u0935\u0948\u0927\u0924\u093e \u0915\u0947 \u0932\u093f\u090f, \u0915\u0943\u092a\u092f\u093e \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u092a\u0930\u093f\u092a\u0924\u094d\u0930 \u0915\u0947 \u0932\u093f\u090f https://uidai.gov.in/images/uidai_ om_on_e_aadhaar_validity.pdf \u0915\u094b \u0926\u0947\u0916\u0947\u0902\u0964"},{question:"\u092e\u093e\u0938\u094d\u0915\u0921 \u0906\u0927\u093e\u0930 \u0915\u094d\u092f\u093e \u0939\u0948?",answer:"\u092e\u093e\u0938\u094d\u0915\u0921 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0938\u0947 \u0924\u093e\u0924\u094d\u092a\u0930\u094d\u092f \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u0947 \u092a\u0939\u0932\u0947 8 \u0905\u0902\u0915\u094b\u0902 \u0915\u094b 'xxxx-xxxx' \u0938\u0947 \u092c\u0926\u0932\u0928\u093e \u0939\u0948, \u0907\u0938\u092e\u0947\u0902 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u0947 \u0915\u0947\u0935\u0932 \u0905\u0902\u0924\u093f\u092e 4 \u0905\u0902\u0915 \u0939\u0940 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964"},{question:"\u0908-\u0906\u0927\u093e\u0930 \u092e\u0947\u0902 \u0921\u093f\u091c\u093f\u091f\u0932 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930 \u0915\u094b \u0915\u0948\u0938\u0947 \u0935\u093f\u0927\u093f\u092e\u093e\u0928\u094d\u092f \u0915\u0930\u0947\u0902?",answer:"\u0915\u0943\u092a\u092f\u093e \u0906\u0927\u093e\u0930 \u092f\u0942\u091f\u094d\u092f\u0942\u092c \u091a\u0948\u0928\u0932 \u092a\u0930 \u091c\u093e\u090f\u0902 \u0914\u0930 \u091f\u094d\u092f\u0942\u091f\u094b\u0930\u093f\u092f\u0932 \u0932\u093f\u0902\u0915 https://youtu.be/aVNfUNIccZs?si= ByW1O6BIPMwc0seL \u0915\u094b \u0926\u0947\u0916\u0947\u0902\u0964"},{question:"\u0908-\u0906\u0927\u093e\u0930 \u0915\u093e \u0915\u094d\u092f\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0939\u0948?",answer:"\u0908-\u0906\u0927\u093e\u0930 \u0915\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0928\u093e\u092e \u0915\u0947 \u092a\u0939\u0932\u0947 4 \u0905\u0915\u094d\u0937\u0930 (\u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0915\u0947 \u092c\u0921\u093c\u0947 \u0905\u0915\u094d\u0937\u0930\u094b\u0902 \u092e\u0947\u0902) \u0914\u0930 \u091c\u0928\u094d\u092e \u0915\u0947 \u0935\u0930\u094d\u0937 (YYYY) \u0915\u093e \u0938\u0902\u092f\u094b\u091c\u0928 \u0939\u0948\u0964\n\u0909\u0926\u093e\u0939\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f :\n\u0909\u0926\u093e\u0939\u0930\u0923 1\n\u0928\u093e\u092e : SURESH KUMAR\n\u091c\u0928\u094d\u092e \u0915\u093e \u0935\u0930\u094d\u0937 : 1990\n\u092a\u093e\u0938\u0935\u0930\u094d\u0921 : SURE1990\n\u0909\u0926\u093e\u0939\u0930\u0923 2\n\u0928\u093e\u092e : SAI KUMAR\n\u091c\u0928\u094d\u092e \u0915\u093e \u0935\u0930\u094d\u0937 : 1990\n\u092a\u093e\u0938\u0935\u0930\u094d\u0921 : SAIK1990\n\u0909\u0926\u093e\u0939\u0930\u0923 3\n\u0928\u093e\u092e : P. KUMAR\n\u091c\u0928\u094d\u092e \u0915\u093e \u0935\u0930\u094d\u0937 : 1990\n\u092a\u093e\u0938\u0935\u0930\u094d\u0921 : P.KU1990\n\u0909\u0926\u093e\u0939\u0930\u0923 4\n\u0928\u093e\u092e : RIA\n\u091c\u0928\u094d\u092e \u0915\u093e \u0935\u0930\u094d\u0937 : 1990\n\u092a\u093e\u0938\u0935\u0930\u094d\u0921 : RIA1990"},{question:"\u0908-\u0906\u0927\u093e\u0930 \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0947 \u0938\u0939\u093e\u092f\u0915 \u0938\u0949\u092b\u093c\u094d\u091f\u0935\u0947\u092f\u0930 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948 ?",answer:"\u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u094b \u0908-\u0906\u0927\u093e\u0930 \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f '\u090f\u0921\u094b\u092c \u0930\u0940\u0921\u0930' \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u0947 \u0938\u093f\u0938\u094d\u091f\u092e \u092e\u0947\u0902 '\u090f\u0921\u094b\u092c \u0930\u0940\u0921\u0930' \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0939\u0948\u0964 \u0938\u093f\u0938\u094d\u091f\u092e \u092e\u0947\u0902 \u090f\u0921\u094b\u092c \u0930\u0940\u0921\u0930 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0932\u093f\u0902\u0915: https://get.adobe.com/reader/ \u092a\u0930 \u091c\u093e\u090f\u0902\u0964"},{question:"\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0915\u093f\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u0908-\u0906\u0927\u093e\u0930 \u0915\u094b \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948?",answer:"\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0924\u0940\u0928 \u0924\u0930\u0940\u0915\u094b\u0902 \u0938\u0947 \u0908-\u0906\u0927\u093e\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n\u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 :\n\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 :\n\u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 :\n\u0908-\u0906\u0927\u093e\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0930 \u0913\u091f\u0940\u092a\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u093e\u0964"}],checkAadhaarValidity:[{question:"\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0906\u0927\u093e\u0930 \u092a\u0924\u094d\u0930 \u0938\u0947 \u0915\u093f\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u092d\u093f\u0928\u094d\u0928 \u0939\u0948?",answer:"\u0906\u0927\u093e\u0930 \u092a\u0924\u094d\u0930 \u0932\u0947\u092e\u093f\u0928\u0947\u091f\u0947\u0921 \u0915\u093e\u0917\u091c \u0906\u0927\u093e\u0930\u093f\u0924 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u0939\u0948, \u091c\u093f\u0938\u0947 \u0928\u093f\u0935\u093e\u0938\u093f\u092f\u094b\u0902 \u0915\u094b \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0914\u0930 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0947 \u092c\u093e\u0926 \u091c\u093e\u0930\u0940 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u092a\u0940\u0935\u0940\u0938\u0940 \u0906\u0927\u093e\u0930\u093f\u0924 \u091f\u093f\u0915\u093e\u090a \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0906\u0938\u093e\u0928\u0940 \u0938\u0947 \u0932\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u0915\u093e\u0930\u094d\u0921 \u0939\u0948\u0964 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0938\u092e\u093e\u0928 \u0930\u0942\u092a \u0938\u0947 \u0935\u0948\u0927 \u0939\u0948\u0964"}],lockUnlockAadhaar:[{question:"\u092e\u0947\u0930\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 \u0905\u092e\u093e\u0928\u094d\u092f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0907\u0938\u0915\u093e \u0915\u094d\u092f\u093e \u092e\u0924\u0932\u092c \u0939\u0948?",answer:"\u0911\u0928\u0932\u093e\u0907\u0928 \u092a\u0924\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u090f \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0928\u093f\u092e\u094d\u0928 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u0939\u094b\u0928\u0947 \u091a\u093e\u0939\u093f\u090f : \n1. https://uidai.gov.in. \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0935\u0948\u0927 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \n2. \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f \n3. \u0905\u092a\u0932\u094b\u0921 \u0915\u0940 \u0917\u0908 \u091b\u0935\u093f \u0938\u094d\u092a\u0937\u094d\u091f \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f \u0914\u0930 \u092e\u0942\u0932 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u093e \u0930\u0902\u0917\u0940\u0928 \u0938\u094d\u0915\u0948\u0928 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964\n\u0928\u092f\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u0915\u093e \u0905\u0928\u0941\u092a\u093e\u0932\u0928 \u0915\u0930\u0928\u093e \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"},{question:"\u0906\u0927\u093e\u0930 (\u092f\u0942\u0906\u0908\u0921\u0940) \u0932\u0949\u0915 \u0914\u0930 \u0905\u0928\u0932\u0949\u0915 \u0915\u094d\u092f\u093e \u0939\u0948?",answer:"\u090f\u0915 \u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u0947 \u0932\u093f\u090f, \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0921\u0947\u091f\u093e \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0914\u0930 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0939\u092e\u0947\u0936\u093e \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u091a\u093f\u0902\u0924\u093e \u0915\u093e \u0935\u093f\u0937\u092f \u0939\u0948\u0964 \u0909\u0938\u0915\u0947 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u094b \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0928\u0947 \u0914\u0930 \u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u094b \u0909\u0938\u0915\u093e \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 (\u092f\u0942\u0906\u0908\u0921\u0940) \u0915\u094b \u0932\u0949\u0915 \u0914\u0930 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0940 \u090f\u0915 \u0938\u0941\u0935\u093f\u0927\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964\n\u0928\u093f\u0935\u093e\u0938\u0940 \u0905\u092a\u0928\u093e \u0906\u0927\u093e\u0930 (\u092f\u0942\u0906\u0908\u0921\u0940) \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f www.myaadhaar.uidai.gov.in \u092f\u093e \u090f\u092e\u0906\u0927\u093e\u0930 \u0910\u092a \u0915\u0947 \u091c\u0930\u093f\u090f \u0932\u0949\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n\u0910\u0938\u093e \u0915\u0930\u0928\u0947 \u0938\u0947 \u0928\u093f\u0935\u093e\u0938\u0940 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938, \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0914\u0930 \u0913\u091f\u0940\u092a\u0940 \u092e\u094b\u0921\u0948\u0932\u093f\u091f\u0940 \u0915\u0947 \u0932\u093f\u090f \u092f\u0942\u0906\u0908\u0921\u0940, \u092f\u0942\u0906\u0908\u0921\u0940 \u091f\u094b\u0915\u0928 \u0914\u0930 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u093e \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n\u092f\u0926\u093f \u0928\u093f\u0935\u093e\u0938\u0940 \u092f\u0942\u0906\u0908\u0921\u0940 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0948 \u0924\u094b \u0935\u0939 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092f\u093e \u090f\u092e\u0906\u0927\u093e\u0930 \u0910\u092a \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0928\u0935\u0940\u0928\u0924\u092e \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0910\u0938\u093e \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n\u0906\u0927\u093e\u0930 (\u092f\u0942\u0906\u0908\u0921\u0940) \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u0928\u093f\u0935\u093e\u0938\u0940 \u092f\u0942\u0906\u0908\u0921\u0940, \u092f\u0942\u0906\u0908\u0921\u0940 \u091f\u094b\u0915\u0928 \u0914\u0930 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964"},{question:"\u0928\u093f\u0935\u093e\u0938\u0940 \u092f\u0942\u0906\u0908\u0921\u0940 \u0915\u0948\u0938\u0947 \u0932\u0949\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902?",answer:"\u092f\u0942\u0906\u0908\u0921\u0940 \u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u0947 \u092a\u093e\u0938 16 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0928\u0902\u092c\u0930 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u0914\u0930 \u092f\u0939 \u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0942\u0930\u094d\u0935-\u0905\u092a\u0947\u0915\u094d\u0937\u093f\u0924 \u0939\u0948\u0964 \u092f\u0926\u093f \u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u0947 \u092a\u093e\u0938 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0928\u0939\u0940\u0902 \u0939\u0948 \u0924\u094b \u0935\u0939 \u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u0947\u0935\u093e \u092f\u093e \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0935\u0947\u092c\u0938\u093e\u0907\u091f (www.myaadhaar.uidai.gov.in) \u0915\u0947 \u091c\u0930\u093f\u090f \u0907\u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n\u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u0947\u0935\u093e : \u091c\u0940\u0935\u0940\u0906\u0908\u0921\u0940 \u0938\u094d\u092a\u0947\u0938 \u092f\u0942\u0906\u0908\u0921\u0940 \u0915\u0947 \u0905\u0902\u0924\u093f\u092e 4 \u092f\u093e 8 \u0905\u0902\u0915 \u0915\u094b 1947 \u092a\u0930 \u090f\u0938\u090f\u092e\u090f\u0938 \u0915\u0930\u0947\u0902\u0964 \u0909\u0926\u093e\u0939\u0930\u0923- \u091c\u0940\u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b1234\n\u0928\u093f\u0935\u093e\u0938\u0940 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f (https://resident.uidai.gov.in/aadhaar-lockunlock) \u092a\u0930 \u091c\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u092e\u093e\u0908 \u0906\u0927\u093e\u0930 \u091f\u0948\u092c \u0915\u0947 \u0924\u0939\u0924, \u0906\u0927\u093e\u0930 \u0932\u0949\u0915 \u0914\u0930 \u0905\u0928\u0932\u0949\u0915 \u0938\u0947\u0935\u093e\u0913\u0902 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u092f\u0942\u0906\u0908\u0921\u0940 \u0932\u0949\u0915 \u0930\u0947\u0921\u093f\u092f\u094b \u092c\u091f\u0928 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0928\u0935\u0940\u0928\u0924\u092e \u0935\u093f\u0935\u0930\u0923 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092f\u0942\u0906\u0908\u0921\u0940 \u0928\u0902\u092c\u0930, \u092a\u0942\u0930\u093e \u0928\u093e\u092e \u0914\u0930 \u092a\u093f\u0928 \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964 \u0938\u0947\u0902\u0921 \u0913\u091f\u0940\u092a\u0940 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902 \u092f\u093e \u091f\u0940\u0913\u091f\u0940\u092a\u0940 \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0938\u092c\u092e\u093f\u091f \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u0906\u092a\u0915\u093e \u092f\u0942\u0906\u0908\u0921\u0940 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0932\u0949\u0915 \u0915\u0930 \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964"},{question:"\u0928\u093f\u0935\u093e\u0938\u0940 \u092f\u0942\u0906\u0908\u0921\u0940 \u0915\u0948\u0938\u0947 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902?",answer:"\u092f\u0942\u0906\u0908\u0921\u0940 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u0947 \u092a\u093e\u0938 \u0928\u0935\u0940\u0928\u0924\u092e 16 \u0905\u0902\u0915\u094b\u0902 \u0915\u0940 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f \u0914\u0930 \u092f\u0926\u093f \u0928\u093f\u0935\u093e\u0938\u0940 16 \u0905\u0902\u0915\u094b\u0902 \u0915\u0940 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u092d\u0942\u0932 \u0917\u092f\u093e \u0939\u0948 \u0924\u094b \u0935\u0939 \u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u0947\u0935\u093e \u0915\u0947 \u091c\u0930\u093f\u090f \u0928\u0935\u0940\u0928\u0924\u092e \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n\u0906\u0930\u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0938\u094d\u092a\u0947\u0938 \u092f\u0942\u0906\u0908\u0921\u0940 \u0915\u0947 \u0905\u0902\u0924\u093f\u092e 4 \u092f\u093e 8 \u0905\u0902\u0915 \u0915\u094b 1947 \u092a\u0930 \u090f\u0938\u090f\u092e\u090f\u0938 \u0915\u0930\u0947\u0902\u0964 \u0909\u0926\u093e\u0939\u0930\u0923- \u0906\u0930\u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b1234\n\u092f\u0942\u0906\u0908\u0921\u0940 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0928\u093f\u0935\u093e\u0938\u0940 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f (https://resident.uidai. gov.in/aadhaar-lockunlock ) \u092a\u0930 \u091c\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u0905\u0928\u0932\u0949\u0915 \u0930\u0947\u0921\u093f\u092f\u094b \u092c\u091f\u0928 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902, \u0928\u0935\u0940\u0928\u0924\u092e \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u0947\u0902\u0921 \u0913\u091f\u0940\u092a\u0940 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902 \u092f\u093e \u091f\u0940\u0913\u091f\u0940\u092a\u0940 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u092c\u092e\u093f\u091f \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u0906\u092a\u0915\u093e \u092f\u0942\u0906\u0908\u0921\u0940 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0905\u0928\u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964\n\u0928\u093f\u0935\u093e\u0938\u0940 \u090f\u092e\u0906\u0927\u093e\u0930 \u0910\u092a \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092d\u0940 \u0906\u0927\u093e\u0930 \u0932\u0949\u0915 \u092f\u093e \u0905\u0928\u0932\u0949\u0915 \u0938\u0947\u0935\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"}],grievanceAndFeedback:[],generateOrRetrieveVid:[{question:"\u092e\u0948\u0902 \u0905\u092a\u0928\u093e \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u092d\u0942\u0932 \u0917\u092f\u093e \u0939\u0942\u0902\u0964 \u092f\u0942\u0906\u0908\u0921\u0940 \u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092e\u0948\u0902 \u0907\u0938\u0947 \u0915\u0948\u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0902?",answer:"\u092f\u0942\u0906\u0908\u0921\u0940 \u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092f\u0926\u093f \u0928\u093f\u0935\u093e\u0938\u0940 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u092d\u0942\u0932 \u0917\u092f\u093e \u0939\u0948, \u0924\u094b \u0928\u093f\u0935\u093e\u0938\u0940 16 \u0905\u0902\u0915\u094b\u0902 \u0935\u093e\u0932\u0940 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u0947\u0935\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u094b \u0909\u0938\u0915\u0947 \u0930\u091c\u093f\u0938\u094d\u091f\u0930 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0930 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u0940\u0964\n\u0906\u0927\u093e\u0930 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0938\u0947 \u0906\u0930\u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0938\u094d\u092a\u0947\u0938 \u092f\u0942\u0906\u0908\u0921\u0940 \u0915\u0947 \u0905\u0902\u0924\u093f\u092e 4 \u092f\u093e 8 \u0905\u0902\u0915 \u0915\u094b 1947 \u092a\u0930 \u090f\u0938\u090f\u092e\u090f\u0938 \u0915\u0930\u0947\u0902\u0964\n\u0909\u0926\u093e\u0939\u0930\u0923 :- \u0906\u0930\u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b1234"},{question:"\u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0906\u0908\u0921\u0940 (\u0935\u0940\u0906\u0908\u0921\u0940) \u0915\u094d\u092f\u093e \u0939\u0948?",answer:"\u0935\u0940\u0906\u0908\u0921\u0940 \u090f\u0915 \u0905\u0938\u094d\u0925\u093e\u092f\u0940, \u092a\u094d\u0930\u0924\u093f\u0938\u0902\u0939\u0930\u0923\u0940\u092f 16-\u0905\u0902\u0915\u0940\u092f \u092f\u093e\u0926\u0943\u091a\u094d\u091b\u093f\u0915 \u0938\u0902\u0916\u094d\u092f\u093e \u0939\u0948, \u091c\u093f\u0938\u0947 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092e\u0948\u092a \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u092f\u093e \u0908-\u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0938\u0947\u0935\u093e\u090f\u0902 \u0928\u093f\u0937\u094d\u092a\u093e\u0926\u093f\u0924 \u0915\u093f\u090f \u091c\u093e\u0928\u0947 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u0947 \u092c\u0926\u0932\u0947 \u0935\u0940\u0906\u0908\u0921\u0940 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0905\u0928\u0941\u0930\u0942\u092a \u0939\u0940 \u0935\u0940\u0906\u0908\u0921\u0940 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0935\u0940\u0906\u0908\u0921\u0940 \u0938\u0947 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u093e \u0938\u0902\u092d\u0935 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"},{question:"\u0915\u094b\u0908 \u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u093f\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u0935\u0940\u0906\u0908\u0921\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0924\u093e \u0939\u0948?",answer:"\u0935\u0940\u0906\u0908\u0921\u0940 \u0915\u094b \u0915\u0947\u0935\u0932 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0926\u094d\u0935\u093e\u0930\u093e \u0939\u0940 \u0938\u0943\u091c\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0928\u093f\u0935\u093e\u0938\u0940 \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u0905\u092a\u0928\u0940 \u0935\u0940\u0906\u0908\u0921\u0940 \u0915\u094b \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u0925\u093e\u092a\u093f\u0924 (\u0928\u0908 \u0935\u0940\u0906\u0908\u0921\u0940 \u0938\u0943\u091c\u093f\u0924) \u092d\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u092f \u090f\u0915 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u0947 \u0932\u093f\u090f \u0915\u0947\u0935\u0932 \u090f\u0915 \u0935\u0940\u0906\u0908\u0921\u0940 \u092e\u093e\u0928\u094d\u092f \u0939\u094b\u0917\u0940\u0964 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915\u094b\u0902 \u0915\u094b \u0905\u092a\u0928\u0940 \u0935\u0940\u0906\u0908\u0921\u0940 \u0938\u0943\u091c\u093f\u0924 \u0915\u0930\u0928\u0947, \u092d\u0942\u0932\u0928\u0947 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0935\u0940\u0906\u0908\u0921\u0940 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0914\u0930 \u0905\u092a\u0928\u0940 \u0935\u0940\u0906\u0908\u0921\u0940 \u0915\u094b \u0928\u090f \u0928\u0902\u092c\u0930 \u0938\u0947 \u092c\u0926\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0935\u093f\u0915\u0932\u094d\u092a \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092f\u0947 \u0935\u093f\u0915\u0932\u094d\u092a \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f (www.myaadhaar.uidai.gov.in), \u0908-\u0906\u0927\u093e\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921, \u090f\u092e-\u0906\u0927\u093e\u0930 \u092e\u094b\u092c\u093e\u0907\u0932 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0906\u0926\u093f \u0915\u0947 \u091c\u0930\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0902\u0964\n\u0906\u0927\u093e\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u0928\u0902\u092c\u0930 1947 \u092a\u0930 \u090f\u0915 \u090f\u0938\u090f\u092e\u090f\u0938 \u092d\u0947\u091c\u0915\u0930 \u092d\u0940 \u0935\u0940\u0906\u0908\u0921\u0940 \u0938\u0943\u091c\u093f\u0924 \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u094b \u091c\u0940\u0935\u0940\u0906\u0908\u0921\u0940 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u0947 \u0905\u0902\u0924\u093f\u092e 4 \u0905\u0902\u0915' \u091f\u093e\u0907\u092a \u0915\u0930\u0928\u0947 \u0939\u094b\u0902\u0917\u0947 \u0914\u0930 \u0907\u0938\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 1947 \u092a\u0930 \u092d\u0947\u091c\u0928\u093e \u0939\u094b\u0917\u093e\u0964"},{question:"\u0915\u094d\u092f\u093e \u0915\u094b\u0908 \u0914\u0930 \u092e\u0947\u0930\u0947 \u0932\u093f\u090f \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u0938\u0943\u091c\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948?",answer:"\u090f\u092f\u0942\u090f/\u0915\u0947\u092f\u0942\u090f \u091c\u0948\u0938\u0940 \u0915\u094b\u0908 \u0905\u0928\u094d\u092f \u0938\u0902\u0938\u094d\u0925\u093e \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0935\u0940\u0906\u0908\u0921\u0940 \u0938\u0943\u091c\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u0935\u0940\u0906\u0908\u0921\u0940 \u0915\u094b \u0915\u0947\u0935\u0932 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u0939\u0940 \u0938\u0943\u091c\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0915\u094b \u0935\u0940\u0906\u0908\u0921\u0940 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0930 \u090f\u0938\u090f\u092e\u090f\u0938 \u0915\u0947 \u091c\u0930\u093f\u090f \u0935\u0940\u0906\u0908\u0921\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u0940\u0964"},{question:"\u0915\u094d\u092f\u093e \u0939\u094b\u0917\u093e \u092f\u0926\u093f \u0915\u094b\u0908 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u092d\u0942\u0932 \u091c\u093e\u090f? \u0915\u094d\u092f\u093e \u0935\u0939 \u0907\u0938\u0947 \u0926\u094b\u092c\u093e\u0930\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948?",answer:"\u0939\u093e\u0902, \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0928\u0908 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u092c\u0928\u093e\u0928\u0947 \u0914\u0930/\u092f\u093e \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0908 \u0924\u0930\u0940\u0915\u0947 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092f\u0947 \u0935\u093f\u0915\u0932\u094d\u092a \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0915\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f (www. myaadhaar.uidai.gov.in), \u0908-\u0906\u0927\u093e\u0930, \u090f\u092e-\u0906\u0927\u093e\u0930 \u092e\u094b\u092c\u093e\u0907\u0932 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928, \u090f\u0938\u090f\u092e\u090f\u0938 \u0906\u0926\u093f \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u093e\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964\n\u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0915\u0940 \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u0915\u0947 \u0932\u093f\u090f, \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0906\u0927\u093e\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u0928\u0902\u092c\u0930 1947 \u092a\u0930 \u090f\u0938\u090f\u092e\u090f\u0938 \u092d\u0947\u091c \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u094b '\u0906\u0930\u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u0947 \u0905\u0902\u0924\u093f\u092e 4 \u0905\u0902\u0915' \u091f\u093e\u0907\u092a \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e \u0914\u0930 \u0907\u0938\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 1947 \u092a\u0930 \u092d\u0947\u091c\u0928\u093e \u0939\u094b\u0917\u093e\u0964"},{question:"\u0915\u094d\u092f\u093e \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0913\u091f\u0940\u092a\u0940 \u092f\u093e \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u092f\u093e \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948?",answer:"\u0939\u093e\u0901\u0964 \u0906\u0927\u093e\u0930 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u0947 \u092c\u0926\u0932\u0947 \u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964"},{question:"\u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902, \u0915\u094d\u092f\u093e \u092e\u0941\u091d\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u092e\u0924\u093f \u0926\u0947\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948?",answer:"\u091c\u0940 \u0939\u093e\u0902, \u0935\u0940\u0906\u0908\u0921\u0940 \u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0915\u0940 \u0938\u0939\u092e\u0924\u093f \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964 \u090f\u091c\u0947\u0902\u0938\u0940 \u0915\u094b \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0915\u094b \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0947 \u092a\u094d\u0930\u092f\u094b\u091c\u0928\u093e\u0930\u094d\u0925 \u0938\u0942\u091a\u093f\u0924 \u0915\u0930\u0928\u093e \u0914\u0930 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u092a\u0937\u094d\u091f \u0938\u0939\u092e\u0924\u093f \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964"},{question:"\u0915\u094d\u092f\u093e \u0915\u094b\u0908 \u090f\u091c\u0947\u0902\u0938\u0940 \u0935\u0940\u0906\u0908\u0921\u0940 \u0915\u093e \u0938\u0902\u0917\u094d\u0930\u0939 \u0915\u0930 \u0938\u0915\u0924\u0940 \u0939\u0948?",answer:"\u091c\u0940 \u0928\u0939\u0940\u0902\u0964 \u091a\u0942\u0902\u0915\u093f \u0935\u0940\u0906\u0908\u0921\u0940 \u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u0939\u0948 \u0914\u0930 \u0907\u0938\u0947 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0926\u094d\u0935\u093e\u0930\u093e \u092c\u0926\u0932\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u0935\u0940\u0906\u0908\u0921\u0940 \u0915\u094b \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0915\u0930\u0928\u093e \u0935\u094d\u092f\u0930\u094d\u0925 \u0930\u0939\u0947\u0917\u093e\u0964 \u090f\u091c\u0947\u0902\u0938\u093f\u092f\u094b\u0902 \u0915\u094b, \u0915\u093f\u0938\u0940 \u092d\u0940 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u092f\u093e \u0932\u0949\u0917 \u092e\u0947\u0902 \u0935\u0940\u0906\u0908\u0921\u0940 \u0915\u094b \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964"},{question:"\u0915\u094d\u092f\u093e \u0935\u0940\u0906\u0908\u0921\u0940 \u0915\u093e \u092a\u0941\u0928: \u0938\u0943\u091c\u0928 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0935\u0939\u0940 \u0935\u0940\u0906\u0908\u0921\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u0940 \u092f\u093e \u0905\u0928\u094d\u092f \u0935\u0940\u0906\u0908\u0921\u0940?",answer:"\u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0935\u0948\u0927\u0924\u093e \u0905\u0935\u0927\u093f (\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 1 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0926\u093f\u0935\u0938 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092f\u093e \u092e\u0927\u094d\u092f \u0930\u093e\u0924\u094d\u0930\u093f 12 \u092c\u091c\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0939\u0948) \u0915\u0947 \u0909\u092a\u0930\u093e\u0902\u0924, \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u090f\u0915 \u0928\u0908 \u0935\u0940\u0906\u0908\u0921\u0940 \u0915\u0947 \u092a\u0941\u0928: \u0938\u0943\u091c\u0928 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0907\u0938 \u0924\u0930\u0939, \u0928\u0908 \u0935\u0940\u0906\u0908\u0921\u0940 \u0938\u0943\u091c\u093f\u0924 \u0939\u094b\u0917\u0940 \u0914\u0930 \u092a\u093f\u091b\u0932\u0940 \u0935\u0940\u0906\u0908\u0921\u0940 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0939\u094b \u091c\u093e\u090f\u0917\u0940\u0964 \n\u0928\u093f\u0935\u093e\u0938\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0935\u0940\u0906\u0908\u0921\u0940 \u0915\u0940 \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u0915\u093e \u0935\u093f\u0915\u0932\u094d\u092a \u091a\u0941\u0928\u0928\u0947 \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902, \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0915\u094b \u092a\u093f\u091b\u0932\u0940 \u0938\u0915\u094d\u0930\u093f\u092f \u0935\u0940\u0906\u0908\u0921\u0940 \u090f\u0938\u090f\u092e\u090f\u0938 \u0915\u0947 \u091c\u0930\u093f\u090f \u092d\u0947\u091c\u0940 \u091c\u093e\u090f\u0917\u0940\u0964 \u0928\u093f\u0935\u093e\u0938\u0940 \u0915\u094b '\u0906\u0930\u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0915\u0947 \u0905\u0902\u0924\u093f\u092e 4 \u0905\u0902\u0915' \u091f\u093e\u0907\u092a \u0915\u0930\u0928\u0947 \u0939\u094b\u0917\u0947\u0902 \u0914\u0930 \u0907\u0938\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 1947 \u092a\u0930 \u092d\u0947\u091c\u0928\u093e \u0939\u094b\u0917\u093e\u0964"}],checkGrievanceFeedbackStatus:[{question:"\u0935\u0940\u0906\u0908\u0921\u0940 \u200b\u200b\u0915\u0940 \u0938\u092e\u093e\u092a\u094d\u0924 \u0905\u0935\u0927\u093f \u0915\u094d\u092f\u093e \u0939\u0948?",answer:"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0935\u0940\u0906\u0908\u0921\u0940 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0938\u092e\u093e\u092a\u094d\u0924 \u0905\u0935\u0927\u093f \u092a\u0930\u093f\u092d\u093e\u0937\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0935\u0940\u0906\u0908\u0921\u0940, \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u0908 \u0935\u0940\u0906\u0908\u0921\u0940 \u0938\u0943\u091c\u093f\u0924 \u0915\u0930\u0928\u0947 \u0924\u0915 \u0935\u0948\u0927 \u0930\u0939\u0947\u0917\u0940\u0964"}]}}},kn_IN:{translation:{dashboard:{header:{title:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd",profile:{aadhaarTagLine:"\u0cae\u0cc7\u0cb0\u0cbe \u0c86\u0ca7\u0cbe\u0cb0\u0ccd, \u0cae\u0cc7\u0cb0\u0cbf \u0caa\u0cc6\u0cb9\u0ccd\u0c9a\u0cbe\u0ca8\u0ccd",clickToFlip:"\u0cab\u0ccd\u0cb2\u0cbf\u0caa\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd",logOut:"\u0cb2\u0cbe\u0c97\u0ccd \u0c94\u0c9f\u0ccd"}},services:{title:"\u0cb8\u0cc6\u0cd5\u0cb5\u0cc6\u0c97\u0cb3\u0cc1",description:"\u0c88 \u0cb9\u0cb2\u0cb5\u0cbe\u0cb0\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0cc1 \u0c86\u0ca8\u0ccd \u0cb2\u0cc8\u0ca8\u0ccd \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6. \u0cb8\u0cc7\u0cb5\u0cc6-\u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cbf\u0cb7\u0ccd\u0c9f \u0caa\u0cc1\u0c9f\u0c95\u0ccd\u0c95\u0cc6 \u0ca8\u0ccd\u0caf\u0cbe\u0cb5\u0cbf\u0c97\u0cc7\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c9f\u0ccd\u0caf\u0cbe\u0cac\u0ccd \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",serviceCards:{downloadAadhaar:{title:"\u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd",description:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8 \u0ca1\u0cbf\u0c9c\u0cbf\u0c9f\u0cb2\u0ccd \u0cb8\u0cb9\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0c8e\u0cb2\u0cc6\u0c95\u0ccd\u0c9f\u0ccd\u0cb0\u0cbe\u0ca8\u0cbf\u0c95\u0ccd \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},orderPVC:{title:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c86\u0ca6\u0cc7\u0cb6\u0cbf\u0cb8\u0cbf",description:"\u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4, \u0cb5\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0c97\u0cbe\u0ca4\u0ccd\u0cb0\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0ca6\u0cc7\u0cb6\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},updateAadhaarOnline:{updateAadhaarOnline:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf",updateAadhaar:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf",headerTitle:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0ca6 \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",title:"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3",description:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c87\u0ca4\u0cb0 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c95\u0ccd\u0c95\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf"},bankLinkingStatus:{title:"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf",description:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},generateVirtualID:{title:"\u0cb5\u0cb0\u0ccd\u0c9a\u0cc1\u0cb5\u0cb2\u0ccd \u0c90\u0ca1\u0cbf \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf",description:"\u0cb5\u0cb0\u0ccd\u0c9a\u0cc1\u0cb5\u0cb2\u0ccd \u0c90\u0ca1\u0cbf (\u0cb5\u0cbf\u0c90\u0ca1\u0cbf) \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf \u0cac\u0ca6\u0cb2\u0cbe\u0c97\u0cbf \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. 16 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cb5\u0cb0\u0ccd\u0c9a\u0cc1\u0caf\u0cb2\u0ccd \u0cb5\u0cbf\u0c90\u0ca1\u0cbf \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},offlineEkyc:{title:"\u0c86\u0cab\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0c87\u0c95\u0cc6\u0cb5\u0cc8\u0cb8\u0cbf",description:"\u0c86\u0cab\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5 \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cb9\u0cc1\u0ca6\u0cbe\u0ca6 \u0c87\u0c95\u0cc6\u0cb5\u0cc8\u0cb8\u0cbf \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},lockUnlockBiometrics:{title:"\u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf / \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",description:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbe\u0ca4\u0ccd\u0c95\u0cbe\u0cb2\u0cbf\u0c95\u0cb5\u0cbe\u0c97\u0cbf \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 / \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},lockUnlockAadhaar:{title:"\u0cb2\u0cbe\u0c95\u0ccd / \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd",description:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbe\u0ca4\u0ccd\u0c95\u0cbe\u0cb2\u0cbf\u0c95\u0cb5\u0cbe\u0c97\u0cbf \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 / \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c88 \u0cb8\u0cc7\u0cb5\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0cac\u0cb3\u0cb8\u0cbf"},paymentHistory:{title:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8",description:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cb0\u0cc1\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},aadharUpdateHistory:{title:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8",description:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf."},bankSeedingStatus:{title:"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb8\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf",description:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb8\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf."},authenticationHistory:{title:"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8",description:"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",heading:"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0cb6\u0ccd\u0cb0\u0cc7\u0ca3\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",modality:"\u0cae\u0cbe\u0ca6\u0cb0\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",fieldStartText:"\u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",fieldEndText:"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",button:"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf",tableHeading:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0caf\u0cc1 {{txnNumber}} \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c95\u0cbe\u0cb0\u0ca3\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",dateRange:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0 \u0c8f\u0c9c\u0cc6\u0ca8\u0ccd\u0cb8\u0cbf (AUA) \u0c85\u0ca5\u0cb5\u0cbe \u0c85\u0cb5\u0cb0\u0cc1 \u0c95\u0cb3\u0cc6\u0ca6 6 \u0ca4\u0cbf\u0c82\u0c97\u0cb3\u0cc1\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ca1\u0cc6\u0cb8\u0cbf\u0ca6 50 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",filterName:"\u0cae\u0cbe\u0ca6\u0cb0\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",note:{l1:"\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6:",l2:"AUA \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1 \u0c90\u0ca1\u0cbf:",l3:"\u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf \u0cb8\u0cae\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb5\u0cbf\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0cb5\u0cbe\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1 \u0c90\u0ca1\u0cbf.",l4:"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0 \u0c8f\u0c9c\u0cc6\u0ca8\u0ccd\u0cb8\u0cbf\u0caf \u0caa\u0c9f\u0ccd\u0c9f\u0cbf:",l5:"\u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cbf\u0c97\u0cc6 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0cb8\u0cbf\u0ca6\u0c82\u0ca4\u0cc6 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0c97\u0cb3\u0cbf\u0ca6\u0ccd\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf, \u0c86 \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cbf\u0c97\u0cc6 AUA \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8