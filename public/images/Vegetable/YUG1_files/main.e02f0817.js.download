cb8\u0c82\u0caf\u0ccb\u0c9c\u0ca8\u0cc6 (\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5\u0c82\u0ca4\u0cc6) \u0c95\u0ccd\u0caf\u0cbe\u0caa\u0cbf\u0c9f\u0cb2\u0ccd \u0c85\u0c95\u0ccd\u0cb7\u0cb0\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cc8\u0cb5\u0cc8\u0cb5\u0cc8 \u0cb8\u0ccd\u0cb5\u0cb0\u0cc2\u0caa\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb9\u0cc1\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6 \u0cb5\u0cb0\u0ccd\u0cb7.",exampleTextOne:"\u0c89\u0ca6\u0cbe\u0cb9\u0cb0\u0ca3\u0cc6 : \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0c85\u0ca8\u0cc0\u0cb6\u0ccd \u0cb5\u0cc8 \u0c95\u0cc1\u0cae\u0cbe\u0cb0\u0ccd (ANISH Y KUMAR ) \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9c\u0ca8\u0ccd\u0cae \u0cb5\u0cb0\u0ccd\u0cb7 1989",exampleTextTwo:"\u0c86\u0c97 \u0c87-\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cbe\u0cb8\u0ccd \u0cb5\u0cb0\u0ccd\u0ca1\u0ccd ANIS1989 \u0c86\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 "}},unauthEaadhaarDownload:{title:"\u0c87\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0ccc\u0ca8\u0ccd\u0cb2\u0ccb\u0ca1\u0ccd",selectLabel:"12 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 /16 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 \u0cb5\u0cb0\u0ccd\u0c9a\u0cc1\u0cb5\u0cb2\u0ccd \u0c90\u0ca1\u0cbf (\u0cb5\u0cbf\u0c90\u0ca1\u0cbf) \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 / 28 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0c90\u0ca1\u0cbf (\u0c87\u0c90\u0ca1\u0cbf) \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf",radioLabels:{uid:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",eid:"\u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf ID \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",vid:"\u0cb5\u0cb0\u0ccd\u0c9a\u0cc1\u0cb5\u0cb2\u0ccd \u0c90\u0ca1\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6"},textFields:{uid:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\