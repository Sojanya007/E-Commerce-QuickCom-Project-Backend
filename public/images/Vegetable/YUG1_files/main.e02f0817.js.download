u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0a9c\u0acb \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0aa8\u0abf\u0ab7\u0acd\u0aab\u0ab3 \u0a9c\u0abe\u0aaf \u0aa4\u0acb, \u0aa4\u0aae\u0ac7 \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0\u0aa8\u0ac0 \u0a98\u0aa3\u0ac0 \u0ab5\u0a96\u0aa4 \u0aab\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb.",button:{cancel:"\u0ab0\u0aa6 \u0a95\u0ab0\u0acb",makePayment:"\u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0a95\u0ab0\u0acb"}}},status:{srnField:"\u0a8f\u0ab8\u0a86\u0ab0\u0a8f\u0aa8 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb",table:{srn:"\u0a8f\u0ab8\u0a86\u0ab0\u0a8f\u0aa8",orderDate:"\u0d15\u0d4d\u0d30\u0d2e\u0d24\u0d40\u0d2f\u0d24\u0d3f",currentStatus:"\u0ab5\u0ab0\u0acd\u0aa4\u0aae\u0abe\u0aa8 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf",awb:"\u0a8f\u0ab0 \u0ab5\u0ac7 \u0aac\u0abf\u0ab2 \u0aa8\u0a82\u0aac\u0ab0",dispatchDate:"\u0aa1\u0abf\u0ab8\u0acd\u0aaa\u0ac7\u0a9a\u0aa8\u0ac0 \u0aa4\u0abe\u0ab0\u0ac0\u0a96",awb_subText:"\u0aa4\u0aae\u0ac7 \u0a89\u0aaa\u0ab0\u0aa8\u0abe \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 'www.indiapost.gov.in' \u0aaa\u0ab0 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a93\u0ab0\u0acd\u0aa1\u0ab0\u0aa8\u0ac7 \u0a9f\u0acd\u0ab0\u0ac7\u0a95 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb",demographic:"\u0a97\u0acb\u0aaa\u0aa8\u0ac0\u0aaf\u0aa4\u0abe\u0aa8\u0abe \u0a95\u0abe\u0ab0\u0aa3\u0acb\u0ab8\u0ab0, \u0ab0\u0abe\u0a9c\u0acd\u0aaf\u0aae\u0abe\u0a82 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aae\u0abe\u0a9f\u0ac7 \u0aa1\u0ac7\u0aae\u0acb\u0a97\u0acd\u0ab0\u0abe\u0aab\u0abf\u0a95 \u0aa1\u0ac7\u0a9f\u0abe \u0a9c\u0abe\u0ab9\u0ac7\u0ab0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aa4\u0acb \u0aa8\u0aa5\u0ac0. \u0a9c\u0acb\u0a95\u0ac7 \u0a93\u0ab0\u0acd\u0aa1\u0ab0 \u0a95\u0ab0\u0ac7\u0ab2\u0abe \u0aaa\u0ac0\u0ab5\u0ac0\u0ab8\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aa1\u0aae\u0abe\u0a82 \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0acb \u0ab2\u0ac7\u0a9f\u0ac7\u0ab8\u0acd\u0a9f \u0aa1\u0ac7\u0aae\u0acb\u0a97\u0acd\u0ab0\u0abe\u0aab\u0abf\u0a95\u0acd\u0ab8 \u0aa1\u0ac7\u0a9f\u0abe \u0ab9\u0ab6\u0ac7."}}},aadharStatus:{title:"\u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0a85\u0aa8\u0ac7 \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0abe \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0aa4\u0aaa\u0abe\u0ab8\u0acb",description:{one:"\u0aa4\u0aaa\u0abe\u0ab8\u0acb \u0a95\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0a86\u0aa7\u0abe\u0ab0 \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0aa5\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7 \u0a95\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aa5\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7 .",twoEID:"14 \u0a85\u0a82\u0a95\u0aa8\u0acb \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0aa8\u0a82\u0aac\u0ab0, \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0/\u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0aa8\u0aae\u0ac2\u0aa8\u0abe\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0ac7\u0aa4\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0ac3\u0aa4\u0abf \u0ab8\u0acd\u0ab2\u0abf\u0aaa \u0aaa\u0ab0 \u0a9b\u0abe\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7\u0a83 1234/12345/12345",twoSRN:" '\u0a8f\u0ab8' \u0aaa\u0a9b\u0ac0 13 \u0a85\u0a82\u0a95\u0acb, \u0a93\u0aa8\u0ab2\u0abe\u0a87\u0aa8 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0aa4\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0ac3\u0aa4\u0abf \u0ab8\u0acd\u0ab2\u0abf\u0aaa \u0aaa\u0ab0 \u0aae\u0ac1\u0aa6\u0acd\u0ab0\u0abf\u0aa4 \u0aa8\u0aae\u0ac2\u0aa8\u0abe\u0a83 S1234567891234",twoURN:"8 \u0a86\u0a82\u0a95\u0aa1\u0abe\u0aa8\u0ac1\u0a82 \u0aaf\u0ac1\u0a86\u0ab0\u0a8f\u0aa8, '\u0a8f\u0aae\u0a86\u0aa7\u0abe\u0ab0' \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0aa8\u0aae\u0ac2\u0aa8\u0abe\u0a83 12345678 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0aa4\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0ac3\u0aa4\u0abf \u0ab8\u0acd\u0ab2\u0abf\u0aaa \u0aaa\u0ab0 \u0aae\u0ac1\u0aa6\u0acd\u0ab0\u0abf\u0aa4 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7.",twoSID:"\u2018S\u2019 followed by 27 digits, printed on acknowledgement slip while physically visiting Enrolment / Update center. Sample: S123456789123456789123456789",three:'In case if you lost EID you can retrieve lost or forgotten EID by your registered mobile number or email ID. <a href="/retrieve-eid-uid" class="click_here">Click here</a> to Retrieve EID'},optionalMessage:"\u0a8f\u0a95\u0aa8\u0acb\u0ab2\u0ac7\u0a9c\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0ab8\u0acd\u0ab2\u0abf\u0aaa (<b>\u0ab5\u0ac8\u0a95\u0ab2\u0acd\u0aaa\u0abf\u0a95</b>) \u0aae\u0ac1\u0a9c\u0aac \u0aa4\u0abe\u0ab0\u0ac0\u0a96 \u0a85\u0aa8\u0ac7 \u0ab8\u0aae\u0aaf\u0aa8\u0acb \u0a89\u0ab2\u0acd\u0ab2\u0ac7\u0a96 \u0a95\u0ab0\u0acb"},complaintStatus:{title:"\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 / \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0aa4\u0aaa\u0abe\u0ab8\u0acb",form:{complaintNumber:"\u0ab8\u0ac7\u0ab5\u0abe \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb",QRCid:"Qrc Id",status:"\u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf",ComplaintNumber:"\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 / \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0aa8\u0a82\u0aac\u0ab0",ResolutionResponse:"\u0aa0\u0ab0\u0abe\u0ab5 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0aad\u0abe\u0ab5"}},fileComplaint:{title:"\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6",description:"\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb",disclaimer:"\u0a86\u0aa7\u0abe\u0ab0, \u0ab8\u0acc\u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aae\u0abe\u0a82 \u0ab2\u0ac7\u0ab5\u0abe\u0aa4\u0ac0 \u0aa1\u0abf\u0a9c\u0abf\u0a9f\u0ab2 \u0a93\u0ab3\u0a96 \u0aa4\u0ab0\u0ac0\u0a95\u0ac7, \u0a85\u0ab8\u0a82\u0a96\u0acd\u0aaf \u0ab8\u0aac\u0ab8\u0abf\u0aa1\u0ac0, \u0ab2\u0abe\u0aad\u0acb \u0a85\u0aa8\u0ac7 \u0ab8\u0ac7\u0ab5\u0abe\u0a93\u0aa8\u0acb \u0ab2\u0abe\u0aad \u0ab2\u0ac7\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0aaa\u0ab0\u0abe\u0aaf \u0a9b\u0ac7. \u0a86\u0aa8\u0ac7 \u0aa7\u0acd\u0aaf\u0abe\u0aa8\u0aae\u0abe\u0a82 \u0ab0\u0abe\u0a96\u0ac0\u0aa8\u0ac7, \u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0ac7\u0a9f\u0abe\u0aac\u0ac7\u0a9d\u0aa8\u0ac0 \u0a9a\u0acb\u0a95\u0ab8\u0abe\u0a88 \u0a9c\u0abe\u0ab3\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, UIDAI \u0a8f \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a85\u0aa8\u0ac7 \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a95\u0ab5\u0abe\u0aaf\u0aa4 \u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0ac0 \u0ab9\u0aa4\u0ac0. \u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0ac7\u0a9f\u0abe\u0aac\u0ac7\u0a9d\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab0\u0abe\u0a96\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab9\u0abe\u0aa5 \u0aa7\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0aa4\u0ac0 \u0aaa\u0acd\u0ab0\u0ab5\u0ac3\u0aa4\u0acd\u0aa4\u0abf\u0a93 \u0aa6\u0ab0\u0aae\u0abf\u0aaf\u0abe\u0aa8, \u0ab8\u0aae\u0aaf\u0abe\u0a82\u0aa4\u0ab0\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95\u0acb\u0aa8\u0ac7 \u0ab8\u0ac2\u0a9a\u0aa8\u0abe\u0a93 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0a86 \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad\u0aae\u0abe\u0a82, \u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f\u0aa4\u0abe \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a95\u0ac7 \u0a95\u0acb\u0a88 \u0aaa\u0aa3 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0acb \u0aa8\u0aa5\u0ac0. \u0a9c\u0acb \u0a95\u0acb\u0a88 \u0aaa\u0aa3 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95\u0aa8\u0ac7 \u0a86 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0aae\u0abe\u0a82 \u0a95\u0acb\u0a88 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 \u0ab9\u0acb\u0aaf, \u0aa4\u0acb \u0aa4\u0ac7\u0a93 \u0aa4\u0ac7\u0aae\u0aa8\u0acb \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0a85\u0ab9\u0ac0\u0a82 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0a86\u0ab5\u0ac0 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0aa8\u0ac1\u0a82 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7.",form:{heading:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb",state:"\u0ab0\u0abe\u0a9c\u0acd\u0aaf \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb",enquirer:"(\u0ab8\u0acd\u0ab5/\u0a85\u0aa8\u0acd\u0aaf) \u0aae\u0abe\u0a9f\u0ac7 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 / \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6",complaintType:"\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 / \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6\u0aa8\u0acb \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb",categoryType:"\u0a95\u0ac7\u0a9f\u0ac7\u0a97\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb",uploadDocumentLabel:"\u0ab5\u0abf\u0a97\u0aa4\u0acb \u0a9c\u0ac1\u0a93 \u0a85\u0aa8\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb (\u0a9c\u0acb \u0a95\u0acb\u0a88 \u0ab9\u0acb\u0aaf \u0aa4\u0acb)",statusField:"EID/SRN/URN \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb",placeholder:"\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0, \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a9a\u0abf\u0a82\u0aa4\u0abe\u0aa8\u0ac7 \u0a85\u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0a95 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a89\u0a95\u0ac7\u0ab2\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0aa8\u0ac7 {{fields}} \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ab5\u0abe \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7.",error:{complaintType:"\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 / \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6\u0aa8\u0acb \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ac7\u0ab2 \u0aa8\u0aa5\u0ac0",categoryType:"\u0ab6\u0acd\u0ab0\u0ac7\u0aa3\u0ac0 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ac0 \u0aa8\u0aa5\u0ac0",state:"\u0ab0\u0abe\u0a9c\u0acd\u0aaf \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ac7\u0ab2 \u0aa8\u0aa5\u0ac0",enquirer:"\u0aaa\u0ac2\u0a9b\u0aaa\u0ab0\u0a9b \u0a95\u0ab0\u0aa8\u0abe\u0ab0 \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ac7\u0ab2 \u0aa8\u0aa5\u0ac0"}},Complaintnote:"\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0aa8\u0abe \u0a9d\u0aa1\u0aaa\u0ac0 \u0aa8\u0abf\u0ab0\u0abe\u0a95\u0ab0\u0aa3 \u0aae\u0abe\u0a9f\u0ac7 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 / \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6\u0aa8\u0acb \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0aad\u0abe\u0ab0\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0ab8\u0ab2\u0abe\u0ab9 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0a96\u0acb\u0a9f\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6/\u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0\u0aa8\u0ac0 \u0aaa\u0ab8\u0a82\u0aa6\u0a97\u0ac0 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab5\u0abf\u0ab2\u0a82\u0aac \u0aa4\u0ab0\u0aab \u0aa6\u0acb\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7",Categorynote:"\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0aa8\u0abe \u0a9d\u0aa1\u0aaa\u0ac0 \u0aa8\u0abf\u0ab0\u0abe\u0a95\u0ab0\u0aa3 \u0aae\u0abe\u0a9f\u0ac7 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0a95\u0ac7\u0a9f\u0ac7\u0a97\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0aad\u0abe\u0ab0\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0ab8\u0ab2\u0abe\u0ab9 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0a96\u0acb\u0a9f\u0ac0 \u0a95\u0ac7\u0a9f\u0ac7\u0a97\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ab5\u0abe\u0aa5\u0ac0 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab5\u0abf\u0ab2\u0a82\u0aac \u0aa5\u0a88 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7",feedbackTextArea:" \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0acb \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0acb",feedback:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa8\u0ac0\u0a9a\u0ac7 \u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 / \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0aab\u0abe\u0a87\u0ab2 \u0a95\u0ab0\u0aa4\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0acb \u0a85\u0aa8\u0ac1\u0aad\u0ab5 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0acb"},errorMessages:{slipApiFailed:"\u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0ac3\u0aa4\u0abf \u0a95\u0abe\u0aaa\u0ab2\u0ac0 \u0aaa\u0ac7\u0aa6\u0abe \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aad\u0ac2\u0ab2 \u