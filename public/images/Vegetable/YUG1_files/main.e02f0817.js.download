c \u0688\u06cc 1234}. ",stepOneLinkText:" VID \u0628\u0646\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06cc\u06c1\u0627\u06ba \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",stepTwoLabel:"\u0645\u0631\u062d\u0644\u06c1 2 \u0627\u0632 3: ",stepTwoDescription:"\u0627\u06cc\u06a9 \u0628\u0627\u0631 \u0622\u067e \u06a9\u0627 VID \u062a\u06cc\u0627\u0631 \u06c1\u0648 \u062c\u0627\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f\u060c \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u0633 \u0635\u0641\u062d\u06c1 \u067e\u0631 \u0648\u0627\u067e\u0633 \u062c\u0627\u0626\u06cc\u06ba \u0627\u0648\u0631 \u0627\u067e\u0646\u06d2 VID \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u067e\u0646\u06d2 \u0622\u062f\u06be\u0627\u0631 \u06a9\u0648 \u0644\u0627\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u06af\u06d2 \u0628\u0691\u06be\u06cc\u06ba\u060c \u067e\u06be\u0631 \u062c\u0628 \u0628\u06be\u06cc \u0636\u0631\u0648\u0631\u06cc \u06c1\u0648 \u0627\u067e\u0646\u06d2 VID \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u06cc\u06ba\u060c \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u067e \u06a9\u06d2 \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0627\u06cc\u06a9 \u0628\u0627\u0631 \u0644\u0627\u06a9 \u06c1\u0648\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f \u063a\u06cc\u0631 \u0641\u0639\u0627\u0644 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4",stepThreeLabel:"\u0645\u0631\u062d\u0644\u06c1 3 \u0627\u0632 3: ",stepThreeDescription:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u0633 \u0635\u0641\u062d\u06c1 \u067e\u0631 \u0648\u0627\u067e\u0633 \u062c\u0627\u0626\u06cc\u06ba \u0627\u0648\u0631 \u0622\u062f\u06be\u0627\u0631 \u06a9\u0648 \u063a\u06cc\u0631 \u0645\u0642\u0641\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u06af\u06d2 \u0628\u0691\u06be\u06