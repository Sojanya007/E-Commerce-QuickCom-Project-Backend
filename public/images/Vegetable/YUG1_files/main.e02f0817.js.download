0a40 \u0a15\u0a08 \u0a35\u0a3e\u0a30 \u0a26\u0a41\u0a2c\u0a3e\u0a30\u0a3e \u0a15\u0a4b\u0a38\u0a3c\u0a3f\u0a38\u0a3c \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964",button:{cancel:"\u0a30\u0a71\u0a26 \u0a15\u0a30\u0a4b",makePayment:"\u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a30\u0a4b"}}},status:{srnField:"\u0a10\u0a38 \u0a06\u0a30 \u0a10\u0a28 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b",table:{srn:"\u0a10\u0a38\u0a06\u0a30\u0a10\u0a28",orderDate:"\u0a06\u0a30\u0a21\u0a30 \u0a2e\u0a3f\u0a24\u0a40",currentStatus:"\u0a2e\u0a4c\u0a1c\u0a42\u0a26\u0a3e \u0a38\u0a25\u0a3f\u0a24\u0a40",awb:"\u0a0f\u0a05\u0a30 \u0a35\u0a47 \u0a2c\u0a3f\u0a32 \u0a28\u0a70\u0a2c\u0a30",dispatchDate:"\u0a21\u0a3f\u0a38\u0a2a\u0a48\u0a1a \u0a26\u0a40 \u0a2e\u0a3f\u0a24\u0a40",awb_subText:"\u0a24\u0a41\u0a38\u0a40\u0a02 \u0a09\u0a71\u0a2a\u0a30 \u0a26\u0a3f\u0a71\u0a24\u0a47 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 'www.indiapost.gov.in' '\u0a24\u0a47 \u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a30\u0a21\u0a30 \u0a28\u0a42\u0a70 \u0a1f\u0a30\u0a48\u0a15 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964",demographic:"\u0a17\u0a4b\u0a2a\u0a28\u0a40\u0a2f\u0a24\u0a3e \u0a26\u0a47 \u0a15\u0a3e\u0a30\u0a28\u0a3e\u0a02 \u0a15\u0a30\u0a15\u0a47, \u0a21\u0a47\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a2b\u0a3f\u0a15 \u0a21\u0a3e\u0a1f\u0a3e \u0a26\u0a3e \u0a16\u0a41\u0a32\u0a3e\u0a38\u0a3e \u0a28\u0a39\u0a40\u0a02 \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a3e\u0964 \u0a39\u0a3e\u0a32\u0a3e\u0a02\u0a15\u0a3f, \u0a06\u0a30\u0a21\u0a30 \u0a15\u0a40\u0a24\u0a47 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21 \u0a35\u0a3f\u0a71\u0a1a \u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a3e \u0a28\u0a35\u0a40\u0a28\u0a24\u0a2e \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a2b\u0a3f\u0a15 \u0a21\u0a3e\u0a1f\u0a3e \u0a39\u0a40 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e\u0964"}}},aadharStatus:{title:"\u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a28 \u0a05\u0a24\u0a47 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a4b",description:{one:"\u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a4b \u0a15\u0a3f \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a1c\u0a28\u0a30\u0a47\u0a1f \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a39\u0a48 \u0a1c\u0a3e\u0a02 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a39\u0a48 .",twoEID:"14 \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a3e \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a28 \u0a28\u0a70\u0a2c\u0a30, \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a28 / \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a47\u0a02\u0a26\u0a30 '\u0a24\u0a47 \u0a38\u0a30\u0a40\u0a30\u0a15 \u0a24\u0a4c\u0a30 '\u0a24\u0a47 \u0a1c\u0a3e\u0a02\u0a26\u0a47 \u0a38\u0a2e\u0a47\u0a02 \u0a30\u0a38\u0a40\u0a26 \u0a38\u0a32\u0a3f\u0a71\u0a2a '\u0a24\u0a47 \u0a1b\u0a3e\u0a2a\u0a3f\u0a06 \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48\u0964",twoSRN:"'S' \u0a26\u0a47 \u0a2c\u0a3e\u0a05\u0a26 13 \u0a05\u0a70\u0a15 \u0a39\u0a41\u0a70\u0a26\u0a47 \u0a39\u0a28, \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a15\u0a30\u0a26\u0a47 \u0a38\u0a2e\u0a47\u0a02 \u0a30\u0a38\u0a40\u0a26 \u0a38\u0a32\u0a3f\u0a71\u0a2a '\u0a24\u0a47 \u0a1b\u0a3e\u0a2a\u0a3f\u0a06 \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48 l",twoURN:"8 \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a3e URN, 'mAadhaar' \u0a10\u0a2a\u0a32\u0a40\u0a15\u0a47\u0a38\u0a3c\u0a28 \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a15\u0a30\u0a26\u0a47 \u0a38\u0a2e\u0a47\u0a02 \u0a30\u0a38\u0a40\u0a26 \u0a38\u0a32\u0a3f\u0a71\u0a2a '\u0a24\u0a47 \u0a1b\u0a3e\u0a2a\u0a3f\u0a06 \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48\u0964",twoSID:"\u2018S\u2019 followed by 27 digits, printed on acknowledgement slip while physically visiting Enrolment / Update center. Sample: S123456789123456789123456789",three:"\u0a1c\u0a47 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a08\u0a06\u0a08\u0a21\u0a40 \u0a17\u0a41\u0a06 \u0a26\u0a3f\u0a71\u0a24\u0a40 \u0a39\u0a48 \u0a24\u0a3e\u0a02 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a06\u0a2a\u0a23\u0a47 \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a17\u0a41\u0a70\u0a2e \u0a1c\u0a3e\u0a02 \u0a2d\u0a41\u0a71\u0a32 \u0a17\u0a08 \u0a08\u0a06\u0a08\u0a21\u0a40 \u0a2e\u0a41\u0a5c \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964"},optionalMessage:"\u0a30\u0a38\u0a40\u0a26 \u0a2a\u0a71\u0a24\u0a30 (<b>\u0a35\u0a3f\u0a15\u0a32\u0a2a\u0a3f\u0a15</b>) \u0a26\u0a47 \u0a05\u0a28\u0a41\u0a38\u0a3e\u0a30 \u0a2e\u0a3f\u0a24\u0a40 \u0a05\u0a24\u0a47 \u0a38\u0a2e\u0a47\u0a02 \u0a26\u0a3e \u0a1c\u0a3c\u0a3f\u0a15\u0a30 \u0a15\u0a30\u0a4b"},complaintStatus:{title:"\u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24/\u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a4b",form:{complaintNumber:"\u0a38\u0a47\u0a35\u0a3e \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b",QRCid:"Qrc Id",status:"\u0a38\u0a25\u0a3f\u0a24\u0a40",ComplaintNumber:"\u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24/\u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a28\u0a70\u0a2c\u0a30",ResolutionResponse:"\u0a38\u0a70\u0a15\u0a32\u0a2a \u0a1c\u0a35\u0a3e\u0a2c"}},fileComplaint:{title:"\u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a05\u0a24\u0a47 \u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15",description:"\u0a06\u0a2a\u0a23\u0a40 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a05\u0a24\u0a47 \u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b",disclaimer:"\u0a06\u0a27\u0a3e\u0a30, \u0a38\u0a2d \u0a24\u0a4b\u0a02 \u0a06\u0a2e \u0a24\u0a4c\u0a30 '\u0a24\u0a47 \u0a35\u0a30\u0a24\u0a40 \u0a1c\u0a3e\u0a23 \u0a35\u0a3e\u0a32\u0a40 \u0a21\u0a3f\u0a1c\u0a40\u0a1f\u0a32 \u0a2a\u0a1b\u0a3e\u0a23 \u0a35\u0a1c\u0a4b\u0a02, \u0a2c\u0a39\u0a41\u0a24 \u0a38\u0a3e\u0a30\u0a40\u0a06\u0a02 \u0a38\u0a2c\u0a38\u0a3f\u0a21\u0a40\u0a06\u0a02, \u0a32\u0a3e\u0a2d\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a3e \u0a32\u0a3e\u0a2d \u0a32\u0a48\u0a23 \u0a32\u0a08 \u0a35\u0a30\u0a24\u0a3f\u0a06 \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a07\u0a38 \u0a26\u0a47 \u0a2e\u0a71\u0a26\u0a47\u0a28\u0a1c\u0a3c\u0a30, \u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a47\u0a1f\u0a3e\u0a2c\u0a47\u0a38 \u0a26\u0a40 \u0a38\u0a3c\u0a41\u0a71\u0a27\u0a24\u0a3e \u0a28\u0a42\u0a70 \u0a2c\u0a23\u0a3e\u0a08 \u0a30\u0a71\u0a16\u0a23 \u0a32\u0a08, UIDAI \u0a28\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a28\u0a42\u0a70 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a15 \u0a05\u0a2d\u0a3f\u0a06\u0a38 \u0a38\u0a3c\u0a41\u0a30\u0a42 \u0a15\u0a40\u0a24\u0a3e \u0a38\u0a40\u0964 \u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a3e\u0a1f\u0a3e\u0a2c\u0a47\u0a38 \u0a28\u0a42\u0a70 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a30\u0a71\u0a16\u0a23 \u0a32\u0a08 \u0a15\u0a40\u0a24\u0a40\u0a06\u0a02 \u0a17\u0a08\u0a06\u0a02 \u0a17\u0a24\u0a40\u0a35\u0a3f\u0a27\u0a40\u0a06\u0a02 \u0a26\u0a47 \u0a26\u0a4c\u0a30\u0a3e\u0a28, \u0a38\u0a2e\u0a47\u0a02-\u0a38\u0a2e\u0a47\u0a02 '\u0a24\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a38\u0a42\u0a1a\u0a28\u0a3e\u0a35\u0a3e\u0a02 \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a40\u0a24\u0a40\u0a06\u0a02 \u0a1c\u0a3e\u0a02\u0a26\u0a40\u0a06\u0a02 \u0a39\u0a28\u0964 \u0a07\u0a38 \u0a38\u0a2c\u0a70\u0a27 \u0a35\u0a3f\u0a71\u0a1a, \u0a07\u0a39 \u0a38\u0a2a\u0a71\u0a38\u0a3c\u0a1f \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48 \u0a15\u0a3f \u0a15\u0a4b\u0a08 \u0a35\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a30\u0a71\u0a26 \u0a28\u0a39\u0a40\u0a02 \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a39\u0a48\u0964 \u0a1c\u0a47\u0a15\u0a30 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a28\u0a42\u0a70 \u0a07\u0a38 \u0a38\u0a2c\u0a70\u0a27 \u0a35\u0a3f\u0a71\u0a1a \u0a15\u0a4b\u0a08 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a09\u0a39 \u0a07\u0a71\u0a25\u0a47 \u0a06\u0a2a\u0a23\u0a3e \u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a26\u0a30\u0a1c \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964 \u0a05\u0a1c\u0a3f\u0a39\u0a40 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a26\u0a3e \u0a28\u0a3f\u0a2a\u0a1f\u0a3e\u0a30\u0a3e \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a3e\u0964",form:{heading:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a32\u0a4b\u0a5c\u0a40\u0a02\u0a26\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a26\u0a3e\u0a16\u0a32 \u0a15\u0a30\u0a4b",state:"\u0a30\u0a3e\u0a1c \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b",enquirer:"(\u0a38\u0a35\u0a48/\u0a26\u0a42\u0a38\u0a30\u0a3f\u0a06\u0a02) \u0a32\u0a08 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 / \u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15",complaintType:"\u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24/\u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a15\u0a3f\u0a38\u0a2e \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b",categoryType:"\u0a38\u0a3c\u0a4d\u0a30\u0a47\u0a23\u0a40 \u0a26\u0a40 \u0a15\u0a3f\u0a38\u0a2e \u0a26\u0a3e\u0a16\u0a32 \u0a15\u0a30\u0a4b",uploadDocumentLabel:"\u0a35\u0a47\u0a30\u0a35\u0a47 \u0a35\u0a47\u0a16\u0a4b \u0a05\u0a24\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a05\u0a71\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a4b (\u0a1c\u0a47 \u0a15\u0a4b\u0a08 \u0a39\u0a48)",statusField:"EID / SRN / URN \u0a26\u0a3e\u0a16\u0a32 \u0a15\u0a30\u0a4b",placeholder:"\u0a2a\u0a3f\u0a06\u0a30\u0a47 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40, \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a1a\u0a3f\u0a70\u0a24\u0a3e \u0a28\u0a42\u0a70 \u0a2a\u0a4d\u0a30\u0a2d\u0a3e\u0a35\u0a38\u0a3c\u0a3e\u0a32\u0a40 \u0a22\u0a70\u0a17 \u0a28\u0a3e\u0a32 \u0a39\u0a71\u0a32 \u0a15\u0a30\u0a28 \u0a32\u0a08, \u0a24\u0a41\u0a39\u0a3e\u0a28\u0a42\u0a70 {{fields}} \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48\u0964",error:{complaintType:"\u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24/\u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a26\u0a40 \u0a15\u0a3f\u0a38\u0a2e \u0a28\u0a39\u0a40\u0a02 \u0a1a\u0a41\u0a23\u0a40 \u0a17\u0a08",categoryType:"\u0a38\u0a3c\u0a4d\u0a30\u0a47\u0a23\u0a40 \u0a28\u0a39\u0a40\u0a02 \u0a1a\u0a41\u0a23\u0a40 \u0a17\u0a08",state:"\u0a30\u0a3e\u0a1c \u0a28\u0a39\u0a40\u0a02 \u0a1a\u0a41\u0a23\u0a3f\u0a06 \u0a17\u0a3f\u0a06",enquirer:"\u0a2a\u0a41\u0a71\u0a1b\u0a17\u0a3f\u0a71\u0a1b \u0a26\u0a40 \u0a15\u0a3f\u0a38\u0a2e \u0a28\u0a39\u0a40\u0a02 \u0a1a\u0a41\u0a23\u0a40 \u0a17\u0a08"}},Complaintnote:"\u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a26\u0a47 \u0a24\u0a41\u0a30\u0a70\u0a24 \u0a39\u0a71\u0a32 \u0a32\u0a08 \u0a38\u0a39\u0a40 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24/\u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a15\u0a3f\u0a38\u0a2e \u0a26\u0a40 \u0a1a\u0a4b\u0a23 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a1c\u0a3c\u0a4b\u0a30\u0a26\u0a3e\u0a30 \u0a38\u0a32\u0a3e\u0a39 \u0a26\u0a3f\u0a71\u0a24\u0a40 \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a17\u0a32\u0a24 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 / \u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a15\u0a3f\u0a38\u0a2e \u0a26\u0a40 \u0a1a\u0a4b\u0a23 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a26\u0a40 \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a1c\u0a3e\u0a02 \u0a30\u0a71\u0a26 \u0a15\u0a30\u0a28 \u0a35\u0a3f\u0a71\u0