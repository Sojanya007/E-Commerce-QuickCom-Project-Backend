u0ab5\u0ac7\u0ab0\u0abf\u0aab\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0ab8\u0ac0\u0a95\u0abf\u0a82\u0a97 \u0a8f\u0aa8\u0acd\u0a9f\u0abf\u0a9f\u0ac0 (OVSE) \u0aa8\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0a8f\u0a95\u0aa4\u0acd\u0ab0\u0abf\u0aa4 \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0a82\u0a97\u0acd\u0ab0\u0ab9\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0ab5\u0a97\u0ab0 \u0a93\u0aab\u0ab2\u0abe\u0a88\u0aa8 \u0a86\u0aa7\u0abe\u0ab0 \u0ab5\u0ac7\u0ab0\u0ac0\u0aab\u0ac0\u0a95\u0ac7\u0ab6\u0aa8\u0aa8\u0ac0 \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe \u0aae\u0ab3\u0ab6\u0ac7."},descTextStep1:"\u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ac7\u0aaa\u0ab0\u0ab2\u0ac7\u0ab8 \u0a91\u0aab\u0ab2\u0abe\u0a87\u0aa8 \u0a87-\u0a95\u0ac7\u0ab5\u0abe\u0aaf\u0ab8\u0ac0 \u0a8f \u0a8f\u0a95 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0a85\u0aa8\u0ac7 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a8f\u0ab5\u0acb \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a9b\u0ac7 \u0a9c\u0ac7\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a86\u0aa7\u0abe\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0a93\u0ab3\u0a96\u0aa8\u0ac0 \u0a91\u0aab\u0ab2\u0abe\u0a87\u0aa8 \u0a9a\u0a95\u0abe\u0ab8\u0aa3\u0ac0 \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0ab5\u0abf\u0a97\u0aa4\u0acb\u0aae\u0abe\u0a82 \u0aa8\u0abe\u0aae, \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82, \u0aab\u0acb\u0a9f\u0acb, \u0a9c\u0abe\u0aa4\u0abf, DoB, \u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0ab0\u0acd\u0aa1 \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0acb \u0ab9\u0ac7\u0ab6, \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0aaf\u0ac7\u0ab2 \u0a88\u0aae\u0ac7\u0a88\u0ab2 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a85\u0aa8\u0ac7 \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad \u0a86\u0a88\u0aa1\u0ac0\u0aa8\u0acb \u0ab9\u0ac7\u0ab6 \u0ab9\u0ab6\u0ac7 \u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0aa1\u0abf\u0a9c\u0abf\u0a9f\u0ab2\u0ac0 \u0ab9\u0ab8\u0acd\u0aa4\u0abe\u0a95\u0acd\u0ab7\u0ab0\u0abf\u0aa4 XML\u0aae\u0abe\u0a82 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0abe \u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0abe 4 \u0a85\u0a82\u0a95\u0acb \u0a85\u0aa8\u0ac7 \u0aaa\u0a9b\u0ac0 \u0a9f\u0abe\u0a88\u0aae \u0ab8\u0acd\u0a9f\u0ac7\u0aae\u0acd\u0aaa \u0ab9\u0ab6\u0ac7.",descTextStep2:"\u0a91\u0aab\u0ab2\u0abe\u0a87\u0aa8 eKYC \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0ac0 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a9d\u0ac0\u0aaa \u0aab\u0abe\u0a87\u0ab2 \u0ab8\u0aab\u0ab3\u0aa4\u0abe\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7"},lockUnlockBiometrics:{serviceCard:{errorMessage:"\u0a85\u0aae\u0ac7 \u0ab5\u0ab0\u0acd\u0aa4\u0aae\u0abe\u0aa8 \u0ab2\u0acb\u0a95/\u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0aae\u0ac7\u0ab3\u0ab5\u0ac0\u0a8f \u0aa4\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0ac1\u0aa7\u0ac0 \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab0\u0abe\u0ab9 \u0a9c\u0ac1\u0a93."},howItWorks:{title:"\u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95\u0acd\u0ab8 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab2\u0ac9\u0a95/\u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7",description:"Bio Lock/Unlock feature prevents possible misuse of the Resident\u2019s Biometrics Data. Locked Biometrics prevents the use of Biometrics information for authentications. Users of this Service are cautioned to do so with care to prevent denial of Authentication services.",infoData:{stepOneDescription:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95\u0acd\u0ab8\u0aa8\u0ac7 \u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa1\u0ac7\u0ab6\u0aac\u0acb\u0ab0\u0acd\u0aa1\u0aa5\u0ac0 \u0a86 \u0ab8\u0ac7\u0ab5\u0abe\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0acb. \u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aa4\u0aae\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95\u0acd\u0ab8 (\u0aab\u0abf\u0a82\u0a97\u0ab0\u0aaa\u0acd\u0ab0\u0abf\u0aa8\u0acd\u0a9f, \u0a86\u0a87\u0ab0\u0abf\u0ab8 \u0a85\u0aa8\u0ac7 \u0a9a\u0ab9\u0ac7\u0ab0\u0acb) \u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0acb \u0a9b\u0acb \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aa4\u0ac7\u0aa8\u0acb \u0ab9\u0ab5\u0ac7 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0aae\u0abe\u0a9f\u0ac7 \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0ab6\u0ac7 \u0aa8\u0ab9\u0ac0\u0a82. \u0a9c\u0acb \u0a95\u0ac7, OTP-\u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0a9c\u0ab0\u0ac2\u0ab0\u0abf\u0aaf\u0abe\u0aa4 \u0aae\u0ac1\u0a9c\u0aac \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7.",stepTwoDescription:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a86 \u0aaa\u0ac3\u0ab7\u0acd\u0aa0 \u0aaa\u0ab0 \u0aaa\u0abe\u0a9b\u0abe \u0aab\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95\u0acd\u0ab8\u0aa8\u0ac7 \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a86\u0a97\u0ab3 \u0ab5\u0aa7\u0acb. \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95\u0acd\u0ab8\u0aa8\u0ac7 \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aaa\u0ab0 (\u0aab\u0abf\u0a82\u0a97\u0ab0\u0aaa\u0acd\u0ab0\u0abf\u0aa8\u0acd\u0a9f + \u0a86\u0a87\u0ab0\u0abf\u0ab8 + \u0aab\u0ac7\u0ab8) OTP \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0ab8\u0abe\u0aa5\u0ac7 \u0ab8\u0a95\u0acd\u0ab7\u0aae \u0aa5\u0a88 \u0a9c\u0ab6\u0ac7."}},selectionScreen:{unlockCard:{heading:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb",consentText:"\u0ab9\u0ac1\u0a82 \u0ab8\u0aae\u0a9c\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95 \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0, \u0ab9\u0ac1\u0a82 \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac0\u0ab6.",label:"\u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95\u0acd\u0ab8 \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0acb"},lockCard:{heading:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb",consentText:"\u0ab9\u0ac1\u0a82 \u0ab8\u0aae\u0a9c\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95 \u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0, \u0a9c\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0ac1\u0aa7\u0ac0 \u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0abe \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95\u0acd\u0ab8\u0aa8\u0ac7 \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0aa8 \u0a95\u0ab0\u0ac1\u0a82 \u0aa4\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0ac1\u0aa7\u0ac0 \u0ab9\u0ac1\u0a82 \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac0\u0ab6 \u0aa8\u0ab9\u0ac0\u0a82.",label:"\u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95\u0acd\u0ab8 \u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0acb"},selectOptionError:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0a8f\u0a95 \u0ab5\u0abf\u0a95\u0ab2\u0acd\u0aaa \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb.",selectButton:{tempUnlock:"\u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95\u0acd\u0ab8\u0aa8\u0ac7 \u0a85\u0ab8\u0acd\u0aa5\u0abe\u0aaf\u0ac0 \u0ab0\u0ac2\u0aaa\u0ac7 \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0acb",tempUnlockInfo:"\u0a9f\u0ac2\u0a82\u0a95\u0abe \u0ab8\u0aae\u0aaf \u0aae\u0abe\u0a9f\u0ac7",unlock:"\u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95\u0acd\u0ab8 \u0a95\u0abe\u0aaf\u0aae\u0ac0 \u0aa7\u0acb\u0ab0\u0aa3\u0ac7 \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0acb",unlockInfo:"\u0a86\u0a97\u0ab2\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7 \u0aa4\u0aae\u0ac7 \u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0acb \u0aa4\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0ac1\u0aa7\u0ac0"}},successScreen:{tempUnlockMessage:"\u0a9c\u0acb \u0aa4\u0aae\u0ac7 \u0a95\u0abe\u0aaf\u0aae\u0ac0 \u0aa7\u0acb\u0ab0\u0aa3\u0ac7 \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0aa4\u0abe \u0ab9\u0acb, \u0aa4\u0acb \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa1\u0ac7\u0ab6\u0aac\u0acb\u0ab0\u0acd\u0aa1\u0aa5\u0ac0 \u0a86 \u0ab8\u0ac7\u0ab5\u0abe\u0aa8\u0ac0 \u0aab\u0ab0\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0acb."}},lockUnlockAadhaar:{howItWorks:{title:"\u0a86\u0aa7\u0abe\u0ab0 \u0ab2\u0ac9\u0a95/\u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a95\u0abe\u0aae \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7",infoData:{stepOneLabel:"3 \u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aaa\u0a97\u0ab2\u0ac1\u0a82 1: ",stepOneDescription:"\u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac7 \u0ab2\u0acb\u0a95 / \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0a86\u0a97\u0ab3 \u0ab5\u0aa7\u0aa4\u0abe \u0aaa\u0ab9\u0ac7\u0ab2\u0abe, \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 16-\u0a85\u0a82\u0a95\u0aa8\u0ac1\u0a82 \u0ab5\u0ab0\u0acd\u0a9a\u0acd\u0aaf\u0ac1\u0a85\u0ab2 \u0a86\u0a88\u0aa1\u0ac0 (VID) \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0acb, \u0a95\u0abe\u0ab0\u0aa3 \u0a95\u0ac7 \u0aae\u0abe\u0aa4\u0acd\u0ab0 VID \u0a9c \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac7 \u0ab2\u0acb\u0a95 /\u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a95\u0acd\u0ab7\u0aae\u0aa4\u0abe \u0aa7\u0ab0\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7. \u0aa4\u0aae\u0ac7 \u0aa1\u0ac7\u0ab6\u0aac\u0acb\u0ab0\u0acd\u0aa1\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0ab5\u0ab0\u0acd\u0a9a\u0acd\u0aaf\u0ac1\u0a85\u0ab2 \u0a86\u0a88\u0aa1\u0ac0 \u0ab8\u0ac7\u0ab5\u0abe\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a85\u0aa5\u0ab5\u0abe \u0ae7\u0aef\u0aea\u0aed \u0aaa\u0ab0 \u0a8f\u0ab8\u0a8f\u0aae\u0a8f\u0ab8 \u0aae\u0acb\u0a95\u0ab2\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 VID \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb. RVID [UID \u0aa8\u0abe \u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0abe 4 \u0a95\u0ac7 8 \u0a85\u0a82\u0a95\u0acb] {\u0aa6\u0abe\u0aa4: RVID 1234}. ",stepOneLinkText:" VID \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb",stepTwoLabel:"3 \u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aaa\u0a97\u0ab2\u0ac1\u0a82 2: ",stepTwoDescription:"\u0a8f\u0a95\u0ab5\u0abe\u0ab0 \u0aa4\u0aae\u0abe\u0ab0\u0acb VID \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0aa5\u0a88 \u0a9c\u0abe\u0aaf, \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a86 \u0aaa\u0ac3\u0ab7\u0acd\u0aa0 \u0aaa\u0ab0 \u0aaa\u0abe\u0a9b\u0abe \u0aab\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe VID \u0ab8\u0abe\u0aa5\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac7 \u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a86\u0a97\u0ab3 \u0ab5\u0aa7\u0acb, \u0aaa\u0a9b\u0ac0 \u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aaa\u0aa3 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0ab9\u0acb\u0aaf \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe VID \u0ab5\u0aa1\u0ac7 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0abf\u0aa4 \u0a95\u0ab0\u0acb, \u0a95\u0abe\u0ab0\u0aa3 \u0a95\u0ac7 \u0a8f\u0a95\u0ab5\u0abe\u0ab0 \u0ab2\u0ac9\u0a95 \u0aa5\u0a88 \u0a9c\u0abe\u0aaf \u0aaa\u0a9b\u0ac0 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a85\u0a95\u0acd\u0ab7\u0aae \u0aa5\u0a88 \u0a9c\u0ab6\u0ac7.",stepThreeLabel:"3 \u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aaa\u0a97\u0ab2\u0ac1\u0a82 3: ",stepThreeDescription:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a86 \u0aaa\u0ac3\u0ab7\u0acd\u0aa0 \u0aaa\u0ab0 \u0aaa\u0abe\u0a9b\u0abe \u0aab\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0a86\u0a97\u0ab3 \u0ab5\u0aa7\u0acb; \u0aae\u0abe\u0aa4\u0acd\u0ab0 VID \u0aaa\u0abe\u0ab8\u0ac7 \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac7 \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a95\u0acd\u0ab7\u0aae\u0aa4\u0abe \u0a9b\u0ac7, \u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac7 \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0ab5\u0abe\u0aa5\u0ac0 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0-\u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3\u0aa8\u0ac0 \u0aaa\u0aa3 \u0aaa\u0ab0\u0ab5\u0abe\u0aa8\u0a97\u0ac0 \u0aae\u0ab3\u0ac7 \u0a9b\u0ac7."}},formScreen:{title:"\u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac7 \u0ab2\u0ac9\u0a95/\u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb",radioLabels:{lockAadhaar:"\u0a86\u0aa7\u0abe\u0ab0 \u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0acb",unlockAadhaar:"\u0a86\u0aa7\u0abe\u0ab0 \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0acb"},consent:{lockConsent:"\u0ab9\u0ac1\u0a82 \u0ab8\u0aae\u0a9c\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0a86\u0aa7\u0abe\u0ab0 \u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0, \u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0ab5\u0ab0\u0acd\u0a9a\u0acd\u0aaf\u0ac1\u0a85\u0ab2 ID (VID)\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac0\u0ab6 \u0a85\u0aa8\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0acb \u0aa8\u0ab9\u0ac0\u0a82.",unlockConsent:"\u0ab9\u0ac1\u0a82 \u0ab8\u0aae\u0a9c\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac7 \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0, \u0ab9\u0ac1\u0a82 \u0ab5\u0ab0\u0acd\u0a9a\u0acd\u0aaf\u0ac1\u0a85\u0ab2 ID (VID) \u0a85\u0aa8\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aac\u0a82\u0aa8\u0ac7\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac0\u0ab6."},textFields:{name:"\u0aaa\u0ac2\u0ab0\u0ac1\u0a82 \u0aa8\u0abe\u0aae \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb",pincode:"\u0aaa\u0abf\u0aa8\u0a95\u0acb\u0aa1 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb"}}},verifyEmailMobile:{desc:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a88\u0aae\u0ac7\u0ab2/\u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0a9a\u0a95\u0abe\u0ab8\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb",verifyMobile:"\u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0a9a\u0a95\u0abe\u0ab8\u0acb",verifyEmail:"\u0a88\u0aae\u0ac7\u0ab2 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a9a\u0a95\u0abe\u0ab8\u0acb",verifyEmailMobile:"\u0a88\u0aae\u0ac7\u0ab2/\u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0a9a\u0a95\u0abe\u0ab8\u0acb"},bankLinkingStatus:{sectionTitle:"\u0a86\u0aa7\u0abe\u0ab0 \u0aac\u0ac7\u0a82\u0a95 \u0ab2\u0abf\u0a82\u0a95 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0aa4\u0aaa\u0abe\u0ab8\u0acb",aadhaarNumber:"\u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0",bankLinkingStatus:"\u0aac\u0ac7\u0a82\u0a95 \u0ab2\u0abf\u0a82\u0a95\u0abf\u0a82\u0a97 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf",active:"\u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf",inactive:"\u0aa8\u0abf\u0ab7\u0acd\u0a95\u0acd\u0ab0\u0abf\u0aaf",prevBankDetails:"\u0a85\u0a97\u0abe\u0a89\u0aa8\u0ac0 \u0aac\u0ac7\u0a82\u0a95 \u0ab2\u0abf\u0a82\u0a95\u0abf\u0a82\u0a97 \u0ab5\u0abf\u0a97\u0aa4\u0acb",lastUpdatedDate:"\u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0ac0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aa4\u0abe\u0ab0\u0ac0\u0a96",failureMessage:"\u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0a86\u0aa7\u0abe\u0ab0-\u0aac\u0ac7\u0a82\u0a95 \u0aae\u0ac7\u0aaa\u0abf\u0a82\u0a97 \u0aa5\u0a88 \u0a97\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7",successMessage:"\u0a86 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0acb\u0a88 \u0aac\u0ac7\u0a82\u0a95 \u0aae\u0ac7\u0aaa\u0abf\u0a82\u0a97 \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1 \u0aae\u0ab3\u0acd\u0aaf\u0acb \u0aa8\u0aa5\u0ac0",disclaimer:"\u0a86\u0aa7\u0abe\u0ab0 \u0ab2\u0abf\u0a82\u0a95\u0abf\u0a82\u0a97 \u0ab8\u0acd\u0a9f\u0ac7\u0a9f\u0ab8 NPCI \u0ab8\u0ab0\u0acd\u0ab5\u0ab0\u0aa5\u0ac0 \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab8\u0a82\u0a9c\u0acb\u0a97\u0acb\u0aae\u0abe\u0a82, UIDAI \u0aaa\u0acd\u0ab0\u0aa6\u0ab0\u0acd\u0ab6\u0abf\u0aa4 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf\u0aa8\u0ac0 \u0a9a\u0acb\u0a95\u0ab8\u0abe\u0a88 \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab5\u0abe\u0aac\u0aa6\u0abe\u0ab0 \u0a85\u0aa5\u0ab5\u0abe \u0a9c\u0ab5\u0abe\u0aac\u0aa6\u0abe\u0ab0 \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7 \u0aa8\u0ab9\u0ac0\u0a82. \u0ab5\u0aa7\u0ac1\u0aae\u0abe\u0a82, UIDAI NPCI \u0ab8\u0ab0\u0acd\u0ab5\u0ab0\u0aa5\u0ac0 \u0aae\u0ac7\u0ab3\u0ab5\u0ac7\u0ab2\u0ac0 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0ab8\u0a82\u0a97\u0acd\u0ab0\u0ab9\u0abf\u0aa4 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0ac1\u0a82 \u0aa8\u0aa5\u0ac0.",noRecordsAvailable:"\u0a95\u0acb\u0a88 \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0aa8\u0aa5\u0ac0",checkWithBank:"\u0aa4\u0aae\u0abe\u0ab0\u0acb \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aac\u0ac7\u0a82\u0a95 \u0a96\u0abe\u0aa4\u0abe \u0ab8\u0abe\u0aa5\u0ac7 \u0a9c\u0acb\u0aa1\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aac\u0ac7\u0a82\u0a95 \u0ab8\u0abe\u0aa5\u0ac7 \u0aa4\u0aaa\u0abe\u0ab8 \u0a95\u0ab0\u0acb"},bankSeedingStatus:{AadhaarNumber:"\u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0",BankName:"\u0aac\u0ac7\u0a82\u0a95\u0aa8\u0ac1\u0a82 \u0aa8\u0abe\u0aae",BankSeedingStatus:"\u0aac\u0ac7\u0a82\u0a95 \u0ab8\u0ac0\u0aa1\u0ac0\u0a82\u0a97 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf",LastUpdatedDate:"\u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0ac0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aa4\u0abe\u0ab0\u0ac0\u0a96",noRecordAlert:"\u0aa4\u0aae\u0abe\u0ab0\u0acb \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aac\u0ac7\u0a82\u0a95 \u0a96\u0abe\u0aa4\u0abe \u0ab8\u0abe\u0aa5\u0ac7 \u0ab2\u0abf\u0a82\u0a95 \u0a95\u0ab0\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aac\u0ac7\u0a82\u0a95 \u0ab8\u0abe\u0aa5\u0ac7 \u0aa4\u0aaa\u0abe\u0ab8 \u0a95\u0ab0\u0acb",note:"\u0ab2\u0abf\u0a82\u0a95 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaa\u0ac2\u0ab0\u0ac0 \u0aaa\u0abe\u0aa1\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0aa8\u0ac7\u0ab6\u0aa8\u0ab2 \u0aaa\u0ac7\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0a95\u0acb\u0ab0\u0acd\u0aaa\u0acb\u0ab0\u0ac7\u0ab6\u0aa8 \u0a93\u0aab \u0a88\u0aa8\u0acd\u0aa1\u0abf\u0aaf\u0abe (NPCI) \u0aa8\u0abe \u0ab8\u0ab0\u0acd\u0ab5\u0ab0\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7. \u0aa4\u0ac7\u0aa8\u0ac0 \u0a9a\u0acb\u0a95\u0ab8\u0abe\u0a88 \u0aae\u0abe\u0a9f\u0ac7 UIDAI \u0a9c\u0ab5\u0abe\u0aac\u0aa6\u0abe\u0ab0 \u0aa8\u0aa5\u0ac0. \u0aae\u0ac7\u0ab3\u0ab5\u0ac7\u0ab2 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 UIDAI \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab8\u0a82\u0a97\u0acd\u0ab0\u0ab9\u0abf\u0aa4 \u0aa8\u0aa5\u0ac0.",ActiveText:"\u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf",InactiveText:"\u0aa8\u0abf\u0ab7\u0acd\u0a95\u0acd\u0ab0\u0abf\u0aaf"},FAQ:{checkAadhaarPvcCardOrderStatus:[{question:"\u0ab6\u0ac1\u0a82 \u0ab9\u0ac1\u0a82 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0\u0aa8\u0ac1\u0a82 \u0a86\u0aa7\u0abe\u0ab0 \u0ab0\u0abe\u0a96\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82 \u0a9b\u0ac1\u0a82?",answer:"\u0ab9\u0abe"},{question:"'\u0a93\u0ab0\u0acd\u0aa1\u0ab0 \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ac0\u0ab5\u0ac0\u0ab8\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aa1' \u0ab8\u0ac7\u0ab5\u0abe \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"'\u0a93\u0ab0\u0acd\u0aa1\u0ab0 \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ac0\u0ab5\u0ac0\u0ab8\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aa1' \u0a8f UIDAI \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0a8f\u0a95 \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0ab8\u0ac7\u0ab5\u0abe \u0a9b\u0ac7 \u0a9c\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa7\u0abe\u0ab0\u0a95\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0a86\u0aa7\u0abe\u0ab0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aa8\u0a9c\u0ac0\u0ab5\u0abe \u0ab6\u0ac1\u0ab2\u0acd\u0a95 \u0a9a\u0ac2\u0a95\u0ab5\u0ac0\u0aa8\u0ac7 PVC \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0aaa\u0ab0 \u0aaa\u0acd\u0ab0\u0abf\u0aa8\u0acd\u0a9f \u0a95\u0ab0\u0abe\u0ab5\u0ab5\u0abe\u0aa8\u0ac0 \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe \u0a86\u0aaa\u0ac7 \u0a9b\u0ac7."},{question:"'\u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ac0\u0ab5\u0ac0\u0ab8\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aa1' \u0aa8\u0ac0 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0ab5\u0abf\u0ab6\u0ac7\u0ab7\u0aa4\u0abe\u0a93 \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"'\u0a86 \u0a95\u0abe\u0ab0\u0acd\u0aa1\u0aae\u0abe\u0a82 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe\u0a93 \u0a9b\u0ac7 \u0a9c\u0ac7\u0aae \u0a95\u0ac7:\n1. \u0a9f\u0ac7\u0aae\u0acd\u0aaa\u0ab0 \u0aaa\u0acd\u0ab0\u0ac2\u0aab QR \u0a95\u0acb\u0aa1\n2. \u0ab9\u0acb\u0ab2\u0acb\u0a97\u0acd\u0ab0\u0abe\u0aae\n3. \u0aae\u0abe\u0a87\u0a95\u0acd\u0ab0\u0acb \u0a9f\u0ac7\u0a95\u0acd\u0ab8\u0acd\u0a9f\n4. \u0aad\u0ac2\u0aa4 \u0a9b\u0aac\u0ac0\n5. \u0a85\u0a82\u0a95\u0aa8\u0ac0 \u0aa4\u0abe\u0ab0\u0ac0\u0a96 \u0a85\u0aa8\u0ac7 \u0a9b\u0abe\u0aaa\u0ab5\u0abe\u0aa8\u0ac0 \u0aa4\u0abe\u0ab0\u0ac0\u0a96\n6. Guilloche \u0aaa\u0ac7\u0a9f\u0ab0\u0acd\u0aa8\n7. \u0a8f\u0aae\u0acd\u0aac\u0acb\u0ab8\u0acd\u0aa1 \u0a86\u0aa7\u0abe\u0ab0 \u0ab2\u0acb\u0a97\u0acb'"},{question:"'\u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ac0\u0ab5\u0ac0\u0ab8\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aa1' \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0aaf\u0abe \u0ab6\u0ac1\u0ab2\u0acd\u0a95 \u0a9a\u0ac2\u0a95\u0ab5\u0ab5\u0abe \u0aaa\u0aa1\u0ab6\u0ac7?",answer:"\u0a9a\u0ac2\u0a95\u0ab5\u0ab5\u0abe\u0aa8\u0abe \u0a9a\u0abe\u0ab0\u0acd\u0a9c\u0ac0\u0ab8 \u0ab0\u0ac2. 50/- (\u0a9c\u0ac0\u0a8f\u0ab8\u0a9f\u0ac0 \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0aaa\u0ac0\u0aa1 \u0aaa\u0acb\u0ab8\u0acd\u0a9f \u0a9a\u0abe\u0ab0\u0acd\u0a9c \u0ab8\u0ab9\u0abf\u0aa4) \u0a9b\u0ac7."},{question:"'\u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ac0\u0ab5\u0ac0\u0ab8\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aa1' \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf?",answer:"''\u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ac0\u0ab5\u0ac0\u0ab8\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aa1' \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 UIDAI \u0ab8\u0aa4\u0acd\u0aa4\u0abe\u0ab5\u0abe\u0ab0 \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f (https://www.uidai.gov.in \u0a85\u0aa5\u0ab5\u0abe https://myaadhaar.uidai.gov.in) \u0a85\u0aa5\u0ab5\u0abe mAadhaar \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0a88\u0aa8\u0ac7 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7."},{question:"\u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0ab0\u0acd\u0aa1 \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a95\u0ab0\u0ab5\u0ac0?",answer:"'1. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 https://uidai.gov.in \u0a85\u0aa5\u0ab5\u0abe https://myaadhaar.uidai.gov.in/genricPVC \u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0acb.\n2. \u0aa4\u0aae\u0abe\u0ab0\u0acb 12 \u0a85\u0a82\u0a95\u0aa8\u0acb \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 (UID) \u0a85\u0aa5\u0ab5\u0abe 28 \u0a85\u0a82\u0a95\u0aa8\u0acb \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 ID \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb.\n3. \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0a95\u0acb\u0aa1 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb\n4. \u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0ab0\u0acd\u0aa1 \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aaa\u0ab0 \u0aae\u0ab3\u0ac7\u0ab2 OTP \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb.\n5. \u201c\u0aa8\u0abf\u0aaf\u0aae\u0acb \u0a85\u0aa8\u0ac7 \u0ab6\u0ab0\u0aa4\u0acb\u201d \u0ab8\u0abe\u0aae\u0ac7\u0aa8\u0abe \u0a9a\u0ac7\u0a95 \u0aac\u0acb\u0a95\u0acd\u0ab8 \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb. (\u0aa8\u0acb\u0a82\u0aa7: \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0a9c\u0acb\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab9\u0abe\u0a87\u0aaa\u0ab0 \u0ab2\u0abf\u0a82\u0a95 \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb).\n6. OTP \u0a9a\u0a95\u0abe\u0ab8\u0aa3\u0ac0 \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 '\u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0acb' \u0aac\u0a9f\u0aa8 \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb.\n7. \u0a86\u0a97\u0ab2\u0ac0 \u0ab8\u0acd\u0a95\u0acd\u0ab0\u0ac0\u0aa8 \u0aaa\u0ab0, \u0ab0\u0abf\u0aaa\u0acd\u0ab0\u0abf\u0aa8\u0acd\u0a9f \u0aae\u0abe\u0a9f\u0ac7 \u0a93\u0ab0\u0acd\u0aa1\u0ab0 \u0a86\u0aaa\u0aa4\u0abe \u0aaa\u0ab9\u0ac7\u0ab2\u0abe \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9a\u0a95\u0abe\u0ab8\u0aa3\u0ac0 \u0aae\u0abe\u0a9f\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0ab5\u0abf\u0a97\u0aa4\u0acb\u0aa8\u0ac1\u0a82 \u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0abe\u0ab5\u0ab2\u0acb\u0a95\u0aa8 \u0aa6\u0ac7\u0a96\u0abe\u0ab6\u0ac7.\n8. '\u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0a95\u0ab0\u0acb' \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb. \u0aa4\u0aae\u0aa8\u0ac7 \u0a95\u0acd\u0ab0\u0ac7\u0aa1\u0abf\u0a9f/\u0aa1\u0ac7\u0aac\u0abf\u0a9f \u0a95\u0abe\u0ab0\u0acd\u0aa1, \u0aa8\u0ac7\u0a9f \u0aac\u0ac7\u0a82\u0a95\u0abf\u0a82\u0a97 \u0a85\u0aa8\u0ac7 UPI \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0ab5\u0abf\u0a95\u0ab2\u0acd\u0aaa\u0acb \u0ab8\u0abe\u0aa5\u0ac7 \u0aaa\u0ac7\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0a97\u0ac7\u0a9f\u0ab5\u0ac7 \u0aaa\u0ac3\u0ab7\u0acd\u0aa0 \u0aaa\u0ab0 \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0aa8\u0abf\u0ab0\u0acd\u0aa6\u0ac7\u0ab6\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7.\n9. \u0ab8\u0aab\u0ab3 \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0aaa\u0a9b\u0ac0, \u0aa1\u0abf\u0a9c\u0abf\u0a9f\u0ab2 \u0ab9\u0ab8\u0acd\u0aa4\u0abe\u0a95\u0acd\u0ab7\u0ab0 \u0aa7\u0ab0\u0abe\u0ab5\u0aa4\u0ac0 \u0ab0\u0ab8\u0ac0\u0aa6 \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0aa5\u0ab6\u0ac7 \u0a9c\u0ac7 \u0aaa\u0ac0\u0aa1\u0ac0\u0a8f\u0aab \u0aab\u0acb\u0ab0\u0acd\u0aae\u0ac7\u0a9f\u0aae\u0abe\u0a82 \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7. \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0\u0aa8\u0ac7 SMS \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab8\u0ac7\u0ab5\u0abe \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0aa8\u0a82\u0aac\u0ab0 \u0aaa\u0aa3 \u0aae\u0ab3\u0ab6\u0ac7.\n10. \u0a86\u0aa7\u0abe\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0abe\u0ab0\u0acd\u0aa1\u0aa8\u0ac0 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0aa4\u0aaa\u0abe\u0ab8\u0ab5\u0abe \u0aaa\u0ab0 \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0aae\u0acb\u0a95\u0ab2\u0ac7 \u0aa4\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0ac1\u0aa7\u0ac0 SRN \u0aa8\u0ac0 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf\u0aa8\u0ac7 \u0a9f\u0acd\u0ab0\u0ac5\u0a95 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.\n11. AWB \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0ab0\u0abe\u0ab5\u0aa4\u0acb SMS \u0aaa\u0aa3 \u0a8f\u0a95\u0ab5\u0abe\u0ab0 DoP \u0aa4\u0ab0\u0aab\u0aa5\u0ac0 \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0a86\u0aa7\u0abe\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 DoP \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0a88\u0aa8\u0ac7 \u0aa1\u0abf\u0ab2\u0abf\u0ab5\u0ab0\u0ac0 \u0ab8\u0acd\u0a9f\u0ac7\u0a9f\u0ab8\u0aa8\u0ac7 \u0ab5\u0aa7\u0ac1 \u0a9f\u0acd\u0ab0\u0ac7\u0a95 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.'"},{question:"\u0aa8\u0acb\u0aa8-\u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0ab0\u0acd\u0aa1/\u0ab5\u0ac8\u0a95\u0ab2\u0acd\u0aaa\u0abf\u0a95 \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a95\u0ab0\u0ab5\u0ac0?",answer:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 https://uidai.gov.in \u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0acb \u0a85\u0aa5\u0ab5\u0abe https://myaadhaar.uidai.gov.in/genricPVC '\u0a93\u0ab0\u0acd\u0aa1\u0ab0 \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0abe\u0ab0\u0acd\u0aa1' \u0ab8\u0ac7\u0ab5\u0abe \u0a85\u0aa5\u0ab5\u0abe mAadhaar \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb \u0aa4\u0aae\u0abe\u0ab0\u0acb 12 \u0a85\u0a82\u0a95\u0aa8\u0acb \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 (UID) \u0a85\u0aa5\u0ab5\u0abe \u0a85\u0aa5\u0ab5\u0abe 28 \u0a85\u0a82\u0a95\u0acb\u0aa8\u0ac0 \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb \u0a86\u0a88\u0aa1\u0ac0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb \u0a9a\u0ac7\u0a95 \u0aac\u0ac9\u0a95\u0acd\u0ab8 \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb '\u0a9c\u0acb \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0abe\u0ab8\u0ac7 \u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0ab0\u0acd\u0aa1 \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aa8\u0aa5\u0ac0, \u0aa4\u0acb \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa8\u0acb\u0aa8-\u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0ab0\u0acd\u0aa1 / \u0ab5\u0ac8\u0a95\u0ab2\u0acd\u0aaa\u0abf\u0a95 \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0a93\u0ab0\u0acd\u0aa1\u0ab0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0abe \u0aac\u0abe\u0a95\u0ac0\u0aa8\u0abe \u0aaa\u0a97\u0ab2\u0abe\u0a82 \u0ab8\u0aae\u0abe\u0aa8 \u0a9b\u0ac7."},{question:"\u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0aaf\u0abe \u0aae\u0acb\u0aa1 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7?",answer:"'\u0ab9\u0abe\u0ab2\u0aae\u0abe\u0a82, \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0abe \u0a91\u0aa8\u0ab2\u0abe\u0a87\u0aa8 \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0aae\u0acb\u0aa1\u0acd\u0ab8 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7:-\n\u0a95\u0acd\u0ab0\u0ac7\u0aa1\u0abf\u0a9f \u0a95\u0abe\u0ab0\u0acd\u0aa1\n\u0aa1\u0ac7\u0aac\u0abf\u0a9f \u0a95\u0abe\u0ab0\u0acd\u0aa1\n\u0aa8\u0ac7\u0a9f \u0aac\u0ac7\u0aa8\u0acd\u0a95\u0abf\u0a82\u0a97\nUPI\nPayTM'"},{question:"SRN \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"SRN \u0a8f 14 \u0a85\u0a82\u0a95\u0aa8\u0acb \u0ab8\u0ab0\u0acd\u0ab5\u0abf\u0ab8 \u0ab0\u0abf\u0a95\u0acd\u0ab5\u0ac7\u0ab8\u0acd\u0a9f \u0aa8\u0a82\u0aac\u0ab0 \u0a9b\u0ac7 \u0a9c\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0 \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0aa5\u0abe\u0aaf \u0a9b\u0ac7. \u0a8f\u0a95\u0ab5\u0abe\u0ab0 \u0aa4\u0aae\u0ac7 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0ab6\u0acb \u0aa4\u0ac7 \u0aaa\u0a9b\u0ac0 \u0aa4\u0ac7 \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0aa5\u0ab6\u0ac7. \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0a9d\u0ac7\u0a95\u0acd\u0ab6\u0aa8 \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aa5\u0abe\u0aaf \u0aa4\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0ac1\u0aa7\u0ac0 '\u0ab0\u0abf\u0a9d\u0acd\u0aaf\u0ac2\u0aae\u0ac7' \u0ab5\u0abf\u0a95\u0ab2\u0acd\u0aaa \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7."},{question:"AWB \u0aa8\u0a82\u0aac\u0ab0 \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"\u0a8f\u0ab0\u0ab5\u0ac7 \u0aac\u0abf\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0a8f \u0a9f\u0acd\u0ab0\u0ac7\u0a95\u0abf\u0a82\u0a97 \u0aa8\u0a82\u0aac\u0ab0 \u0a9b\u0ac7 \u0a9c\u0ac7 \u0aa1\u0ac0\u0a93\u0aaa\u0ac0 \u0a8f\u0a9f\u0ab2\u0ac7 \u0a95\u0ac7 \u0a88\u0aa8\u0acd\u0aa1\u0abf\u0aaf\u0abe \u0ab8\u0acd\u0aaa\u0ac0\u0aa1 \u0aaa\u0acb\u0ab8\u0acd\u0a9f \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa4\u0ac7\u0a93 \u0a9c\u0ac7 \u0ab8\u0acb\u0a82\u0aaa\u0aa3\u0ac0/\u0a89\u0aa4\u0acd\u0aaa\u0abe\u0aa6\u0aa8 \u0aaa\u0ab9\u0acb\u0a82\u0a9a\u0abe\u0aa1\u0ac7 \u0a9b\u0ac7 \u0aa4\u0ac7\u0aa8\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7."},{question:"\u0a9c\u0acb \u0ab0\u0ab9\u0ac7\u0ab5\u0abe\u0ab8\u0ac0\u0a93 \u0aa4\u0ac7\u0aae\u0aa8\u0ac7 \u0a9c\u0acb\u0a88\u0aa4\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0ab8\u0abe\u0aa5\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 PVC \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0aaa\u0acd\u0ab0\u0abf\u0aa8\u0acd\u0a9f \u0a95\u0ab0\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0aa4\u0abe \u0ab9\u0acb\u0aaf \u0aa4\u0acb \u0ab6\u0ac1\u0a82?",answer:"\u0a9c\u0acb \u0ab0\u0ab9\u0ac7\u0ab5\u0abe\u0ab8\u0ac0\u0a93 \u0aaa\u0acd\u0ab0\u0abf\u0aa8\u0acd\u0a9f\u0ac7\u0aa1 \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0aa4\u0acd\u0ab0 \u0a85\u0aa5\u0ab5\u0abe \u0aaa\u0ac0\u0ab5\u0ac0\u0ab8\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aa1\u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb\u0aae\u0abe\u0a82 \u0a95\u0ac7\u0a9f\u0ab2\u0abe\u0a95 \u0aab\u0ac7\u0ab0\u0aab\u0abe\u0ab0\u0acb \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0aa4\u0abe \u0ab9\u0acb\u0aaf, \u0aa4\u0acb \u0aa4\u0ac7\u0a93\u0a8f \u0aaa\u0ab9\u0ac7\u0ab2\u0abe \u0a95\u0abe\u0aaf\u0aae\u0ac0 \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0a85\u0aa5\u0ab5\u0abe SSUP \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2 (\u0a85\u0aaa\u0aa1\u0ac7\u0a9f\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0ac7) \u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0a88\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0ac1\u0a82 \u0aaa\u0aa1\u0ab6\u0ac7 \u0a85\u0aa8\u0ac7 \u0aaa\u0a9b\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ab0\u0ab5\u0ac0 \u0aaa\u0aa1\u0ab6\u0ac7 \u0a95\u0abe\u0ab0\u0aa3 \u0a95\u0ac7 \u0a86 \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7. \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ac0\u0ab5\u0ac0\u0ab8\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aa1/\u0ab2\u0ac7\u0a9f\u0ab0\u0aa8\u0ac0 \u0ab9\u0abe\u0ab0\u0acd\u0aa1 \u0a95\u0acb\u0aaa\u0ac0"},{question:"\u0ab8\u0aab\u0ab3 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0 '\u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ac0\u0ab5\u0ac0\u0ab8\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aa1' \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a95\u0ac7\u0a9f\u0ab2\u0abe \u0aa6\u0abf\u0ab5\u0ab8\u0acb \u0ab2\u0abe\u0a97\u0ab6\u0ac7?",answer:"\u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u0a86\u0aa7\u0abe\u0ab0 PVC \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0aae\u0abe\u0a9f\u0ac7 \u0a93\u0ab0\u0acd\u0aa1\u0ab0 \u0aae\u0ab3\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0, UIDAI \u0aaa\u0acd\u0ab0\u0abf\u0aa8\u0acd\u0a9f\u0ac7\u0aa1 \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0aa1\u0ac0\u0a93\u0aaa\u0ac0\u0aa8\u0ac7 5 \u0a95\u0abe\u0aae\u0a95\u0abe\u0a9c\u0aa8\u0abe \u0aa6\u0abf\u0ab5\u0ab8\u0acb\u0aae\u0abe\u0a82 (\u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0aa8\u0ac0 \u0aa4\u0abe\u0ab0\u0ac0\u0a96 \u0ab8\u0abf\u0ab5\u0abe\u0aaf) \u0ab8\u0acb\u0a82\u0aaa\u0ac7 \u0a9b\u0ac7. \u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0ac7\u0a9f\u0abe\u0aac\u0ac7\u0a9d\u0aae\u0abe\u0a82 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0aaf\u0ac7\u0ab2\u0abe \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0a82 \u0aaa\u0ab0 \u0ab5\u0ab0\u0acd\u0aa4\u0aae\u0abe\u0aa8 \u0aa1\u0abf\u0ab2\u0abf\u0ab5\u0ab0\u0ac0 \u0aa7\u0acb\u0ab0\u0aa3\u0acb\u0aa8\u0ac7 \u0a85\u0aa8\u0ac1\u0ab0\u0ac2\u0aaa \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ac0\u0ab5\u0ac0\u0ab8\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0ab8\u0acd\u0aaa\u0ac0\u0aa1 \u0aaa\u0acb\u0ab8\u0acd\u0a9f \u0ab8\u0ab0\u0acd\u0ab5\u0abf\u0ab8 \u0a93\u0aab \u0a88\u0aa8\u0acd\u0aa1\u0abf\u0aaf\u0abe \u0aaa\u0acb\u0ab8\u0acd\u0a9f \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab5\u0abf\u0aa4\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 https://www.indiapost.gov.in/_layouts/15/dop.portal.track \u0aaa\u0ab0 DoP \u0a9f\u0acd\u0ab0\u0ac7\u0a95\u0abf\u0a82\u0a97 \u0ab8\u0ac7\u0ab5\u0abe\u0a93\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa1\u0abf\u0ab2\u0abf\u0ab5\u0ab0\u0ac0 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf\u0aa8\u0ac7 \u0a9f\u0acd\u0ab0\u0ac7\u0a95 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7"},{question:"\u0a86\u0aa7\u0abe\u0ab0 PVC \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0aa4\u0acd\u0ab0\u0aa5\u0ac0 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a85\u0ab2\u0a97 \u0a9b\u0ac7?",answer:"\u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0aa4\u0acd\u0ab0 \u0a8f \u0ab2\u0ac7\u0aae\u0abf\u0aa8\u0ac7\u0a9f\u0ac7\u0aa1 \u0aaa\u0ac7\u0aaa\u0ab0 \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a9b\u0ac7 \u0a9c\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95\u0acb\u0aa8\u0ac7 \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aaa\u0a9b\u0ac0 \u0a9c\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0a86\u0aa7\u0abe\u0ab0 PVC \u0a95\u0abe\u0ab0\u0acd\u0aa1 PVC \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0a9f\u0a95\u0abe\u0a89 \u0a85\u0aa8\u0ac7 \u0aac\u0ab9\u0ac1\u0ab5\u0abf\u0aa7 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe\u0a93 \u0ab8\u0abe\u0aa5\u0ac7 \u0ab2\u0a88 \u0a9c\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0ab0\u0ab3 \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0a9b\u0ac7. \u0a86\u0aa7\u0abe\u0ab0 PVC \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0aaa\u0aa3 \u0a8f\u0a9f\u0ab2\u0ac1\u0a82 \u0a9c \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0a9b\u0ac7."}],verifyEmailMobile:[{question:"\u0ab6\u0ac1\u0a82 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0ab5\u0abf\u0a97\u0aa4\u0acb\u0aa8\u0abe \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0acb\u0a88 \u0aab\u0ac0 \u0ab8\u0abe\u0aae\u0ac7\u0ab2 \u0a9b\u0ac7?",answer:"\u0ab9\u0abe, \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0\u0aa8\u0abe \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac7 \u0ab0\u0ac2. 50/- (\u0a9c\u0ac0\u0a8f\u0ab8\u0a9f\u0ac0 \u0ab8\u0ab9\u0abf\u0aa4)."}],orderAadhaarPvcCard:[{question:"\u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0abe \u0ab5\u0abf\u0ab5\u0abf\u0aa7 \u0ab8\u0acd\u0ab5\u0ab0\u0ac2\u0aaa\u0acb \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0ab5\u0abf\u0ab6\u0ac7\u0ab7\u0aa4\u0abe\u0a93 \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"\u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0abe \u0ab5\u0abf\u0ab5\u0abf\u0aa7 \u0ab8\u0acd\u0ab5\u0ab0\u0ac2\u0aaa\u0acb \u0a9b\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0aa4\u0acd\u0ab0, \u0a86\u0aa7\u0abe\u0ab0 PVC \u0a95\u0abe\u0ab0\u0acd\u0aa1, \u0a88-\u0a86\u0aa7\u0abe\u0ab0 \u0a85\u0aa8\u0ac7 m-\u0a86\u0aa7\u0abe\u0ab0. \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0abe \u0aa4\u0aae\u0abe\u0aae \u0ab8\u0acd\u0ab5\u0ab0\u0ac2\u0aaa\u0acb \u0ab8\u0aae\u0abe\u0aa8 \u0ab0\u0ac0\u0aa4\u0ac7 \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0acd\u0aaf \u0a9b\u0ac7."}],retrieveEidAadhaarNumber:[{question:"\u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0ac7\u0a9f\u0abe \u0a95\u0ac7\u0a9f\u0ab2\u0ac0 \u0ab5\u0abe\u0ab0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7?",answer:"'\u0a86\u0aa7\u0abe\u0ab0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0\u0aa8\u0abe \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0ac0 \u0aae\u0ab0\u0acd\u0aaf\u0abe\u0aa6\u0abe\u0a93 \u0ab2\u0abe\u0a97\u0ac1 \u0aaa\u0aa1\u0ac7 \u0a9b\u0ac7: \n\u2022 \u0aa8\u0abe\u0aae: \u0a9c\u0ac0\u0ab5\u0aa8\u0a95\u0abe\u0ab3\u0aae\u0abe\u0a82 \u0aac\u0ac7 \u0ab5\u0abe\u0ab0 \n\u2022 \u0a9c\u0abe\u0aa4\u0abf: \u0a9c\u0ac0\u0ab5\u0aa8\u0aae\u0abe\u0a82 \u0a8f\u0a95\u0ab5\u0abe\u0ab0 \n\u2022 \u0a9c\u0aa8\u0acd\u0aae \u0aa4\u0abe\u0ab0\u0ac0\u0a96: \u0a9c\u0ac0\u0ab5\u0aa8\u0aae\u0abe\u0a82 \u0a8f\u0a95\u0ab5\u0abe\u0ab0'"},{question:"\u0a86\u0aa7\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0aae\u0abe\u0ab0\u0abe \u0aa8\u0abe\u0aae\u0aae\u0abe\u0a82 \u0ab9\u0ac1\u0a82 \u0ab6\u0ac1\u0a82 \u0aab\u0ac7\u0ab0\u0aab\u0abe\u0ab0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",answer:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aa8\u0abe\u0aae\u0aae\u0abe\u0a82 \u0aa8\u0abe\u0aa8\u0abe \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0aa8\u0abe\u0aae\u0aae\u0abe\u0a82 \u0aab\u0ac7\u0ab0\u0aab\u0abe\u0ab0 \u0aae\u0abe\u0a9f\u0ac7, \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa8\u0a9c\u0ac0\u0a95\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0acb."},{question:"\u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0a8f\u0aa1\u0acd\u0ab0\u0ac7\u0ab8 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0aaf\u0abe \u0aa1\u0acb\u0a95\u0acd\u0aaf\u0ac1\u0aae\u0ac7\u0aa8\u0acd\u0a9f\u0acd\u0ab8\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0a9b\u0ac7?",answer:"\u0ab8\u0ab9\u0abe\u0aaf\u0a95 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb\u0aa8\u0ac0 \u0ab8\u0ac2\u0a9a\u0abf \u0aae\u0ac1\u0a9c\u0aac POA \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0aaa\u0aa1\u0ab6\u0ac7. https://uidai.gov.in \u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0acb."},{question:"\u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0aaf\u0abe \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0a9b\u0ac7?",answer:"\u0ab8\u0ab9\u0abe\u0aaf\u0a95 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb\u0aa8\u0ac0 \u0ab8\u0ac2\u0a9a\u0abf \u0a95\u0ac7 \u0a9c\u0ac7\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aa4\u0aae\u0ac7 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb \u0aa4\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab8\u0ac2\u0a9a\u0abf\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0aa1\u0ac7\u0a9f\u0abe \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0aa3\u0abe \u0ab9\u0abe\u0aa5 \u0aa7\u0ab0\u0aa4\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac0 \u0ab8\u0acd\u0a95\u0ac7\u0aa8/\u0a87\u0aae\u0ac7\u0a9c \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0acb."},{question:"\u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a91\u0aa8\u0ab2\u0abe\u0a87\u0aa8 \u0ab8\u0ac7\u0ab5\u0abe\u0aa8\u0abe \u0a95\u0abf\u0ab8\u0acd\u0ab8\u0abe\u0aae\u0abe\u0a82 \u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0abe \u0ab8\u0ab9\u0abe\u0aaf\u0a95 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",answer:"\u0aa4\u0aae\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a8f\u0aa1\u0acd\u0ab0\u0ac7\u0ab8 \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0ab8\u0ab0\u0acd\u0ab5\u0abf\u0ab8\u0aae\u0abe\u0a82 \u0aaa\u0ac0\u0aa1\u0ac0\u0a8f\u0aab \u0a85\u0aa5\u0ab5\u0abe \u0a9c\u0ac7\u0aaa\u0ac0\u0a88\u0a9c\u0ac0 \u0aab\u0acb\u0ab0\u0acd\u0aae\u0ac7\u0a9f\u0aae\u0abe\u0a82 \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0abf\u0a82\u0a97 \u0aa1\u0acb\u0a95\u0acd\u0aaf\u0ac1\u0aae\u0ac7\u0aa8\u0acd\u0a9f\u0aa8\u0ac0 \u0ab8\u0acd\u0a95\u0ac7\u0aa8/\u0a88\u0aae\u0ac7\u0a9c \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ab9\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0abe\u0a9a\u0acb \u0ab8\u0ab9\u0abe\u0aaf\u0a95 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb. \u0aaa\u0abe\u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f, \u0aad\u0abe\u0aa1\u0ac1\u0a82 \u0a85\u0aa8\u0ac7 \u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0a95\u0ab0\u0abe\u0ab0 \u0a9c\u0ac7\u0ab5\u0abe \u0a85\u0aae\u0ac1\u0a95 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0aae\u0abe\u0a9f\u0ac7, \u0aac\u0ab9\u0ac1\u0ab5\u0abf\u0aa7 \u0aaa\u0ac3\u0ab7\u0acd\u0aa0\u0acb\u0aa8\u0ac0 \u0a9b\u0aac\u0ac0\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0aaa\u0aa1\u0ab6\u0ac7."},{question:"\u0ab6\u0ac1\u0a82 \u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0abf\u0a95 \u0aad\u0abe\u0ab7\u0abe\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a86\u0aa7\u0abe\u0ab0 \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0ab8\u0ac7\u0ab5\u0abe \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",answer:"\u0ab9\u0abe\u0ab2\u0aae\u0abe\u0a82 \u0aa4\u0aae\u0ac7 \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0abf\u0a95 \u0aad\u0abe\u0ab7\u0abe\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0aa4\u0abe \u0aa8\u0aa5\u0ac0."},{question:"\u0ab6\u0ac1\u0a82 \u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0ac0 \u0a9c\u0aa8\u0acd\u0aae \u0aa4\u0abe\u0ab0\u0ac0\u0a96 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a86\u0aa7\u0abe\u0ab0 \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0ab8\u0ac7\u0ab5\u0abe \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",answer:"\u0aa8\u0abe, \u0a9c\u0aa8\u0acd\u0aae \u0aa4\u0abe\u0ab0\u0ac0\u0a96 (DoB) \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 DoB \u0aaa\u0acd\u0ab0\u0ac2\u0aab \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0ab8\u0abe\u0aa5\u0ac7 \u0aa8\u0a9c\u0ac0\u0a95\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0acb."},{question:"\u0aae\u0ac7\u0a82 \u0aaa\u0ab9\u0ac7\u0ab2\u0ac7\u0aa5\u0ac0 \u0a9c \u0aae\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0a9c\u0aa8\u0acd\u0aae\u0aa4\u0abe\u0ab0\u0ac0\u0a96 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0a9b\u0ac7. \u0ab6\u0ac1\u0a82 \u0ab9\u0ac1\u0a82 \u0aa4\u0ac7\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f/\u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",answer:"\u0aa8\u0abe. \u0aa4\u0aae\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a9c\u0aa8\u0acd\u0aae\u0aa4\u0abe\u0ab0\u0ac0\u0a96 (DoB) \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0a8f\u0a95 \u0a9c \u0ab5\u0abe\u0ab0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb. \u0a85\u0ab8\u0abe\u0aa7\u0abe\u0ab0\u0aa3 \u0ab8\u0a82\u0a9c\u0acb\u0a97\u0acb\u0aae\u0abe\u0a82 \u0a86\u0a97\u0ab3\u0aa8\u0ac0 \u0a9c\u0aa8\u0acd\u0aae\u0aa4\u0abe\u0ab0\u0ac0\u0a96 (DoB) \u0aac\u0aa6\u0ab2\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7, \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a86 \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad\u0ac7 1947 \u0aaa\u0ab0 \u0a95\u0ac9\u0ab2 \u0a95\u0ab0\u0acb."},{question:"\u0ab6\u0ac1\u0a82 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0ab8\u0aac\u0aae\u0abf\u0ab6\u0aa8 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0\u0aa8\u0abe \u0a85\u0aaa\u0aa1\u0ac7\u0a9f\u0aa8\u0ac0 \u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a86\u0aaa\u0ac7 \u0a9b\u0ac7?",answer:"\u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0ab8\u0aac\u0aae\u0abf\u0ab6\u0aa8 \u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0ac7\u0a9f\u0abe\u0aa8\u0abe \u0a85\u0aaa\u0aa1\u0ac7\u0a9f\u0aa8\u0ac0 \u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a86\u0aaa\u0aa4\u0ac1\u0a82 \u0aa8\u0aa5\u0ac0. \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a86\u0aa7\u0abe\u0ab0 \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0ab8\u0ac7\u0ab5\u0abe \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0abe \u0aab\u0ac7\u0ab0\u0aab\u0abe\u0ab0\u0acb UIDAI \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9a\u0a95\u0abe\u0ab8\u0aa3\u0ac0 \u0a85\u0aa8\u0ac7 \u0aae\u0abe\u0aa8\u0acd\u0aaf\u0aa4\u0abe\u0aa8\u0ac7 \u0a86\u0aa7\u0abf\u0aa8 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aae\u0abe\u0aa8\u0acd\u0aaf\u0aa4\u0abe \u0aaa\u0a9b\u0ac0 \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0aab\u0ac7\u0ab0\u0aab\u0abe\u0ab0\u0aa8\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0aaa\u0ab0 \u0a86\u0aa7\u0abe\u0ab0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aae\u0abe\u0a9f\u0ac7 \u0a86\u0a97\u0ab3 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7."},{question:"\u0aae\u0ac7\u0a82 \u0aae\u0abe\u0ab0\u0acb \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0a97\u0ac1\u0aae\u0abe\u0ab5\u0ac0 \u0aa6\u0ac0\u0aa7\u0acb \u0a9b\u0ac7/ \u0a9c\u0ac7 \u0aa8\u0a82\u0aac\u0ab0 \u0aae\u0ac7\u0a82 \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0abe\u0aa5\u0ac7 \u0aa8\u0acb\u0a82\u0aa7\u0acd\u0aaf\u0acb \u0a9b\u0ac7 \u0aa4\u0ac7 \u0aa8\u0a82\u0aac\u0ab0 \u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0abe\u0ab8\u0ac7 \u0aa8\u0aa5\u0ac0. \u0aae\u0abe\u0ab0\u0ac7 \u0aae\u0abe\u0ab0\u0ac0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0ac0 \u0a9c\u0acb\u0a88\u0a8f?",answer:"\u0a9c\u0acb \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0abe\u0ab8\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0abe\u0aa5\u0ac7 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0aaf\u0ac7\u0ab2 \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0a96\u0acb\u0ab5\u0abe\u0a88 \u0a97\u0aaf\u0acb \u0ab9\u0acb\u0aaf/ \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0abe\u0ab8\u0ac7 \u0aa8 \u0ab9\u0acb\u0aaf, \u0aa4\u0acb \u0aa4\u0aae\u0abe\u0ab0\u0ac7 \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0a9c\u0ac0\u0a95\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aa8\u0ac0 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0ab0\u0ac0\u0aa4\u0ac7 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0ac7\u0ab5\u0ac0 \u0aaa\u0aa1\u0ab6\u0ac7."},{question:"\u0ab6\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0acb \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aa5\u0aaf\u0abe \u0aaa\u0a9b\u0ac0 \u0aac\u0aa6\u0ab2\u0abe\u0a88 \u0a9c\u0ab6\u0ac7?",answer:"\u0aa8\u0abe, \u0aa4\u0aae\u0abe\u0ab0\u0acb \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aa5\u0aaf\u0abe \u0aaa\u0a9b\u0ac0 \u0aaa\u0aa3 \u0a8f \u0a9c \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7."},{question:"\u0ab9\u0ac1\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0ac1 \u0a9b\u0ac1\u0a82. \u0ab6\u0ac1\u0a82 \u0ab9\u0ac1\u0a82 \u0aa4\u0ac7 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac0\u0ab6?",answer:"\u0a9c\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0ac1\u0aa7\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a86\u0a97\u0ab3\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab2\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8 \u0a86\u0ab5\u0ac7 \u0aa4\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0ac1\u0aa7\u0ac0 \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 myAadhaar \u0aa1\u0ac7\u0ab6\u0aac\u0acb\u0ab0\u0acd\u0aa1\u0aae\u0abe\u0a82 \u2018\u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u2019 \u0ab8\u0acd\u0aaa\u0ac7\u0ab8\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0aa8\u0ac7 \u0ab0\u0aa6 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0a9c\u0acb \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0aa4\u0acb, \u0a9a\u0ac2\u0a95\u0ab5\u0ac7\u0ab2 \u0ab0\u0a95\u0aae 21 \u0aa6\u0abf\u0ab5\u0ab8\u0aa8\u0ac0 \u0a85\u0a82\u0aa6\u0ab0 \u0a96\u0abe\u0aa4\u0abe\u0aae\u0abe\u0a82 \u0aaa\u0ab0\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7."},{question:"\u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0ac0 \u0aac\u0aa7\u0ac0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0a93 \u0a95\u0acd\u0aaf\u0abe\u0a82 \u0a9c\u0acb\u0a88 \u0ab6\u0a95\u0ac1\u0a82?",answer:"\u0a8f\u0a95 \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 \u0aae\u0abe\u0aaf\u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0ac7\u0ab6\u0aac\u0acb\u0ab0\u0acd\u0aa1\u0aa8\u0ac0 \u0a85\u0a82\u0aa6\u0ab0 \u2018\u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u2019 \u0ab8\u0acd\u0aaa\u0ac7\u0ab8\u0aa8\u0ac0 \u0a85\u0a82\u0aa6\u0ab0 \u0aa4\u0ac7\u0aa8\u0ac0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0\u0a93 \u0a9c\u0acb\u0a88 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7."},{question:"\u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0abe \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aae\u0abe\u0a82 \u0aae\u0abe\u0ab0\u0abe \u0aaa\u0abf\u0aa4\u0abe/\u0aaa\u0aa4\u0abf\u0aa8\u0ac1\u0a82 \u0aa8\u0abe\u0aae \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a89\u0aae\u0ac7\u0ab0\u0ac1\u0a82?",answer:"\u0ab8\u0a82\u0aac\u0a82\u0aa7\u0aa8\u0ac0 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0a8f \u0a86\u0aa7\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0a8f\u0aa1\u0acd\u0ab0\u0ac7\u0ab8 \u0aab\u0ac0\u0ab2\u0acd\u0aa1\u0aa8\u0acb \u0a8f\u0a95 \u0aad\u0abe\u0a97 \u0a9b\u0ac7. \u0a86\u0aa8\u0ac7 C/o (\u0a95\u0ac7\u0ab0 \u0a93\u0aab) \u0aae\u0abe\u0a9f\u0ac7 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7. \u0a86 \u0aad\u0ab0\u0ab5\u0ac1\u0a82 \u0ab5\u0ac8\u0a95\u0ab2\u0acd\u0aaa\u0abf\u0a95 \u0a9b\u0ac7."}],eaadhaarDownload:[{question:"\u0a88-\u0a86\u0aa7\u0abe\u0ab0 \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"\u0a88-\u0a86\u0aa7\u0abe\u0ab0 \u0a8f \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac0 \u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0a88\u0ab2\u0ac7\u0a95\u0acd\u0a9f\u0acd\u0ab0\u0acb\u0aa8\u0abf\u0a95 \u0a95\u0acb\u0aaa\u0ac0 \u0a9b\u0ac7, \u0a9c\u0ac7 UIDAI \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa1\u0abf\u0a9c\u0abf\u0a9f\u0ab2\u0ac0 \u0ab8\u0ab9\u0ac0 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7."},{question:"\u0ab6\u0ac1\u0a82 \u0a88-\u0a86\u0aa7\u0abe\u0ab0 \u0a8f \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac0 \u0aad\u0acc\u0aa4\u0abf\u0a95 \u0aa8\u0a95\u0ab2\u0aa8\u0ac0 \u0a9c\u0ac7\u0aae \u0a9c \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0a9b\u0ac7?",answer:"\u0a86\u0aa7\u0abe\u0ab0 \u0a8f\u0a95\u0acd\u0a9f \u0aae\u0ac1\u0a9c\u0aac, \u0a88-\u0a86\u0aa7\u0abe\u0ab0 \u0a8f \u0aa4\u0aae\u0abe\u0aae \u0ab9\u0ac7\u0aa4\u0ac1\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0ac0 \u0aad\u0acc\u0aa4\u0abf\u0a95 \u0aa8\u0a95\u0ab2\u0aa8\u0ac0 \u0a9c\u0ac7\u0aae \u0a9c \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0a9b\u0ac7. eAadhaar \u0aa8\u0ac0 \u0aae\u0abe\u0aa8\u0acd\u0aaf\u0aa4\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 UIDAI \u0aaa\u0ab0\u0abf\u0aaa\u0aa4\u0acd\u0ab0\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0acb- https://uidai.gov.in/images/ uidai_om_on_e_aadhaar_validity.pdf"},{question:"\u0aae\u0abe\u0ab8\u0acd\u0a95\u0acd\u0aa1 \u0a86\u0aa7\u0abe\u0ab0 \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"\u0aae\u0abe\u0ab8\u0acd\u0a95 \u0a95\u0ab0\u0ac7\u0ab2 \u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0acb \u0a85\u0ab0\u0acd\u0aa5 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0aa5\u0aae 8 \u0a85\u0a82\u0a95\u0acb\u0aa8\u0ac7 \u201cxxxx-xxxx\u201d \u0ab8\u0abe\u0aa5\u0ac7 \u0aac\u0aa6\u0ab2\u0ab5\u0abe\u0aa8\u0acb \u0a9b\u0ac7 \u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0abe \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0abe 4 \u0a85\u0a82\u0a95 \u0a9c \u0aa6\u0ac7\u0a96\u0abe\u0aaf \u0a9b\u0ac7."},{question:"\u0a87-\u0a86\u0aa7\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0aa1\u0abf\u0a9c\u0abf\u0a9f\u0ab2 \u0ab9\u0ab8\u0acd\u0aa4\u0abe\u0a95\u0acd\u0ab7\u0ab0 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0a95\u0ab0\u0ab5\u0abe?",answer:"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 YouTube \u0a9a\u0ac7\u0aa8\u0ab2\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0acb \u0a85\u0aa8\u0ac7 https://youtu.be/aVNfUNIccZs?si=ByW1O6BIPMwc0seL \u0aaa\u0ab0 \u0a9f\u0acd\u0aaf\u0ac1\u0a9f\u0acb\u0ab0\u0abf\u0aaf\u0ab2 \u0ab2\u0abf\u0a82\u0a95 \u0a9c\u0ac1\u0a93"},{question:"\u0a88-\u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0acb \u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1 \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"\u0a88-\u0a86\u0aa7\u0abe\u0ab0\u0aa8\u0acb \u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1 \u0a95\u0ac7\u0aaa\u0abf\u0a9f\u0ab2\u0aae\u0abe\u0a82 \u0aa8\u0abe\u0aae\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0aa5\u0aae 4 \u0a85\u0a95\u0acd\u0ab7\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0a9c\u0aa8\u0acd\u0aae \u0ab5\u0ab0\u0acd\u0ab7 (YYYY)\u0aa8\u0ac1\u0a82 \u0ab8\u0a82\u0aaf\u0acb\u0a9c\u0aa8 \u0a9b\u0ac7.\n\u0a89\u0aa6\u0abe\u0ab9\u0ab0\u0aa3 \u0aa4\u0ab0\u0ac0\u0a95\u0ac7:\n\u0a89\u0aa6\u0abe\u0ab9\u0ab0\u0aa3 1\n\u0aa8\u0abe\u0aae: \u0ab8\u0ac1\u0ab0\u0ac7\u0ab6 \u0a95\u0ac1\u0aae\u0abe\u0ab0\n\u0a9c\u0aa8\u0acd\u0aae \u0ab5\u0ab0\u0acd\u0ab7: 1990\n\u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1: SURE1990\n\u0a89\u0aa6\u0abe\u0ab9\u0ab0\u0aa3 2\n\u0aa8\u0abe\u0aae: \u0ab8\u0abe\u0a88 \u0a95\u0ac1\u0aae\u0abe\u0ab0\n\u0a9c\u0aa8\u0acd\u0aae \u0ab5\u0ab0\u0acd\u0ab7: 1990\n\u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1: SAIK1990\n\u0a89\u0aa6\u0abe\u0ab9\u0ab0\u0aa3 3\n\u0aa8\u0abe\u0aae: \u0aaa\u0ac0. \u0a95\u0ac1\u0aae\u0abe\u0ab0\n\u0a9c\u0aa8\u0acd\u0aae \u0ab5\u0ab0\u0acd\u0ab7: 1990\n\u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1: P.KU1990\n\u0a89\u0aa6\u0abe\u0ab9\u0ab0\u0aa3 4\n\u0aa8\u0abe\u0aae: RIA\n\u0a9c\u0aa8\u0acd\u0aae \u0ab5\u0ab0\u0acd\u0ab7: 1990\n\u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1: RIA1990"},{question:"\u0a88-\u0a86\u0aa7\u0abe\u0ab0 \u0a96\u0acb\u0ab2\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0aaf\u0abe \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0abf\u0a82\u0a97 \u0ab8\u0acb\u0aab\u0acd\u0a9f\u0ab5\u0ac7\u0ab0\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0a9b\u0ac7?",answer:"\u0a88-\u0a86\u0aa7\u0abe\u0ab0 \u0a9c\u0acb\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0\u0aa8\u0ac7 '\u0a8f\u0aa1\u0acb\u0aac \u0ab0\u0ac0\u0aa1\u0ab0'\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0a9b\u0ac7. \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0abf\u0ab8\u0acd\u0a9f\u0aae\u0aae\u0abe\u0a82 '\u0a8f\u0aa1\u0acb\u0aac \u0ab0\u0ac0\u0aa1\u0ab0' \u0a87\u0aa8\u0acd\u0ab8\u0acd\u0a9f\u0acb\u0ab2 \u0a95\u0ab0\u0ac7\u0ab2 \u0a9b\u0ac7. \u0ab8\u0abf\u0ab8\u0acd\u0a9f\u0aae\u0aae\u0abe\u0a82 \u0a8f\u0aa1\u0acb\u0aac \u0ab0\u0ac0\u0aa1\u0ab0 \u0a87\u0aa8\u0acd\u0ab8\u0acd\u0a9f\u0acb\u0ab2 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7\nhttps://get.adobe.com/reader/ \u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0acb '"},{question:"\u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0a88-\u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7?\n\u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0a95\u0acd\u0aaf\u0abe\u0a82\u0aa5\u0ac0 \u0a88-\u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7?",answer:"\u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0aa4\u0acd\u0ab0\u0aa3 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a85\u0aa8\u0ac1\u0ab8\u0ab0\u0ac0\u0aa8\u0ac7 \u0a88-\u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.\n\u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7:\n\u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7:\nVID \u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7:\n\u0a88-\u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0acb OTP \u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0ab0\u0acd\u0aa1 \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aaa\u0ab0 \u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0aa5\u0ab6\u0ac7.\n\u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0a9a\u0ac7\u0aa8 \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aab\u0acb\u0aa8 \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0abe\u0aaf\u0abe\u0aa6\u0abe\u0ab0\u0ac0 \u0a85\u0aaa\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 UIDAI \u0aa8\u0abe Madar Porta- Hetps://myadar.uyudai.gov.in \u0a85\u0aa5\u0ab5\u0abe \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0a88\u0aa8\u0ac7 A-\u0a86\u0aa7\u0abe\u0ab0 \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb."}],bookAnAppointment:[{question:"UIDAI \u0aae\u0abe\u0a82 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 \u0aa8\u0abf\u0ab5\u0abe\u0ab0\u0aa3 \u0a9a\u0ac7\u0aa8\u0ab2\u0acb \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"\u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a93 \u0aac\u0ab9\u0ac1\u0ab5\u0abf\u0aa7 \u0a9a\u0ac7\u0aa8\u0ab2\u0acb \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe UIDAI \u0ab8\u0ac1\u0aa7\u0ac0 \u0aaa\u0ab9\u0acb\u0a82\u0a9a\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 \u0aa8\u0abf\u0ab5\u0abe\u0ab0\u0aa3 \u0aae\u0abe\u0a9f\u0ac7 \u0aab\u0acb\u0aa8, \u0a88\u0aae\u0ac7\u0ab2, \u0a9a\u0ac7\u0a9f, \u0aaa\u0aa4\u0acd\u0ab0/\u0aaa\u0acb\u0ab8\u0acd\u0a9f, \u0ab5\u0ac7\u0aac \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2, \u0ab5\u0acb\u0a95 \u0a88\u0aa8 \u0a85\u0aa8\u0ac7 \u0ab8\u0acb\u0ab6\u0abf\u0aaf\u0ab2 \u0aae\u0ac0\u0aa1\u0abf\u0aaf\u0abe.\n\u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9a\u0ac7\u0aa8\u0ab2\u0acb \u0ab5\u0abf\u0ab6\u0ac7 \u0ab5\u0abf\u0a97\u0aa4\u0ab5\u0abe\u0ab0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0aa8\u0ac0\u0a9a\u0ac7 \u0aae\u0ac1\u0a9c\u0aac \u0a9b\u0ac7:\n1. \u0aab\u0acb\u0aa8 \u0a95\u0ac9\u0ab2 (\u0a9f\u0acb\u0ab2 \u0aab\u0acd\u0ab0\u0ac0 \u0aa8\u0a82\u0aac\u0ab0) -\n\u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0a9a\u0abf\u0a82\u0aa4\u0abe\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a93 UIDAI \u0a9f\u0acb\u0ab2 \u0aab\u0acd\u0ab0\u0ac0 \u0aa8\u0a82\u0aac\u0ab0 (1947)\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. UIDAI \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aae\u0abe\u0a82 \u0ab8\u0acd\u0ab5 \u0ab8\u0ac7\u0ab5\u0abe IVRS (\u0a87\u0aa8\u0acd\u0a9f\u0ab0\u0ac7\u0a95\u0acd\u0a9f\u0abf\u0ab5 \u0ab5\u0ac9\u0a87\u0ab8 \u0ab0\u0abf\u0ab8\u0acd\u0aaa\u0acb\u0aa8\u0acd\u0ab8 \u0ab8\u0abf\u0ab8\u0acd\u0a9f\u0aae) \u0a85\u0aa8\u0ac7 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0a8f\u0a95\u0acd\u0a9d\u0abf\u0a95\u0acd\u0aaf\u0ac1\u0a9f\u0abf\u0ab5 \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0ab8\u0ab9\u0abe\u0aaf\u0aa8\u0acb \u0ab8\u0aae\u0abe\u0ab5\u0ac7\u0ab6 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7. \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0ab8\u0ab0\u0ab3\u0aa4\u0abe \u0aae\u0ac1\u0a9c\u0aac \u0ab5\u0abe\u0aa4\u0a9a\u0ac0\u0aa4 \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0ac0\u0a9a\u0ac7 \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ac7\u0ab2 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aad\u0abe\u0ab7\u0abe \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.\n.1. \u0ab9\u0abf\u0aa8\u0acd\u0aa6\u0ac0\n5. \u0a95\u0aa8\u0acd\u0aa8\u0aa1\n9. \u0a97\u0ac1\u0a9c\u0ab0\u0abe\u0aa4\u0ac0\n2. \u0a85\u0a82\u0a97\u0acd\u0ab0\u0ac7\u0a9c\u0ac0\n6. \u0aae\u0ab2\u0aaf\u0abe\u0ab2\u0aae\n10. \u0aae\u0ab0\u0abe\u0aa0\u0ac0\n\u0aa4\u0acd\u0ab0\u0aa3. \u0aa4\u0ac7\u0ab2\u0ac1\u0a97\u0ac1\n7. \u0a86\u0ab8\u0abe\u0aae\u0ac0\n11. \u0aaa\u0a82\u0a9c\u0abe\u0aac\u0ac0\n4. \u0aa4\u0aae\u0abf\u0ab2\n8. \u0aac\u0a82\u0a97\u0abe\u0ab3\u0ac0\n12. \u0aa1\u0ac0 \n\u0ab8\u0aae\u0aaf:\na) IVRS \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab8\u0acd\u0ab5 \u0ab8\u0ac7\u0ab5\u0abe\u0aa8\u0acb \u0ab2\u0abe\u0aad \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0acb: IVRS \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab8\u0ac7\u0ab5\u0abe\u0a93 24X7 \u0aa7\u0acb\u0ab0\u0aa3\u0ac7 \u0ab8\u0acd\u0ab5 \u0ab8\u0ac7\u0ab5\u0abe \u0aae\u0acb\u0aa1\u0aae\u0abe\u0a82 \u0aae\u0ac7\u0ab3\u0ab5\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.\nb) \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0a8f\u0a95\u0acd\u0a9d\u0abf\u0a95\u0acd\u0aaf\u0ac1\u0a9f\u0abf\u0ab5 \u0ab8\u0ab9\u0abe\u0aaf: \u0a86 \u0ab8\u0ac7\u0ab5\u0abe \u0ab8\u0acb\u0aae\u0ab5\u0abe\u0ab0 - \u0ab6\u0aa8\u0abf\u0ab5\u0abe\u0ab0: \u0ab8\u0ab5\u0abe\u0ab0\u0ac7 7 \u0aa5\u0ac0 11 \u0ab5\u0abe\u0a97\u0acd\u0aaf\u0abe \u0ab8\u0ac1\u0aa7\u0ac0, \u0ab0\u0ab5\u0abf\u0ab5\u0abe\u0ab0: \u0ab8\u0ab5\u0abe\u0ab0\u0ac7 8 \u0aa5\u0ac0 \u0ab8\u0abe\u0a82\u0a9c\u0ac7 5 \u0ab5\u0abe\u0a97\u0acd\u0aaf\u0abe \u0ab8\u0ac1\u0aa7\u0ac0 \u0aae\u0ac7\u0ab3\u0ab5\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.\n\u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb\u0aa8\u0ac1\u0a82 \u0aa8\u0abf\u0ab0\u0abe\u0a95\u0ab0\u0aa3 \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aa8\u0abe \u0a8f\u0a95\u0acd\u0a9d\u0abf\u0a95\u0acd\u0aaf\u0ac1\u0a9f\u0abf\u0ab5 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe UIDAI \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0aae\u0abe\u0aa8\u0a95 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0aad\u0abe\u0ab5\u0acb \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 UIDAI \u0aa8\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0ab5\u0abf\u0aad\u0abe\u0a97\u0acb/\u0aaa\u0acd\u0ab0\u0abe\u0aa6\u0ac7\u0ab6\u0abf\u0a95 \u0a95\u0a9a\u0ac7\u0ab0\u0ac0\u0a93\u0aa8\u0ac7 \u0ab5\u0abe\u0ab8\u0acd\u0aa4\u0ab5\u0abf\u0a95 \u0ab8\u0aae\u0aaf\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0ac7 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0acb \u0ab8\u0acb\u0a82\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0a85\u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0a95 \u0aa8\u0abf\u0ab0\u0abe\u0a95\u0ab0\u0aa3 \u0a85\u0aa8\u0ac7 \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0aac\u0abe\u0aa6 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf \u0ab8\u0abe\u0aa5\u0ac7 \u0ab5\u0abe\u0aa4\u0a9a\u0ac0\u0aa4 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 UIDAI\u0aa8\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0ab5\u0abf\u0aad\u0abe\u0a97/\u0aaa\u0acd\u0ab0\u0abe\u0aa6\u0ac7\u0ab6\u0abf\u0a95 \u0a95\u0a9a\u0ac7\u0ab0\u0ac0\u0a93\u0aae\u0abe\u0a82 \u0a86 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0acb\u0aa8\u0ac0 \u0a86\u0a82\u0aa4\u0ab0\u0abf\u0a95 \u0aa4\u0aaa\u0abe\u0ab8 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7.\n2. \u0a9a\u0ac7\u0a9f\u0aac\u0acb\u0a9f (\u0a86\u0aa7\u0abe\u0ab0 \u0aae\u0abf\u0aa4\u0acd\u0ab0) \u2013 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a93 UIDAI \u0a9a\u0ac7\u0a9f\u0aac\u0acb\u0a9f \u0ab8\u0ac7\u0ab5\u0abe '\u0a86\u0aa7\u0abe\u0ab0 \u0aae\u0abf\u0aa4\u0acd\u0ab0' \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0a9a\u0abf\u0a82\u0aa4\u0abe \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 \u0a9c\u0ac7 UIDAI \u0aa8\u0ac0 \u0a85\u0aa7\u0abf\u0a95\u0ac3\u0aa4 \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f \u0aaa\u0ab0 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac73. UIDAI \u0ab5\u0ac7\u0aac \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2 - \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a93 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0ab9\u0ac7\u0aa0\u0ab3 UIDAI \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f \u0aaa\u0ab0 \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0ab5\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac0 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0aa4\u0aaa\u0abe\u0ab8\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0a85\u0aa8\u0ac1\u0a95\u0acd\u0ab0\u0aae\u0ac7 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 / \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0aa4\u0aaa\u0abe\u0ab8\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \n4. \u0a88\u0aae\u0ac7\u0ab2 - \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb \u0a85\u0aa8\u0ac7 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf help@uidai.gov.in \u0aaa\u0ab0 \u0a88\u0aae\u0ac7\u0ab2 \u0aae\u0acb\u0a95\u0ab2\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.\n5. \u0aaa\u0acd\u0ab0\u0abe\u0aa6\u0ac7\u0ab6\u0abf\u0a95 \u0a95\u0a9a\u0ac7\u0ab0\u0ac0\u0a93\u0aae\u0abe\u0a82 \u0ab5\u0acb\u0a95-\u0a87\u0aa8: \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a93 \u0aa4\u0ac7\u0aae\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb\u0aa8\u0abe \u0aa8\u0abf\u0ab0\u0abe\u0a95\u0ab0\u0aa3 \u0a85\u0aa5\u0ab5\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0acb \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0abe \u0ab0\u0abe\u0a9c\u0acd\u0aaf \u0a85\u0aa8\u0ac1\u0ab8\u0abe\u0ab0 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0abe\u0aa6\u0ac7\u0ab6\u0abf\u0a95 \u0a95\u0a9a\u0ac7\u0ab0\u0ac0\u0a93\u0aae\u0abe\u0a82 \u0ab8\u0ac0\u0aa7\u0abe \u0a9c \u0a9c\u0a88 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.\n6. \u0aaa\u0acb\u0ab8\u0acd\u0a9f/\u0aaa\u0aa4\u0acd\u0ab0: \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a93 \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0acb \u0aaa\u0acb\u0ab8\u0acd\u0a9f \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe UIDAI HO \u0a85\u0aa5\u0ab5\u0abe \u0aaa\u0acd\u0ab0\u0abe\u0aa6\u0ac7\u0ab6\u0abf\u0a95 \u0a95\u0a9a\u0ac7\u0ab0\u0ac0\u0a93\u0aae\u0abe\u0a82 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0ab5\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa5\u0ab5\u0abe \u0ab9\u0abe\u0aa5 \u0ab5\u0aa1\u0ac7 \u0a85\u0ab0\u0a9c\u0ac0 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0abe\u0aa6\u0ac7\u0ab6\u0abf\u0a95 \u0a95\u0a9a\u0ac7\u0ab0\u0ac0/\u0ab5\u0abf\u0aad\u0abe\u0a97 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0aa8\u0abe \u0aa8\u0abf\u0ab0\u0abe\u0a95\u0ab0\u0aa3 \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0aaa\u0a97\u0ab2\u0abe\u0a82 \u0ab2\u0ac7\u0ab6\u0ac7.\n7. \u0aad\u0abe\u0ab0\u0aa4 \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0aa8\u0ac1\u0a82 \u0aaa\u0aac\u0acd\u0ab2\u0abf\u0a95 \u0a97\u0acd\u0ab0\u0ac0\u0ab5\u0aa8\u0acd\u0ab8 \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2 (CPGRAMS): UIDAI \u0aaa\u0ab0 \u0ab8\u0ac7\u0aa8\u0acd\u0a9f\u0acd\u0ab0\u0ab2\u0abe\u0a88\u0a9d\u0acd\u0aa1 \u0aaa\u0aac\u0acd\u0ab2\u0abf\u0a95 \u0a97\u0acd\u0ab0\u0ac0\u0ab5\u0aa8\u0acd\u0ab8 \u0ab0\u0abf\u0aa1\u0acd\u0ab0\u0ac7\u0ab8 \u0a8f\u0aa8\u0acd\u0aa1 \u0aae\u0acb\u0aa8\u0abf\u0a9f\u0ab0\u0abf\u0a82\u0a97 \u0ab8\u0abf\u0ab8\u0acd\u0a9f\u0aae (CPGRAMS) \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0acb \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0ab5\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7. \u0a86 \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95\u0acb \u0aae\u0abe\u0a9f\u0ac7 24x7 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0a9b\u0ac7.\n8. \u0ab8\u0acb\u0ab6\u0abf\u0aaf\u0ab2 \u0aae\u0ac0\u0aa1\u0abf\u0aaf\u0abe: \u0a9f\u0acd\u0ab5\u0abf\u0a9f\u0ab0, \u0aab\u0ac7\u0ab8\u0aac\u0ac1\u0a95, \u0aaf\u0ac1 \u0a9f\u0acd\u0aaf\u0ac1\u0aac, \u0a87\u0aa8\u0acd\u0ab8\u0acd\u0a9f\u0abe\u0a97\u0acd\u0ab0\u0abe\u0aae \u0ab5\u0a97\u0ac7\u0ab0\u0ac7 \u0a9c\u0ac7\u0ab5\u0abe \u0aac\u0ab9\u0ac1\u0ab5\u0abf\u0aa7 \u0ab8\u0acb\u0ab6\u0abf\u0aaf\u0ab2 \u0aae\u0ac0\u0aa1\u0abf\u0aaf\u0abe \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0ab5\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7. \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0a9a\u0abf\u0a82\u0aa4\u0abe/\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0aa8\u0ac7 \u0ab2\u0a97\u0aa4\u0ac0 \u0aaa\u0acb\u0ab8\u0acd\u0a9f UIDAI\u0aa8\u0ac7 \u0a9f\u0ac7\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa5\u0ab5\u0abe \u0ab5\u0abf\u0ab5\u0abf\u0aa7 \u0ab8\u0acb\u0ab6\u0abf\u0aaf\u0ab2 \u0aae\u0ac0\u0aa1\u0abf\u0aaf\u0abe \u0ab8\u0acd\u0a9f\u0acd\u0ab0\u0ac0\u0aae\u0acd\u0ab8 \u0aaa\u0ab0 \u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0aaa\u0ac7\u0a9c\u0aa8\u0ac7 DM \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7."},{question:"\u0ab6\u0ac1\u0a82 \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0ac7\u0ab5\u0abe \u0ab6\u0ac1\u0ab2\u0acd\u0a95 \u0a85\u0ab2\u0a97 \u0a9b\u0ac7?\nFor charges please refer : Aadhaar Enrolment & Update Charges",answer:"\u0aa8\u0abe, \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb \u0ab8\u0ab9\u0abf\u0aa4 \u0aa6\u0ac7\u0ab6\u0aa8\u0abe \u0aa4\u0aae\u0abe\u0aae \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb \u0aaa\u0ab0 \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe\u0a93 \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0abe \u0ab6\u0ac1\u0ab2\u0acd\u0a95 \u0ab8\u0aae\u0abe\u0aa8 \u0a9b\u0ac7."},{question:"\u0ab6\u0ac1\u0a82 \u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0ac0 \u0a8f\u0aaa\u0acb\u0a87\u0aa8\u0acd\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0ab6\u0ac7\u0aa1\u0acd\u0aaf\u0ac2\u0ab2/\u0ab0\u0aa6 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",answer:"\u0ab9\u0abe, \u0aa4\u0aae\u0ac7 \u0a8f \u0a9c \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0/\u0a88\u0aae\u0ac7\u0ab2 \u0a86\u0a88\u0aa1\u0ac0 (\u0a9c\u0ac7\u0aae \u0a95\u0ac7 \u0a85\u0a97\u0abe\u0a89 \u0a86\u0aaa\u0ac7\u0ab2 \u0a9b\u0ac7) \u0ab5\u0aa1\u0ac7 \u0a8f\u0aaa\u0acb\u0a88\u0aa8\u0acd\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2\u0aae\u0abe\u0a82 \u0ab2\u0acb\u0a97\u0a88\u0aa8 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 24 \u0a95\u0ab2\u0abe\u0a95 \u0aaa\u0ab9\u0ac7\u0ab2\u0abe \u0a8f\u0aaa\u0acb\u0a88\u0aa8\u0acd\u0a9f\u0aae\u0ac7\u0aa8\u0acd\u0a9f\u0aa8\u0ac7 \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0ab6\u0ac7\u0aa1\u0acd\u0aaf\u0ac2\u0ab2 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb."},{question:"\u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0ab9\u0ac1\u0a82 \u0a95\u0a88 \u0ab8\u0ac7\u0ab5\u0abe\u0a93 \u0aae\u0ac7\u0ab3\u0ab5\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",answer:"\u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb \u0aa4\u0aae\u0abe\u0aae \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0\u0aa8\u0ac0 \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe\u0a93 \u0aaa\u0ac2\u0ab0\u0ac0 \u0aaa\u0abe\u0aa1\u0ac7 \u0a9b\u0ac7 \u0a9c\u0ac7\u0aae \u0a95\u0ac7\n1. \u0aa4\u0aae\u0abe\u0aae \u0ab5\u0aaf \u0a9c\u0ac2\u0aa5 \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0ab5\u0ac0 \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0.\n2. \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 \u0ab5\u0abf\u0ab7\u0aaf\u0a95 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 (\u0aa8\u0abe\u0aae, \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82, \u0a9c\u0abe\u0aa4\u0abf, \u0a9c\u0aa8\u0acd\u0aae \u0aa4\u0abe\u0ab0\u0ac0\u0a96, \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0a85\u0aa8\u0ac7 \u0a88\u0aae\u0ac7\u0ab2 \u0a86\u0a88\u0aa1\u0ac0) \u0aa8\u0ac0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f.\n3. \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0\u0aa8\u0ac1\u0a82 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f (\u0aab\u0acb\u0a9f\u0acb, \u0aab\u0abf\u0a82\u0a97\u0ab0\u0aaa\u0acd\u0ab0\u0abf\u0aa8\u0acd\u0a9f\u0acd\u0ab8 \u0a85\u0aa8\u0ac7 \u0a86\u0a87\u0ab0\u0abf\u0ab8 \u0ab8\u0acd\u0a95\u0ac7\u0aa8).\n4. \u0aac\u0abe\u0ab3\u0a95\u0acb\u0aa8\u0ac1\u0a82 \u0aab\u0ab0\u0a9c\u0abf\u0aaf\u0abe\u0aa4 \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f (5 \u0a85\u0aa8\u0ac7 15 \u0ab5\u0ab0\u0acd\u0ab7\u0aa8\u0ac0 \u0a89\u0a82\u0aae\u0ab0\u0ac7 \u0aaa\u0ab9\u0acb\u0a82\u0a9a\u0aa4\u0abe).\n5. \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0aa1\u0ac7\u0a9f (POI \u0a85\u0aa8\u0ac7 POA) .\n6. \u0a86\u0aa7\u0abe\u0ab0 \u0ab6\u0acb\u0aa7\u0acb \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0abf\u0aa8\u0acd\u0a9f \u0a95\u0ab0\u0acb."},{question:"UIDAI ASKs (\u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb) \u0aa8\u0abe \u0ab8\u0aae\u0aaf \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"\u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb \u0ab0\u0abe\u0ab7\u0acd\u0a9f\u0acd\u0ab0\u0ac0\u0aaf/\u0aaa\u0acd\u0ab0\u0abe\u0aa6\u0ac7\u0ab6\u0abf\u0a95 \u0ab0\u0a9c\u0abe\u0a93\u0aa8\u0ac7 \u0aac\u0abe\u0aa6 \u0a95\u0ab0\u0aa4\u0abe\u0a82 \u0a85\u0aa0\u0ab5\u0abe\u0aa1\u0abf\u0aaf\u0abe\u0aa8\u0abe \u0aa4\u0aae\u0abe\u0aae 7 \u0aa6\u0abf\u0ab5\u0ab8 \u0a96\u0ac1\u0ab2\u0acd\u0ab2\u0abe \u0ab0\u0ab9\u0ac7 \u0a9b\u0ac7. \u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 \u0aa4\u0ac7 9:30 AM \u0aa5\u0ac0 5:30 PM (IST) \u0ab8\u0ac1\u0aa7\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aaf \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.\nUIDAI ASK \u0ab8\u0abf\u0ab5\u0abe\u0aaf\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb \u0aa4\u0ac7\u0aae\u0aa8\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0acd\u0ab0\u0abe\u0ab0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa8\u0abf\u0ab0\u0acd\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0ab8\u0aae\u0aaf\u0aa8\u0ac7 \u0a85\u0aa8\u0ac1\u0ab8\u0ab0\u0ac7 \u0a9b\u0ac7. \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0a87\u0a9a\u0acd\u0a9b\u0aa4\u0ac0 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a93/ \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95\u0acb \u0ab5\u0aa7\u0ac1 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0abe \u0aa8\u0a9c\u0ac0\u0a95\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7."},{question:"\u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 (ASK) \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"\u2018\u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u2019 \u0a85\u0aa5\u0ab5\u0abe ASK \u0a8f \u0ab0\u0ab9\u0ac7\u0ab5\u0abe\u0ab8\u0ac0\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0abe\u0aae \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0abf\u0a82\u0a97\u0ab2-\u0ab8\u0acd\u0a9f\u0acb\u0aaa \u0aa1\u0ac7\u0ab8\u0acd\u0a9f\u0abf\u0aa8\u0ac7\u0ab6\u0aa8 \u0a9b\u0ac7. ASK \u0a85\u0aa4\u0acd\u0aaf\u0abe\u0aa7\u0ac1\u0aa8\u0abf\u0a95 \u0ab5\u0abe\u0aa4\u0abe\u0ab5\u0ab0\u0aa3\u0aae\u0abe\u0a82 \u0ab0\u0ab9\u0ac7\u0ab5\u0abe\u0ab8\u0ac0\u0a93\u0aa8\u0ac7 \u0ab8\u0aae\u0ab0\u0acd\u0aaa\u0abf\u0aa4 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0a85\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab8\u0ac7\u0ab5\u0abe\u0a93 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7. \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0ab0\u0ab9\u0ac7\u0ab5\u0abe\u0ab8\u0ac0\u0a93\u0aa8\u0ac7 \u0a86\u0ab0\u0abe\u0aae\u0aa6\u0abe\u0aaf\u0a95 \u0ab5\u0abe\u0aa4\u0abe\u0aa8\u0ac1\u0a95\u0ac2\u0ab2\u0abf\u0aa4 \u0ab5\u0abe\u0aa4\u0abe\u0ab5\u0ab0\u0aa3 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7. \u0aac\u0aa7\u0abe ASK \u0ab5\u0acd\u0ab9\u0ac0\u0ab2\u0a9a\u0ac7\u0ab0 \u0aab\u0acd\u0ab0\u0ac7\u0aa8\u0acd\u0aa1\u0ab2\u0ac0 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0ab5\u0ac3\u0aa6\u0acd\u0aa7\u0acb \u0a85\u0aa8\u0ac7 \u0a96\u0abe\u0ab8 \u0aa6\u0abf\u0ab5\u0acd\u0aaf\u0abe\u0a82\u0a97\u0acb\u0aa8\u0ac7 \u0ab8\u0ac7\u0ab5\u0abe \u0a86\u0aaa\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0abf\u0ab6\u0ac7\u0ab7 \u0a9c\u0acb\u0a97\u0ab5\u0abe\u0a88\u0a93 \u0aa7\u0ab0\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7. ASK \u0ab5\u0abf\u0ab6\u0ac7 \u0ab5\u0aa7\u0ac1 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0a85\u0ab9\u0ac0\u0a82 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7: uidai.gov.in \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a88\u0a9f."},{question:"\u0ab9\u0ac1\u0a82 UIDAI ASK (\u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb) \u0aa8\u0ac0 \u0aaf\u0abe\u0aa6\u0ac0 \u0a95\u0acd\u0aaf\u0abe\u0a82\u0aa5\u0ac0 \u0aae\u0ac7\u0ab3\u0ab5\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",answer:"\u0aa4\u0aae\u0abe\u0aae \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0abe\u0aa4\u0acd\u0aae\u0a95 ASK \u0aa8\u0ac0 \u0ab8\u0a82\u0a95\u0ab2\u0abf\u0aa4 \u0ab8\u0ac2\u0a9a\u0abf \u0a85\u0ab9\u0ac0\u0a82 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7: \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aa8\u0ac0 \u0ab8\u0ac2\u0a9a\u0abf\n\u0a86 ASK \u0aaa\u0ab9\u0ac7\u0ab2\u0abe\u0aa5\u0ac0 \u0aac\u0ac7\u0a82\u0a95\u0acb, \u0aaa\u0acb\u0ab8\u0acd\u0a9f \u0a93\u0aab\u0abf\u0ab8, CSC, BSNL \u0a85\u0aa8\u0ac7 \u0ab0\u0abe\u0a9c\u0acd\u0aaf \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0acb \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab8\u0a82\u0a9a\u0abe\u0ab2\u0abf\u0aa4 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0acb \u0a89\u0aaa\u0ab0\u0abe\u0a82\u0aa4 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7"}],checkEnrolmentUpdateStatus:[{question:"\u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a86\u0aa7\u0abe\u0ab0 \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0ab8\u0ac7\u0ab5\u0abe \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab9\u0ac1\u0a82 \u0a95\u0a88 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",answer:"\u0a86 \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0ab2 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe, \u0aa4\u0aae\u0ac7 \u0aab\u0a95\u0acd\u0aa4 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a85\u0aa8\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb. \u0a85\u0aa8\u0acd\u0aaf \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aae\u0abe\u0a9f\u0ac7, \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa8\u0a9c\u0ac0\u0a95\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0acb."}],checkAadhaarValidity:[],lockUnlockAadhaar:[{question:"\u0aae\u0abe\u0ab0\u0ac0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a85\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0a95\u0abe\u0ab0\u0ac0 \u0a95\u0abe\u0aa2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0. \u0a86\u0aa8\u0acb \u0a85\u0ab0\u0acd\u0aa5 \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"'\u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0a8f\u0aa1\u0acd\u0ab0\u0ac7\u0ab8 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0ac7 \u0a9c\u0ac7 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0acb \u0a9b\u0acb \u0aa4\u0ac7 \u0a86 \u0ab9\u0acb\u0ab5\u0acb \u0a9c\u0acb\u0a88\u0a8f:\n\u2022 https://uidai.gov.in \u0aae\u0ac1\u0a9c\u0aac \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c.\n\u2022 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac7\u0ab2 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0\u0aa8\u0abe \u0aa8\u0abe\u0aae\u0ac7 \u0a9b\u0ac7.\n\u2022 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac7\u0ab2\u0ac0 \u0a9b\u0aac\u0ac0 \u0aae\u0ac2\u0ab3 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0aa8\u0ac0 \u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f \u0a85\u0aa8\u0ac7 \u0ab0\u0a82\u0a97\u0ac0\u0aa8 \u0ab8\u0acd\u0a95\u0ac7\u0aa8 \u0ab9\u0acb\u0ab5\u0ac0 \u0a9c\u0acb\u0a88\u0a8f.\n\u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a95\u0ab0\u0acb \u0a95\u0ac7 \u0aa4\u0aae\u0ac7 \u0aa8\u0ab5\u0ac0 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ab0\u0acb \u0aa4\u0ac7 \u0aaa\u0ab9\u0ac7\u0ab2\u0abe\u0a82 \u0aa4\u0aae\u0ac7 \u0a89\u0aaa\u0ab0\u0acb\u0a95\u0acd\u0aa4\u0aa8\u0ac7 \u0a85\u0aa8\u0ac1\u0ab8\u0ab0\u0acb \u0a9b\u0acb.'"},{question:"\u0a86\u0aa7\u0abe\u0ab0 (UID) \u0ab2\u0acb\u0a95 \u0a85\u0aa8\u0ac7 \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"'\u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 \u0aae\u0abe\u0a9f\u0ac7, \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0aa1\u0ac7\u0a9f\u0abe\u0aa8\u0ac0 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0a85\u0aa8\u0ac7 \u0a97\u0acb\u0aaa\u0aa8\u0ac0\u0aaf\u0aa4\u0abe \u0ab9\u0a82\u0aae\u0ac7\u0ab6\u0abe \u0aaa\u0acd\u0ab0\u0abe\u0aa5\u0aae\u0abf\u0a95 \u0a9a\u0abf\u0a82\u0aa4\u0abe\u0aa8\u0acb \u0ab5\u0abf\u0ab7\u0aaf \u0a9b\u0ac7. \u0aa4\u0ac7\u0aa8\u0abe/\u0aa4\u0ac7\u0aa3\u0ac0\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0ac0 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe\u0aa8\u0ac7 \u0aae\u0a9c\u0aac\u0ac2\u0aa4 \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa8\u0ac7 \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0\u0aa8\u0ac7 \u0aa8\u0abf\u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0aa3 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, UIDAI \u0a8f \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 (UID)\u0aa8\u0ac7 \u0ab2\u0ac9\u0a95 \u0a85\u0aa8\u0ac7 \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0aaa\u0aa6\u0acd\u0aa7\u0aa4\u0abf \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.\n\u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 UIDAI \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f www.myaadhaar.uidai.gov.in \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a85\u0aa5\u0ab5\u0abe mAadhaar \u0a8f\u0aaa \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa4\u0ac7\u0aa8\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0aa4\u0ac7\u0aa3\u0ac0\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0 (UID)\u0aa8\u0ac7 \u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.\n\u0a86\u0aae \u0a95\u0ab0\u0ab5\u0abe\u0aa5\u0ac0 \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95\u0acd\u0ab8, \u0aa1\u0ac7\u0aae\u0acb\u0a97\u0acd\u0ab0\u0abe\u0aab\u0abf\u0a95 \u0a85\u0aa8\u0ac7 OTP \u0aae\u0acb\u0aa1\u0ab2\u0abf\u0a9f\u0ac0 \u0aae\u0abe\u0a9f\u0ac7 UID, UID \u0a9f\u0acb\u0a95\u0aa8 \u0a85\u0aa8\u0ac7 VID \u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0\u0aa8\u0ac1\u0a82 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0aa4\u0abe \u0aa8\u0aa5\u0ac0.\n\u0a9c\u0acb \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 UID \u0aa8\u0ac7 \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0ac7 \u0a9b\u0ac7 \u0aa4\u0acb \u0aa4\u0ac7 UIDAI \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f \u0a85\u0aa5\u0ab5\u0abe mAadhaar \u0a8f\u0aaa \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa8\u0ab5\u0ac0\u0aa8\u0aa4\u0aae VID \u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.\n\u0a86\u0aa7\u0abe\u0ab0 (UID) \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0, \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 UID, UID \u0a9f\u0acb\u0a95\u0aa8 \u0a85\u0aa8\u0ac7 VID \u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.'"},{question:"\u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 UID \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7?",answer:"'UID \u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 \u0aaa\u0abe\u0ab8\u0ac7 16 \u0a85\u0a82\u0a95\u0aa8\u0acb VID \u0aa8\u0a82\u0aac\u0ab0 \u0ab9\u0acb\u0ab5\u0acb \u0a9c\u0acb\u0a88\u0a8f \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7 \u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aaa\u0ac2\u0ab0\u0acd\u0ab5-\u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0a9b\u0ac7. \u0a9c\u0acb \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 \u0aaa\u0abe\u0ab8\u0ac7 VID \u0aa8 \u0ab9\u0acb\u0aaf \u0aa4\u0acb SMS \u0ab8\u0ac7\u0ab5\u0abe \u0a85\u0aa5\u0ab5\u0abe UIDAI \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f (www.myaadhaar.uidai.gov.in) \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.\nSMS \u0ab8\u0ac7\u0ab5\u0abe. GVID \u0a9c\u0a97\u0acd\u0aaf\u0abe UID \u0aa8\u0abe 4 \u0a85\u0aa5\u0ab5\u0abe 8 \u0a85\u0a82\u0a95\u0aa8\u0ac0 \u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0ac0 \u0a9b\u0ac7. 1947. Ex-GVID 1234 \u0aaa\u0ab0 SMS \u0a95\u0ab0\u0acb.\n\u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 UIDAI \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f https://resident.uidai.gov.in/aadhaar-lockunlock \u0aae\u0abe\u0aaf \u0a86\u0aa7\u0abe\u0ab0 \u0a9f\u0ac7\u0aac \u0ab9\u0ac7\u0aa0\u0ab3, \u0a86\u0aa7\u0abe\u0ab0 \u0ab2\u0acb\u0a95 \u0a85\u0aa8\u0ac7 \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0ab8\u0ac7\u0ab5\u0abe\u0a93 \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. UID \u0ab2\u0acb\u0a95 \u0ab0\u0ac7\u0aa1\u0abf\u0aaf\u0acb \u0aac\u0a9f\u0aa8 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0aa8\u0ab5\u0ac0\u0aa8\u0aa4\u0aae \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aae\u0ac1\u0a9c\u0aac UID \u0aa8\u0a82\u0aac\u0ab0, \u0a86\u0a96\u0ac1\u0a82 \u0aa8\u0abe\u0aae \u0a85\u0aa8\u0ac7 \u0aaa\u0abf\u0aa8 \u0a95\u0acb\u0aa1 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0a95\u0acb\u0aa1 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb. Send OTP \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb. \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 UID \u0ab8\u0aab\u0ab3\u0aa4\u0abe\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0ab2\u0acb\u0a95 \u0aa5\u0a88 \u0a9c\u0ab6\u0ac7.'"},{question:"\u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 UID \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7?",answer:"'UID \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 \u0aaa\u0abe\u0ab8\u0ac7 \u0aa8\u0ab5\u0ac0\u0aa8\u0aa4\u0aae 16 \u0a85\u0a82\u0a95\u0aa8\u0acb VID \u0ab9\u0acb\u0ab5\u0acb \u0a9c\u0acb\u0a88\u0a8f \u0a85\u0aa8\u0ac7 \u0a9c\u0acb \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 16 \u0a85\u0a82\u0a95\u0aa8\u0acb VID \u0aad\u0ac2\u0ab2\u0ac0 \u0a97\u0aaf\u0acb \u0ab9\u0acb\u0aaf \u0aa4\u0acb \u0aa4\u0ac7 SMS \u0ab8\u0ac7\u0ab5\u0abe\u0a93 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa8\u0ab5\u0ac0\u0aa8\u0aa4\u0aae VID \u0aae\u0ac7\u0ab3\u0ab5\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.\nRVID \u0ab8\u0acd\u0aaa\u0ac7\u0ab8 UID \u0aa8\u0abe 4 \u0a85\u0aa5\u0ab5\u0abe 8 \u0a85\u0a82\u0a95\u0aa8\u0ac0 \u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0ac0 \u0a9b\u0ac7. 1947 \u0aaa\u0ab0 SMS \u0a95\u0ab0\u0acb. \u0aad\u0ac2\u0aa4\u0aaa\u0ac2\u0ab0\u0acd\u0ab5 RVID 1234\nUID \u0a85\u0aa8\u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 UIDAI \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f https://resident.uidai.gov.in/aadhaar-lockunlock \u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0a88 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7, \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0ab0\u0ac7\u0aa1\u0abf\u0aaf\u0acb \u0aac\u0a9f\u0aa8 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7, \u0aa8\u0ab5\u0ac0\u0aa8\u0aa4\u0aae VID \u0a85\u0aa8\u0ac7 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0a95\u0acb\u0aa1 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0aae\u0acb\u0a95\u0ab2\u0acb OTP \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb. \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 UID \u0ab8\u0aab\u0ab3\u0aa4\u0abe\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0aa5\u0a88 \u0a9c\u0ab6\u0ac7.\n\u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 mAadhaar \u0a8f\u0aaa \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a86\u0aa7\u0abe\u0ab0 \u0ab2\u0acb\u0a95 \u0a85\u0aa5\u0ab5\u0abe \u0a85\u0aa8\u0ab2\u0acb\u0a95 \u0ab8\u0ac7\u0ab5\u0abe\u0aa8\u0acb \u0aaa\u0aa3 \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.'"}],grievanceAndFeedback:[],generateOrRetrieveVid:[{question:"\u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0ac0 VID \u0aad\u0ac2\u0ab2\u0ac0 \u0a97\u0aaf\u0acb. UID \u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0 \u0ab9\u0ac1\u0a82 \u0aa4\u0ac7\u0aa8\u0ac7 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0aae\u0ac7\u0ab3\u0ab5\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?",answer:"'UID \u0ab2\u0ac9\u0a95 \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0 \u0a9c\u0acb \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 VID \u0aad\u0ac2\u0ab2\u0ac0 \u0a97\u0aaf\u0acb \u0ab9\u0acb\u0aaf, \u0aa4\u0acb \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 16 \u0a85\u0a82\u0a95\u0aa8\u0acb VID \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 SMS \u0ab8\u0ac7\u0ab5\u0abe\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0\u0aa8\u0ac7 \u0aa4\u0ac7\u0aa8\u0abe/\u0aa4\u0ac7\u0aa3\u0ac0\u0aa8\u0abe \u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0ab0 \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aaa\u0ab0 VID \u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0aa5\u0ab6\u0ac7. \u0a86\u0aa7\u0abe\u0ab0 \u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0ab0 \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aaa\u0ab0\u0aa5\u0ac0 1947 \u0aaa\u0ab0 SMS \u0aae\u0acb\u0a95\u0ab2\u0acb, RVID \u0ab8\u0acd\u0aaa\u0ac7\u0ab8 UID \u0aa8\u0abe 4 \u0a85\u0aa5\u0ab5\u0abe 8 \u0a85\u0a82\u0a95\u0aa8\u0ac0 \u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0ac0 \u0a9b\u0ac7."},{question:"\u0ab5\u0ab0\u0acd\u0a9a\u0acd\u0aaf\u0ac1\u0a85\u0ab2 \u0a86\u0a88\u0aa1\u0ac0 (VID) \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"VID \u0a8f \u0a95\u0abe\u0aae\u0a9a\u0ab2\u0abe\u0a89, \u0ab0\u0abf\u0ab5\u0acb\u0a95\u0ac7\u0aac\u0ab2 16-\u0a85\u0a82\u0a95\u0aa8\u0acb \u0ab0\u0ac7\u0aa8\u0acd\u0aa1\u0aae \u0aa8\u0a82\u0aac\u0ab0 \u0a9b\u0ac7 \u0a9c\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0ab8\u0abe\u0aa5\u0ac7 \u0aae\u0ac7\u0aaa \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aaa\u0aa3 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0a85\u0aa5\u0ab5\u0abe \u0a88-\u0a95\u0ac7\u0ab5\u0abe\u0aaf\u0ab8\u0ac0 \u0ab8\u0ac7\u0ab5\u0abe\u0a93 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0abe \u0aac\u0aa6\u0ab2\u0ac7 VID \u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7. \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a9c\u0ac7\u0aae VID \u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7. VID \u0aa5\u0ac0 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0acb \u0ab6\u0a95\u0acd\u0aaf \u0aa8\u0aa5\u0ac0."},{question:"\u0ab0\u0ab9\u0ac7\u0ab5\u0abe\u0ab8\u0ac0 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 VID \u0aae\u0ac7\u0ab3\u0ab5\u0ac7 \u0a9b\u0ac7?",answer:"'VID \u0aab\u0a95\u0acd\u0aa4 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9c \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7. \u0aa4\u0ac7\u0a93 \u0ab8\u0aae\u0aaf\u0abe\u0a82\u0aa4\u0ab0\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0abe VID\u0aa8\u0ac7 \u0aac\u0aa6\u0ab2\u0ac0 \u0aaa\u0aa3 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7 (\u0aa8\u0ab5\u0ac0 VID \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7) \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95\u0acb \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 VID \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7, \u0a9c\u0acb \u0aa4\u0ac7\u0a93 \u0aad\u0ac2\u0ab2\u0ac0 \u0a9c\u0abe\u0aaf \u0aa4\u0acb \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 VID \u0aaa\u0ac1\u0aa8\u0a83\u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0abe VID\u0aa8\u0ac7 \u0aa8\u0ab5\u0abe \u0aa8\u0a82\u0aac\u0ab0 \u0ab8\u0abe\u0aa5\u0ac7 \u0aac\u0aa6\u0ab2\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a86 \u0ab5\u0abf\u0a95\u0ab2\u0acd\u0aaa\u0acb UIDAI\u0aa8\u0ac0 \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f (www.myaadhaar.uidai.gov.in), eAadhaar \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1, mAadhaar \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a95\u0ab0\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0a85\u0ab0\u0a9c\u0ac0, \u0ab5\u0a97\u0ac7\u0ab0\u0ac7.\n\u0a86\u0aa7\u0abe\u0ab0 \u0ab9\u0ac7\u0ab2\u0acd\u0aaa\u0ab2\u0abe\u0a88\u0aa8 \u0aa8\u0a82\u0aac\u0ab0 1947 \u0aaa\u0ab0 SMS \u0aae\u0acb\u0a95\u0ab2\u0ac0\u0aa8\u0ac7 \u0aaa\u0aa3 VID \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7. \u0ab0\u0ab9\u0ac7\u0ab5\u0abe\u0ab8\u0ac0\u0a8f '\u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0abe GVIDLast 4 \u0a85\u0a82\u0a95' \u0a9f\u0abe\u0a88\u0aaa \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0ab0\u0acd\u0aa1 \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe 1947 \u0aaa\u0ab0 \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7."},{question:"\u0ab6\u0ac1\u0a82 \u0aac\u0ac0\u0a9c\u0ac1\u0a82 \u0a95\u0acb\u0a88 \u0aae\u0abe\u0ab0\u0abe \u0aae\u0abe\u0a9f\u0ac7 VID \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7?",answer:"AUA/KUA \u0a9c\u0ac7\u0ab5\u0ac0 \u0a85\u0aa8\u0acd\u0aaf \u0a95\u0acb\u0a88 \u0a8f\u0aa8\u0acd\u0a9f\u0abf\u0a9f\u0ac0 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0ab5\u0aa4\u0ac0 VID \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ab6\u0ac7 \u0aa8\u0ab9\u0ac0\u0a82. \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0aab\u0a95\u0acd\u0aa4 \u0aaa\u0acb\u0aa4\u0abe\u0aa8\u0ac0 \u0a9c\u0abe\u0aa4\u0ac7 \u0a9c VID \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0ab0\u0a9c\u0ac0\u0ab8\u0acd\u0a9f\u0ab0\u0acd\u0aa1 \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aaa\u0ab0 SMS \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe VID \u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0a95\u0ab0\u0ab6\u0ac7.\nAUA/KUA \u0a9c\u0ac7\u0ab5\u0ac0 \u0a85\u0aa8\u0acd\u0aaf \u0a95\u0acb\u0a88 \u0a8f\u0aa8\u0acd\u0a9f\u0abf\u0a9f\u0ac0 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0ab5\u0aa4\u0ac0 VID \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ab6\u0ac7 \u0aa8\u0ab9\u0ac0\u0a82. \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0aab\u0a95\u0acd\u0aa4 \u0aaa\u0acb\u0aa4\u0abe\u0aa8\u0ac0 \u0a9c\u0abe\u0aa4\u0ac7 \u0a9c VID \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0ab0\u0a9c\u0ac0\u0ab8\u0acd\u0a9f\u0ab0\u0acd\u0aa1 \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aaa\u0ab0 SMS \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe VID \u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0a95\u0ab0\u0ab6\u0ac7."},{question:"\u0a9c\u0acb \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 VID \u0aad\u0ac2\u0ab2\u0ac0 \u0a9c\u0abe\u0aaf \u0aa4\u0acb \u0ab6\u0ac1\u0a82? \u0ab6\u0ac1\u0a82 \u0aa4\u0ac7/\u0aa4\u0ac7\u0aa3\u0ac0 \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0aae\u0ac7\u0ab3\u0ab5\u0ac0 \u0ab6\u0a95\u0ab6\u0ac7?",answer:"'\u0ab9\u0abe, UIDAI \u0aa8\u0ab5\u0ac0 \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa8\u0ac7/\u0a85\u0aa5\u0ab5\u0abe \u0ab5\u0ab0\u0acd\u0aa4\u0aae\u0abe\u0aa8 VID \u0aaa\u0ac1\u0aa8\u0a83\u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0aac\u0ab9\u0ac1\u0ab5\u0abf\u0aa7 \u0ab0\u0ac0\u0aa4\u0acb \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7. \u0a86 \u0ab5\u0abf\u0a95\u0ab2\u0acd\u0aaa\u0acb UIDAI \u0aa8\u0ac0 \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f (www.myaadhaar.uidai.gov.in), eAadhaar, mAadhaar \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8, SMS \u0ab5\u0a97\u0ac7\u0ab0\u0ac7 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a95\u0ab0\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7.\nVID \u0aaa\u0ac1\u0aa8\u0a83\u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0a86\u0aa7\u0abe\u0ab0 \u0ab9\u0ac7\u0ab2\u0acd\u0aaa\u0ab2\u0abe\u0a88\u0aa8 \u0aa8\u0a82\u0aac\u0ab0 1947 \u0aaa\u0ab0 SMS \u0aae\u0acb\u0a95\u0ab2\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0ab0\u0ab9\u0ac7\u0ab5\u0abe\u0ab8\u0ac0\u0a8f '\u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0abe RVID \u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0abe 4 \u0a85\u0a82\u0a95\u0acb' \u0a9f\u0abe\u0a88\u0aaa \u0a95\u0ab0\u0ab5\u0abe \u0aaa\u0aa1\u0ab6\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac7 \u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0ab0\u0acd\u0aa1 \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe 1947 \u0aaa\u0ab0 \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0acb \u0aaa\u0aa1\u0ab6\u0ac7."},{question:"\u0ab6\u0ac1\u0a82 VID \u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 OTP \u0a85\u0aa5\u0ab5\u0abe \u0aac\u0abe\u0aaf\u0acb\u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0abf\u0a95\u0acd\u0ab8 \u0a85\u0aa5\u0ab5\u0abe \u0aa1\u0ac7\u0aae\u0acb\u0a97\u0acd\u0ab0\u0abe\u0aab\u0abf\u0a95\u0acd\u0ab8 \u0a93\u0aa5\u0ac7\u0aa8\u0acd\u0a9f\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7?",answer:"\u0ab9\u0abe. \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0abe \u0aac\u0aa6\u0ab2\u0ac7 VID \u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7."},{question:"VID \u0aa8\u0abe \u0a95\u0abf\u0ab8\u0acd\u0ab8\u0abe\u0aae\u0abe\u0a82, \u0ab6\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0ac7 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0a86\u0aaa\u0ab5\u0abe\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0a9b\u0ac7?",answer:"\u0ab9\u0abe, VID \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0aae\u0abe\u0a9f\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95\u0aa8\u0ac0 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0a9b\u0ac7. \u0a8f\u0a9c\u0aa8\u0acd\u0ab8\u0ac0\u0a8f \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0abe \u0ab9\u0ac7\u0aa4\u0ac1\u0aa8\u0ac0 \u0a9c\u0abe\u0aa3 \u0a95\u0ab0\u0ab5\u0ac0 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0ab2\u0ac7\u0ab5\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0a9b\u0ac7."},{question:"\u0ab6\u0ac1\u0a82 \u0a8f\u0a9c\u0aa8\u0acd\u0ab8\u0ac0 VID \u0ab8\u0acd\u0a9f\u0acb\u0ab0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7?",answer:"\u0aa8\u0abe. VID \u0a85\u0ab8\u0acd\u0aa5\u0abe\u0aaf\u0ac0 \u0ab9\u0acb\u0ab5\u0abe\u0aa5\u0ac0 \u0a85\u0aa8\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aac\u0aa6\u0ab2\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7, VID \u0ab8\u0a82\u0a97\u0acd\u0ab0\u0ab9\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0a95\u0acb\u0a88 \u0aae\u0ac2\u0ab2\u0acd\u0aaf \u0aa8\u0aa5\u0ac0. \u0a8f\u0a9c\u0aa8\u0acd\u0ab8\u0ac0\u0a93\u0a8f \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aa1\u0ac7\u0a9f\u0abe\u0aac\u0ac7\u0a9d \u0a85\u0aa5\u0ab5\u0abe \u0ab2\u0acb\u0a97\u0aae\u0abe\u0a82 VID \u0ab8\u0a82\u0a97\u0acd\u0ab0\u0ab9\u0abf\u0aa4 \u0aa8 \u0a95\u0ab0\u0ab5\u0acb \u0a9c\u0acb\u0a88\u0a8f."},{question:"\u0ab6\u0ac1\u0a82 VID \u0aa8\u0ac1\u0a82 \u0aaa\u0ac1\u0aa8\u0a83\u0a9c\u0aa8\u0ab0\u0ac7\u0ab6\u0aa8 \u0a8f \u0a9c VID \u0a85\u0aa5\u0ab5\u0abe \u0a85\u0ab2\u0a97 VID \u0aa4\u0ab0\u0aab \u0aa6\u0acb\u0ab0\u0ac0 \u0a9c\u0ab6\u0ac7?",answer:"'\u0ab2\u0a98\u0ac1\u0aa4\u0acd\u0aa4\u0aae \u0aae\u0abe\u0aa8\u0acd\u0aaf\u0aa4\u0abe \u0a85\u0ab5\u0aa7\u0abf \u0aaa\u0a9b\u0ac0 (\u0ab9\u0abe\u0ab2\u0aae\u0abe\u0a82 1 \u0a95\u0ac7\u0ab2\u0ac7\u0aa8\u0acd\u0aa1\u0ab0 \u0aa6\u0abf\u0ab5\u0ab8 \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0a85\u0aa5\u0ab5\u0abe \u0aae\u0aa7\u0acd\u0aaf\u0ab0\u0abe\u0aa4\u0acd\u0ab0\u0abf 12 \u0aaa\u0a9b\u0ac0 \u0ab8\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7), \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0aa8\u0ab5\u0ac0 VID\u0aa8\u0abe \u0aaa\u0ac1\u0aa8\u0ab0\u0acd\u0a9c\u0ac0\u0ab5\u0aa8\u0aa8\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0a86 \u0ab0\u0ac0\u0aa4\u0ac7, \u0aa8\u0ab5\u0ac0 VID \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7 \u0a85\u0aa8\u0ac7 \u0a85\u0a97\u0abe\u0a89\u0aa8\u0ac0 VID \u0aa8\u0abf\u0ab7\u0acd\u0a95\u0acd\u0ab0\u0abf\u0aaf \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7.\n\u0a95\u0abf\u0ab8\u0acd\u0ab8\u0abe\u0aae\u0abe\u0a82, \u0a9c\u0acb \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0 VID \u0aaa\u0ac1\u0aa8\u0a83\u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7, \u0aa4\u0acb \u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0acb \u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf VID \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95\u0aa8\u0ac7 SMS \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0aa8\u0abf\u0ab5\u0abe\u0ab8\u0ac0\u0a8f '\u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0abe RVID\u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0abe 4 \u0a85\u0a82\u0a95\u0acb' \u0a9f\u0abe\u0a88\u0aaa \u0a95\u0ab0\u0ab5\u0abe \u0aaa\u0aa1\u0ab6\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac7 \u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0ab0\u0acd\u0aa1 \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe 1947 \u0aaa\u0ab0 \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0acb \u0aaa\u0aa1\u0ab6\u0ac7."}],checkGrievanceFeedbackStatus:[{question:"VID \u0aa8\u0ac0 \u0ab8\u0aae\u0abe\u0aaa\u0acd\u0aa4\u0abf \u0a85\u0ab5\u0aa7\u0abf \u0ab6\u0ac1\u0a82 \u0a9b\u0ac7?",answer:"\u0a86 \u0ab8\u0aae\u0aaf\u0ac7 VID \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0acb\u0a88 \u0ab8\u0aae\u0abe\u0aaa\u0acd\u0aa4\u0abf \u0a85\u0ab5\u0aa7\u0abf \u0aa8\u0abf\u0ab0\u0acd\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0aa8\u0aa5\u0ac0. VID \u0a9c\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0ac1\u0aa7\u0ac0 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aa7\u0abe\u0ab0\u0a95 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa8\u0ab5\u0ac0 VID \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8 \u0a86\u0ab5\u0ac7 \u0aa4\u0acd\u0aaf\u0abe\u0a82 \u0ab8\u0ac1\u0aa7\u0ac0 \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7."}]}},qt={dashboard:{header:{title:"\u09ae\u09be\u0987\u0986\u09a7\u09be\u09b0",profile:{aadhaarTagLine:"\u0986\u09ae\u09be\u09b0 \u0986\u09a7\u09be\u09b0,\u0986\u09ae\u09be\u09b0 \u09aa\u09b0\u09bf\u099a\u09df",clickToFlip:"\u0986\u09a7\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1\u099f\u09bf \u09ab\u09cd\u09b2\u09bf\u09aa \u0995\u09b0\u09c1\u09a8",logOut:"\u09b2\u0997\u0986\u0989\u099f"}},services:{title:"\u09b8\u09c7\u09ac\u09be",description:"\u09a8\u09bf\u09ae\u09cd\u09a8\u09b2\u09bf\u0996\u09bf\u09a4 \u0986\u09a7\u09be\u09b0 \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u0997\u09c1\u09b2\u09bf\u09b0 \u09a4\u09cb\u09a1\u09bc\u09be \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0989\u09aa\u09b2\u09ac\u09cd\u09a7\u0964 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be-\u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09aa\u09c3\u09b7\u09cd\u09a0\u09be\u09af\u09bc \u09a8\u09c7\u09ad\u09bf\u0997\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u099f\u09cd\u09af\u09be\u09ac\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8",serviceCards:{downloadAadhaar:{title:"\u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0986\u09a7\u09be\u09b0",description:"\u09a1\u09bf\u099c\u09bf\u099f\u09be\u09b2\u09bf \u09b8\u09cd\u09ac\u09be\u0995\u09cd\u09b7\u09b0\u09bf\u09a4 \u098f\u09ac\u0982 \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09bf\u09a4 \u0986\u09a7\u09be\u09b0\u09c7\u09b0 \u09ac\u09c8\u09a6\u09cd\u09af\u09c1\u09a4\u09bf\u09a8 \u0985\u09a8\u09c1\u09b2\u09bf\u09aa\u09bf \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},orderPVC:{title:"\u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0986\u09a7\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1",description:"\u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09bf\u09a4, \u09ae\u09be\u09a8\u09bf\u09ac\u09cd\u09af\u09be\u0997\u09c7\u09b0 \u0986\u0995\u09be\u09b0\u09c7\u09b0 \u0986\u09a7\u09be\u09b0 \u09aa\u09bf\u09ad\u09bf\u09b8\u09bf \u0995\u09be\u09b0\u09cd\u09a1 \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},updateAadhaarOnline:{updateAadhaarOnline:"\u0986\u09a7\u09be\u09b0 \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09c1\u09a8",updateAadhaar:"\u0986\u09a7\u09be\u09b0 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09c1\u09a8",headerTitle:"\u0985\u09a8\u09b2\u09be\u0987\u09a8 \u0986\u09a7\u09be\u09b0 \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u09a7\u09b0\u09a8 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8",title:"\u09a0\u09bf\u0995\u09be\u09a8\u09be \u0986\u09aa\u09a1\u09c7\u099f",description:"\u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\u0964 \u0985\u09a8\u09cd\u09af \u0995\u09cb\u09a8 \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u099c\u09a8\u09cd\u09af, \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09a8\u09bf\u0995\u099f\u09b8\u09cd\u09a5 \u0986\u09a7\u09be\u09b0 \u09b8\u09c7\u09ac\u09be \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u09c7 \u09af\u09be\u09a8"},bankLinkingStatus:{title:"\u09ac\u09cd\u09af\u09be\u0982\u0995 \u09b2\u09bf\u0999\u09cd\u0995\u09bf\u0982\u09af\u09bc\u09c7\u09b0 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf",description:"\u0986\u09a7\u09be\u09b0 \u098f\u09ac\u0982 \u09ac\u09cd\u09af\u09be\u0982\u0995 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7\u09b0 \u09b2\u09bf\u0999\u09cd\u0995\u09bf\u0982\u09af\u09bc\u09c7\u09b0 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},generateVirtualID:{title:"\u09ad\u09be\u09b0\u09cd\u099a\u09c1\u09af\u09bc\u09be\u09b2 \u0986\u0987\u09a1\u09bf \u099c\u09c7\u09a8\u09be\u09b0\u09c7\u099f \u0995\u09b0\u09c1\u09a8",description:"\u09ad\u09be\u09b0\u09cd\u099a\u09c1\u09af\u09bc\u09be\u09b2 \u0986\u0987\u09a1\u09bf (\u09ad\u09bf\u0986\u0987\u09a1\u09bf) \u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0\u09c7\u09b0 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964 \u09e7\u09ec \u0985\u0999\u09cd\u0995\u09c7\u09b0 \u098f\u09b2\u09cb\u09ae\u09c7\u09b2\u09cb \u09ad\u09bf\u0986\u0987\u09a1\u09bf \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8 |"},offlineEkyc:{title:"\u0985\u09ab\u09b2\u09be\u0987\u09a8 \u0987-\u0995\u09c7\u0993\u09df\u09be\u0987\u09b8\u09bf",description:"\u0985\u09ab\u09b2\u09be\u0987\u09a8 \u09b8\u09a8\u09be\u0995\u09cd\u09a4\u0995\u09b0\u09a3 \u09af\u09be\u099a\u09be\u0987\u0995\u09b0\u09a3\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09a8\u09bf\u09b0\u09be\u09aa\u09a6 \u098f\u09ac\u0982 \u09ad\u09be\u0997\u09af\u09cb\u0997\u09cd\u09af eKYC \u09a8\u09a5\u09bf\u099f\u09bf \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},lockUnlockBiometrics:{title:"\u09b2\u0995 / \u0986\u09a8\u09b2\u0995 \u09ac\u09be\u09af\u09bc\u09cb\u09ae\u09c7\u099f\u09cd\u09b0\u09bf\u0995\u09cd\u09b8",description:"\u0985\u09b8\u09cd\u09a5\u09be\u09af\u09bc\u09c0\u09ad\u09be\u09ac\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09be\u09af\u09bc\u09cb\u09ae\u09c7\u099f\u09cd\u09b0\u09bf\u0995 \u09a4\u09a5\u09cd\u09af \u09b2\u0995 / \u0986\u09a8\u09b2\u0995 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8"},lockUnlockAadhaar:{title:"\u09b2\u0995 / \u0986\u09a8\u09b2\u0995 \u0986\u09a7\u09be\u09b0",description:"\u0985\u09b8\u09cd\u09a5\u09be\u09af\u09bc\u09c0\u09ad\u09be\u09ac\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0\u099f\u09bf\u0995\u09c7 \u09b2\u0995 / \u0986\u09a8\u09b2\u0995 \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\u0964 \u098f\u0987 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u099f\u09bf \u09b8\u09be\u09ac\u09a7\u09be\u09a8\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8"},paymentHistory:{title:"\u0985\u09b0\u09cd\u09a5 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8\u09c7\u09b0 \u0987\u09a4\u09bf\u09b9\u09be\u09b8 ",description:"\u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u098f\u09ac\u0982 \u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1 \u098f\u09b0 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf  \u09a6\u09c7\u0996\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8 |"},aadharUpdateHistory:{title:"\u0986\u09a7\u09be\u09b0 \u0986\u09aa\u09a1\u09c7\u099f \u0987\u09a4\u09bf\u09b9\u09be\u09b8",description:"\u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0 \u0986\u09aa\u09a1\u09c7\u099f \u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u0996\u09c1\u0981\u099c\u09c7 \u09aa\u09c7\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8."},bankSeedingStatus:{title:"\u09ac\u09cd\u09af\u09be\u0982\u0995 \u09ac\u09c0\u099c\u09c7\u09b0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be",description:"\u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995 \u09b8\u09bf\u09a1\u09bf\u0982 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09be\u09b8 \u099c\u09be\u09a8\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8."},authenticationHistory:{title:"\u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u0987\u09a4\u09bf\u09b9\u09be\u09b8",description:"\u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u09a6\u09c7\u0996\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8",heading:"\u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3\u09c7\u09b0 \u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u0986\u09a8\u09a4\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u09a4\u09be\u09b0\u09bf\u0996 \u09aa\u09b0\u09bf\u09b8\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8",modality:"\u09ae\u09cb\u09a1\u09be\u09b2\u09bf\u099f\u09bf \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8",fieldStartText:"\u09b6\u09c1\u09b0\u09c1\u09b0 \u09a4\u09be\u09b0\u09bf\u0996 \u09b2\u09bf\u0996\u09c1\u09a8",fieldEndText:"\u09b6\u09c7\u09b7 \u09a4\u09be\u09b0\u09bf\u0996 \u09b2\u09bf\u0996\u09c1\u09a8",button:"\u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u0986\u09a8\u09c1\u09a8",tableHeading:"\u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8\u09c7\u09b0 \u09ab\u09b2\u09c7 {{txnNumber}}\u099f\u09bf \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u09b9\u09af\u09bc\u09c7\u099b\u09c7",dateRange:"\u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09a7\u09be\u09b0\u0995 \u09af\u09c7\u0995\u09cb\u09a8 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0 \u09b8\u0982\u09b8\u09cd\u09a5\u09be (AUA) \u09ac\u09be \u09a4\u09be\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0997\u09a4 \u09ec \u09ae\u09be\u09b8\u09c7 \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09bf\u09a4 \u09eb\u09e6 \u099f\u09bf \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u09b0\u09c7\u0995\u09b0\u09cd\u09a1\u09c7\u09b0 \u09ac\u09bf\u09b6\u09a6 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09a6\u09c7\u0996\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964",filterName:"\u09ae\u09cb\u09a1\u09be\u09b2\u09bf\u099f\u09bf \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8",note:{l1:"\u09ac\u09bf\u0983\u09a6\u09cd\u09b0\u0983:",l2:"AUA \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u0986\u0987\u09a1\u09bf: ",l3:"\u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc \u0985\u09a8\u09a8\u09cd\u09af \u0986\u09a7\u09be\u09b0 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u0986\u0987\u09a1\u09bf\u0964",l4:"\u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0 \u09b8\u0982\u09b8\u09cd\u09a5\u09be\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be: ",l5:"\u0995\u09cb\u09a8\u09cb \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09b8\u0982\u0995\u09cd\u09b0\u09be\u09a8\u09cd\u09a4 \u0995\u09cb\u09a8\u09cb \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u09b0 \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09c7, \u09b8\u09c7\u0987 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af AUA-\u098f\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964",l6:"\u09ac\u09bf\u09b8\u09cd\u09a4\u09be\u09b0\u09bf\u09a4 \u09a6\u09c7\u0996\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\u0964",l7:"\u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be: ",l8:"\u09b8\u09be\u09ab\u09b2\u09cd\u09af / \u09ac\u09cd\u09af\u09b0\u09cd\u09a5\u09a4\u09be",l9:"UIDAI \u09a4\u09cd\u09b0\u09c1\u099f\u09bf \u0995\u09cb\u09a1: ",l10:"\u0986\u09a7\u09be\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u09a4\u09cd\u09b0\u09c1\u099f\u09bf \u0995\u09cb\u09a1\u0964 ",l11:"\u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8",l12:"\u09b8\u099a\u09b0\u09be\u099a\u09b0 \u099c\u09bf\u099c\u09cd\u099e\u09be\u09b8\u09cd\u09af ",l13:"\u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u0987\u09a4\u09bf\u09b9\u09be\u09b8\u0964 ",l14:"\u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8",l15:"\u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf: ",l16:"\u0986\u09a7\u09be\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3\u09c7\u09b0 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf",l17:"\u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u09aa\u09bf\u09a1\u09bf\u098f\u09ab \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1\u099f\u09bf \u09ee\u099f\u09bf \u0985\u0995\u09cd\u09b7\u09b0\u09c7\u09b0 \u09b9\u09ac\u09c7\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09be\u09ae\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u099a\u09be\u09b0\u099f\u09bf \u0985\u0995\u09cd\u09b7\u09b0\u09c7\u09b0 \u09b8\u0982\u09ae\u09bf\u09b6\u09cd\u09b0\u09a3 (\u0986\u09a7\u09be\u09b0\u09c7\u09b0 \u09ae\u09a4\u09cb) \u09ac\u09a1\u09bc \u0985\u0995\u09cd\u09b7\u09b0\u09c7 \u098f\u09ac\u0982 YYYY \u09ab\u09b0\u09cd\u09ae\u09cd\u09af\u09be\u099f\u09c7 \u099c\u09a8\u09cd\u09ae\u09c7\u09b0 \u09ac\u099b\u09b0\u0964"}},documentUpdate:{title:"\u09a8\u09a5\u09bf \u0986\u09aa\u09a1\u09c7\u099f",description:"\u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09b0\u09bf\u099a\u09df\u09c7\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a8 (\u09