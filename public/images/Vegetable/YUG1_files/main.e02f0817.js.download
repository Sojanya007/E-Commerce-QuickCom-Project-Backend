\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21 \u0a26\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b"},enrolmentAndUpdateStatus:{title:"\u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a28 \u0a05\u0a24\u0a47 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a4b",description:"\u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a28 \u0a1c\u0a3e\u0a02 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a26\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a26\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b"},bookAppointment:{title:"\u0a07\u0a71\u0a15 \u0a05\u0a2a\u0a4b\u0a07\u0a70\u0a1f\u0a2e\u0a48\u0a02\u0a1f \u0a2c\u0a41\u0a71\u0a15 \u0a15\u0a30\u0a4b",description:"\u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a28 \u0a1c\u0a3e\u0a02 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08 \u0a05\u0a2a\u0a4c\u0a07\u0a70\u0a1f\u0a2e\u0a48\u0a02\u0a1f \u0a2c\u0a41\u0a71\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b"},vidGenerator:{title:"\u0a35\u0a40\u0a06\u0a08\u0a21\u0a40 \u0a1c\u0a47\u0a28\u0a30\u0a47\u0a1f\u0a30",description:"\u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a3e\u0a32 \u0a1c\u0a41\u0a5c\u0a47 16 \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a3e \u0a35\u0a30\u0a1a\u0a41\u0a05\u0a32 \u0a06\u0a08\u0a21\u0a40 (\u0a35\u0a40\u0a06\u0a08\u0a21\u0a40) \u0a24\u0a3f\u0a06\u0a30 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b"},lec:{title:"\u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a28 \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a26\u0a3e \u0a2a\u0a24\u0a3e \u0a32\u0a17\u0a3e\u0a13",description:"\u0a06\u0a38 \u0a2a\u0a3e\u0a38 \u0a26\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a32\u0a71\u0a2d\u0a23 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b"},lockUnlockAadhaar:{title:"\u0a32\u0a4c\u0a15 / \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a06\u0a27\u0a3e\u0a30",description:"\u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a05\u0a38\u0a25\u0a3e\u0a08 \u0a24\u0a4c\u0a30 \u0a24\u0a47 \u0a32\u0a4c\u0a15 / \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a07\u0a38 \u0a38\u0a47\u0a35\u0a3e \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a38\u0a3e\u0a35\u0a27\u0a3e\u0a28\u0a40 \u0a28\u0a3e\u0a32 \u0a15\u0a30\u0a4b"},complaintStatus:{title:"\u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24/\u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a4b",description:"\u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24/\u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a26\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b"},fileComplaint:{title:"\u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a05\u0a24\u0a47 \u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15",description:"\u0a06\u0a2a\u0a23\u0a40 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a05\u0a24\u0a47 \u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b"}}}},documentUpdate:{intentPage:{title:"\u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a38\u0a47\u0a35\u0a3e \u0a26\u0a3e \u0a09\u0a26\u0a47\u0a38\u0a3c",p1:"\u0a2a\u0a3f\u0a06\u0a30\u0a47 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40,",p2:"\u0a24\u0a41\u0a39\u0a3e\u0a28\u0a42\u0a70 \u0a38\u0a32\u0a3e\u0a39 \u0a26\u0a3f\u0a71\u0a24\u0a40 \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48 \u0a15\u0a3f \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a47\u0a1f\u0a3e\u0a2c\u0a47\u0a38 \u0a35\u0a3f\u0a71\u0a1a \u0a28\u0a35\u0a40\u0a28\u0a24\u0a2e \u0a2a\u0a1b\u0a3e\u0a23 \u0a26\u0a47 \u0a38\u0a2c\u0a42\u0a24 (POI) \u0a05\u0a24\u0a47 \u0a2a\u0a24\u0a47 \u0a26\u0a47 \u0a38\u0a2c\u0a42\u0a24 (POA) \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a35\u0a3e \u0a15\u0a47 \u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a2e\u0a1c\u0a3c\u0a2c\u0a42\u0a24 \u200b\u200b\u0a15\u0a30\u0a4b\u0964 POI/POA \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a26\u0a71\u0a38\u0a47 \u0a17\u0a0f \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a28\u0a3e\u0a32 \u0a2e\u0a47\u0a32 \u0a16\u0a3e\u0a02\u0a26\u0a47 \u0a39\u0a4b\u0a23\u0a47 \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a47 \u0a39\u0a28\u0964 \u0a07\u0a39 \u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a47\u0a1f\u0a3e\u0a2c\u0a47\u0a38 \u0a35\u0a3f\u0a71\u0a1a \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a26\u0a40 \u0a28\u0a3f\u0a30\u0a70\u0a24\u0a30 \u0a38\u0a3c\u0a41\u0a71\u0a27\u0a24\u0a3e \u0a28\u0a42\u0a70 \u0a2f\u0a15\u0a40\u0a28\u0a40 \u0a2c\u0a23\u0a3e\u0a09\u0a23 \u0a35\u0a3f\u0a71\u0a1a \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a2e\u0a26\u0a26 \u0a15\u0a30\u0a47\u0a17\u0a3e\u0964",p3:"\u0a1c\u0a47\u0a15\u0a30 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a39\u0a40 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a23 \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a1c\u0a3e\u0a02 myAadhaar \u0a2a\u0a4b\u0a30\u0a1f\u0a32 \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30 \u0a1a\u0a41\u0a71\u0a15\u0a47 \u0a39\u0a4b, \u0a24\u0a3e\u0a02 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a07\u0a38\u0a26\u0a40 \u0a38\u0a35\u0a40\u0a15\u0a4d\u0a30\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a09\u0a21\u0a40\u0a15 \u0a15\u0a30\u0a4b \u0a1c\u0a3e\u0a02 \u0a39\u0a4b\u0a30\u0964 \u0a38\u0a2a\u0a41\u0a30\u0a26 \u0a15\u0a40\u0a24\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a05\u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a35\u0a3f\u0a71\u0a1a, \u0a24\u0a41\u0a39\u0a3e\u0a28\u0a42\u0a70 \u0a26\u0a41\u0a2c\u0a3e\u0a30\u0a3e \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28\u0a3e \u0a2a\u0a48 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964",p4:"\u0a1c\u0a47\u0a15\u0a30 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a2a\u0a24\u0a3e \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a47 \u0a39\u0a4b, \u0a24\u0a3e\u0a02 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a07\u0a71\u0a25\u0a47 ",p5:"\u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964",p6:"\u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a08 25/- \u0a30\u0a41\u0a2a\u0a0f \u0a26\u0a3e \u0a2e\u0a3e\u0a2e\u0a42\u0a32\u0a40 \u0a1a\u0a3e\u0a30\u0a1c \u0a05\u0a26\u0a3e \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a3e, \u0a1c\u0a4b \u0a15\u0a3f \u0a35\u0a3e\u0a2a\u0a38\u0a40\u0a2f\u0a4b\u0a17 \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a48\u0964",p7:"\u0a07\u0a39 \u0a38\u0a47\u0a35\u0a3e 14/06/2025 \u0a24\u0a71\u0a15 \u0a2e\u0a41\u0a2b\u0a24 \u0a39\u0a48"},howItWorks:{description:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a39\u0a47\u0a20\u0a3e\u0a02 \u0a26\u0a3f\u0a71\u0a24\u0a47 \u0a15\u0a26\u0a2e\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a27\u0a3f\u0a06\u0a28 \u0a28\u0a3e\u0a32 \u0a2a\u0a5c\u0a4d\u0a39\u0a4b\u0964 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a26\u0a40 \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a1c\u0a3e\u0a02 \u0a05\u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30 \u0a15\u0a30\u0a28 \u0a35\u0a3f\u0a71\u0a1a \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a26\u0a47\u0a30\u0a40 \u0a24\u0a4b\u0a02 \u0a2c\u0a1a\u0a23 \u0a32\u0a08 \u0a35\u0a71\u0a16-\u0a35\u0a71\u0a16 \u0a2a\u0a5c\u0a3e\u0a35\u0a3e\u0a02 '\u0a24\u0a47 \u0a38\u0a41\u0a1d\u0a3e\u0a0f \u0a17\u0a0f \u0a15\u0a3f\u0a30\u0a3f\u0a06\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a2a\u0a3e\u0a32\u0a23\u0a3e \u0a15\u0a30\u0a4b\u0964 \u0a1c\u0a47\u0a15\u0a30 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a2a\u0a24\u0a3e \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a47 \u0a39\u0a4b, \u0a24\u0a3e\u0a02 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a07\u0a71\u0a25\u0a47",stepDescription:{one:"\u0a06\u0a2a\u0a23\u0a47 \u0a2a\u0a1b\u0a3e\u0a23 \u0a26\u0a47 \u0a38\u0a2c\u0a42\u0a24 (PoI) \u0a05\u0a24\u0a47 \u0a2a\u0a24\u0a47 \u0a26\u0a47 \u0a38\u0a2c\u0a42\u0a24 (PoA) \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a05\u0a71\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964",two:"\u0a07\u0a38 \u0a2a\u0a5c\u0a3e\u0a05 \u0a35\u0a3f\u0a71\u0a1a, \u0a24\u0a41\u0a39\u0a3e\u0a28\u0a42\u0a70 \u0a35\u0a48\u0a27 POI/POA \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a05\u0a71\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a15\u0a3f\u0a39\u0a3e \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a3e \u0a1c\u0a3f\u0a38 \u0a35\u0a3f\u0a71\u0a1a \u0a2a\u0a5c\u0a3e\u0a05 1 \u0a35\u0a3f\u0a71\u0a1a \u0a2a\u0a41\u0a38\u0a3c\u0a1f\u0a40 \u0a15\u0a40\u0a24\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a26\u0a40 \u0a2a\u0a41\u0a38\u0a3c\u0a1f\u0a40 \u0a15\u0a40\u0a24\u0a40 \u0a17\u0a08 \u0a39\u0a48\u0964",three:"\u0a24\u0a41\u0a39\u0a3e\u0a28\u0a42\u0a70 \u0a07\u0a38 \u0a38\u0a47\u0a35\u0a3e \u0a32\u0a08 \u20b9 25 (\u0a38\u0a3f\u0a30\u0a2b\u0a3c \u0a2a\u0a71\u0a1a\u0a40 \u0a30\u0a41\u0a2a\u0a0f) \u0a26\u0a3e \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a30\u0a28\u0a3e \u0a2a\u0a35\u0a47\u0a17\u0a3e\u0964 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a15\u0a4d\u0a30\u0a48\u0a21\u0a3f\u0a1f/\u0a21\u0a48\u0a2c\u0a3f\u0a1f \u0a15\u0a3e\u0a30\u0a21 \u0a1c\u0a3e\u0a02 \u0a28\u0a48\u0a71\u0a1f \u0a2c\u0a48\u0a02\u0a15\u0a3f\u0a70\u0a17 \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964 \u0a07\u0a39 \u0a30\u0a15\u0a2e \u0a28\u0a3e-\u0a35\u0a3e\u0a2a\u0a38\u0a40\u0a2f\u0a4b\u0a17 \u0a39\u0a48\u0964"},note:"\u0a1c\u0a47\u0a15\u0a30 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a06\u0a2a\u0a23\u0a47 \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a2b\u0a3f\u0a15 \u0a35\u0a47\u0a30\u0a35\u0a47 (\u0a28\u0a3e\u0a2e, \u0a1c\u0a28\u0a2e \u0a2e\u0a3f\u0a24\u0a40, \u0a32\u0a3f\u0a70\u0a17 \u0a1c\u0a3e\u0a02 \u0a2a\u0a24\u0a3e) \u0a28\u0a42\u0a70 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a47 \u0a39\u0a4b, \u0a24\u0a3e\u0a02 \u0a28\u0a1c\u0a3c\u0a26\u0a40\u0a15\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a47\u0a02\u0a26\u0a30 '\u0a24\u0a47 \u0a1c\u0a3e\u0a13 \u0a05\u0a24\u0a47 \u0a38\u0a3f\u0a30\u0a2b\u0a3c \u0a2a\u0a24\u0a47 \u0a28\u0a42\u0a70 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 ",noteLink:"\u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964"},currentSection:{form:{title:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a06\u0a2a\u0a23\u0a47 \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a5e\u0a3f\u0a15 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a26\u0a40 \u0a2a\u0a41\u0a38\u0a3c\u0a1f\u0a40 \u0a15\u0a30\u0a4b",name:"\u0a28\u0a3e\u0a2e",gender:"\u0a32\u0a3f\u0a70\u0a17",dob:"\u0a1c\u0a28\u0a2e \u0a24\u0a3e\u0a30\u0a40\u0a16",address:"\u0a2a\u0a24\u0a3e",consent:"\u0a2e\u0a48\u0a02 \u0a2a\u0a41\u0a38\u0a3c\u0a1f\u0a40 \u0a15\u0a30\u0a26\u0a3e/\u0a15\u0a30\u0a26\u0a40 \u0a39\u0a3e\u0a02 \u0a15\u0a3f \u0a09\u0a2a\u0a30\u0a4b\u0a15\u0a24 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a38\u0a39\u0a40 \u0a39\u0a28\u0964"},note:"\u0a1c\u0a47\u0a15\u0a30 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a35\u0a3f\u0a71\u0a1a \u0a15\u0a4b\u0a08 \u0a2e\u0a47\u0a32 \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a28\u0a1c\u0a3c\u0a26\u0a40\u0a15\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a47\u0a02\u0a26\u0a30 '\u0a24\u0a47 \u0a06\u0a2a\u0a23\u0a47 \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a2b\u0a3f\u0a15 \u0a35\u0a47\u0a30\u0a35\u0a47 (\u0a28\u0a3e\u0a2e, \u0a2a\u0a24\u0a3e, \u0a1c\u0a28\u0a2e \u0a2e\u0a3f\u0a24\u0a40 \u0a1c\u0a3e\u0a02 \u0a32\u0a3f\u0a70\u0a17) \u0a28\u0a42\u0a70 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a4b \u0a05\u0a24\u0a47 \u0a38\u0a3f\u0a30\u0a2b\u0a3c \u0a2a\u0a24\u0a47 \u0a26\u0a47 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 ",noteLink:"\u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964"},uploadSection:{confirmationPopUp:{title:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a35\u0a3f\u0a71\u0a1a \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a5e\u0a3f\u0a15 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a26\u0a40 \u0a2a\u0a41\u0a38\u0a3c\u0a1f\u0a40 \u0a15\u0a30\u0a4b \u0a1c\u0a4b \u0a06\u0a27\u0a3e\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a5e\u0a3f\u0a15 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a28\u0a3e\u0a32 \u0a2c\u0a3f\u0a32\u0a15\u0a41\u0a32 \u0a2e\u0a47\u0a32 \u0a16\u0a3