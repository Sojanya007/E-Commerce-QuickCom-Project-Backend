0caf\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf."},orderPVCStatus:{title:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c86\u0ca6\u0cc7\u0cb6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",description:"\u0c88\u0c97\u0cbe\u0c97\u0cb2\u0cc7 \u0c86\u0ca6\u0cc7\u0cb6\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0caa\u0cbf\u0cb5\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0ca8 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},enrolmentAndUpdateStatus:{title:"\u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",description:"\u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},bookAppointment:{title:"\u0ca8\u0cc7\u0cae\u0c95\u0cbe\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cbe\u0caf\u0ccd\u0ca6\u0cbf\u0cb0\u0cbf\u0cb8\u0cbf",description:"\u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0ca8\u0cc7\u0cae\u0c95\u0cbe\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cbe\u0caf\u0ccd\u0ca6\u0cbf\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},vidGenerator:{title:"\u0cb5\u0cbf\u0c90\u0ca1\u0cbf \u0c9c\u0ca8\u0cb0\u0cc7\u0c9f\u0cb0\u0ccd",description:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0c97\u0cc6 \u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0ca6 16 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cb5\u0cb0\u0ccd\u0c9a\u0cc1\u0cb5\u0cb2\u0ccd \u0c90\u0ca1\u0cbf (\u0cb5\u0cbf\u0c90\u0ca1\u0cbf) \u0c89\u0ca4\u0ccd\u0caa\u0cbe\u0ca6\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},lec:{title:"\u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca4\u0ccd\u0ca4\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf",description:"\u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},lockUnlockAadhaar:{title:"\u0cb2\u0cbe\u0c95\u0ccd / \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0c86\u0ca7\u0cbe\u0cb0\u0ccd",description:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbe\u0ca4\u0ccd\u0c95\u0cbe\u0cb2\u0cbf\u0c95\u0cb5\u0cbe\u0c97\u0cbf \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 / \u0c85\u0ca8\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c88 \u0cb8\u0cc7\u0cb5\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0cac\u0cb3\u0cb8\u0cbf."},complaintStatus:{title:"\u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 / \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",description:"\u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 / \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},fileComplaint:{title:"\u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6",description:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cc1\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0cb0\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"}}}},documentUpdate:{intentPage:{title:"\u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cb8\u0cc7\u0cb5\u0cc6\u0caf \u0c89\u0ca6\u0ccd\u0ca6\u0cc7\u0cb6",p1:"\u0c86\u0ca4\u0ccd\u0cae\u0cc0\u0caf \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf,",p2:"\u0c87\u0ca4\u0ccd\u0ca4\u0cc0\u0c9a\u0cbf\u0ca8 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6 (\u0caa\u0cbf\u0c92\u0c90) \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6 (\u0caa\u0cbf\u0c92\u0c8e) \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe\u0cac\u0cc7\u0cb8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb2\u0caa\u0ca1\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0cb8\u0cb2\u0cb9\u0cc6 \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. POI/POA \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cac\u0cc7\u0c95\u0cc1. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe\u0cac\u0cc7\u0cb8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf \u0ca8\u0cbf\u0cb0\u0c82\u0ca4\u0cb0 \u0ca8\u0cbf\u0c96\u0cb0\u0ca4\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0c87\u0ca6\u0cc1 \u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",p3:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c88\u0c97\u0cbe\u0c97\u0cb2\u0cc7 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c97\u0cb3 \u0cae\u0cc2\u0cb2\u0c95 \u0c85\u0ca5\u0cb5\u0cbe myAadhaar \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c85\u0ca6\u0cb0 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cbe\u0cb0\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0c87\u0cb2\u0ccd\u0cb2\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6. \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbf\u0cb0\u0cb8\u0ccd\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb8\u0c82\u0ca6\u0cb0\u0ccd\u0cad\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf, \u0ca8\u0cc0\u0cb5\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cbe\u0c97\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",p4:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cac\u0caf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1",p5:"\u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",p6:"\u0ca8\u0cbe\u0cae\u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0cb0\u0cc2. 25/- \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1, \u0c87\u0ca6\u0cc1 \u0cae\u0cb0\u0cc1\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.",p7:"\u0c88 \u0cb8\u0cc7\u0cb5\u0cc6\u0caf\u0cc1 14/06/2025 \u0cb0\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0c89\u0c9a\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6."},howItWorks:{description:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 \u0cb9\u0c82\u0ca4\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0c93\u0ca6\u0cbf. \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0ca3\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb5\u0cbf\u0cb3\u0c82\u0cac\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0caa\u0ccd\u0caa\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb5\u0cbf\u0cb5\u0cbf\u0ca7 \u0cb9\u0c82\u0ca4\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cc2\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0c95\u0ccd\u0cb0\u0cae\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0cc1\u0cb8\u0cb0\u0cbf\u0cb8\u0cbf. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cac\u0caf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1",stepDescription:{one:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6 (PoI) \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6 (PoA) \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",two:"\u0c88 \u0cb9\u0c82\u0ca4\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf, \u0cb9\u0c82\u0ca4 1 \u0cb0\u0cb2\u0ccd\u0cb2\u0cbf \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0cb3\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0cb0\u0cc1\u0cb5 \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0ca6 POI/POA \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cc7\u0cb3\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",three:"\u0c88 \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cc6 \u0ca8\u0cc0\u0cb5\u0cc1 \u20b9 25 (\u0c87\u0caa\u0ccd\u0caa\u0ca4\u0ccd\u0ca4\u0cc8\u0ca6\u0cc1 \u0cb0\u0cc2\u0caa\u0cbe\u0caf\u0cbf\u0c97\u0cb3\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0) \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1. \u0ca8\u0cc0\u0cb5\u0cc1 \u0c95\u0ccd\u0cb0\u0cc6\u0ca1\u0cbf\u0c9f\u0ccd/\u0ca1\u0cc6\u0cac\u0cbf\u0c9f\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cc6\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c88 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc1\u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2."},note:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 (\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, DoB, \u0cb2\u0cbf\u0c82\u0c97 \u0c85\u0ca5\u0cb5\u0cbe \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8) \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cac\u0caf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 ",noteLink:"\u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf."},currentSection:{form:{title:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",name:"\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1",gender:"\u0cb2\u0cbf\u0c82\u0c97",dob:"\u0cb9\u0cc1\u0c9f\u0ccd\u0ca4\u0cbf\u0ca6 \u0ca6\u0cbf\u0ca8",address:"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8",consent:"\u0cae\u0cc7\u0cb2\u0cbf\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0cb5\u0cc6\u0caf\u0cc7 \u0c8e\u0c82\u0ca6\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6."},note:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cbe\u0ca3\u0cbf\u0c95\u0cc6\u0caf\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 (\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8, DoB \u0c85\u0ca5\u0cb5\u0cbe \u0cb2\u0cbf\u0c82\u0c97) ",noteLink:"\u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf."},uploadSection:{confirmationPopUp:{title:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cc1\u0cb5 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cbe \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c96\u0c9a\u0cbf\u0ca4\u0caa\u0ca1\u0cbf\u0cb8\u0cbf"},stepper:{verify:"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",upload:"\u0c85\u0caa\u0ccd\u0cb2\u0ccb\u0ca1\u0ccd"},guidelines:{title:"\u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0cb8\u0cc2\u0c9a\u0cbf\u0c97\u0cb3\u0cc1",l1:"\u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0c97\u0cbe\u0ca4\u0ccd\u0cb0\u0cb5\u0cc1 2 MB \u0c97\u0cbf\u0c82\u0ca4 \u0c95\u0ca1\u0cbf\u0cae\u0cc6\u0caf\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1",l2:"\u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cbf\u0ca4 \u0cab\u0cc8\u0cb2\u0ccd \u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd\u0caf\u0cbe\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1: <b>JPEG, PNG</b> \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 <b>PDF</b>"},form:{poiTitle:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6 (POI) \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",poaTitle:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6 (POA) \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"},consent:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cbf\u0ca6/\u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf/\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cb5\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb9\u0c82\u0ca4\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0c97\u0cc6 \u0c92\u0cb3\u0caa\u0ca1\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0c8e\u0c82\u0ca6\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c88 \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0ca8\u0ccd\u0ca8 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c97\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6."},faq:{card:{heading:"\u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3",description_1:"",description_2:""},guidelines:{heading_1:"\u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cc6\u0c82\u0cac\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",heading_2:"14/06/2025 \u0cb0\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0c89\u0c9a\u0cbf\u0ca4",question_1:{title:"\u0c8f\u0ca8\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1?",content:{line_1:"\u0caa\u0ca1\u0cbf\u0ca4\u0cb0 \u0c9a\u0cc0\u0c9f\u0cbf, \u0cae\u0ca4\u0ca6\u0cbe\u0cb0\u0cb0 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cc0\u0c9f\u0cbf, \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cb5\u0cc1 \u0ca8\u0cc0\u0ca1\u0cbf\u0ca6 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cc0\u0c9f\u0cbf/\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5 \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ca4\u0ccd\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cad\u0cbe\u0cb0\u0ca4\u0cc0\u0caf \u0caa\u0cbe\u0cb8\u0ccd\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0c8e\u0cb0\u0ca1\u0c95\u0ccd\u0c95\u0cc2 \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0cb5\u0cc6. ",line_2:"\u0caa\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd, \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cbf\u0c82\u0c97\u0ccd \u0cb2\u0cc8\u0cb8\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd, \u0cb8\u0cc6\u0c95\u0cc6\u0c82\u0ca1\u0cb0\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0cc0\u0ca8\u0cbf\u0caf\u0cb0\u0ccd \u0cb8\u0ccd\u0c95\u0cc2\u0cb2\u0ccd \u0cae\u0cbe\u0cb0\u0ccd\u0c95\u0ccd \u0cb6\u0cc0\u0c9f\u0ccd/\u0c9b\u0cbe\u0caf\u0cbe\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb8\u0ccd\u0c95\u0cc2\u0cb2\u0ccd \u0cb2\u0cc0\u0cb5\u0cbf\u0c82\u0c97\u0ccd \u0cb8\u0cb0\u0ccd\u0c9f\u0cbf\u0cab\u0cbf\u0c95\u0cc7\u0c9f\u0ccd, \u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0 \u0ca8\u0cc0\u0ca1\u0cbf\u0ca6 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cc0\u0c9f\u0cbf/\u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ca4\u0ccd\u0cb0-\u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6\u0caf\u0cbe\u0c97\u0cbf \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6. ",line_3:"\u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cc1\u0ca4\u0ccd/\u0ca8\u0cc0\u0cb0\u0cc1/\u0c97\u0ccd\u0caf\u0cbe\u0cb8\u0ccd \u0cac\u0cbf\u0cb2\u0ccd (\u0c95\u0cb3\u0cc6\u0ca6 3 \u0ca4\u0cbf\u0c82\u0c97\u0cb3), \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd/\u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0c86\u0cab\u0cc0\u0cb8\u0ccd \u0caa\u0cbe\u0cb8\u0ccd\u0cac\u0cc1\u0c95\u0ccd, \u0cac\u0cbe\u0ca1\u0cbf\u0c97\u0cc6/\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0c97\u0cc6/\u0cb0\u0c9c\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0c92\u0caa\u0ccd\u0caa\u0c82\u0ca6\u0cb5\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6\u0caf\u0cbe\u0c97\u0cbf \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. ",line_4:"\u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3 \u0cb5\u0cbf\u0cb5\u0cb0\u0cb5\u0cbe\u0ca6 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0c97\u0cbe\u0c97\u0cbf, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 ",line_5:" \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"}},question_2:{title:"\u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6?",content:{line_1:"\u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf myAadhaar \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c95\u0ccd\u0c95\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5 \u0cae\u0cc2\u0cb2\u0c95 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",line_2:"\u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb9\u0c82\u0ca4 \u0cb9\u0c82\u0ca4\u0ca6 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 ",line_3:"\u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf"}},main_content:{submit:"\u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",title:"\u0cb8\u0cb9\u0cbe\u0caf \u0cac\u0cc7\u0c95\u0cc7?",videoText:"\u0cb5\u0cc0\u0ca1\u0cbf\u0caf\u0cca \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0ca6\u0cb0\u0ccd\u0cb6\u0cbf",knowMoreText:"\u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1 \u0ca4\u0cbf\u0cb3\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6\u0caf\u0cc7?",callText:"\u0c9f\u0ccb\u0cb2\u0ccd-\u0cab\u0ccd\u0cb0\u0cc0 \u0c95\u0cb0\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf (1947)"}},one:{title:"\u0ca8\u0ca8\u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbe\u0ca8\u0cc1 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0cae\u0ca4\u0ccd\u0cc1\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0c8f\u0c95\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cc6\u0cc7\u0c95\u0cc1?",content:"\u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cb5\u0cbf\u0cc7\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0caa\u0cc7\u0cb7\u0c95 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0ccd\u0cc1 \u0cae\u0ca4\u0ccd\u0cc1\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1 \u0c9c\u0cc7\u0cb5\u0ca8\u0cb5\u0ca8\u0cc1\u0ca8 \u0cb8\u0cc1\u0cb2\u0cad\u0c97\u0cc6\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0cc1\u0cb5\u0cc6, \u0c89\u0ca4\u0ccd\u0cc1\u0cae \u0cb8\u0cc6\u0cc7\u0cb5\u0cbe \u0cb5\u0cbf\u0ca4\u0ccd\u0cb0\u0ca3\u0cc6 \u0cae\u0ca4\u0ccd\u0cc1\u0cc1 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0ca6 \u0ca6\u0cc3\u0ca2\u0cc7\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0cc1\u0ca8 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0cc1\u0cb5\u0cc6. \u0c86\u0ca6\u0ca6\u0cb0\u0cbf\u0cbf\u0c82\u0ca6, \u0c87\u0ca4\u0cbf\u0cc1\u0cc7\u0c9a\u0cbf\u0ca8 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0cae\u0ca4\u0ccd\u0cc1\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0 \u0cb8\u0cbf\u0c82\u0c96\u0ccd\u0cc6\u0cc6 \u0cb9\u0cc6\u0cca\u0cbf\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cb5\u0cb0 \u0cb9\u0cbf\u0ca4\u0cbe\u0cb8\u0c95\u0ccd\u0ca4\u0cc1\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6."},two:{title:"\u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0ccd\u0cc1 \u0cae\u0ca4\u0ccd\u0cc1\u0cc1\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0c95\u0cbe\u0cbe\u0c97\u0cbf \u0ca8\u0cbe\u0ca8\u0cc1 \u0caf\u0cbe\u0cb5 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cc6\u0cc7\u0c95\u0cc1?",content:{para_1:{heading_one:"\u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0ccd\u0cc1 \u0cae\u0ca4\u0ccd\u0cc1\u0cc1\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0c8e\u0cb0\u0ca1\u0c95\u0cca\u0cbe \u0ca1\u0cbe\u0c95\u0cc1\u0cc6\u0cae\u0cbf\u0c82\u0c9f\u0ccd\u0c83",list_1:"(a) \u0cb0\u0cc6\u0cc7\u0cb7\u0ca8\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd",list_2:"(b) \u0cae\u0ca4\u0ccd\u0ca6\u0cbe\u0cb0\u0cb0 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cbf\u0cc7\u0c9f",list_3:"(c) \u0c95\u0ccd\u0ca4\u0cb8\u0cbe\u0ca8\u0ccd \u0cab\u0cc7\u0c9f\u0cc6\u0cca\u0cc7 \u0caa\u0cbe\u0cb8\u0ccd \u0cac\u0cc1\u0c95",list_4:"(d) \u0cad\u0cbe\u0cb0\u0ca4\u0cbf\u0cc7\u0caf \u0caa\u0cbe\u0cb8\u0cc6\u0cca\u0caa\u0cc7\u0c9f\u0ccd",list_5:"(e) \u0cb8\u0c95\u0cbe\u0ccd\u0cb0 \u0ca8\u0cbf\u0cc7\u0ca1\u0cbf\u0ca6 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cbf\u0cc7\u0c9f\u0cbf/\u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ccd\u0ca4\u0ccd\u0cb0, \u0c8e\u0cb8\u0cbf\u0cbf/\u0c8e\u0cb8\u0cbf\u0cbf/\u0c92\u0cac\u0cbf\u0cb8\u0cbf \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ccd\u0ca4\u0ccd\u0cb0 \u0c85\u0ca5\u0cb5\u0cbe \u0cad\u0cbe\u0cb5\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0 \u0cb9\u0cc6\u0cca\u0cbf\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5 \u0cae\u0ca6\u0cc1\u0cb5\u0cc6 \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ccd\u0ca4\u0ccd\u0cb0",list_6:"(f) \u0c85\u0cbf\u0c82\u0c97\u0cb5\u0cc6\u0cc8\u0c95\u0cb2\u0cc6 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cbf\u0cc7\u0c9f\u0cbf/\u0c85\u0cbf\u0c82\u0c97\u0cb5\u0cc6\u0cc8\u0c95\u0cb2\u0cc6 \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ccd\u0ca4\u0ccd\u0cb0",list_7:"(g)  \u0ca4\u0ccd\u0cc3\u0ca4\u0cbf\u0cc7\u0caf \u0cb2\u0ccd\u0cb2\u0cbf\u0c82\u0c97 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cbf\u0cc7\u0c9f\u0cbf/\u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ccd\u0ca4\u0ccd\u0cb0",list_8:"(h) \u0cb2\u0cc6\u0cc8\u0cbf\u0c82\u0c97\u0cbf\u0c95 \u0c95\u0cbe\u0caf\u0ccd\u0c95\u0ca4\u0cc6\u0ccd\u0c97\u0cc6 \u0cb8\u0cbf\u0c82\u0cac\u0cbf\u0c82\u0ca7\u0cbf\u0cb8\u0cbf\u0ca6\u0cbf\u0c82\u0ca4\u0cc6 \u0caf\u0cc1\u0c90\u0ca1\u0cbf\u0c8e\u0c90 \u0ca8\u0cbf\u0c97\u0ca7\u0cbf\u0caa\u0ccd\u0ca1\u0cbf\u0cb8\u0cbf\u0ca6 \u0cae\u0cbe\u0ca1\u0cbf\u0cb0\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbf\u0cc7\u0ca1\u0cb2\u0cbe\u0ca6 \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ccd\u0ca4\u0ccd\u0cb0",list_9:"(i) \u0cae\u0cbe\u0ca8\u0cc6\u0ca4\u0cc6 \u0caa\u0ccd\u0ca1\u0cc6\u0ca6 \u0c86\u0cb6\u0ccd\u0cb0\u0caf \u0cae\u0ca8\u0cc6\u0c97\u0cb3\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0c85\u0ca8\u0cbe\u0ca5\u0cbe\u0cb6\u0ccd\u0cb0\u0cae\u0c97\u0cb3\u0cbf\u0cbf\u0c82\u0ca6 \u0caf\u0cc1\u0c90\u0ca1\u0cbf\u0c8e\u0c90 \u0ca8\u0cbf\u0c97\u0ca7\u0cbf\u0caa\u0ccd\u0ca1\u0cbf\u0cb8\u0cbf\u0ca6 \u0cae\u0cbe\u0ca1\u0cbf\u0cb0\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8\u0cbf\u0cc7\u0ca1\u0cb2\u0cbe\u0ca6 \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ccd\u0ca4",list_10:"(j)  \u0c9c\u0cc6\u0cc8\u0cb2\u0cc1 \u0c85\u0ca7\u0cbf\u0c95\u0cbe\u0cb0\u0cbf \u0ca8\u0cbf\u0cc7\u0ca1\u0cbf\u0ca6 \u0c95\u0cc6\u0cc8\u0ca6\u0cbf\u0c97\u0cb3 \u0caa\u0ccd\u0cb0\u0cb5\u0cc6\u0cc7\u0cb6\u0ccd \u0ca6\u0cbe\u0c96\u0cb2\u0cc6"},para_2:{heading_one:"\u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0ccd\u0c83",list_1:"(a) \u0cad\u0cbe\u0cb5\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb6\u0cbe\u0cb2\u0cbe \u0cac\u0cbf\u0c9f\u0ccd\u0cc1\u0cbf \u0cb9\u0cc6\u0cca\u0cc7\u0c97\u0cc1\u0cb5 \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ccd\u0ca4\u0ccd\u0cb0/\u0cb6\u0cbe\u0cb2\u0cbe \u0cb5\u0c97\u0cbe\u0ccd\u0cb5\u0ca3\u0cc6 \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ccd\u0ca4\u0ccd\u0cb0",list_2:"(b) \u0cad\u0cbe\u0cb5\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0cae\u0cbe\u0ca8\u0cc6\u0ca4\u0cc6 \u0caa\u0ccd\u0ca1\u0cc6\u0ca6 \u0cb6\u0cbf\u0c95\u0ccd\u0cb7\u0ca3 \u0cae\u0cbf\u0c82\u0ca1\u0cb3\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cb5\u0cbf\u0ca6\u0cbe\u0cc6\u0cb2\u0caf \u0ca8\u0cbf\u0cc7\u0ca1\u0cbf\u0ca6 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cbf\u0cc7\u0c9f\u0cbf/\u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ccd\u0ca4\u0ccd\u0cb0",list_3:"(c) \u0caa\u0cbe\u0cc6\u0ca8\u0ccd/\u0c87-\u0caa\u0cbe\u0cc6\u0ca8\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd",list_4:"(d) \u0cb8\u0c95\u0cbe\u0ccd\u0cb0/\u0cb6\u0cbe\u0cb8\u0ca8\u0cac\u0ca6\u0ca7\u0cb8\u0cbf\u0c82\u0cb8\u0cc6\u0cc6/\u0caa\u0cbf\u0c8e\u0cb8\u0cc1\u0cc6 \u0ca8\u0cbf\u0cc7\u0ca1\u0cbf\u0ca6 \u0c89\u0ca6\u0cc6\u0cca\u0cc6\u0cc7\u0c97\u0cbf/\u0caa\u0cbf\u0cbf\u0c82\u0c9a\u0ca3\u0cbf\u0ca6\u0cbe\u0cb0\u0cb0 \u0cad\u0cbe\u0cb5\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cbf\u0cc7\u0c9f\u0cbf, \u0caa\u0cbf\u0cbf\u0c82\u0c9a\u0ca3\u0cbf \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0c86\u0ca6\u0cc6\u0cc7\u0cb6\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0ca7\u0ccd\u0cc6\u0cb8\u0cbf\u0cc6\u0c95\u0cc6 \u0cb9\u0c95\u0cc1\u0cbe \u0caa\u0ccd\u0ca4\u0ccd\u0cb0",list_5:"(e) \u0c9a\u0cbe\u0cb2\u0ca8\u0cbe \u0caa\u0ccd\u0cb0\u0cb5\u0cbe\u0ca8\u0c97",list_6:"(f) \u0cb8\u0cbe\u0cb5\u0ca4\u0ccd\u0cbf\u0c82\u0ca4\u0ccd\u0cb0\u0caf \u0cb9\u0cc6\u0cca\u0cc7\u0cb0\u0cbe\u0c9f\u0ccd\u0c97\u0cbe\u0cb0\u0cb0 \u0cad\u0cbe\u0cb5\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cbf\u0cc7\u0c9f\u0cbf"},para_3:{heading_one:"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0ccd:",list_1:"(a) \u0cb5\u0cbf\u0ca6\u0cc1\u0cc6\u0ca4\u0ccd, \u0ca8\u0cbf\u0cc7\u0cb0\u0cc1, \u0c85\u0ca8\u0cbf\u0cb2 \u0c85\u0ca5\u0cb5\u0cbe \u0ca6\u0cca\u0cb0\u0cb5\u0cbe\u0ca3\u0cbf/\u0cae\u0cca\u0cac\u0cc6\u0cc8\u0cb2\u0ccd/\u0cac\u0cbe\u0cb0\u0ca1\u0cbe\u0ccd\u0caf\u0cbf\u0c82\u0cb0\u0ccd\u0ca1 \u0cac\u0cbf\u0cb2\u0ccd (\u0cae\u0cca\u0cb0\u0cc1 \u0ca4\u0cbf\u0cbf\u0c82\u0c97\u0cb3\u0cc1\u0c97\u0cb3\u0cbf\u0c97\u0cbf\u0cbf\u0c82\u0ca4\u0ccd \u0cb9\u0cb3\u0cc6\u0caf\u0ca6\u0cb2\u0cbf)",list_2:"(b) \u0c85\u0ca8\u0cc1\u0cb8\u0cca\u0c9a\u0cbf\u0ca4\u0ccd \u0cb5\u0cbe\u0ca3\u0cbf\u0c9c\u0cc6 \u0cac\u0cbe\u0cc6\u0cbf\u0c82\u0c95\u0ccd/\u0c85\u0cbf\u0c82\u0c9a\u0cc6 \u0c95\u0c9a\u0cc6\u0cc7\u0cb0\u0cbf\u0caf \u0cb8\u0cb9\u0cbf \u0cae\u0ca4\u0ccd\u0cc1\u0cc1 \u0cb8\u0cbe\u0cbf\u0caf\u0cbf\u0c82\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cad\u0cbe\u0cb5\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0caa\u0ccd\u0cb8\u0cc1\u0cac\u0cca\u0c95",list_3:"(c) \u0c85\u0ca8\u0cc1\u0cb8\u0cca\u0c9a\u0cbf\u0ca4\u0ccd \u0cb5\u0cbe\u0ca3\u0cbf\u0c9c\u0cc6 \u0cac\u0cbe\u0cc6\u0cbf\u0c82\u0c95\u0ccd/\u0c85\u0cbf\u0c82\u0c9a\u0cc6 \u0c95\u0c9a\u0cc6\u0cc7\u0cb0\u0cbf \u0cb8\u0cb9\u0cbf \u0cae\u0cbe\u0ca1\u0cbf \u0cb8\u0cbe\u0cbf\u0caf\u0cbf\u0c82\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0c96\u0ccd\u0cbe\u0ca4\u0cc6/\u0c95\u0cc6\u0cb0\u0ca1\u0cbf\u0c9f \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0cb8\u0cc6\u0cbf\u0cc7\u0c9f\u0cc6\u0cae\u0cbf\u0c82\u0c9f (\u0cae\u0cca\u0cb0\u0cc1 \u0ca4\u0cbf\u0cbf\u0c82\u0c97\u0cb3\u0cc1\u0c97\u0cb3\u0cbf\u0c97\u0cbf\u0cbf\u0c82\u0ca4\u0ccd \u0cb9\u0cb3\u0cc6\u0caf\u0ca6\u0cb2\u0cbf)",list_4:"(d) \u0cae\u0cbe\u0ca8\u0cc6\u0cb5\u0cbe\u0ca6 \u0cac\u0cbe\u0ca1\u0cbf\u0c97\u0cc6, \u0c97\u0cc1\u0ca4\u0cbf\u0cc1\u0c97\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0cb2\u0ccd\u0cb2\u0cc7\u0cb5\u0ccd \u0cae\u0ca4\u0ccd\u0cc1\u0cc1\u0caa\u0ccd\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c82\u0ca6",list_5:"(e) \u0cb8\u0cbf\u0c82\u0cb8\u0ca6, \u0cb6\u0cbe\u0cb8\u0c95, \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8 \u0caa\u0ccd\u0cb0\u0cbf\u0cb7\u0ca4\u0ccd \u0cb8\u0ca6\u0cb8\u0cc6, \u0cae\u0cc1\u0ca8\u0cbf\u0cb8\u0cbf\u0caa\u0ccd\u0cb2\u0ccd \u0c95\u0ccc\u0ca8\u0cbf\u0cbf\u0cb2\u0cb0\u0ccd, \u0c97\u0cca\u0cb0\u0caa\u0ccd '\u0c8e' \u0c85\u0ca5\u0cb5\u0cbe '\u0cac\u0cbf' \u0c97\u0cc6\u0c9c\u0cc6\u0c9f\u0cc6\u0cb0\u0ccd\u0ca1 \u0c85\u0ca7\u0cbf\u0c95\u0cbe\u0cb0\u0cbf, \u0c87. \u0caa\u0cbf. \u0c8e\u0cab\u0ccd. \u0c93. \u0c85\u0ca7\u0cbf\u0c95\u0cbe\u0cb0\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0ca4\u0ccd\u0cb9\u0cb8\u0cbf\u0cc7\u0cb2\u0cbe\u0ca6\u0cb0",list_6:"(f) UIDAI \u0cb8\u0cbe\u0cbf\u0caf\u0cbf\u0c82\u0ca1\u0cb0\u0ccd\u0ca1\u0ccd \u0cb8\u0c9f\u0cbf\u0ccd\u0cab\u0cbf\u0c95\u0cc6\u0cc7\u0c9f \u0cb0\u0cca\u0caa\u0ccd\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c97\u0cbe\u0cb0\u0cae \u0caa\u0ccd\u0cbf\u0c82\u0c9a\u0cbe\u0caf\u0cbf\u0ca4\u0cbf \u0cae\u0cc1\u0c96\u0cc6\u0cb8\u0cc6\u0cb0\u0cc1/\u0c95\u0cbe\u0caf\u0ccd\u0ca6\u0cb6\u0cbf\u0ccd, \u0c97\u0cbe\u0cb0\u0cae \u0c95\u0cbf\u0c82\u0ca6\u0cbe\u0caf \u0c85\u0ca7\u0cbf\u0c95\u0cbe\u0cb0\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0ca4\u0ccd\u0ca4\u0ccd\u0cbf\u0cae\u0cbe\u0ca8 (\u0c97\u0cbe\u0cb0\u0cae\u0cbf\u0cc7\u0ca3 \u0caa\u0ccd\u0cb0\u0ca6\u0cc6\u0cc7\u0cb6\u0ccd\u0c97\u0cb3\u0cbf\u0c97\u0cc6) \u0ca8\u0cbf\u0cc7\u0ca1\u0cbf\u0ca6 \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ccd\u0ca4\u0ccd\u0cb0",list_7:"(g) UIDAI \u0cb8\u0cbe\u0cbf\u0caf\u0cbf\u0c82\u0ca1\u0cb0\u0ccd\u0ca1\u0ccd \u0cb8\u0c9f\u0cbf\u0ccd\u0cab\u0cbf\u0c95\u0cc6\u0cc7\u0c9f \u0cb0\u0cca\u0caa\u0ccd\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0cb5\u0cbf\u0ca6\u0cbe\u0cc6\u0cb0\u0ccd\u0ca5\u0ccd\u0c97\u0cc6 \u0cae\u0cbe\u0ca8\u0cc6\u0ca4\u0cc6 \u0caa\u0ccd\u0ca1\u0cc6\u0ca6 \u0cb6\u0cbf\u0c95\u0ccd\u0cb7\u0ca3 \u0cb8\u0cbf\u0c82\u0cb8\u0cc6\u0cc6\u0caf \u0cae\u0cc1\u0c96\u0cc6\u0cb8\u0cc6\u0cb0\u0cc1 \u0ca8\u0cbf\u0cc7\u0ca1\u0cbf\u0ca6 \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ccd\u0ca4",list_8:"(h) \u0c86\u0cb8\u0cbf\u0cc1\u0ca4\u0cc6\u0cb0\u0cbf\u0c97\u0cc6 \u0cb0\u0cb6\u0cbf\u0cc7\u0ca6\u0cbf (\u0c92\u0cbf\u0c82\u0ca6\u0cc1 \u0cb5\u0cb7\u0ccd\u0c95\u0ccd\u0ca4\u0cbe\u0cbf\u0c82\u0ca4\u0ccd \u0cb9\u0cb3\u0cc6\u0caf\u0ca6\u0cb2\u0cbf)",list_9:"(i) \u0cae\u0cbe\u0ca8\u0cc6 \u0ca8\u0cc6\u0cca\u0cc7\u0cbf\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4\u0ccd \u0cae\u0cbe\u0cb0\u0cbe\u0c9f\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c82\u0ca6 \u0c85\u0ca5\u0cb5\u0cbe \u0c89\u0ca1\u0cc1\u0c97\u0cc6\u0cca\u0cb0\u0cc6 \u0caa\u0ccd\u0ca4",list_10:"(j) \u0cb8\u0c95\u0cbe\u0ccd\u0cb0/\u0cb6\u0cbe\u0cb8\u0ca8\u0cac\u0ca6\u0ca7-\u0cb8\u0cbf\u0c82\u0cb8\u0cc6\u0cc6/\u0caa\u0cbf\u0c8e\u0cb8\u0cc1\u0cc6-\u0ca8\u0cbf\u0cc7\u0ca1\u0cbf\u0ca6 \u0cb5\u0cb8\u0ca4\u0cbf \u0cb9\u0cbf\u0c82\u0c9a\u0cbf\u0c95\u0cc6 \u0caa\u0ccd\u0ca4\u0ccd\u0cb0 (\u0c92\u0cbf\u0c82\u0ca6\u0cc1 \u0cb5\u0cb7\u0ccd\u0c95\u0ccd\u0ca4\u0cbe\u0cbf\u0c82\u0ca4\u0ccd \u0cb9\u0cb3\u0cc6\u0caf\u0ca6\u0cb2\u0cbf)",list_11:"(k) \u0c9c\u0cc7\u0cb5 \u0c85\u0ca5\u0cb5\u0cbe \u0cb5\u0cc6\u0cc8\u0ca6\u0cc6\u0c95\u0ccd\u0ca4\u0cc7\u0caf \u0cb5\u0cbf\u0cae\u0cbe \u0caa\u0cbe\u0cb2\u0ccd\u0cb2\u0cb8\u0cbf (\u0c92\u0cbf\u0c82\u0ca6\u0cc1 \u0cb5\u0cb7\u0ccd\u0c95\u0ccd\u0ca4\u0cbe\u0cbf\u0c82\u0ca4\u0ccd \u0cb9\u0cb3\u0cc6\u0caf\u0ca6\u0cb2\u0cbf)"}}},three:{title:"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0ca8\u0cbe\u0ca8\u0cc1 \u0cb9\u0cc6\u0cc7\u0c97\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",content:"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0ca8\u0ca8\u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca8 \u0c86\u0ca8\u0cc6\u0cbf\u0cc8\u0ca8\u0ccd \u0caa\u0cc7\u0c9f\u0ccd\u0ccd\u0cb2\u0ccd https://myaadhaar.uidai.gov.in/ \u0c85\u0ca5\u0cb5\u0cbe \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc6\u0cc7 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cc6\u0cc7\u0cbf\u0c82\u0ca6\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1."},four:{title:"\u0c86\u0ca8\u0cc6\u0cbf\u0cc8\u0ca8\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0cb9\u0cc6\u0cc7\u0c97\u0cc6?",content:{list_1:"(1) https://myaadhaar.uidai.gov.in/ \u0c97\u0cc6 \u0cb9\u0cc6\u0cca\u0cc7\u0c97\u0cbf, \u0ca8\u0cbf\u0cae\u0cae \u0ca8\u0cbf\u0cae\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cbf\u0c82\u0c96\u0ccd\u0cc6\u0cc6 \u0cae\u0ca4\u0ccd\u0cc1\u0cc1 \u0ca8\u0cc6\u0cca\u0cc7\u0cbf\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4\u0ccd \u0cae\u0cca\u0cac\u0cc6\u0cc8\u0cb2\u0ccd \u0cb8\u0cbf\u0c82\u0c96\u0ccd\u0cc6\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf\u0cb5\u0cc7\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0c92\u0ca8\u0ccd-\u0c9f\u0cc6\u0cc8\u0cae\u0ccd \u0caa\u0cbe\u0cb8\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd (\u0c92\u0c9f\u0cbf\u0caa\u0cbf) \u0cac\u0cb3\u0cb8\u0cbf \u0cb2\u0cbe\u0c97\u0ccd \u0c87\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",list_2:"(2) \u0ca8\u0cbf\u0cae\u0cae \u0caa\u0cb0\u0cab\u0cc6\u0cc8\u0cb2\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0ca4\u0cc6\u0cca\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca8\u0cbf\u0cae\u0cae \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0ccd\u0cc1 \u0cae\u0ca4\u0ccd\u0cc1\u0cc1\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0caa\u0ccd\u0cb0\u0cbf\u0cb6\u0cbf\u0cc7\u0cb2\u0ccd\u0cb2\u0cb8",list_3:"(3) \u0ca8\u0cbf\u0cae\u0cae \u0caa\u0cb0\u0cab\u0cc6\u0cc8\u0cb2\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca4\u0cc6\u0cca\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0ca4\u0ccd\u0caa\u0cbe\u0caa\u0c97\u0cbf\u0ca6\u0ca6\u0cb0\u0cc6, \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 5\u0ca8\u0cc6\u0cc7 \u0caa\u0ccd\u0cb0\u0cb6\u0cc6\u0ca8\u0c97\u0cc6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0ca4\u0cb0\u0caf\u0ccd\u0ca6\u0caf\u0cbe\u0c97\u0cbf \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0cbf\u0c82\u0ca4\u0cc6 \u0c95\u0cb0\u0cae \u0c95\u0cc6\u0cc8\u0c97\u0cc6\u0cca\u0cb3\u0cbf\u0cbf.",list_4:"(4) \u0ca8\u0cbf\u0cae\u0cae \u0caa\u0cb0\u0cab\u0cc6\u0cc8\u0cb2\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0caa\u0ccd\u0cb0\u0ca6\u0cb6\u0cbf\u0ccd\u0cb8\u0cb2\u0cbe\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0ca6\u0cb0\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0cc1\u0cbf '\u0cae\u0cc7\u0cb2\u0ccd\u0cb2\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0cb5\u0cc6 \u0c8e\u0cbf\u0c82\u0ca6\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0cbf\u0cb6\u0cbf\u0cc7\u0cb2\u0ccd\u0cb2\u0cb8\u0cc1\u0ca4\u0cc6\u0cc1\u0cc7\u0ca8\u0cc6' \u0c8e\u0cbf\u0c82\u0cac \u0c9f\u0cbe\u0cc6\u0cac\u0ccd \u0c85\u0ca8\u0cc1\u0ca8 \u0c95\u0ccd\u0ca4\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. ",list_5:"(5) \u0ca8\u0cbf\u0cc7\u0cb5\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0cb5 \u0ca1\u0cbe\u0cb0\u0caa\u0ccd-\u0ca1\u0ccc\u0ca8\u0ccd \u0cae\u0ca8\u0cc1\u0cb5\u0cbf\u0ca8\u0cbf\u0cbf\u0c82\u0ca6 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0ca8\u0cc1\u0ca8 \u0c86\u0caf\u0ccd\u0ca6\u0cbe \u0cae\u0cbe\u0ca1.",list_6:"(6) \u0ca8\u0cbf\u0cae\u0cae \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0ca8\u0cc1\u0ca8 \u0c85\u0caa\u0cbf\u0cc7\u0cb0\u0ccd\u0ca1 \u0cae\u0cbe\u0ca1\u0cbf (\u0c97\u0cbe\u0ca4\u0ccd\u0cb0 2 \u0c8e\u0cbf\u0c82\u0cac\u0cbf\u0c97\u0cbf\u0cbf\u0c82\u0ca4\u0ccd \u0c95\u0ca1\u0cbf\u0cae; \u0cab\u0cc6\u0cc8\u0cb2\u0ccd \u0cab\u0cbe\u0cae\u0cbe\u0cc6\u0ccd\u0c9f \u0c9c\u0cc6\u0caa\u0cbf\u0c87\u0c9c, \u0caa\u0cbf \u0c8f\u0ca8\u0ccd \u0c9c \u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0cbf\u0ca1\u0cbf\u0c8e\u0cab\u0ccd)",list_7:"(7) \u0ca8\u0cbf\u0cc7\u0cb5\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0cb5 \u0ca1\u0cbe\u0cb0\u0caa\u0ccd-\u0ca1\u0ccc\u0ca8\u0ccd \u0cae\u0ca8\u0cc1\u0cb5\u0cbf\u0ca8\u0cbf\u0cbf\u0c82\u0ca6 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0ca8\u0cc1\u0ca8 \u0c86\u0caf\u0ccd\u0ca6\u0cbe \u0cae\u0cbe\u0ca1\u0cbf.",list_8:"(8) \u0ca8\u0cbf\u0cae\u0cae \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0ca8\u0cc1\u0ca8 \u0c85\u0caa\u0cbf\u0cc7\u0cb0\u0ccd\u0ca1 \u0cae\u0cbe\u0ca1\u0cbf (\u0c97\u0cbe\u0ca4\u0ccd\u0cb0 2 \u0c8e\u0cbf\u0c82. \u0cac\u0cbf. \u0c97\u0cbf\u0cbf\u0c82\u0ca4\u0ccd \u0c95\u0ca1\u0cbf\u0cae; \u0cab\u0cc6\u0cc8\u0cb2\u0ccd \u0cab\u0cbe\u0cae\u0cbe\u0cc6\u0ccd\u0c9f \u0c9c\u0cc6\u0caa\u0cbf\u0c87\u0c9c, \u0caa\u0cbf \u0c8f\u0ca8\u0ccd \u0c9c \u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0cbf\u0ca1\u0cbf\u0c8e\u0cab\u0ccd).",list_9:"(9) \u0ca8\u0cbf\u0cae\u0cae \u0c92\u0caa\u0cbf\u0caa\u0c97\u0cc6\u0caf\u0ca8\u0cc1\u0ca8 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf."}},five:{title:"\u0ca8\u0ca8\u0ca8 \u0caa\u0cb0\u0cab\u0cc6\u0cc8\u0cb2\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0ca4\u0cc6\u0cca\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0cc1 \u0ca8\u0ca8\u0ca8 \u0caa\u0ccd\u0cb0\u0cb8\u0cc1\u0cc1\u0ca4\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0c95\u0cc6\u0cbe \u0cb9\u0cc6\u0cca\u0cbf\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0ca6\u0cbf\u0ca6\u0ca6\u0cb0\u0cc6, \u0ca8\u0cbe\u0ca8\u0cc1 \u0c8f\u0ca8\u0cc1 \u0cae\u0cbe\u0ca1\u0cac\u0cc6\u0cc7\u0c95\u0cc1?",content:{list_1:"(1) '\u0cae\u0cc7\u0cb2\u0ccd\u0cb2\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0cb5\u0cc6 \u0c8e\u0cbf\u0c82\u0ca6\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0cbf\u0cb6\u0cbf\u0cc7\u0cb2\u0ccd\u0cb2\u0cb8\u0cc1\u0ca4\u0cc6\u0cc1\u0cc7\u0ca8\u0cc6' \u0c8e\u0ca8\u0cc1\u0ca8\u0cb5 \u0c9f\u0cbe\u0cac\u0cbf\u0ca8 \u0c95\u0cc6\u0cb3\u0c97\u0cc6 \u0c87\u0cb0\u0cc1\u0cb5 '\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0cb9\u0cc6\u0cca\u0cbf\u0c82\u0ca6\u0cbe\u0ca3\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0ca6\u0cbf\u0ca6\u0ca6\u0cb0\u0cc6, \u0c87\u0cb2\u0ccd\u0cb2\u0cbf\u0c95\u0ccd\u0ca4\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf' \u0c8e\u0cbf\u0c82\u0cac \u0cb2\u0ccd\u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0c85\u0ca8\u0cc1\u0ca8 \u0c95\u0ccd\u0ca4\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",list_2:"(2) \u0caa\u0ccd\u0cb0\u0ca6\u0cb6\u0cbf\u0ccd\u0cb8\u0cb2\u0cbe\u0ca6 \u0c85\u0c9c\u0ccd\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0cad\u0ca4\u0cbf\u0ccd \u0cae\u0cbe\u0ca1.",list_3:"(3) \u0ca8\u0cbf\u0cc7\u0cb5\u0cc1 \u0c85\u0caa\u0cbf\u0cc7\u0cb0\u0ccd\u0ca1 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0cb5 \u0ca1\u0cbe\u0cb0\u0caa\u0ccd-\u0ca1\u0ccc\u0ca8\u0ccd \u0cae\u0ca8\u0cc1\u0cb5\u0cbf\u0ca8\u0cbf\u0cbf\u0c82\u0ca6 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0ca8\u0cc1\u0ca8 \u0c86\u0caf\u0ccd\u0ca6\u0cbe \u0cae\u0cbe\u0ca1\u0cbf.",list_4:"(4) \u0ca8\u0cbf\u0cae\u0cae \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0ca8\u0cc1\u0ca8 \u0c85\u0caa\u0cbf\u0cc7\u0cb0\u0ccd\u0ca1 \u0cae\u0cbe\u0ca1\u0cbf (\u0c97\u0cbe\u0ca4\u0ccd\u0cb0 2 \u0c8e\u0cbf\u0c82. \u0cac\u0cbf. \u0c97\u0cbf\u0cbf\u0c82\u0ca4\u0ccd \u0c95\u0ca1\u0cbf\u0cae; \u0cab\u0cc6\u0cc8\u0cb2\u0ccd \u0cab\u0cbe\u0cae\u0cbe\u0cc6\u0ccd\u0c9f \u0c9c\u0cc6\u0caa\u0cbf\u0c87\u0c9c, \u0caa\u0cbf \u0c8f\u0ca8\u0ccd \u0c9c \u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0cbf\u0ca1\u0cbf\u0c8e\u0cab\u0ccd).",list_5:"(5) \u0c85\u0c97\u0ca4\u0ccd\u0cc6 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0cae\u0cbe\u0ca1\u0cbf.",list_6:"(6) \u0ca8\u0cbf\u0cae\u0cae \u0cb5\u0cbf\u0ca8\u0cbf\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0cc1\u0ca8 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8."}},six:{title:"\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc6\u0cc7 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 (\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0cb2\u0ccd\u0cb2\u0cbf\u0c82\u0c97 \u0c85\u0ca5\u0cb5\u0cbe \u0cb9\u0cc1\u0c9f\u0cbf\u0cbf\u0ca6 \u0ca6\u0cbf\u0ca8\u0cbe\u0cbf\u0c82\u0c95) \u0ca8\u0ca8\u0ca8 \u0ca8\u0cbf\u0c9c\u0cb5\u0cbe\u0ca6 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb9\u0cc6\u0cca\u0cbf\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0ca6\u0cbf\u0ca6\u0ca6\u0cb0\u0cc6, \u0ca8\u0cbe\u0ca8\u0cc1 \u0c8f\u0ca8\u0cc1 \u0cae\u0cbe\u0ca1\u0cac\u0cc6\u0cc7\u0c95\u0cc1?",content:"https://uidai.gov.in/images/commdoc/List_of_Supporting_Document_for_Aadhaar_Enrolment_and_Update.pdf \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0caa\u0ccd\u0c9f\u0cbf\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0cb5\u0cbf\u0c82\u0ca4\u0cc6 \u0cae\u0cca\u0cb2 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc6 \u0cbf\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cc6\u0cc7\u0cbf\u0c82\u0ca6\u0cb0\u0c95\u0cc6\u0cbe \u0cad\u0cc6\u0cc7\u0c9f\u0cbf \u0ca8\u0cbf\u0cc7\u0ca1\u0cbf."},seven:{title:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0c86\u0cab\u0cc6\u0cbf\u0cc8\u0ca8\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6, \u0ca8\u0cbe\u0ca8\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cc6\u0cc7\u0cbf\u0c82\u0ca6\u0cb0\u0cb5\u0ca8\u0cc1\u0ca8 \u0cb9\u0cc6\u0cc7\u0c97\u0cc6 \u0caa\u0ccd\u0ca4\u0cc6\u0cc1\u0cb9\u0c9a\u0c9a\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",content:{list_1:"(1) \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0cc1\u0cbf https://bhuvan.nrsc.gov.in/aadhaar/ \u0c97\u0cc6 \u0cb9\u0cc6\u0cca\u0cc7\u0c97",list_2:"(2) \u0cb9\u0ca4\u0cbf\u0cc1\u0cb0\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cc6\u0cc7\u0cbf\u0c82\u0ca6\u0cb0\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0cb8\u0cb2\u0cc1, '\u0cb9\u0ca4\u0cbf\u0cc1\u0cb0\u0ca6 \u0c95\u0cc6\u0cc7\u0cbf\u0c82\u0ca6\u0cb0\u0c97\u0cb3\u0cc1' \u0c9f\u0cbe\u0cc6\u0cac\u0ccd \u0c85\u0ca8\u0cc1\u0ca8 \u0c95\u0ccd\u0ca4\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0cb9\u0ca4\u0cbf\u0cc1\u0cb0\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cc6\u0cc7\u0cbf\u0c82\u0ca6\u0cb0\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0ca8\u0cc6\u0cca\u0cc7\u0ca1\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0cae \u0cb8\u0cc6\u0cb3\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0ca8\u0cae\u0cca\u0ca6\u0cbf\u0cb8\u0cbf.",list_3:"(3) \u0ca8\u0cbf\u0cae\u0cae \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0cc6\u0cca\u0cc7\u0cb0\u0ccd\u0ca1 \u0caa\u0ccd\u0cb0\u0ca6\u0cc6\u0cc7\u0cb6\u0ccd\u0ca6\u0cc6\u0cca\u0cb3\u0c97\u0cc6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cc6\u0cc7\u0cbf\u0c82\u0ca6\u0cb0\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0caa\u0ccd\u0ca4\u0cc6\u0cc1\u0cb9\u0c9a\u0c9a\u0cb2\u0cc1, '\u0cb8\u0c9a\u0ccd\u0ccd \u0cac\u0cc6\u0cc8 \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0cc6\u0cca\u0cc7\u0cb0\u0ccd\u0ca1' \u0c9f\u0cbe\u0cc6\u0cac\u0ccd \u0c85\u0ca8\u0cc1\u0ca8 \u0c95\u0ccd\u0ca4\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0c86 \u0caa\u0ccd\u0cb0\u0ca6\u0cc6\u0cc7\u0cb6\u0ccd\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca8\u0cbf\u0cae\u0cae \u0caa\u0ccd\u0cb0\u0ca6\u0cc6\u0cc7\u0cb6\u0ccd\u0ca6 \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0cc6\u0cca\u0cc7\u0cb0\u0ccd\u0ca1 \u0c85\u0ca8\u0cc1\u0ca8 \u0ca8\u0cae\u0cca\u0ca6\u0cbf\u0cb8\u0cbf, \u0c86 \u0caa\u0ccd\u0cb0\u0ca6\u0cc6\u0cc7\u0cb6\u0ccd\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cc6\u0cc7\u0cbf\u0c82\u0ca6\u0cb0\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0ca8\u0cc6\u0cca\u0cc7\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1."}},eight:{title:"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c8e\u0cb7\u0cc1\u0cbf \u0cb6\u0ccd\u0cc1\u0cb2\u0cbe \u0cb5\u0cbf\u0ca7\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0cc1\u0ca6\u0cc6?",content:"2023\u0cb0 \u0cb8\u0cc6\u0caa\u0cc6\u0cbf\u0cbf\u0c82\u0cac\u0cb0\u0ccd 14\u0cb0\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0ca8\u0ca8\u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0cc7\u0c9f\u0ccd\u0ccd\u0cb2\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0c89\u0c9a\u0cbf\u0ca4\u0ccd\u0cb5\u0cbe\u0c97\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cc6\u0cc7\u0cbf\u0c82\u0ca6\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1, \u0c85\u0ca8\u0cb5\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0cb5 \u0cb6\u0ccd\u0cc1\u0cb2\u0cbe\u0cb5\u0cc1 \u0cb0\u0cca. 50."},nine:{title:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0caf\u0cbe\u0cb5 \u0ca6\u0cbf\u0ca8\u0cbe\u0cbf\u0c82\u0c95\u0ca6\u0cc6\u0cca\u0cb3\u0c97\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cc6\u0cc7\u0c95\u0cc1?",content:"\u0c9c\u0cc7\u0cb5\u0ca8\u0cb5\u0ca8\u0cc1\u0ca8 \u0cb8\u0cc1\u0cb2\u0cad\u0c97\u0cc6\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1, \u0c89\u0ca4\u0ccd\u0cc1\u0cae \u0cb8\u0cc6\u0cc7\u0cb5\u0cbe \u0cb5\u0cbf\u0ca4\u0ccd\u0cb0\u0ca3\u0cc6 \u0cae\u0ca4\u0ccd\u0cc1\u0cc1 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0ca6 \u0ca6\u0cc3\u0ca2\u0cc7\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0cc1\u0ca8 \u0cb8\u0c95\u0ccd\u0ca4\u0cb0\u0caf\u0c97\u0cc6\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0ca8\u0cb5\u0cbf\u0cc7\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c85\u0caa\u0cc6\u0cc7\u0c95\u0ccd\u0cb7\u0ca3\u0cbf\u0cc7\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c86\u0ca6\u0ca6\u0cb0\u0cbf\u0cbf\u0c82\u0ca6, \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0c86\u0ca6\u0cb7\u0cc1\u0cbf \u0cac\u0cc6\u0cc7\u0c97 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0ca8\u0cbf\u0cae\u0cae \u0cb9\u0cbf\u0ca4\u0cbe\u0cb8\u0c95\u0ccd\u0ca4\u0cc1\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0cc1\u0ca6\u0cc6."},ten:{title:"\u0ca8\u0cbe\u0ca8\u0cc1 \u0c85\u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf \u0cad\u0cbe\u0cb0\u0ca4\u0cbf\u0cc7\u0caf (\u0c8e\u0ca8\u0ccd. \u0c86\u0cb0\u0ccd. \u0c90). \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0ca8\u0cbe\u0ca8\u0cc1 \u0cb9\u0cc6\u0cc7\u0c97\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",content:"\u0ca8\u0cbf\u0cc7\u0cb5\u0cc1 \u0cad\u0cbe\u0cb0\u0ca4\u0ccd\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cbe\u0ca6\u0c97\u0cb2\u0cc6\u0cb2\u0cbe\u0cbf\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0cc1\u0ca8 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1."}}},aadharUpdateHistory:{title1:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",label1:"\u0cb0\u0cc6\u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",label2:"\u0ca6\u0cbe\u0c96\u0cb2\u0cbe\u0ca4\u0cbf/\u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95",label3:"URN/EID",label4:"\u0cae\u0cbe\u0ca6\u0cb0\u0cbf",list1:"\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1",list2:"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd",list3:"\u0c87\u0cae\u0cc7\u0cb2\u0ccd",list4:"\u0cb9\u0cc1\u0c9f\u0ccd\u0ca4\u0cbf\u0ca6 \u0ca6\u0cbf\u0ca8",list5:"\u0cb2\u0cbf\u0c82\u0c97",list6:"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8"},ssup:{howItWorks:{title:"\u0c87\u0ca6\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6",description:"\u0c86\u0ca8\u0ccd\u0cb2\u0cc8\u0ca8\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0cb0\u0ccd\u0ca5\u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0c88 \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 \u0cb9\u0c82\u0ca4\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c93\u0ca6\u0cbf. \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5\u0cb2\u0ccd\u0cb2\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0ca4\u0cbf\u0cb0\u0cb8\u0ccd\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5\u0cb2\u0ccd\u0cb2\u0cbf \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb5\u0cbf\u0cb3\u0c82\u0cac\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0caa\u0ccd\u0caa\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb5\u0cbf\u0cb5\u0cbf\u0ca7 \u0cb9\u0c82\u0ca4\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cc2\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0c95\u0ccd\u0cb0\u0cae\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0cc1\u0cb8\u0cb0\u0cbf\u0cb8\u0cbf",proceedToUpdateAadhaar:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbf\u0cb0\u0cbf",stepDescription:{one:"\u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0c95\u0ccd\u0cb7\u0cc7\u0ca4\u0ccd\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf. \u0c88 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd \u0cae\u0cc2\u0cb2\u0c95, \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0cb2\u0cbf\u0c82\u0c97, DOB, \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6, \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd\u0cb8\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe\u0c97\u0cbe\u0c97\u0cbf, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0c95\u0ccd\u0c95\u0cc6 \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf.",two:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca1\u0cc6\u0cae\u0cca\u0c97\u0ccd\u0cb0\u0cbe\u0cab\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf. \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0ca1\u0cc6\u0cae\u0cca\u0c97\u0ccd\u0cb0\u0cbe\u0cab\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd \u0ca1\u0ccc\u0ca8\u0ccd \u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6. \u0ca1\u0cc6\u0cae\u0cca\u0c97\u0ccd\u0cb0\u0cbe\u0cab\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cc1\u0cb5\u0cbe\u0c97 \u0c85\u0ca5\u0cb5\u0cbe \u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd \u0ca1\u0ccc\u0ca8\u0ccd \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cbe\u0c97 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c9c\u0cbe\u0c97\u0cb0\u0cc2\u0c95\u0cb0\u0cbe\u0c97\u0cbf\u0cb0\u0cbf.",three:"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cc2\u0cb2 \u0caa\u0ccb\u0cb7\u0c95 \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd\u200c\u0ca8 \u0cb8\u0ccd\u0c95\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c95\u0cb2\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0caa\u0ccb\u0cb7\u0c95 \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cc6\u0cb8\u0cb0\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6 \u0c8e\u0c82\u0ca6\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf. \u0ca8\u0cc0\u0cb5\u0cc1 UIDAI \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0cbf\u0ca4 \u0cb8\u0ccd\u0cb5\u0cb0\u0cc2\u0caa\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ca4\u0ccd\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbf\u0cb0\u0cb8\u0ccd\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0caa\u0ccd\u0caa\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb8\u0c82\u0c9a\u0cbf\u0c95\u0cc6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95, \u0c85\u0ca1\u0ccd\u0ca1 \u0c9a\u0cbf\u0cb9\u0ccd\u0ca8\u0cc6, \u0cab\u0ccb\u0c9f\u0ccb\u0ca6\u0cbe\u0ca6\u0ccd\u0caf\u0c82\u0ca4 \u0cb8\u0ccd\u0c9f\u0ccd\u0caf\u0cbe\u0c82\u0caa\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c93\u0cb5\u0cb0\u0ccd\u200c\u0cb0\u0cc8\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0ca8\u0c82\u0ca4\u0cb9 \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0ca4\u0caa\u0ccd\u0caa\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.",four:"\u0c86\u0ca8\u0ccd\u0cb2\u0cc8\u0ca8\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c95\u0ccd\u0c95\u0cc6 \u0ca8\u0cc0\u0cb5\u0cc1 \u20b950 (\u0c90\u0cb5\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb0\u0cc2\u0caa\u0cbe\u0caf\u0cbf\u0c97\u0cb3\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0) \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1. \u0c95\u0ccd\u0cb0\u0cc6\u0ca1\u0cbf\u0c9f\u0ccd/\u0ca1\u0cc6\u0cac\u0cbf\u0c9f\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cc6\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cc0\u0cb5\u0cc1 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c88 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc1\u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0ca6\u0cc1. \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0caf \u0cb8\u0c82\u0ca6\u0cb0\u0ccd\u0cad\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf, \u0ca8\u0cc0\u0cb5\u0cc1 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc1\u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",five:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c92\u0c82\u0ca6\u0cc1 \u0cb8\u0cc7\u0cb5\u0cbe \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 (\u0c8e\u0cb8\u0ccd \u0c86\u0cb0\u0ccd \u0c8e\u0ca8\u0ccd) \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cc0\u0cb0\u0cbf. \u0c85\u0caa\u0ccd\u0ca1\u0cc7\u0c9f\u0ccd  \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c9f\u0ccd\u0cb0\u0ccd\u0caf\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0caf\u0cc1\u0c90\u0ca1\u0cbf\u0c8e\u0c90 \u0cb9\u0cc6\u0cb2\u0ccd\u0caa\u0ccd \u0ca1\u0cc6\u0cb8\u0ccd\u0c95\u0ccd \u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cad\u0cb5\u0cbf\u0cb7\u0ccd\u0caf\u0ca6 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0c88 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cbf.",six:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0ccd\u0cae \u0c86\u0c82\u0ca4\u0cb0\u0cbf\u0c95 \u0c97\u0cc1\u0ca3\u0cae\u0c9f\u0ccd\u0c9f \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cbe\u0cb9\u0c95\u0cb0\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6. \u0c88 \u0cb9\u0c82\u0ca4\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0ca1\u0cc6\u0cae\u0cca\u0c97\u0ccd\u0cb0\u0cbe\u0cab\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cbf\u0cb0\u0cc1\u0cb5 \u0caa\u0cc2\u0cb0\u0c95 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cb9\u0cca\u0c82\u0ca6\u0cbe\u0ca3\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbf\u0cb0\u0cb8\u0ccd\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0ca4\u0cc6\u0caf\u0cbf\u0ca6\u0cc6.",seven:"\u0c97\u0cc1\u0ca3\u0cae\u0c9f\u0ccd\u0c9f \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0c82\u0ca1 \u0ca8\u0c82\u0ca4\u0cb0, \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0c90\u0ca1\u0cbf \u0cab\u0cb2\u0cbf\u0ca4\u0cbe\u0c82\u0cb6 \u0c92\u0cb3\u0c97\u0cca\u0c82\u0ca1 \u0c8e\u0cb8\u0ccd\u0c8e\u0c82\u0c8e\u0cb8\u0ccd \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cc0\u0cb0\u0cbf.",eight:"\u0ca8\u0cae\u0ccd\u0cae \u0cac\u0ccd\u0caf\u0cbe\u0c95\u0ccd \u0c8e\u0c82\u0ca1\u0ccd \u0c9f\u0cc0\u0cae\u0ccd \u0ca8\u0cbf\u0c82\u0ca6 \u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0cc0\u0c95\u0cb0\u0ca3\u0c97\u0cb3 \u0ca8\u0c82\u0ca4\u0cb0, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cab\u0cb2\u0cbf\u0ca4\u0cbe\u0c82\u0cb6\u0ca6 \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c8e\u0cb8\u0ccd\u0c8e\u0c82\u0c8e\u0cb8\u0ccd \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cc0\u0cb0\u0cbf.",nine:"\u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0cc1 90% \u0cb8\u0cc7\u0cb5\u0cbe \u0cae\u0cbe\u0ca8\u0ca6\u0c82\u0ca1\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 30 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca8\u0cbe\u0cb5\u0cc1 \u0ca8\u0cae\u0ccd\u0cae \u0cb5\u0ccd\u0caf\u0cb5\u0cb8\u0ccd\u0ca5\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc1\u0ca7\u0cbe\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0cb5\u0cc6. \u0c85\u0ca6\u0c95\u0ccd\u0c95\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0cc1 \u0c89\u0cb2\u0ccd\u0cb2\u0cc7\u0c96\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb8\u0cae\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cca\u0ca6\u0cb2\u0cc7 \u0c85\u0caa\u0ccd\u0ca1\u0cc7\u0c9f\u0ccd \u0c86\u0c97\u0cc1\u0cb5 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0ca4\u0cc6\u0caf\u0cc2 \u0c87\u0ca6\u0cc6. myaadhaar.uidai.gov.in \u0cad\u0cc7\u0c9f\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1."}},updateSelectPage:{title:"\u0c86\u0ca8\u0ccd\u0cb2\u0cc8\u0ca8\u0ccd \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf",selectFields:{smallDescription:"\u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe \u0c95\u0ccd\u0cb7\u0cc7\u0ca4\u0ccd\u0cb0(\u0c97\u0cb3\u0cc1) \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",longDescription:"\u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c88 \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cbe\u0ca6\u0cb0\u0cc2 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe \u0c95\u0ccd\u0cb7\u0cc7\u0ca4\u0ccd\u0cb0 (\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1) \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",updatesLeft:" \u0cac\u0cbe\u0c95\u0cbf \u0c87\u0cb0\u0cc1\u0cb5 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c97\u0cb3\u0cc1",noLimit:"\u0cae\u0cbf\u0ca4\u0cbf \u0c87\u0cb2\u0ccd\u0cb2",demoGraphics:{language:"\u0cad\u0cbe\u0cb7\u0cc6",name:"\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1",dob:"\u0cb9\u0cc1\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95",gender:"\u0cb2\u0cbf\u0c82\u0c97",hof:"\u0c95\u0cc1\u0c9f\u0cc1\u0c82\u0cac\u0ca6 \u0cae\u0cc1\u0c96\u0ccd\u0caf\u0cb8\u0ccd\u0ca5 (HOF) \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3",address:"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8"}},documentDescriptionLinkText:"\u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0caa\u0cbf\u0c93\u0c90 / \u0caa\u0cbf\u0c93\u0c8e / \u0caa\u0cbf\u0c93\u0cac\u0cbf \u0c97\u0cc6 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0cb8\u0cbf\u0ca6  \u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cbf",proceedToUpdateAadhaar:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbf\u0cb0\u0cbf",faq:"\u0caa\u0ca6\u0cc7 \u0caa\u0ca6\u0cc7 \u0c95\u0cc7\u0cb3\u0cb2\u0cbe\u0c97\u0cc1\u0cb5 \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0cc1"},dashboard:"\u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd",hof:{title:"\u0c95\u0cc1\u0c9f\u0cc1\u0c82\u0cac\u0ca6 \u0cae\u0cc1\u0c96\u0ccd\u0caf\u0cb8\u0ccd\u0ca5 (HOF) \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3",description:"\u0c95\u0cc1\u0c9f\u0cc1\u0c82\u0cac\u0ca6 \u0cae\u0cc1\u0c96\u0ccd\u0caf\u0cb8\u0ccd\u0ca5\u0cb0 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0ca6 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0ca6\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",howItWorks:{step1:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe\u0cac\u0cc7\u0cb8\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cc1\u0c9f\u0cc1\u0c82\u0cac\u0ca6 \u0cae\u0cc1\u0c96\u0ccd\u0caf\u0cb8\u0ccd\u0ca5\u0cb0 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf. 18 \u0c85\u0ca5\u0cb5\u0cbe \u0c85\u0ca6\u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0cb5\u0caf\u0cb8\u0ccd\u0cb8\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cb2\u0cc1\u0caa\u0cbf\u0ca6 \u0ca8\u0cbf\u0cb5\u0cbe\u0cb8\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 HoF \u0c8e\u0c82\u0ca6\u0cc1 \u0caa\u0cb0\u0cbf\u0c97\u0ca3\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",step2:'\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cc1\u0c9f\u0cc1\u0c82\u0cac\u0ca6 \u0cae\u0cc1\u0c96\u0ccd\u0caf\u0cb8\u0ccd\u0ca5\u0cb0 \u0cb9\u0cc6\u0cb8\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0caa\u0cb7\u0ccd\u0c9f\u0cb5\u0cbe\u0c97\u0cbf \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf\u0cb0\u0cc1\u0cb5 \u0c9c\u0cca\u0ca4\u0cc6\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cc6\u0cb8\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0ca6 \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6 (PoR) \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 HoF \u0ca8 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf, \u0c89\u0ca6\u0cbe\u0cb9\u0cb0\u0ca3\u0cc6\u0c97\u0cc6 HoF \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0ca4\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, "\u0c97\u0c82\u0ca1" \u0c8e\u0c82\u0ca6\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf.',step3:"\u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0c85\u0caa\u0ccd\u200c\u0ca1\u0cc7\u0c9f\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c95\u0ccd\u0c95\u0cc6 \u0ca8\u0cc0\u0cb5\u0cc1 \u20b9 50 (\u0c90\u0cb5\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb0\u0cc2\u0caa\u0cbe\u0caf\u0cbf\u0c97\u0cb3\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0) \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1. \u0ca8\u0cc0\u0cb5\u0cc1 \u0c95\u0ccd\u0cb0\u0cc6\u0ca1\u0cbf\u0c9f\u0ccd/\u0ca1\u0cc6\u0cac\u0cbf\u0c9f\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cc6\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c88 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc1\u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.",step4:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cc1\u0c9f\u0cc1\u0c82\u0cac\u0ca6 \u0cae\u0cc1\u0c96\u0ccd\u0caf\u0cb8\u0ccd\u0ca5\u0cb0\u0cc1  \u0cae\u0cc8\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6\u0cbe\u0c97, \u0c85\u0cb5\u0cb0\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6, \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0cb5\u0cb0\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. HoF \u0cae\u0cc2\u0cb2\u0c95 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 / \u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c88 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0caf\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0ca6\u0cbf\u0c82\u0ca6 30 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."},currentSection:{title:"\u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf HoF \u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6"},updateSection:{forms:{hofUid:{label:"HoF \u0ca8 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf"},mobileField:{label:"HoF \u0ca8 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6"},documentUpload:{label:"\u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0ca6 \u0caa\u0ccb\u0cb7\u0c95 \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf"},relationshipDropdown:{label:"\u0c85\u0cb0\u0ccd\u0c9c\u0cbf\u0ca6\u0cbe\u0cb0\u0cb0\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 HoF \u0ca8 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",values:{father:"\u0ca4\u0c82\u0ca6\u0cc6",mother:"\u0ca4\u0cbe\u0caf\u0cbf",husband:"\u0c97\u0c82\u0ca1",wife:"\u0cb9\u0cc6\u0c82\u0ca1\u0ca4\u0cbf",guardian:"\u0c97\u0cbe\u0cb0\u0ccd\u0ca1\u0cbf\u0caf\u0ca8\u0ccd",Others:"\u0c87\u0ca4\u0cb0\u0cb0\u0cc1"}}}}},documentInfoPopup:{title:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",identityDocumentInfo:"\u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6\u0c97\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0c85\u0ca6\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cc6\u0cb8\u0cb0\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cad\u0cbe\u0cb5\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1. \u0ca8\u0cc0\u0cb5\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 '\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1' \u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cc7\u0cb2\u0cc6 \u0ca4\u0cbf\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 '\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1' \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0c8e\u0c82\u0cac\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.",addressDocumentInfo:"\u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0c87\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0c85\u0ca6\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cc6\u0cb8\u0cb0\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1. \u0cb8\u0c82\u0c97\u0cbe\u0ca4\u0cbf\u0caf, \u0caa\u0ccb\u0cb7\u0c95\u0cb0\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0ccb\u0cb7\u0c95\u0cb0 \u0cb9\u0cc6\u0cb8\u0cb0\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cc7\u0cb2\u0cc6 \u0ca4\u0cbf\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 '\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8' \u0ca8\u0cc0\u0cb5\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca1\u0cbe\u0c95\u0ccd\u0caf\u0cc1\u0cae\u0cc6\u0c82\u0c9f\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf '\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8'\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0c8e\u0c82\u0cac\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.",close:"\u0c95\u0ccd\u0cb2\u0ccb\u0cb8\u0ccd",continueToUpload:"\u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf"},forms:{reUseDocText:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c88\u0c97\u0cbe\u0c97\u0cb2\u0cc7 \u0c85\u0caa\u0ccd \u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc1\u0cac\u0cb3\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",stepper:{language:"\u0cad\u0cbe\u0cb7\u0cc6",Name:"\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1",dob:"\u0cb9\u0cc1\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95",gender:"\u0cb2\u0cbf\u0c82\u0c97",address:"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8",preview:"\u0cae\u0cc1\u0ca8\u0ccd\u0ca8\u0cc6\u0cc2\u0cd5\u0c9f",payment:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf"},formButtons:{back:"\u0cb9\u0cbf\u0c82\u0ca6\u0cc6",next:"\u0cae\u0cc1\u0c82\u0ca6\u0cc6",makePayment:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cbf",retry:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc1\u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf",goToDashboard:"\u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd \u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf"},languageForm:{currentSection:{title:"\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0cad\u0cbe\u0cb7\u0cc6\u0caf \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 ",fields:{currentLocalLanguage:"\u0caa