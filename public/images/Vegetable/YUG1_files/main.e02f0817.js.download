f\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d02"},success:{desc:"\u0d38\u0d47\u0d35\u0d28\u0d02 \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d37\u0d46\u0d2f\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",p1:"\u0d38\u0d3f\u0d2a\u0d4d  \u0d2b\u0d2f\u0d7d",p2:"\u0d37\u0d46\u0d2f\u0d7c \u0d15\u0d4b\u0d21\u0d4d",p3:"\u0d38\u0d47\u0d35\u0d28 \u0d26\u0d3e\u0d24\u0d3e\u0d35\u0d3f\u0d7d \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c",summary:"\u0d07\u0d24\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d36\u0d47\u0d16\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d4b \u0d38\u0d02\u0d2d\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d4b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d24\u0d46 \u0d24\u0d28\u0d4d\u0d28\u0d46 \u0d38\u0d47\u0d35\u0d28 \u0d26\u0d3e\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d13\u0d2b\u0d4d\u200c\u0d32\u0d48\u0d7b \u0d35\u0d46\u0d30\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d38\u0d40\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d0e\u0d28\u0d4d\u0d31\u0d3f\u0d31\u0d4d\u0d31\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02 (OVSE) \u0d13\u0d2b\u0d4d\u200c\u0d32\u0d48\u0d7b \u0d06\u0d27\u0d3e\u0d7c \u0d35\u0d46\u0d30\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d38\u0d57\u0d15\u0d30\u0d4d\u0d2f\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d02."},descTextStep1:"\u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d47\u0d2a\u0d4d\u0d2a\u0d7c\u0d32\u0d46\u0d38\u0d4d \u0d13\u0d2b\u0d4d\u200c\u0d32\u0d48\u0d7b \u0d07-\u0d15\u0d46\u0d35\u0d48\u0d38\u0d3f \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d24\u0d35\u0d41\u0d02 \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d3e\u0d35\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d41\u0d2e\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d30\u0d47\u0d16\u0d2f\u0d3e\u0d23\u0d4d, \u0d05\u0d24\u0d4d \u0d24\u0d3f\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d31\u0d3f\u0d2f\u0d32\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d13\u0d2b\u0d4d\u200c\u0d32\u0d48\u0d7b \u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d40\u0d15\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d0f\u0d24\u0d4a\u0d30\u0d41 \u0d06\u0d27\u0d3e\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02. \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d2a\u0d47\u0d30\u0d4d, \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02, \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b, \u0d32\u0d3f\u0d02\u0d17\u0d2d\u0d47\u0d26\u0d02, \u0d21\u0d3f \u0d12 \u0d2c\u0d3f, \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d39\u0d3e\u0d37\u0d4d, \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d39\u0d3e\u0d37\u0d4d, \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d05\u0d35\u0d38\u0d3e\u0d28 4 \u0d05\u0d15\u0d4d\u0d15\u0d19\u0d4d\u0d19\u0d7e \u0d09\u0d7e\u0d15\u0d4d\u0d15\u0d4a\u0d33\u0d4d\u0d33\u0d41\u0d28\u0d4d\u0d28 \u0d31\u0d2b\u0d31\u0d7b\u0d38\u0d4d \u0d10\u0d21\u0d3f \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d41\u0d02 \u0d24\u0d41\u0d1f\u0d7c\u0d28\u0d4d\u0d28\u0d4d \u0d21\u0d3f\u0d1c\u0d3f\u0d31\u0d4d\u0d31\u0d7d \u0d38\u0d48\u0d7b \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d0e\u0d15\u0d4d\u0d38\u0d4d \u0d0e\u0d02 \u0d0e\u0d7d -\u0d7d \u0d1f\u0d48\u0d02 \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d2e\u0d4d\u0d2a\u0d41\u0d02 \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02.",descTextStep2:"\u0d13\u0d2b\u0d4d\u200c\u0d32\u0d48\u0d7b \u0d07 \u0d15\u0d46\u0d35\u0d48\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d3f\u0d2a\u0d4d \u0d2b\u0d2f\u0d7d \u0d35\u0d3f\u0d1c\u0d2f\u0d15\u0d30\u0d2e\u0d3e\u0d2f\u0d3f \u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d41"},lockUnlockBiometrics:{serviceCard:{errorMessage:"\u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d32\u0d46 \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d/\u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d32 \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d41\u0d35\u0d30\u0d46 \u0d15\u0d3e\u0d24\u0d4d\u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15."},howItWorks:{title:"\u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u200c\u0d38\u0d4d \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d/\u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41",description:"\u0d2c\u0d2f\u0d4b \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d /\u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d2b\u0d40\u0d1a\u0d4d\u0d1a\u0d7c \u0d31\u0d46\u0d38\u0d3f\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d26\u0d41\u0d30\u0d41\u0d2a\u0d2f\u0d4b\u0d17\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d38\u0d3e\u0d27\u0d4d\u0d2f\u0d24\u0d2f\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d4d \u0d24\u0d1f\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d06\u0d27\u0d3f\u0d15\u0d3e\u0d30\u0d3f\u0d15\u0d24\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d24\u0d1f\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d06\u0d27\u0d3f\u0d15\u0d3e\u0d30\u0d3f\u0d15\u0d24 \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d3f\u0d37\u0d47\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d24\u0d1f\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d08 \u0d38\u0d47\u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d09\u0d2a\u0d2f\u0d4b\u0d15\u0d4d\u0d24\u0d3e\u0d15\u0d4d\u0d15\u0d7e \u0d36\u0d4d\u0d30\u0d26\u0d4d\u0d27\u0d3e\u0d24\u0d4d\u0d24\u0d4b\u0d1f\u0d46 \u0d05\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d23\u0d2e\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d2e\u0d41\u0d28\u0d4d\u0d28\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",infoData:{stepOneDescription:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u200c\u0d38\u0d4d \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d21\u0d3e\u0d37\u0d4d\u200c\u0d2c\u0d4b\u0d7c\u0d21\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d08 \u0d38\u0d47\u0d35\u0d28\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u200c\u0d38\u0d4d (\u0d35\u0d3f\u0d30\u0d32\u0d1f\u0d2f\u0d3e\u0d33\u0d02, \u0d10\u0d31\u0d3f\u0d38\u0d4d, \u0d2e\u0d41\u0d16\u0d02) \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d7e\xa0 \u0d05\u0d35 \u0d13\u0d24\u0d28\u0d4d\u0d31\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d28\u0d41\u0d35\u0d47\u0d23\u0d4d\u0d1f\u0d3f \u0d07\u0d28\u0d3f \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d3e\u0d15\u0d3f\u0d32\u0d4d\u0d32. \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d3e\u0d32\u0d41\u0d02, \u0d12\u0d1f\u0d3f\u0d2a\u0d3f  \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d13\u0d24\u0d28\u0d4d\u0d31\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b  \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d38\u0d30\u0d23\u0d02 \u0d24\u0d41\u0d1f\u0d7c\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d15\u0d41\u0d02.",stepTwoDescription:"\u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d08 \u0d2a\u0d47\u0d1c\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d1f\u0d19\u0d4d\u0d19\u0d3f, \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d7e \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u200c\u0d38\u0d4d (\u0d35\u0d3f\u0d30\u0d32\u0d1f\u0d2f\u0d3e\u0d33\u0d02 + \u0d10\u0d31\u0d3f\u0d38\u0d4d + \u0d2e\u0d41\u0d16\u0d02) \u0d12\u0d1f\u0d3f\u0d2a\u0d3f \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d13\u0d24\u0d28\u0d4d\u0d31\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d28\u0d4b\u0d1f\u0d4a\u0d2a\u0d4d\u0d2a\u0d02 \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d15\u0d4d\u0d37\u0d2e\u0d2e\u0d3e\u0d15\u0d41\u0d02."}},selectionScreen:{unlockCard:{heading:"\u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15",consentText:"\u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u200c\u0d24 \u0d36\u0d47\u0d37\u0d02, \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d \u0d13\u0d24\u0d28\u0d4d\u0d31\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d35\u0d3e\u0d7b  \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d2e\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d1e\u0d3e\u0d7b \u0d2e\u0d28\u0d38\u0d4d\u0d38\u0d3f\u0d32\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",label:"\u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},lockCard:{heading:"\u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15",consentText:"\u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u200c\u0d24 \u0d36\u0d47\u0d37\u0d02, \u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u200c\u0d38\u0d4d \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d41\u0d35\u0d30\u0d46 \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d \u0d13\u0d24\u0d28\u0d4d\u0d31\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b  \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d35\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d3f\u0d32\u0d4d\u0d32\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d1e\u0d3e\u0d7b \u0d2e\u0d28\u0d38\u0d4d\u0d38\u0d3f\u0d32\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",label:"\u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},selectOptionError:"\u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d12\u0d30\u0d41 \u0d13\u0d2a\u0d4d\u0d37\u0d7b \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02 \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15.",selectButton:{tempUnlock:"\u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u200c\u0d38\u0d4d \u0d24\u0d3e\u0d7d\u0d15\u0d4d\u0d15\u0d3e\u0d32\u0d3f\u0d15\u0d2e\u0d3e\u0d2f\u0d3f \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",tempUnlockInfo:"\u0d12\u0d30\u0d41 \u0d1a\u0d46\u0d31\u0d3f\u0d2f \u0d15\u0d3e\u0d32\u0d2f\u0d33\u0d35\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d",unlock:"\u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u200c\u0d38\u0d4d \u0d36\u0d3e\u0d36\u0d4d\u0d35\u0d24\u0d2e\u0d3e\u0d2f\u0d3f \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",unlockInfo:"\u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24 \u0d24\u0d35\u0d23 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d35\u0d30\u0d46"}},successScreen:{tempUnlockMessage:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d36\u0d3e\u0d36\u0d4d\u0d35\u0d24\u0d2e\u0d3e\u0d2f\u0d3f \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d23\u0d2e\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d21\u0d3e\u0d37\u0d4d\u200c\u0d2c\u0d4b\u0d7c\u0d21\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d02  \u0d08 \u0d38\u0d47\u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f  \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d41\u0d02 \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15"}},lockUnlockAadhaar:{howItWorks:{title:"\u0d06\u0d27\u0d3e\u0d7c \u0d35\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d7e \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d/\u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02",infoData:{stepOneLabel:"\u0d18\u0d1f\u0d4d\u0d1f\u0d02 1 / 3: ",stepOneDescription:"\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d / \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d4b\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2e\u0d41\u0d2e\u0d4d\u0d2a\u0d4d, 16 \u0d05\u0d15\u0d4d\u0d15 \u0d35\u0d46\u0d7c\u0d1a\u0d4d\u0d35\u0d7d \u0d10\u0d21\u0d3f (\u0d35\u0d3f\u0d10\u0d21\u0d3f) \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d15\u0d3e\u0d30\u0d23\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d34\u0d3f\u0d35\u0d4d \u0d35\u0d3f\u0d10\u0d21\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 \u0d09\u0d33\u0d4d\u0d33\u0d42. \u0d21\u0d3e\u0d37\u0d4d\u0d2c\u0d4b\u0d7c\u0d21\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d7c\u0d1a\u0d4d\u0d35\u0d7d \u0d10\u0d21\u0d3f \u0d38\u0d47\u0d35\u0d28\u0d02 \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d4b \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d 1947 \u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d12\u0d30\u0d41 \u0d0e\u0d38\u0d4d\u0d0e\u0d02\u0d0e\u0d38\u0d4d \u0d05\u0d2f\u0d1a\u0d4d\u0d1a\u0d41\u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4b \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02. RVID [\u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d05\u0d35\u0d38\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d46 4 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d 8 \u0d05\u0d15\u0d4d\u0d15\u0d19\u0d4d\u0d19\u0d7e] {ex: RVID 1234}. ",stepOneLinkText:" \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",stepTwoLabel:"\u0d18\u0d1f\u0d4d\u0d1f\u0d02 2 / 3: ",stepTwoDescription:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d10\u0d21\u0d3f (VID) \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d15\u0d34\u0d3f\u0d1e\u0d4d\u0d1e\u0d3e\u0d7d, \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d08 \u0d2a\u0d47\u0d1c\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d1f\u0d19\u0d4d\u0d19\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d35\u0d3f\u0d10\u0d21\u0d3f (VID) \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d7d \u0d24\u0d41\u0d1f\u0d30\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15, \u0d24\u0d41\u0d1f\u0d7c\u0d28\u0d4d\u0d28\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d41\u0d33\u0d4d\u0d33\u0d2a\u0d4d\u0d2a\u0d4b\u0d34\u0d46\u0d32\u0d4d\u0d32\u0d3e\u0d02 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d10\u0d21\u0d3f (VID) \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d15\u0d3e\u0d30\u0d23\u0d02 \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u200c\u0d24\u0d3e\u0d7d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d30\u0d39\u0d3f\u0d24\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d02.",stepThreeLabel:"\u0d18\u0d1f\u0d4d\u0d1f\u0d02 3 / 3: ",stepThreeDescription:"\u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d08 \u0d2a\u0d47\u0d1c\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d1f\u0d19\u0d4d\u0d19\u0d3f \u0d06\u0d27\u0d3e\u0d7c \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d2a\u0d4b\u0d15\u0d41\u0d15; \u0d35\u0d3f\u0d10\u0d21\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 \u0d06\u0d27\u0d3e\u0d7c \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d34\u0d3f\u0d35\u0d41\u0d33\u0d4d\u0d33\u0d42, \u0d05\u0d24\u0d47\u0d38\u0d2e\u0d2f\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d23\u0d35\u0d41\u0d02 \u0d05\u0d28\u0d41\u0d35\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41."}},formScreen:{title:"\u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d/\u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d15",radioLabels:{lockAadhaar:"\u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15",unlockAadhaar:"\u0d06\u0d27\u0d3e\u0d7c \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"},consent:{lockConsent:"\u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u200c\u0d24 \u0d36\u0d47\u0d37\u0d02, \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d32\u0d4d\u0d32, \u0d35\u0d46\u0d7c\u0d1a\u0d4d\u0d35\u0d7d \u0d10\u0d21\u0d3f (VID) \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d23\u0d02 \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d42 \u0d0e\u0d28\u0d4d\u0d28\u0d4d \u0d1e\u0d3e\u0d7b \u0d2e\u0d28\u0d38\u0d4d\u0d38\u0d3f\u0d32\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.",unlockConsent:"\u0d0e\u0d28\u0d4d\u0d31\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u200c\u0d24 \u0d36\u0d47\u0d37\u0d02, \u0d35\u0d46\u0d7c\u0d1a\u0d4d\u0d35\u0d7d \u0d10\u0d21\u0d3f\u0d2f\u0d41\u0d02 (VID) \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d23\u0d02 \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d2e\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d1e\u0d3e\u0d7b \u0d2e\u0d28\u0d38\u0d4d\u0d38\u0d3f\u0d32\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41."},textFields:{name:"\u0d2e\u0d41\u0d34\u0d41\u0d35\u0d7b \u0d2a\u0d47\u0d30\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d15",pincode:"\u0d2a\u0d3f\u0d7b\u0d15\u0d4b\u0d21\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d15"}}},verifyEmailMobile:{desc:"\u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d / \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d31\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d15",verifyMobile:"\u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",verifyEmail:"\u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",verifyEmailMobile:"\u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d/\u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15"},bankLinkingStatus:{sectionTitle:"\u0d06\u0d27\u0d3e\u0d7c \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d4d \u0d32\u0d3f\u0d19\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d28\u0d3f\u0d32 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15",aadhaarNumber:"\u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c",bankLinkingStatus:"\u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d4d \u0d32\u0d3f\u0d19\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d28\u0d3f\u0d32",active:"\u0d38\u0d1c\u0d40\u0d35\u0d2e\u0d3e\u0d2f",inactive:"\u0d28\u0d3f\u0d37\u0d4d\u200c\u0d15\u0d4d\u0d30\u0d3f\u0d2f\u0d02",prevBankDetails:"\u0d2e\u0d41\u0d2e\u0d4d\u0d2a\u0d24\u0d4d\u0d24\u0d46 \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d4d \u0d32\u0d3f\u0d19\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e",lastUpdatedDate:"\u0d2a\u0d41\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d3f\u0d2f \u0d05\u0d35\u0d38\u0d3e\u0d28 \u0d24\u0d40\u0d2f\u0d24\u0d3f",failureMessage:"\u0d08 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d28\u0d4d\u0d31\u0d46  \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d4d \u0d2e\u0d3e\u0d2a\u0d4d\u0d2a\u0d3f\u0d02\u0d17\u0d4d \u0d31\u0d46\u0d15\u0d4d\u0d15\u0d4b\u0d7c\u0d21\u0d4a\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d3f\u0d32\u0d4d\u0d32",successMessage:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c-\u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d4d \u0d2e\u0d3e\u0d2a\u0d4d\u0d2a\u0d3f\u0d02\u0d17\u0d4d \u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d3e\u0d2f\u0d3f",disclaimer:"\u0d0e\u0d7b\u200c\u0d2a\u0d3f\u200c\u0d38\u0d3f\u200c\u0d10 \u0d38\u0d46\u0d7c\u0d35\u0d31\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d3f\u0d19\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d28\u0d3f\u0d32 \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f.\u0d12\u0d30\u0d41 \u0d38\u0d3e\u0d39\u0d1a\u0d30\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d41\u0d02, \u0d2a\u0d4d\u0d30\u0d26\u0d7c\u0d36\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d31\u0d4d\u0d31\u0d38\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d24\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d2f\u0d41\u0d10\u200c\u0d21\u0d3f\u200c\u0d0e\u0d10 \u0d09\u0d24\u0d4d\u0d24\u0d30\u0d35\u0d3e\u0d26\u0d3f\u0d2f\u0d4b \u0d2c\u0d3e\u0d27\u0d4d\u0d2f\u0d30\u0d4b \u0d06\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3f\u0d32\u0d4d\u0d32. \u0d15\u0d42\u0d1f\u0d3e\u0d24\u0d46, \u0d0e\u0d7b\u200c\u0d2a\u0d3f\u200c\u0d38\u0d3f\u200c\u0d10 \u0d38\u0d46\u0d7c\u0d35\u0d31\u0d41\u0d15\u0d33\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d32\u0d2d\u0d3f\u0d1a\u0d4d\u0d1a \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d4a\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d2f\u0d41\u0d10\u200c\u0d21\u0d3f\u200c\u0d0e\u0d10 \u0d38\u0d02\u0d2d\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32.",noRecordsAvailable:"\u0d30\u0d47\u0d16\u0d15\u0d33\u0d4a\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d32\u0d4d\u0d32",checkWithBank:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d4d \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d2c\u0d28\u0d4d\u0d27\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d15"},bankSeedingStatus:{AadhaarNumber:"\u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c",BankName:"\u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d47\u0d30\u0d4d",BankSeedingStatus:"\u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d4d \u0d38\u0d40\u0d21\u0d3f\u0d02\u0d17\u0d4d \u0d28\u0d3f\u0d32",LastUpdatedDate:"\u0d05\u0d35\u0d38\u0d3e\u0d28\u0d02 \u0d2a\u0d41\u0d24\u0d41\u0d15\u0d4d\u0d15\u0d3f\u0d2f \u0d24\u0d40\u0d2f\u0d24\u0d3f",noRecordAlert:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d4d \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d32\u0d3f\u0d19\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d15",note:"\u0d32\u0d3f\u0d19\u0d4d\u0d15\u0d4d \u0d35\u0d34\u0d3f \u0d28\u0d7d\u0d15\u0d3f\u0d2f \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d3e\u0d37\u0d23\u0d7d \u0d2a\u0d47\u0d2f\u0d4d\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d15\u0d4b\u0d7c\u0d2a\u0d4d\u0d2a\u0d31\u0d47\u0d37\u0d7b \u0d13\u0d2b\u0d4d  \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f \u0d2f\u0d41\u0d1f\u0d46 (NPCI) \u0d38\u0d46\u0d7c\u0d35\u0d31\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d3e\u0d23\u0d4d \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d. \u0d05\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d15\u0d43\u0d24\u0d4d\u0d2f\u0d24\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d09\u0d24\u0d4d\u0d24\u0d30\u0d35\u0d3e\u0d26\u0d3f\u0d2f\u0d32\u0d4d\u0d32. \u0d32\u0d2d\u0d3f\u0d1a\u0d4d\u0d1a \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e UIDAI \u0d38\u0d02\u0d2d\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d1f\u0d4d\u0d1f\u0d3f\u0d32\u0d4d\u0d32.",ActiveText:"\u0d38\u0d1c\u0d40\u0d35\u0d2e\u0d3e\u0d23\u0d4d",InactiveText:"\u0d28\u0d3f\u0d37\u0d4d\u0d15\u0d4d\u0d30\u0d3f\u0d2f"},FAQ:{checkAadhaarPvcCardOrderStatus:[{question:"\u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d35\u0d3f\u0d35\u0d3f\u0d27 \u0d30\u0d42\u0d2a\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d24\u0d4a\u0d15\u0d4d\u0d15\u0d46\u0d2f\u0d3e\u0d23\u0d4d, \u0d05\u0d35\u0d2f\u0d41\u0d1f\u0d46 \u0d38\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d24\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d24\u0d4a\u0d15\u0d4d\u0d15\u0d46\u0d2f\u0d3e\u0d23\u0d4d?",answer:"\u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d24\u0d4d\u0d24\u0d4d, \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d, \u0d07 \u0d06\u0d27\u0d3e\u0d7c, \u0d0e\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d3e\u0d23\u0d4d \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d35\u0d4d\u0d2f\u0d24\u0d4d\u0d2f\u0d38\u0d4d\u0d24 \u0d30\u0d42\u0d2a\u0d19\u0d4d\u0d19\u0d7e. \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d0e\u0d32\u0d4d\u0d32\u0d3e \u0d30\u0d42\u0d2a\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d12\u0d30\u0d41\u0d2a\u0d4b\u0d32\u0d46 \u0d38\u0d3e\u0d27\u0d41\u0d24\u0d2f\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d41\u0d02 \u0d38\u0d4d\u0d35\u0d40\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d35\u0d41\u0d2e\u0d3e\u0d23\u0d4d."},{question:"\u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d0f\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d30\u0d42\u0d2a\u0d02  \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d2e\u0d4b?",answer:"\u0d05\u0d24\u0d46"},{question:"\u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d '\u0d13\u0d7c\u0d21\u0d7c \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d' \u0d38\u0d47\u0d35\u0d28\u0d02?",answer:"\u0d13\u0d7c\u0d21\u0d7c \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d06\u0d30\u0d02\u0d2d\u0d3f\u0d1a\u0d4d\u0d1a \u0d12\u0d30\u0d41 \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d38\u0d47\u0d35\u0d28\u0d2e\u0d3e\u0d23\u0d4d, \u0d05\u0d24\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3e\u0d2e\u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d3e\u0d2f \u0d28\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d7e \u0d28\u0d7d\u0d15\u0d3f \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d3f\u0d7d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d2a\u0d4d\u0d30\u0d3f\u0d7b\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d38\u0d39\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41."},{question:"\u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d3f\u0d7b\u0d4d\u0d31\u0d46' \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3e \u0d38\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d24\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d24\u0d4a\u0d15\u0d4d\u0d15\u0d46\u0d2f\u0d3e\u0d23\u0d4d?",answer:"\u0d08 \u0d15\u0d3e\u0d7c\u0d21\u0d3f\u0d7d \u0d07\u0d24\u0d41\u0d2a\u0d4b\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3e \u0d38\u0d35\u0d3f\u0d36\u0d47\u0d37\u0d24\u0d15\u0d7e \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41:\r\n1. \u0d1f\u0d3e\u0d02\u0d2a\u0d7c \u0d2a\u0d4d\u0d30\u0d42\u0d2b\u0d4d \u0d15\u0d4d\u0d2f\u0d41\u0d06\u0d7c  \u0d15\u0d4b\u0d21\u0d4d\r\n2. \u0d39\u0d4b\u0d33\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d02\r\n3. \u0d2e\u0d48\u0d15\u0d4d\u0d30\u0d4b \u0d1f\u0d46\u0d15\u0d4d\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d\r\n4. \u0d17\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d02\r\n5. \u0d07\u0d37\u0d4d\u0d2f\u0d41 \u0d24\u0d40\u0d2f\u0d24\u0d3f\u0d2f\u0d41\u0d02 \u0d05\u0d1a\u0d4d\u0d1a\u0d1f\u0d3f \u0d24\u0d40\u0d2f\u0d24\u0d3f\u0d2f\u0d41\u0d02\r\n6. \u0d17\u0d3f\u0d32\u0d4b\u0d1a\u0d4d\u0d1a\u0d4d  \u0d2a\u0d3e\u0d31\u0d4d\u0d31\u0d47\u0d7a\r\n7. \u0d0e\u0d02\u0d2c\u0d4b\u0d38\u0d4d\u0d21\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d4b\u0d17\u0d4b"},{question:"\u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d3f\u0d28\u0d4d \u0d28\u0d7d\u0d15\u0d47\u0d23\u0d4d\u0d1f \u0d28\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d24\u0d4a\u0d15\u0d4d\u0d15\u0d46\u0d2f\u0d3e\u0d23\u0d4d?",answer:"\u0d05\u0d1f\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d47\u0d23\u0d4d\u0d1f \u0d28\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d7e 50/- \u0d30\u0d42\u0d2a\u0d2f\u0d3e\u0d23\u0d4d (\u0d1c\u0d3f\u0d0e\u0d38\u0d4d\u0d1f\u0d3f\u0d2f\u0d41\u0d02 \u0d38\u0d4d\u0d2a\u0d40\u0d21\u0d4d \u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d3e\u0d7c\u0d1c\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d46)."},{question:"\u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d3f\u0d28\u0d3e\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d12\u0d30\u0d3e\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d28\u0d7d\u0d15\u0d3e\u0d02?",answer:"\u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d14\u0d26\u0d4d\u0d2f\u0d4b\u0d17\u0d3f\u0d15 \u0d35\u0d46\u0d2c\u0d4d\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d4d (https://www.uidai.gov.in \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d https://myaadhaar.uidai.gov.in) \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d mAadhaar \u0d06\u0d2a\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d ''\u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d' \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d09\u0d28\u0d4d\u0d28\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02."},{question:"\u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d7d\u0d15\u0d3e\u0d02?",answer:"1. \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f https://uidai.gov.in \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d https://myaadhaar.uidai.gov.in/genricPVC \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.\n2. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 12 \u0d05\u0d15\u0d4d\u0d15 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c (UID) \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d 28 \u0d05\u0d15\u0d4d\u0d15 \u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d10\u0d21\u0d3f \u0d28\u0d7d\u0d15\u0d41\u0d15.\n3. \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3e \u0d15\u0d4b\u0d21\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d15\n4. \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7d \u0d32\u0d2d\u0d3f\u0d1a\u0d4d\u0d1a OTP \u0d28\u0d7d\u0d15\u0d41\u0d15.\n5. \u0d28\u0d3f\u0d2c\u0d28\u0d4d\u0d27\u0d28\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d35\u0d4d\u0d2f\u0d35\u0d38\u0d4d\u0d25\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02' \u0d0e\u0d24\u0d3f\u0d30\u0d3e\u0d2f \u0d1a\u0d46\u0d15\u0d4d\u0d15\u0d4d \u0d2c\u0d4b\u0d15\u0d4d\u0d38\u0d3f\u0d7d \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. (\u0d36\u0d4d\u0d30\u0d26\u0d4d\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15: \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d3e\u0d23\u0d3e\u0d7b \u0d39\u0d48\u0d2a\u0d4d\u0d2a\u0d7c \u0d32\u0d3f\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15).                                   6. OTP \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d28 \u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d7b '\u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15' \u0d2c\u0d1f\u0d4d\u0d1f\u0d23\u0d3f\u0d7d \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.                                                                                                                                                                                                                                                                                    7. \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24 \u0d38\u0d4d\u200c\u0d15\u0d4d\u0d30\u0d40\u0d28\u0d3f\u0d7d, \u0d31\u0d40\u0d2a\u0d4d\u0d30\u0d3f\u0d7b\u0d4d\u0d31\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d13\u0d7c\u0d21\u0d7c \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2e\u0d41\u0d2e\u0d4d\u0d2a\u0d4d \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d7b \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d31\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d06\u0d27\u0d3e\u0d7c \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d3f\u0d35\u0d4d\u0d2f\u0d42 \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d15\u0d41\u0d02. 8. '\u0d2a\u0d47\u0d2f\u0d4d\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d41\u0d15' \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d7d \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. \u0d15\u0d4d\u0d30\u0d46\u0d21\u0d3f\u0d31\u0d4d\u0d31\u0d4d/\u0d21\u0d46\u0d2c\u0d3f\u0d31\u0d4d\u0d31\u0d4d \u0d15\u0d3e\u0d7c\u0d21\u0d4d, \u0d28\u0d46\u0d31\u0d4d\u0d31\u0d4d \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d, \u0d2f\u0d41\u0d2a\u0d3f\u0d10 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d28\u0d46\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d13\u0d2a\u0d4d\u200c\u0d37\u0d28\u0d41\u0d15\u0d33\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d17\u0d47\u0d31\u0d4d\u0d31\u0d4d\u200c\u0d35\u0d47 \u0d2a\u0d47\u0d1c\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d46 \u0d31\u0d40\u0d21\u0d2f\u0d31\u0d15\u0d4d\u200c\u0d1f\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d02.                                                                                                                                                                                                                                                                                                                                                                             9. \u0d35\u0d3f\u0d1c\u0d2f\u0d15\u0d30\u0d2e\u0d3e\u0d2f \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d3f\u0d28\u0d4d \u0d36\u0d47\u0d37\u0d02, \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d PDF \u0d2b\u0d4b\u0d7c\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d7d \u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d35\u0d41\u0d28\u0d4d\u0d28 \u0d21\u0d3f\u0d1c\u0d3f\u0d31\u0d4d\u0d31\u0d7d \u0d38\u0d3f\u0d17\u0d4d\u0d28\u0d47\u0d1a\u0d4d\u0d1a\u0d7c \u0d09\u0d33\u0d4d\u0d33 \u0d30\u0d38\u0d40\u0d24\u0d4d \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d02. \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d38\u0d4d\u0d0e\u0d02\u0d0e\u0d38\u0d4d \u0d35\u0d34\u0d3f \u0d38\u0d47\u0d35\u0d28 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d41\u0d02 \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02.                                                                                                                                                                                                                                                                                             10. \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d31\u0d4d\u0d31\u0d38\u0d4d \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d05\u0d2f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d35\u0d30\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d SRN-\u0d7b\u0d4d\u0d31\u0d46 \u0d28\u0d3f\u0d32 \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02.                                                                                              11. DoP-\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d05\u0d2f\u0d1a\u0d4d\u0d1a\u0d41\u0d15\u0d34\u0d3f\u0d1e\u0d4d\u0d1e\u0d3e\u0d7d AWB \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f \u0d0e\u0d38\u0d4d\u0d0e\u0d02\u0d0e\u0d38\u0d41\u0d02 \u0d05\u0d2f\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d41\u0d02. DoP \u0d35\u0d46\u0d2c\u0d4d\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d21\u0d46\u0d32\u0d3f\u0d35\u0d31\u0d3f \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d31\u0d4d\u0d31\u0d38\u0d4d \u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02."},{question:"\u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d24\u0d4d\u0d24/\u0d07\u0d24\u0d30 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d09\u0d2f\u0d7c\u0d24\u0d4d\u0d24\u0d3e\u0d02?",answer:"\u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f https://uidai.gov.in \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d https://myaadhaar.uidai.gov.in/genricPVC '\u0d13\u0d7c\u0d21\u0d7c \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d3e\u0d7c\u0d21\u0d4d' \u0d38\u0d47\u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d mAadhaar \u0d06\u0d2a\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 12 \u0d05\u0d15\u0d4d\u0d15 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c (UID) \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d 28 \u0d05\u0d15\u0d4d\u0d15 \u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d15 \u0d38\u0d46\u0d15\u0d4d\u0d2f\u0d42\u0d30\u0d3f\u0d31\u0d4d\u0d31\u0d3f \u0d15\u0d4b\u0d21\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d15. '\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d07\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d2c\u0d4b\u0d15\u0d4d\u0d38\u0d3f\u0d7d \u0d1a\u0d46\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15' \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d24\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c  \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d13\u0d7c\u0d21\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d28\u0d3f\u0d35\u0d3e\u0d38\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d  \u0d2a\u0d4d\u0d30\u0d3f\u0d35\u0d4d\u0d2f\u0d42 \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d32\u0d4d\u0d32 . \u0d13\u0d7c\u0d21\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d3f \u0d18\u0d1f\u0d4d\u0d1f\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d24\u0d47\u0d2a\u0d1f\u0d3f \u0d24\u0d41\u0d1f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d41."},{question:"\u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d0f\u0d24\u0d4a\u0d15\u0d4d\u0d15\u0d46 \u0d2e\u0d4b\u0d21\u0d41\u0d15\u0d7e \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d?",answer:"\u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d7d, \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d07\u0d28\u0d3f\u0d2a\u0d4d\u0d2a\u0d31\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d2e\u0d4b\u0d21\u0d41\u0d15\u0d7e \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d:-\n\u0d15\u0d4d\u0d30\u0d46\u0d21\u0d3f\u0d31\u0d4d\u0d31\u0d4d \u0d15\u0d3e\u0d7c\u0d21\u0d4d\n\u0d21\u0d46\u0d2c\u0d3f\u0d31\u0d4d\u0d31\u0d4d \u0d15\u0d3e\u0d7c\u0d21\u0d4d\n\u0d28\u0d46\u0d31\u0d4d\u0d31\u0d4d \u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d\n\u0d2f\u0d41\u0d2a\u0d3f\u0d10\nPayTM"},{question:"\u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d SRN?",answer:"SRN \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d4d 14 \u0d05\u0d15\u0d4d\u0d15\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d47\u0d35\u0d28 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3e\u0d23\u0d4d, \u0d05\u0d24\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d09\u0d2f\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d24\u0d3f\u0d28\u0d4d \u0d36\u0d47\u0d37\u0d02 \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d24\u0d41\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f\u0d3e\u0d7d \u0d05\u0d24\u0d4d \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d02. \u0d07\u0d1f\u0d2a\u0d3e\u0d1f\u0d4d \u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d3e\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d41\u0d35\u0d30\u0d46 '\u0d31\u0d46\u0d38\u0d4d\u0d2f\u0d42\u0d02' \u0d13\u0d2a\u0d4d\u0d37\u0d7b \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d15\u0d41\u0d02."},{question:"\u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d AWB \u0d28\u0d2e\u0d4d\u0d2a\u0d7c?",answer:"\u0d0e\u0d2f\u0d7c\u0d35\u0d47 \u0d2c\u0d3f\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c, \u0d05\u0d35\u0d7c \u0d21\u0d46\u0d32\u0d3f\u0d35\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d05\u0d38\u0d48\u0d7b\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d3f\u0d28\u0d4d/\u0d09\u0d7d\u0d2a\u0d4d\u0d2a\u0d28\u0d4d\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f DoP, \u0d05\u0d24\u0d3e\u0d2f\u0d24\u0d4d \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f \u0d38\u0d4d\u0d2a\u0d40\u0d21\u0d4d \u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3e\u0d23\u0d4d."},{question:"\u0d28\u0d3f\u0d35\u0d3e\u0d38\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d  \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d05\u0d35\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d2a\u0d4d\u0d30\u0d3f\u0d7b\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d23\u0d2e\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d0e\u0d28\u0d4d\u0d24\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d02",answer:"\u0d28\u0d3f\u0d35\u0d3e\u0d38\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d4d\u0d30\u0d3f\u0d7b\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d46\u0d31\u0d4d\u0d31\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46\u0d2f\u0d4b \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d3f\u0d7b\u0d4d\u0d31\u0d46\u0d2f\u0d4b \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d1a\u0d3f\u0d32 \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d19\u0d4d\u0d19\u0d7e \u0d35\u0d47\u0d23\u0d2e\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d05\u0d35\u0d7c \u0d06\u0d26\u0d4d\u0d2f\u0d02 \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d2e\u0d3e\u0d2f \u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d38\u0d46\u0d7b\u0d4d\u0d31\u0d7c \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d SSUP \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d7d (\u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d46 \u0d06\u0d36\u0d4d\u0d30\u0d2f\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d) \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d23\u0d02, \u0d24\u0d41\u0d1f\u0d7c\u0d28\u0d4d\u0d28\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d09\u0d28\u0d4d\u0d28\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d15\u0d3e\u0d30\u0d23\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d/\u0d32\u0d46\u0d31\u0d4d\u0d31\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d39\u0d3e\u0d7c\u0d21\u0d4d \u0d15\u0d4b\u0d2a\u0d4d\u0d2a\u0d3f \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d08 \u0d38\u0d57\u0d15\u0d30\u0d4d\u0d2f\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02"},{question:"\u0d35\u0d3f\u0d1c\u0d2f\u0d15\u0d30\u0d2e\u0d3e\u0d2f \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d1a\u0d4d\u0d1a\u0d24\u0d3f\u0d28\u0d4d \u0d36\u0d47\u0d37\u0d02 '\u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d' \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d0e\u0d24\u0d4d\u0d30 \u0d26\u0d3f\u0d35\u0d38\u0d2e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d02?",answer:"\u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d13\u0d7c\u0d21\u0d7c \u0d32\u0d2d\u0d3f\u0d1a\u0d4d\u0d1a \u0d36\u0d47\u0d37\u0d02, \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 5 \u0d2a\u0d4d\u0d30\u0d35\u0d43\u0d24\u0d4d\u0d24\u0d3f \u0d26\u0d3f\u0d35\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d7d (\u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d24\u0d40\u0d2f\u0d24\u0d3f \u0d12\u0d34\u0d3f\u0d15\u0d46) \u0d05\u0d1a\u0d4d\u0d1a\u0d1f\u0d3f\u0d1a\u0d4d\u0d1a \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d3e\u0d7c\u0d21\u0d4d DoP-\u0d28\u0d4d \u0d15\u0d48\u0d2e\u0d3e\u0d31\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d06\u0d27\u0d3e\u0d7c \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d3e\u0d2c\u0d47\u0d38\u0d3f\u0d7d \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d21\u0d46\u0d32\u0d3f\u0d35\u0d31\u0d3f \u0d2e\u0d3e\u0d28\u0d26\u0d23\u0d4d\u0d21\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d28\u0d41\u0d38\u0d43\u0d24\u0d2e\u0d3e\u0d2f\u0d3f \u0d38\u0d4d\u0d2a\u0d40\u0d21\u0d4d \u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d7c\u0d35\u0d40\u0d38\u0d4d \u0d13\u0d2b\u0d4d \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d3e \u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3f\u0d32\u0d42\u0d1f\u0d46\u0d2f\u0d3e\u0d23\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d35\u0d3f\u0d24\u0d30\u0d23\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d. \u0d12\u0d30\u0d41 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d https://www.indiapost.gov.in/_layouts/15/dop.portal.track-\u0d32\u0d46 DoP \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d21\u0d46\u0d32\u0d3f\u0d35\u0d31\u0d3f \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d31\u0d4d\u0d31\u0d38\u0d4d \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02"}],verifyEmailMobile:[{question:"\u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d  \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d4d \u0d0e\u0d28\u0d4d\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d2b\u0d40\u0d38\u0d41\u0d23\u0d4d\u0d1f\u0d4b?",answer:"\u0d05\u0d24\u0d46, \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e Rs. 50/- (\u0d1c\u0d3f\u0d0e\u0d38\u0d4d\u0d1f\u0d3f \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d46)\u0d28\u0d7d\u0d15\u0d23\u0d02"}],orderAadhaarPvcCard:[{question:"\u0d12\u0d30\u0d41 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d07-\u0d06\u0d27\u0d3e\u0d7c \u0d0e\u0d35\u0d3f\u0d1f\u0d46 \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02?",answer:"\u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10\u0d2f\u0d41\u0d1f\u0d46 MyAadhaar portal - https://myaadhaar.uidai.gov.in \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d1a\u0d4d\u0d1a\u0d4b\n\u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d2b\u0d4b\u0d23\u0d41\u0d15\u0d33\u0d3f\u0d7d  mAadhaar \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4b \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d07-\u0d06\u0d27\u0d3e\u0d7c \u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02."}],retrieveEidAadhaarNumber:[{question:"\u0d06\u0d27\u0d3e\u0d7c \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d24\u0d4d\u0d30 \u0d24\u0d35\u0d23 \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02?",answer:"\u0d06\u0d27\u0d3e\u0d7c \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d4d \u0d07\u0d28\u0d3f\u0d2a\u0d4d\u0d2a\u0d31\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d30\u0d3f\u0d27\u0d3f\u0d15\u0d7e \u0d2c\u0d3e\u0d27\u0d15\u0d2e\u0d3e\u0d23\u0d4d:\n\u2022 \u0d2a\u0d47\u0d30\u0d4d: \u0d1c\u0d40\u0d35\u0d3f\u0d24\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d30\u0d23\u0d4d\u0d1f\u0d41\u0d24\u0d35\u0d23\n\u2022 \u0d32\u0d3f\u0d02\u0d17\u0d2d\u0d47\u0d26\u0d02: \u0d1c\u0d40\u0d35\u0d3f\u0d24\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d12\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d7d\n\u2022 \u0d1c\u0d28\u0d28\u0d24\u0d4d\u0d24\u0d40\u0d2f\u0d24\u0d3f: \u0d1c\u0d40\u0d35\u0d3f\u0d24\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d12\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d7d"},{question:"\u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7d \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d47\u0d30\u0d3f\u0d7d \u0d0e\u0d28\u0d4d\u0d24\u0d4d \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d19\u0d4d\u0d19\u0d7e \u0d35\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02?",answer:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d47\u0d30\u0d3f\u0d32\u0d46 \u0d1a\u0d46\u0d31\u0d3f\u0d2f \u0d24\u0d3f\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d32\u0d41\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4b \u200b\u200b\u0d2a\u0d47\u0d30\u0d3f\u0d32\u0d46 \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4b \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02 \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15."},{question:"\u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d0e\u0d28\u0d4d\u0d24\u0d4d \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d?",answer:"\u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d21\u0d4b\u0d15\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d2a\u0d4d\u0d30\u0d15\u0d3e\u0d30\u0d2e\u0d41\u0d33\u0d4d\u0d33 POA \u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d02 \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d. https://uidai.gov.in \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15."},{question:"\u0d06\u0d27\u0d3e\u0d7c \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d0f\u0d24\u0d3e\u0d23\u0d4d?",answer:"\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d38\u0d39\u0d3e\u0d2f \u0d30\u0d47\u0d16\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d. \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d  \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d24\u0d3f\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d7d \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d7e \u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d09\u0d1a\u0d3f\u0d24\u0d2e\u0d3e\u0d2f \u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d02 \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d4d \u0d05\u0d24\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d38\u0d4d\u0d15\u0d3e\u0d7b/\u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d15."},{question:"\u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d38\u0d47\u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d38\u0d39\u0d3e\u0d2f \u0d30\u0d47\u0d16\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02?",answer:"\u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d38\u0d47\u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d7d pdf \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d jpeg \u0d2b\u0d4b\u0d7c\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d7d \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d38\u0d4d\u0d15\u0d3e\u0d7b/\u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d02 \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d4b\u0d1f\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d02. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d2a\u0d4d\u0d30\u0d4b\u0d38\u0d38\u0d4d\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d36\u0d30\u0d3f\u0d2f\u0d3e\u0d2f \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d3e \u0d30\u0d47\u0d16 \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. \u0d2a\u0d3e\u0d38\u0d4d\u200c\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d, \u0d35\u0d3e\u0d1f\u0d15, \u0d2a\u0d4d\u0d30\u0d4b\u0d2a\u0d4d\u0d2a\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f \u0d09\u0d1f\u0d2e\u0d4d\u0d2a\u0d1f\u0d3f \u0d2a\u0d4b\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d1a\u0d3f\u0d32 \u0d21\u0d4b\u0d15\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d41\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d12\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d27\u0d3f\u0d15\u0d02 \u0d2a\u0d47\u0d1c\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d02 \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d."},{question:"\u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d38\u0d47\u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d3e\u0d26\u0d47\u0d36\u0d3f\u0d15 \u0d2d\u0d3e\u0d37 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d2e\u0d4b?",answer:"\u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d7d \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d7d \u0d35\u0d34\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d4d\u0d30\u0d3e\u0d26\u0d47\u0d36\u0d3f\u0d15 \u0d2d\u0d3e\u0d37 \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d3f\u0d32\u0d4d\u0d32."},{question:"\u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d38\u0d47\u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d1c\u0d28\u0d28\u0d24\u0d4d\u0d24\u0d40\u0d2f\u0d24\u0d3f \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d2e\u0d4b?",answer:"\u0d07\u0d32\u0d4d\u0d32, \u0d1c\u0d28\u0d28\u0d24\u0d4d\u0d24\u0d40\u0d2f\u0d24\u0d3f (DoB) \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f DoB \u0d2a\u0d4d\u0d30\u0d42\u0d2b\u0d4d \u0d21\u0d4b\u0d15\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02 \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15."},{question:"\u0d1e\u0d3e\u0d7b \u0d07\u0d24\u0d3f\u0d28\u0d15\u0d02 \u0d12\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d7d \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7d \u0d1c\u0d28\u0d28\u0d24\u0d4d\u0d24\u0d40\u0d2f\u0d24\u0d3f \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d4d. \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d24\u0d4d \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d4b / \u0d36\u0d30\u0d3f\u0d2f\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d4b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d2e\u0d4b?",answer:"\u0d07\u0d32\u0d4d\u0d32. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d1c\u0d28\u0d28\u0d24\u0d4d\u0d24\u0d40\u0d2f\u0d24\u0d3f (DoB) \u0d12\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d7d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d42. \u0d05\u0d38\u0d3e\u0d27\u0d3e\u0d30\u0d23\u0d2e\u0d3e\u0d2f \u0d38\u0d3e\u0d39\u0d1a\u0d30\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d \u0d1c\u0d28\u0d28\u0d24\u0d4d\u0d24\u0d40\u0d2f\u0d24\u0d3f (DoB) \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3e\u0d35\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3e\u0d23\u0d4d, \u0d07\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d7d 1947 \u0d0e\u0d28\u0d4d\u0d28 \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7d \u0d35\u0d3f\u0d33\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15."},{question:"\u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d  \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d17\u0d4d\u0d2f\u0d3e\u0d30\u0d7b\u0d4d\u0d31\u0d3f \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d23\u0d4d\u0d1f\u0d4b?",answer:"\u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d2f\u0d41\u0d1f\u0d46 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d09\u0d31\u0d2a\u0d4d\u0d2a\u0d41\u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32. \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d38\u0d47\u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d19\u0d4d\u0d19\u0d7e \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10\u0d2f\u0d41\u0d1f\u0d46 \u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d40\u0d15\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d2e\u0d42\u0d32\u0d4d\u0d2f\u0d28\u0d3f\u0d7c\u0d23\u0d4d\u0d23\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d35\u0d3f\u0d27\u0d47\u0d2f\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d02, \u0d2e\u0d42\u0d32\u0d4d\u0d2f\u0d28\u0d3f\u0d7c\u0d23\u0d4d\u0d23\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d \u0d36\u0d47\u0d37\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d2e\u0d3e\u0d31\u0d4d\u0d31 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02 \u0d2a\u0d4d\u0d30\u0d4b\u0d38\u0d38\u0d4d\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d02."},{question:"\u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d28\u0d37\u0d4d\u0d1f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d41/ \u0d06\u0d27\u0d3e\u0d31\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d0e\u0d7b\u0d31\u0d4b\u0d7e \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d15\u0d48\u0d35\u0d36\u0d2e\u0d3f\u0d32\u0d4d\u0d32. \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d02?",answer:"\u0d06\u0d27\u0d3e\u0d31\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d33\u0d4d\u0d33 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d28\u0d37\u0d4d\u0d1f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d4b \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d15\u0d48\u0d35\u0d36\u0d02 \u0d35\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d3e\u0d24\u0d4d\u0d24\u0d24\u0d4b \u0d06\u0d23\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d47\u0d30\u0d3f\u0d1f\u0d4d\u0d1f\u0d4d \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02 \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d02."},{question:"\u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d4d \u0d36\u0d47\u0d37\u0d02 \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d2e\u0d3e\u0d31\u0d41\u0d2e\u0d4b?",answer:"\u0d07\u0d32\u0d4d\u0d32, \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d4d \u0d36\u0d47\u0d37\u0d35\u0d41\u0d02 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d05\u0d24\u0d47\u0d2a\u0d1f\u0d3f \u0d28\u0d3f\u0d32\u0d28\u0d3f\u0d7d\u0d15\u0d4d\u0d15\u0d41\u0d02."},{question:"\u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d31\u0d26\u0d4d\u0d26\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d1e\u0d3e\u0d7b \u0d06\u0d17\u0d4d\u0d30\u0d39\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d24\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d2e\u0d4b?",answer:"\u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d \u0d2a\u0d4d\u0d30\u0d4b\u0d38\u0d38\u0d4d\u0d38\u0d3f\u0d02\u0d17\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d0e\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d35\u0d30\u0d46 \u0d12\u0d30\u0d41 \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d28\u0d4d myAadhaar \u0d21\u0d3e\u0d37\u0d4d\u200c\u0d2c\u0d4b\u0d7c\u0d21\u0d3f\u0d32\u0d46 '\u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28\u0d15\u0d7e' \u0d38\u0d4d\u200c\u0d2a\u0d46\u0d2f\u0d4d\u200c\u0d38\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d31\u0d26\u0d4d\u0d26\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02. \u0d31\u0d26\u0d4d\u0d26\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d3e\u0d7d, \u0d05\u0d1f\u0d1a\u0d4d\u0d1a \u0d24\u0d41\u0d15 21 \u0d26\u0d3f\u0d35\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d7d \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d46 \u0d28\u0d7d\u0d15\u0d41\u0d02."},{question:"\u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d0e\u0d32\u0d4d\u0d32\u0d3e \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28\u0d15\u0d33\u0d41\u0d02 \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d3e\u0d23\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02?",answer:"myAadhaar \u0d21\u0d3e\u0d37\u0d4d\u200c\u0d2c\u0d4b\u0d7c\u0d21\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33\u0d3f\u0d32\u0d46 '\u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28\u0d15\u0d7e' \u0d0e\u0d28\u0d4d\u0d28 \u0d38\u0d4d\u0d25\u0d32\u0d24\u0d4d\u0d24\u0d4d \u0d12\u0d30\u0d41 \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d28\u0d4d \u0d05\u0d35\u0d7b\u0d4d\u0d31\u0d46/\u0d05\u0d35\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28\u0d15\u0d7e \u0d15\u0d3e\u0d23\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02."},{question:"\u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d3f\u0d24\u0d3e\u0d35\u0d3f\u0d7b\u0d4d\u0d31\u0d46 / \u0d2d\u0d7c\u0d24\u0d4d\u0d24\u0d3e\u0d35\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d47\u0d30\u0d4d \u0d1a\u0d47\u0d7c\u0d15\u0d4d\u0d15\u0d3e\u0d02?",answer:"\u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d32\u0d46 \u0d35\u0d3f\u0d32\u0d3e\u0d38 \u0d2b\u0d40\u0d7d\u0d21\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d2d\u0d3e\u0d17\u0d2e\u0d3e\u0d23\u0d4d \u0d2c\u0d28\u0d4d\u0d27\u0d24\u0d4d\u0d24\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e. \u0d07\u0d24\u0d4d C/o (\u0d15\u0d46\u0d2f\u0d7c \u0d13\u0d2b\u0d4d) \u0d06\u0d2f\u0d3f \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d7b\u0d21\u0d47\u0d7c\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d4d. \u0d07\u0d24\u0d4d \u0d2a\u0d42\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d13\u0d2a\u0d4d\u0d37\u0d23\u0d32\u0d3e\u0d23\u0d4d."}],eaadhaarDownload:[{question:"\u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d \u0d07-\u0d06\u0d27\u0d3e\u0d7c?",answer:"\u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d21\u0d3f\u0d1c\u0d3f\u0d31\u0d4d\u0d31\u0d32\u0d3e\u0d2f\u0d3f \u0d12\u0d2a\u0d4d\u0d2a\u0d3f\u0d1f\u0d4d\u0d1f \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d3e\u0d38\u0d4d\u200c\u0d35\u0d47\u0d21\u0d4d \u0d2a\u0d30\u0d3f\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d24 \u0d07\u0d32\u0d15\u0d4d\u0d1f\u0d4d\u0d30\u0d4b\u0d23\u0d3f\u0d15\u0d4d \u0d2a\u0d15\u0d7c\u0d2a\u0d4d\u0d2a\u0d3e\u0d23\u0d4d \u0d07-\u0d06\u0d27\u0d3e\u0d7c."},{question:"\u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d2b\u0d3f\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d7d \u0d15\u0d4b\u0d2a\u0d4d\u0d2a\u0d3f \u0d2a\u0d4b\u0d32\u0d46 \u0d24\u0d28\u0d4d\u0d28\u0d46 \u0d07-\u0d06\u0d27\u0d3e\u0d31\u0d41\u0d02 \u0d38\u0d3e\u0d27\u0d41\u0d24\u0d2f\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d3e\u0d23\u0d4b?",answer:"\u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d3f\u0d2f\u0d2e\u0d02 \u0d05\u0d28\u0d41\u0d38\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d, \u0d0e\u0d32\u0d4d\u0d32\u0d3e \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d2b\u0d3f\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d7d \u0d15\u0d4b\u0d2a\u0d4d\u0d2a\u0d3f \u0d2a\u0d4b\u0d32\u0d46 \u0d07-\u0d06\u0d27\u0d3e\u0d31\u0d41\u0d02 \u0d12\u0d30\u0d41\u0d2a\u0d4b\u0d32\u0d46 \u0d38\u0d3e\u0d27\u0d41\u0d24\u0d2f\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d3e\u0d23\u0d4d. \u0d07 \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d38\u0d3e\u0d27\u0d41\u0d24\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f, \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f UIDAI \u0d38\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d32\u0d7c \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15- https://uidai.gov.in/images/ uidai_om_on_e_aadhaar_validity.pdf"},{question:"\u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d \u0d2e\u0d3e\u0d38\u0d4d\u200c\u0d15\u0d4d\u0d21\u0d4d \u0d06\u0d27\u0d3e\u0d7c?",answer:"\u0d2e\u0d3e\u0d38\u0d4d\u200c\u0d15\u0d4d\u0d21\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d06\u0d26\u0d4d\u0d2f 8 \u0d05\u0d15\u0d4d\u0d15\u0d19\u0d4d\u0d19\u0d7e \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f 'xxxx-xxxx' \u0d0e\u0d28\u0d4d\u0d28\u0d4d \u0d38\u0d42\u0d1a\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d05\u0d24\u0d47\u0d38\u0d2e\u0d2f\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d05\u0d35\u0d38\u0d3e\u0d28 4 \u0d05\u0d15\u0d4d\u0d15\u0d19\u0d4d\u0d19\u0d7e \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 \u0d26\u0d43\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d15\u0d42."},{question:"\u0d07-\u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d32\u0d46 \u0d21\u0d3f\u0d1c\u0d3f\u0d31\u0d4d\u0d31\u0d7d \u0d38\u0d3f\u0d17\u0d4d\u0d28\u0d47\u0d1a\u0d4d\u0d1a\u0d31\u0d41\u0d15\u0d7e \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d38\u0d3e\u0d27\u0d42\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02?",answer:"\u0d06\u0d27\u0d3e\u0d7c YouTube \u0d1a\u0d3e\u0d28\u0d7d \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d https://youtu.be/aVNfUNIccZs?si=ByW1O6BIPMwc0seL \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d7d \u0d1f\u0d4d\u0d2f\u0d42\u0d1f\u0d4d\u0d1f\u0d4b\u0d31\u0d3f\u0d2f\u0d7d \u0d32\u0d3f\u0d19\u0d4d\u0d15\u0d4d \u0d15\u0d3e\u0d23\u0d41\u0d15"},{question:"\u0d07-\u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d3e\u0d38\u0d4d\u200c\u0d35\u0d47\u0d21\u0d4d \u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d?",answer:"\u0d2a\u0d47\u0d30\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d06\u0d26\u0d4d\u0d2f 4 \u0d15\u0d4d\u0d2f\u0d3e\u0d2a\u0d3f\u0d31\u0d4d\u0d31\u0d7d  \u0d05\u0d15\u0d4d\u0d37\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d1c\u0d28\u0d28 \u0d35\u0d7c\u0d37\u0d35\u0d41\u0d02 (YYYY) \u0d1a\u0d47\u0d7c\u0d28\u0d4d\u0d28\u0d24\u0d3e\u0d23\u0d4d \u0d07 \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d3e\u0d38\u0d4d\u200c\u0d35\u0d47\u0d21\u0d4d.\n\u0d09\u0d26\u0d3e\u0d39\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d:\n\u0d09\u0d26\u0d3e\u0d39\u0d30\u0d23\u0d02 1\n\u0d2a\u0d47\u0d30\u0d4d: \u0d38\u0d41\u0d30\u0d47\u0d37\u0d4d \u0d15\u0d41\u0d2e\u0d3e\u0d7c\n\u0d1c\u0d28\u0d3f\u0d1a\u0d4d\u0d1a \u0d35\u0d7c\u0d37\u0d02: 1990\n\u0d2a\u0d3e\u0d38\u0d4d\u200c\u0d35\u0d47\u0d21\u0d4d: SURE1990\n\u0d09\u0d26\u0d3e\u0d39\u0d30\u0d23\u0d02 2\n\u0d2a\u0d47\u0d30\u0d4d: \u0d38\u0d3e\u0d2f\u0d3f \u0d15\u0d41\u0d2e\u0d3e\u0d7c\n\u0d1c\u0d28\u0d3f\u0d1a\u0d4d\u0d1a \u0d35\u0d7c\u0d37\u0d02: 1990\n\u0d2a\u0d3e\u0d38\u0d4d\u200c\u0d35\u0d47\u0d21\u0d4d: SAIK1990\n\u0d09\u0d26\u0d3e\u0d39\u0d30\u0d23\u0d02 3\n\u0d2a\u0d47\u0d30\u0d4d: \u0d2a\u0d3f.\u0d15\u0d41\u0d2e\u0d3e\u0d7c\n\u0d1c\u0d28\u0d3f\u0d1a\u0d4d\u0d1a \u0d35\u0d7c\u0d37\u0d02: 1990\n\u0d2a\u0d3e\u0d38\u0d4d\u200c\u0d35\u0d47\u0d21\u0d4d: P.KU1990\n\u0d09\u0d26\u0d3e\u0d39\u0d30\u0d23\u0d02 4\n\u0d2a\u0d47\u0d30\u0d4d: RIA\n\u0d1c\u0d28\u0d3f\u0d1a\u0d4d\u0d1a \u0d35\u0d7c\u0d37\u0d02: 1990\n\u0d2a\u0d3e\u0d38\u0d4d\u200c\u0d35\u0d47\u0d21\u0d4d: RIA1990"},{question:"\u0d07-\u0d06\u0d27\u0d3e\u0d7c \u0d13\u0d2a\u0d4d\u0d2a\u0d7a  \u0d1a\u0d46\u0d2f\u0d41\u0d35\u0d3e\u0d7b \u0d0f\u0d24\u0d41 \u0d38\u0d4b\u0d2b\u0d4d\u0d31\u0d4d\u0d31\u0d4d\u200c\u0d35\u0d46\u0d2f\u0d7c \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d?",answer:"\u0d07-\u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d3e\u0d23\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d28\u0d3f\u0d35\u0d3e\u0d38\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d  '\u0d05\u0d21\u0d4b\u0d2c\u0d4d \u0d31\u0d40\u0d21\u0d7c' \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d24\u0d4d\u0d24\u0d3f\u0d7d '\u0d05\u0d21\u0d4b\u0d2c\u0d4d \u0d31\u0d40\u0d21\u0d7c' \u0d07\u0d7b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d7e \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d4d. \u0d38\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d05\u0d21\u0d4b\u0d2c\u0d4d \u0d31\u0d40\u0d21\u0d7c \u0d07\u0d7b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d7e \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d35\u0d3e\u0d7b\r\n\u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15 https://get.adobe.com/reader/"},{question:"\u0d12\u0d30\u0d41 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d07-\u0d06\u0d27\u0d3e\u0d7c \u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02?",answer:"\u0d12\u0d30\u0d41 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d42\u0d28\u0d4d\u0d28\u0d4d \u0d35\u0d34\u0d3f\u0d15\u0d33\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d07-\u0d06\u0d27\u0d3e\u0d7c \u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02.\n\u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d:\n\u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d:\n\u0d35\u0d3f\u0d10\u0d21\u0d3f  \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d:\n\u0d07 \u0d06\u0d27\u0d3e\u0d7c \u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d1f\u0d3f\u0d2a\u0d3f \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7d \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02."}],bookAnAppointment:[{question:"UIDAI-\u0d2f\u0d3f\u0d32\u0d46 \u0d2a\u0d30\u0d3e\u0d24\u0d3f \u0d2a\u0d30\u0d3f\u0d39\u0d3e\u0d30 \u0d1a\u0d3e\u0d28\u0d32\u0d41\u0d15\u0d7e \u0d0f\u0d24\u0d4a\u0d15\u0d4d\u0d15\u0d46\u0d2f\u0d3e\u0d23\u0d4d?",answer:"'\u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d2a\u0d30\u0d3e\u0d24\u0d3f \u0d2a\u0d30\u0d3f\u0d39\u0d3e\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d2b\u0d4b\u0d7a, \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d, \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d, \u0d15\u0d24\u0d4d\u0d24\u0d4d/\u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d, \u0d35\u0d46\u0d2c\u0d4d \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d7d, \u0d35\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d07\u0d7b, \u0d38\u0d4b\u0d37\u0d4d\u0d2f\u0d7d \u0d2e\u0d40\u0d21\u0d3f\u0d2f \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d12\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d27\u0d3f\u0d15\u0d02 \u0d1a\u0d3e\u0d28\u0d32\u0d41\u0d15\u0d7e \u0d35\u0d34\u0d3f \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10\u0d2f\u0d3f\u0d7d \u0d0e\u0d24\u0d4d\u0d24\u0d3f\u0d1a\u0d4d\u0d1a\u0d47\u0d30\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02.\n\u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d1a\u0d3e\u0d28\u0d32\u0d41\u0d15\u0d33\u0d46\u0d15\u0d4d\u0d15\u0d41\u0d31\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d36\u0d26\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d24\u0d3e\u0d34\u0d46 \u0d15\u0d4a\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41:\n1. \u0d2b\u0d4b\u0d7a \u0d15\u0d4b\u0d7e (\u0d1f\u0d4b\u0d7e \u0d2b\u0d4d\u0d30\u0d40 \u0d28\u0d2e\u0d4d\u0d2a\u0d7c) -\n\u0d06\u0d27\u0d3e\u0d31\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d06\u0d36\u0d19\u0d4d\u0d15\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d UIDAI \u0d1f\u0d4b\u0d7e \u0d2b\u0d4d\u0d30\u0d40 \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7d (1947) \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d3e\u0d02. UIDAI \u0d15\u0d4b\u0d7a\u0d1f\u0d3e\u0d15\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d46\u0d7b\u0d4d\u0d31\u0d31\u0d3f\u0d7d \u0d12\u0d30\u0d41 \u0d38\u0d4d\u0d35\u0d2f\u0d02 \u0d38\u0d47\u0d35\u0d28 IVRS (\u0d07\u0d7b\u0d4d\u0d31\u0d31\u0d3e\u0d15\u0d4d\u0d1f\u0d40\u0d35\u0d4d \u0d35\u0d4b\u0d2f\u0d4d\u200c\u0d38\u0d4d \u0d31\u0d46\u0d38\u0d4d\u200c\u0d2a\u0d4b\u0d7a\u0d38\u0d4d \u0d38\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d02), \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d17\u0d24 \u0d38\u0d2a\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d \u0d0e\u0d15\u0d4d\u200c\u0d38\u0d3f\u0d15\u0d4d\u0d2f\u0d42\u0d1f\u0d4d\u0d1f\u0d40\u0d35\u0d4d \u0d05\u0d27\u0d3f\u0d37\u0d4d\u200c\u0d20\u0d3f\u0d24 \u0d38\u0d39\u0d3e\u0d2f\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d0e\u0d33\u0d41\u0d2a\u0d4d\u0d2a\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d28\u0d41\u0d38\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d06\u0d36\u0d2f\u0d35\u0d3f\u0d28\u0d3f\u0d2e\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d24\u0d3e\u0d34\u0d46\u0d2a\u0d4d\u0d2a\u0d31\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d0f\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d2d\u0d3e\u0d37 \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3e\u0d02.1. \u0d39\u0d3f\u0d28\u0d4d\u0d26\u0d3f\n5. \u0d15\u0d28\u0d4d\u0d28\u0d21\n9. \u0d17\u0d41\u0d1c\u0d31\u0d3e\u0d24\u0d4d\u0d24\u0d3f\n2. \u0d07\u0d02\u0d17\u0d4d\u0d32\u0d40\u0d37\u0d4d\n6. \u0d2e\u0d32\u0d2f\u0d3e\u0d33\u0d02\n10. \u0d2e\u0d31\u0d3e\u0d24\u0d4d\u0d24\u0d3f\n3. \u0d24\u0d46\u0d32\u0d41\u0d19\u0d4d\u0d15\u0d4d\n7. \u0d05\u0d38\u0d2e\u0d40\u0d38\u0d4d\n11. \u0d2a\u0d1e\u0d4d\u0d1a\u0d3e\u0d2c\u0d3f\n4. \u0d24\u0d2e\u0d3f\u0d34\u0d4d\n8. \u0d2c\u0d02\u0d17\u0d3e\u0d33\u0d3f\n12. \u0d12\u0d21\u0d3f\u0d2f\n\u0d38\u0d2e\u0d2f\u0d15\u0d4d\u0d30\u0d2e\u0d02:a) IVRS \u0d35\u0d34\u0d3f \u0d38\u0d4d\u0d35\u0d2f\u0d02 \u0d38\u0d47\u0d35\u0d28\u0d02 \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d7d: IVRS \u0d35\u0d34\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e 24X7 \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d38\u0d46\u0d7d\u0d2b\u0d4d \u0d38\u0d7c\u0d35\u0d40\u0d38\u0d4d \u0d2e\u0d4b\u0d21\u0d3f\u0d7d \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02.b) \u0d38\u0d2a\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d \u0d0e\u0d15\u0d4d\u0d38\u0d3f\u0d15\u0d4d\u0d2f\u0d42\u0d1f\u0d4d\u0d1f\u0d40\u0d35\u0d4d \u0d38\u0d39\u0d3e\u0d2f\u0d02: \u0d08 \u0d38\u0d47\u0d35\u0d28\u0d02 \u0d24\u0d3f\u0d19\u0d4d\u0d15\u0d7e \u0d2e\u0d41\u0d24\u0d7d \u0d36\u0d28\u0d3f \u0d35\u0d30\u0d46: 7 AM \u0d2e\u0d41\u0d24\u0d7d 11 PM \u0d35\u0d30\u0d46, \u0d1e\u0d3e\u0d2f\u0d31\u0d3e\u0d34\u0d4d\u0d1a: 8 AM \u0d2e\u0d41\u0d24\u0d7d 5 PM \u0d35\u0d30\u0d46.\u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d05\u0d02\u0d17\u0d40\u0d15\u0d30\u0d3f\u0d1a\u0d4d\u0d1a \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d7b\u0d21\u0d47\u0d7c\u0d21\u0d4d \u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e \u0d2e\u0d41\u0d16\u0d47\u0d28 \u0d15\u0d4b\u0d7a\u0d1f\u0d3e\u0d15\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d46\u0d7b\u0d4d\u0d31\u0d7c \u0d0e\u0d15\u0d4d\u0d38\u0d3f\u0d15\u0d4d\u0d2f\u0d42\u0d1f\u0d4d\u0d1f\u0d40\u0d35\u0d3e\u0d23\u0d4d \u0d2a\u0d4a\u0d24\u0d41\u0d35\u0d3e\u0d2f \u0d1a\u0d4b\u0d26\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e \u0d2a\u0d30\u0d3f\u0d39\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d, \u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d15\u0d7e \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10\u0d2f\u0d41\u0d1f\u0d46 \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d21\u0d3f\u0d35\u0d3f\u0d37\u0d28\u0d41\u0d15\u0d7e/\u0d31\u0d40\u0d1c\u0d3f\u0d2f\u0d23\u0d7d \u0d13\u0d2b\u0d40\u0d38\u0d41\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d24\u0d24\u0d4d\u0d38\u0d2e\u0d2f \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d05\u0d38\u0d48\u0d7b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d08 \u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d15\u0d7e \u0d2b\u0d32\u0d2a\u0d4d\u0d30\u0d26\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d30\u0d3f\u0d39\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d06\u0d36\u0d2f\u0d35\u0d3f\u0d28\u0d3f\u0d2e\u0d2f\u0d02 \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10\u0d2f\u0d41\u0d1f\u0d46 \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d21\u0d3f\u0d35\u0d3f\u0d37\u0d7b/\u0d31\u0d40\u0d1c\u0d3f\u0d2f\u0d23\u0d7d \u0d13\u0d2b\u0d40\u0d38\u0d41\u0d15\u0d33\u0d3f\u0d7d \u0d06\u0d28\u0d4d\u0d24\u0d30\u0d3f\u0d15\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.2. \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d (\u0d06\u0d27\u0d3e\u0d7c \u0d2e\u0d3f\u0d24\u0d4d\u0d30) - UIDAI \u0d2f\u0d41\u0d1f\u0d46 \u0d14\u0d26\u0d4d\u0d2f\u0d4b\u0d17\u0d3f\u0d15 \u0d35\u0d46\u0d2c\u0d4d\u200c\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d3f\u0d7d \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f UIDAI \u0d1a\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u200c\u0d2c\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d38\u0d47\u0d35\u0d28\u0d2e\u0d3e\u0d2f '\u0d06\u0d27\u0d3e\u0d7c \u0d2e\u0d3f\u0d24\u0d4d\u0d30' \u0d35\u0d34\u0d3f \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d06\u0d27\u0d3e\u0d31\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d06\u0d36\u0d19\u0d4d\u0d15\u0d15\u0d7e \u0d09\u0d28\u0d4d\u0d28\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02.\n3. \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d35\u0d46\u0d2c\u0d4d \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d7d - \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2f\u0d25\u0d3e\u0d15\u0d4d\u0d30\u0d2e\u0d02 \u0d2a\u0d30\u0d3e\u0d24\u0d3f, \u0d2b\u0d40\u0d21\u0d4d\u200c\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d4d & \u0d1a\u0d46\u0d15\u0d4d\u0d15\u0d4d \u0d17\u0d4d\u0d30\u0d40\u0d35\u0d7b\u0d38\u0d4d / \u0d2b\u0d40\u0d21\u0d4d\u200c\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d31\u0d4d\u0d31\u0d38\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d15\u0d40\u0d34\u0d3f\u0d7d \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d35\u0d46\u0d2c\u0d4d\u200c\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d3f\u0d7d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d28\u0d3f\u0d32 \u0d30\u0d47\u0d16\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d3e\u0d28\u0d41\u0d02 \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02.4. \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d - \u0d06\u0d27\u0d3e\u0d31\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d0f\u0d24\u0d4d \u0d38\u0d02\u0d36\u0d2f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d help@uidai.gov.in \u0d0e\u0d28\u0d4d\u0d28 \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d32\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d \u0d05\u0d2f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d3e\u0d35\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3e\u0d23\u0d4d.\n5. \u0d31\u0d40\u0d1c\u0d3f\u0d2f\u0d23\u0d7d \u0d13\u0d2b\u0d40\u0d38\u0d41\u0d15\u0d33\u0d3f\u0d7d \u0d35\u0d3e\u0d15\u0d4d\u0d15\u0d4d-\u0d07\u0d7b: \u0d06\u0d27\u0d3e\u0d31\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d38\u0d02\u0d36\u0d2f\u0d19\u0d4d\u0d19\u0d7e \u0d2a\u0d30\u0d3f\u0d39\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4b \u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4b \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d28\u0d41\u0d38\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d05\u0d24\u0d3e\u0d24\u0d4d \u0d31\u0d40\u0d1c\u0d3f\u0d2f\u0d23\u0d7d \u0d13\u0d2b\u0d40\u0d38\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d47\u0d30\u0d3f\u0d1f\u0d4d\u0d1f\u0d4d \u0d2a\u0d4b\u0d15\u0d3e\u0d02.6. \u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d/\u0d15\u0d24\u0d4d\u0d24\u0d4d: \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d15\u0d7e \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d0e\u0d1a\u0d4d\u0d1a\u0d4d\u0d12\u0d2f\u0d3f\u0d32\u0d4b \u0d31\u0d40\u0d1c\u0d3f\u0d2f\u0d23\u0d7d \u0d13\u0d2b\u0d40\u0d38\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d4b \u0d24\u0d2a\u0d3e\u0d7d \u0d2e\u0d41\u0d16\u0d47\u0d28 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d15\u0d48\u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d \u0d05\u0d2a\u0d47\u0d15\u0d4d\u0d37 \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02. \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d31\u0d40\u0d1c\u0d3f\u0d2f\u0d23\u0d7d \u0d13\u0d2b\u0d40\u0d38\u0d4d/ \u0d21\u0d3f\u0d35\u0d3f\u0d37\u0d7b \u0d2a\u0d30\u0d3e\u0d24\u0d3f \u0d2a\u0d30\u0d3f\u0d39\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d28\u0d1f\u0d2a\u0d1f\u0d3f\u0d15\u0d7e \u0d38\u0d4d\u0d35\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02.\n7. \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d3e \u0d17\u0d35\u0d7a\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d2c\u0d4d\u0d32\u0d3f\u0d15\u0d4d \u0d17\u0d4d\u0d30\u0d40\u0d35\u0d7b\u0d38\u0d4d \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d7d (CPGRAMS): \u0d38\u0d46\u0d7b\u0d1f\u0d4d\u0d30\u0d32\u0d48\u0d38\u0d4d\u0d21\u0d4d \u0d2a\u0d2c\u0d4d\u0d32\u0d3f\u0d15\u0d4d \u0d17\u0d4d\u0d30\u0d40\u0d35\u0d7b\u0d38\u0d4d \u0d31\u0d3f\u0d21\u0d4d\u0d30\u0d38\u0d4d \u0d06\u0d7b\u0d21\u0d4d \u0d2e\u0d4b\u0d23\u0d3f\u0d31\u0d4d\u0d31\u0d31\u0d3f\u0d02\u0d17\u0d4d \u0d38\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d02 (CPGRAMS) \u0d35\u0d34\u0d3f UIDAI-\u0d7d \u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d35\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3e\u0d23\u0d4d.8. \u0d38\u0d4b\u0d37\u0d4d\u0d2f\u0d7d \u0d2e\u0d40\u0d21\u0d3f\u0d2f: \u0d1f\u0d4d\u0d35\u0d3f\u0d31\u0d4d\u0d31\u0d7c, \u0d2b\u0d47\u0d38\u0d4d\u0d2c\u0d41\u0d15\u0d4d\u0d15\u0d4d, \u0d2f\u0d42 \u0d1f\u0d4d\u0d2f\u0d42\u0d2c\u0d4d, \u0d07\u0d7b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d17\u0d4d\u0d30\u0d3e\u0d02 \u0d24\u0d41\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f \u0d12\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d27\u0d3f\u0d15\u0d02 \u0d38\u0d4b\u0d37\u0d4d\u0d2f\u0d7d \u0d2e\u0d40\u0d21\u0d3f\u0d2f \u0d2a\u0d4d\u0d32\u0d3e\u0d31\u0d4d\u0d31\u0d4d\u200c\u0d2b\u0d4b\u0d2e\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d15\u0d7e \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02. \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d06\u0d36\u0d19\u0d4d\u0d15/\u0d2a\u0d30\u0d3e\u0d24\u0d3f\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d12\u0d30\u0d41 \u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d UIDAI \u0d1f\u0d3e\u0d17\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u200c\u0d24\u0d4d \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d35\u0d3f\u0d35\u0d3f\u0d27 \u0d38\u0d4b\u0d37\u0d4d\u0d2f\u0d7d \u0d2e\u0d40\u0d21\u0d3f\u0d2f \u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d40\u0d2e\u0d41\u0d15\u0d33\u0d3f\u0d7d \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23\u0d3e \u0d2a\u0d47\u0d1c\u0d4d DM \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02."},{question:"\u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d38\u0d47\u0d35\u0d28 \u0d28\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d7e \u0d35\u0d4d\u0d2f\u0d24\u0d4d\u0d2f\u0d38\u0d4d\u0d24\u0d2e\u0d3e\u0d23\u0d4b?",answer:"\u0d07\u0d32\u0d4d\u0d32, \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d46 \u0d30\u0d3e\u0d1c\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d46 \u0d0e\u0d32\u0d4d\u0d32\u0d3e \u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d41\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d28\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d7e \u0d12\u0d28\u0d4d\u0d28\u0d41\u0d24\u0d28\u0d4d\u0d28\u0d46\u0d2f\u0d3e\u0d23\u0d4d.\n\u0d28\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d31\u0d2b\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15: \u0d06\u0d27\u0d3e\u0d7c \u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d & \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d28\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d7e"},{question:"\u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d05\u0d2a\u0d4d\u0d2a\u0d4b\u0d2f\u0d3f\u0d7b\u0d4d\u0d31\u0d4d\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d41\u0d02 \u0d37\u0d46\u0d21\u0d4d\u0d2f\u0d42\u0d7e \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d4b / \u0d31\u0d26\u0d4d\u0d26\u0d3e\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d4b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d2e\u0d4b?",answer:"\u0d05\u0d24\u0d46,  \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c/ \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d \u0d10\u0d21\u0d3f (\u0d28\u0d47\u0d30\u0d24\u0d4d\u0d24\u0d46 \u0d28\u0d7d\u0d15\u0d3f\u0d2f\u0d24\u0d4d \u0d2a\u0d4b\u0d32\u0d46) \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d05\u0d2a\u0d4d\u0d2a\u0d4b\u0d2f\u0d3f\u0d7b\u0d4d\u0d31\u0d4d\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d32\u0d3f\u0d7d \u0d32\u0d4b\u0d17\u0d3f\u0d7b \u0d1a\u0d46\u0d2f\u0d4d\u200c\u0d24\u0d4d 24 \u0d2e\u0d23\u0d3f\u0d15\u0d4d\u0d15\u0d42\u0d31\u0d3f\u0d28\u0d4d \u0d2e\u0d41\u0d2e\u0d4d\u0d2a\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2a\u0d4d\u0d2a\u0d4b\u0d2f\u0d3f\u0d7b\u0d4d\u0d31\u0d4d\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d41\u0d02 \u0d37\u0d46\u0d21\u0d4d\u0d2f\u0d42\u0d7e \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02."},{question:"\u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d28\u0d4d\u0d24\u0d4d \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02?",answer:"\u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d4d\u0d24\u0d30\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41\n\u0d05\u0d24\u0d41\u0d2a\u0d47\u0d3e\u0d32\u0d46\n1. \u0d0e\u0d32\u0d4d\u0d32\u0d3e \u0d2a\u0d4d\u0d30\u0d3e\u0d2f\u0d15\u0d4d\u0d15\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d.\n2. \u0d0f\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d1c\u0d28\u0d38\u0d02\u0d16\u0d4d\u0d2f\u0d3e \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d (\u0d2a\u0d47\u0d30\u0d4d, \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02, \u0d32\u0d3f\u0d02\u0d17\u0d2d\u0d47\u0d26\u0d02, \u0d1c\u0d28\u0d28\u0d24\u0d4d\u0d24\u0d40\u0d2f\u0d24\u0d3f, \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c, \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d \u0d10\u0d21\u0d3f).\n3. \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d (\u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b, \u0d35\u0d3f\u0d30\u0d32\u0d1f\u0d2f\u0d3e\u0d33\u0d02, \u0d10\u0d31\u0d3f\u0d38\u0d4d \u0d38\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d15\u0d7e) .\n4. \u0d15\u0d41\u0d1f\u0d4d\u0d1f\u0d3f\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3f\u0d7c\u0d2c\u0d28\u0d4d\u0d27\u0d3f\u0d24 \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d (5 \u0d35\u0d2f\u0d38\u0d41\u0d02 15 \u0d35\u0d2f\u0d38\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d3e\u0d2f\u0d2e\u0d41\u0d33\u0d4d\u0d33\u0d35\u0d7c).\n5.\u0d21\u0d4b\u0d15\u0d4d\u0d2f\u0d41\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d (POI, POA) .\n6.\u0d06\u0d27\u0d3e\u0d7c \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3f \u0d2a\u0d4d\u0d30\u0d3f\u0d7b\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15."},{question:"UIDAI ASK-\u0d15\u0d33\u0d41\u0d1f\u0d46 (\u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e) \u0d38\u0d2e\u0d2f\u0d2e\u0d46\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d?",answer:"\u0d26\u0d47\u0d36\u0d40\u0d2f/\u0d2a\u0d4d\u0d30\u0d3e\u0d26\u0d47\u0d36\u0d3f\u0d15 \u0d05\u0d35\u0d27\u0d3f\u0d15\u0d7e \u0d12\u0d34\u0d3f\u0d15\u0d46 \u0d06\u0d34\u0d4d\u0d1a\u0d2f\u0d3f\u0d32\u0d46 7 \u0d26\u0d3f\u0d35\u0d38\u0d35\u0d41\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d24\u0d41\u0d31\u0d28\u0d4d\u0d28\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02. \u0d38\u0d3e\u0d27\u0d3e\u0d30\u0d23\u0d2f\u0d3e\u0d2f\u0d3f \u0d07\u0d24\u0d4d 9:30 AM \u0d2e\u0d41\u0d24\u0d7d 5:30 PM (IST) \u0d35\u0d30\u0d46 \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02.\nUIDAI ASK-\u0d15\u0d7e \u0d12\u0d34\u0d3f\u0d15\u0d46\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d06\u0d27\u0d3e\u0d7c \u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d38\u0d46\u0d7b\u0d4d\u0d31\u0d31\u0d41\u0d15\u0d7e \u0d05\u0d24\u0d24\u0d4d \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3e\u0d7c\u0d2e\u0d3e\u0d7c \u0d28\u0d3f\u0d7c\u0d35\u0d1a\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d38\u0d2e\u0d2f\u0d15\u0d4d\u0d30\u0d2e\u0d02 \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d1f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d06\u0d17\u0d4d\u0d30\u0d39\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d/ \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d38\u0d46\u0d7b\u0d4d\u0d31\u0d31\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d3e\u0d35\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3e\u0d23\u0d4d."},{question:"\u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02 (ASK)?",answer:"'\u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02' \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d ASK, \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d0e\u0d32\u0d4d\u0d32\u0d3e \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d0f\u0d15\u0d1c\u0d3e\u0d32\u0d15 \u0d32\u0d15\u0d4d\u0d37\u0d4d\u0d2f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d23\u0d4d. \u0d05\u0d24\u0d4d\u0d2f\u0d3e\u0d27\u0d41\u0d28\u0d3f\u0d15 \u0d2a\u0d30\u0d3f\u0d24\u0d38\u0d4d\u0d25\u0d3f\u0d24\u0d3f\u0d2f\u0d3f\u0d7d \u0d24\u0d3e\u0d2e\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d35\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d24 \u0d06\u0d27\u0d3e\u0d7c \u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d41\u0d02 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 ASK \u0d35\u0d3e\u0d17\u0d4d\u0d26\u0d3e\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02 \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d41\u0d16\u0d2a\u0d4d\u0d30\u0d26\u0d2e\u0d3e\u0d2f \u0d0e\u0d2f\u0d7c \u0d15\u0d23\u0d4d\u0d1f\u0d40\u0d37\u0d7b\u0d21\u0d4d \u0d05\u0d28\u0d4d\u0d24\u0d30\u0d40\u0d15\u0d4d\u0d37\u0d02 \u0d2a\u0d4d\u0d30\u0d26\u0d3e\u0d28\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d0e\u0d32\u0d4d\u0d32\u0d3e ASK \u0d09\u0d02 \u0d35\u0d40\u0d7d\u0d1a\u0d46\u0d2f\u0d7c \u0d38\u0d57\u0d39\u0d43\u0d26\u0d2e\u0d3e\u0d23\u0d4d \u0d15\u0d42\u0d1f\u0d3e\u0d24\u0d46 \u0d2a\u0d4d\u0d30\u0d3e\u0d2f\u0d2e\u0d3e\u0d2f\u0d35\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d24\u0d4d\u0d2f\u0d47\u0d15 \u0d15\u0d34\u0d3f\u0d35\u0d41\u0d33\u0d4d\u0d33\u0d35\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d02 \u0d38\u0d47\u0d35\u0d28\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2a\u0d4d\u0d30\u0d24\u0d4d\u0d2f\u0d47\u0d15 \u0d35\u0d4d\u0d2f\u0d35\u0d38\u0d4d\u0d25\u0d15\u0d7e \u0d09\u0d23\u0d4d\u0d1f\u0d4d. ASK-\u0d15\u0d33\u0d46\u0d15\u0d4d\u0d15\u0d41\u0d31\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d42\u0d1f\u0d41\u0d24\u0d7d \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d: uidai.gov.in \u0d35\u0d46\u0d2c\u0d4d\u200c\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d4d."},{question:"UIDAI ASK-\u0d15\u0d33\u0d41\u0d1f\u0d46 (\u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d19\u0d4d\u0d19\u0d7e) \u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d35\u0d3f\u0d1f\u0d46 \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02?",answer:"\u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d15\u0d4d\u0d37\u0d2e\u0d2e\u0d3e\u0d2f \u0d0e\u0d32\u0d4d\u0d32\u0d3e ASK-\u0d15\u0d33\u0d41\u0d1f\u0d46\u0d2f\u0d41\u0d02 \u0d12\u0d30\u0d41 \u0d0f\u0d15\u0d40\u0d15\u0d43\u0d24 \u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d07\u0d35\u0d3f\u0d1f\u0d46 \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d: \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30 \u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d\n\u0d2c\u0d3e\u0d19\u0d4d\u0d15\u0d41\u0d15\u0d7e, \u0d2a\u0d4b\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d13\u0d2b\u0d40\u0d38\u0d41\u0d15\u0d7e, CSC, BSNL, \u0d38\u0d02\u0d38\u0d4d\u0d25\u0d3e\u0d28 \u0d17\u0d35\u0d7a\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d07\u0d24\u0d3f\u0d28\u0d15\u0d02 \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28 \u0d06\u0d27\u0d3e\u0d7c \u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d4d \u0d38\u0d46\u0d7b\u0d4d\u0d31\u0d31\u0d41\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d41\u0d31\u0d2e\u0d47 \u0d08 ASK-\u0d15\u0d7e \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d."}],checkEnrolmentUpdateStatus:[{question:"\u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d38\u0d47\u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d28\u0d4d\u0d24\u0d4d \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02?",answer:"\u0d08 \u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d32\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d35\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d35\u0d41\u0d02 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 \u0d15\u0d34\u0d3f\u0d2f\u0d42. \u0d2e\u0d31\u0d4d\u0d31\u0d47\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d3e\u0d2f\u0d3f, \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d33\u0d4d\u0d33 \u0d06\u0d27\u0d3e\u0d7c \u0d38\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d02 \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15."}],checkAadhaarValidity:[{question:"\u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d46\u0d31\u0d4d\u0d31\u0d31\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d35\u0d4d\u0d2f\u0d24\u0d4d\u0d2f\u0d3e\u0d38\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41?",answer:"\u0d0e\u0d7b\u0d31\u0d4b\u0d7e\u0d2e\u0d46\u0d7b\u0d4d\u0d31\u0d3f\u0d28\u0d4d \u0d36\u0d47\u0d37\u0d02 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d24\u0d3f\u0d28\u0d4d \u0d36\u0d47\u0d37\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d32\u0d3e\u0d2e\u0d3f\u0d28\u0d47\u0d31\u0d4d\u0d31\u0d21\u0d4d \u0d2a\u0d47\u0d2a\u0d4d\u0d2a\u0d7c \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d30\u0d47\u0d16\u0d2f\u0d3e\u0d23\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d46\u0d31\u0d4d\u0d31\u0d7c. \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d41\u0d02 \u0d12\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d27\u0d3f\u0d15\u0d02 \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3e \u0d2b\u0d40\u0d1a\u0d4d\u0d1a\u0d31\u0d41\u0d15\u0d33\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d41\u0d02 \u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d41\u0d2a\u0d4b\u0d15\u0d3e\u0d7b \u0d0e\u0d33\u0d41\u0d2a\u0d4d\u0d2a\u0d2e\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d41\u0d2e\u0d3e\u0d2f \u0d15\u0d3e\u0d7c\u0d21\u0d3e\u0d23\u0d4d. \u0d06\u0d27\u0d3e\u0d7c \u0d2a\u0d3f\u0d35\u0d3f\u0d38\u0d3f \u0d15\u0d3e\u0d7c\u0d21\u0d3f\u0d28\u0d4d \u0d24\u0d41\u0d32\u0d4d\u0d2f \u0d38\u0d3e\u0d27\u0d41\u0d24\u0d2f\u0d41\u0d23\u0d4d\u0d1f\u0d4d."}],lockUnlockAadhaar:[{question:"\u0d05\u0d38\u0d3e\u0d27\u0d41\u0d35\u0d3e\u0d2f \u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d28\u0d3f\u0d30\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f\u0d41. \u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d3f\u0d24\u0d3f\u0d28\u0d7c\u0d24\u0d4d\u0d25\u0d02?",answer:"\u0d13\u0d7a\u0d32\u0d48\u0d7b \u0d35\u0d3f\u0d32\u0d3e\u0d38\u0d02 \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d02 \u0d07\u0d24\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d02:\r\n\u2022 https://uidai.gov.in \u0d2a\u0d4d\u0d30\u0d15\u0d3e\u0d30\u0d02 \u0d38\u0d3e\u0d27\u0d41\u0d35\u0d3e\u0d2f \u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d02.\r\n\u2022 \u0d05\u0d2a\u0d4d \u0d32\u0d4b\u0d21\u0d4d  \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d02 \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d7b\u0d4d\u0d31\u0d46 \u0d2a\u0d47\u0d30\u0d3f\u0d32\u0d3e\u0d23\u0d4d.\r\n\u2022 \u0d05\u0d2a\u0d4d \u0d32\u0d4b\u0d21\u0d4d  \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d02 \u0d2f\u0d25\u0d3e\u0d7c\u0d24\u0d4d\u0d25 \u0d2a\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d35\u0d41\u0d02 \u0d28\u0d3f\u0d31\u0d2e\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d41\u0d2e\u0d3e\u0d2f \u0d38\u0d4d\u0d15\u0d3e\u0d7b \u0d06\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d02.\r\n\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d12\u0d30\u0d41 \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28 \u0d38\u0d43\u0d37\u0d4d\u200c\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2e\u0d41\u0d2e\u0d4d\u0d2a\u0d4d \u0d2e\u0d41\u0d15\u0d33\u0d3f\u0d7d \u0d2a\u0d31\u0d1e\u0d4d\u0d1e\u0d35 \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d1f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d35\u0d46\u0d28\u0d4d\u0d28\u0d4d \u0d09\u0d31\u0d2a\u0d4d\u0d2a\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15."},{question:"\u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d \u0d06\u0d27\u0d3e\u0d7c (UID) \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d & \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d?",answer:"\u0d12\u0d30\u0d41 \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d28\u0d46 \u0d38\u0d02\u0d2c\u0d28\u0d4d\u0d27\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d1f\u0d24\u0d4d\u0d24\u0d4b\u0d33\u0d02, \u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d2f\u0d41\u0d1f\u0d46 \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d2f\u0d41\u0d02 \u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d2f\u0d41\u0d02 \u0d0e\u0d32\u0d4d\u0d32\u0d3e\u0d2f\u0d4d\u0d2a\u0d4d\u0d2a\u0d4b\u0d34\u0d41\u0d02 \u0d12\u0d30\u0d41 \u0d2a\u0d4d\u0d30\u0d3e\u0d25\u0d2e\u0d3f\u0d15 \u0d06\u0d36\u0d19\u0d4d\u0d15\u0d2f\u0d3e\u0d23\u0d4d. \u0d05\u0d35\u0d7b\u0d4d\u0d31\u0d46/\u0d05\u0d35\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37 \u0d36\u0d15\u0d4d\u0d24\u0d3f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d23\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02, \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c (UID) \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d38\u0d02\u0d35\u0d3f\u0d27\u0d3e\u0d28\u0d02 UIDAI \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.\nUIDAI \u0d35\u0d46\u0d2c\u0d4d\u200c\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d4d www.myaadhaar.uidai.gov.in \u0d35\u0d34\u0d3f\u0d2f\u0d4b mAadhaar \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d35\u0d34\u0d3f\u0d2f\u0d4b \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d28\u0d4d \u0d05\u0d35\u0d7b\u0d4d\u0d31\u0d46 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d05\u0d35\u0d33\u0d41\u0d1f\u0d46 \u0d06\u0d27\u0d3e\u0d7c (UID) \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02.\n\u0d07\u0d24\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d32\u0d42\u0d1f\u0d46, \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u200c\u0d38\u0d4d, \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d, \u0d12\u0d1f\u0d3f\u0d2a\u0d3f \u0d2e\u0d4b\u0d21\u0d3e\u0d32\u0d3f\u0d31\u0d4d\u0d31\u0d3f \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f \u0d2f\u0d41\u0d10\u0d21\u0d3f, \u0d2f\u0d41\u0d10\u0d21\u0d3f \u0d1f\u0d4b\u0d15\u0d4d\u0d15\u0d7a, \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d12\u0d30\u0d41 \u0d24\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d23\u0d35\u0d41\u0d02 \u0d31\u0d38\u0d3f\u0d21\u0d7b\u0d4d\u0d31\u0d3f\u0d28\u0d4d \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d3f\u0d32\u0d4d\u0d32\n\u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d2f\u0d41\u0d10\u0d21\u0d3f \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d23\u0d2e\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d35\u0d46\u0d2c\u0d4d\u200c\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d4d \u0d35\u0d34\u0d3f\u0d2f\u0d4b \u0d0e\u0d02\u0d06\u0d27\u0d3e\u0d7c \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d35\u0d34\u0d3f\u0d2f\u0d4b \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d05\u0d2f\u0d3e\u0d7e\u0d15\u0d4d\u0d15\u0d4d/\u0d05\u0d35\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d24\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02.\n\u0d06\u0d27\u0d3e\u0d7c (\u0d2f\u0d41\u0d10\u0d21\u0d3f) \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d36\u0d47\u0d37\u0d02, \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d2f\u0d41\u0d10\u0d21\u0d3f, \u0d2f\u0d41\u0d10\u0d21\u0d3f \u0d1f\u0d4b\u0d15\u0d4d\u0d15\u0d7a, \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d23\u0d02 \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02."},{question:"\u0d31\u0d38\u0d3f\u0d21\u0d7b\u0d4d\u0d31\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 UID \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02?",answer:"\u0d2f\u0d41\u0d10\u0d21\u0d3f \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d, \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d28\u0d4d 16 \u0d05\u0d15\u0d4d\u0d15 \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d23\u0d4d\u0d1f\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d02, \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d07\u0d24\u0d4d \u0d12\u0d30\u0d41 \u0d2e\u0d41\u0d7b\u0d35\u0d4d\u0d2f\u0d35\u0d38\u0d4d\u0d25\u0d2f\u0d3e\u0d23\u0d4d. \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d07\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d0e\u0d38\u0d4d\u0d0e\u0d02\u0d0e\u0d38\u0d4d \u0d38\u0d47\u0d35\u0d28\u0d02 \u0d35\u0d34\u0d3f\u0d2f\u0d4b \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d35\u0d46\u0d2c\u0d4d\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d4d (www.myaadhaar.uidai.gov.in) \u0d35\u0d34\u0d3f\u0d2f\u0d4b \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02.SMS \u0d38\u0d47\u0d35\u0d28\u0d02. UID-\u0d2f\u0d41\u0d1f\u0d46 \u0d05\u0d35\u0d38\u0d3e\u0d28 4 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d 8 \u0d05\u0d15\u0d4d\u0d15 GVID \u0d38\u0d4d\u200c\u0d2a\u0d46\u0d2f\u0d4d\u200c\u0d38\u0d4d. 1947. Ex-GVID 1234 \u0d0e\u0d28\u0d4d\u0d28 \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d SMS \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15.\u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d35\u0d46\u0d2c\u0d4d\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02 https://resident.uidai.gov.in/aadhaar-lockunlock \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d06\u0d27\u0d3e\u0d7c \u0d1f\u0d3e\u0d2c\u0d3f\u0d28\u0d4d \u0d15\u0d40\u0d34\u0d3f\u0d7d, \u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d & \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. UID \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d31\u0d47\u0d21\u0d3f\u0d2f\u0d4b \u0d2c\u0d1f\u0d4d\u0d1f\u0d7a \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d4d \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d35\u0d3f\u0d36\u0d26\u0d3e\u0d02\u0d36\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d2a\u0d4b\u0d32\u0d46 UID \u0d28\u0d2e\u0d4d\u0d2a\u0d7c, \u0d2e\u0d41\u0d34\u0d41\u0d35\u0d7b \u0d2a\u0d47\u0d30\u0d4d, \u0d2a\u0d3f\u0d7b \u0d15\u0d4b\u0d21\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d28\u0d7d\u0d15\u0d3f \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3e \u0d15\u0d4b\u0d21\u0d4d \u0d28\u0d7d\u0d15\u0d41\u0d15. \u0d38\u0d46\u0d7b\u0d21\u0d4d \u0d12\u0d1f\u0d3f\u0d2a\u0d3f \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d4d \u0d38\u0d2c\u0d4d\u0d2e\u0d3f\u0d31\u0d4d\u0d31\u0d4d \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 UID \u0d35\u0d3f\u0d1c\u0d2f\u0d15\u0d30\u0d2e\u0d3e\u0d2f\u0d3f \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d02.'"},{question:"\u0d31\u0d38\u0d3f\u0d21\u0d7b\u0d4d\u0d31\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 UID \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d02?",answer:"UID \u0d31\u0d38\u0d3f\u0d21\u0d7b\u0d4d\u0d31\u0d4d \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d41\u0d24\u0d3f\u0d2f 16 \u0d05\u0d15\u0d4d\u0d15 \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d09\u0d23\u0d4d\u0d1f\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d02, \u0d15\u0d42\u0d1f\u0d3e\u0d24\u0d46 \u0d31\u0d38\u0d3f\u0d21\u0d7b\u0d4d\u0d31\u0d4d 16 \u0d05\u0d15\u0d4d\u0d15 VID \u0d2e\u0d31\u0d28\u0d4d\u0d28\u0d41\u0d2a\u0d4b\u0d2f\u0d3e\u0d7d SMS \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d41\u0d24\u0d3f\u0d2f VID \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02.RVID \u0d38\u0d4d\u200c\u0d2a\u0d46\u0d2f\u0d4d\u200c\u0d38\u0d4d UID-\u0d2f\u0d41\u0d1f\u0d46 \u0d05\u0d35\u0d38\u0d3e\u0d28 4 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d 8 \u0d05\u0d15\u0d4d\u0d15\u0d19\u0d4d\u0d19\u0d7e. 1947-\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d SMS \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. Ex- RVID 1234  \u0d2f\u0d41\u0d10\u0d21\u0d3f \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b, \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d7b \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d35\u0d46\u0d2c\u0d4d\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d4d \u0d38\u0d28\u0d4d\u0d26\u0d7c\u0d36\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02 https://resident.uidai.gov.in/aadhaar-lockunlock , \u0d31\u0d47\u0d21\u0d3f\u0d2f\u0d4b \u0d2c\u0d1f\u0d4d\u0d1f\u0d7a \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15, \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d41\u0d24\u0d3f\u0d2f VID, \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3e \u0d15\u0d4b\u0d21\u0d4d \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d28\u0d7d\u0d15\u0d3f \u0d05\u0d2f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d15 OTP \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d4d \u0d38\u0d2e\u0d7c\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15 \u0d15\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 UID \u0d35\u0d3f\u0d1c\u0d2f\u0d15\u0d30\u0d2e\u0d3e\u0d2f\u0d3f \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d02.mAadhaar \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d35\u0d34\u0d3f \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d05\u0d7a\u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d47\u0d35\u0d28\u0d35\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02.'"}],grievanceAndFeedback:[],generateOrRetrieveVid:[{question:"\u0d1e\u0d3e\u0d7b \u0d0e\u0d7b\u0d4d\u0d31\u0d46 \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d2e\u0d31\u0d28\u0d4d\u0d28\u0d41. \u0d2f\u0d41\u0d10\u0d21\u0d3f \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d24\u0d3f\u0d28\u0d4d \u0d36\u0d47\u0d37\u0d02 \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d24\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02?",answer:"\u0d31\u0d38\u0d3f\u0d21\u0d7b\u0d4d\u0d31\u0d4d \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d2e\u0d31\u0d28\u0d4d\u0d28\u0d41\u0d2a\u0d4b\u0d2f\u0d3e\u0d7d \u0d2f\u0d41\u0d10\u0d21\u0d3f \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d36\u0d47\u0d37\u0d02, 16 \u0d05\u0d15\u0d4d\u0d15 \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d31\u0d38\u0d3f\u0d21\u0d7b\u0d4d\u0d31\u0d3f\u0d28\u0d4d \u0d0e\u0d38\u0d4d\u0d0e\u0d02\u0d0e\u0d38\u0d4d \u0d38\u0d47\u0d35\u0d28\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02. \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d28\u0d4d \u0d05\u0d35\u0d7b\u0d4d\u0d31\u0d46/\u0d05\u0d35\u0d33\u0d41\u0d1f\u0d46 \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7d \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02.\n\u0d06\u0d27\u0d3e\u0d7c \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u200c\u0d31\u0d4d\u0d31\u0d7c \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d 1947-\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d SMS \u0d05\u0d2f\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d41\u0d15.\nRVID \u0d38\u0d4d\u200c\u0d2a\u0d46\u0d2f\u0d4d\u200c\u0d38\u0d4d UID-\u0d2f\u0d41\u0d1f\u0d46 \u0d05\u0d35\u0d38\u0d3e\u0d28 4 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d 8 \u0d05\u0d15\u0d4d\u0d15\u0d19\u0d4d\u0d19\u0d7e.\n\u0d09\u0d26\u0d3e:- RVID 1234"},{question:"\u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d \u0d35\u0d46\u0d7c\u0d1a\u0d4d\u0d35\u0d7d \u0d10\u0d21\u0d3f (VID)?",answer:"VID \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d28\u0d4a\u0d2a\u0d4d\u0d2a\u0d02 \u0d2e\u0d3e\u0d2a\u0d4d\u0d2a\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u200c\u0d24 \u0d24\u0d3e\u0d7d\u0d15\u0d4d\u0d15\u0d3e\u0d32\u0d3f\u0d15, \u0d2a\u0d3f\u0d7b\u0d35\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d35\u0d41\u0d28\u0d4d\u0d28 16 \u0d05\u0d15\u0d4d\u0d15 \u0d31\u0d3e\u0d7b\u0d21\u0d02 \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3e\u0d23\u0d4d. \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d23\u0d2e\u0d4b \u0d07-\u0d15\u0d46\u0d35\u0d48\u0d38\u0d3f \u0d38\u0d47\u0d35\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d4b \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d34\u0d46\u0d32\u0d4d\u0d32\u0d3e\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d28\u0d4d \u0d2a\u0d15\u0d30\u0d2e\u0d3e\u0d2f\u0d3f \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02. \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d38\u0d2e\u0d3e\u0d28\u0d2e\u0d3e\u0d2f \u0d30\u0d40\u0d24\u0d3f\u0d2f\u0d3f\u0d7d VID \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d23\u0d02 \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d3e\u0d02. \u0d35\u0d3f\u0d10\u0d21\u0d3f\u0d2f\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d38\u0d3e\u0d27\u0d4d\u0d2f\u0d2e\u0d32\u0d4d\u0d32."},{question:"\u0d12\u0d30\u0d41 \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d28\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46\u0d2f\u0d3e\u0d23\u0d4d VID \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d?",answer:"\u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d42. \u0d05\u0d35\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d10\u0d21\u0d3f\u0d2f\u0d46 \u0d15\u0d3e\u0d32\u0d3e\u0d15\u0d3e\u0d32\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d7d \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 (\u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02) \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02. \u0d0f\u0d24\u0d4d \u0d38\u0d2e\u0d2f\u0d24\u0d4d\u0d24\u0d41\u0d02 \u0d12\u0d30\u0d41 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d28\u0d4d \u0d12\u0d30\u0d41 \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 \u0d38\u0d3e\u0d27\u0d41\u0d24\u0d2f\u0d41\u0d33\u0d4d\u0d33\u0d42. \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10 \u0d06\u0d27\u0d3e\u0d31\u0d3f\u0d28\u0d4d \u0d35\u0d3f\u0d35\u0d3f\u0d27 \u0d13\u0d2a\u0d4d\u0d37\u0d28\u0d41\u0d15\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41 \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d02 \u0d05\u0d35\u0d7c \u0d2e\u0d31\u0d28\u0d4d\u0d28\u0d41\u0d2a\u0d4b\u0d2f\u0d3e\u0d7d \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d28\u0d7d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d08 \u0d13\u0d2a\u0d4d\u0d37\u0d28\u0d41\u0d15\u0d7e \u0d2f\u0d41\u0d10\u0d21\u0d3f\u0d0e\u0d10\u0d2f\u0d41\u0d1f\u0d46 \u0d35\u0d46\u0d2c\u0d4d\u200c\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d4d (www.myaadhaar.uidai.gov.in), eAadhaar \u0d21\u0d57\u0d7a\u0d32\u0d4b\u0d21\u0d4d, mAadhaar \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d35\u0d34\u0d3f \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d02. \u0d05\u0d2a\u0d47\u0d15\u0d4d\u0d37 \u0d2e\u0d41\u0d24\u0d32\u0d3e\u0d2f\u0d35.\u0d06\u0d27\u0d3e\u0d7c \u0d39\u0d46\u0d7d\u0d2a\u0d4d\u0d2a\u0d4d\u200c\u0d32\u0d48\u0d7b \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3e\u0d2f 1947-\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d12\u0d30\u0d41 SMS \u0d05\u0d2f\u0d1a\u0d4d\u0d1a\u0d41\u0d02 VID \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d35\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3e\u0d23\u0d4d. \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d7b 'GVID \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d05\u0d35\u0d38\u0d3e\u0d28 4 \u0d05\u0d15\u0d4d\u0d15\u0d19\u0d4d\u0d19\u0d7e' \u0d0e\u0d28\u0d4d\u0d28\u0d4d \u0d1f\u0d48\u0d2a\u0d4d\u0d2a\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u200c\u0d24\u0d4d \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d35\u0d34\u0d3f 1947 \u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2f\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d47\u0d23\u0d4d\u0d1f\u0d24\u0d41\u0d23\u0d4d\u0d1f\u0d4d.'"},{question:"\u0d2e\u0d31\u0d4d\u0d31\u0d3e\u0d7c\u0d15\u0d4d\u0d15\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d32\u0d41\u0d02 \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d2f\u0d3f VID \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d2e\u0d4b?",answer:"AUA/KUA \u0d2a\u0d4b\u0d32\u0d46\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d2e\u0d31\u0d4d\u0d31\u0d4a\u0d30\u0d41 \u0d38\u0d4d\u0d25\u0d3e\u0d2a\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d41\u0d1f\u0d46 \u0d2a\u0d47\u0d30\u0d3f\u0d7d VID \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d3f\u0d32\u0d4d\u0d32. \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d4d\u0d35\u0d2f\u0d02/\u0d05\u0d35\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 VID \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d42. \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7d SMS \u0d35\u0d34\u0d3f VID \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02."},{question:"\u0d12\u0d30\u0d41 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d2e\u0d31\u0d28\u0d4d\u0d28\u0d41\u0d2a\u0d4b\u0d2f\u0d3e\u0d32\u0d4b? \u0d05\u0d35\u0d28\u0d4d/\u0d05\u0d35\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d41\u0d02 \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d2e\u0d4b?",answer:"\u0d05\u0d24\u0d46, UIDAI \u0d2a\u0d41\u0d24\u0d3f\u0d2f VID \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02/\u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d32\u0d46 VID \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d12\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d27\u0d3f\u0d15\u0d02 \u0d2e\u0d3e\u0d7c\u0d17\u0d4d\u0d17\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d08 \u0d13\u0d2a\u0d4d\u0d37\u0d28\u0d41\u0d15\u0d7e UIDAI-\u0d2f\u0d41\u0d1f\u0d46 \u0d35\u0d46\u0d2c\u0d4d\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d4d (www.myaadhaar.uidai.gov.in) , eAadhaar, mAadhaar \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d06\u0d2a\u0d4d\u0d32\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b, SMS \u0d2e\u0d41\u0d24\u0d32\u0d3e\u0d2f\u0d35 \u0d35\u0d34\u0d3f \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d4d.\nVID \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d, \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d39\u0d46\u0d7d\u0d2a\u0d4d\u0d2a\u0d4d \u0d32\u0d48\u0d7b \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3e\u0d2f 1947-\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d SMS \u0d05\u0d2f\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d3e\u0d02. RVID \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d05\u0d35\u0d38\u0d3e\u0d28 4 \u0d05\u0d15\u0d4d\u0d15\u0d19\u0d4d\u0d19\u0d7e' \u0d0e\u0d28\u0d4d\u0d28\u0d4d \u0d1f\u0d48\u0d2a\u0d4d\u0d2a\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u200c\u0d24\u0d4d \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d35\u0d34\u0d3f 1947-\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2f\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d47\u0d23\u0d4d\u0d1f\u0d24\u0d3e\u0d23\u0d4d.'"},{question:"OTP \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2c\u0d2f\u0d4b\u0d2e\u0d46\u0d1f\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d21\u0d46\u0d2e\u0d4b\u0d17\u0d4d\u0d30\u0d3e\u0d2b\u0d3f\u0d15\u0d4d\u0d38\u0d4d \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d VID \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d2e\u0d4b?",answer:"\u0d05\u0d24\u0d46. \u0d06\u0d27\u0d3e\u0d7c \u0d13\u0d24\u0d7b\u0d4d\u0d31\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d3e\u0d7b \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d28\u0d4d \u0d2a\u0d15\u0d30\u0d02 VID \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d02."},{question:"\u0d35\u0d3f\u0d10\u0d21\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d7d, \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d \u0d1e\u0d3e\u0d7b \u0d38\u0d2e\u0d4d\u0d2e\u0d24\u0d02 \u0d28\u0d7d\u0d15\u0d47\u0d23\u0d4d\u0d1f\u0d24\u0d41\u0d23\u0d4d\u0d1f\u0d4b?",answer:"\u0d05\u0d24\u0d46, VID \u0d05\u0d1f\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d28\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d41\u0d1f\u0d46 \u0d38\u0d2e\u0d4d\u0d2e\u0d24\u0d02 \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d. \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d09\u0d26\u0d4d\u0d26\u0d47\u0d36\u0d4d\u0d2f\u0d02 \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d46 \u0d05\u0d31\u0d3f\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d3e\u0d2e\u0d3e\u0d23\u0d40\u0d15\u0d30\u0d23\u0d02 \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d2e\u0d3e\u0d2f \u0d38\u0d2e\u0d4d\u0d2e\u0d24\u0d02 \u0d36\u0d47\u0d16\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d0f\u0d1c\u0d7b\u0d38\u0d3f \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3e\u0d23\u0d4d."},{question:"\u0d12\u0d30\u0d41 \u0d0f\u0d1c\u0d7b\u0d38\u0d3f\u0d15\u0d4d\u0d15\u0d4d VID \u0d38\u0d02\u0d2d\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d2e\u0d4b?",answer:"\u0d07\u0d32\u0d4d\u0d32. VID \u0d24\u0d3e\u0d7d\u0d15\u0d4d\u0d15\u0d3e\u0d32\u0d3f\u0d15\u0d2e\u0d3e\u0d2f\u0d24\u0d3f\u0d28\u0d3e\u0d7d \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d3e\u0d7d, VID \u0d38\u0d02\u0d2d\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2e\u0d42\u0d32\u0d4d\u0d2f\u0d2e\u0d3f\u0d32\u0d4d\u0d32. \u0d0f\u0d1c\u0d7b\u0d38\u0d3f\u0d15\u0d7e \u0d12\u0d30\u0d41 \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d3e\u0d2c\u0d47\u0d38\u0d3f\u0d32\u0d4b \u0d32\u0d4b\u0d17\u0d3f\u0d32\u0d4b VID \u0d38\u0d02\u0d2d\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d2a\u0d3e\u0d1f\u0d3f\u0d32\u0d4d\u0d32."},{question:"\u0d35\u0d3f\u0d10\u0d21\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d2a\u0d41\u0d28\u0d7c\u0d28\u0d3f\u0d7c\u0d2e\u0d4d\u0d2e\u0d3e\u0d23\u0d02 \u0d12\u0d30\u0d47 \u0d35\u0d3f\u0d10\u0d21\u0d3f\u0d2f\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4b \u0d2e\u0d31\u0d4d\u0d31\u0d4a\u0d30\u0d41 \u0d35\u0d3f\u0d10\u0d21\u0d3f\u0d2f\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4b \u0d28\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d2e\u0d4b?",answer:"\u0d2e\u0d3f\u0d28\u0d3f\u0d2e\u0d02 \u0d38\u0d3e\u0d27\u0d41\u0d24\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d3e\u0d32\u0d2f\u0d33\u0d35\u0d3f\u0d28\u0d4d \u0d36\u0d47\u0d37\u0d02 (\u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d7d 1 \u0d15\u0d32\u0d23\u0d4d\u0d1f\u0d7c \u0d26\u0d3f\u0d35\u0d38\u0d2e\u0d3e\u0d2f\u0d3f \u0d38\u0d1c\u0d4d\u0d1c\u0d40\u0d15\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d05\u0d7c\u0d26\u0d4d\u0d27\u0d30\u0d3e\u0d24\u0d4d\u0d30\u0d3f 12 \u0d28\u0d4d \u0d36\u0d47\u0d37\u0d02), \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e \u0d12\u0d30\u0d41 \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d35\u0d3f\u0d10\u0d21\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d2a\u0d41\u0d28\u0d30\u0d41\u0d1c\u0d4d\u0d1c\u0d40\u0d35\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d3f\u0d1a\u0d4d\u0d1a\u0d47\u0d15\u0d4d\u0d15\u0d3e\u0d02. \u0d08 \u0d30\u0d40\u0d24\u0d3f\u0d2f\u0d3f\u0d7d, \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d2e\u0d41\u0d2e\u0d4d\u0d2a\u0d24\u0d4d\u0d24\u0d46 \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d28\u0d3f\u0d7c\u0d1c\u0d4d\u0d1c\u0d40\u0d35\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d02.\n\u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d35\u0d40\u0d23\u0d4d\u0d1f\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d24\u0d3e\u0d2e\u0d38\u0d15\u0d4d\u0d15\u0d3e\u0d30\u0d7b \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d3e\u0d23\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d05\u0d35\u0d38\u0d3e\u0d28\u0d2e\u0d3e\u0d2f\u0d3f \u0d38\u0d1c\u0d40\u0d35\u0d2e\u0d3e\u0d2f \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d SMS \u0d35\u0d34\u0d3f \u0d05\u0d2f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d02. RVID \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d7b\u0d4d\u0d31\u0d46 \u0d05\u0d35\u0d38\u0d3e\u0d28 4 \u0d05\u0d15\u0d4d\u0d15\u0d19\u0d4d\u0d19\u0d7e' \u0d0e\u0d28\u0d4d\u0d28\u0d4d \u0d1f\u0d48\u0d2a\u0d4d\u0d2a\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d4d \u0d30\u0d1c\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d2e\u0d4a\u0d2c\u0d48\u0d7d \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d35\u0d34\u0d3f 1947 \u0d0e\u0d28\u0d4d\u0d28 \u0d28\u0d2e\u0d4d\u0d2a\u0d31\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2f\u0d15\u0d4d\u0d15\u0d47\u0d23\u0d4d\u0d1f\u0d24\u0d3e\u0d23\u0d4d.'"}],checkGrievanceFeedbackStatus:[{question:"\u0d35\u0d3f\u0d10\u0d21\u0d3f\u0d2f\u0d41\u0d1f\u0d46 \u0d15\u0d3e\u0d32\u0d39\u0d30\u0d23 \u0d15\u0d3e\u0d32\u0d2f\u0d33\u0d35\u0d4d \u0d0e\u0d28\u0d4d\u0d24\u0d3e\u0d23\u0d4d?",answer:"\u0d08 \u0d38\u0d2e\u0d2f\u0d24\u0d4d\u0d24\u0d4d VID-\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d4d \u0d15\u0d3e\u0d32\u0d39\u0d30\u0d23\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d7d \u0d15\u0d3e\u0d32\u0d2f\u0d33\u0d35\u0d4a\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d28\u0d3f\u0d7c\u0d35\u0d1a\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d1f\u0d4d\u0d1f\u0d3f\u0d32\u0d4d\u0d32. \u0d06\u0d27\u0d3e\u0d7c \u0d28\u0d2e\u0d4d\u0d2a\u0d7c \u0d09\u0d1f\u0d2e \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d35\u0d3f\u0d10\u0d21\u0d3f \u0d1c\u0d28\u0d31\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28 \u0d38\u0d2e\u0d2f\u0d02 \u0d35\u0d30\u0d46 VID \u0d38\u0d3e\u0d27\u0d41\u0d35\u0d3e\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02."}]}}},mr_IN:{translation:{dashboard:{header:{title:"\u092e\u093e\u091d\u093e \u0906\u0927\u093e\u0930",profile:{aadhaarTagLine:"\u092e\u093e\u091d\u093e \u0906\u0927\u093e\u0930, \u092e\u093e\u091d\u0940 \u0913\u0933\u0916",clickToFlip:"\u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u092b\u094d\u0932\u093f\u092a \u0915\u0930\u093e",logOut:"\u092c\u093e\u0939\u0947\u0930 \u092a\u0921\u0923\u0947"}},services:{title:"\u0938\u0947\u0935\u093e",description:"\u0911\u0928\u0932\u093e\u0907\u0928 \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0916\u093e\u0932\u0940\u0932 \u092a\u0941\u0937\u094d\u092a\u0917\u0941\u091a\u094d\u091b \u092a\u094d\u0930\u0935\u0947\u0936\u093e\u0938\u093e\u0920\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947\u0924. \u0938\u0947\u0935\u093e-\u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930 \u0928\u0947\u0935\u094d\u0939\u093f\u0917\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u091f\u0945\u092c\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e",serviceCards:{downloadAadhaar:{title:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0906\u0927\u093e\u0930",description:"\u0921\u093f\u091c\u0940\u091f\u0932 \u0938\u094d\u0935\u093e\u0915\u094d\u0937\u0930\u0940\u0915\u0943\u0924 \u0906\u0923\u093f \u0906\u0927\u093e\u0930 \u0938\u0902\u0930\u0915\u094d\u0937\u093f\u0924 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u092a\u094d\u0930\u0924 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"},orderPVC:{title:"\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u092e\u093e\u0917\u0935\u093e",description:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924, \u092a\u093e\u0915\u0940\u091f-\u0906\u0915\u093e\u0930\u093e\u091a\u0947 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0911\u0930\u094d\u0921\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"},updateAadhaarOnline:{updateAadhaarOnline:"\u0906\u0927\u093e\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u093e",updateAadhaar:"\u0906\u0927\u093e\u0930 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u093e",headerTitle:"\u0915\u0943\u092a\u092f\u093e \u0911\u0928\u0932\u093e\u0907\u0928 \u0906\u0927\u093e\u0930 \u0905\u092a\u0921\u0947\u091f\u091a\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u093e",title:"\u092a\u0924\u094d\u0924\u093e \u0905\u092a\u0921\u0947\u091f",description:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u091a\u093e \u092a\u0924\u094d\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. \u0907\u0924\u0930 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0905\u092a\u0921\u0947\u091f\u0938\u093e\u0920\u0940, \u0915\u0943\u092a\u092f\u093e \u091c\u0935\u0933\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e"},bankLinkingStatus:{title:"\u092c\u0901\u0915 \u091c\u094b\u0921\u0923\u094d\u092f\u093e\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940",description:"\u0906\u0927\u093e\u0930 \u0906\u0923\u093f \u092c\u0901\u0915 \u0916\u093e\u0924\u094d\u092f\u093e\u091a\u0940 \u0926\u0941\u0935\u093e \u0938\u093e\u0927\u0923\u094d\u092f\u093e\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"},generateVirtualID:{title:"\u0935\u094d\u0939\u0930\u094d\u091a\u094d\u092f\u0941\u0905\u0932 \u0906\u092f\u0921\u0940 \u0935\u094d\u092f\u0941\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0930\u093e",description:"\u0935\u094d\u0939\u0930\u094d\u091a\u094d\u092f\u0941\u0905\u0932 \u0906\u092f\u0921\u0940 (\u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940) \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u091a\u094d\u092f\u093e \u0910\u0935\u091c\u0940 \u0935\u093e\u092a\u0930\u0932\u093e \u091c\u093e\u090a \u0936\u0915\u0924\u094b. 16 \u0905\u0902\u0915\u0940 \u092f\u093e\u0926\u0943\u091a\u094d\u091b\u093f\u0915 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"},offlineEkyc:{title:"\u0911\u092b\u0932\u093e\u0907\u0928 eKYC",description:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0923\u093f \u0938\u093e\u092e\u093e\u092f\u093f\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u092f\u094b\u0917\u094d\u092f \u0908\u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0915\u093e\u0917\u0926\u091c\u0924\u094d\u0930\u093e\u0924 \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e, \u0911\u092b\u0932\u093e\u0907\u0928 \u0913\u0933\u0916 \u0938\u0924\u094d\u092f\u093e\u092a\u0928\u093e\u0938\u093e\u0920\u0940 \u0935\u093e\u092a\u0930\u0932\u0947\u0932\u0947"},lockUnlockBiometrics:{title:"\u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0932\u0949\u0915 / \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u093e",description:"\u0906\u092a\u0932\u0940 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u092e\u093e\u0939\u093f\u0924\u0940 \u0924\u093e\u0924\u094d\u092a\u0941\u0930\u0924\u0940 \u0932\u0949\u0915 / \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"},lockUnlockAadhaar:{title:"\u0906\u0927\u093e\u0930 \u0932\u0949\u0915 / \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u093e",description:"\u0906\u092a\u0932\u093e \u0906\u0927\u093e\u0930 \u0924\u093e\u0924\u094d\u092a\u0941\u0930\u0924\u0947 \u0932\u0949\u0915 / \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. \u0915\u0943\u092a\u092f\u093e \u0939\u0940 \u0938\u0947\u0935\u093e \u0915\u093e\u0933\u091c\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u0935\u093e\u092a\u0930\u093e"},paymentHistory:{title:"\u092a\u0947\u092e\u0947\u0902\u091f \u0907\u0924\u093f\u0939\u093e\u0938",description:"\u092a\u0947\u092e\u0947\u0902\u091f \u0906\u0923\u093f \u092a\u0930\u0924\u093e\u0935\u094d\u092f\u093e\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u092a\u093e\u0939\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e"},aadharUpdateHistory:{title:"\u0906\u0927\u093e\u0930 \u0905\u092a\u0921\u0947\u091f \u0907\u0924\u093f\u0939\u093e\u0938",description:"\u0924\u0941\u092e\u091a\u093e \u0906\u0927\u093e\u0930 \u0905\u092a\u0921\u0947\u091f \u0907\u0924\u093f\u0939\u093e\u0938 \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e."},bankSeedingStatus:{title:"\u092c\u0901\u0915 \u0938\u0940\u0921\u093f\u0902\u0917 \u0938\u094d\u0925\u093f\u0924\u0940",description:"\u0924\u0941\u092e\u091a\u0940 \u092c\u0901\u0915 \u0938\u0940\u0921\u093f\u0902\u0917 \u0938\u094d\u0925\u093f\u0924\u0940 \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e."},authenticationHistory:{title:"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0907\u0924\u093f\u0939\u093e\u0938",description:"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0907\u0924\u093f\u0939\u093e\u0938 \u092a\u093e\u0939\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e",heading:"\u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0907\u0924\u093f\u0939\u093e\u0938 \u0906\u0923\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0924\u093e\u0930\u0940\u0916 \u0936\u094d\u0930\u0947\u0923\u0940 \u0928\u093f\u0935\u0921\u093e",modality:"\u092e\u094b\u0921\u0945\u0932\u093f\u091f\u0940 \u0928\u093f\u0935\u0921\u093e",fieldStartText:"\u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0924\u093e\u0930\u0940\u0916 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",fieldEndText:"\u0938\u092e\u093e\u092a\u094d\u0924\u0940 \u0924\u093e\u0930\u0940\u0916 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",button:"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0907\u0924\u093f\u0939\u093e\u0938 \u0906\u0923\u093e",tableHeading:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0928\u093f\u0935\u0921\u0940\u092e\u0941\u0933\u0947 {{txnNumber}} \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u091d\u093e\u0932\u0947 \u0906\u0939\u0947",dateRange:"\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0911\u0925\u0947\u0902\u091f\u093f\u0915\u0947\u0936\u0928 \u092f\u0941\u091c\u0930 \u090f\u091c\u0928\u094d\u0938\u0940\u0928\u0947 (AUA) \u0915\u093f\u0902\u0935\u093e \u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e/\u0924\u093f\u0928\u0947 \u0917\u0947\u0932\u094d\u092f\u093e 6 \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u0902\u0924 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e 50 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0928\u094b\u0902\u0926\u0940\u0902\u091a\u093e \u0924\u092a\u0936\u0940\u0932 \u092a\u093e\u0939\u0942 \u0936\u0915\u0924\u094b.",filterName:"\u092e\u094b\u0921\u0945\u0932\u093f\u091f\u0940 \u0928\u093f\u0935\u0921\u093e",note:{l1:"\u091f\u0940\u092a: ",l2:"AUA \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0906\u092f\u0921\u0940:",l3:"\u0935\u093f\u0928\u0902\u0924\u0940\u091a\u094d\u092f\u093e \u0935\u0947\u0933\u0940 \u0905\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u0906\u0927\u093e\u0930 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0906\u092f\u0921\u0940.",l4:"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e \u090f\u091c\u0928\u094d\u0938\u0940\u091a\u0940 \u092f\u093e\u0926\u0940:",l5:"\u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u092c\u093e\u092c\u0924 \u0915\u093e\u0939\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0924\u094d\u092f\u093e \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u0938\u093e\u0920\u0940 AUA \u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e.",l6:"\u0924\u092a\u0936\u0940\u0932 \u092a\u093e\u0939\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e.",l7:"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u092a\u094d\u0930\u0924\u093f\u0938\u093e\u0926:",l8:"\u092f\u0936/\u0905\u092a\u092f\u0936",l9:"UIDAI \u0924\u094d\u0930\u0941\u091f\u0940 \u0915\u094b\u0921:",l10:"\u0906\u0927\u093e\u0930 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0924\u094d\u0930\u0941\u091f\u0940 \u0915\u094b\u0921.",l11:"\u0907\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e",l12:"FAQs: ",l13:"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0907\u0924\u093f\u0939\u093e\u0938.",l14:"\u0907\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e",l15:"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u092a\u0926\u094d\u0927\u0924\u0940:",l16:"\u0906\u0927\u093e\u0930 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923\u093e\u091a\u0940 \u092a\u0926\u094d\u0927\u0924",l17:"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0907\u0924\u093f\u0939\u093e\u0938 PDF \u092a\u093e\u0938\u0935\u0930\u094d\u0921 8 \u0935\u0930\u094d\u0923\u093e\u0902\u091a\u093e \u0905\u0938\u0947\u0932. \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0928\u093e\u0935\u093e\u091a\u0940 \u092a\u0939\u093f\u0932\u0940 \u091a\u093e\u0930 \u0905\u0915\u094d\u0937\u0930\u0947 (\u0906\u0927\u093e\u0930 \u092a\u094d\u0930\u092e\u093e\u0923\u0947) \u0915\u0945\u092a\u093f\u091f\u0932 \u0905\u0915\u094d\u0937\u0930\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u0906\u0923\u093f YYYY \u092b\u0949\u0930\u092e\u0945\u091f\u092e\u0927\u094d\u092f\u0947 \u091c\u0928\u094d\u092e\u093e\u091a\u0947 \u0935\u0930\u094d\u0937."}},documentUpdate:{title:"\u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u0926\u094d\u092f\u0924\u0928",description:"\u0924\u0941\u092e\u091a\u093e \u0913\u0933\u0916\u0940\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e (PoI) \u0906\u0923\u093f \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u091a\u093e \u092a\u0941\u0930\u093e\u0935\u093e (PoA) \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e."}}},requests:{title:"\u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e",description:"\u0905\u0932\u093f\u0915\u0921\u0940\u0932 \u092d\u0942\u0924\u0915\u093e\u0933\u093e\u0924 \u0906\u092a\u0932\u094d\u092f\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0935\u093f\u0935\u093f\u0927 \u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e\u0902\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940. \u0906\u092a\u0923 \u201c\u0916\u093e\u0932\u0940\u201d \u092c\u093e\u0923 \u091a\u093f\u0928\u094d\u0939\u093e\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0941\u0928 \u0935\u093f\u0928\u0902\u0924\u0940\u091a\u0940 \u0924\u092a\u0936\u0940\u0932\u0935\u093e\u0930 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u0942 \u0936\u0915\u0924\u093e",serviceName:"\u0938\u0947\u0935\u0947\u091a\u0947 \u0928\u093e\u0935",status:"\u0938\u094d\u0925\u093f\u0924\u0940",srnUrnEid:"\u090f\u0938\u0906\u0930\u090f\u0928 / \u092f\u0942\u0906\u0930\u090f\u0928 / \u0908\u0906\u092f\u0921\u0940",created:"\u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u0947\u0932\u0940 \u0924\u093e\u0930\u0940\u0916",orderPVC:"\u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u092e\u093e\u0917\u0935\u093e",inProcess:"\u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u0947\u0924",stepper:{language:"\u092d\u093e\u0937\u093e",name:"\u0928\u093e\u0935",dob:"\u091c\u0928\u094d\u092e \u0924\u093e\u0930\u0940\u0916",gender:"\u0932\u093f\u0902\u0917",preview:"\u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928",payme