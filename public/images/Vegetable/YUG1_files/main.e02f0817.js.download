u0631\u0628\u0631\u0627\u06c1 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u0627\u067e\u0646\u0627 \u067e\u062a\u06c1 \u0634\u06cc\u0626\u0631 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0648 \u0645\u0633\u062a\u0631\u062f \u06a9\u0631 \u062f\u06cc\u0627 \u06c1\u06d2\u06d4"},confirmationPopUp:{rejectPrompt:"\u06a9\u06cc\u0627 \u0622\u067e \u06a9\u0648 \u06cc\u0642\u06cc\u0646 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0634\u06cc\u0626\u0631 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u0637\u0648\u0631 HoF \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0648 \u0645\u0633\u062a\u0631\u062f \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06ba \u06af\u06d2",acceptPrompt:"\u06a9\u06cc\u0627 \u0622\u067e \u06a9\u0648 \u06cc\u0642\u06cc\u0646 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u0627\u06cc\u0688\u0631\u06cc\u0633 \u0634\u06cc\u0626\u0631 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0648 \u0628\u0637\u0648\u0631 HoF \u0642\u0628\u0648\u0644 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06ba \u06af\u06d2\u061f"}}},pvc:{oauth:{preview:{sectionHeading:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0622\u062f\u06be\u0627\u0631 \u067e\u06cc\u0648\u06cc\u0633\u06cc \u06a9\u0627\u0631\u0688 \u0645\u06cc\u06ba \u0622\u0631\u0688\u0631 \u062f\u06cc\u0646\u06d2 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0627\u067e\u0646\u06d2 \u0622\u0628\u0627\u062f\u06cc\u0627\u062a\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06a9\u0627 \u062c\u0627\u0626\u0632\u06c1 \u0644\u06cc\u06ba",sectionText:"\u0627\u06af\u0631 \u0622\u067e \u06a9\u0648 \u0627\u067e\u0646\u06d2 \u0622\u062f\u06be\u0627\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u06a9\u0648\u0626\u06cc \u063a\u0644\u0637\u06cc / \u06af\u0645\u0634\u062f\u06af\u06cc / \u067e\u0631\u0627\u0646\u06cc / \u067e\u0631\u0627\u0646\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0644\u062a\u06cc \u06c1\u06cc\u06ba \u062a\u0648 \u060c \u0622\u067e \u0633\u0628 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0642\u0631\u06cc\u0628\u06cc \u0622\u062f\u06be\u0627\u0631 \u062e\u062f\u0645\u062a \u0645\u0631\u06a9\u0632 \u067e\u0631 \u062c\u0627\u06a9\u0631 \u06cc\u0627 \u0627\u0633 \u067e\u0648\u0631\u0679\u0644 \u0633\u06d2 \u0622\u062f\u06be\u0627\u0631 \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u06cc\u06ba \u06a9\u06d2 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u062d\u0627\u0635\u0644 \u06a9\u0631\u06a9\u06d2 \u0627\u067e\u0646\u06d2 \u0627\u0648\u062f\u06be\u0627\u0631 \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u06d2 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",name:"\u0646\u0627\u0645",dob:"\u067e\u06cc\u062f\u0627\u0626\u0634 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e",gender:"\u0635\u0646\u0641",address:"\u067e\u062a\u06c1"}},generic:{form:{selectLabel:"12 \u0639\u062f\u062f\u06cc \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 / 28 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u06d2 \u0627\u0646\u062f\u0631\u0627\u062c \u0622\u0626\u06cc \u0688\u06cc \u06a9\u0648 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba",radioLabels:{uid:"\u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631",eid:"\u0627\u0646\u062f\u0631\u0627\u062c ID \u0646\u0645\u0628\u0631"},textFields:{uid:"\u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba",eid:"14 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 \u0627\u0646\u062f\u0631\u0627\u062c \u0646\u0645\u0628\u0631 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4",generic:"\u0627\u0646\u062f\u0631\u0627\u062c \u0634\u0646\u0627\u062e\u062a \u06cc\u0627 \u0627\u06cc\u0633 \u0622\u0631 \u0627\u06cc\u0646 \u06cc\u0627 \u0627\u06d2 \u0622\u0631 \u0627\u06cc\u0646 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba",mobile:"\u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba",otp:"\u0627\u0648\u0679\u06cc \u067e\u06cc \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba",securityCode:"\u06a9\u06cc\u067e\u0686\u0627 \u062f\u0627\u062e\u0644 \u06a9\u0631\u06cc\u06ba"},checkBox:{mobile:"\u0645\u06cc\u0631\u0627 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u0631\u062c\u0633\u0679\u0631\u0688 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2",tnc:"\u0634\u0631\u0627\u0626\u0637 \u0648 \u0636\u0648\u0627\u0628\u0637"},button:{otp:"\u0627\u0648 \u0679\u06cc \u067e\u06cc \u0628\u06be\u06cc\u062c\u06cc\u06ba",submit:"\u0633\u0628\u0645\u0679"},modal:{mobile:"\u0627\u06af\u0631 \u0622\u067e \u06a9\u0627 \u0622\u062f\u06be\u0627\u0631 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0631\u062c\u0633\u0679\u0631\u0688 \u06c1\u06d2 \u062a\u0648 \u060c \u06c1\u0645 \u0622\u067e \u06a9\u0648 \u0645\u06cc\u0631\u0627 \u0622\u062f\u06be\u0627\u0631 (myaadhaar.uidai.gov.in) \u067e\u0631 \u0644\u0627\u06af \u0627\u0646 \u06c1\u0648\u0646\u06d2 \u0627\u0648\u0631 \u067e\u06cc\u0648\u06cc\u0633\u06cc \u06a9\u0627\u0631\u0688 \u06a9\u06d2 \u0644\u0626\u06d2 \u0622\u0631\u0688\u0631 \u062f\u06cc\u0646\u06d2 \u06a9\u06cc \u062a\u0631\u063a\u06cc\u0628 \u062f\u06cc\u06ba \u06af\u06d2\u06d4",tnc:{heading:"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u0648 \u0627\u06d2 \u0633\u06cc \u067e\u0648\u0631\u0679\u0644 \u0645\u06cc\u06ba \u0627\u067e \u0688\u06cc\u0679 \u06c1\u0648\u0646\u06d2 \u0648\u0627\u0644\u06cc \u0645\u0646\u0638\u0648\u0631 \u0634\u062f\u06c1 '\u0634\u0631\u0627\u0626\u0637 \u0648 \u0636\u0648\u0627\u0628\u0637' \u06a9\u06d2 \u0646\u06cc\u0686\u06d2 \u062a\u0644\u0627\u0634 \u06a9\u0631\u06cc\u06ba:",t1:"\u0645\u06cc\u06ba \u0627\u0633 \u0637\u0631\u062d \u0627\u067e\u0646\u06d2 \u0622\u062f\u06be\u0627\u0631 \u067e\u06cc\u0648\u06cc\u0633\u06cc \u06a9\u0627\u0631\u0688 \u06a9\u06cc \u0637\u0628\u0627\u0639\u062a \u06a9\u06d2 \u0644\u0626\u06d2 \u0627\u067e\u0646\u06cc \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u062f\u06cc\u062a\u0627 \u06c1\u0648\u06ba\u06d4",t2:"\u0645\u06cc\u06ba \u0633\u0645\u062c\u06be\u062a\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u0645\u06cc\u0631\u0627 \u067e\u0631\u0646\u0679 \u0634\u062f\u06c1 \u0622\u062f\u06be\u0627\u0631 \u067e\u06cc\u0648\u06cc\u0633\u06cc \u06a9\u0627\u0631\u0688 \u0645\u06cc\u0631\u06d2 \u067e\u062a\u06c1 \u067e\u0631 \u067e\u06c1\u0646\u0686\u0627\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u060c \u0622\u062f\u06be\u0627\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0631\u062c\u0633\u0679\u0631\u0688 \u06c1\u06d2 \u062c\u0648 \u0645\u06a9\u0645\u0644 \u0627\u0648\u0631 \u067e\u06cc\u0646 \u06a9\u0648\u0688 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062f\u0631\u0633\u062a \u06c1\u06d2\u06d4",t3:"\u0645\u06cc\u06ba \u0622\u0631\u0688\u0631 \u0622\u062f\u06be\u0627\u0631 \u067e\u06cc\u0648\u06cc\u0633\u06cc \u06a9\u0627\u0631\u0688 \u0633\u0631\u0648\u0633 \u06a9\u06d2 \u0644\u0626\u06d2\u06d4 50 / - (Incl GST) \u0627\u062f\u0627 \u06a9\u0631\u0646\u06d2 \u067e\u0631 \u0631\u0627\u0636\u06cc \u06c1\u0648\u06ba\u06d4",t4:"I. \u0645\u06cc\u06ba \u0633\u0645\u062c\u06be\u062a\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u0622\u062f\u06be\u0627\u0631 \u067e\u06cc\u0648\u06cc\u0633\u06cc \u06a9\u0627\u0631\u0688 \u0627\u0646\u0688\u06cc\u0627 \u067e\u0648\u0633\u0679 \u06a9\u06cc \u062a\u06cc\u0632 \u0631\u0641\u062a\u0627\u0631 \u067e\u0648\u0633\u0679 \u0633\u0631\u0648\u0633 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 \u0627\u0646 \u06a9\u06d2 \u062a\u0631\u0633\u06cc\u0644 \u06a9\u06d2 \u0627\u0635\u0648\u0644\u0648\u06ba \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u0627\u0646\u0688\u06cc\u0627 \u067e\u0648\u0633\u0679 \u0627\u0633\u0679\u06cc\u0679\u0633 \u0679\u0631\u06cc\u06a9\u0646\u06af \u062e\u062f\u0645\u0627\u062a \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2 \u0641\u0631\u0627\u06c1\u0645\u06cc \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a \u06a9\u0627 \u0633\u0631\u0627\u063a \u0644\u06af\u0627\u06cc\u0627 \u062c\u0627\u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4"}}},payment:{welcomeText:"\u0639\u0632\u06cc\u0632 \u0631\u06c1\u0627\u0626\u0634\u06cc \u060c",srnInfo:" \u0622\u067e \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0648 \u0627\u06cc\u0633 \u0622\u0631 \u0627\u06cc\u0646 # \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062f\u0631\u062c \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4",trackInfo:"\u0622\u0631\u0688\u0631 \u0633\u06d2 \u0628\u0627\u062e\u0628\u0631 \u0631\u06c1\u0646\u06d2 \u0627\u0648\u0631 \u06cc\u0648 \u0622\u0626\u06cc \u0688\u06cc \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062e\u0637 \u0648 \u06a9\u062a\u0627\u0628\u062a \u06a9\u06d2 \u0644\u0626\u06d2 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u06cc\u06c1 \u0646\u0645\u0628\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4",paymentInfo:"\u067e\u06cc \u0648\u06cc \u0633\u06cc \u0622\u062f\u06be\u0627\u0631 \u06a9\u0627\u0631\u0688 \u06a9\u06d2 \u0644\u0626\u06d2 \u0622\u067e \u0633\u06d2 50 / - \u0631\u0648\u067e\u06d2 (\u062c\u06cc \u0627\u06cc\u0633 \u0679\u06cc \u0627\u0648\u0631 \u0627\u0633\u067e\u06cc\u0688 \u067e\u0648\u0633\u0679 \u0686\u0627\u0631\u062c\u0632 \u0633\u0645\u06cc\u062a) \u0648\u0635\u0648\u0644 \u06a9\u06cc\u06d2 \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u06d4 ",redirectInfo:" \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0631\u06cc\u06ba \u0628\u0679\u0646 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u0646\u06d2 \u067e\u0631 \u060c \u0622\u067e \u06a9\u0648 \u0622\u0646 \u0644\u0627\u0626\u0646 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06d2 \u0644\u0626\u06d2 \u067e\u06cc \u06cc\u0648 \u06cc\u0648 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06d2 \u06af\u06cc\u0679 \u0648\u06d2 \u067e\u0631 \u0628\u06be\u06cc\u062c \u062f\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u06a9\u0627\u0645\u06cc\u0627\u0628 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u067e\u0631 \u060c \u0622\u067e \u06a9\u0648 \u0642\u0628\u0648\u0644\u06cc\u062a \u067e\u0631\u0686\u06cc \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u0627\u0633 \u0635\u0641\u062d\u06d2 \u067e\u0631 \u0648\u0627\u067e\u0633 \u0628\u06be\u06cc\u062c \u062f\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u0645\u06cc\u06ba \u0646\u0627\u06a9\u0627\u0645 \u06c1\u0648\u0646\u06d2 \u06a9\u06cc \u0635\u0648\u0631\u062a \u0645\u06cc\u06ba \u060c \u0622\u067e \u0645\u062a\u0639\u062f\u062f \u0628\u0627\u0631 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u067e\u0631 \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0648\u0634\u0634 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",button:{cancel:"\u0645\u0646\u0633\u0648\u062e \u06a9\u0631\u06cc\u06ba",makePayment:"\u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u0631\u0646\u0627"}}},status:{srnField:"\u0627\u06cc\u0633 \u0622\u0631 \u0627\u06cc\u0646 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba",table:{srn:"\u0627\u06cc\u0633 \u0622\u0631 \u0627\u06cc\u0646",orderDate:"\u0622\u0631\u0688\u0631 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e",currentStatus:"\u0645\u0648\u062c\u0648\u062f\u06c1 \u0635\u0648\u0631\u062a \u062d\u0627\u0644",awb:"\u06c1\u0648\u0627\u0626\u06cc \u0631\u0627\u0633\u062a\u06c1 \u0628\u0644 \u0646\u0645\u0628\u0631",dispatchDate:"\u0631\u0648\u0627\u0646\u06c1 \u06c1\u0648\u0646\u06d2 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e",awb_subText:"\u0622\u067e \u0627\u0648\u067e\u0631 \u0646\u0645\u0628\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2 'www.indiapost.gov.in' \u067e\u0631 \u0627\u067e\u0646\u06d2 \u0622\u0631\u0688\u0631 \u06a9\u0648 \u0679\u0631\u06cc\u06a9 \u06a9\u0631\u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba",demographic:"\u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06a9\u06cc \u0648\u062c\u0648\u06c1\u0627\u062a \u06a9\u06cc \u0628\u0646\u0627\u0621 \u067e\u0631 \u060c \u0631\u06cc\u0627\u0633\u062a \u0645\u06cc\u06ba \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u06a9\u06d2 \u0627\u0639\u062f\u0627\u062f \u0648 \u0634\u0645\u0627\u0631 \u06a9\u06d2 \u0627\u0639\u062f\u0627\u062f \u0648 \u0634\u0645\u0627\u0631 \u06a9\u0648 \u0638\u0627\u06c1\u0631 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u062c\u0627\u0633\u06a9\u062a\u0627\u06d4 \u062a\u0627\u06c1\u0645 \u060c \u0622\u0631\u0688\u0631 \u06a9\u0631\u062f\u06c1 \u067e\u06cc\u0648\u06cc\u0633\u06cc \u06a9\u0627\u0631\u0688 \u0645\u06cc\u06ba \u0622\u062f\u06be\u0627\u0631 \u06a9\u0627 \u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646 \u0688\u06cc\u0645\u0648\u06af\u0631\u0627\u0641\u06a9\u0633 \u0688\u06cc\u0679\u0627 \u06c1\u0648\u06af\u0627\u06d4"}}},aadharStatus:{title:"\u0627\u0646\u062f\u0631\u0627\u062c \u0627\u0648\u0631 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",description:{one:"\u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba \u06a9\u06c1 \u0622\u06cc\u0627 \u0622\u067e \u06a9\u0627 \u0622\u062f\u06be\u0627\u0631 \u062a\u06cc\u0627\u0631 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2 \u06cc\u0627 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2 \u06d4",twoEID:"14\u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 \u0627\u0646\u062f\u0631\u0627\u062c \u0646\u0645\u0628\u0631\u060c \u062f\u0627\u062e\u0644\u06d2 / \u0627\u067e \u0688\u06cc\u0679 \u0633\u0646\u0679\u0631 \u06a9\u0627 \u062c\u0633\u0645\u0627\u0646\u06cc \u0637\u0648\u0631 \u067e\u0631 \u062f\u0648\u0631\u06c1 \u06a9\u0631\u062a\u06d2 \u0648\u0642\u062a\u060c \u0627\u06cc\u06a9\u0646\u0648\u0644\u062c\u0645\u0646\u0679 \u0633\u0644\u067e \u067e\u0631 \u067e\u0631\u0646\u0679 \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u0646\u0645\u0648\u0646\u06c1: 1234/12345/12345",twoSRN:"\u0627\u06cc\u0633 \u06a9\u06d2 \u0628\u0639\u062f 13 \u06c1\u0646\u062f\u0633\u06d2 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0622\u0646 \u0644\u0627\u0626\u0646 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u062a\u06d2 \u0648\u0642\u062a \u0627\u0642\u0631\u0627\u0631 \u067e\u0631\u0686\u06cc \u067e\u0631 \u067e\u0631\u0646\u0679 \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u0646\u0645\u0648\u0646\u06c1: S1234567891234",twoURN:"\u0627\u06cc\u0645 \u0622\u062f\u06be\u0627\u0631 \u0627\u06cc\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u062a\u06d2 \u0648\u0642\u062a 8 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u0627 UR N\u060c \u0627\u0642\u0631\u0627\u0631 \u067e\u0631\u0686\u06cc \u067e\u0631 \u067e\u0631\u0646\u0679 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4\u0646\u0645\u0648\u0646\u06c1: 12345678",twoSID:"\u2018S\u2019 followed by 27 digits, printed on acknowledgement slip while physically visiting Enrolment / Update center. Sample: S123456789123456789123456789",three:"\u0627\u06af\u0631 \u0622\u067e \u0646\u06d2 EID \u06a9\u06be\u0648 \u062f\u06cc \u06c1\u06d2 \u062a\u0648 \u0622\u067e \u0627\u067e\u0646\u06d2 \u0631\u062c\u0633\u0679\u0631\u0688 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u0633\u06d2 \u06af\u0645\u0634\u062f\u06c1 \u06cc\u0627 \u0628\u06be\u0648\u0644\u06cc \u06c1\u0648\u0626\u06cc EID \u0628\u0627\u0632\u06cc\u0627\u0641\u062a \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"},optionalMessage:"\u0627\u0639\u062a\u0631\u0627\u0641 \u067e\u0631\u0686\u06cc \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u062a\u0627\u0631\u06cc\u062e \u0627\u0648\u0631 \u0648\u0642\u062a \u06a9\u0627 \u0630\u06a9\u0631 \u06a9\u0631\u06cc\u06ba (<b>\u0627\u062e\u062a\u06cc\u0627\u0631\u06cc</b>)"},complaintStatus:{title:"\u0634\u06a9\u0627\u06cc\u062a / \u062a\u0627\u062b\u0631\u0627\u062a \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a \u06a9\u0648 \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",form:{complaintNumber:"\u0633\u0631\u0648\u0633 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0646\u0645\u0628\u0631 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4",QRCid:"Qrc Id",status:"\u062d\u0627\u0644\u062a",ComplaintNumber:"\u0634\u06a9\u0627\u06cc\u062a/\u0641\u06cc\u0688 \u0628\u06cc\u06a9 \u0646\u0645\u0628\u0631",ResolutionResponse:"\u0642\u0631\u0627\u0631\u062f\u0627\u062f \u06a9\u0627 \u062c\u0648\u0627\u0628"}},fileComplaint:{title:"\u0634\u06a9\u0627\u06cc\u062a \u0627\u0648\u0631 \u0631\u0627\u0626\u06d2",description:"\u0627\u067e\u0646\u06cc \u0634\u06a9\u0627\u06cc\u062a \u0627\u0648\u0631 \u0631\u0627\u0626\u06d2 \u062f\u0631\u062c \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06cc\u06c1\u0627\u06ba \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",disclaimer:"\u0622\u062f\u06be\u0627\u0631\u060c \u0633\u0628 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06c1\u0648\u0646\u06d2 \u0648\u0627\u0644\u06cc \u0688\u06cc\u062c\u06cc\u0679\u0644 \u0634\u0646\u0627\u062e\u062a \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631\u060c \u0645\u062a\u0639\u062f\u062f \u0633\u0628\u0633\u0688\u06cc\u060c \u0641\u0648\u0627\u0626\u062f \u0627\u0648\u0631 \u062e\u062f\u0645\u0627\u062a \u062d\u0627\u0635\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u0633\u06cc \u06a9\u06d2 \u067e\u06cc\u0634 \u0646\u0638\u0631\u060c \u0622\u062f\u06be\u0627\u0631 \u0688\u06cc\u0679\u0627 \u0628\u06cc\u0633 \u06a9\u06cc \u062f\u0631\u0633\u062a\u06af\u06cc \u06a9\u0648 \u0628\u0631\u0642\u0631\u0627\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c UIDAI \u0646\u06d2 \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u0627\u0648\u0631 \u0622\u062f\u06be\u0627\u0631 \u06a9\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u06a9 \u0645\u0634\u0642 \u0634\u0631\u0648\u0639 \u06a9\u06cc \u062a\u06be\u06cc\u06d4 \u0622\u062f\u06be\u0627\u0631 \u0688\u06cc\u0679\u0627 \u0628\u06cc\u0633 \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u0631\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u06cc \u062c\u0627\u0646\u06d2 \u0648\u0627\u0644\u06cc \u0633\u0631\u06af\u0631\u0645\u06cc\u0648\u06ba \u06a9\u06d2 \u062f\u0648\u0631\u0627\u0646\u060c \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u0648\u06ba \u06a9\u0648 \u0648\u0642\u062a\u0627\u064b \u0641\u0648\u0642\u062a\u0627\u064b \u0627\u0637\u0644\u0627\u0639 \u062c\u0627\u0631\u06cc \u06a9\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06d2\u06d4 \u0627\u0633 \u0633\u0644\u0633\u0644\u06d2 \u0645\u06cc\u06ba\u060c \u06cc\u06c1 \u0648\u0627\u0636\u062d \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u06a9\u0648\u0626\u06cc \u0628\u06be\u06cc \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0645\u0646\u0633\u0648\u062e \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4 \u0627\u06af\u0631 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0622\u062f\u06be\u0627\u0631 \u0646\u0645\u0628\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u06a9\u0648 \u0627\u0633 \u0633\u0644\u0633\u0644\u06d2 \u0645\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u0634\u06a9\u0627\u06cc\u062a \u06c1\u06d2 \u062a\u0