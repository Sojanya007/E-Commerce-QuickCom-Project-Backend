4\u0acb \u0a9c\u0acb\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb.",l7:"\u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6: ",l8:"\u0ab8\u0aab\u0ab3\u0aa4\u0abe/\u0aa8\u0abf\u0ab7\u0acd\u0aab\u0ab3\u0aa4\u0abe",l9:"UIDAI \u0aad\u0ac2\u0ab2 \u0a95\u0acb\u0aa1\u0acd\u0ab8: ",l10:"\u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0aad\u0ac2\u0ab2 \u0a95\u0acb\u0aa1\u0acd\u0ab8. ",l11:"\u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb",l12:"FAQs: ",l13:"\u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0 \u0a87\u0aa4\u0abf\u0ab9\u0abe\u0ab8. ",l14:"\u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb",l15:"\u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3 \u0aaa\u0aa6\u0acd\u0aa7\u0aa4\u0abf: ",l16:"\u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac0\u0a95\u0ab0\u0aa3\u0aa8\u0ac0 \u0aaa\u0aa6\u0acd\u0aa7\u0aa4\u0abf",l17:"\u0a93\u0aa5\u0ac7\u0aa8\u0acd\u0a9f\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0ab9\u0abf\u0ab8\u0acd\u0a9f\u0acd\u0ab0\u0ac0 \u0aaa\u0ac0\u0aa1\u0ac0\u0a8f\u0aab \u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1 8 \u0a85\u0a95\u0acd\u0ab7\u0ab0\u0acb\u0aae\u0abe\u0a82 \u0ab9\u0ab6\u0ac7. \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aa8\u0abe\u0aae\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0aa5\u0aae \u0a9a\u0abe\u0ab0 \u0a85\u0a95\u0acd\u0ab7\u0ab0\u0acb (\u0a86\u0aa7\u0abe\u0ab0 \u0aa4\u0ab0\u0ac0\u0a95\u0ac7) \u0a95\u0ac7\u0aaa\u0abf\u0a9f\u0ab2 \u0a85\u0a95\u0acd\u0ab7\u0ab0\u0acb\u0aae\u0abe\u0a82 \u0a85\u0aa8\u0ac7 YYYY \u0aab\u0acb\u0ab0\u0acd\u0aae\u0ac7\u0a9f\u0aae\u0abe\u0a82 \u0a9c\u0aa8\u0acd\u0aae \u0ab5\u0ab0\u0acd\u0ab7\u0aa8\u0ac1\u0a82 \u0ab8\u0a82\u0aaf\u0acb\u0a9c\u0aa8."}},documentUpdate:{title:"\u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0aa1\u0ac7\u0a9f",descriptio