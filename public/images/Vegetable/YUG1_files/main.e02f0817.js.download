0a48\u0a02\u0a15 \u0a32\u0a3f\u0a70\u0a15\u0a3f\u0a70\u0a17 \u0a35\u0a47\u0a30\u0a35\u0a47",lastUpdatedDate:"\u0a06\u0a16\u0a30\u0a40 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a2e\u0a3f\u0a24\u0a40",failureMessage:"\u0a07\u0a38 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a32\u0a08 \u0a15\u0a4b\u0a08 \u0a2c\u0a48\u0a02\u0a15 \u0a2e\u0a48\u0a2a\u0a3f\u0a70\u0a17 \u0a30\u0a3f\u0a15\u0a3e\u0a30\u0a21 \u0a28\u0a39\u0a40\u0a02 \u0a2e\u0a3f\u0a32\u0a3f\u0a06",successMessage:"\u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a06\u0a27\u0a3e\u0a30-\u0a2c\u0a48\u0a02\u0a15 \u0a2e\u0a48\u0a2a\u0a3f\u0a70\u0a17 \u0a39\u0a4b \u0a17\u0a08 \u0a39\u0a48",disclaimer:"\u0a06\u0a27\u0a3e\u0a30 \u0a32\u0a3f\u0a70\u0a15\u0a3f\u0a70\u0a17 \u0a26\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a10\u0a28\u0a2a\u0a40\u0a38\u0a40\u0a06\u0a08 \u0a38\u0a30\u0a35\u0a30 \u0a24\u0a4b\u0a02 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48 | \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a35\u0a3f\u0a71\u0a1a, \u0a2f\u0a42\u0a06\u0a08\u0a21\u0a40\u0a0f\u0a06\u0a08 \u0a2a\u0a4d\u0a30\u0a26\u0a30\u0a38\u0a3c\u0a24 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a38\u0a3c\u0a41\u0a71\u0a27\u0a24\u0a3e \u0a32\u0a08 \u0a1c\u0a3c\u0a3f\u0a70\u0a2e\u0a47\u0a35\u0a3e\u0a30 \u0a1c\u0a3e\u0a02 \u0a1c\u0a35\u0a3e\u0a2c\u0a26\u0a47\u0a39 \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e | \u0a07\u0a38 \u0a24\u0a4b\u0a02 \u0a07\u0a32\u0a3e\u0a35\u0a3e, \u0a2f\u0a42\u0a06\u0a08\u0a21\u0a40\u0a0f\u0a06\u0a08 \u0a10\u0a28\u0a2a\u0a40\u0a38\u0a40\u0a06\u0a08 \u0a38\u0a30\u0a35\u0a30 \u0a24\u0a4b\u0a02 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a39\u0a4b\u0a08 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a28\u0a42\u0a70 \u0a38\u0a1f\u0a4b\u0a30 \u0a28\u0a39\u0a40\u0a02 \u0a15\u0a30 \u0a30\u0a3f\u0a39\u0a3e \u0a39\u0a48 |",noRecordsAvailable:"\u0a15\u0a4b\u0a08 \u0a30\u0a3f\u0a15\u0a3e\u0a30\u0a21 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a28\u0a39\u0a40\u0a02",checkWithBank:"\u0a06\u0a2a\u0a23\u0a47 \u0a2c\u0a48\u0a02\u0a15 \u0a16\u0a3e\u0a24\u0a47 \u0a28\u0a3e\u0a32 \u0a06\u0a2a\u0a23\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a32\u0a3f\u0a70\u0a15 \u0a15\u0a30\u0a35\u0a3e\u0a09\u0a23 \u0a32\u0a08 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a06\u0a2a\u0a23\u0a47 \u0a2c\u0a48\u0a02\u0a15 \u0a28\u0a3e\u0a32 \u0a38\u0a70\u0a2a\u0a30\u0a15 \u0a15\u0a30\u0a4b"},bankSeedingStatus:{AadhaarNumber:"\u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30",BankName:"\u0a2c\u0a48\u0a02\u0a15 \u0a26\u0a3e \u0a28\u0a3e\u0a2e",BankSeedingStatus:"\u0a2c\u0a48\u0a02\u0a15 \u0a2c\u0a40\u0a1c\u0a23 \u0a26\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40",LastUpdatedDate:"\u0a06\u0a16\u0a30\u0a40 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a2e\u0a3f\u0a24\u0a40",noRecordAlert:"\u0a06\u0a2a\u0a23\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a06\u0a2a\u0a23\u0a47 \u0a2c\u0a48\u0a02\u0a15 \u0a16\u0a3e\u0a24\u0a47 \u0a28\u0a3e\u0a32 \u0a32\u0a3f\u0a70\u0a15 \u0a15\u0a30\u0a35\u0a3e\u0a09\u0a23 \u0a32\u0a08 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a06\u0a2a\u0a23\u0a47 \u0a2c\u0a48\u0a02\u0a15 \u0a28\u0a3e\u0a32 \u0a38\u0a70\u0a2a\u0a30\u0a15 \u0a15\u0a30\u0a4b",note:"\u0a32\u0a3f\u0a70\u0a15 \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a26\u0a3f\u0a71\u0a24\u0a40 \u0a17\u0a08 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a28\u0a48\u0a38\u0a3c\u0a28\u0a32 \u0a2a\u0a47\u0a2e\u0a48\u0a02\u0a1f \u0a15\u0a3e\u0a30\u0a2a\u0a4b\u0a30\u0a47\u0a38\u0a3c\u0a28 \u0a06\u0a2b \u0a07\u0a70\u0a21\u0a40\u0a06 (NPCI) \u0a26\u0a47 \u0a38\u0a30\u0a35\u0a30 \u0a24\u0a4b\u0a02 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a40\u0a24\u0a40 \u0a17\u0a08 \u0a39\u0a48\u0964 \u0a07\u0a38\u0a26\u0a40 \u0a38\u0a3c\u0a41\u0a71\u0a27\u0a24\u0a3e \u0a32\u0a08 UIDAI \u0a1c\u0a3c\u0a3f\u0a70\u0a2e\u0a47\u0a35\u0a3e\u0a30 \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a48\u0964 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 UIDAI \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a38\u0a1f\u0a4b\u0a30 \u0a28\u0a39\u0a40\u0a02 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48\u0964",ActiveText:"\u0a15\u0a3f\u0a30\u0a3f\u0a06\u0a38\u0a3c\u0a40\u0a32",InactiveText:"\u0a05\u0a15\u0a3f\u0a30\u0a3f\u0a06\u0a38\u0a3c\u0a40\u0a32"},FAQ:{checkAadhaarPvcCardOrderStatus:[{question:"\u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a47 \u0a35\u0a71\u0a16-\u0a35\u0a71\u0a16 \u0a30\u0a42\u0a2a \u0a15\u0a40 \u0a39\u0a28 \u0a05\u0a24\u0a47 \u0a09\u0a28\u0a4d\u0a39\u0a3e\u0a02 \u0a26\u0a40\u0a06\u0a02 \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a15\u0a40 \u0a39\u0a28?",answer:"\u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a47 \u0a35\u0a71\u0a16-\u0a35\u0a71\u0a16 \u0a30\u0a42\u0a2a \u0a39\u0a28 - \u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a71\u0a24\u0a30, \u0a06\u0a27\u0a3e\u0a30 PVC \u0a15\u0a3e\u0a30\u0a21, \u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a05\u0a24\u0a47 \u0a10\u0a2e-\u0a06\u0a27\u0a3e\u0a30 \u0964 \u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a47 \u0a38\u0a3e\u0a30\u0a47 \u0a30\u0a42\u0a2a \u0a2c\u0a30\u0a3e\u0a2c\u0a30 \u0a35\u0a48\u0a27 \u0a05\u0a24\u0a47 \u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30\u0a2f\u0a4b\u0a17 \u0a39\u0a28\u0964"},{question:"\u0a15\u0a40 \u0a2e\u0a48\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a47 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a30\u0a42\u0a2a \u0a28\u0a42\u0a70 \u0a30\u0a71\u0a16\u0a23\u0a3e \u0a05\u0a24\u0a47 \u0a35\u0a30\u0a24\u0a23\u0a3e \u0a1a\u0a41\u0a23 \u0a38\u0a15\u0a26\u0a3e/\u0a38\u0a15\u0a26\u0a40 \u0a39\u0a3e\u0a02?",answer:"\u0a39\u0a3e\u0a02 l"},{question:"\u0a06\u0a30\u0a21\u0a30 \u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a40 \u0a39\u0a48?",answer:"\u0a06\u0a30\u0a21\u0a30 \u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21' \u0a2f\u0a42\u0a06\u0a08\u0a21\u0a40\u0a0f\u0a06\u0a08 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a38\u0a3c\u0a41\u0a30\u0a42 \u0a15\u0a40\u0a24\u0a40 \u0a17\u0a08 \u0a07\u0a71\u0a15 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a38\u0a47\u0a35\u0a3e \u0a39\u0a48 \u0a1c\u0a4b \u0a15\u0a3f \u0a06\u0a27\u0a3e\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a28\u0a42\u0a70 \u0a2e\u0a3e\u0a2e\u0a42\u0a32\u0a40 \u0a16\u0a30\u0a1a\u0a3f\u0a06\u0a02 \u0a26\u0a3e \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a30\u0a15\u0a47 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21 '\u0a24\u0a47 \u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a2a\u0a4d\u0a30\u0a3f\u0a70\u0a1f \u0a15\u0a30\u0a35\u0a3e\u0a09\u0a23 \u0a26\u0a40 \u0a38\u0a39\u0a42\u0a32\u0a24 \u0a26\u0a3f\u0a70\u0a26\u0a40 \u0a39\u0a48\u0964"},{question:"\u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21 \u0a26\u0a40\u0a06\u0a02 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a06 \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a15\u0a40 \u0a39\u0a28?",answer:"\u0a07\u0a38 \u0a15\u0a3e\u0a30\u0a21 \u0a35\u0a3f\u0a71\u0a1a \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a06 \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a39\u0a28 \u0a1c\u0a3f\u0a35\u0a47\u0a02 \u0a15\u0a3f:\n1. \u0a1f\u0a48\u0a02\u0a2a\u0a30 \u0a2a\u0a30\u0a42\u0a2b QR \u0a15\u0a4b\u0a21\n2. \u0a39\u0a4b\u0a32\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a2e\n3. \u0a2e\u0a3e\u0a08\u0a15\u0a4d\u0a30\u0a4b \u0a1f\u0a48\u0a15\u0a38\u0a1f\n4. \u0a2d\u0a42\u0a24 \u0a1a\u0a3f\u0a71\u0a24\u0a30\n5. \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a2e\u0a3f\u0a24\u0a40 \u0a05\u0a24\u0a47 \u0a1b\u0a3e\u0a2a\u0a23 \u0a26\u0a40 \u0a2e\u0a3f\u0a24\u0a40\n6. \u0a17\u0a3f\u0a32\u0a4b\u0a1a\u0a47 \u0a2a\u0a48\u0a1f\u0a30\u0a28\n7. \u0a09\u0a2d\u0a30\u0a3f\u0a06 \u0a06\u0a27\u0a3e\u0a30 \u0a32\u0a4b\u0a17\u0a4b"},{question:"\u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21 \u0a32\u0a08 \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a40\u0a24\u0a47 \u0a1c\u0a3e\u0a23 \u0a35\u0a3e\u0a32\u0a47 \u0a16\u0a30\u0a1a\u0a47 \u0a15\u0a40 \u0a39\u0a28?",answer:"\u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a40\u0a24\u0a47 \u0a1c\u0a3e\u0a23 \u0a35\u0a3e\u0a32\u0a47 \u0a16\u0a30\u0a1a\u0a47 50/- (\u0a1c\u0a40\u0a10\u0a38\u0a1f\u0a40 \u0a05\u0a24\u0a47 \u0a38\u0a2a\u0a40\u0a21 \u0a2a\u0a4b\u0a38\u0a1f \u0a16\u0a30\u0a1a\u0a3f\u0a06\u0a02 \u0a38\u0a2e\u0a47\u0a24) \u0a39\u0a28\u0964"},{question:"\u0a15\u0a4b\u0a08 '\u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21' \u0a32\u0a08 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48?",answer:"'\u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21' \u0a2c\u0a47\u0a28\u0a24\u0a40 UIDAI \u0a26\u0a40 \u0a05\u0a27\u0a3f\u0a15\u0a3e\u0a30\u0a24 \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f (https://www.uidai.gov.in \u0a1c\u0a3e\u0a02 https://myaadhaar.uidai.gov.in) \u0a1c\u0a3e\u0a02 mAadhaar \u0a10\u0a2a\u0a32\u0a40\u0a15\u0a47\u0a38\u0a3c\u0a28 '\u0a24\u0a47 \u0a1c\u0a3e \u0a15\u0a47 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40 \u0a39\u0a48\u0964"},{question:"\u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e\u0a35\u0a47?",answer:"1. \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 https://uidai.gov.in \u0a1c\u0a3e\u0a02 https://myaadhaar.uidai.gov.in/genricPVC '\u0a24\u0a47 \u0a1c\u0a3e\u0a13\u0964\n2. \u0a06\u0a2a\u0a23\u0a3e 12 \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 (UID) \u0a1c\u0a3e\u0a02 28 \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a3e \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a28 ID \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b\u0964\n3. \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a06 \u0a15\u0a4b\u0a21 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b\n4. \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 '\u0a24\u0a47 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a39\u0a4b\u0a07\u0a06 OTP \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b\u0964\n5. '\u0a28\u0a3f\u0a2f\u0a2e \u0a05\u0a24\u0a47 \u0a38\u0a3c\u0a30\u0a24\u0a3e\u0a02' \u0a26\u0a47 \u0a35\u0a3f\u0a30\u0a41\u0a71\u0a27 \u0a1a\u0a48\u0a71\u0a15 \u0a2c\u0a3e\u0a15\u0a38 '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964 (\u0a28\u0a4b\u0a1f: \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a26\u0a47\u0a16\u0a23 \u0a32\u0a08 \u0a39\u0a3e\u0a08\u0a2a\u0a30 \u0a32\u0a3f\u0a70\u0a15 '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b)\u0964\n6. OTP \u0a2a\u0a41\u0a38\u0a3c\u0a1f\u0a40\u0a15\u0a30\u0a28 \u0a28\u0a42\u0a70 \u0a2a\u0a42\u0a30\u0a3e \u0a15\u0a30\u0a28 \u0a32\u0a08 '\u0a38\u0a2c\u0a2e\u0a3f\u0a1f' \u0a2c\u0a1f\u0a28 '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964\n7. \u0a05\u0a17\u0a32\u0a40 \u0a38\u0a15\u0a4d\u0a30\u0a40\u0a28 '\u0a24\u0a47, \u0a06\u0a27\u0a3e\u0a30 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a26\u0a3e \u0a2a\u0a42\u0a30\u0a35\u0a26\u0a30\u0a38\u0a3c\u0a28 \u0a2e\u0a41\u0a5c-\u0a2a\u0a4d\u0a30\u0a3f\u0a70\u0a1f \u0a32\u0a08 \u0a06\u0a30\u0a21\u0a30 \u0a26\u0a47\u0a23 \u0a24\u0a4b\u0a02 \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a24\u0a38\u0a26\u0a40\u0a15 \u0a32\u0a08 \u0a26\u0a3f\u0a16\u0a3e\u0a08 \u0a26\u0a47\u0a35\u0a47\u0a17\u0a3e\u0964\n8. '\u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a30\u0a4b' '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964 \u0a24\u0a41\u0a39\u0a3e\u0a28\u0a42\u0a70 \u0a15\u0a4d\u0a30\u0a48\u0a21\u0a3f\u0a1f/\u0a21\u0a48\u0a2c\u0a3f\u0a1f \u0a15\u0a3e\u0a30\u0a21, \u0a28\u0a48\u0a71\u0a1f \u0a2c\u0a48\u0a02\u0a15\u0a3f\u0a70\u0a17 \u0a05\u0a24\u0a47 UPI \u0a26\u0a47 \u0a30\u0a42\u0a2a \u0a35\u0a3f\u0a71\u0a1a \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a35\u0a3f\u0a15\u0a32\u0a2a\u0a3e\u0a02 \u0a26\u0a47 \u0a28\u0a3e\u0a32 \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a17\u0a47\u0a1f\u0a35\u0a47 \u0a2a\u0a70\u0a28\u0a47 '\u0a24\u0a47 \u0a2e\u0a41\u0a5c \u0a28\u0a3f\u0a30\u0a26\u0a47\u0a38\u0a3c\u0a3f\u0a24 \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a3e\u0964\n9. \u0a38\u0a2b\u0a32 \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26, \u0a21\u0a3f\u0a1c\u0a40\u0a1f\u0a32 \u0a26\u0a38\u0a24\u0a16\u0a24 \u0a35\u0a3e\u0a32\u0a40 \u0a30\u0a38\u0a40\u0a26 \u0a24\u0a3f\u0a06\u0a30 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a40 \u0a1c\u0a3f\u0a38 \u0a28\u0a42\u0a70 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a2a\u0a40\u0a21\u0a40\u0a10\u0a2b \u0a2b\u0a3e\u0a30\u0a2e\u0a48\u0a1f \u0a35\u0a3f\u0a71\u0a1a \u0a21\u0a3e\u0a0a\u0a28\u0a32\u0a4b\u0a21 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a28\u0a42\u0a70 SMS \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a38\u0a47\u0a35\u0a3e \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a28\u0a70\u0a2c\u0a30 \u0a35\u0a40 \u0a2e\u0a3f\u0a32\u0a47\u0a17\u0a3e\u0964\n10. \u0a06\u0a27\u0a3e\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a3e\u0a30\u0a21 \u0a26\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a28 '\u0a24\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a3e\u0a30\u0a21 \u0a26\u0a40 \u0a21\u0a3f\u0a38\u0a2a\u0a48\u0a1a \u0a39\u0a4b\u0a23 \u0a24\u0a71\u0a15 SRN \u0a26\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a1f\u0a30\u0a48\u0a15 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964\n11. DoP \u0a24\u0a4b\u0a02 \u0a2d\u0a47\u0a1c\u0a47 \u0a1c\u0a3e\u0a23 '\u0a24\u0a47 AWB \u0a28\u0a70\u0a2c\u0a30 \u0a35\u0a3e\u0a32\u0a47 SMS \u0a35\u0a40 \u0a2d\u0a47\u0a1c\u0a47 \u0a1c\u0a3e\u0a23\u0a17\u0a47\u0964 \u0a06\u0a27\u0a3e\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a21\u0a40\u0a13\u0a2a\u0a40 \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f '\u0a24\u0a47 \u0a1c\u0a3e \u0a15\u0a47 \u0a21\u0a3f\u0a32\u0a40\u0a35\u0a30\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a39\u0a4b\u0a30 \u0a1f\u0a30\u0a48\u0a15 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964"},{question:"\u0a17\u0a48\u0a30-\u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21/\u0a35\u0a3f\u0a15\u0a32\u0a2a\u0a15 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e\u0a35\u0a47?",answer:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 https://uidai.gov.in \u0a1c\u0a3e\u0a02 https://myaadhaar.uidai.gov.in/genricPVC '\u0a24\u0a47 \u0a1c\u0a3e\u0a13 \u0a05\u0a24\u0a47 '\u0a06\u0a30\u0a21\u0a30 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a3e\u0a30\u0a21' \u0a38\u0a47\u0a35\u0a3e '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b \u0a1c\u0a3e\u0a02 mAadhaar \u0a10\u0a2a\u0a32\u0a40\u0a15\u0a47\u0a38\u0a3c\u0a28 '\u0a24\u0a47 \u0a1c\u0a3e\u0a13 l\n\u0a06\u0a2a\u0a23\u0a3e 12 \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 (UID) \u0a1c\u0a3e\u0a02 28 \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a3e \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a28 ID \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b\u0964\n\u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a06 \u0a15\u0a4b\u0a21 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b\u0964 \u0a1a\u0a48\u0a71\u0a15 \u0a2c\u0a3e\u0a15\u0a38 '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b '\u0a1c\u0a47\u0a15\u0a30 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a15\u0a4b\u0a32 \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a2c\u0a3e\u0a15\u0a38 \u0a35\u0a3f\u0a71\u0a1a \u0a1a\u0a48\u0a71\u0a15 \u0a15\u0a30\u0a4b'\u0964 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a17\u0a48\u0a30-\u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 / \u0a35\u0a3f\u0a15\u0a32\u0a2a\u0a3f\u0a15 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b\u0964\n\u0a17\u0a48\u0a30-\u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a06\u0a30\u0a21\u0a30 \u0a15\u0a30\u0a28 \u0a35\u0a3e\u0a32\u0a47 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40\u0a06\u0a02 \u0a32\u0a08 \u0a2a\u0a4d\u0a30\u0a40\u0a35\u0a3f\u0a0a \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e\u0964\n\u0a06\u0a30\u0a21\u0a30 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a2c\u0a3e\u0a15\u0a40 \u0a26\u0a47 \u0a2a\u0a5c\u0a3e\u0a05 \u0a09\u0a39\u0a40 \u0a30\u0a39\u0a3f\u0a70\u0a26\u0a47 \u0a39\u0a28\u0964"},{question:"\u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a15\u0a3f\u0a39\u0a5c\u0a47 \u0a2e\u0a4b\u0a21 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a39\u0a28?",answer:"\u0a07\u0a38 \u0a38\u0a2e\u0a47\u0a02, \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a39\u0a47\u0a20\u0a3e\u0a02 \u0a26\u0a3f\u0a71\u0a24\u0a47 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a2e\u0a4b\u0a21 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a39\u0a28: -\n\u0a15\u0a30\u0a47\u0a21\u0a3f\u0a1f \u0a15\u0a3e\u0a30\u0a21\n\u0a21\u0a48\u0a2c\u0a3f\u0a1f \u0a15\u0a3e\u0a30\u0a21\n\u0a28\u0a48\u0a71\u0a1f \u0a2c\u0a48\u0a02\u0a15\u0a3f\u0a70\u0a17\n\u0a2f\u0a42\u0a2a\u0a40\u0a06\u0a08\n\u0a2a\u0a47\u0a1f\u0a40\u0a10\u0a2e"},{question:"SRN \u0a15\u0a40 \u0a39\u0a48?",answer:"SRN 14 \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a3e \u0a38\u0a47\u0a35\u0a3e \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a28\u0a70\u0a2c\u0a30 \u0a39\u0a48 \u0a1c\u0a4b \u0a06\u0a27\u0a3e\u0a30 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26 \u0a24\u0a3f\u0a06\u0a30 \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a1c\u0a26\u0a4b\u0a02 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a38\u0a2a\u0a41\u0a30\u0a26 \u0a15\u0a30\u0a28\u0a3e \u0a38\u0a3c\u0a41\u0a30\u0a42 \u0a15\u0a30\u0a26\u0a47 \u0a39\u0a4b \u0a24\u0a3e\u0a02 \u0a07\u0a39 \u0a09\u0a24\u0a2a\u0a70\u0a28 \u0a39\u0a4b \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a3e\u0964 \u0a32\u0a48\u0a23-\u0a26\u0a47\u0a23 \u0a26\u0a47 \u0a2a\u0a42\u0a30\u0a3e \u0a39\u0a4b\u0a23 \u0a24\u0a71\u0a15 '\u0a30\u0a3f\u0a1c\u0a3c\u0a3f\u0a0a\u0a2e' \u0a35\u0a3f\u0a15\u0a32\u0a2a \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e\u0964"},{question:"AWB \u0a28\u0a70\u0a2c\u0a30 \u0a15\u0a40 \u0a39\u0a48?",answer:"\u0a0f\u0a05\u0a30\u0a35\u0a47\u0a05 \u0a2c\u0a3f\u0a71\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a09\u0a39 \u0a1f\u0a30\u0a48\u0a15\u0a3f\u0a70\u0a17 \u0a28\u0a70\u0a2c\u0a30 \u0a39\u0a48 \u0a1c\u0a4b \u0a21\u0a40\u0a13\u0a2a\u0a40 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a24\u0a3f\u0a06\u0a30 \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48, \u0a2d\u0a3e\u0a35 \u0a07\u0a70\u0a21\u0a40\u0a06 \u0a38\u0a2a\u0a40\u0a21 \u0a2a\u0a4b\u0a38\u0a1f \u0a09\u0a38 \u0a05\u0a38\u0a3e\u0a08\u0a28\u0a2e\u0a48\u0a02\u0a1f/\u0a09\u0a24\u0a2a\u0a3e\u0a26 \u0a32\u0a08 \u0a1c\u0a4b \u0a09\u0a39 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a47 \u0a39\u0a28\u0964"},{question:"\u0a15\u0a40 \u0a1c\u0a47 \u0a35\u0a38\u0a28\u0a40\u0a15 \u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21 \u0a28\u0a42\u0a70 \u0a09\u0a39\u0a28\u0a3e\u0a02 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a28\u0a3e\u0a32 \u0a2a\u0a4d\u0a30\u0a3f\u0a70\u0a1f \u0a15\u0a30\u0a35\u0a3e\u0a09\u0a23\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a47 \u0a39\u0a28 \u0a1c\u0a4b \u0a09\u0a39 \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a47 \u0a39\u0a28?",answer:"\u0a1c\u0a47\u0a15\u0a30 \u0a35\u0a38\u0a28\u0a40\u0a15 \u0a2a\u0a4d\u0a30\u0a3f\u0a70\u0a1f \u0a15\u0a40\u0a24\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a71\u0a24\u0a30 \u0a1c\u0a3e\u0a02 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21 \u0a26\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a15\u0a41\u0a1d \u0a2c\u0a26\u0a32\u0a3e\u0a05 \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a47 \u0a39\u0a28, \u0a24\u0a3e\u0a02 \u0a09\u0a28\u0a4d\u0a39\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a38\u0a25\u0a3e\u0a08 \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a23 \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a1c\u0a3e\u0a02 SSUP \u0a2a\u0a4b\u0a30\u0a1f\u0a32 (\u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f '\u0a24\u0a47 \u0a28\u0a3f\u0a30\u0a2d\u0a30) '\u0a24\u0a47 \u0a1c\u0a3e \u0a15\u0a47 \u0a06\u0a2a\u0a23\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28\u0a3e \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e \u0a05\u0a24\u0a47 \u0a2b\u0a3f\u0a30 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a15\u0a30\u0a28\u0a40 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a40 \u0a15\u0a3f\u0a09\u0a02\u0a15\u0a3f \u0a07\u0a38 \u0a38\u0a39\u0a42\u0a32\u0a24 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21/\u0a32\u0a48\u0a1f\u0a30 \u0a26\u0a40 \u0a39\u0a3e\u0a30\u0a21 \u0a15\u0a3e\u0a2a\u0a40 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40 \u0a39\u0a48 l"},{question:"\u0a38\u0a2b\u0a32 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26 '\u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21' \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30\u0a28 \u0a35\u0a3f\u0a71\u0a1a \u0a15\u0a3f\u0a70\u0a28\u0a47 \u0a26\u0a3f\u0a28 \u0a32\u0a71\u0a17\u0a23\u0a17\u0a47?",answer:"\u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a24\u0a4b\u0a02 \u0a06\u0a27\u0a3e\u0a30 PVC \u0a15\u0a3e\u0a30\u0a21 \u0a32\u0a08 \u0a06\u0a30\u0a21\u0a30 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26, UIDAI \u0a2a\u0a4d\u0a30\u0a3f\u0a70\u0a1f \u0a15\u0a40\u0a24\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a3e\u0a30\u0a21 5 \u0a15\u0a70\u0a2e\u0a15\u0a3e\u0a1c\u0a40 \u0a26\u0a3f\u0a28\u0a3e\u0a02 (\u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a26\u0a40 \u0a2e\u0a3f\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a1b\u0a71\u0a21 \u0a15\u0a47) \u0a26\u0a47 \u0a05\u0a70\u0a26\u0a30 \u0a21\u0a40\u0a13\u0a2a\u0a40 \u0a28\u0a42\u0a70 \u0a38\u0a4c\u0a02\u0a2a\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21 \u0a28\u0a42\u0a70 \u0a38\u0a2a\u0a40\u0a21 \u0a2a\u0a4b\u0a38\u0a1f \u0a38\u0a30\u0a35\u0a3f\u0a38 \u0a06\u0a2b\u0a3c \u0a07\u0a70\u0a21\u0a40\u0a06 \u0a2a\u0a4b\u0a38\u0a1f \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a3e\u0a1f\u0a3e\u0a2c\u0a47\u0a38 \u0a35\u0a3f\u0a71\u0a1a \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30 \u0a15\u0a40\u0a24\u0a47 \u0a2a\u0a24\u0a47 '\u0a24\u0a47 \u0a2e\u0a4c\u0a1c\u0a42\u0a26\u0a3e \u0a21\u0a3f\u0a32\u0a40\u0a35\u0a30\u0a40 \u0a28\u0a3f\u0a2f\u0a2e\u0a3e\u0a02 \u0a26\u0a47 \u0a05\u0a28\u0a41\u0a38\u0a3e\u0a30 \u0a21\u0a3f\u0a32\u0a40\u0a35\u0a30 \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a07\u0a71\u0a15 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 https://www.indiapost.gov.in/_layouts/15/dop.portal.track '\u0a24\u0a47 DoP \u0a1f\u0a30\u0a48\u0a15\u0a3f\u0a70\u0a17 \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a21\u0a3f\u0a32\u0a40\u0a35\u0a30\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a1f\u0a30\u0a48\u0a15 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964"}],verifyEmailMobile:[{question:"\u0a15\u0a40 \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a5e\u0a3f\u0a15 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a26\u0a47 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08 \u0a15\u0a4b\u0a08 \u0a2b\u0a40\u0a38 \u0a38\u0a3c\u0a3e\u0a2e\u0a32 \u0a39\u0a48?",answer:"\u0a39\u0a3e\u0a02, \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a2b\u0a3f\u0a15 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a26\u0a47 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08 \u0a24\u0a41\u0a39\u0a3e\u0a28\u0a42\u0a70 50/- \u0a30\u0a41\u0a2a\u0a0f (\u0a1c\u0a40\u0a10\u0a38\u0a1f\u0a40 \u0a38\u0a2e\u0a47\u0a24) \u0a05\u0a26\u0a3e \u0a15\u0a30\u0a28\u0a47 \u0a2a\u0a48\u0a23\u0a17\u0a47\u0964"}],orderAadhaarPvcCard:[{question:"\u0a07\u0a71\u0a15 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a15\u0a3f\u0a71\u0a25\u0a4b\u0a02 \u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a3e\u0a0a\u0a28\u0a32\u0a4b\u0a21 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48?",answer:"\u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 UIDAI \u0a26\u0a47 MyAadhaar \u0a2a\u0a4b\u0a30\u0a1f\u0a32 - https://myaadhaar.uidai.gov.in '\u0a24\u0a47 \u0a1c\u0a3e \u0a15\u0a47 \u0a1c\u0a3e\u0a02 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a2b\u0a4b\u0a28\u0a3e\u0a02 \u0a32\u0a08 mAadhaar \u0a10\u0a2a \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a3e\u0a0a\u0a28\u0a32\u0a4b\u0a21 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28 \u0964"}],retrieveEidAadhaarNumber:[{question:"\u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a47\u0a1f\u0a3e \u0a28\u0a42\u0a70 \u0a15\u0a3f\u0a70\u0a28\u0a40 \u0a35\u0a3e\u0a30 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48?",answer:"\u0a06\u0a27\u0a3e\u0a30 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a26\u0a47 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08 \u0a39\u0a47\u0a20 \u0a32\u0a3f\u0a16\u0a40\u0a06\u0a02 \u0a38\u0a40\u0a2e\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a3e\u0a17\u0a42 \u0a39\u0a28:\n\u2022 \u0a28\u0a3e\u0a2e: \u0a1c\u0a40\u0a35\u0a28 \u0a15\u0a3e\u0a32 \u0a35\u0a3f\u0a71\u0a1a \u0a26\u0a4b \u0a35\u0a3e\u0a30\n\u2022 \u0a32\u0a3f\u0a70\u0a17: \u0a1c\u0a40\u0a35\u0a28 \u0a15\u0a3e\u0a32 \u0a35\u0a3f\u0a71\u0a1a \u0a07\u0a71\u0a15 \u0a35\u0a3e\u0a30\n\u2022 \u0a1c\u0a28\u0a2e \u0a2e\u0a3f\u0a24\u0a40: \u0a1c\u0a40\u0a35\u0a28 \u0a15\u0a3e\u0a32 \u0a35\u0a3f\u0a71\u0a1a \u0a07\u0a71\u0a15 \u0a35\u0a3e\u0a30"},{question:"\u0a2e\u0a48\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a06\u0a2a\u0a23\u0a47 \u0a28\u0a3e\u0a2e \u0a35\u0a3f\u0a71\u0a1a \u0a15\u0a40 \u0a2c\u0a26\u0a32\u0a3e\u0a05 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a3e\u0a02?",answer:"\u0a06\u0a2a\u0a23\u0a47 \u0a28\u0a3e\u0a2e \u0a35\u0a3f\u0a71\u0a1a \u0a2e\u0a3e\u0a2e\u0a42\u0a32\u0a40 \u0a38\u0a41\u0a27\u0a3e\u0a30\u0a3e\u0a02 \u0a1c\u0a3e\u0a02 \u0a28\u0a3e\u0a2e \u0a35\u0a3f\u0a71\u0a1a \u0a24\u0a2c\u0a26\u0a40\u0a32\u0a40 \u0a32\u0a08, \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a28\u0a1c\u0a3c\u0a26\u0a40\u0a15\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a1c\u0a3e\u0a13\u0964"},{question:"\u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a10\u0a21\u0a30\u0a48\u0a71\u0a38 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08 \u0a15\u0a3f\u0a39\u0a5c\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a48?",answer:"\u0a38\u0a39\u0a3e\u0a07\u0a15 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a38\u0a42\u0a1a\u0a40 \u0a26\u0a47 \u0a05\u0a28\u0a41\u0a38\u0a3e\u0a30 POA \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a40\u0964 https://uidai.gov.in '\u0a24\u0a47 \u0a1c\u0a3e\u0a13\u0964"},{question:"\u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a24\u0a47 \u0a28\u0a42\u0a70 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a15\u0a3f\u0a39\u0a5c\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a32\u0a4b\u0a5c\u0a40\u0a02\u0a26\u0a47 \u0a39\u0a28?",answer:"\u0a38\u0a39\u0a3e\u0a07\u0a15 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a26\u0a40 \u0a38\u0a42\u0a1a\u0a40 \u0a1c\u0a3f\u0a28\u0a4d\u0a39\u0a3e\u0a02 \u0a35\u0a3f\u0a71\u0a1a\u0a4b\u0a02 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a1a\u0a41\u0a23 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b, \u0a07\u0a71\u0a25\u0a47 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a39\u0a48\u0964 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a38\u0a42\u0a1a\u0a40 \u0a35\u0a3f\u0a71\u0a1a\u0a4b\u0a02 \u0a09\u0a1a\u0a3f\u0a24 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a26\u0a40 \u0a1a\u0a4b\u0a23 \u0a15\u0a30\u0a4b \u0a05\u0a24\u0a47 \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a2b\u0a3f\u0a15 \u0a38\u0a70\u0a2c\u0a70\u0a27\u0a40 \u0a21\u0a47\u0a1f\u0a3e \u0a38\u0a41\u0a27\u0a3e\u0a30 \u0a15\u0a30\u0a26\u0a47 \u0a38\u0a2e\u0a47\u0a02 \u0a09\u0a38 \u0a26\u0a3e \u0a07\u0a71\u0a15 \u0a38\u0a15\u0a48\u0a28/\u0a1a\u0a3f\u0a71\u0a24\u0a30 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a4b\u0964"},{question:"\u0a10\u0a21\u0a30\u0a48\u0a71\u0a38 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a38\u0a47\u0a35\u0a3e \u0a26\u0a47 \u0a2e\u0a3e\u0a2e\u0a32\u0a47 \u0a35\u0a3f\u0a71\u0a1a \u0a2e\u0a48\u0a02 \u0a06\u0a2a\u0a23\u0a47 \u0a38\u0a39\u0a3e\u0a07\u0a15 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a3e\u0a02?",answer:"\u0a24\u0a41\u0a39\u0a3e\u0a28\u0a42\u0a70 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a10\u0a21\u0a30\u0a48\u0a71\u0a38 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a38\u0a47\u0a35\u0a3e \u0a35\u0a3f\u0a71\u0a1a pdf \u0a1c\u0a3e\u0a02 jpeg \u0a2b\u0a3e\u0a30\u0a2e\u0a48\u0a1f \u0a35\u0a3f\u0a71\u0a1a \u0a38\u0a39\u0a3e\u0a07\u0a15 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a26\u0a40 \u0a38\u0a15\u0a48\u0a28/\u0a1a\u0a3f\u0a71\u0a24\u0a30 \u0a05\u0a71\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a15\u0a3f\u0a39\u0a3e \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a3e\u0964 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a26\u0a40 \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a32\u0a08 \u0a38\u0a39\u0a40 \u0a38\u0a39\u0a3e\u0a07\u0a15 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a05\u0a71\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a4b\u0964 \u0a2a\u0a3e\u0a38\u0a2a\u0a4b\u0a30\u0a1f, \u0a15\u0a3f\u0a30\u0a3e\u0a0f \u0a05\u0a24\u0a47 \u0a1c\u0a3e\u0a07\u0a26\u0a3e\u0a26 \u0a38\u0a2e\u0a1d\u0a4c\u0a24\u0a47 \u0a35\u0a30\u0a17\u0a47 \u0a15\u0a41\u0a1d \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a32\u0a08, \u0a15\u0a08 \u0a2a\u0a70\u0a28\u0a3f\u0a06\u0a02 \u0a26\u0a40 \u0a24\u0a38\u0a35\u0a40\u0a30 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a40\u0964"},{question:"\u0a15\u0a40 \u0a2e\u0a48\u0a02 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a06\u0a27\u0a3e\u0a30 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a38\u0a47\u0a35\u0a3e \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a06\u0a2a\u0a23\u0a40 \u0a38\u0a25\u0a3e\u0a28\u0a15 \u0a2d\u0a3e\u0a38\u0a3c\u0a3e \u0a28\u0a42\u0a70 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e/\u0a38\u0a15\u0a26\u0a40 \u0a39\u0a3e\u0a02?",answer:"\u0a2b\u0a3f\u0a32\u0a39\u0a3e\u0a32 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a06\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a2a\u0a4b\u0a30\u0a1f\u0a32 \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a06\u0a2a\u0a23\u0a40 \u0a38\u0a25\u0a3e\u0a28\u0a15 \u0a2d\u0a3e\u0a38\u0a3c\u0a3e \u0a28\u0a42\u0a70 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a28\u0a39\u0a40\u0a02 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964"},{question:"\u0a15\u0a40 \u0a2e\u0a48\u0a02 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a06\u0a27\u0a3e\u0a30 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a38\u0a47\u0a35\u0a3e \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a06\u0a2a\u0a23\u0a40 \u0a1c\u0a28\u0a2e \u0a2e\u0a3f\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e/\u0a38\u0a15\u0a26\u0a40 \u0a39\u0a3e\u0a02?",answer:"\u0a28\u0a39\u0a40\u0a02, \u0a1c\u0a28\u0a2e \u0a2e\u0a3f\u0a24\u0a40 (DoB) \u0a28\u0a42\u0a70 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 DoB \u0a38\u0a2c\u0a42\u0a24 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a26\u0a47 \u0a28\u0a3e\u0a32 \u0a28\u0a1c\u0a3c\u0a26\u0a40\u0a15\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30 '\u0a24\u0a47 \u0a1c\u0a3e\u0a13\u0964"},{question:"\u0a2e\u0a48\u0a02 \u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a39\u0a40 \u0a07\u0a71\u0a15 \u0a35\u0a3e\u0a30 \u0a1c\u0a28\u0a2e \u0a2e\u0a3f\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a40\u0a24\u0a3e \u0a39\u0a48\u0964 \u0a15\u0a40 \u0a2e\u0a48\u0a02 \u0a07\u0a38\u0a28\u0a42\u0a70 \u0a05\u0a2a\u0a21\u0a47\u0a1f/\u0a38\u0a39\u0a40 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e/\u0a38\u0a15\u0a26\u0a40 \u0a39\u0a3e\u0a02?",answer:"\u0a28\u0a39\u0a40\u0a02\u0964 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a06\u0a2a\u0a23\u0a40 \u0a1c\u0a28\u0a2e \u0a2e\u0a3f\u0a24\u0a40 (DoB) \u0a28\u0a42\u0a70 \u0a38\u0a3f\u0a30\u0a2b\u0a3c \u0a07\u0a71\u0a15 \u0a35\u0a3e\u0a30 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964 \u0a39\u0a4b\u0a30 \u0a1c\u0a28\u0a2e \u0a2e\u0a3f\u0a24\u0a40 (DoB) \u0a05\u0a38\u0a27\u0a3e\u0a30\u0a28 \u0a39\u0a3e\u0a32\u0a24\u0a3e\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a2c\u0a26\u0a32\u0a40 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40 \u0a39\u0a48, \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a07\u0a38 \u0a38\u0a2c\u0a70\u0a27 \u0a35\u0a3f\u0a71\u0a1a 1947 '\u0a24\u0a47 \u0a15\u0a3e\u0a32 \u0a15\u0a30\u0a4b\u0964"},{question:"\u0a15\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e \u0a15\u0a30\u0a28\u0a3e \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a5e\u0a3f\u0a15 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a26\u0a47 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a26\u0a40 \u0a17\u0a3e\u0a30\u0a70\u0a1f\u0a40 \u0a39\u0a48?",answer:"\u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a3e\u0a09\u0a23\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a47\u0a1f\u0a3e \u0a26\u0a47 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a26\u0a40 \u0a17\u0a3e\u0a30\u0a70\u0a1f\u0a40 \u0a28\u0a39\u0a40\u0a02 \u0a26\u0a3f\u0a70\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a06\u0a27\u0a3e\u0a30 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a38\u0a47\u0a35\u0a3e \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a40\u0a24\u0a47 \u0a17\u0a0f \u0a2c\u0a26\u0a32\u0a3e\u0a05 \u0a2f\u0a42\u0a06\u0a08\u0a21\u0a40\u0a0f\u0a06\u0a08 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a2a\u0a41\u0a38\u0a3c\u0a1f\u0a40\u0a15\u0a30\u0a28 \u0a05\u0a24\u0a47 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e \u0a26\u0a47 \u0a05\u0a27\u0a40\u0a28 \u0a39\u0a28 \u0a05\u0a24\u0a47 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26 \u0a06\u0a27\u0a3e\u0a30 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08 \u0a38\u0a3f\u0a30\u0a2b \u0a24\u0a2c\u0a26\u0a40\u0a32\u0a40 \u0a26\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 '\u0a24\u0a47 \u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48\u0964"},{question:"\u0a2e\u0a47\u0a30\u0a3e \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a17\u0a41\u0a06\u0a1a \u0a17\u0a3f\u0a06 \u0a39\u0a48/ \u0a2e\u0a47\u0a30\u0a47 \u0a15\u0a4b\u0a32 \u0a09\u0a39 \u0a28\u0a70\u0a2c\u0a30 \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a48 \u0a1c\u0a4b \u0a2e\u0a48\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a3e\u0a32 \u0a26\u0a30\u0a1c \u0a15\u0a40\u0a24\u0a3e \u0a38\u0a40\u0964 \u0a2e\u0a48\u0a28\u0a42\u0a70 \u0a06\u0a2a\u0a23\u0a40 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a28\u0a40 \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a40 \u0a39\u0a48?",answer:"\u0a1c\u0a47\u0a15\u0a30 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a15\u0a4b\u0a32 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a3e\u0a32 \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a17\u0a41\u0a06\u0a1a \u0a17\u0a3f\u0a06/\u0a28\u0a39\u0a40\u0a02 \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a24\u0a41\u0a39\u0a3e\u0a28\u0a42\u0a70 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a28\u0a3f\u0a71\u0a1c\u0a40 \u0a24\u0a4c\u0a30 '\u0a24\u0a47 \u0a28\u0a1c\u0a3c\u0a26\u0a40\u0a15\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30 '\u0a24\u0a47 \u0a1c\u0a3e\u0a23\u0a3e \u0a2a\u0a35\u0a47\u0a17\u0a3e\u0964"},{question:"\u0a15\u0a40 \u0a2e\u0a47\u0a30\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a39\u0a4b\u0a23 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26 \u0a2c\u0a26\u0a32 \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a3e?",answer:"\u0a28\u0a39\u0a40\u0a02, \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26 \u0a35\u0a40 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a09\u0a39\u0a40 \u0a30\u0a39\u0a47\u0a17\u0a3e\u0964"},{question:"\u0a2e\u0a48\u0a02 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a26\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a30\u0a71\u0a26 \u0a15\u0a30\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a3e/\u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a40 \u0a39\u0a3e\u0a02\u0964 \u0a15\u0a40 \u0a2e\u0a48\u0a02 \u0a07\u0a39 \u0a15\u0a30\u0a28 \u0a26\u0a47 \u0a2f\u0a4b\u0a17 \u0a39\u0a4b\u0a35\u0a3e\u0a02\u0a17\u0a3e?",answer:"\u0a07\u0a71\u0a15 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 myAadhaar \u0a21\u0a48\u0a38\u0a3c\u0a2c\u0a4b\u0a30\u0a21 \u0a35\u0a3f\u0a71\u0a1a '\u0a2c\u0a47\u0a28\u0a24\u0a40' \u0a38\u0a2a\u0a47\u0a38 \u0a24\u0a4b\u0a02 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a30\u0a71\u0a26 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48 \u0a1c\u0a26\u0a4b\u0a02 \u0a24\u0a71\u0a15 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a05\u0a17\u0a32\u0a40 \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a32\u0a08 \u0a28\u0a39\u0a40\u0a02 \u0a1a\u0a41\u0a71\u0a15\u0a3f\u0a06 \u0a1c\u0a3e\u0a02\u0a26\u0a3e\u0964 \u0a1c\u0a47\u0a15\u0a30 \u0a30\u0a71\u0a26 \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a40\u0a24\u0a40 \u0a17\u0a08 \u0a30\u0a15\u0a2e 21 \u0a26\u0a3f\u0a28\u0a3e\u0a02 \u0a26\u0a47 \u0a05\u0a70\u0a26\u0a30 \u0a16\u0a3e\u0a24\u0a47 \u0a35\u0a3f\u0a71\u0a1a \u0a35\u0a3e\u0a2a\u0a38 \u0a15\u0a30 \u0a26\u0a3f\u0a71\u0a24\u0a40 \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a40\u0964"},{question:"\u0a2e\u0a48\u0a02 \u0a06\u0a2a\u0a23\u0a40\u0a06\u0a02 \u0a38\u0a3e\u0a30\u0a40\u0a06\u0a02 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a2c\u0a47\u0a28\u0a24\u0a40\u0a06\u0a02 \u0a15\u0a3f\u0a71\u0a25\u0a47 \u0a26\u0a47\u0a16 \u0a38\u0a15\u0a26\u0a3e/\u0a38\u0a15\u0a26\u0a40 \u0a39\u0a3e\u0a02?",answer:"\u0a07\u0a71\u0a15 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 myAadhaar \u0a21\u0a48\u0a38\u0a3c\u0a2c\u0a4b\u0a30\u0a21 \u0a26\u0a47 \u0a05\u0a70\u0a26\u0a30 '\u0a2c\u0a47\u0a28\u0a24\u0a40' \u0a38\u0a2a\u0a47\u0a38 \u0a26\u0a47 \u0a05\u0a70\u0a26\u0a30 \u0a06\u0a2a\u0a23\u0a40\u0a06\u0a02 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a2c\u0a47\u0a28\u0a24\u0a40\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a26\u0a47\u0a16 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964"},{question:"\u0a2e\u0a48\u0a02 \u0a06\u0a2a\u0a23\u0a47 \u0a2a\u0a24\u0a47 \u0a35\u0a3f\u0a71\u0a1a \u0a06\u0a2a\u0a23\u0a47 \u0a2a\u0a3f\u0a24\u0a3e / \u0a2a\u0a24\u0a40 \u0a26\u0a3e \u0a28\u0a3e\u0a2e \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a38\u0a3c\u0a3e\u0a2e\u0a32 \u0a15\u0a30\u0a3e\u0a02?",answer:"\u0a30\u0a3f\u0a38\u0a3c\u0a24\u0a47 \u0a26\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a2a\u0a24\u0a3e \u0a16\u0a47\u0a24\u0a30 \u0a26\u0a3e \u0a07\u0a71\u0a15 \u0a39\u0a3f\u0a71\u0a38\u0a3e \u0a39\u0a28\u0964 \u0a07\u0a38\u0a28\u0a42\u0a70 C/o (\u0a26\u0a47\u0a16\u0a2d\u0a3e\u0a32) \u0a32\u0a08 \u0a2e\u0a3e\u0a28\u0a15\u0a40\u0a15\u0a30\u0a28 \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a39\u0a48\u0964 \u0a07\u0a38 \u0a28\u0a42\u0a70 \u0a2d\u0a30\u0a28\u0a3e \u0a35\u0a3f\u0a15\u0a32\u0a2a\u0a3f\u0a15 \u0a39\u0a48\u0964"}],eaadhaarDownload:[{question:"\u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a40 \u0a39\u0a48?",answer:"\u0a08-\u0a06\u0a27\u0a3e\u0a30, \u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a40 \u0a2a\u0a3e\u0a38\u0a35\u0a30\u0a21 \u0a28\u0a3e\u0a32 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a05\u0a24 \u0a07\u0a32\u0a48\u0a15\u0a1f\u0a4d\u0a30\u0a3e\u0a28\u0a3f\u0a15 \u0a15\u0a3e\u0a2a\u0a40 \u0a39\u0a48, \u0a1c\u0a3f\u0a38 '\u0a24\u0a47 UIDAI \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a21\u0a3f\u0a1c\u0a3c\u0a40\u0a1f\u0a32 \u0a39\u0a38\u0a24\u0a3e\u0a16\u0a30 \u0a15\u0a40\u0a24\u0a47 \u0a17\u0a0f \u0a39\u0a28\u0964"},{question:"\u0a15\u0a40 \u0a08-\u0a06\u0a27\u0a3e\u0a30, \u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a40 \u0a2d\u0a4c\u0a24\u0a3f\u0a15 \u0a15\u0a3e\u0a2a\u0a40 \u0a35\u0a3e\u0a02\u0a17 \u0a39\u0a40 \u0a35\u0a48\u0a27 \u0a39\u0a48?",answer:"\u0a06\u0a27\u0a3e\u0a30 \u0a10\u0a15\u0a1f \u0a26\u0a47 \u0a05\u0a28\u0a41\u0a38\u0a3e\u0a30, \u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a3e\u0a30\u0a47 \u0a09\u0a26\u0a47\u0a38\u0a3c\u0a3e\u0a02 \u0a32\u0a08 \u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a40 \u0a2d\u0a4c\u0a24\u0a3f\u0a15 \u0a15\u0a3e\u0a2a\u0a40 \u0a35\u0a3e\u0a02\u0a17 \u0a39\u0a40 \u0a35\u0a48\u0a27 \u0a39\u0a48\u0964 \u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a40 \u0a35\u0a48\u0a27\u0a24\u0a3e \u0a32\u0a08, \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 UIDAI \u0a38\u0a30\u0a15\u0a42\u0a32\u0a30- https://uidai.gov.in/images/ uidai_om_on_e_aadhaar_validity.pdf '\u0a24\u0a47 \u0a1c\u0a3e\u0a13"},{question:"\u0a2e\u0a3e\u0a38\u0a15\u0a21 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a40 \u0a39\u0a48?",answer:"\u0a2e\u0a3e\u0a38\u0a15\u0a21 \u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a3e \u0a2e\u0a24\u0a32\u0a2c \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a47 \u0a2a\u0a39\u0a3f\u0a32\u0a47 8 \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u201cxxxx-xxxx\u201d \u0a28\u0a3e\u0a32 \u0a2c\u0a26\u0a32\u0a23\u0a3e \u0a39\u0a48 \u0a1c\u0a26\u0a15\u0a3f \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a47 \u0a38\u0a3f\u0a30\u0a2b\u0a3c \u0a06\u0a16\u0a30\u0a40 4 \u0a05\u0a70\u0a15 \u0a39\u0a40 \u0a26\u0a3f\u0a16\u0a3e\u0a08 \u0a26\u0a3f\u0a70\u0a26\u0a47 \u0a39\u0a28\u0964"},{question:"\u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a21\u0a3f\u0a1c\u0a40\u0a1f\u0a32 \u0a26\u0a38\u0a24\u0a16\u0a24\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a24 \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e\u0a35\u0a47?",answer:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a06\u0a27\u0a3e\u0a30 YouTube \u0a1a\u0a48\u0a28\u0a32 '\u0a24\u0a47 \u0a1c\u0a3e\u0a13 \u0a05\u0a24\u0a47 https://youtu.be/aVNfUNIccZs?si=ByW1O6BIPMwc0seL '\u0a24\u0a47 \u0a1f\u0a3f\u0a0a\u0a1f\u0a4b\u0a30\u0a3f\u0a05\u0a32 \u0a32\u0a3f\u0a70\u0a15 \u0a26\u0a47\u0a16\u0a4b"},{question:"\u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a3e \u0a2a\u0a3e\u0a38\u0a35\u0a30\u0a21 \u0a15\u0a40 \u0a39\u0a48?",answer:"\u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a3e \u0a2a\u0a3e\u0a38\u0a35\u0a30\u0a21 \u0a15\u0a48\u0a2a\u0a40\u0a1f\u0a32 \u0a35\u0a3f\u0a71\u0a1a \u0a28\u0a3e\u0a2e \u0a26\u0a47 \u0a2a\u0a39\u0a3f\u0a32\u0a47 4 \u0a05\u0a71\u0a16\u0a30\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a1c\u0a28\u0a2e \u0a26\u0a47 \u0a38\u0a3e\u0a32 (YYYY) \u0a26\u0a3e \u0a38\u0a41\u0a2e\u0a47\u0a32 \u0a39\u0a48\u0964\n\u0a09\u0a26\u0a3e\u0a39\u0a30\u0a23 \u0a32\u0a08:\n\u0a09\u0a26\u0a3e\u0a39\u0a30\u0a28 1\n\u0a28\u0a3e\u0a2e: SURESH KUMAR\n\u0a1c\u0a28\u0a2e \u0a26\u0a3e \u0a38\u0a3e\u0a32: 1990\n\u0a2a\u0a3e\u0a38\u0a35\u0a30\u0a21: SURE1990\n\u0a09\u0a26\u0a3e\u0a39\u0a30\u0a28 2\n\u0a28\u0a3e\u0a2e: SAI KUMAR\n\u0a1c\u0a28\u0a2e \u0a26\u0a3e \u0a38\u0a3e\u0a32: 1990\n\u0a2a\u0a3e\u0a38\u0a35\u0a30\u0a21:  SAIK1990\n\u0a09\u0a26\u0a3e\u0a39\u0a30\u0a28 3\n\u0a28\u0a3e\u0a2e: P. KUMAR\n\u0a1c\u0a28\u0a2e \u0a26\u0a3e \u0a38\u0a3e\u0a32: 1990\n\u0a2a\u0a3e\u0a38\u0a35\u0a30\u0a21:  P.KU1990\n\u0a09\u0a26\u0a3e\u0a39\u0a30\u0a28 4\n\u0a28\u0a3e\u0a2e: RIA\n\u0a1c\u0a28\u0a2e \u0a26\u0a3e \u0a38\u0a3e\u0a32: 1990\n\u0a2a\u0a3e\u0a38\u0a35\u0a30\u0a21:  RIA1990"},{question:"\u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a16\u0a4b\u0a32\u0a4d\u0a39\u0a23 \u0a32\u0a08 \u0a15\u0a3f\u0a39\u0a5c\u0a47 \u0a38\u0a39\u0a3e\u0a07\u0a15 \u0a38\u0a3e\u0a2b\u0a1f\u0a35\u0a47\u0a05\u0a30 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a48?",answer:"\u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a28\u0a42\u0a70 \u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a26\u0a47\u0a16\u0a23 \u0a32\u0a08 'Adobe Reader' \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a48\u0964 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a38\u0a3f\u0a38\u0a1f\u0a2e \u0a35\u0a3f\u0a71\u0a1a 'Adobe Reader' \u0a07\u0a70\u0a38\u0a1f\u0a3e\u0a32 \u0a39\u0a48\u0964 \u0a38\u0a3f\u0a38\u0a1f\u0a2e \u0a35\u0a3f\u0a71\u0a1a Adobe Reader \u0a28\u0a42\u0a70 \u0a07\u0a70\u0a38\u0a1f\u0a3e\u0a32 \u0a15\u0a30\u0a28 \u0a32\u0a08\nhttps://get.adobe.com/reader/ '\u0a24\u0a47 \u0a1c\u0a3e\u0a13 l"},{question:"\u0a07\u0a71\u0a15 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a21\u0a3e\u0a0a\u0a28\u0a32\u0a4b\u0a21 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48?",answer:"\u0a07\u0a71\u0a15 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a24\u0a3f\u0a70\u0a28 \u0a24\u0a30\u0a40\u0a15\u0a3f\u0a06\u0a02 \u0a28\u0a3e\u0a32 \u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a3e\u0a0a\u0a28\u0a32\u0a4b\u0a21 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964\n\u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a28 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47:\n\u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47:\nVID \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47:\n\u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a21\u0a3e\u0a0a\u0a28\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a28 \u0a32\u0a08 OTP \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 '\u0a24\u0a47 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e\u0964"}],bookAnAppointment:[{question:"UIDAI \u0a35\u0a3f\u0a71\u0a1a \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a28\u0a3f\u0a35\u0a3e\u0a30\u0a28 \u0a1a\u0a48\u0a28\u0a32 \u0a15\u0a40 \u0a39\u0a28?",answer:"'\u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40 \u0a06\u0a2a\u0a23\u0a40 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a26\u0a47 \u0a28\u0a3f\u0a2a\u0a1f\u0a3e\u0a30\u0a47 \u0a32\u0a08 \u0a15\u0a08 \u0a1a\u0a48\u0a28\u0a32\u0a3e\u0a02 \u0a1c\u0a3f\u0a35\u0a47\u0a02 \u0a15\u0a3f \u0a2b\u0a4b\u0a28, \u0a08\u0a2e\u0a47\u0a32, \u0a1a\u0a48\u0a1f, \u0a2a\u0a71\u0a24\u0a30/\u0a2a\u0a4b\u0a38\u0a1f, \u0a35\u0a48\u0a71\u0a2c \u0a2a\u0a4b\u0a30\u0a1f\u0a32, \u0a35\u0a3e\u0a15 \u0a07\u0a28 \u0a05\u0a24\u0a47 \u0a38\u0a4b\u0a38\u0a3c\u0a32 \u0a2e\u0a40\u0a21\u0a40\u0a06 \u0a30\u0a3e\u0a39\u0a40\u0a02 UIDAI \u0a24\u0a71\u0a15 \u0a2a\u0a39\u0a41\u0a70\u0a1a \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964\n\u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a1a\u0a48\u0a28\u0a32\u0a3e\u0a02 \u0a2c\u0a3e\u0a30\u0a47 \u0a35\u0a3f\u0a38\u0a24\u0a4d\u0a30\u0a3f\u0a24 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a39\u0a47\u0a20\u0a3e\u0a02 \u0a26\u0a3f\u0a71\u0a24\u0a40 \u0a17\u0a08 \u0a39\u0a48:\n1. \u0a2b\u0a3c\u0a4b\u0a28 \u0a15\u0a3e\u0a32 (\u0a1f\u0a4b\u0a32 \u0a2b\u0a4d\u0a30\u0a40 \u0a28\u0a70\u0a2c\u0a30) -\n\u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a3e\u0a32 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a1a\u0a3f\u0a70\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a08 \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40 UIDAI \u0a1f\u0a4b\u0a32 \u0a2b\u0a4d\u0a30\u0a40 \u0a28\u0a70\u0a2c\u0a30 (1947) '\u0a24\u0a47 \u0a38\u0a70\u0a2a\u0a30\u0a15 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964 UIDAI \u0a38\u0a70\u0a2a\u0a30\u0a15 \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a07\u0a71\u0a15 \u0a38\u0a35\u0a48 \u0a38\u0a47\u0a35\u0a3e IVRS (\u0a07\u0a70\u0a1f\u0a30\u0a10\u0a15\u0a1f\u0a3f\u0a35 \u0a35\u0a3e\u0a07\u0a38 \u0a30\u0a3f\u0a38\u0a2a\u0a3e\u0a02\u0a38 \u0a38\u0a3f\u0a38\u0a1f\u0a2e) \u0a05\u0a24\u0a47 \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40\u0a17\u0a24 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a15\u0a3e\u0a30\u0a1c\u0a15\u0a3e\u0a30\u0a40 \u0a06\u0a27\u0a3e\u0a30\u0a3f\u0a24 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a38\u0a3c\u0a3e\u0a2e\u0a32 \u0a39\u0a41\u0a70\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40 \u0a06\u0a2a\u0a23\u0a40 \u0a38\u0a4c\u0a16 \u0a05\u0a28\u0a41\u0a38\u0a3e\u0a30 \u0a38\u0a70\u0a1a\u0a3e\u0a30 \u0a32\u0a08 \u0a39\u0a47\u0a20 \u0a32\u0a3f\u0a16\u0a40\u0a06\u0a02 \u0a2d\u0a3e\u0a38\u0a3c\u0a3e\u0a35\u0a3e\u0a02 \u0a35\u0a3f\u0a71\u0a1a\u0a4b\u0a02 \u0a15\u0a4b\u0a08 \u0a35\u0a40 \u0a1a\u0a41\u0a23 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964\n1. \u0a39\u0a3f\u0a70\u0a26\u0a40\n5. \u0a15\u0a70\u0a28\u0a5c\n9. \u0a17\u0a41\u0a1c\u0a30\u0a3e\u0a24\u0a40\n2. \u0a05\u0a70\u0a17\u0a30\u0a47\u0a1c\u0a3c\u0a40\n6. \u0a2e\u0a32\u0a3f\u0a06\u0a32\u0a2e\n10. \u0a2e\u0a30\u0a3e\u0a20\u0a40\n3. \u0a24\u0a47\u0a32\u0a17\u0a42\n7. \u0a05\u0a38\u0a3e\u0a2e\u0a40\n11. \u0a2a\u0a70\u0a1c\u0a3e\u0a2c\u0a40\n4. \u0a24\u0a3e\u0a2e\u0a3f\u0a32\n8. \u0a2c\u0a70\u0a17\u0a3e\u0a32\u0a40\n12. \u0a13\u0a21\u0a40\u0a06\n\u0a38\u0a2e\u0a3e\u0a02:\na) IVRS \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a38\u0a35\u0a48 \u0a38\u0a47\u0a35\u0a3e \u0a26\u0a3e \u0a32\u0a3e\u0a2d \u0a09\u0a20\u0a3e\u0a09\u0a23\u0a3e: IVRS \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 24X7 \u0a06\u0a27\u0a3e\u0a30 '\u0a24\u0a47 \u0a38\u0a35\u0a48 \u0a38\u0a47\u0a35\u0a3e \u0a2e\u0a4b\u0a21 \u0a35\u0a3f\u0a71\u0a1a \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a40\u0a24\u0a40\u0a06\u0a02 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40\u0a06\u0a02 \u0a39\u0a28\u0964\nb) \u0a38\u0a39\u0a3e\u0a07\u0a15 \u0a15\u0a3e\u0a30\u0a1c\u0a15\u0a3e\u0a30\u0a40 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e: \u0a07\u0a39 \u0a38\u0a47\u0a35\u0a3e \u0a38\u0a4b\u0a2e\u0a35\u0a3e\u0a30 - \u0a38\u0a3c\u0a28\u0a40\u0a35\u0a3e\u0a30: \u0a38\u0a35\u0a47\u0a30\u0a47 7 \u0a35\u0a1c\u0a47 \u0a24\u0a4b\u0a02 \u0a38\u0a3c\u0a3e\u0a2e 11 \u0a35\u0a1c\u0a47, \u0a10\u0a24\u0a35\u0a3e\u0a30: \u0a38\u0a35\u0a47\u0a30\u0a47 8 \u0a35\u0a1c\u0a47 \u0a24\u0a4b\u0a02 \u0a38\u0a3c\u0a3e\u0a2e 5 \u0a35\u0a1c\u0a47 \u0a24\u0a71\u0a15 \u0a32\u0a08 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40 \u0a39\u0a48\u0964\n\u0a06\u0a2e \u0a38\u0a35\u0a3e\u0a32\u0a3e\u0a02 \u0a26\u0a3e \u0a28\u0a3f\u0a2a\u0a1f\u0a3e\u0a30\u0a3e \u0a38\u0a70\u0a2a\u0a30\u0a15 \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a15\u0a3e\u0a30\u0a1c\u0a15\u0a3e\u0a30\u0a40 \u0a26\u0a41\u0a06\u0a30\u0a3e UIDAI \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a2a\u0a4d\u0a30\u0a35\u0a3e\u0a28\u0a3f\u0a24 \u0a2e\u0a3f\u0a06\u0a30\u0a40 \u0a1c\u0a35\u0a3e\u0a2c\u0a3e\u0a02 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a05\u0a38\u0a32 \u0a38\u0a2e\u0a47\u0a02 \u0a26\u0a47 \u0a05\u0a27\u0a3e\u0a30 '\u0a24\u0a47 UIDAI \u0a26\u0a47 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a35\u0a3f\u0a2d\u0a3e\u0a17\u0a3e\u0a02/\u0a16\u0a47\u0a24\u0a30\u0a40 \u0a26\u0a2b\u0a24\u0a30\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a38\u0a4c\u0a02\u0a2a\u0a3f\u0a06 \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a07\u0a39\u0a28\u0a3e\u0a02 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24\u0a3e\u0a02 \u0a26\u0a40 \u0a05\u0a70\u0a26\u0a30\u0a42\u0a28\u0a40 \u0a24\u0a4c\u0a30 '\u0a24\u0a47 UIDAI \u0a26\u0a47 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a21\u0a3f\u0a35\u0a40\u0a1c\u0a3c\u0a28/\u0a16\u0a47\u0a24\u0a30\u0a40 \u0a26\u0a2b\u0a3c\u0a24\u0a30\u0a3e\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48 \u0a24\u0a3e\u0a02 \u0a1c\u0a4b \u0a2a\u0a4d\u0a30\u0a2d\u0a3e\u0a35\u0a40 \u0a39\u0a71\u0a32 \u0a05\u0a24\u0a47 \u0a09\u0a38 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26 \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a38\u0a70\u0a1a\u0a3e\u0a30 \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e \u0a38\u0a15\u0a47\u0964\n2. \u0a1a\u0a48\u0a1f\u0a2c\u0a4b\u0a1f (\u0a06\u0a27\u0a3e\u0a30 \u0a2e\u0a3f\u0a71\u0a24\u0a30) - \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40 UIDAI \u0a1a\u0a48\u0a1f\u0a2c\u0a4b\u0a1f \u0a38\u0a47\u0a35\u0a3e ''\u0a06\u0a27\u0a3e\u0a30 \u0a2e\u0a3f\u0a71\u0a24\u0a30'' \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a3e\u0a32 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a06\u0a2a\u0a23\u0a40 \u0a1a\u0a3f\u0a70\u0a24\u0a3e \u0a28\u0a42\u0a70 \u0a09\u0a20\u0a3e \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28, \u0a1c\u0a4b \u0a15\u0a3f UIDAI \u0a26\u0a40 \u0a05\u0a27\u0a3f\u0a15\u0a3e\u0a30\u0a24 \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f '\u0a24\u0a47 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a39\u0a48 \u0a07\u0a38 \u0a1a\u0a48\u0a1f\u0a2c\u0a4b\u0a1f \u0a28\u0a42\u0a70 \u0a38\u0a35\u0a3e\u0a32\u0a3e\u0a02 \u0a26\u0a3e \u0a1c\u0a35\u0a3e\u0a2c \u0a26\u0a47\u0a23 \u0a32\u0a08 \u0a38\u0a3f\u0a16\u0a32\u0a3e\u0a08 \u0a26\u0a3f\u0a71\u0a24\u0a40 \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40\u0a17\u0a24 \u0a05\u0a28\u0a41\u0a2d\u0a35 \u0a28\u0a42\u0a70 \u0a2c\u0a3f\u0a39\u0a24\u0a30 \u0a2c\u0a23\u0a3e\u0a09\u0a23 \u0a26\u0a3e \u0a09\u0a26\u0a47\u0a38\u0a3c \u0a39\u0a48\u0964\n3. UIDAI \u0a35\u0a48\u0a71\u0a2c \u0a2a\u0a4b\u0a30\u0a1f\u0a32 - \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a05\u0a24\u0a47 \u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a26\u0a47 \u0a24\u0a39\u0a3f\u0a24 UIDAI \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f '\u0a24\u0a47 \u0a06\u0a2a\u0a23\u0a40 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a26\u0a30\u0a1c \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28 \u0a05\u0a24\u0a47 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28 \u0a05\u0a24\u0a47 \u0a15\u0a4d\u0a30\u0a2e\u0a35\u0a3e\u0a30 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 / \u0a2b\u0a40\u0a21\u0a2c\u0a48\u0a15 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964\n4. \u0a08\u0a2e\u0a47\u0a32 - \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a3e\u0a32 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a38\u0a35\u0a3e\u0a32 \u0a05\u0a24\u0a47 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a32\u0a08 help@uidai.gov.in '\u0a24\u0a47 \u0a08\u0a2e\u0a47\u0a32 \u0a2d\u0a47\u0a1c \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964\n5. \u0a16\u0a47\u0a24\u0a30\u0a40 \u0a26\u0a2b\u0a24\u0a30\u0a3e\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a35\u0a3e\u0a15-\u0a07\u0a28: \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40 \u0a06\u0a2a\u0a23\u0a47 \u0a38\u0a35\u0a3e\u0a32\u0a3e\u0a02 \u0a26\u0a47 \u0a39\u0a71\u0a32 \u0a32\u0a08 \u0a1c\u0a3e\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a3e\u0a32 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24\u0a3e\u0a02 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a3e\u0a09\u0a23 \u0a32\u0a08 \u0a38\u0a3f\u0a71\u0a27\u0a47 \u0a24\u0a4c\u0a30 '\u0a24\u0a47 \u0a06\u0a2a\u0a23\u0a47 \u0a30\u0a3e\u0a1c \u0a26\u0a47 \u0a05\u0a28\u0a41\u0a38\u0a3e\u0a30 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a16\u0a47\u0a24\u0a30\u0a40 \u0a26\u0a2b\u0a24\u0a30\u0a3e\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964\n6. \u0a21\u0a3e\u0a15/\u0a2a\u0a71\u0a24\u0a30: \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40 \u0a06\u0a2a\u0a23\u0a40\u0a06\u0a02 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24\u0a3e\u0a02 UIDAI HO \u0a1c\u0a3e\u0a02 \u0a16\u0a47\u0a24\u0a30\u0a40 \u0a26\u0a2b\u0a3c\u0a24\u0a30\u0a3e\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a21\u0a3e\u0a15 \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a35\u0a3e \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28 \u0a1c\u0a3e\u0a02 \u0a39\u0a71\u0a25\u0a40\u0a02 \u0a05\u0a30\u0a1c\u0a3c\u0a40 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a35\u0a3e \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a16\u0a47\u0a24\u0a30\u0a40 \u0a26\u0a2b\u0a3c\u0a24\u0a30/\u0a35\u0a3f\u0a2d\u0a3e\u0a17 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a26\u0a47 \u0a39\u0a71\u0a32 \u0a32\u0a08 \u0a32\u0a4b\u0a5c\u0a40\u0a02\u0a26\u0a47 \u0a15\u0a26\u0a2e \u0a1a\u0a41\u0a71\u0a15\u0a47\u0a17\u0a3e\u0964\n7. \u0a2d\u0a3e\u0a30\u0a24 \u0a38\u0a30\u0a15\u0a3e\u0a30 \u0a26\u0a3e \u0a1c\u0a28\u0a24\u0a15 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a2a\u0a4b\u0a30\u0a1f\u0a32 (CPGRAMS): \u0a15\u0a47\u0a02\u0a26\u0a30\u0a40\u0a15\u0a4d\u0a30\u0a3f\u0a24 \u0a1c\u0a28\u0a24\u0a15 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a28\u0a3f\u0a35\u0a3e\u0a30\u0a28 \u0a05\u0a24\u0a47 \u0a28\u0a3f\u0a17\u0a30\u0a3e\u0a28\u0a40 \u0a2a\u0a4d\u0a30\u0a23\u0a3e\u0a32\u0a40 (CPGRAMS) \u0a30\u0a3e\u0a39\u0a40\u0a02 UIDAI '\u0a24\u0a47 \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24\u0a3e\u0a02 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a35\u0a3e\u0a08\u0a06\u0a02 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40\u0a06\u0a02 \u0a39\u0a28\u0964 \u0a07\u0a39 \u0a28\u0a3e\u0a17\u0a30\u0a3f\u0a15\u0a3e\u0a02 \u0a32\u0a08 24x7 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a07\u0a71\u0a15 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e \u0a39\u0a48\u0964\n8. \u0a38\u0a4b\u0a38\u0a3c\u0a32 \u0a2e\u0a40\u0a21\u0a40\u0a06: \u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24\u0a3e\u0a02 \u0a15\u0a08 \u0a38\u0a4b\u0a38\u0a3c\u0a32 \u0a2e\u0a40\u0a21\u0a40\u0a06 \u0a2a\u0a32\u0a47\u0a1f\u0a2b\u0a3e\u0a30\u0a2e\u0a3e\u0a02 \u0a1c\u0a3f\u0a35\u0a47\u0a02 \u0a1f\u0a35\u0a3f\u0a71\u0a1f\u0a30, \u0a2b\u0a47\u0a38\u0a2c\u0a41\u0a71\u0a15, \u0a2f\u0a42 \u0a1f\u0a3f\u0a0a\u0a2c, \u0a07\u0a70\u0a38\u0a1f\u0a3e\u0a17\u0a4d\u0a30\u0a3e\u0a2e \u0a06\u0a26\u0a3f \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a26\u0a30\u0a1c \u0a15\u0a40\u0a24\u0a40\u0a06\u0a02 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40\u0a06\u0a02 \u0a39\u0a28\u0964 \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40 \u0a06\u0a2a\u0a23\u0a40 \u0a1a\u0a3f\u0a70\u0a24\u0a3e/\u0a38\u0a3c\u0a3f\u0a15\u0a3e\u0a07\u0a24 \u0a28\u0a3e\u0a32 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a2a\u0a4b\u0a38\u0a1f \u0a28\u0a42\u0a70 UIDAI \u0a28\u0a42\u0a70 \u0a1f\u0a48\u0a17 \u0a15\u0a30\u0a15\u0a47 \u0a05\u0a71\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48 \u0a1c\u0a3e\u0a02 \u0a35\u0a71\u0a16-\u0a35\u0a71\u0a16 \u0a38\u0a4b\u0a38\u0a3c\u0a32 \u0a2e\u0a40\u0a21\u0a40\u0a06 \u0a38\u0a1f\u0a4d\u0a30\u0a40\u0a2e\u0a3e\u0a02 '\u0a24\u0a47 \u0a38\u0a39\u0a3e\u0a07\u0a24\u0a3e \u0a2a\u0a70\u0a28\u0a47 '\u0a24\u0a47 DM \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964 '"},{question:"\u0a15\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30\u0a3e\u0a02 \u0a32\u0a08 \u0a38\u0a47\u0a35\u0a3e \u0a16\u0a30\u0a1a\u0a47 \u0a35\u0a71\u0a16\u0a30\u0a47 \u0a39\u0a28?",answer:"\u0a28\u0a39\u0a40\u0a02, \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30\u0a3e\u0a02 \u0a38\u0a2e\u0a47\u0a24 \u0a26\u0a47\u0a38\u0a3c \u0a26\u0a47 \u0a38\u0a3e\u0a30\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a47\u0a02\u0a26\u0a30\u0a3e\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a08 \u0a16\u0a30\u0a1a\u0a47 \u0a07\u0a71\u0a15\u0a4b \u0a1c\u0a3f\u0a39\u0a47 \u0a39\u0a28\u0964\n\u0a16\u0a30\u0a1a\u0a3f\u0a06\u0a02 \u0a32\u0a08 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a35\u0a47\u0a16\u0a4b: \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a23 \u0a05\u0a24\u0a47 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a16\u0a30\u0a1a\u0a47"},{question:"\u0a15\u0a40 \u0a2e\u0a48\u0a02 \u0a06\u0a2a\u0a23\u0a40 \u0a2e\u0a41\u0a32\u0a3e\u0a15\u0a3e\u0a24 \u0a28\u0a42\u0a70 \u0a2e\u0a41\u0a5c-\u0a24\u0a39\u0a3f/\u0a30\u0a71\u0a26 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e/\u0a38\u0a15\u0a26\u0a40 \u0a39\u0a3e\u0a02?",answer:"\u0a39\u0a3e\u0a02, \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a09\u0a38\u0a47 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30/\u0a08\u0a2e\u0a47\u0a32 \u0a06\u0a08\u0a21\u0a40 (\u0a1c\u0a3f\u0a35\u0a47\u0a02 \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a26\u0a3f\u0a71\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a38\u0a40) \u0a28\u0a3e\u0a32 \u0a2e\u0a41\u0a32\u0a3e\u0a15\u0a3e\u0a24 \u0a2a\u0a4b\u0a30\u0a1f\u0a32 \u0a35\u0a3f\u0a71\u0a1a \u0a32\u0a4c\u0a17\u0a07\u0a28 \u0a15\u0a30\u0a15\u0a47 24 \u0a18\u0a70\u0a1f\u0a3f\u0a06\u0a02 \u0a24\u0a4b\u0a02 \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a2e\u0a41\u0a32\u0a3e\u0a15\u0a3e\u0a24 \u0a28\u0a42\u0a70 \u0a2e\u0a41\u0a5c \u0a24\u0a39\u0a3f \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964"},{question:"\u0a2e\u0a48\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a24\u0a4b\u0a02 \u0a15\u0a3f\u0a39\u0a5c\u0a40\u0a06\u0a02 \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a48 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a3e\u0a02?",answer:"\u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a39\u0a30 \u0a24\u0a30\u0a4d\u0a39\u0a3e\u0a02 \u0a26\u0a40\u0a06\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a47 \u0a39\u0a28 \u0a1c\u0a3f\u0a35\u0a47\u0a02 \u0a15\u0a3f\n1. \u0a39\u0a30 \u0a09\u0a2e\u0a30 \u0a38\u0a2e\u0a42\u0a39 \u0a32\u0a08 \u0a28\u0a35\u0a3e\u0a02 \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a28\u0964\n2. \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a5e\u0a3f\u0a15 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 (\u0a28\u0a3e\u0a2e, \u0a2a\u0a24\u0a3e, \u0a32\u0a3f\u0a70\u0a17, \u0a1c\u0a28\u0a2e \u0a2e\u0a3f\u0a24\u0a40, \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a05\u0a24\u0a47 \u0a08\u0a2e\u0a47\u0a32 \u0a06\u0a08\u0a21\u0a40) \u0a26\u0a3e \u0a05\u0a2a\u0a21\u0a47\u0a1f\u0964\n3. \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 (\u0a2b\u0a4b\u0a1f\u0a4b, \u0a2b\u0a3f\u0a70\u0a17\u0a30\u0a2a\u0a4d\u0a30\u0a3f\u0a70\u0a1f\u0a38 \u0a05\u0a24\u0a47 \u0a06\u0a07\u0a30\u0a3f\u0a38 \u0a38\u0a15\u0a48\u0a28) \u0a26\u0a3e \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f\u0964\n4. \u0a2c\u0a71\u0a1a\u0a3f\u0a06\u0a02 \u0a26\u0a3e \u0a32\u0a3e\u0a1c\u0a3c\u0a2e\u0a40 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f (5 \u0a05\u0a24\u0a47 15 \u0a38\u0a3e\u0a32 \u0a26\u0a40 \u0a09\u0a2e\u0a30 \u0a24\u0a71\u0a15)\n5. \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f (POI \u0a05\u0a24\u0a47 POA)\u0964\n6. \u0a06\u0a27\u0a3e\u0a30 \u0a32\u0a71\u0a2d\u0a4b \u0a05\u0a24\u0a47 \u0a2a\u0a4d\u0a30\u0a3f\u0a70\u0a1f \u0a15\u0a30\u0a4b\u0964"},{question:"UIDAI ASKs (\u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30\u0a3e\u0a02) \u0a26\u0a47 \u0a38\u0a2e\u0a47\u0a02 \u0a15\u0a40 \u0a39\u0a28?",answer:"\u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a30\u0a3e\u0a38\u0a3c\u0a1f\u0a30\u0a40/\u0a16\u0a47\u0a24\u0a30\u0a40 \u0a1b\u0a41\u0a71\u0a1f\u0a40\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a1b\u0a71\u0a21 \u0a15\u0a47 \u0a39\u0a2b\u0a3c\u0a24\u0a47 \u0a26\u0a47 \u0a38\u0a3e\u0a30\u0a47 7 \u0a26\u0a3f\u0a28 \u0a16\u0a41\u0a71\u0a32\u0a4d\u0a39\u0a47 \u0a30\u0a39\u0a3f\u0a70\u0a26\u0a47 \u0a39\u0a28\u0964 \u0a06\u0a2e \u0a24\u0a4c\u0a30 '\u0a24\u0a47 \u0a07\u0a39 9:30 AM \u0a24\u0a4b\u0a02 5:30 PM (IST) \u0a24\u0a71\u0a15 \u0a15\u0a70\u0a2e \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48\u0964\nUIDAI ASKs \u0a24\u0a4b\u0a02 \u0a07\u0a32\u0a3e\u0a35\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a23 \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a06\u0a2a\u0a23\u0a47 \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a3e\u0a30 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a2a\u0a30\u0a3f\u0a2d\u0a3e\u0a38\u0a3c\u0a3f\u0a24 \u0a38\u0a2e\u0a47\u0a02 \u0a26\u0a40 \u0a2a\u0a3e\u0a32\u0a23\u0a3e \u0a15\u0a30\u0a26\u0a47 \u0a39\u0a28\u0964 \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a23 \u0a26\u0a40 \u0a2e\u0a70\u0a17 \u0a15\u0a30\u0a28 \u0a35\u0a3e\u0a32\u0a47 \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40/\u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a35\u0a27\u0a47\u0a30\u0a47 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a32\u0a08 \u0a06\u0a2a\u0a23\u0a47 \u0a28\u0a47\u0a5c\u0a32\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a23 \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a28\u0a3e\u0a32 \u0a38\u0a70\u0a2a\u0a30\u0a15 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964"},{question:"\u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30 (ASK) \u0a15\u0a40 \u0a39\u0a48?",answer:"\u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30' \u0a1c\u0a3e\u0a02 ASK \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40\u0a06\u0a02 \u0a32\u0a08 \u0a38\u0a3e\u0a30\u0a40\u0a06\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 \u0a32\u0a08 \u0a07\u0a71\u0a15 \u0a38\u0a3f\u0a70\u0a17\u0a32-\u0a38\u0a1f\u0a3e\u0a2a \u0a1f\u0a3f\u0a15\u0a3e\u0a23\u0a3e \u0a39\u0a48\u0964 ASK \u0a07\u0a71\u0a15 \u0a05\u0a24\u0a3f-\u0a06\u0a27\u0a41\u0a28\u0a3f\u0a15 \u0a2e\u0a3e\u0a39\u0a4c\u0a32 \u0a35\u0a3f\u0a71\u0a1a \u0a35\u0a38\u0a28\u0a40\u0a15\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a38\u0a2e\u0a30\u0a2a\u0a3f\u0a24 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a23 \u0a05\u0a24\u0a47 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a40 \u0a2a\u0a47\u0a38\u0a3c\u0a15\u0a38\u0a3c \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a35\u0a38\u0a28\u0a40\u0a15\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a07\u0a71\u0a15 \u0a06\u0a30\u0a3e\u0a2e\u0a26\u0a3e\u0a07\u0a15 \u0a0f\u0a05\u0a30-\u0a15\u0a70\u0a21\u0a40\u0a38\u0a3c\u0a28\u0a21 \u0a35\u0a3e\u0a24\u0a3e\u0a35\u0a30\u0a23 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a38\u0a3e\u0a30\u0a47 ASK \u0a35\u0a4d\u0a39\u0a40\u0a32\u0a1a\u0a47\u0a05\u0a30 \u0a05\u0a28\u0a41\u0a15\u0a42\u0a32 \u0a39\u0a28 \u0a05\u0a24\u0a47 \u0a2c\u0a1c\u0a3c\u0a41\u0a30\u0a17\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c \u0a24\u0a4c\u0a30 '\u0a24\u0a47 \u0a2f\u0a4b\u0a17 \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40\u0a06\u0a02 \u0a26\u0a40 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c \u0a2a\u0a4d\u0a30\u0a2c\u0a70\u0a27 \u0a39\u0a28\u0964 ASKs \u0a2c\u0a3e\u0a30\u0a47 \u0a39\u0a4b\u0a30 \u0a1c\u0a3e\u0a23\u0a15\u0a3e\u0a30\u0a40 \u0a07\u0a71\u0a25\u0a47 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a39\u0a48 l \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f: uidai.gov.in"},{question:"\u0a2e\u0a48\u0a28\u0a42\u0a70 UIDAI ASKs (\u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30\u0a3e\u0a02) \u0a26\u0a40 \u0a38\u0a42\u0a1a\u0a40 \u0a15\u0a3f\u0a71\u0a25\u0a4b\u0a02 \u0a2e\u0a3f\u0a32 \u0a38\u0a15\u0a26\u0a40 \u0a39\u0a48?",answer:"\u0a38\u0a3e\u0a30\u0a47 \u0a15\u0a3e\u0a30\u0a1c\u0a38\u0a3c\u0a40\u0a32 ASK \u0a26\u0a40 \u0a07\u0a71\u0a15 \u0a38\u0a70\u0a2f\u0a41\u0a15\u0a24 \u0a38\u0a42\u0a1a\u0a40 \u0a07\u0a71\u0a25\u0a47 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a39\u0a48: \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a38\u0a42\u0a1a\u0a40\n\u0a07\u0a39 ASK \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a24\u0a4b\u0a02 \u0a2c\u0a48\u0a02\u0a15\u0a3e\u0a02, \u0a21\u0a3e\u0a15\u0a18\u0a30\u0a3e\u0a02, CSC, BSNL \u0a05\u0a24\u0a47 \u0a30\u0a3e\u0a1c \u0a38\u0a30\u0a15\u0a3e\u0a30\u0a3e\u0a02 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a1a\u0a32\u0a3e\u0a0f \u0a1c\u0a3e \u0a30\u0a39\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a23 \u0a15\u0a47\u0a02\u0a26\u0a30\u0a3e\u0a02 \u0a24\u0a4b\u0a02 \u0a07\u0a32\u0a3e\u0a35\u0a3e \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a39\u0a28\u0964"}],checkEnrolmentUpdateStatus:[{question:"\u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a06\u0a27\u0a3e\u0a30 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a38\u0a47\u0a35\u0a3e \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a2e\u0a48\u0a02 \u0a15\u0a3f\u0a39\u0a5c\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e/\u0a38\u0a15\u0a26\u0a40 \u0a39\u0a3e\u0a02?",answer:"\u0a07\u0a38 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a2a\u0a4b\u0a30\u0a1f\u0a32 \u0a26\u0a47 \u0a1c\u0a3c\u0a30\u0a40\u0a0f, \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a38\u0a3f\u0a30\u0a2b \u0a2a\u0a24\u0a3e \u0a05\u0a24\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964 \u0a15\u0a3f\u0a38\u0a47 \u0a39\u0a4b\u0a30 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08, \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a28\u0a1c\u0a3c\u0a26\u0a40\u0a15\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30 '\u0a24\u0a47 \u0a1c\u0a3e\u0a13\u0964"}],checkAadhaarValidity:[{question:"\u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21 \u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a71\u0a24\u0a30 \u0a24\u0a4b\u0a02 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a35\u0a71\u0a16\u0a30\u0a3e \u0a39\u0a48?",answer:"\u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a71\u0a24\u0a30 \u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a23 \u0a1c\u0a3e\u0a02 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a15\u0a3e\u0a17\u0a1c\u0a3c \u0a06\u0a27\u0a3e\u0a30\u0a3f\u0a24 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a39\u0a48\u0964 \u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a05\u0a27\u0a3e\u0a30\u0a24 \u0a1f\u0a3f\u0a15\u0a3e\u0a0a \u0a05\u0a24\u0a47 \u0a15\u0a08 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a06 \u0a35\u0a3f\u0a38\u0a3c\u0a47\u0a38\u0a3c\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a35\u0a3e\u0a32\u0a3e \u0a15\u0a3e\u0a30\u0a21 \u0a32\u0a48 \u0a1c\u0a3e\u0a23 \u0a35\u0a3f\u0a71\u0a1a \u0a06\u0a38\u0a3e\u0a28 \u0a39\u0a48\u0964 \u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a40\u0a35\u0a40\u0a38\u0a40 \u0a15\u0a3e\u0a30\u0a21 \u0a35\u0a40 \u0a2c\u0a30\u0a3e\u0a2c\u0a30 \u0a35\u0a48\u0a27 \u0a39\u0a48\u0964"}],lockUnlockAadhaar:[{question:"\u0a2e\u0a47\u0a30\u0a40 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a05\u0a35\u0a48\u0a27 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a32\u0a08 \u0a05\u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30 \u0a15\u0a30 \u0a26\u0a3f\u0a71\u0a24\u0a40 \u0a17\u0a08 \u0a39\u0a48\u0964 \u0a07\u0a38\u0a26\u0a3e \u0a15\u0a40 \u0a2e\u0a24\u0a32\u0a2c \u0a39\u0a48?",answer:"\u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a10\u0a21\u0a30\u0a48\u0a71\u0a38 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08 \u0a1c\u0a4b \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a35\u0a30\u0a24\u0a26\u0a47 \u0a39\u0a4b \u0a09\u0a39 \u0a39\u0a4b\u0a23\u0a3e \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a3e \u0a39\u0a48:\n\u2022 https://uidai.gov.in \u0a26\u0a47 \u0a05\u0a28\u0a41\u0a38\u0a3e\u0a30 \u0a35\u0a48\u0a27 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0964\n\u2022 \u0a05\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a26\u0a47 \u0a28\u0a3e\u0a2e '\u0a24\u0a47 \u0a39\u0a48\u0964\n\u2022 \u0a05\u0a71\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a40\u0a24\u0a40 \u0a17\u0a08 \u0a24\u0a38\u0a35\u0a40\u0a30 \u0a05\u0a38\u0a32\u0a40 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a26\u0a40 \u0a38\u0a2a\u0a38\u0a3c\u0a1f \u0a05\u0a24\u0a47 \u0a30\u0a70\u0a17\u0a40\u0a28 \u0a38\u0a15\u0a48\u0a28 \u0a39\u0a4b\u0a23\u0a40 \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a40 \u0a39\u0a48\u0964\n\u0a07\u0a39 \u0a2f\u0a15\u0a40\u0a28\u0a40 \u0a2c\u0a23\u0a3e\u0a13 \u0a15\u0a3f \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a28\u0a35\u0a40\u0a02 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a2c\u0a23\u0a3e\u0a09\u0a23 \u0a24\u0a4b\u0a02 \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a09\u0a2a\u0a30\u0a4b\u0a15\u0a24 \u0a26\u0a40 \u0a2a\u0a3e\u0a32\u0a23\u0a3e \u0a15\u0a30\u0a26\u0a47 \u0a39\u0a4b\u0964"},{question:"\u0a06\u0a27\u0a3e\u0a30 (UID) \u0a32\u0a4c\u0a15 \u0a05\u0a24\u0a47 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a40 \u0a39\u0a48?",answer:"\u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a32\u0a08, \u0a28\u0a3f\u0a71\u0a1c\u0a40 \u0a21\u0a47\u0a1f\u0a3e \u0a26\u0a40 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a06 \u0a05\u0a24\u0a47 \u0a17\u0a4b\u0a2a\u0a28\u0a40\u0a2f\u0a24\u0a3e \u0a39\u0a2e\u0a47\u0a38\u0a3c\u0a3e \u0a07\u0a71\u0a15 \u0a2e\u0a41\u0a71\u0a16 \u0a1a\u0a3f\u0a70\u0a24\u0a3e \u0a39\u0a41\u0a70\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a09\u0a38\u0a26\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a40 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a06 \u0a28\u0a42\u0a70 \u0a2e\u0a1c\u0a3c\u0a2c\u0a42\u0a24 \u200b\u200b\u200b\u200b\u0a15\u0a30\u0a28 \u0a05\u0a24\u0a47 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a28\u0a42\u0a70 \u0a28\u0a3f\u0a2f\u0a70\u0a24\u0a30\u0a23 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a28 \u0a32\u0a08, UIDAI \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 (UID) \u0a28\u0a42\u0a70 \u0a32\u0a3e\u0a15 \u0a05\u0a24\u0a47 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a07\u0a71\u0a15 \u0a35\u0a3f\u0a27\u0a40 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48\u0964\n\u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 UIDAI \u0a26\u0a40 \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f www.myaadhaar.uidai.gov.in \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a1c\u0a3e\u0a02 mAadhaar \u0a10\u0a2a \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a06\u0a2a\u0a23\u0a3e \u0a06\u0a27\u0a3e\u0a30 (UID) \u0a32\u0a4c\u0a15 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964\n\u0a05\u0a1c\u0a3f\u0a39\u0a3e \u0a15\u0a30\u0a28 \u0a28\u0a3e\u0a32 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38, \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a5e\u0a3f\u0a15 \u0a05\u0a24\u0a47 OTP \u0a35\u0a3f\u0a27\u0a40 \u0a32\u0a08 UID, UID \u0a1f\u0a4b\u0a15\u0a28 \u0a05\u0a24\u0a47 VID \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a15\u0a3f\u0a38\u0a2e \u0a26\u0a40 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e \u0a28\u0a39\u0a40\u0a02 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964\n\u0a1c\u0a47\u0a15\u0a30 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 UID \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a3e \u0a39\u0a48 \u0a24\u0a3e\u0a02 \u0a09\u0a39 \u0a28\u0a35\u0a40\u0a28\u0a24\u0a2e VID \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47, UIDAI \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f \u0a1c\u0a3e\u0a02 mAadhaar \u0a10\u0a2a \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a05\u0a1c\u0a3f\u0a39\u0a3e \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964\n\u0a06\u0a27\u0a3e\u0a30 (UID) \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26, \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 UID, UID \u0a1f\u0a4b\u0a15\u0a28 \u0a05\u0a24\u0a47 VID \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a40\u0a15\u0a30\u0a28 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964"},{question:"\u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 UID \u0a28\u0a42\u0a70 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a32\u0a4c\u0a15 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48?",answer:"\u0a2f\u0a42\u0a06\u0a08\u0a21\u0a40 \u0a28\u0a42\u0a70 \u0a32\u0a3e\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08, \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a15\u0a4b\u0a32 16 \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a3e VID \u0a28\u0a70\u0a2c\u0a30 \u0a39\u0a4b\u0a23\u0a3e \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a3e \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a07\u0a39 \u0a32\u0a3e\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a15 \u0a2a\u0a42\u0a30\u0a35-\u0a32\u0a4b\u0a5c\u0a40 \u0a39\u0a48\u0964 \u0a1c\u0a47\u0a15\u0a30 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a15\u0a4b\u0a32 VID \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a48 \u0a24\u0a3e\u0a02 \u0a09\u0a39 SMS \u0a38\u0a47\u0a35\u0a3e \u0a1c\u0a3e\u0a02 UIDAI \u0a26\u0a40 \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f (www.myaadhaar.uidai.gov.in) \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a24\u0a3f\u0a06\u0a30 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964\nSMS \u0a38\u0a47\u0a35\u0a3e\u0964 GVID \u0a38\u0a2a\u0a47\u0a38 UID \u0a26\u0a47 \u0a06\u0a16\u0a30\u0a40 4 \u0a1c\u0a3e\u0a02 8 \u0a05\u0a70\u0a15 \u0964 1947  '\u0a24\u0a47 SMS \u0a15\u0a30\u0a4b \u0964 \u0a09\u0a26\u0a3e\u0a39\u0a30\u0a28-GVID 1234\n\u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 UIDAI \u0a26\u0a40 \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f https://resident.uidai.gov.in/aadhaar-lockunlock '\u0a24\u0a47 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48 Myaadhaar \u0a1f\u0a48\u0a2c \u0a26\u0a47 \u0a24\u0a39\u0a3f\u0a24, \u0a06\u0a27\u0a3e\u0a30 \u0a32\u0a4c\u0a15 \u0a05\u0a24\u0a47 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964 UID \u0a32\u0a4c\u0a15 \u0a30\u0a47\u0a21\u0a40\u0a13 \u0a2c\u0a1f\u0a28 \u0a28\u0a42\u0a70 \u0a1a\u0a41\u0a23\u0a4b \u0a05\u0a24\u0a47 \u0a28\u0a35\u0a40\u0a28\u0a24\u0a2e \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a05\u0a28\u0a41\u0a38\u0a3e\u0a30 UID \u0a28\u0a70\u0a2c\u0a30, \u0a2a\u0a42\u0a30\u0a3e \u0a28\u0a3e\u0a2e \u0a05\u0a24\u0a47 \u0a2a\u0a3f\u0a28 \u0a15\u0a4b\u0a21 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b \u0a05\u0a24\u0a47 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a06 \u0a15\u0a4b\u0a21 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b\u0964 Send OTP '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b \u0a05\u0a24\u0a47 \u0a38\u0a2c\u0a2e\u0a3f\u0a1f '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 UID \u0a38\u0a2b\u0a32\u0a24\u0a3e\u0a2a\u0a42\u0a30\u0a35\u0a15 \u0a32\u0a4c\u0a15 \u0a39\u0a4b \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a40\u0964"},{question:"\u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 UID \u0a28\u0a42\u0a70 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48?",answer:"UID \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a15\u0a4b\u0a32 \u0a28\u0a35\u0a40\u0a28\u0a24\u0a2e 16 \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a40 VID \u0a39\u0a4b\u0a23\u0a40 \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a40 \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a1c\u0a47\u0a15\u0a30 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 16 \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a40 VID \u0a2d\u0a41\u0a71\u0a32 \u0a17\u0a3f\u0a06 \u0a39\u0a48 \u0a24\u0a3e\u0a02 \u0a09\u0a39 SMS \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a28\u0a35\u0a40\u0a28\u0a24\u0a2e VID \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964\nRVID \u0a38\u0a2a\u0a47\u0a38 UID \u0a26\u0a47 \u0a06\u0a16\u0a30\u0a40 4 \u0a1c\u0a3e\u0a02 8 \u0a05\u0a70\u0a15 \u0964 1947 '\u0a24\u0a47 SMS \u0a15\u0a30\u0a4b\u0964 \u0a09\u0a26\u0a3e\u0a39\u0a30\u0a28-RVID 1234\nUID \u0a28\u0a42\u0a70 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08, \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 UIDAI \u0a26\u0a40 \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f https://resident.uidai.gov.in/aadhaar-lockunlock '\u0a24\u0a47 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48, \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a30\u0a47\u0a21\u0a40\u0a13 \u0a2c\u0a1f\u0a28 \u0a28\u0a42\u0a70 \u0a1a\u0a41\u0a23\u0a4b, \u0a28\u0a35\u0a40\u0a28\u0a24\u0a2e VID \u0a05\u0a24\u0a47 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a06 \u0a15\u0a4b\u0a21 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b \u0a05\u0a24\u0a47 Send OTP '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b \u0a05\u0a24\u0a47 \u0a38\u0a2c\u0a2e\u0a3f\u0a1f '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 UID \u0a38\u0a2b\u0a32\u0a24\u0a3e\u0a2a\u0a42\u0a30\u0a35\u0a15 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a39\u0a4b \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a40\u0964\n\u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 mAadhaar \u0a10\u0a2a \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a32\u0a4c\u0a15 \u0a1c\u0a3e\u0a02 \u0a05\u0a28\u0a32\u0a4c\u0a15 \u0a38\u0a47\u0a35\u0a3e \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a35\u0a40 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964'"}],grievanceAndFeedback:[],generateOrRetrieveVid:[{question:"\u0a2e\u0a48\u0a02 \u0a06\u0a2a\u0a23\u0a40 VID \u0a2d\u0a41\u0a71\u0a32 \u0a17\u0a3f\u0a06\u0964 UID \u0a28\u0a42\u0a70 \u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26 \u0a2e\u0a48\u0a02 \u0a07\u0a38\u0a28\u0a42\u0a70 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a3e\u0a02?",answer:"UID \u0a28\u0a42\u0a70 \u0a32\u0a4c\u0a15 \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26 \u0a1c\u0a47\u0a15\u0a30 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 VID \u0a2d\u0a41\u0a71\u0a32 \u0a17\u0a3f\u0a06 \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 16 \u0a05\u0a70\u0a15\u0a3e\u0a02 \u0a26\u0a40 VID \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30\u0a28 \u0a32\u0a08 SMS \u0a38\u0a47\u0a35\u0a3e \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a28\u0a42\u0a70 \u0a09\u0a38\u0a26\u0a47 \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 '\u0a24\u0a47 VID \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e\u0964\n\u0a06\u0a27\u0a3e\u0a30 \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a24\u0a4b\u0a02 1947 '\u0a24\u0a47 SMS \u0a2d\u0a47\u0a1c\u0a4b,\nRVID \u0a38\u0a2a\u0a47\u0a38 UID \u0a26\u0a47 \u0a06\u0a16\u0a30\u0a40 4 \u0a1c\u0a3e\u0a02 8 \u0a05\u0a70\u0a15\u0964\n\u0a09\u0a26\u0a3e\u0a39\u0a30\u0a28:- RVID 1234'"},{question:"\u0a35\u0a30\u0a1a\u0a41\u0a05\u0a32 \u0a06\u0a08\u0a21\u0a40 (VID) \u0a15\u0a40 \u0a39\u0a48?",answer:"VID \u0a07\u0a71\u0a15 \u0a05\u0a38\u0a25\u0a3e\u0a08, \u0a30\u0a40\u0a35\u0a4b\u0a15\u0a47\u0a2c\u0a32 16-\u0a05\u0a70\u0a15 \u0a2c\u0a47\u0a24\u0a30\u0a24\u0a40\u0a2c \u0a28\u0a70\u0a2c\u0a30 \u0a39\u0a48 \u0a1c\u0a4b \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a28\u0a3e\u0a32 \u0a2e\u0a48\u0a2a \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a39\u0a48\u0964 VID \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a47 \u0a2c\u0a26\u0a32\u0a47 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40 \u0a39\u0a48 \u0a1c\u0a26\u0a4b\u0a02 \u0a35\u0a40 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e \u0a1c\u0a3e\u0a02 \u0a08-\u0a15\u0a47\u0a35\u0a3e\u0a08\u0a38\u0a40 \u0a38\u0a47\u0a35\u0a3e\u0a35\u0a3e\u0a02 \u0a15\u0a40\u0a24\u0a40\u0a06\u0a02 \u0a1c\u0a3e\u0a02\u0a26\u0a40\u0a06\u0a02 \u0a39\u0a28\u0964 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a28 \u0a35\u0a3e\u0a02\u0a17 VID \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40 \u0a39\u0a48\u0964 VID \u0a24\u0a4b\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30\u0a28\u0a3e \u0a38\u0a70\u0a2d\u0a35 \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a48\u0964"},{question:"\u0a07\u0a71\u0a15 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 VID \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48?",answer:"\u0a35\u0a40\u0a06\u0a08\u0a21\u0a40 \u0a38\u0a3f\u0a30\u0a2b\u0a3c \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a24\u0a3f\u0a06\u0a30 \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a09\u0a39 \u0a38\u0a2e\u0a47\u0a02-\u0a38\u0a2e\u0a47\u0a02 '\u0a24\u0a47 \u0a06\u0a2a\u0a23\u0a40 \u0a35\u0a40\u0a06\u0a08\u0a21\u0a40 \u0a28\u0a42\u0a70 \u0a2c\u0a26\u0a32 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28 (\u0a28\u0a35\u0a40\u0a02 \u0a35\u0a40\u0a06\u0a08\u0a21\u0a40 \u0a2c\u0a23\u0a3e \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28)\u0964 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a38\u0a2e\u0a47\u0a02 '\u0a24\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a32\u0a08 \u0a38\u0a3f\u0a30\u0a2b\u0a3c \u0a07\u0a71\u0a15 \u0a35\u0a40\u0a06\u0a08\u0a21\u0a40 \u0a35\u0a48\u0a27 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a40\u0964\nUIDAI \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a06\u0a2a\u0a23\u0a40 VID \u0a2c\u0a23\u0a3e\u0a09\u0a23, \u0a2d\u0a41\u0a71\u0a32 \u0a1c\u0a3e\u0a23 '\u0a24\u0a47 \u0a09\u0a28\u0a4d\u0a39\u0a3e\u0a02 \u0a26\u0a40 VID \u0a2e\u0a41\u0a5c \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30\u0a28, \u0a05\u0a24\u0a47 \u0a09\u0a28\u0a4d\u0a39\u0a3e\u0a02 \u0a26\u0a40 VID \u0a28\u0a42\u0a70 \u0a07\u0a71\u0a15 \u0a28\u0a35\u0a47\u0a02 \u0a28\u0a70\u0a2c\u0a30 \u0a28\u0a3e\u0a32 \u0a2c\u0a26\u0a32\u0a23 \u0a32\u0a08 \u0a15\u0a08 \u0a35\u0a3f\u0a15\u0a32\u0a2a \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48\u0964\n\u0a07\u0a39 \u0a35\u0a3f\u0a15\u0a32\u0a2a UIDAI \u0a26\u0a40 \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f (www.myaadhaar.uidai.gov.in), \u0a08-\u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a3e\u0a0a\u0a28\u0a32\u0a4b\u0a21, \u0a10\u0a2e-\u0a06\u0a27\u0a3e\u0a30  \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a10\u0a2a\u0a32\u0a40\u0a15\u0a47\u0a38\u0a3c\u0a28 \u0a06\u0a26\u0a3f \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a15\u0a30\u0a35\u0a3e\u0a0f \u0a1c\u0a3e\u0a23\u0a17\u0a47\u0964\n\u0a06\u0a27\u0a3e\u0a30 \u0a39\u0a48\u0a32\u0a2a\u0a32\u0a3e\u0a08\u0a28 \u0a28\u0a70\u0a2c\u0a30 1947 '\u0a24\u0a47 \u0a07\u0a71\u0a15 SMS \u0a2d\u0a47\u0a1c \u0a15\u0a47 \u0a35\u0a40 VID \u0a24\u0a3f\u0a06\u0a30 \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a28\u0a42\u0a70 'GVID \u0a38\u0a2a\u0a47\u0a38 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a47 \u0a06\u0a16\u0a30\u0a40 4 \u0a05\u0a70\u0a15' \u0a1f\u0a3e\u0a08\u0a2a \u0a15\u0a30\u0a28\u0a3e \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e \u0a05\u0a24\u0a47 \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a30\u0a3e\u0a39\u0a40\u0a02 1947 '\u0a24\u0a47 \u0a2d\u0a47\u0a1c\u0a23\u0a3e \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e\u0964"},{question:"\u0a15\u0a40 \u0a15\u0a4b\u0a08 \u0a39\u0a4b\u0a30 \u0a2e\u0a47\u0a30\u0a47 \u0a32\u0a08 VID \u0a2c\u0a23\u0a3e \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48?",answer:"AUA/KUA \u0a35\u0a30\u0a17\u0a40 \u0a15\u0a4b\u0a08 \u0a39\u0a4b\u0a30 \u0a38\u0a70\u0a38\u0a25\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a26\u0a40 \u0a24\u0a30\u0a2b\u0a4b\u0a02 VID \u0a28\u0a39\u0a40\u0a02 \u0a2c\u0a23\u0a3e \u0a38\u0a15\u0a26\u0a40\u0964 VID \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a2a \u0a39\u0a40 \u0a24\u0a3f\u0a06\u0a30 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 '\u0a24\u0a47 SMS \u0a30\u0a3e\u0a39\u0a40\u0a02 VID \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30\u0a47\u0a17\u0a3e\u0964"},{question:"\u0a1c\u0a47\u0a15\u0a30 \u0a15\u0a4b\u0a08 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 VID \u0a2d\u0a41\u0a71\u0a32 \u0a1c\u0a3e\u0a35\u0a47 \u0a24\u0a3e\u0a02 \u0a15\u0a40 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e? \u0a15\u0a40 \u0a09\u0a39 \u0a26\u0a41\u0a2c\u0a3e\u0a30\u0a3e \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48?",answer:"'\u0a39\u0a3e\u0a02, UIDAI \u0a28\u0a35\u0a47\u0a02 \u0a2c\u0a23\u0a3e\u0a09\u0a23 \u0a05\u0a24\u0a47/\u0a1c\u0a3e\u0a02 \u0a2e\u0a4c\u0a1c\u0a42\u0a26\u0a3e VID \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30\u0a28 \u0a26\u0a47 \u0a15\u0a08 \u0a24\u0a30\u0a40\u0a15\u0a47 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a07\u0a39 \u0a35\u0a3f\u0a15\u0a32\u0a2a UIDAI \u0a26\u0a40 \u0a35\u0a48\u0a71\u0a2c\u0a38\u0a3e\u0a08\u0a1f (www.myaadhaar.uidai.gov.in), eAadhaar, mAadhaar \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a10\u0a2a\u0a32\u0a40\u0a15\u0a47\u0a38\u0a3c\u0a28, SMS, \u0a06\u0a26\u0a3f \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a15\u0a30\u0a35\u0a3e\u0a0f \u0a17\u0a0f \u0a39\u0a28\u0964\nVID \u0a26\u0a40 \u0a2e\u0a41\u0a5c \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24\u0a40 \u0a32\u0a08, \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a06\u0a27\u0a3e\u0a30 \u0a39\u0a48\u0a32\u0a2a\u0a32\u0a3e\u0a08\u0a28 \u0a28\u0a70\u0a2c\u0a30 1947 '\u0a24\u0a47 SMS \u0a2d\u0a47\u0a1c \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a28\u0a42\u0a70 'RVID \u0a38\u0a2a\u0a47\u0a38 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a47 \u0a06\u0a16\u0a30\u0a40 4 \u0a05\u0a70\u0a15' \u0a1f\u0a3e\u0a08\u0a2a \u0a15\u0a30\u0a15\u0a47 \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a30\u0a3e\u0a39\u0a40\u0a02 1947 '\u0a24\u0a47 \u0a2d\u0a47\u0a1c\u0a23\u0a3e \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e\u0964"},{question:"\u0a15\u0a40 VID \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 OTP \u0a1c\u0a3e\u0a02 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15 \u0a1c\u0a3e\u0a02 \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a5e\u0a3f\u0a15  \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e \u0a32\u0a08 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40 \u0a39\u0a48?",answer:"\u0a39\u0a3e\u0a02\u0964 \u0a06\u0a27\u0a3e\u0a30 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a40\u0a15\u0a30\u0a28 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a47 \u0a2c\u0a26\u0a32\u0a47 VID \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40 \u0a39\u0a48\u0964"},{question:"VID \u0a26\u0a47 \u0a2e\u0a3e\u0a2e\u0a32\u0a47 \u0a35\u0a3f\u0a71\u0a1a, \u0a15\u0a40 \u0a2e\u0a48\u0a28\u0a42\u0a70 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e \u0a32\u0a08 \u0a38\u0a39\u0a3f\u0a2e\u0a24\u0a40 \u0a26\u0a47\u0a23 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a48?",answer:"\u0a39\u0a3e\u0a02, VID \u0a06\u0a27\u0a3e\u0a30\u0a3f\u0a24 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e \u0a32\u0a08 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a26\u0a40 \u0a38\u0a39\u0a3f\u0a2e\u0a24\u0a40 \u0a1c\u0a3c\u0a30\u0a42\u0a30\u0a40 \u0a39\u0a48\u0964 \u0a0f\u0a1c\u0a70\u0a38\u0a40 \u0a28\u0a42\u0a70 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a28\u0a42\u0a70 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e \u0a26\u0a47 \u0a09\u0a26\u0a47\u0a38\u0a3c \u0a2c\u0a3e\u0a30\u0a47 \u0a38\u0a42\u0a1a\u0a3f\u0a24 \u0a15\u0a30\u0a28 \u0a05\u0a24\u0a47 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a40\u0a15\u0a30\u0a28 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a38\u0a2a\u0a38\u0a3c\u0a1f \u0a38\u0a39\u0a3f\u0a2e\u0a24\u0a40 \u0a32\u0a48\u0a23 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a41\u0a70\u0a26\u0a40 \u0a39\u0a48\u0964"},{question:"\u0a15\u0a40 \u0a15\u0a4b\u0a08 \u0a0f\u0a1c\u0a70\u0a38\u0a40 VID \u0a38\u0a1f\u0a4b\u0a30 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a40 \u0a39\u0a48?",answer:"\u0a28\u0a39\u0a40\u0a02\u0964 \u0a15\u0a3f\u0a09\u0a02\u0a15\u0a3f VID \u0a05\u0a38\u0a25\u0a3e\u0a08 \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a2c\u0a26\u0a32\u0a3f\u0a06 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48, VID \u0a38\u0a1f\u0a4b\u0a30 \u0a15\u0a30\u0a28 \u0a26\u0a3e \u0a15\u0a4b\u0a08 \u0a2e\u0a41\u0a71\u0a32 \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a48\u0964 \u0a0f\u0a1c\u0a70\u0a38\u0a40\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a21\u0a47\u0a1f\u0a3e\u0a2c\u0a47\u0a38 \u0a1c\u0a3e\u0a02 \u0a32\u0a4c\u0a17\u0a38 \u0a35\u0a3f\u0a71\u0a1a VID \u0a38\u0a1f\u0a4b\u0a30 \u0a28\u0a39\u0a40\u0a02 \u0a15\u0a30\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a3e \u0a39\u0a48\u0964"},{question:"\u0a15\u0a40 VID \u0a26\u0a40 \u0a2e\u0a41\u0a5c-\u0a09\u0a24\u0a2a\u0a24\u0a40 \u0a09\u0a38\u0a47 VID \u0a1c\u0a3e\u0a02 \u0a07\u0a71\u0a15 \u0a35\u0a71\u0a16\u0a30\u0a40 VID \u0a35\u0a71\u0a32 \u0a32\u0a48 \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48?",answer:"'\u0a18\u0a71\u0a1f\u0a4b-\u0a18\u0a71\u0a1f \u0a35\u0a48\u0a27\u0a24\u0a3e \u0a26\u0a40 \u0a2e\u0a3f\u0a06\u0a26 \u0a24\u0a4b\u0a02 \u0a2c\u0a3e\u0a05\u0a26 (\u0a35\u0a30\u0a24\u0a2e\u0a3e\u0a28 \u0a35\u0a3f\u0a71\u0a1a 1 \u0a15\u0a48\u0a32\u0a70\u0a21\u0a30 \u0a26\u0a3f\u0a28 \u0a1c\u0a3e\u0a02 \u0a05\u0a71\u0a27\u0a40 \u0a30\u0a3e\u0a24 12 \u0a26\u0a47 \u0a2c\u0a3e\u0a05\u0a26 \u0a38\u0a48\u0a71\u0a1f \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a39\u0a48), \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a07\u0a71\u0a15 \u0a28\u0a35\u0a40\u0a02 VID \u0a28\u0a42\u0a70 \u0a2e\u0a41\u0a5c \u0a2c\u0a23\u0a3e\u0a09\u0a23 \u0a32\u0a08 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a07\u0a38 \u0a24\u0a30\u0a4d\u0a39\u0a3e\u0a02, \u0a28\u0a35\u0a40\u0a02 VID \u0a24\u0a3f\u0a06\u0a30 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a40 \u0a05\u0a24\u0a47 \u0a2a\u0a3f\u0a1b\u0a32\u0a40 VID \u0a28\u0a42\u0a70 \u0a05\u0a15\u0a3f\u0a30\u0a3f\u0a06\u0a38\u0a3c\u0a40\u0a32 \u0a15\u0a30 \u0a26\u0a3f\u0a71\u0a24\u0a3e \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a3e\u0964\n\u0a1c\u0a47\u0a15\u0a30 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 VID \u0a26\u0a40 \u0a2e\u0a41\u0a5c \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24\u0a40 \u0a26\u0a40 \u0a1a\u0a4b\u0a23 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a06\u0a16\u0a30\u0a40 \u0a15\u0a3f\u0a30\u0a3f\u0a06\u0a38\u0a3c\u0a40\u0a32 VID \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a28\u0a42\u0a70 SMS \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a2d\u0a47\u0a1c\u0a3f\u0a06 \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a3e\u0964 \u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a28\u0a42\u0a70 'RVID \u0a38\u0a2a\u0a47\u0a38 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a47 \u0a06\u0a16\u0a30\u0a40 4 \u0a05\u0a70\u0a15' \u0a1f\u0a3e\u0a08\u0a2a \u0a15\u0a30\u0a28\u0a3e \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e \u0a05\u0a24\u0a47 \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 \u0a30\u0a3e\u0a39\u0a40\u0a02 1947 '\u0a24\u0a47 \u0a2d\u0a47\u0a1c\u0a23\u0a3e \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e\u0964"}],checkGrievanceFeedbackStatus:[{question:"VID \u0a2a\u0a41\u0a71\u0a17\u0a23 \u0a26\u0a40 \u0a2e\u0a3f\u0a06\u0a26 \u0a15\u0a40 \u0a39\u0a48?",answer:"\u0a07\u0a38 \u0a38\u0a2e\u0a47\u0a02 VID \u0a32\u0a08 \u0a15\u0a4b\u0a08 \u0a2a\u0a41\u0a71\u0a17\u0a23 \u0a26\u0a40 \u0a2e\u0a3f\u0a06\u0a26 \u0a2a\u0a30\u0a3f\u0a2d\u0a3e\u0a38\u0a3c\u0a3f\u0a24 \u0a28\u0a39\u0a40\u0a02 \u0a39\u0a48\u0964 VID \u0a09\u0a26\u0a4b\u0a02 \u0a24\u0a71\u0a15 \u0a35\u0a48\u0a27 \u0a30\u0a39\u0a47\u0a17\u0a3e \u0a1c\u0a26\u0a4b\u0a02 \u0a24\u0a71\u0a15 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a07\u0a71\u0a15 \u0a28\u0a35\u0a3e\u0a02 VID \u0a24\u0a3f\u0a06\u0a30 \u0a28\u0a39\u0a40\u0a02 \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48\u0964"}]}}},ta_IN:{translation:{dashboard:{header:{title:"\u0b8e\u0ba9\u0ba4\u0bc1 \u0b86\u0ba4\u0bbe\u0bb0\u0bcd",profile:{aadhaarTagLine:"\u0b8e\u0ba9\u0ba4\u0bc1  \u0b86\u0ba4\u0bbe\u0bb0\u0bcd ,\u0b8e\u0ba9\u0ba4\u0bc1  \u0b85\u0b9f\u0bc8\u0baf\u0bbe\u0bb3\u0bae\u0bcd",clickToFlip:"\u0baa\u0bc1\u0bb0\u0b9f\u0bcd\u0b9f\u0bc1 \u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b85\u0b9f\u0bcd\u0b9f\u0bc8",logOut:"\u0bb5\u0bc6\u0bb3\u0bbf\u0baf\u0bc7\u0bb1\u0bc1"}},services:{title:"\u0b9a\u0bc7\u0bb5\u0bc8\u0b95\u0bb3\u0bcd",description:"\u0b86\u0ba9\u0bcd\u0bb2\u0bc8\u0ba9\u0bcd \u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b9a\u0bc7\u0bb5\u0bc8\u0b95\u0bb3\u0bcd  \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0b9a\u0bc7\u0bb5\u0bc8\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b85\u0ba3\u0bc1\u0b95\u0bb2\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b95\u0bbf\u0b9f\u0bc8\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1. \u0b9a\u0bc7\u0bb5\u0bc8 \u0b9a\u0bbe\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0baa\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b9a\u0bc6\u0bb2\u0bcd\u0bb2 \u0ba4\u0bbe\u0bb5\u0bb2\u0bc8\u0b95\u0bcd \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0b95",serviceCards:{downloadAadhaar:{title:"\u0baa\u0ba4\u0bbf\u0bb5\u0bbf\u0bb1\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0b86\u0ba4\u0bbe\u0bb0\u0bcd",description:"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b9f\u0bbf\u0b9c\u0bbf\u0b9f\u0bcd\u0b9f\u0bb2\u0bcd \u0b95\u0bc8\u0baf\u0bca\u0baa\u0bcd\u0baa\u0bae\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0b9f\u0bb5\u0bc1\u0b9a\u0bcd\u0b9a\u0bca\u0bb2\u0bcd \u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bae\u0bbf\u0ba9\u0bcd\u0ba9\u0ba3\u0bc1 \u0ba8\u0b95\u0bb2\u0bc8\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bbf\u0bb1\u0b95\u0bcd\u0b95 \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0b95"},orderPVC:{title:"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0baa\u0bbf.\u0bb5\u0bbf.\u0b9a\u0bbf \u0b85\u0b9f\u0bcd\u0b9f\u0bc8\u0baf\u0bc8 \u0b86\u0bb0\u0bcd\u0b9f\u0bb0\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd",description:"\u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bbe\u0ba9, \u0baa\u0ba3\u0baa\u0bcd\u0baa\u0bc8 \u0b85\u0bb3\u0bb5\u0bbf\u0bb2\u0bbe\u0ba9 \u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0baa\u0bbf.\u0bb5\u0bbf.\u0b9a\u0bbf \u0b95\u0bbe\u0bb0\u0bcd\u0b9f\u0bc8 \u0b86\u0bb0\u0bcd\u0b9f\u0bb0\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0b95"},updateAadhaarOnline:{updateAadhaarOnline:"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b86\u0ba9\u0bcd\u0bb2\u0bc8\u0ba9\u0bbf\u0bb2\u0bcd \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd",updateAadhaar:"\u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0b86\u0ba4\u0bbe\u0bb0\u0bcd",headerTitle:"\u0b86\u0ba9\u0bcd\u0bb2\u0bc8\u0ba9\u0bcd \u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0bb5\u0b95\u0bc8\u0baf\u0bc8\u0ba4\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd",title:"\u0bae\u0bc1\u0b95\u0bb5\u0bb0\u0bbf \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u0baa\u0bc1",description:"\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0bae\u0bc1\u0b95\u0bb5\u0bb0\u0bbf\u0baf\u0bc8 \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95 \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bb5\u0bc1\u0bae\u0bcd. \u0bb5\u0bc7\u0bb1\u0bc1 \u0b8f\u0ba4\u0bc7\u0ba9\u0bc1\u0bae\u0bcd \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1, \u0ba4\u0baf\u0bb5\u0bc1\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bc1 \u0b85\u0bb0\u0bc1\u0b95\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b9a\u0bc7\u0bb5\u0bc8 \u0bae\u0bc8\u0baf\u0ba4\u0bcd\u0ba4\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0baf\u0bbf\u0b9f\u0bb5\u0bc1\u0bae\u0bcd"},bankLinkingStatus:{title:"\u0bb5\u0b99\u0bcd\u0b95\u0bbf \u0b87\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bb2\u0bc8",description:"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0b99\u0bcd\u0b95\u0bbf \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bb2\u0bc8\u0baf\u0bc8 \u0b85\u0bb1\u0bbf\u0baf \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0b95"},generateVirtualID:{title:"\u0bae\u0bc6\u0baf\u0bcd\u0ba8\u0bbf\u0b95\u0bb0\u0bcd \u0b90\u0b9f\u0bbf\u0baf\u0bc8 \u0b89\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd",description:"\u0bae\u0bc6\u0baf\u0bcd\u0ba8\u0bbf\u0b95\u0bb0\u0bcd \u0b90\u0b9f\u0bbf (\u0bb5\u0bbf\u0b90\u0b9f\u0bbf) \u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0ba4\u0bbf\u0bb2\u0bbe\u0b95 \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bb2\u0bbe\u0bae\u0bcd. 16 \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b9a\u0bc0\u0bb0\u0bb1\u0bcd\u0bb1 \u0bb5\u0bbf\u0b90\u0b9f\u0bbf\u0baf\u0bc8\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bbf\u0bb1\u0b95\u0bcd\u0b95 \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0b95"},offlineEkyc:{title:"\u0b86\u0b83\u0baa\u0bcd\u0bb2\u0bc8\u0ba9\u0bcd eKYC",description:"\u0b86\u0b83\u0baa\u0bcd\u0bb2\u0bc8\u0ba9\u0bcd \u0b85\u0b9f\u0bc8\u0baf\u0bbe\u0bb3 \u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0b95\u0bbf\u0bb0\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf eKYC \u0b86\u0bb5\u0ba3\u0ba4\u0bcd\u0ba4\u0bc8 \u0b85\u0ba3\u0bc1\u0b95 \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0b95"},lockUnlockBiometrics:{title:"\u0baa\u0baf\u0bcb\u0bae\u0bc6\u0b9f\u0bcd\u0bb0\u0bbf\u0b95\u0bcd\u0bb8\u0bcd \u0bae\u0bc1\u0b9f\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bb2\u0bcd / \u0ba4\u0bbf\u0bb1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd",description:"\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0baf\u0bcb\u0bae\u0bc6\u0b9f\u0bcd\u0bb0\u0bbf\u0b95\u0bcd \u0ba4\u0b95\u0bb5\u0bb2\u0bc8 \u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0bb2\u0bbf\u0b95\u0bae\u0bbe\u0b95 \u0bae\u0bc1\u0b9f\u0b95\u0bcd\u0b95 / \u0ba4\u0bbf\u0bb1\u0b95\u0bcd\u0b95 \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0b95"},lockUnlockAadhaar:{title:"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0bae\u0bc1\u0b9f\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bb2\u0bcd / \u0ba4\u0bbf\u0bb1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd",description:"\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b86\u0ba4\u0bbe\u0bb0\u0bc8 \u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0bb2\u0bbf\u0b95\u0bae\u0bbe\u0b95 \u0bae\u0bc1\u0b9f\u0b95\u0bcd\u0b95 / \u0ba4\u0bbf\u0bb1\u0b95\u0bcd\u0b95 \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0b95. \u0b87\u0ba8\u0bcd\u0ba4 \u0b9a\u0bc7\u0bb5\u0bc8\u0baf\u0bc8 \u0b95\u0bb5\u0ba9\u0bae\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb5\u0bc1\u0bae\u0bcd"},paymentHistory:{title:"\u0b95\u0b9f\u0bcd\u0b9f\u0ba3 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bc1",description:"\u0baa\u0ba3\u0bae\u0bcd \u0b9a\u0bc6\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0ba4\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0ba3\u0ba4\u0bcd\u0ba4\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0baa\u0bcd \u0baa\u0bc6\u0bb1\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0ba8\u0bbf\u0bb2\u0bc8\u0baf\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95 \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bb5\u0bc1\u0bae\u0bcd"},aadharUpdateHistory:{title:"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bc1",description:"\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc8\u0b95\u0bcd \u0b95\u0ba3\u0bcd\u0b9f\u0bb1\u0bbf\u0baf \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bb5\u0bc1\u0bae\u0bcd."},bankSeedingStatus:{title:"\u0bb5\u0b99\u0bcd\u0b95\u0bbf \u0bb5\u0bbf\u0ba4\u0bc8\u0baa\u0bcd\u0baa\u0bc1 \u0ba8\u0bbf\u0bb2\u0bc8",description:"\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0b99\u0bcd\u0b95\u0bbf \u0bb5\u0bbf\u0ba4\u0bc8\u0baa\u0bcd\u0baa\u0bc1 \u0ba8\u0bbf\u0bb2\u0bc8\u0baf\u0bc8\u0b95\u0bcd \u0b95\u0ba3\u0bcd\u0b9f\u0bb1\u0bbf\u0baf \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bb5\u0bc1\u0bae\u0bcd."},authenticationHistory:{title:"\u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bc1",description:"\u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0ba3 \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bb5\u0bc1\u0bae\u0bcd",heading:"\u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc8\u0baa\u0bcd \u0baa\u0bc6\u0bb1 \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0\u0ba4\u0bcd \u0ba4\u0bc7\u0ba4\u0bbf \u0bb5\u0bb0\u0bae\u0bcd\u0baa\u0bc8\u0ba4\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd",modality:"\u0bae\u0bbe\u0ba4\u0bbf\u0bb0\u0bbf\u0baf\u0bc8\u0ba4\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd",fieldStartText:"\u0ba4\u0bca\u0b9f\u0b95\u0bcd\u0b95 \u0ba4\u0bc7\u0ba4\u0bbf\u0baf\u0bc8 \u0b89\u0bb3\u0bcd\u0bb3\u0bbf\u0b9f\u0bb5\u0bc1\u0bae\u0bcd",fieldEndText:"\u0b87\u0bb1\u0bc1\u0ba4\u0bbf \u0ba4\u0bc7\u0ba4\u0bbf\u0baf\u0bc8 \u0b89\u0bb3\u0bcd\u0bb3\u0bbf\u0b9f\u0bb5\u0bc1\u0bae\u0bcd",button:"\u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bc8\u0baa\u0bcd \u0baa\u0bc6\u0bb1\u0bb5\u0bc1\u0bae\u0bcd",tableHeading:"\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0bb5\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0bb3\u0bc8\u0bb5\u0bbe\u0b95 {{txnNumber}} \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bbf\u0b9f\u0bc8\u0ba4\u0bcd\u0ba4\u0ba9",dateRange:"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b8e\u0ba3\u0bcd \u0bb5\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bb5\u0bb0\u0bcd, \u0b95\u0b9f\u0ba8\u0bcd\u0ba4 6 \u0bae\u0bbe\u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b8f\u0ba4\u0bc7\u0ba9\u0bc1\u0bae\u0bcd \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bb0\u0bcd \u0b8f\u0b9c\u0bc6\u0ba9\u0bcd\u0b9a\u0bbf (AUA) \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b85\u0bb5\u0bb0\u0bbe\u0bb2\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 50 \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bc1\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0bb5\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bb2\u0bbe\u0bae\u0bcd.",filterName:"\u0bae\u0bbe\u0ba4\u0bbf\u0bb0\u0bbf\u0baf\u0bc8\u0ba4\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd",note:{l1:"\u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc1:",l2:"AUA \u0baa\u0bb0\u0bbf\u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0ba9\u0bc8 \u0b90\u0b9f\u0bbf:",l3:"\u0b95\u0bcb\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0bcb\u0ba4\u0bc1 \u0ba4\u0ba9\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0baa\u0bb0\u0bbf\u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0ba9\u0bc8 \u0b90\u0b9f\u0bbf.",l4:"\u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0 \u0baa\u0baf\u0ba9\u0bb0\u0bcd \u0b8f\u0b9c\u0bc6\u0ba9\u0bcd\u0b9a\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bb2\u0bcd: ",l5:"\u0baa\u0bb0\u0bbf\u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0ba9\u0bc8 \u0ba4\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0ba9 \u0b8f\u0ba4\u0bc7\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbe\u0bb2\u0bcd, \u0b85\u0ba8\u0bcd\u0ba4 \u0baa\u0bb0\u0bbf\u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0ba9\u0bc8\u0b95\u0bcd\u0b95\u0bc1 AUA\u0b90\u0ba4\u0bcd \u0ba4\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bc1 \u0b95\u0bca\u0bb3\u0bcd\u0bb3\u0bb5\u0bc1\u0bae\u0bcd.",l6:"\u0bb5\u0bbf\u0bb5\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95 \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bb5\u0bc1\u0bae\u0bcd.",l7:"\u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0 \u0baa\u0ba4\u0bbf\u0bb2\u0bcd:",l8:"\u0bb5\u0bc6\u0bb1\u0bcd\u0bb1\u0bbf / \u0ba4\u0bcb\u0bb2\u0bcd\u0bb5\u0bbf",l9:"UIDAI \u0baa\u0bbf\u0bb4\u0bc8\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baf\u0bc0\u0b9f\u0bc1\u0b95\u0bb3\u0bcd:",l10:"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0 \u0baa\u0bbf\u0bb4\u0bc8 \u0b95\u0bc1\u0bb1\u0bbf\u0baf\u0bc0\u0b9f\u0bc1\u0b95\u0bb3\u0bcd.",l11:"\u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bb5\u0bc1\u0bae\u0bcd",l12:"FAQs: ",l13:"\u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0 \u0baa\u0bb0\u0bbf\u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0ba9\u0bc8 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bc1.",l14:"\u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bb5\u0bc1\u0bae\u0bcd",l15:"\u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0 \u0bae\u0bc1\u0bb1\u0bc8: ",l16:"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0 \u0bae\u0bc1\u0bb1\u0bc8: ",l17:"\u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bb0 \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bc1 PDF \u0b95\u0b9f\u0bb5\u0bc1\u0b9a\u0bcd\u0b9a\u0bca\u0bb2\u0bcd 8 \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd. \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bc6\u0baf\u0bb0\u0bbf\u0ba9\u0bcd \u0bae\u0bc1\u0ba4\u0bb2\u0bcd \u0ba8\u0bbe\u0ba9\u0bcd\u0b95\u0bc1 \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bc8 (\u0b86\u0ba4\u0bbe\u0bb0\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc8\u0baa\u0bcd \u0baa\u0bcb\u0bb2) \u0baa\u0bc6\u0bb0\u0bbf\u0baf \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4 \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0bb2\u0bc1\u0bae\u0bcd YYYY \u0bb5\u0b9f\u0bbf\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b87\u0ba3\u0bc8\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd."}},documentUpdate:{title:"\u0b86\u0bb5\u0ba3 \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u0baa\u0bc1",description:"\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0b9f\u0bc8\u0baf\u0bbe\u0bb3\u0b9a\u0bcd \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1 (PoI) \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0b95\u0bb5\u0bb0\u0bbf\u0b9a\u0bcd \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1 (PoA) \u0b86\u0bb5\u0ba3\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bc7\u0bb1\u0bcd\u0bb1 \u0b87\u0b99\u0bcd\u0b95\u0bc7 \u0b95\u0bbf\u0bb3\u0bbf\u0b95\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bb5\u0bc1\u0bae\u0bcd."}}},requests:{title:"\u0b95\u0bc7\u0bbe\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bcd",description:"\u0b9a\u0bae\u0bc0\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0b95\u0bbe\u0bb2\u