c\u0a3c \u0a05\u0a2a\u0a21\u0a47\u0a1f ",description_1:"",description_2:""},guidelines:{heading_1:"\u0a2a\u0a1b\u0a3e\u0a23 \u0a05\u0a24\u0a47 \u0a2a\u0a24\u0a47 \u0a26\u0a47 \u0a38\u0a2e\u0a30\u0a25\u0a28 \u0a35\u0a3f\u0a71\u0a1a \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a05\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a4b",heading_2:"14/06/2025 \u0a24\u0a71\u0a15 \u0a2e\u0a41\u0a2b\u0a3c\u0a24",question_1:{title:"\u0a15\u0a40 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a3e\u0a09\u0a23\u0a3e \u0a39\u0a48?",content:{line_1:"\u0a30\u0a3e\u0a38\u0a3c\u0a28 \u0a15\u0a3e\u0a30\u0a21, \u0a35\u0a4b\u0a1f\u0a30 \u0a38\u0a3c\u0a28\u0a3e\u0a16\u0a24\u0a40 \u0a15\u0a3e\u0a30\u0a21, \u0a38\u0a30\u0a15\u0a3e\u0a30 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a40\u0a24\u0a3e \u0a2a\u0a1b\u0a3e\u0a23 \u0a2a\u0a71\u0a24\u0a30/\u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f \u0a1c\u0a3f\u0a38 \u0a35\u0a3f\u0a71\u0a1a \u0a2a\u0a24\u0a3e \u0a39\u0a4b\u0a35\u0a47 \u0a05\u0a24\u0a47 \u0a2d\u0a3e\u0a30\u0a24\u0a40 \u0a2a\u0a3e\u0a38\u0a2a\u0a4b\u0a30\u0a1f \u0a2a\u0a1b\u0a3e\u0a23 \u0a05\u0a24\u0a47 \u0a2a\u0a24\u0a47 \u0a26\u0a4b\u0a35\u0a3e\u0a02 \u0a26\u0a47 \u0a38\u0a2c\u0a42\u0a24 \u0a35\u0a1c\u0a4b\u0a02 \u0a15\u0a70\u0a2e \u0a15\u0a30\u0a26\u0a47 \u0a39\u0a28\u0964",line_2:"\u0a2a\u0a48\u0a28 \u0a15\u0a3e\u0a30\u0a21, \u0a21\u0a30\u0a3e\u0a08\u0a35\u0a3f\u0a70\u0a17 \u0a32\u0a3e\u0a07\u0a38\u0a48\u0a02\u0a38, \u0a38\u0a48\u0a15\u0a70\u0a21\u0a30\u0a40 \u0a1c\u0a3e\u0a02 \u0a38\u0a40\u0a28\u0a40\u0a05\u0a30 \u0a38\u0a15\u0a42\u0a32 \u0a26\u0a40 \u0a2e\u0a3e\u0a30\u0a15 \u0a38\u0a3c\u0a40\u0a1f/ \u0a2b\u0a4b\u0a1f\u0a4b \u0a35\u0a3e\u0a32\u0a3e \u0a38\u0a15\u0a42\u0a32 \u0a1b\u0a71\u0a21\u0a23 \u0a26\u0a3e \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f, \u0a38\u0a30\u0a15\u0a3e\u0a30 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a40\u0a24\u0a3e \u0a2a\u0a1b\u0a3e\u0a23 \u0a2a\u0a71\u0a24\u0a30/\u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f - \u0a38\u0a3f\u0a30\u0a2b \u0a2a\u0a1b\u0a3e\u0a23 \u0a26\u0a47 \u0a38\u0a2c\u0a42\u0a24 \u0a35\u0a1c\u0a4b\u0a02 \u0a15\u0a70\u0a2e \u0a15\u0a30\u0a26\u0a47 \u0a39\u0a28\u0964",line_3:"\u0a2c\u0a3f\u0a1c\u0a32\u0a40/\u0a2a\u0a3e\u0a23\u0a40/\u0a17\u0a48\u0a38 \u0a2c\u0a3f\u0a71\u0a32 (\u0a2a\u0a3f\u0a1b\u0a32\u0a47 3 \u0a2e\u0a39\u0a40\u0a28\u0a47), \u0a2c\u0a48\u0a02\u0a15/\u0a21\u0a3e\u0a15\u0a16\u0a3e\u0a28\u0a47 \u0a26\u0a40 \u0a2a\u0a3e\u0a38\u0a2c\u0a41\u0a71\u0a15, \u0a15\u0a3f\u0a30\u0a3e\u0a07\u0a06/\u0a32\u0a40\u0a1c\u0a3c/\u0a1b\u0a41\u0a71\u0a1f\u0a40 \u0a05\u0a24\u0a47 \u0a32\u0a3e\u0a07\u0a38\u0a48\u0a02\u0a38 \u0a07\u0a15\u0a30\u0a3e\u0a30\u0a28\u0a3e\u0a2e\u0a3e \u0a38\u0a3f\u0a30\u0a2b\u0a3c \u0a2a\u0a24\u0a47 \u0a26\u0a47 \u0a38\u0a2c\u0a42\u0a24 \u0a35\u0a1c\u0a4b\u0a02 \u0a15\u0a70\u0a2e \u0a15\u0a30\u0a26\u0a47 \u0a39\u0a28\u0964",line_4:"\u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30\u0a2f\u0a4b\u0a17 \u0a2a\u0a1b\u0a3e\u0a23 \u0a05\u0a24\u0a47 \u0a2a\u0a24\u0a47 \u0a26\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a26\u0a40 \u0a35\u0a3f\u0a38\u0a24\u0a4d\u0a30\u0a3f\u0a24 \u0a38\u0a42\u0a1a\u0a40 \u0a32\u0a08, \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b",line_5:" \u0a07\u0a71\u0a25\u0a47"}},question_2:{title:"\u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a3e\u0a09\u0a23\u0a3e \u0a39\u0a48?",content:{line_1:"\u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c myAadhaar \u0a2a\u0a4b\u0a30\u0a1f\u0a32 '\u0a24\u0a47 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a1c\u0a3e\u0a02 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a47\u0a02\u0a26\u0a30 '\u0a24\u0a47 \u0a1c\u0a3e \u0a15\u0a47 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e \u0a15\u0a40\u0a24\u0a47 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964",line_2:"\u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a1c\u0a2e\u0a4d\u0a39\u0a3e \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a15\u0a26\u0a2e \u0a26\u0a30 \u0a15\u0a26\u0a2e \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a32\u0a08 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b",line_3:" \u0a07\u0a71\u0a25\u0a47"}},main_content:{submit:"\u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b",title:"\u0a2e\u0a26\u0a26 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a48?",videoText:"\u0a35\u0a40\u0a21\u0a40\u0a13 \u0a17\u0a3e\u0a08\u0a21",knowMoreText:"\u0a39\u0a4b\u0a30 \u0a1c\u0a3e\u0a23\u0a4b?",callText:"\u0a1f\u0a4b\u0a32-\u0a2b\u0a4d\u0a30\u0a40 (1947) \u0a15\u0a3e\u0a32 \u0a15\u0a30\u0a4b"}},one:{title:"\u0a2e\u0a48\u0a28\u0a42\u0a70 \u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a32\u0a08 \u0a2a\u0a1b\u0a3e\u0a23 \u0a05\u0a24\u0a47 \u0a2a\u0a24\u0a47 \u0a26\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a15\u0a3f\u0a09\u0a02 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a3e\u0a09\u0a23\u0a47 \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a47 \u0a39\u0a28?",content:"\u0a06\u0a27\u0a3e\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a2a\u0a1b\u0a3e\u0a23 \u0a05\u0a24\u0a47 \u0a2a\u0a24\u0a47 \u0a32\u0a08 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a40\u0a24\u0a47 \u0a17\u0a0f \u0a38\u0a39\u0a3e\u0a07\u0a15 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c, \u0a1c\u0a40\u0a35\u0a28 \u0a26\u0a40 \u0a38\u0a4c\u0a16, \u0a2c\u0a3f\u0a39\u0a24\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a28 \u0a05\u0a24\u0a47 \u0a38\u0a39\u0a40 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e \u0a28\u0a42\u0a70 \u0a38\u0a2e\u0a30\u0a71\u0a25 \u0a2c\u0a23\u0a3e\u0a09\u0a02\u0a26\u0a47 \u0a39\u0a28\u0964 \u0a07\u0a38 \u0a32\u0a08, \u0a24\u0a3e\u0a1c\u0a3c\u0a3e \u0a2a\u0a1b\u0a3e\u0a23 \u0a05\u0a24\u0a47 \u0a2a\u0a24\u0a47 \u0a26\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a3e\u0a09\u0a23\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a27\u0a3e\u0a30\u0a15 \u0a26\u0a47 \u0a39\u0a3f\u0a71\u0a24 \u0a35\u0a3f\u0a71\u0a1a \u0a39\u0a48\u0964"},two:{title:"\u0a2e\u0a48\u0a28\u0a42\u0a70 \u0a06\u0a2a\u0a23\u0a40 \u0a2a\u0a1b\u0a3e\u0a23 \u0a05\u0a24\u0a47 \u0a2a\u0a24\u0a47 \u0a32\u0a08 \u0a15\u0a3f\u0a39\u0a5c\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a3e\u0a09\u0a23\u0a47 \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a47 \u0a39\u0a28?",content:{para_1:{heading_one:"\u0a2a\u0a1b\u0a3e\u0a23 \u0a05\u0a24\u0a47 \u0a2a\u0a24\u0a47 \u0a26\u0a4b\u0a35\u0a3e\u0a02 \u0a32\u0a08 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c:",list_1:"(\u0a0f) \u0a30\u0a3e\u0a38\u0a3c\u0a28 \u0a15\u0a3e\u0a30\u0a21",list_2:"(\u0a2c\u0a40) \u0a35\u0a4b\u0a1f\u0a30 \u0a2a\u0a1b\u0a3e\u0a23 \u0a2a\u0a71\u0a24\u0a30",list_3:"(\u0a38\u0a40) \u0a15\u0a3f\u0a38\u0a3e\u0a28 \u0a2b\u0a4b\u0a1f\u0a4b \u0a2a\u0a3e\u0a38\u0a2c\u0a41\u0a71\u0a15",list_4:"(\u0a21\u0a40) \u0a2d\u0a3e\u0a30\u0a24\u0a40 \u0a2a\u0a3e\u0a38\u0a2a\u0a4b\u0a30\u0a1f",list_5:"(\u0a08) \u0a38\u0a30\u0a15\u0a3e\u0a30 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a40\u0a24\u0a3e \u0a2a\u0a1b\u0a3e\u0a23 \u0a2a\u0a71\u0a24\u0a30/\u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f 1, ST/SC/OBC \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f \u0a1c\u0a3e\u0a02 \u0a35\u0a3f\u0a06\u0a39 \u0a26\u0a3e \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f, \u0a2b\u0a4b\u0a1f\u0a4b \u0a35\u0a3e\u0a32\u0a3e",list_6:"(\u0a10\u0a2b) \u0a05\u0a2a\u0a70\u0a17\u0a24\u0a3e \u0a2a\u0a1b\u0a3e\u0a23 \u0a2a\u0a71\u0a24\u0a30 / \u0a05\u0a2a\u0a70\u0a17\u0a24\u0a3e \u0a26\u0a3e \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f",list_7:"(\u0a1c\u0a40) \u0a1f\u0a4d\u0a30\u0a3e\u0a02\u0a38\u0a1c\u0a48\u0a02\u0a21\u0a30 \u0a2a\u0a1b\u0a3e\u0a23 \u0a2a\u0a71\u0a24\u0a30/\u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f",list_8:"(\u0a10\u0a1a) \u0a07\u0a71\u0a15 \u0a38\u0a48\u0a15\u0a38 \u0a35\u0a30\u0a15\u0a30 \u0a26\u0a47 \u0a38\u0a2c\u0a70\u0a27 \u0a35\u0a3f\u0a71\u0a1a UIDAI \u0a38\u0a1f\u0a48\u0a02\u0a21\u0a30\u0a21 \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f \u0a2b\u0a3e\u0a30\u0a2e\u0a48\u0a1f \u0a35\u0a3f\u0a71\u0a1a \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a40\u0a24\u0a3e \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f",list_9:"(\u0a06\u0a08) \u0a2e\u0a3e\u0a28\u0a24\u0a3e \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a38\u0a3c\u0a48\u0a32\u0a1f\u0a30 \u0a39\u0a4b\u0a2e \u0a1c\u0a3e\u0a02 \u0a05\u0a28\u0a3e\u0a25 \u0a06\u0a38\u0a3c\u0a30\u0a2e\u0a3e\u0a02 \u0a26\u0a41\u0a06\u0a30\u0a3e UIDAI \u0a38\u0a1f\u0a48\u0a02\u0a21\u0a30\u0a21 \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f \u0a2b\u0a3e\u0a30\u0a2e\u0a48\u0a1f \u0a35\u0a3f\u0a71\u0a1a \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a40\u0a24\u0a3e \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f",list_10:"(\u0a1c\u0a47) \u0a1c\u0a47\u0a32\u0a4d\u0a39 \u0a05\u0a27\u0a3f\u0a15\u0a3e\u0a30\u0a40 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a48\u0a26\u0a40 \u0a38\u0a3c\u0a3e\u0a2e\u0a32 \u0a15\u0a30\u0a28 \u0a26\u0a3e \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c"},para_2:{heading_one:"\u0a2a\u0a1b\u0a3e\u0a23 \u0a32\u0a08 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c:",list_1:"(\u0a0f) \u0a38\u0a15\u0a42\u0a32 \u0a1b\u0a71\u0a21\u0a23 \u0a26\u0a3e \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f / \u0a2b\u0a4b\u0a1f\u0a4b \u0a26\u0a47 \u0a28\u0a3e\u0a32 \u0a38\u0a15\u0a42\u0a32 \u0a26\u0a3e \u0a24\u0a2c\u0a3e\u0a26\u0a32\u0a3e \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f",list_2:"(\u0a2c\u0a40) \u0a2e\u0a3e\u0a28\u0a24\u0a3e \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a38\u0a3f\u0a71\u0a16\u0a3f\u0a06 \u0a2c\u0a4b\u0a30\u0a21 \u0a1c\u0a3e\u0a02 \u0a2f\u0a42\u0a28\u0a40\u0a35\u0a30\u0a38\u0a3f\u0a1f\u0a40 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a2b\u0a4b\u0a1f\u0a4b \u0a38\u0a2e\u0a47\u0a24 \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a40\u0a24\u0a40 \u0a2e\u0a3e\u0a30\u0a15\u0a38\u0a3c\u0a40\u0a1f/\u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f",list_3:"(\u0a38\u0a40) \u0a2a\u0a48\u0a28/\u0a08-\u0a2a\u0a48\u0a28 \u0a15\u0a3e\u0a30\u0a21",list_4:"(\u0a21\u0a40) \u0a38\u0a30\u0a15\u0a3e\u0a30/\u0a15\u0a3e\u0a28\u0a42\u0a70\u0a28\u0a40-\u0a38\u0a30\u0a40\u0a30/PSU \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a30\u0a2e\u0a1a\u0a3e\u0a30\u0a40/\u0a2a\u0a48\u0a28\u0a38\u0a3c\u0a28\u0a30 \u0a2b\u0a4b\u0a1f\u0a4b \u0a2a\u0a1b\u0a3e\u0a23 \u0a2a\u0a71\u0a24\u0a30, \u0a2a\u0a48\u0a28\u0a38\u0a3c\u0a28 \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a06\u0a30\u0a21\u0a30 \u0a1c\u0a3e\u0a02 \u0a2e\u0a48\u0a21\u0a40-\u0a15\u0a32\u0a47\u0a2e \u0a15\u0a3e\u0a30\u0a21",list_5:"(\u0a08) \u0a21\u0a30\u0a3e\u0a08\u0a35\u0a3f\u0a70\u0a17 \u0a32\u0a3e\u0a07\u0a38\u0a70\u0a38",list_6:"(\u0a10\u0a2b) \u0a38\u0a41\u0a24\u0a70\u0a24\u0a30\u0a24\u0a3e \u0a38\u0a48\u0a28\u0a3e\u0a28\u0a40 \u0a2b\u0a4b\u0a1f\u0a4b \u0a2a\u0a1b\u0a3e\u0a23 \u0a2a\u0a71\u0a24\u0a30"},para_3:{heading_one:"\u0a2a\u0a24\u0a47 \u0a32\u0a08 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c:",list_1:"(\u0a0f) \u0a2c\u0a3f\u0a1c\u0a32\u0a40, \u0a2a\u0a3e\u0a23\u0a40, \u0a17\u0a48\u0a38 \u0a1c\u0a3e\u0a02 \u0a1f\u0a48\u0a32\u0a40\u0a2b\u0a4b\u0a28/\u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32/\u0a2c\u0a30\u0a3e\u0a21\u0a2c\u0a48\u0a02\u0a21 \u0a2c\u0a3f\u0a71\u0a32 (\u0a24\u0a3f\u0a70\u0a28 \u0a2e\u0a39\u0a40\u0a28\u0a3f\u0a06\u0a02 \u0a24\u0a4b\u0a02 \u0a35\u0a71\u0a27 \u0a2a\u0a41\u0a30\u0a3e\u0a23\u0a3e \u0a28\u0a39\u0a40\u0a02)",list_2:"(\u0a2c\u0a40) \u0a2b\u0a4b\u0a1f\u0a4b \u0a26\u0a47 \u0a28\u0a3e\u0a32 \u0a05\u0a28\u0a41\u0a38\u0a42\u0a1a\u0a3f\u0a24 \u0a15\u0a2e\u0a30\u0a38\u0a3c\u0a40\u0a05\u0a32 \u0a2c\u0a48\u0a02\u0a15 / \u0a2a\u0a4b\u0a38\u0a1f \u0a06\u0a2b\u0a3f\u0a38 \u0a2a\u0a3e\u0a38\u0a2c\u0a41\u0a71\u0a15 '\u0a24\u0a47 \u0a38\u0a39\u0a40 \u0a22\u0a70\u0a17 \u0a28\u0a3e\u0a32 \u0a26\u0a38\u0a24\u0a16\u0a24 \u0a05\u0a24\u0a47 \u0a2e\u0a4b\u0a39\u0a30 \u0a32\u0a71\u0a17\u0a40",list_3:"(\u0a38\u0a40) \u0a05\u0a28\u0a41\u0a38\u0a42\u0a1a\u0a3f\u0a24 \u0a15\u0a2e\u0a30\u0a38\u0a3c\u0a40\u0a05\u0a32 \u0a2c\u0a48\u0a02\u0a15/\u0a21\u0a3e\u0a15\u0a18\u0a30 \u0a16\u0a3e\u0a24\u0a3e/\u0a15\u0a4d\u0a30\u0a48\u0a21\u0a3f\u0a1f-\u0a15\u0a3e\u0a30\u0a21 \u0a38\u0a1f\u0a47\u0a1f\u0a2e\u0a48\u0a02\u0a1f (\u0a24\u0a3f\u0a70\u0a28 \u0a2e\u0a39\u0a40\u0a28\u0a3f\u0a06\u0a02 \u0a24\u0a4b\u0a02 \u0a35\u0a71\u0a27 \u0a2a\u0a41\u0a30\u0a3e\u0a23\u0a40 \u0a28\u0a39\u0a40\u0a02)",list_4:"(\u0a21\u0a40) \u0a35\u0a48\u0a27 \u0a15\u0a3f\u0a30\u0a3e\u0a07\u0a06, \u0a32\u0a40\u0a1c\u0a3c \u0a1c\u0a3e\u0a02 \u0a1b\u0a41\u0a71\u0a1f\u0a40 \u0a05\u0a24\u0a47 \u0a32\u0a3e\u0a07\u0a38\u0a48\u0a02\u0a38 \u0a38\u0a2e\u0a1d\u0a4c\u0a24\u0a3e",list_5:"(\u0a08) \u0a10\u0a2e\u0a2a\u0a40, \u0a10\u0a2e\u0a10\u0a32\u0a0f, \u0a10\u0a2e\u0a10\u0a32\u0a38\u0a40, \u0a2e\u0a3f\u0a09\u0a02\u0a38\u0a2a\u0a32 \u0a15\u0a4c\u0a02\u0a38\u0a32\u0a30, \u0a17\u0a30\u0a41\u0a71\u0a2a '\u0a0f' \u0a1c\u0a3e\u0a02 '\u0a2c\u0a40' \u0a17\u0a1c\u0a3c\u0a1f\u0a3f\u0a21 \u0a05\u0a2b\u0a38\u0a30, \u0a08\u0a2a\u0a40\u0a10\u0a2b\u0a13 \u0a05\u0a2b\u0a38\u0a30 \u0a1c\u0a3e\u0a02 \u0a24\u0a39\u0a3f\u0a38\u0a40\u0a32\u0a26\u0a3e\u0a30 \u0a26\u0a41\u0a06\u0a30\u0a3e UIDAI \u0a38\u0a1f\u0a48\u0a02\u0a21\u0a30\u0a21 \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f \u0a2b\u0a3e\u0a30\u0a2e\u0a48\u0a1f \u0a35\u0a3f\u0a71\u0a1a \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f",list_6:"(\u0a10\u0a2b) \u0a17\u0a4d\u0a30\u0a3e\u0a2e \u0a2a\u0a70\u0a1a\u0a3e\u0a07\u0a24 \u0a2e\u0a41\u0a16\u0a40/\u0a38\u0a15\u0a71\u0a24\u0a30, \u0a17\u0a4d\u0a30\u0a3e\u0a2e \u0a2e\u0a3e\u0a32 \u0a05\u0a27\u0a3f\u0a15\u0a3e\u0a30\u0a40 \u0a1c\u0a3e\u0a02 \u0a07\u0a38 \u0a26\u0a47 \u0a2c\u0a30\u0a3e\u0a2c\u0a30 (\u0a2a\u0a47\u0a02\u0a21\u0a42 \u0a16\u0a47\u0a24\u0a30\u0a3e\u0a02 \u0a32\u0a08) \u0a26\u0a41\u0a06\u0a30\u0a3e UIDAI \u0a38\u0a1f\u0a48\u0a02\u0a21\u0a30\u0a21 \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f \u0a2b\u0a3e\u0a30\u0a2e\u0a48\u0a1f \u0a35\u0a3f\u0a71\u0a1a \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f\u0964",list_7:"(\u0a1c\u0a40) \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a2e\u0a3e\u0a28\u0a24\u0a3e \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a35\u0a3f\u0a26\u0a3f\u0a05\u0a15 \u0a38\u0a70\u0a38\u0a25\u0a3e \u0a26\u0a47 \u0a2e\u0a41\u0a16\u0a40 \u0a26\u0a41\u0a06\u0a30\u0a3e UIDAI \u0a38\u0a1f\u0a48\u0a02\u0a21\u0a30\u0a21 \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f \u0a2b\u0a3e\u0a30\u0a2e\u0a48\u0a1f \u0a35\u0a3f\u0a71\u0a1a \u0a35\u0a3f\u0a26\u0a3f\u0a06\u0a30\u0a25\u0a40 \u0a28\u0a42\u0a70 \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f",list_8:"(\u0a10\u0a1a) \u0a1c\u0a3e\u0a07\u0a26\u0a3e\u0a26 \u0a1f\u0a48\u0a15\u0a38 \u0a26\u0a40 \u0a30\u0a38\u0a40\u0a26 (\u0a07\u0a71\u0a15 \u0a38\u0a3e\u0a32 \u0a24\u0a4b\u0a02 \u0a35\u0a71\u0a27 \u0a2a\u0a41\u0a30\u0a3e\u0a23\u0a40 \u0a28\u0a39\u0a40\u0a02)",list_9:"(\u0a06\u0a08) \u0a35\u0a48\u0a27 \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a35\u0a3f\u0a15\u0a30\u0a40 \u0a38\u0a2e\u0a1d\u0a4c\u0a24\u0a3e \u0a1c\u0a3e\u0a02 \u0a24\u0a4b\u0a39\u0a2b\u0a3c\u0a3e \u0a21\u0a40\u0a21",list_10:"(\u0a1c\u0a47) \u0a38\u0a30\u0a15\u0a3e\u0a30/\u0a35\u0a3f\u0a27\u0a3e\u0a28\u0a3f\u0a15 \u0a38\u0a70\u0a38\u0a25\u0a3e/PSU \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a1c\u0a3e\u0a30\u0a40 \u0a30\u0a3f\u0a39\u0a3e\u0a07\u0a38\u0a3c \u0a05\u0a32\u0a3e\u0a1f\u0a2e\u0a48\u0a02\u0a1f \u0a2a\u0a71\u0a24\u0a30 (\u0a07\u0a71\u0a15 \u0a38\u0a3e\u0a32 \u0a24\u0a4b\u0a02 \u0a35\u0a71\u0a27 \u0a2a\u0a41\u0a30\u0a3e\u0a23\u0a3e \u0a28\u0a39\u0a40\u0a02)",list_11:"(\u0a15\u0a47) \u0a1c\u0a40\u0a35\u0a28 \u0a1c\u0a3e\u0a02 \u0a2e\u0a48\u0a21\u0a40\u0a15\u0a32 \u0a2c\u0a40\u0a2e\u0a3e \u0a2a\u0a3e\u0a32\u0a3f\u0a38\u0a40 (\u0a07\u0a71\u0a15 \u0a38\u0a3e\u0a32 \u0a24\u0a4b\u0a02 \u0a35\u0a71\u0a27 \u0a2a\u0a41\u0a30\u0a3e\u0a23\u0a40 \u0a28\u0a39\u0a40\u0a02)"}}},three:{title:"\u0a2e\u0a48\u0a02 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e/\u0a38\u0a15\u0a26\u0a40 \u0a39\u0a3e\u0a02?",content:"\u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c myAadhaar \u0a2a\u0a4b\u0a30\u0a1f\u0a32 https://myaadhaar.uidai.gov.in/ '\u0a24\u0a47 \u0a06\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a1c\u0a3e\u0a02 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a47\u0a02\u0a26\u0a30 '\u0a24\u0a47 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e \u0a15\u0a40\u0a24\u0a47 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964"},four:{title:"\u0a2e\u0a48\u0a02 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a06\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e/\u0a38\u0a15\u0a26\u0a40 \u0a39\u0a3e\u0a02?",content:{list_1:"(1) https://myaadhaar.uidai.gov.in/ '\u0a24\u0a47 \u0a1c\u0a3e\u0a13, \u0a05\u0a24\u0a47 \u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a05\u0a24\u0a47 \u0a30\u0a1c\u0a3f\u0a38\u0a1f\u0a30\u0a21 \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30 '\u0a24\u0a47 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a39\u0a4b\u0a0f \u0a35\u0a28-\u0a1f\u0a3e\u0a08\u0a2e \u0a2a\u0a3e\u0a38\u0a35\u0a30\u0a21 (OTP) \u0a26\u0a40 \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30\u0a15\u0a47 \u0a32\u0a4c\u0a17\u0a07\u0a28 \u0a15\u0a30\u0a4b\u0964",list_2:"(2) \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a2a\u0a4d\u0a30\u0a4b\u0a2b\u0a3e\u0a08\u0a32 \u0a35\u0a3f\u0a71\u0a1a \u0a2a\u0a4d\u0a30\u0a26\u0a30\u0a38\u0a3c\u0a3f\u0a24 \u0a06\u0a2a\u0a23\u0a40 \u0a2a\u0a1b\u0a3e\u0a23 \u0a05\u0a24\u0a47 \u0a2a\u0a24\u0a47 \u0a26\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a4b\u0964",list_3:"(3) \u0a1c\u0a47\u0a15\u0a30 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a2a\u0a4d\u0a30\u0a4b\u0a2b\u0a3e\u0a08\u0a32 \u0a35\u0a3f\u0a71\u0a1a \u0a2a\u0a4d\u0a30\u0a26\u0a30\u0a38\u0a3c\u0a3f\u0a24 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a17\u0a32\u0a24 \u0a39\u0a28, \u0a24\u0a3e\u0a02 \u0a39\u0a47\u0a20\u0a3e\u0a02 \u0a26\u0a3f\u0a71\u0a24\u0a47 \u0a38\u0a35\u0a3e\u0a32 5 \u0a26\u0a47 \u0a1c\u0a35\u0a3e\u0a2c \u0a35\u0a3f\u0a71\u0a1a \u0a26\u0a71\u0a38\u0a47 \u0a05\u0a28\u0a41\u0a38\u0a3e\u0a30 \u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08 \u0a15\u0a30\u0a4b\u0964",list_4:"(4) \u0a1c\u0a47\u0a15\u0a30 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a2a\u0a4d\u0a30\u0a4b\u0a2b\u0a3e\u0a08\u0a32 \u0a35\u0a3f\u0a71\u0a1a \u0a26\u0a30\u0a38\u0a3e\u0a0f \u0a17\u0a0f \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a38\u0a39\u0a40 \u0a39\u0a28, \u0a24\u0a3e\u0a02 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 '\u0a2e\u0a48\u0a02 \u0a2a\u0a41\u0a38\u0a3c\u0a1f\u0a40 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a3e\u0a02 \u0a15\u0a3f \u0a09\u0a2a\u0a30\u0a4b\u0a15\u0a24 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a38\u0a39\u0a40 \u0a39\u0a28' \u0a1f\u0a48\u0a2c '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964",list_5:"(5) \u0a21\u0a4d\u0a30\u0a4c\u0a2a-\u0a21\u0a3e\u0a09\u0a28 \u0a2e\u0a40\u0a28\u0a42 \u0a24\u0a4b\u0a02 \u0a2a\u0a1b\u0a3e\u0a23 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a1a\u0a41\u0a23\u0a4b \u0a1c\u0a4b \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a47 \u0a39\u0a4b\u0964",list_6:"(6) \u0a06\u0a2a\u0a23\u0a3e \u0a2a\u0a1b\u0a3e\u0a23 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a05\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a4b (2 MB \u0a24\u0a4b\u0a02 \u0a18\u0a71\u0a1f \u0a06\u0a15\u0a3e\u0a30; \u0a2b\u0a3e\u0a08\u0a32 \u0a2b\u0a3e\u0a30\u0a2e\u0a48\u0a1f JPEG, PNG \u0a1c\u0a3e\u0a02 PDF)",list_7:"(7) \u0a21\u0a4d\u0a30\u0a4c\u0a2a-\u0a21\u0a3e\u0a09\u0a28 \u0a2e\u0a40\u0a28\u0a42 \u0a24\u0a4b\u0a02 \u0a10\u0a21\u0a30\u0a48\u0a71\u0a38 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a1a\u0a41\u0a23\u0a4b \u0a1c\u0a4b \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e \u0a15\u0a30\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a47 \u0a39\u0a4b\u0964",list_8:"(8) \u0a06\u0a2a\u0a23\u0a3e \u0a2a\u0a24\u0a3e \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a05\u0a71\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a4b (2 MB \u0a24\u0a4b\u0a02 \u0a18\u0a71\u0a1f \u0a06\u0a15\u0a3e\u0a30; \u0a2b\u0a3e\u0a08\u0a32 \u0a2b\u0a3e\u0a30\u0a2e\u0a48\u0a1f JPEG, PNG \u0a1c\u0a3e\u0a02 PDF)\u0964",list_9:"(9) \u0a06\u0a2a\u0a23\u0a40 \u0a38\u0a39\u0a3f\u0a2e\u0a24\u0a40 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b\u0964"}},five:{title:"\u0a1c\u0a47\u0a15\u0a30 \u0a2e\u0a47\u0a30\u0a47 \u0a2a\u0a4d\u0a30\u0a4b\u0a2b\u0a3e\u0a08\u0a32 \u0a35\u0a3f\u0a71\u0a1a \u0a26\u0a3f\u0a16\u0a3e\u0a07\u0a06 \u0a17\u0a3f\u0a06 \u0a2a\u0a24\u0a3e \u0a2e\u0a47\u0a30\u0a47 \u0a2e\u0a4c\u0a1c\u0a42\u0a26\u0a3e \u0a2a\u0a24\u0a47 \u0a28\u0a3e\u0a32 \u0a2e\u0a47\u0a32 \u0a28\u0a39\u0a40\u0a02 \u0a16\u0a3e\u0a02\u0a26\u0a3e, \u0a24\u0a3e\u0a02 \u0a2e\u0a48\u0a28\u0a42\u0a70 \u0a15\u0a40 \u0a15\u0a30\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a3e \u0a39\u0a48?",content:{list_1:"(1) \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 '\u0a2e\u0a48\u0a02 \u0a24\u0a38\u0a26\u0a40\u0a15 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a3e\u0a02 \u0a15\u0a3f \u0a09\u0a2a\u0a30\u0a4b\u0a15\u0a24 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a38\u0a39\u0a40 \u0a39\u0a28', \u0a1f\u0a48\u0a2c \u0a26\u0a47 \u0a39\u0a47\u0a20\u0a3e\u0a02 '\u0a1c\u0a47\u0a15\u0a30 \u0a2a\u0a24\u0a47 \u0a35\u0a3f\u0a71\u0a1a \u0a15\u0a4b\u0a08 \u0a2e\u0a47\u0a32 \u0a28\u0a39\u0a40\u0a02 \u0a16\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b' \u0a32\u0a3f\u0a70\u0a15 '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964",list_2:"(2) \u0a2a\u0a4d\u0a30\u0a26\u0a30\u0a38\u0a3c\u0a3f\u0a24 \u0a2b\u0a3e\u0a30\u0a2e \u0a35\u0a3f\u0a71\u0a1a \u0a2a\u0a24\u0a47 \u0a26\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a2d\u0a30\u0a4b\u0964",list_3:"(3) \u0a21\u0a4d\u0a30\u0a4c\u0a2a-\u0a21\u0a3e\u0a09\u0a28 \u0a2e\u0a40\u0a28\u0a42 \u0a24\u0a4b\u0a02 \u0a2a\u0a24\u0a3e \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a1a\u0a41\u0a23\u0a4b \u0a1c\u0a3f\u0a38 \u0a28\u0a42\u0a70 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a05\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a47 \u0a39\u0a4b\u0964",list_4:"(4) \u0a06\u0a2a\u0a23\u0a3e \u0a2a\u0a24\u0a3e \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a05\u0a71\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a4b (2 MB \u0a24\u0a4b\u0a02 \u0a18\u0a71\u0a1f \u0a06\u0a15\u0a3e\u0a30; \u0a2b\u0a3e\u0a08\u0a32 \u0a2b\u0a3e\u0a30\u0a2e\u0a48\u0a1f JPEG, PNG \u0a1c\u0a3e\u0a02 PDF)\u0964",list_5:"(5) \u0a32\u0a4b\u0a5c\u0a40\u0a02\u0a26\u0a3e \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a30\u0a4b\u0964",list_6:"(6) \u0a06\u0a2a\u0a23\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b\u0964"}},six:{title:"\u0a1c\u0a47\u0a15\u0a30 \u0a15\u0a4b\u0a08 \u0a2a\u0a1b\u0a3e\u0a23 \u0a35\u0a47\u0a30\u0a35\u0a3e (\u0a28\u0a3e\u0a2e, \u0a32\u0a3f\u0a70\u0a17 \u0a1c\u0a3e\u0a02 \u0a1c\u0a28\u0a2e \u0a2e\u0a3f\u0a24\u0a40) \u0a2e\u0a47\u0a30\u0a47 \u0a05\u0a38\u0a32 \u0a2a\u0a1b\u0a3e\u0a23 \u0a35\u0a47\u0a30\u0a35\u0a3f\u0a06\u0a02 \u0a28\u0a3e\u0a32 \u0a2e\u0a47\u0a32 \u0a28\u0a39\u0a40\u0a02 \u0a16\u0a3e\u0a02\u0a26\u0a3e, \u0a24\u0a3e\u0a02 \u0a2e\u0a48\u0a28\u0a42\u0a70 \u0a15\u0a40 \u0a15\u0a30\u0a28\u0a3e \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a3e \u0a39\u0a48?",content:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 https://uidai.gov.in/images/commdoc/List_of_Supporting_Document_for_Aadhaar_Enrolment_and_Update.pdf '\u0a24\u0a47 \u0a38\u0a42\u0a1a\u0a40\u0a2c\u0a71\u0a27 \u0a2e\u0a42\u0a32 \u0a2a\u0a1b\u0a3e\u0a23 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a26\u0a47 \u0a28\u0a3e\u0a32 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a47\u0a02\u0a26\u0a30 '\u0a24\u0a47 \u0a1c\u0a3e\u0a13\u0964"},seven:{title:"\u0a1c\u0a47\u0a15\u0a30 \u0a2e\u0a48\u0a02 \u0a14\u0a2b\u0a32\u0a3e\u0a08\u0a28 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a35\u0a3e\u0a09\u0a23\u0a3e \u0a1a\u0a3e\u0a39\u0a41\u0a70\u0a26\u0a3e \u0a39\u0a3e\u0a02, \u0a24\u0a3e\u0a02 \u0a2e\u0a48\u0a02 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a47\u0a02\u0a26\u0a30 \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a32\u0a71\u0a2d \u0a38\u0a15\u0a26\u0a3e/\u0a38\u0a15\u0a26\u0a40 \u0a39\u0a3e\u0a02?",content:{list_1:"(1) \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 https://bhuvan.nrsc.gov.in/aadhaar/ '\u0a24\u0a47 \u0a1c\u0a3e\u0a13",list_2:"(2) \u0a28\u0a47\u0a5c\u0a32\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a47\u0a02\u0a26\u0a30\u0a3e\u0a02 \u0a26\u0a3e \u0a2a\u0a24\u0a3e \u0a32\u0a17\u0a3e\u0a09\u0a23 \u0a32\u0a08, '\u0a28\u0a47\u0a5c\u0a32\u0a47 \u0a15\u0a47\u0a02\u0a26\u0a30\u0a3e\u0a02' \u0a1f\u0a48\u0a2c '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964 \u0a28\u0a47\u0a5c\u0a32\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a47\u0a02\u0a26\u0a30\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a26\u0a47\u0a16\u0a23 \u0a32\u0a08 \u0a06\u0a2a\u0a23\u0a47 \u0a1f\u0a3f\u0a15\u0a3e\u0a23\u0a47 \u0a26\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a26\u0a3e\u0a16\u0a32 \u0a15\u0a30\u0a4b\u0964",list_3:"(3) \u0a06\u0a2a\u0a23\u0a47 \u0a2a\u0a3f\u0a70\u0a28 \u0a15\u0a4b\u0a21 \u0a16\u0a47\u0a24\u0a30 \u0a26\u0a47 \u0a05\u0a70\u0a26\u0a30 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a47\u0a02\u0a26\u0a30\u0a3e\u0a02 \u0a26\u0a3e \u0a2a\u0a24\u0a3e \u0a32\u0a17\u0a3e\u0a09\u0a23 \u0a32\u0a08, '\u0a2a\u0a3f\u0a70\u0a28 \u0a15\u0a4b\u0a21 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a16\u0a4b\u0a1c \u0a15\u0a30\u0a4b' \u0a1f\u0a48\u0a2c '\u0a24\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964 \u0a09\u0a38 \u0a16\u0a47\u0a24\u0a30 \u0a35\u0a3f\u0a71\u0a1a \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a47\u0a02\u0a26\u0a30\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a26\u0a47\u0a16\u0a23 \u0a32\u0a08 \u0a06\u0a2a\u0a23\u0a47 \u0a16\u0a47\u0a24\u0a30 \u0a26\u0a3e \u0a2a\u0a3f\u0a70\u0a28 \u0a15\u0a4b\u0a21 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b\u0964"}},eight:{title:"\u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a3e\u0a09\u0a23 \u0a26\u0a3e \u0a15\u0a40 \u0a5e\u0a40\u0a38 \u0a39\u0a48?",content:"myAadhaar \u0a2a\u0a4b\u0a30\u0a1f\u0a32 '\u0a24\u0a47 14 \u0a38\u0a24\u0a70\u0a2c\u0a30 2023 \u0a24\u0a71\u0a15 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a35\u0a3e\u0a09\u0a23\u0a3e \u0a2e\u0a41\u0a2b\u0a24 \u0a39\u0a48\u0964 \u0a06\u0a27\u0a3e\u0a30 \u0a15\u0a47\u0a02\u0a26\u0a30 '\u0a24\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a3e\u0a09\u0a23 \u0a32\u0a08, \u0a32\u0a3e\u0a17\u0a42 \u0a5e\u0a40\u0a38 50 \u0a30\u0a41\u0a2a\u0a0f \u0a39\u0a48\u0964 "},nine:{title:"\u0a2e\u0a48\u0a28\u0a42\u0a70 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a15\u0a26\u0a4b\u0a02 \u0a24\u0a71\u0a15 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a3e\u0a09\u0a23\u0a47 \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a47 \u0a39\u0a28?",content:"\u0a1c\u0a40\u0a35\u0a28 \u0a26\u0a40 \u0a38\u0a4c\u0a16, \u0a2c\u0a3f\u0a39\u0a24\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30\u0a28 \u0a05\u0a24\u0a47 \u0a38\u0a39\u0a40 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e \u0a28\u0a42\u0a70 \u0a38\u0a2e\u0a30\u0a71\u0a25 \u0a2c\u0a23\u0a3e\u0a09\u0a23 \u0a32\u0a08 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28\u0a3e \u0a2b\u0a3e\u0a07\u0a26\u0a47\u0a2e\u0a70\u0a26 \u0a39\u0a48\u0964 \u0a07\u0a38 \u0a32\u0a08, \u0a1c\u0a32\u0a26\u0a40 \u0a24\u0a4b\u0a02 \u0a1c\u0a32\u0a26\u0a40 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30\u0a3e\u0a09\u0a23\u0a3e \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a39\u0a3f\u0a71\u0a24 \u0a35\u0a3f\u0a71\u0a1a \u0a39\u0a48\u0964"},ten:{title:"\u0a2e\u0a48\u0a02 \u0a07\u0a71\u0a15 \u0a17\u0a48\u0a30-\u0a28\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a2d\u0a3e\u0a30\u0a24\u0a40 (NRI) \u0a39\u0a3e\u0a02\u0964 \u0a2e\u0a48\u0a02 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a3e\u0a02?",content:"\u0a1c\u0a26\u0a4b\u0a02 \u0a35\u0a40 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a2d\u0a3e\u0a30\u0a24 \u0a35\u0a3f\u0a71\u0a1a \u0a39\u0a4b \u0a24\u0a3e\u0a02 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a1c\u0a2e\u0a4d\u0a39\u0a3e\u0a02 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964"}}},aadharUpdateHistory:{title1:"\u0a06\u0a2a\u0a23\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a07\u0a24\u0a3f\u0a39\u0a3e\u0a38 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a4b",label1:"\u0a30\u0a3f\u0a15\u0a3e\u0a30\u0a21",label2:"\u0a28\u0a3e\u0a2e\u0a3e\u0a02\u0a15\u0a23/\u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a26\u0a40 \u0a2e\u0a3f\u0a24\u0a40",label3:"URN/EID ",label4:"\u0a1f\u0a3e\u0a08\u0a2a \u0a15\u0a30\u0a4b",list1:"\u0a28\u0a3e\u0a2e",list2:"\u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32",list3:"\u0a08 - \u0a2e\u0a47\u0a32",list4:"\u0a1c\u0a28\u0a2e \u0a24\u0a3e\u0a30\u0a40\u0a16",list5:"\u0a32\u0a3f\u0a70\u0a17",list6:"\u0a2a\u0a24\u0a3e"},ssup:{howItWorks:{title:"\u0a07\u0a39 \u0a15\u0a70\u0a2e \u0a15\u0a3f\u0a35\u0a47\u0a02 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48 ",description:"\u0a06\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a28\u0a42\u0a70 \u0a38\u0a2e\u0a1d\u0a23 \u0a32\u0a08 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a39\u0a47\u0a20\u0a3e\u0a02 \u0a26\u0a3f\u0a71\u0a24\u0a47 \u0a15\u0a26\u0a2e\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a2a\u0a5c\u0a4d\u0a39\u0a4b\u0964 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a26\u0a40 \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a15\u0a30\u0a28 \u0a1c\u0a3e\u0a02 \u0a05\u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30 \u0a15\u0a30\u0a28 \u0a35\u0a3f\u0a71\u0a1a \u0a26\u0a47\u0a30\u0a40 \u0a24\u0a4b\u0a02 \u0a2c\u0a1a\u0a23 \u0a32\u0a08 \u0a35\u0a71\u0a16-\u0a35\u0a71\u0a16 \u0a15\u0a26\u0a2e\u0a3e\u0a02 \u0a09\u0a71\u0a24\u0a47 \u0a26\u0a3f\u0a71\u0a24\u0a40\u0a06\u0a02 \u0a17\u0a08\u0a06\u0a02 \u0a15\u0a3f\u0a30\u0a3f\u0a06\u0a35\u0a3e\u0a02 \u0a26\u0a3e \u0a2a\u0a3e\u0a32\u0a23 \u0a15\u0a30\u0a4b\u0964",proceedToUpdateAadhaar:"\u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a05\u0a71\u0a17\u0a47 \u0a35\u0a71\u0a27\u0a4b",stepDescription:{one:"\u0a38\u0a42\u0a1a\u0a40 \u0a35\u0a3f\u0a71\u0a1a\u0a4b\u0a02 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a2a\u0a24\u0a3e \u0a16\u0a47\u0a24\u0a30 \u0a1a\u0a41\u0a23\u0a4b\u0964 \u0a07\u0a38 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a2a\u0a4b\u0a30\u0a1f\u0a32 \u0a30\u0a3e\u0a39\u0a40\u0a02, \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a2a\u0a24\u0a3e \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964 \u0a28\u0a3e\u0a2e, \u0a32\u0a3f\u0a70\u0a17, DOB, \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30, \u0a08\u0a2e\u0a47\u0a32 \u0a05\u0a24\u0a47 \u0a2c\u0a3e\u0a07\u0a13\u0a2e\u0a48\u0a1f\u0a4d\u0a30\u0a3f\u0a15\u0a38 \u0a21\u0a47\u0a1f\u0a3e \u0a32\u0a08, \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a28\u0a1c\u0a3c\u0a26\u0a40\u0a15\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a38\u0a47\u0a35\u0a3e \u0a15\u0a47\u0a02\u0a26\u0a30 '\u0a24\u0a47 \u0a1c\u0a3e\u0a13\u0964",two:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a32\u0a4b\u0a5c\u0a40\u0a02\u0a26\u0a47 \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a2b\u0a3f\u0a15 \u0a21\u0a3e\u0a1f\u0a3e \u0a26\u0a3e\u0a16\u0a32 \u0a15\u0a30\u0a4b\u0964 \u0a15\u0a41\u0a1d \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a2b\u0a3f\u0a15 \u0a38\u0a70\u0a2c\u0a70\u0a27\u0a40 \u0a21\u0a3e\u0a1f\u0a3e \u0a28\u0a42\u0a70 \u0a21\u0a4d\u0a30\u0a4c\u0a2a\u0a21\u0a3e\u0a09\u0a28 \u0a38\u0a42\u0a1a\u0a40 \u0a35\u0a3f\u0a71\u0a1a\u0a4b\u0a02 \u0a1a\u0a4b\u0a23 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a41\u0a70\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a21\u0a48\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a2b\u0a3f\u0a15\u0a38 \u0a21\u0a3e\u0a1f\u0a3e \u0a28\u0a42\u0a70 \u0a26\u0a3e\u0a16\u0a32 \u0a15\u0a30\u0a26\u0a47 \u0a38\u0a2e\u0a47\u0a02 \u0a1c\u0a3e\u0a02 \u0a21\u0a4d\u0a30\u0a4c\u0a2a\u0a21\u0a3e\u0a09\u0a28 \u0a35\u0a3f\u0a15\u0a32\u0a2a\u0a3e\u0a02 \u0a35\u0a3f\u0a71\u0a1a\u0a4b\u0a02 \u0a1a\u0a4b\u0a23 \u0a15\u0a30\u0a26\u0a47 \u0a38\u0a2e\u0a47\u0a02 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a27\u0a3f\u0a06\u0a28 \u0a30\u0a71\u0a16\u0a4b\u0964",three:"\u0a2a\u0a24\u0a3e \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08 \u0a05\u0a38\u0a32 \u0a38\u0a39\u0a3e\u0a07\u0a15 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a26\u0a40 \u0a38\u0a15\u0a48\u0a28 \u0a15\u0a40\u0a24\u0a40 \u0a15\u0a3e\u0a2a\u0a40 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a41\u0a70\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a2f\u0a15\u0a40\u0a28\u0a40 \u0a2c\u0a23\u0a3e\u0a13 \u0a15\u0a3f \u0a38\u0a39\u0a3e\u0a07\u0a15 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a28\u0a3e\u0a2e \u0a35\u0a3f\u0a71\u0a1a \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a35\u0a48\u0a27 \u0a39\u0a48\u0964 \u0a1c\u0a47\u0a15\u0a30 \u0a24\u0a41\u0a38\u0a40\u0a02 UIDAI \u0a38\u0a1f\u0a48\u0a02\u0a21\u0a30\u0a21 \u0a2b\u0a3e\u0a30\u0a2e\u0a48\u0a1f \u0a35\u0a3f\u0a71\u0a1a \u0a07\u0a71\u0a15 \u0a38\u0a30\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a1f \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a30 \u0a30\u0a39\u0a47 \u0a39\u0a4b, \u0a24\u0a3e\u0a02 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a05\u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30 \u0a15\u0a30\u0a28 \u0a24\u0a4b\u0a02 \u0a2c\u0a1a\u0a23 \u0a32\u0a08 \u0a06\u0a2e \u0a17\u0a32\u0a24\u0a40\u0a06\u0a02 \u0a1c\u0a3f\u0a35\u0a47\u0a02 \u0a15\u0a3f \u0a07\u0a38\u0a3c\u0a42 \u0a26\u0a40 \u0a2e\u0a3f\u0a24\u0a40, \u0a15\u0a4d\u0a30\u0a3e\u0a38\u0a21 \u0a38\u0a3e\u0a08\u0a28, \u0a2b\u0a4b\u0a1f\u0a4b \u0a09\u0a71\u0a24\u0a47 \u0a2e\u0a4b\u0a39\u0a30 \u0a05\u0a24\u0a47 \u0a15\u0a4b\u0a08 \u0a13\u0a35\u0a30\u0a30\u0a3e\u0a08\u0a1f\u0a3f\u0a70\u0a17 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30\u0a4b\u0964",four:"\u0a24\u0a41\u0a39\u0a3e\u0a28\u0a42\u0a70 \u0a06\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a2b\u0a40\u0a38 \u0a32\u0a08 \u20b9 50 (\u0a38\u0a3f\u0a30\u0a2b \u0a2a\u0a70\u0a1c\u0a3e\u0a39 \u0a30\u0a41\u0a2a\u0a0f) \u0a05\u0a26\u0a3e \u0a15\u0a30\u0a28\u0a47 \u0a2a\u0a48\u0a23\u0a17\u0a47\u0964 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a15\u0a30\u0a48\u0a21\u0a3f\u0a1f / \u0a21\u0a48\u0a2c\u0a3f\u0a1f \u0a15\u0a3e\u0a30\u0a21 \u0a1c\u0a3e\u0a02 \u0a28\u0a48\u0a1f \u0a2c\u0a48\u0a02\u0a15\u0a3f\u0a70\u0a17 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964 \u0a07\u0a39 \u0a30\u0a15\u0a2e \u0a35\u0a3e\u0a2a\u0a38 \u0a28\u0a39\u0a40\u0a02 \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40\u0964 \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a26\u0a47 \u0a2e\u0a3e\u0a2e\u0a32\u0a47 \u0a35\u0a3f\u0a71\u0a1a, \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a32\u0a08 \u0a26\u0a41\u0a2c\u0a3e\u0a30\u0a3e \u0a15\u0a4b\u0a38\u0a3c\u0a3f\u0a38\u0a3c \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964",five:"\u0a24\u0a41\u0a38\u0a40\u0a02 \u0a07\u0a71\u0a15 \u0a38\u0a47\u0a35\u0a3e \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a28\u0a70\u0a2c\u0a30 (SRN) \u0a07\u0a71\u0a15 \u0a39\u0a35\u0a3e\u0a32\u0a47 \u0a26\u0a47 \u0a30\u0a42\u0a2a \u0a35\u0a3f\u0a71\u0a1a \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30\u0a4b\u0a17\u0a47\u0964 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a26\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a1f\u0a30\u0a48\u0a15 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a1c\u0a3e\u0a02 \u0a2f\u0a42\u0a06\u0a08\u0a21\u0a40\u0a0f\u0a06\u0a08 \u0a39\u0a48\u0a32\u0a2a\u0a21\u0a48\u0a38\u0a15 \u0a28\u0a3e\u0a32 \u0a15\u0a3f\u0a38\u0a47 \u0a2d\u0a35\u0a3f\u0a71\u0a16 \u0a26\u0a47 \u0a38\u0a70\u0a1a\u0a3e\u0a30 \u0a32\u0a08 \u0a07\u0a38 \u0a28\u0a70\u0a2c\u0a30 \u0a28\u0a42\u0a70 \u0a38\u0a41\u0a30\u0a71\u0a16\u0a3f\u0a05\u0a24 \u0a15\u0a30\u0a4b\u0964",six:"\u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a38\u0a3e\u0a21\u0a47 \u0a05\u0a70\u0a26\u0a30\u0a42\u0a28\u0a40 \u0a15\u0a41\u0a06\u0a32\u0a1f\u0a40 \u0a1a\u0a48\u0a15 \u0a06\u0a2a\u0a30\u0a47\u0a1f\u0a30\u0a3e\u0a02 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a15\u0a40\u0a24\u0a40 \u0a1c\u0a3e\u0a0f\u0a17\u0a40\u0964 \u0a07\u0a38 \u0a2a\u0a5c\u0a3e\u0a05 '\u0a24\u0a47 \u0a2a\u0a4d\u0a30\u0a26\u0a3e\u0a28 \u0a15\u0a40\u0a24\u0a47 \u0a17\u0a0f \u0a21\u0a4c\u0a2e\u0a4b\u0a17\u0a4d\u0a30\u0a3e\u0a2b\u0a3f\u0a15\u0a38 \u0a21\u0a3e\u0a1f\u0a3e \u0a28\u0a42\u0a70 \u0a38\u0a39\u0a3f\u0a2f\u0a4b\u0a17\u0a40 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a26\u0a47 \u0a35\u0a3f\u0a30\u0a41\u0a71\u0a27 \u0a1c\u0a3e\u0a02\u0a1a\u0a3f\u0a06 \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a3e\u0964 \u0a1c\u0a47 \u0a15\u0a4b\u0a08 \u0a2e\u0a47\u0a32 \u0a28\u0a39\u0a40\u0a02 \u0a16\u0a3e\u0a02\u0a26\u0a3e, \u0a24\u0a3e\u0a02 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a05\u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30 \u0a15\u0a30 \u0a26\u0a3f\u0a71\u0a24\u0a3e \u0a1c\u0a3e\u0a0f\u0a17\u0a3e\u0964",seven:"\u0a15\u0a41\u0a06\u0a32\u0a1f\u0a40 \u0a1a\u0a48\u0a71\u0a15 \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a2a\u0a42\u0a30\u0a40 \u0a39\u0a4b\u0a23 '\u0a24\u0a47, \u0a24\u0a41\u0a39\u0a3e\u0a28\u0a42\u0a70 \u0a07\u0a15 \u0a10\u0a38\u0a10\u0a2e\u0a10\u0a38 \u0a28\u0a4b\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a38\u0a3c\u0a28 \u0a2e\u0a3f\u0a32\u0a47\u0a17\u0a3e \u0a1c\u0a3f\u0a38 \u0a35\u0a3f\u0a1a \u0a10\u0a28\u0a30\u0a4b\u0a32\u0a2e\u0a48\u0a02\u0a1f \u0a06\u0a08\u0a21\u0a40 \u0a26\u0a3e \u0a28\u0a24\u0a40\u0a1c\u0a3e \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e\u0964",eight:"\u0a38\u0a3e\u0a21\u0a47 \u0a2c\u0a48\u0a15\u0a10\u0a02\u0a21 \u0a38\u0a4c\u0a2b\u0a1f\u0a35\u0a47\u0a05\u0a30 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a15\u0a41\u0a1d \u0a39\u0a4b\u0a30 \u0a2a\u0a4d\u0a30\u0a2e\u0a3e\u0a23\u0a3f\u0a15\u0a24\u0a3e\u0a35\u0a3e\u0a02 \u0a26\u0a47 \u0a2c\u0a3e\u0a05\u0a26, \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a26\u0a40 \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a2a\u0a42\u0a30\u0a40 \u0a39\u0a4b \u0a1c\u0a3e\u0a35\u0a47\u0a17\u0a40\u0964 \u0a28\u0a24\u0a40\u0a1c\u0a47 '\u0a24\u0a47 \u0a24\u0a41\u0a39\u0a3e\u0a28\u0a42\u0a70 \u0a07\u0a71\u0a15 \u0a10\u0a38\u0a10\u0a2e\u0a10\u0a38 \u0a28\u0a4b\u0a1f\u0a40\u0a2b\u0a3f\u0a15\u0a47\u0a38\u0a3c\u0a28 \u0a2e\u0a3f\u0a32\u0a47\u0a17\u0a3e\u0964",nine:"\u0a06\u0a2e \u0a24\u0a4c\u0a30 '\u0a24\u0a47 90% \u0a38\u0a47\u0a35\u0a3e \u0a2e\u0a3f\u0a06\u0a30\u0a3e\u0a02 \u0a26\u0a47 \u0a28\u0a3e\u0a32 30 \u0a26\u0a3f\u0a28\u0a3e\u0a02 \u0a26\u0a47 \u0a05\u0a70\u0a26\u0a30 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a2a\u0a42\u0a30\u0a40 \u0a39\u0a4b \u0a1c\u0a3e\u0a02\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a39\u0a3e\u0a32\u0a3e\u0a02\u0a15\u0a3f, \u0a05\u0a38\u0a40\u0a02 \u0a06\u0a2a\u0a23\u0a47 \u0a2a\u0a4d\u0a30\u0a23\u0a3e\u0a32\u0a40\u0a06\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a38\u0a41\u0a27\u0a3e\u0a30 \u0a15\u0a30 \u0a30\u0a39\u0a47 \u0a39\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a2c\u0a39\u0a41\u0a24 \u0a38\u0a70\u0a2d\u0a3e\u0a35\u0a28\u0a3e \u0a35\u0a3f\u0a71\u0a1a, \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a26\u0a3e \u0a1c\u0a3c\u0a3f\u0a15\u0a30 \u0a15\u0a40\u0a24\u0a47 \u0a38\u0a2e\u0a47\u0a02 \u0a24\u0a4b\u0a02 \u0a2a\u0a39\u0a3f\u0a32\u0a3e\u0a02 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a40\u0a24\u0a3e \u0a1c\u0a3e\u0a0f\u0a17\u0a3e | \u0a24\u0a41\u0a38\u0a40\u0a02 myaadhaar.uidai.gov.in '\u0a24\u0a47 \u0a1c\u0a3e \u0a15\u0a47 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a2a\u0a4d\u0a30\u0a15\u0a3f\u0a30\u0a3f\u0a06 \u0a26\u0a40 \u0a38\u0a25\u0a3f\u0a24\u0a40 \u0a26\u0a40 \u0a1c\u0a3e\u0a02\u0a1a \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b |"}},updateSelectPage:{title:"\u0a06\u0a27\u0a3e\u0a30 \u0a06\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a4b",selectFields:{smallDescription:"\u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a47\u0a1f\u0a3e \u0a16\u0a47\u0a24\u0a30 \u0a26\u0a40 \u0a1a\u0a4b\u0a23 \u0a15\u0a30\u0a4b",longDescription:"\u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a39\u0a47\u0a20\u0a3e\u0a02 \u0a26\u0a3f\u0a71\u0a24\u0a47 \u0a15\u0a3f\u0a38\u0a47 \u0a35\u0a40 \u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a47\u0a1f\u0a3e \u0a16\u0a47\u0a24\u0a30 \u0a26\u0a40 \u0a1a\u0a4b\u0a23 \u0a15\u0a30\u0a4b",updatesLeft:" \u0a2c\u0a15\u0a3e\u0a07\u0a06 \u0a05\u0a2a\u0a21\u0a47\u0a1f\u0a38",noLimit:"\u0a15\u0a4b\u0a08 \u0a38\u0a40\u0a2e\u0a3e \u0a28\u0a39\u0a40\u0a02",demoGraphics:{language:"\u0a2d\u0a3e\u0a38\u0a3c\u0a3e",name:"\u0a28\u0a3e\u0a2e",dob:"\u0a1c\u0a28\u0a2e \u0a2e\u0a3f\u0a24\u0a40",gender:"\u0a32\u0a3f\u0a70\u0a17",hof:"\u0a2a\u0a30\u0a3f\u0a35\u0a3e\u0a30 \u0a26\u0a47 \u0a2e\u0a41\u0a16\u0a40 (HOF) \u0a05\u0a27\u0a3e\u0a30\u0a3f\u0a24 \u0a2a\u0a24\u0a3e \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f",address:"\u0a2a\u0a24\u0a3e"}},documentDescriptionLinkText:"\u0a05\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a2a\u0a40\u0a13\u0a06\u0a08 / \u0a2a\u0a40\u0a13\u0a0f / \u0a2a\u0a40\u0a13\u0a2c\u0a40 \u0a28\u0a3e\u0a32 \u0a38\u0a70\u0a2c\u0a70\u0a27\u0a24 \u0a32\u0a4b\u0a5c\u0a40\u0a02\u0a26\u0a47 \u0a35\u0a48\u0a27 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a35\u0a47\u0a16\u0a4b",proceedToUpdateAadhaar:"\u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a05\u0a2a\u0a21\u0a47\u0a1f \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a05\u0a71\u0a17\u0a47 \u0a35\u0a71\u0a27\u0a4b",faq:"\u0a05\u0a15\u0a38\u0a30 \u0a2a\u0a41\u0a71\u0a1b\u0a47 \u0a1c\u0a3e\u0a23 \u0a35\u0a3e\u0a32\u0a47 \u0a38\u0a35\u0a3e\u0a32"},dashboard:"\u0a21\u0a48\u0a38\u0a3c\u0a2c\u0a4b\u0a30\u0a21",hof:{title:"\u0a2a\u0a30\u0a3f\u0a35\u0a3e\u0a30 \u0a26\u0a47 \u0a2e\u0a41\u0a16\u0a40 (HOF) \u0a05\u0a27\u0a3e\u0a30\u0a3f\u0a24 \u0a2a\u0a24\u0a3e \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f",description:"\u0a2a\u0a30\u0a3f\u0a35\u0a3e\u0a30 \u0a26\u0a47 \u0a2e\u0a41\u0a16\u0a40 \u0a05\u0a27\u0a3e\u0a30\u0a3f\u0a24 \u0a2a\u0a24\u0a3e \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a28\u0a3e\u0a32 \u0a05\u0a71\u0a17\u0a47 \u0a35\u0a27\u0a23 \u0a32\u0a08 \u0a07\u0a71\u0a25\u0a47 \u0a15\u0a32\u0a3f\u0a71\u0a15 \u0a15\u0a30\u0a4b\u0964",howItWorks:{step1:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a06\u0a27\u0a3e\u0a30 \u0a21\u0a47\u0a1f\u0a3e\u0a2c\u0a47\u0a38 \u0a24\u0a4b\u0a02 \u0a2a\u0a24\u0a3e \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a06\u0a2a\u0a23\u0a47 \u0a2a\u0a30\u0a3f\u0a35\u0a3e\u0a30 \u0a26\u0a47 \u0a2e\u0a41\u0a16\u0a40 \u0a26\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b\u0964 \u0a38\u0a3f\u0a30\u0a2b\u0a3c 18 \u0a38\u0a3e\u0a32 \u0a1c\u0a3e\u0a02 \u0a07\u0a38 \u0a24\u0a4b\u0a02 \u0a35\u0a71\u0a27 \u0a09\u0a2e\u0a30 \u0a26\u0a47 \u0a35\u0a38\u0a28\u0a40\u0a15\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a39\u0a40 HoF \u0a2e\u0a70\u0a28\u0a3f\u0a06 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a3e \u0a39\u0a48\u0964",step2:'\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a30\u0a3f\u0a38\u0a3c\u0a24\u0a47 \u0a26\u0a3e \u0a38\u0a2c\u0a42\u0a24 (PoR) \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a05\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a4b \u0a1c\u0a3f\u0a38 \u0a35\u0a3f\u0a71\u0a1a \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a3e \u0a28\u0a3e\u0a2e \u0a05\u0a24\u0a47 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a2a\u0a30\u0a3f\u0a35\u0a3e\u0a30 \u0a26\u0a47 \u0a2e\u0a41\u0a16\u0a40 \u0a26\u0a3e \u0a28\u0a3e\u0a2e \u0a38\u0a2a\u0a38\u0a3c\u0a1f \u0a24\u0a4c\u0a30 \'\u0a24\u0a47 \u0a1c\u0a3c\u0a3f\u0a15\u0a30 \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a39\u0a4b\u0a35\u0a47 \u0964 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a28\u0a3e\u0a32 HoF \u0a26\u0a3e \u0a30\u0a3f\u0a38\u0a3c\u0a24\u0a3e \u0a1a\u0a41\u0a23\u0a4b, \u0a09\u0a26\u0a3e\u0a39\u0a30\u0a28 \u0a32\u0a08 \u0a1c\u0a47\u0a15\u0a30 HoF \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a3e \u0a2a\u0a24\u0a40 \u0a39\u0a48, \u0a24\u0a3e\u0a02 "\u0a2a\u0a24\u0a40" \u0a28\u0a42\u0a70 \u0a1a\u0a41\u0a23\u0a4b\u0964',step3:"\u0a24\u0a41\u0a39\u0a3e\u0a28\u0a42\u0a70 \u0a14\u0a28\u0a32\u0a3e\u0a08\u0a28 \u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08 \u20b9 50 (\u0a38\u0a3f\u0a30\u0a2b\u0a3c \u0a2a\u0a70\u0a1c\u0a3e\u0a39 \u0a30\u0a41\u0a2a\u0a0f) \u0a26\u0a40 \u0a2b\u0a40\u0a38  \u0a26\u0a3e \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a30\u0a28\u0a3e \u0a2a\u0a35\u0a47\u0a17\u0a3e\u0964 \u0a24\u0a41\u0a38\u0a40\u0a02 \u0a15\u0a4d\u0a30\u0a48\u0a21\u0a3f\u0a1f/\u0a21\u0a48\u0a2c\u0a3f\u0a1f \u0a15\u0a3e\u0a30\u0a21 \u0a1c\u0a3e\u0a02 \u0a28\u0a48\u0a71\u0a1f \u0a2c\u0a48\u0a02\u0a15\u0a3f\u0a70\u0a17 \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964 \u0a07\u0a39 \u0a30\u0a15\u0a2e \u0a28\u0a3e-\u0a35\u0a3e\u0a2a\u0a38\u0a40\u0a2f\u0a4b\u0a17 \u0a39\u0a48\u0964",step4:"\u0a1c\u0a26\u0a4b\u0a02 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a2a\u0a30\u0a3f\u0a35\u0a3e\u0a30 \u0a26\u0a3e \u0a2e\u0a41\u0a16\u0a40 \u0a06\u0a2a\u0a23\u0a47 myAadhaar \u0a2a\u0a4b\u0a30\u0a1f\u0a32 '\u0a24\u0a47 \u0a32\u0a3e\u0a17\u0a07\u0a28 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a09\u0a28\u0a4d\u0a39\u0a3e\u0a02 \u0a28\u0a42\u0a70 \u0a2a\u0a24\u0a3e \u0a38\u0a3e\u0a02\u0a1d\u0a3e \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a40, \u0a1c\u0a3f\u0a38 \u0a28\u0a42\u0a70 \u0a09\u0a39 \u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30 \u0a1c\u0a3e\u0a02 \u0a07\u0a28\u0a15\u0a3e\u0a30 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a28\u0964 HoF \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a28\u0a42\u0a70 \u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30 / \u0a05\u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30 \u0a15\u0a30\u0a28 \u0a26\u0a3e \u0a07\u0a39 \u0a35\u0a3f\u0a15\u0a32\u0a2a \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a2e\u0a3f\u0a24\u0a40 \u0a24\u0a4b\u0a02 30 \u0a26\u0a3f\u0a28\u0a3e\u0a02 \u0a32\u0a08 \u0a35\u0a48\u0a27 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e\u0964"},currentSection:{title:"\u0a05\u0a71\u0a2a\u0a21\u0a47\u0a1f \u0a32\u0a08 HoF \u0a26\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a48"},updateSection:{forms:{hofUid:{label:"HoF \u0a26\u0a3e \u0a06\u0a27\u0a3e\u0a30 \u0a28\u0a70\u0a2c\u0a30 \u0a26\u0a30\u0a1c \u0a15\u0a30\u0a4b"},mobileField:{label:"HoF \u0a26\u0a3e \u0a2e\u0a4b\u0a2c\u0a3e\u0a08\u0a32 \u0a28\u0a70\u0a2c\u0a30"},documentUpload:{label:"\u0a35\u0a48\u0a27 \u0a38\u0a39\u0a3e\u0a07\u0a15 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a26\u0a40 \u0a15\u0a3f\u0a38\u0a2e \u0a1a\u0a41\u0a23\u0a4b"},relationshipDropdown:{label:"\u0a2c\u0a3f\u0a28\u0a48\u0a15\u0a3e\u0a30 \u0a28\u0a3e\u0a32 HoF \u0a26\u0a3e \u0a38\u0a2c\u0a70\u0a27 \u0a1a\u0a41\u0a23\u0a4bt",values:{father:"\u0a2a\u0a3f\u0a24\u0a3e",mother:"\u0a2e\u0a3e\u0a24\u0a3e",husband:"\u0a2a\u0a24\u0a40",wife:"\u0a2a\u0a24\u0a28\u0a40",guardian:"\u0a38\u0a30\u0a2a\u0a4d\u0a30\u0a38\u0a24",Others:"\u0a39\u0a4b\u0a30"}}}}},documentInfoPopup:{title:"\u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a06\u0a2a\u0a23\u0a40 \u0a2c\u0a47\u0a28\u0a24\u0a40 \u0a24\u0a47 \u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a07\u0a71\u0a15 \u0a35\u0a48\u0a27 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a05\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a4b",identityDocumentInfo:"\u0a1c\u0a47\u0a15\u0a30 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a2a\u0a1b\u0a3e\u0a23 \u0a26\u0a47 \u0a38\u0a2c\u0a42\u0a24 \u0a32\u0a08 \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a07\u0a39 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a28\u0a3e\u0a2e '\u0a24\u0a47 \u0a39\u0a4b\u0a23\u0a3e \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a3e \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a07\u0a71\u0a15 \u0a2b\u0a4b\u0a1f\u0a4b \u0a39\u0a4b\u0a23\u0a40 \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a24\u0a38\u0a26\u0a40\u0a15 \u0a15\u0a30\u0a4b \u0a15\u0a3f \u0a2b\u0a3e\u0a30\u0a2e \u0a35\u0a3f\u0a71\u0a1a \u0a09\u0a71\u0a2a\u0a30 \u0a1c\u0a3c\u0a3f\u0a15\u0a30 \u0a15\u0a40\u0a24\u0a3e '\u0a28\u0a3e\u0a2e' \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a05\u0a71\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a40\u0a24\u0a47 \u0a1c\u0a3e \u0a30\u0a39\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a35\u0a3f\u0a71\u0a1a '\u0a28\u0a3e\u0a2e' \u0a28\u0a3e\u0a32 \u0a2e\u0a47\u0a32 \u0a16\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48\u0964",addressDocumentInfo:"\u0a1c\u0a47\u0a15\u0a30 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a2a\u0a24\u0a47 \u0a26\u0a47 \u0a38\u0a2c\u0a42\u0a24 \u0a32\u0a08 \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a07\u0a39 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a28\u0a3e\u0a2e '\u0a24\u0a47 \u0a39\u0a4b\u0a23\u0a3e \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a1c\u0a40\u0a35\u0a28 \u0a38\u0a3e\u0a25\u0a40, \u0a38\u0a30\u0a2a\u0a4d\u0a30\u0a38\u0a24, \u0a1c\u0a3e\u0a02 \u0a2e\u0a3e\u0a24\u0a3e-\u0a2a\u0a3f\u0a24\u0a3e \u0a26\u0a47 \u0a28\u0a3e\u0a2e \u0a26\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a38\u0a35\u0a40\u0a15\u0a3e\u0a30 \u0a28\u0a39\u0a40\u0a02 \u0a15\u0a40\u0a24\u0a47 \u0a1c\u0a3e\u0a23\u0a17\u0a47\u0964 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a15\u0a30\u0a15\u0a47 \u0a24\u0a38\u0a26\u0a40\u0a15 \u0a15\u0a30\u0a4b \u0a15\u0a3f \u0a2b\u0a3e\u0a30\u0a2e \u0a35\u0a3f\u0a71\u0a1a \u0a09\u0a2a\u0a30\u0a4b\u0a15\u0a24 \u0a1c\u0a3c\u0a3f\u0a15\u0a30 \u0a15\u0a40\u0a24\u0a3e '\u0a2a\u0a24\u0a3e' \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a05\u0a71\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a40\u0a24\u0a47 \u0a1c\u0a3e \u0a30\u0a39\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c \u0a35\u0a3f\u0a71\u0a1a '\u0a2a\u0a24\u0a47' \u0a28\u0a3e\u0a32 \u0a2e\u0a47\u0a32 \u0a16\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48\u0964",close:"\u0a2c\u0a70\u0a26 \u0a15\u0a30\u0a4b",continueToUpload:"\u0a05\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a30\u0a28\u0a3e \u0a1c\u0a3e\u0a30\u0a40 \u0a30\u0a71\u0a16\u0a4b"},forms:{reUseDocText:"\u0a24\u0a41\u0a38\u0a40\u0a02 \u0a39\u0a47\u0a20\u0a3e\u0a02 \u0a26\u0a3f\u0a71\u0a24\u0a47 \u0a05\u0a2a\u0a32\u0a4b\u0a21 \u0a15\u0a40\u0a24\u0a47 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a1c\u0a3c\u0a3e\u0a02 \u0a26\u0a40 \u0a2e\u0a41\u0a5c \u0a35\u0a30\u0a24\u0a4b\u0a02 \u0a15\u0a30 \u0a38\u0a15\u0a26\u0a47 \u0a39\u0a4b\u0964",stepper:{language:"\u0a2d\u0a3e\u0a38\u0a3c\u0a3e",Name:"\u0a28\u0a3e\u0a2e",dob:"\u0a1c\u0a28\u0a2e \u0a2e\u0a3f\u0a24\u0a40",gender:"\u0a32\u0a3f\u0a70\u0a17",address:"\u0a2a\u0a24\u0a3e",preview:"\u0a1d\u0a32\u0a15",payment:"\u0a2d\u0a41\u0a17\u0a24\u0a3e\u0a28"},formButtons:{back:"\u0a35\u0a3e\u0a2a\u0a38",next:"\u0a05\u0a17\