\u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3f\u0c32\u0c4d\u0c35 \u0c1a\u0c47\u0c2f\u0c26\u0c41.",noRecordsAvailable:"\u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32\u0c41 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c32\u0c47\u0c35\u0c41",checkWithBank:"\u0c2e\u0c40 \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c16\u0c3e\u0c24\u0c3e\u0c15\u0c41 \u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d\u200c\u0c28\u0c3f \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f "},bankSeedingStatus:{AadhaarNumber:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c02\u0c16\u0c4d\u0c2f",BankName:"\u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c2a\u0c47\u0c30\u0c41",BankSeedingStatus:"\u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c38\u0c40\u0c21\u0c3f\u0c02\u0c17\u0c4d \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f",LastUpdatedDate:"\u0c1a\u0c3f\u0c35\u0c30\u0c3f\u0c17\u0c3e \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c40",noRecordAlert:"\u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c2e\u0c40 \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c16\u0c3e\u0c24\u0c3e\u0c15\u0c41 \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d\u200c\u0c28\u0c3f \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",note:"\u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c28\u0c47\u0c37\u0c28\u0c32\u0c4d \u0c2a\u0c47\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c2a\u0c4a\u0c30\u0c47\u0c37\u0c28\u0c4d \u0c06\u0c2b\u0c4d \u0c07\u0c02\u0c21\u0c3f\u0c2f\u0c3e (NPCI) \u0c38\u0c30\u0c4d\u0c35\u0c30\u0c4d \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \u0c26\u0c3e\u0c28\u0c3f \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c24\u0c4d\u0c35\u0c3e\u0c28\u0c3f\u0c15\u0c3f UIDAI \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24 \u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c26\u0c41. \u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c28 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c28\u0c3f UIDAI  \u0c38\u0c4d\u0c1f\u0c4b\u0c30\u0c4d \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c26\u0c41.",ActiveText:"\u0c1a\u0c41\u0c30\u0c41\u0c15\u0c41\u0c17\u0c3e",InactiveText:"\u0c28\u0c3f\u0c37\u0c4d\u0c15\u0c4d\u0c30\u0c3f\u0c2f"},FAQ:{checkAadhaarPvcCardOrderStatus:[{question:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c35\u0c3f\u0c35\u0c3f\u0c27 \u0c30\u0c42\u0c2a\u0c3e\u0c32\u0c41 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3e\u0c1f\u0c3f \u0c32\u0c15\u0c4d\u0c37\u0c23\u0c3e\u0c32\u0c41 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c35\u0c3f\u0c35\u0c3f\u0c27 \u0c30\u0c42\u0c2a\u0c3e\u0c32\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c32\u0c47\u0c16, \u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d, eAadhaar \u0c2e\u0c30\u0c3f\u0c2f\u0c41 mAadhaar. \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c30\u0c15\u0c3e\u0c32 \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c32\u0c41 \u0c38\u0c2e\u0c3e\u0c28\u0c02\u0c17\u0c3e \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c35\u0c41\u0c24\u0c3e\u0c2f\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c06\u0c2e\u0c4b\u0c26\u0c2f\u0c4b\u0c17\u0c4d\u0c2f\u0c2e\u0c48\u0c28\u0c35\u0c3f."},{question:"\u0c28\u0c47\u0c28\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c30\u0c42\u0c2a\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c02\u0c21\u0c21\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c3e?",answer:"\u0c05\u0c35\u0c41\u0c28\u0c41"},{question:"\u201c\u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d\u201d \u0c38\u0c47\u0c35 \u0c05\u0c02\u0c1f\u0c47 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"\u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d' \u0c05\u0c28\u0c47\u0c26\u0c3f UIDAI \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c38\u0c47\u0c35, \u0c07\u0c26\u0c3f \u0c28\u0c3e\u0c2e\u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2a\u0c41 \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32\u0c41 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c2a\u0c48  \u0c35\u0c3e\u0c30\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c3f\u0c02\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c40\u0c32\u0c41 \u0c15\u0c32\u0c4d\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f."},{question:"\u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d\u201d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2d\u0c26\u0c4d\u0c30\u0c24\u0c3e \u0c32\u0c15\u0c4d\u0c37\u0c23\u0c3e\u0c32\u0c41 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"\u0c08 \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2d\u0c26\u0c4d\u0c30\u0c24\u0c3e \u0c32\u0c15\u0c4d\u0c37\u0c23\u0c3e\u0c32\u0c41 \u0c07\u0c32\u0c3e \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f:\r\n1. \u0c1f\u0c4d\u0c2f\u0c3e\u0c02\u0c2a\u0c30\u0c4d \u0c2a\u0c4d\u0c30\u0c42\u0c2b\u0c4d QR \u0c15\u0c4b\u0c21\u0c4d\r\n2. \u0c39\u0c4b\u0c32\u0c4b\u0c17\u0c4d\u0c30\u0c3e\u0c2e\u0c4d\r\n3. \u0c2e\u0c48\u0c15\u0c4d\u0c30\u0c4b \u0c1f\u0c46\u0c15\u0c4d\u0c38\u0c4d\u0c1f\u0c4d\r\n4. \u0c18\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c07\u0c2e\u0c47\u0c1c\u0c4d \r\n5. \u0c07\u0c37\u0c4d\u0c2f\u0c42 \u0c24\u0c47\u0c26\u0c40 & \u0c2a\u0c4d\u0c30\u0c3f\u0c02\u0c1f\u0c4d \u0c24\u0c47\u0c26\u0c40\r\n6. \u0c17\u0c3f\u0c32\u0c4d\u0c32\u0c4b\u0c1a\u0c47 \u0c28\u0c2e\u0c42\u0c28\u0c3e\r\n7. \u0c0e\u0c02\u0c2c\u0c4b\u0c38\u0c4d\u0c21\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c32\u0c4b\u0c17\u0c4b"},{question:"\u201c\u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d\u201d \u0c15\u0c4b\u0c38\u0c02 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c4d\u0c38\u0c3f\u0c28 \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32\u0c41 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c4d\u0c38\u0c3f\u0c28 \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32\u0c41 \u0c30\u0c42.50/- (GST & \u0c38\u0c4d\u0c2a\u0c40\u0c21\u0c4d \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32\u0c24\u0c4b \u0c15\u0c32\u0c3f\u0c2a\u0c3f)."},{question:"\u201c\u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d\u201d \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c0e\u0c32\u0c3e \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41?",answer:"UIDAI \u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c3f\u0c15 \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d (https://www.uidai.gov.in \u0c32\u0c47\u0c26\u0c3e https://myaadhaar.uidai.gov.in) \u0c32\u0c47\u0c26\u0c3e mAadhaar \u0c05\u0c2a\u0c4d\u0c32\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d\u200c\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e ''\u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d' \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41."},{question:"\u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c0e\u0c32\u0c3e \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41?",answer:"1. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f https://uidai.gov.in \u0c32\u0c47\u0c26\u0c3e https://myaadhaar.uidai.gov.in/genricPVC\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f. 2. \u0c2e\u0c40 12 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d (UID) \u0c32\u0c47\u0c26\u0c3e 28 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c0e\u0c28\u0c4d\u200c\u0c30\u0c4b\u0c32\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d ID\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.  3. \u0c2d\u0c26\u0c4d\u0c30\u0c24\u0c3e \u0c15\u0c4b\u0c21\u0c4d\u200c\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.   4. \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c35\u0c1a\u0c4d\u0c1a\u0c3f\u0c28 OTP\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.    5. '\u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c37\u0c30\u0c24\u0c41\u0c32\u0c15\u0c41'  \u0c1a\u0c46\u0c15\u0c4d \u0c2c\u0c3e\u0c15\u0c4d\u0c38\u0c4d\u200c\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. (\u0c17\u0c2e\u0c28\u0c3f\u0c15: \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c1a\u0c42\u0c21\u0c1f\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c39\u0c48\u0c2a\u0c30\u0c4d \u0c32\u0c3f\u0c02\u0c15\u0c4d\u200c\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f).  6. OTP \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23\u0c28\u0c41 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u201c\u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c41\u201d \u0c2c\u0c1f\u0c28\u0c4d\u200c\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.  7. \u0c24\u0c26\u0c41\u0c2a\u0c30\u0c3f \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c40\u0c28\u0c4d\u200c\u0c32\u0c4b, \u0c30\u0c40\u0c2a\u0c4d\u0c30\u0c3f\u0c02\u0c1f\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c1a\u0c47\u0c38\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c15\u0c4b\u0c38\u0c02 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32 \u0c2a\u0c4d\u0c30\u0c3f\u0c35\u0c4d\u0c2f\u0c42 \u0c15\u0c28\u0c3f\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.  8. '\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c41' \u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c15\u0c4d\u0c30\u0c46\u0c21\u0c3f\u0c1f\u0c4d/\u0c21\u0c46\u0c2c\u0c3f\u0c1f\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d, \u0c28\u0c46\u0c1f\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 UPI \u0c35\u0c02\u0c1f\u0c3f \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c0e\u0c02\u0c2a\u0c3f\u0c15\u0c32\u0c24\u0c4b \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c17\u0c47\u0c1f\u0c4d\u200c\u0c35\u0c47 \u0c2a\u0c47\u0c1c\u0c40\u0c15\u0c3f \u0c2e\u0c33\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c30\u0c41.   9. \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c2e\u0c48\u0c28 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, \u0c30\u0c38\u0c40\u0c26\u0c41 \u0c21\u0c3f\u0c1c\u0c3f\u0c1f\u0c32\u0c4d \u0c38\u0c02\u0c24\u0c15\u0c02\u0c24\u0c4b \u0c30\u0c42\u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f, \u0c26\u0c40\u0c28\u0c3f\u0c28\u0c3f \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f PDF \u0c06\u0c15\u0c43\u0c24\u0c3f\u0c32\u0c4b \u0c21\u0c4c\u0c28\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f SMS \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c38\u0c47\u0c35\u0c3e \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c15\u0c42\u0c21\u0c3e \u0c2a\u0c4a\u0c02\u0c26\u0c41\u0c24\u0c3e\u0c30\u0c41.  10. \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c4d\u0c1f\u0c47\u0c1f\u0c38\u0c4d\u200c\u0c28\u0c3f \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c21\u0c02\u0c32\u0c4b \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c2a\u0c02\u0c2a\u0c47 \u0c35\u0c30\u0c15\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d SRN \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41.  11. AWB \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c28\u0c4d\u0c28 SMS \u0c15\u0c42\u0c21\u0c3e DoP \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c2a\u0c02\u0c2a\u0c2c\u0c21\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c2a\u0c02\u0c2a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d DoP \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d\u200c\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c21\u0c46\u0c32\u0c3f\u0c35\u0c30\u0c40 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c2e\u0c30\u0c3f\u0c02\u0c24 \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41."},{question:"\u0c28\u0c3e\u0c28\u0c4d-\u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d/\u0c06\u0c32\u0c4d\u0c1f\u0c30\u0c4d\u0c28\u0c47\u0c1f\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c0e\u0c32\u0c3e \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41?",answer:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f https://uidai.gov.in\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f \u0c32\u0c47\u0c26\u0c3e https://myaadhaar.uidai.gov.in/genricPVC \u201c\u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d\u201d \u0c38\u0c47\u0c35\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c40 12 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d (UID) \u0c32\u0c47\u0c26\u0c3e 28 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c28\u0c2e\u0c4b\u0c26\u0c41\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. ID\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c2e\u0c40\u0c15\u0c41 \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c24\u0c47, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c28\u0c3f / \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c3e\u0c2e\u0c4d\u0c28\u0c3e\u0c2f \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f' \u0c05\u0c28\u0c47 \u0c1a\u0c46\u0c15\u0c4d \u0c2c\u0c3e\u0c15\u0c4d\u0c38\u0c4d\u200c\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c3f\u0c17\u0c3f\u0c32\u0c3f\u0c28 \u0c26\u0c36\u0c32\u0c41 \u0c05\u0c32\u0c3e\u0c17\u0c47 \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c3f."},{question:"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c0f \u0c2e\u0c4b\u0c21\u0c4d\u200c\u0c32\u0c41 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f?",answer:"\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02, \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26\u0c3f \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c2e\u0c4b\u0c21\u0c4d\u200c\u0c32\u0c41 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f:-  \u0c15\u0c4d\u0c30\u0c46\u0c21\u0c3f\u0c1f\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d   \u0c21\u0c46\u0c2c\u0c3f\u0c1f\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d   \u0c28\u0c46\u0c1f\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c3f\u0c02\u0c17\u0c4d  \u0c2f\u0c42\u0c2a\u0c40\u0c10 \u0c2a\u0c47 \u0c1f\u0c3f \u0c0e\u0c02"},{question:"SRN \u0c05\u0c02\u0c1f\u0c47 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"SRN \u0c05\u0c28\u0c47\u0c26\u0c3f 14 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c30\u0c3f\u0c15\u0c4d\u0c35\u0c46\u0c38\u0c4d\u0c1f\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d, \u0c07\u0c26\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c30\u0c42\u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c07\u0c26\u0c3f \u0c30\u0c42\u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c2f\u0c4d\u0c2f\u0c47 \u0c35\u0c30\u0c15\u0c41 '\u0c30\u0c46\u0c38\u0c4d\u0c2f\u0c42\u0c2e\u0c4d' \u0c06\u0c2a\u0c4d\u0c37\u0c28\u0c4d \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f."},{question:"AWB \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c05\u0c02\u0c1f\u0c47 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"\u0c0e\u0c2f\u0c3f\u0c30\u0c4d\u200c\u0c35\u0c47 \u0c2c\u0c3f\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c05\u0c28\u0c47\u0c26\u0c3f \u0c35\u0c3e\u0c30\u0c41 \u0c21\u0c46\u0c32\u0c3f\u0c35\u0c30\u0c40 \u0c1a\u0c47\u0c38\u0c47 \u0c05\u0c38\u0c48\u0c28\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d/\u0c2a\u0c4d\u0c30\u0c4a\u0c21\u0c15\u0c4d\u0c1f\u0c4d \u0c15\u0c4b\u0c38\u0c02 DoP \u0c05\u0c02\u0c1f\u0c47 \u0c07\u0c02\u0c21\u0c3f\u0c2f\u0c3e \u0c38\u0c4d\u0c2a\u0c40\u0c21\u0c4d \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c30\u0c42\u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d."},{question:"\u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f\u0c24\u0c41\u0c32\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c28\u0c41 \u0c24\u0c2e\u0c15\u0c41 \u0c15\u0c3e\u0c35\u0c32\u0c38\u0c3f\u0c28 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c24\u0c4b \u0c2e\u0c41\u0c26\u0c4d\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c47 \u0c0f\u0c2e\u0c3f \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c3f?",answer:"\u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f\u0c24\u0c41\u0c32\u0c41 \u0c2e\u0c41\u0c26\u0c4d\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c32\u0c47\u0c16 \u0c32\u0c47\u0c26\u0c3e PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c32\u0c4b \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41\u0c32\u0c41 \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c47, \u0c35\u0c3e\u0c30\u0c41 \u0c2e\u0c41\u0c02\u0c26\u0c41\u0c17\u0c3e \u0c36\u0c3e\u0c36\u0c4d\u0c35\u0c24 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c02 \u0c32\u0c47\u0c26\u0c3e SSUP \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d (\u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c06\u0c27\u0c3e\u0c30\u0c02\u0c17\u0c3e) \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c35\u0c3e\u0c30\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c06 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d/\u0c32\u0c46\u0c1f\u0c30\u0c4d \u0c39\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c15\u0c3e\u0c2a\u0c40\u0c28\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c08 \u0c38\u0c26\u0c41\u0c2a\u0c3e\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41."},{question:"\u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c2e\u0c48\u0c28 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u201c\u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d\u201d \u0c2a\u0c4a\u0c02\u0c26\u0c1f\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c0e\u0c28\u0c4d\u0c28\u0c3f \u0c30\u0c4b\u0c1c\u0c41\u0c32\u0c41 \u0c2a\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f?",answer:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, UIDAI 5 \u0c2a\u0c28\u0c3f \u0c26\u0c3f\u0c28\u0c3e\u0c32\u0c32\u0c4b (\u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c24\u0c47\u0c26\u0c40 \u0c2e\u0c3f\u0c28\u0c39\u0c3e) \u0c2e\u0c41\u0c26\u0c4d\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c28\u0c3f DoP\u0c15\u0c3f \u0c05\u0c02\u0c26\u0c1c\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c21\u0c47\u0c1f\u0c3e\u0c2c\u0c47\u0c38\u0c4d\u200c\u0c32\u0c4b \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c15\u0c41 \u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24 \u0c21\u0c46\u0c32\u0c3f\u0c35\u0c30\u0c40 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c15\u0c41 \u0c05\u0c28\u0c41\u0c17\u0c41\u0c23\u0c02\u0c17\u0c3e \u0c38\u0c4d\u0c2a\u0c40\u0c21\u0c4d \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c06\u0c2b\u0c4d \u0c07\u0c02\u0c21\u0c3f\u0c2f\u0c3e \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c21\u0c46\u0c32\u0c3f\u0c35\u0c30\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d https://www.indiapost.gov.in/_layouts/15/dop.portal.track\u0c32\u0c4b DoP \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c38\u0c47\u0c35\u0c32\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f \u0c21\u0c46\u0c32\u0c3f\u0c35\u0c30\u0c40 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41."}],verifyEmailMobile:[{question:"\u0c21\u0c46\u0c2e\u0c4b\u0c17\u0c4d\u0c30\u0c3e\u0c2b\u0c3f\u0c15\u0c4d  \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c30\u0c41\u0c38\u0c41\u0c2e\u0c41 \u0c09\u0c02\u0c26\u0c3e?",answer:"\u0c05\u0c35\u0c41\u0c28\u0c41, \u0c21\u0c46\u0c2e\u0c4b\u0c17\u0c4d\u0c30\u0c3e\u0c2b\u0c3f\u0c15\u0c4d \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c2e\u0c40\u0c30\u0c41 \u0c30\u0c42. \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f. 50/- (GST\u0c24\u0c4b \u0c38\u0c39\u0c3e)."}],orderAadhaarPvcCard:[{question:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c07-\u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c0e\u0c15\u0c4d\u0c15\u0c21 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c21\u0c4c\u0c28\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c41?",answer:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d UIDAI \u0c2f\u0c4a\u0c15\u0c4d\u0c15 MyAadhaar \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d- https://myaadhaar.uidai.gov.in\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c2b\u0c4b\u0c28\u0c4d\u0c32\u0c4b mAadhaar \u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c07-\u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c21\u0c4c\u0c28\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c41."}],retrieveEidAadhaarNumber:[{question:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c21\u0c47\u0c1f\u0c3e\u0c28\u0c41 \u0c0e\u0c28\u0c4d\u0c28\u0c3f\u0c38\u0c3e\u0c30\u0c4d\u0c32\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41?",answer:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23\u0c15\u0c41 \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26\u0c3f \u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24\u0c41\u0c32\u0c41 \u0c35\u0c30\u0c4d\u0c24\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f:    \u2022 \u0c2a\u0c47\u0c30\u0c41: \u0c1c\u0c40\u0c35\u0c3f\u0c24 \u0c15\u0c3e\u0c32\u0c02\u0c32\u0c4b \u0c30\u0c46\u0c02\u0c21\u0c41\u0c38\u0c3e\u0c30\u0c4d\u0c32\u0c41   \u2022 \u0c32\u0c3f\u0c02\u0c17\u0c02: \u0c1c\u0c40\u0c35\u0c3f\u0c24\u0c02\u0c32\u0c4b \u0c12\u0c15\u0c38\u0c3e\u0c30\u0c3f   \u2022 \u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c40: \u0c1c\u0c40\u0c35\u0c3f\u0c24\u0c02\u0c32\u0c4b \u0c12\u0c15\u0c38\u0c3e\u0c30\u0c3f'"},{question:"\u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c32\u0c4b \u0c28\u0c3e \u0c2a\u0c47\u0c30\u0c41\u0c15\u0c41 \u0c28\u0c47\u0c28\u0c41 \u0c0e\u0c32\u0c3e\u0c02\u0c1f\u0c3f \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41\u0c32\u0c41 \u0c1a\u0c47\u0c2f\u0c17\u0c32\u0c28\u0c41?",answer:"\u0c2e\u0c40 \u0c2a\u0c47\u0c30\u0c41\u0c32\u0c4b \u0c1a\u0c3f\u0c28\u0c4d\u0c28 \u0c38\u0c35\u0c30\u0c23\u0c32\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c47\u0c30\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41 \u0c15\u0c4b\u0c38\u0c02, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c2e\u0c40\u0c2a\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f."},{question:"\u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c05\u0c21\u0c4d\u0c30\u0c38\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c0f \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c41 \u0c05\u0c35\u0c38\u0c30\u0c02?",answer:"\u0c38\u0c39\u0c3e\u0c2f\u0c15 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32 \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e \u0c2a\u0c4d\u0c30\u0c15\u0c3e\u0c30\u0c02 POA \u0c2a\u0c24\u0c4d\u0c30\u0c02 \u0c05\u0c35\u0c38\u0c30\u0c02. https://uidai.gov.in \u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f."},{question:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c32\u0c4b  \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c0f \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c41 \u0c05\u0c35\u0c38\u0c30\u0c02?",answer:"\u0c2e\u0c40\u0c30\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c17\u0c32 \u0c38\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32 \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c24\u0c17\u0c3f\u0c28 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c41\u0c28\u0c3f, \u0c21\u0c46\u0c2e\u0c4b\u0c17\u0c4d\u0c30\u0c3e\u0c2b\u0c3f\u0c15\u0c4d \u0c21\u0c47\u0c1f\u0c3e \u0c26\u0c3f\u0c26\u0c4d\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c28\u0c41 \u0c1a\u0c47\u0c2a\u0c1f\u0c4d\u0c1f\u0c47\u0c1f\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c26\u0c3e\u0c28\u0c3f \u0c38\u0c4d\u0c15\u0c3e\u0c28\u0c4d/\u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f."},{question:"\u0c05\u0c21\u0c4d\u0c30\u0c38\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c35\u0c3f\u0c37\u0c2f\u0c02\u0c32\u0c4b \u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3e \u0c38\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c0e\u0c32\u0c3e \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c17\u0c32\u0c28\u0c41?",answer:"\u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c38\u0c47\u0c35\u0c32\u0c4b pdf \u0c32\u0c47\u0c26\u0c3e jpeg \u0c06\u0c15\u0c43\u0c24\u0c3f\u0c32\u0c4b \u0c38\u0c39\u0c3e\u0c2f\u0c15 \u0c2a\u0c24\u0c4d\u0c30\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c38\u0c4d\u0c15\u0c3e\u0c28\u0c4d/\u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c2e\u0c28\u0c3f \u0c2e\u0c40\u0c30\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c2a\u0c4d\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c24\u0c3e\u0c30\u0c41. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c38\u0c46\u0c38\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c30\u0c48\u0c28 \u0c38\u0c39\u0c3e\u0c2f\u0c15 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c4d, \u0c05\u0c26\u0c4d\u0c26\u0c46 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c06\u0c38\u0c4d\u0c24\u0c3f \u0c12\u0c2a\u0c4d\u0c2a\u0c02\u0c26\u0c02 \u0c35\u0c02\u0c1f\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c26\u0c3f\u0c37\u0c4d\u0c1f \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02, \u0c2c\u0c39\u0c41\u0c33 \u0c2a\u0c47\u0c1c\u0c40\u0c32 \u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c02 \u0c05\u0c35\u0c38\u0c30\u0c02."},{question:"\u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3e \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3f\u0c15 \u0c2d\u0c3e\u0c37\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c3e?",answer:"\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02 \u0c2e\u0c40\u0c30\u0c41 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c40 \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3f\u0c15 \u0c2d\u0c3e\u0c37\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c32\u0c47\u0c30\u0c41."},{question:"\u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3e \u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c40\u0c28\u0c3f \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c3e?",answer:"\u0c32\u0c47\u0c26\u0c41, \u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c40\u0c28\u0c3f (DoB) \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f DoB \u0c2a\u0c4d\u0c30\u0c42\u0c2b\u0c4d \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c24\u0c4b \u0c38\u0c2e\u0c40\u0c2a\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f."},{question:"\u0c28\u0c47\u0c28\u0c41 \u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c47 \u0c12\u0c15\u0c38\u0c3e\u0c30\u0c3f \u0c28\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c32\u0c4b \u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c40\u0c28\u0c3f \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c28\u0c41. \u0c28\u0c47\u0c28\u0c41 \u0c26\u0c3e\u0c28\u0c3f\u0c28\u0c3f \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c3e/ \u0c38\u0c30\u0c3f\u0c26\u0c3f\u0c26\u0c4d\u0c26\u0c35\u0c1a\u0c4d\u0c1a\u0c3e?",answer:"\u0c32\u0c47\u0c26\u0c41. \u0c2e\u0c40\u0c30\u0c41 \u0c2e\u0c40 \u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c40\u0c28\u0c3f (DoB) \u0c12\u0c15\u0c4d\u0c15\u0c38\u0c3e\u0c30\u0c3f \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c17\u0c32\u0c30\u0c41. \u0c05\u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23\u0c2e\u0c48\u0c28 \u0c2a\u0c30\u0c3f\u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c41\u0c32\u0c32\u0c4b \u0c24\u0c26\u0c41\u0c2a\u0c30\u0c3f \u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c40\u0c28\u0c3f (DoB) \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c08 \u0c35\u0c3f\u0c37\u0c2f\u0c02\u0c32\u0c4b 1947\u0c15\u0c3f \u0c15\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f."},{question:"\u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c23 \u0c1c\u0c28\u0c3e\u0c2d\u0c3e \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23\u0c15\u0c41 \u0c39\u0c3e\u0c2e\u0c40 \u0c07\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3e?",answer:"\u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c23 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c21\u0c47\u0c1f\u0c3e \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23\u0c15\u0c41 \u0c39\u0c3e\u0c2e\u0c40 \u0c07\u0c35\u0c4d\u0c35\u0c26\u0c41. \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41\u0c32\u0c41 UIDAI \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23\u0c15\u0c41 \u0c32\u0c4b\u0c2c\u0c21\u0c3f \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c24\u0c26\u0c41\u0c2a\u0c30\u0c3f \u0c2a\u0c4d\u0c30\u0c3e\u0c38\u0c46\u0c38\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f."},{question:"\u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3e \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c2a\u0c4b\u0c17\u0c4a\u0c1f\u0c4d\u0c1f\u0c41\u0c15\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41/ \u0c28\u0c47\u0c28\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c24\u0c4b \u0c0e\u0c28\u0c4d\u200c\u0c30\u0c4b\u0c32\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c32\u0c47\u0c28\u0c41. \u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3e \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c0e\u0c32\u0c3e \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f?",answer:"\u0c12\u0c15\u0c35\u0c47\u0c33 \u0c2e\u0c40\u0c30\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c24\u0c4b \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c15\u0c4b\u0c32\u0c4d\u0c2a\u0c4b\u0c2f\u0c3f\u0c28\u0c3e/\u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c15\u0c2a\u0c4b\u0c2f\u0c3f\u0c28\u0c3e, \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c40\u0c30\u0c41 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24\u0c02\u0c17\u0c3e \u0c38\u0c2e\u0c40\u0c2a\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f."},{question:"\u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c28\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c2e\u0c3e\u0c30\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3e?",answer:"\u0c32\u0c47\u0c26\u0c41, \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c15\u0c42\u0c21\u0c3e \u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c05\u0c32\u0c3e\u0c17\u0c47 \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f."},{question:"\u0c28\u0c47\u0c28\u0c41 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41. \u0c28\u0c47\u0c28\u0c41 \u0c1a\u0c47\u0c2f\u0c17\u0c32\u0c28\u0c3e?",answer:"\u0c24\u0c26\u0c41\u0c2a\u0c30\u0c3f \u0c2a\u0c4d\u0c30\u0c3e\u0c38\u0c46\u0c38\u0c3f\u0c02\u0c17\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c38\u0c4d\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c47 \u0c35\u0c30\u0c15\u0c41 \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f myAadhaar \u0c21\u0c4d\u0c2f\u0c3e\u0c37\u0c4d\u200c\u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c4b\u0c28\u0c3f \u2018\u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c32\u0c41\u2019 \u0c38\u0c4d\u0c25\u0c32\u0c02 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c38\u0c3f\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47, \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 21 \u0c30\u0c4b\u0c1c\u0c41\u0c32\u0c4d\u0c32\u0c4b \u0c16\u0c3e\u0c24\u0c3e\u0c15\u0c41 \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f."},{question:"\u0c28\u0c3e \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c32\u0c28\u0c4d\u0c28\u0c3f\u0c02\u0c1f\u0c3f\u0c28\u0c40 \u0c28\u0c47\u0c28\u0c41 \u0c0e\u0c15\u0c4d\u0c15\u0c21 \u0c1a\u0c42\u0c21\u0c17\u0c32\u0c28\u0c41?",answer:"\u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f \u0c24\u0c28/\u0c06\u0c2e\u0c46 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c32\u0c28\u0c41 myAadhaar \u0c21\u0c4d\u0c2f\u0c3e\u0c37\u0c4d\u200c\u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c4b\u0c28\u0c3f '\u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c32' \u0c38\u0c4d\u0c25\u0c32\u0c02\u0c32\u0c4b \u0c1a\u0c42\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41."},{question:"\u0c28\u0c3e \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c15\u0c41 \u0c28\u0c3e \u0c24\u0c02\u0c21\u0c4d\u0c30\u0c3f/\u0c2d\u0c30\u0c4d\u0c24 \u0c2a\u0c47\u0c30\u0c41\u0c28\u0c41 \u0c0e\u0c32\u0c3e \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f?",answer:"\u0c38\u0c02\u0c2c\u0c02\u0c27 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c32\u0c4b\u0c28\u0c3f \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c2b\u0c40\u0c32\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c4b \u0c12\u0c15 \u0c2d\u0c3e\u0c17\u0c02. \u0c07\u0c26\u0c3f C/o (\u0c15\u0c47\u0c30\u0c4d \u0c06\u0c2b\u0c4d)\u0c15\u0c3f \u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c3f\u0c15\u0c02 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \u0c26\u0c40\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c42\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c10\u0c1a\u0c4d\u0c1b\u0c3f\u0c15\u0c02."}],eaadhaarDownload:[{question:"\u0c07-\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c05\u0c02\u0c1f\u0c47 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"\u0c07-\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c05\u0c28\u0c47\u0c26\u0c3f UIDAI\u0c1a\u0c47 \u0c21\u0c3f\u0c1c\u0c3f\u0c1f\u0c32\u0c4d \u0c38\u0c02\u0c24\u0c15\u0c02 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c24 \u0c0e\u0c32\u0c15\u0c4d\u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c3f\u0c15\u0c4d \u0c15\u0c3e\u0c2a\u0c40."},{question:"\u0c07-\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2d\u0c4c\u0c24\u0c3f\u0c15 \u0c15\u0c3e\u0c2a\u0c40 \u0c35\u0c32\u0c46 \u0c38\u0c2e\u0c3e\u0c28\u0c02\u0c17\u0c3e \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3e?",answer:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c1a\u0c1f\u0c4d\u0c1f\u0c02 \u0c2a\u0c4d\u0c30\u0c15\u0c3e\u0c30\u0c02, \u0c07-\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2d\u0c4c\u0c24\u0c3f\u0c15 \u0c15\u0c3e\u0c2a\u0c40 \u0c35\u0c32\u0c46 \u0c38\u0c2e\u0c3e\u0c28\u0c02\u0c17\u0c3e \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. eAadhaar \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c15\u0c4b\u0c38\u0c02, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f UIDAI \u0c38\u0c30\u0c4d\u0c15\u0c4d\u0c2f\u0c41\u0c32\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f- https://uidai.gov.in/images/ uidai_om_on_e_aadhaar_validity.pdf"},{question:"\u0c2e\u0c3e\u0c38\u0c4d\u0c15\u0c4d\u200c\u0c21\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c05\u0c02\u0c1f\u0c47 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"\u0c2e\u0c3e\u0c38\u0c4d\u0c15\u0c4d\u200c\u0c21\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c05\u0c28\u0c47\u0c26\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c32\u0c4b\u0c28\u0c3f \u0c2e\u0c4a\u0c26\u0c1f\u0c3f 8 \u0c05\u0c02\u0c15\u0c46\u0c32\u0c28\u0c41 \u201cxxxx-xxxx\u201d\u0c24\u0c4b \u0c2d\u0c30\u0c4d\u0c24\u0c40 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c42\u0c1a\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f, \u0c05\u0c2f\u0c3f\u0c24\u0c47 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c32\u0c4b\u0c28\u0c3f \u0c1a\u0c3f\u0c35\u0c30\u0c3f 4 \u0c05\u0c02\u0c15\u0c46\u0c32\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c15\u0c28\u0c3f\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f."},{question:"\u0c07-\u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c32\u0c4b \u0c21\u0c3f\u0c1c\u0c3f\u0c1f\u0c32\u0c4d \u0c38\u0c02\u0c24\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c0e\u0c32\u0c3e \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f?",answer:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d YouTube \u0c1b\u0c3e\u0c28\u0c46\u0c32\u0c4d\u200c\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1f\u0c4d\u0c2f\u0c41\u0c1f\u0c4b\u0c30\u0c3f\u0c2f\u0c32\u0c4d \u0c32\u0c3f\u0c02\u0c15\u0c4d\u200c\u0c28\u0c3f https://youtu.be/aVNfUNIccZs?si=ByW1O6BIPMwc0seL\u0c32\u0c4b \u0c1a\u0c42\u0c21\u0c02\u0c21\u0c3f"},{question:"\u0c07-\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c05\u0c02\u0c1f\u0c47 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"eAadhaar \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c05\u0c28\u0c47\u0c26\u0c3f \u0c2a\u0c47\u0c30\u0c41\u0c32\u0c4b\u0c28\u0c3f \u0c2e\u0c4a\u0c26\u0c1f\u0c3f 4 \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32\u0c41 \u0c15\u0c4d\u0c2f\u0c3e\u0c2a\u0c3f\u0c1f\u0c32\u0c4d\u200c\u0c32\u0c4b \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02 (YYYY) \u0c15\u0c32\u0c2f\u0c3f\u0c15.\n\u0c09\u0c26\u0c3e\u0c39\u0c30\u0c23\u0c15\u0c41:\n\u0c09\u0c26\u0c3e\u0c39\u0c30\u0c23 1\n\u0c2a\u0c47\u0c30\u0c41: SURESH KUMAR\n\u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02: 1990\n\u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d: SURE1990\n\u0c09\u0c26\u0c3e\u0c39\u0c30\u0c23 2\n\u0c2a\u0c47\u0c30\u0c41: SAI KUMAR\n\u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02: 1990\n\u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d: SAIK1990\n\u0c09\u0c26\u0c3e\u0c39\u0c30\u0c23 3\n\u0c2a\u0c47\u0c30\u0c41: P. KUMAR\n\u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02: 1990\n\u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d: P.KU1990\n\u0c09\u0c26\u0c3e\u0c39\u0c30\u0c23 4\n\u0c2a\u0c47\u0c30\u0c41: RIA\n\u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02: 1990\n\u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d: RIA1990"},{question:"\u0c07-\u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c24\u0c46\u0c30\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c0f \u0c38\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c38\u0c3e\u0c2b\u0c4d\u0c1f\u0c4d\u200c\u0c35\u0c47\u0c30\u0c4d \u0c05\u0c35\u0c38\u0c30\u0c02?",answer:"\u0c07-\u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f\u0c15\u0c3f 'Adobe Reader' \u0c05\u0c35\u0c38\u0c30\u0c02. \u0c2e\u0c40\u0c30\u0c41 \u0c2e\u0c40 \u0c38\u0c3f\u0c38\u0c4d\u0c1f\u0c2e\u0c4d\u200c\u0c32\u0c4b 'Adobe Reader' \u0c07\u0c28\u0c4d\u200c\u0c38\u0c4d\u0c1f\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c38\u0c3e\u0c30\u0c41. \u0c38\u0c3f\u0c38\u0c4d\u0c1f\u0c2e\u0c4d\u200c\u0c32\u0c4b Adobe Reader\u0c28\u0c3f \u0c07\u0c28\u0c4d\u200c\u0c38\u0c4d\u0c1f\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f\nhttps://get.adobe.com/reader/ \u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f"},{question:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c07-\u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c0e\u0c32\u0c3e \u0c21\u0c4c\u0c28\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c41?",answer:"\u0c12\u0c15 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c2e\u0c42\u0c21\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c17\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c28\u0c41\u0c38\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c07-\u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c21\u0c4c\u0c28\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c41.\n\u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e:\n\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e:\nVID\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e:\neAadhaar \u0c21\u0c4c\u0c28\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f OTP \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c2a\u0c02\u0c2a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f."}],bookAnAppointment:[{question:"UIDAI\u0c32\u0c4b\u0c28\u0c3f \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41\u0c32 \u0c2a\u0c30\u0c3f\u0c37\u0c4d\u0c15\u0c3e\u0c30 \u0c2e\u0c3e\u0c30\u0c4d\u0c17\u0c3e\u0c32\u0c41 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"\u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c41\u0c32\u0c41 \u0c24\u0c2e \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41\u0c32 \u0c2a\u0c30\u0c3f\u0c37\u0c4d\u0c15\u0c3e\u0c30\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c2b\u0c4b\u0c28\u0c4d, \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d, \u0c1a\u0c3e\u0c1f\u0c4d, \u0c32\u0c46\u0c1f\u0c30\u0c4d/\u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d, \u0c35\u0c46\u0c2c\u0c4d \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d, \u0c35\u0c3e\u0c15\u0c4d \u0c07\u0c28\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c4b\u0c37\u0c32\u0c4d \u0c2e\u0c40\u0c21\u0c3f\u0c2f\u0c3e \u0c35\u0c02\u0c1f\u0c3f \u0c2c\u0c39\u0c41\u0c33 \u0c1b\u0c3e\u0c28\u0c46\u0c32\u0c4d\u200c\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e UIDAI\u0c28\u0c3f \u0c1a\u0c47\u0c30\u0c41\u0c15\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c41.    \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28 \u0c1b\u0c3e\u0c28\u0c46\u0c32\u0c4d\u200c\u0c32 \u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c3f\u0c35\u0c30\u0c23\u0c3e\u0c24\u0c4d\u0c2e\u0c15 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26\u0c3f \u0c35\u0c3f\u0c27\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c26\u0c3f:    1. \u0c2b\u0c4b\u0c28\u0c4d \u0c15\u0c3e\u0c32\u0c4d (\u0c1f\u0c4b\u0c32\u0c4d \u0c2b\u0c4d\u0c30\u0c40 \u0c28\u0c02\u0c2c\u0c30\u0c4d) -\n\u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c41\u0c32\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c32 \u0c15\u0c4b\u0c38\u0c02 UIDAI \u0c1f\u0c4b\u0c32\u0c4d \u0c2b\u0c4d\u0c30\u0c40 \u0c28\u0c02\u0c2c\u0c30\u0c4d (1947)\u0c28\u0c3f \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. UIDAI \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c02 \u0c38\u0c4d\u0c35\u0c40\u0c2f \u0c38\u0c47\u0c35 IVRS (\u0c07\u0c02\u0c1f\u0c30\u0c3e\u0c15\u0c4d\u0c1f\u0c3f\u0c35\u0c4d \u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d \u0c30\u0c46\u0c38\u0c4d\u0c2a\u0c3e\u0c28\u0c4d\u0c38\u0c4d \u0c38\u0c3f\u0c38\u0c4d\u0c1f\u0c2e\u0c4d) \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c3e\u0c39\u0c15 \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c38\u0c39\u0c3e\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f. \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f \u0c35\u0c3e\u0c30\u0c3f \u0c38\u0c4c\u0c32\u0c2d\u0c4d\u0c2f\u0c02 \u0c2a\u0c4d\u0c30\u0c15\u0c3e\u0c30\u0c02 \u0c15\u0c2e\u0c4d\u0c2f\u0c42\u0c28\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c26\u0c3f\u0c17\u0c41\u0c35 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c2d\u0c3e\u0c37\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c41.            1. \u0c39\u0c3f\u0c02\u0c26\u0c40\n5. \u0c15\u0c28\u0c4d\u0c28\u0c21\n9. \u0c17\u0c41\u0c1c\u0c30\u0c3e\u0c24\u0c40\n2. \u0c07\u0c02\u0c17\u0c4d\u0c32\u0c40\u0c37\u0c4d\n6. \u0c2e\u0c32\u0c2f\u0c3e\u0c33\u0c02\n10. \u0c2e\u0c30\u0c3e\u0c20\u0c40\n3. \u0c24\u0c46\u0c32\u0c41\u0c17\u0c41\n7. \u0c05\u0c38\u0c4d\u0c38\u0c3e\u0c2e\u0c40\n11. \u0c2a\u0c02\u0c1c\u0c3e\u0c2c\u0c40\n4. \u0c24\u0c2e\u0c3f\u0c33\u0c02\n8. \u0c2c\u0c46\u0c02\u0c17\u0c3e\u0c32\u0c40\n12. \u0c12\u0c21\u0c3f\u0c2f\u0c3e     \u0c38\u0c2e\u0c2f\u0c3e\u0c32\u0c41:  \u0c0e) IVRS \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c38\u0c4d\u0c35\u0c40\u0c2f \u0c38\u0c47\u0c35\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c21\u0c02: IVRS \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c38\u0c47\u0c35\u0c32\u0c28\u0c41 24X7 \u0c2a\u0c4d\u0c30\u0c3e\u0c24\u0c3f\u0c2a\u0c26\u0c3f\u0c15\u0c28 \u0c38\u0c46\u0c32\u0c4d\u0c2b\u0c4d \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c2e\u0c4b\u0c21\u0c4d\u200c\u0c32\u0c4b \u0c2a\u0c4a\u0c02\u0c26\u0c35\u0c1a\u0c4d\u0c1a\u0c41.      \u0c2c\u0c3f) \u0c38\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c4d \u0c0e\u0c17\u0c4d\u0c1c\u0c3f\u0c15\u0c4d\u0c2f\u0c42\u0c1f\u0c3f\u0c35\u0c4d \u0c38\u0c39\u0c3e\u0c2f\u0c02: \u0c08 \u0c38\u0c47\u0c35\u0c28\u0c41 \u0c38\u0c4b\u0c2e\u0c35\u0c3e\u0c30\u0c02 - \u0c36\u0c28\u0c3f\u0c35\u0c3e\u0c30\u0c02 \u0c28\u0c41\u0c02\u0c21\u0c3f: \u0c09\u0c26\u0c2f\u0c02 7 \u0c28\u0c41\u0c02\u0c21\u0c3f 11 \u0c17\u0c02\u0c1f\u0c32 \u0c35\u0c30\u0c15\u0c41, \u0c06\u0c26\u0c3f\u0c35\u0c3e\u0c30\u0c02: \u0c09\u0c26\u0c2f\u0c02 8 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c38\u0c3e\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c02 5 \u0c17\u0c02\u0c1f\u0c32 \u0c35\u0c30\u0c15\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c35\u0c1a\u0c4d\u0c1a\u0c41.   \u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c41 UIDAI \u0c06\u0c2e\u0c4b\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c3f\u0c15 \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c28\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c15\u0c3e\u0c02\u0c1f\u0c3e\u0c15\u0c4d\u0c1f\u0c4d \u0c38\u0c46\u0c02\u0c1f\u0c30\u0c4d \u0c0e\u0c17\u0c4d\u0c1c\u0c3f\u0c15\u0c4d\u0c2f\u0c42\u0c1f\u0c3f\u0c35\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c30\u0c3f\u0c37\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 UIDAI \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c3e\u0c32\u0c41/\u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c40\u0c2f \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c3e\u0c32\u0c2f\u0c3e\u0c32\u0c15\u0c41 \u0c28\u0c3f\u0c1c \u0c38\u0c2e\u0c2f \u0c2a\u0c4d\u0c30\u0c3e\u0c24\u0c3f\u0c2a\u0c26\u0c3f\u0c15\u0c28 \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41\u0c32\u0c41 \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f. \u0c08 \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41\u0c32\u0c41 \u0c2a\u0c4d\u0c30\u0c2d\u0c3e\u0c35\u0c35\u0c02\u0c24\u0c2e\u0c48\u0c28 \u0c2a\u0c30\u0c3f\u0c37\u0c4d\u0c15\u0c3e\u0c30\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c15\u0c3f \u0c15\u0c2e\u0c4d\u0c2f\u0c42\u0c28\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c15\u0c4b\u0c38\u0c02 UIDAI \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c21\u0c3f\u0c35\u0c3f\u0c1c\u0c28\u0c4d/\u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c40\u0c2f \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c3e\u0c32\u0c2f\u0c3e\u0c32\u0c32\u0c4b \u0c05\u0c02\u0c24\u0c30\u0c4d\u0c17\u0c24\u0c02\u0c17\u0c3e \u0c2a\u0c30\u0c3f\u0c36\u0c40\u0c32\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f.        2. \u0c1a\u0c3e\u0c1f\u0c4d\u200c\u0c2c\u0c3e\u0c1f\u0c4d (\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2e\u0c3f\u0c24\u0c4d\u0c30) \u2013 UIDAI \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c3f\u0c15 \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d\u200c\u0c32\u0c4b \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28 UIDAI \u0c1a\u0c3e\u0c1f\u0c4d\u200c\u0c2c\u0c3e\u0c1f\u0c4d \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d ''\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2e\u0c3f\u0c24\u0c4d\u0c30'' \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c41\u0c32\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c24\u0c2e \u0c06\u0c02\u0c26\u0c4b\u0c33\u0c28\u0c28\u0c41 \u0c32\u0c47\u0c35\u0c28\u0c46\u0c24\u0c4d\u0c24\u0c35\u0c1a\u0c4d\u0c1a\u0c41, \u0c08 \u0c1a\u0c3e\u0c1f\u0c4d\u200c\u0c2c\u0c3e\u0c1f\u0c4d \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c15\u0c41 \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 \u0c05\u0c28\u0c41\u0c2d\u0c35\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2e\u0c46\u0c30\u0c41\u0c17\u0c41\u0c2a\u0c30\u0c1a\u0c21\u0c02 \u0c32\u0c15\u0c4d\u0c37\u0c4d\u0c2f\u0c02\u0c17\u0c3e \u0c36\u0c3f\u0c15\u0c4d\u0c37\u0c23 \u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c26\u0c3f.     3. UIDAI \u0c35\u0c46\u0c2c\u0c4d \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d \u2013 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c41\u0c32\u0c41 UIDAI \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d\u200c\u0c32\u0c4b \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2b\u0c40\u0c21\u0c4d\u200c\u0c2c\u0c4d\u0c2f\u0c3e\u0c15\u0c4d & \u0c1a\u0c46\u0c15\u0c4d \u0c17\u0c4d\u0c30\u0c40\u0c35\u0c46\u0c28\u0c4d\u0c38\u0c4d / \u0c2b\u0c40\u0c21\u0c4d\u200c\u0c2c\u0c4d\u0c2f\u0c3e\u0c15\u0c4d \u0c38\u0c4d\u0c1f\u0c47\u0c1f\u0c38\u0c4d \u0c15\u0c3f\u0c02\u0c26 \u0c35\u0c3e\u0c30\u0c3f \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41.              4. \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d - \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c41\u0c32\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c0f\u0c35\u0c48\u0c28\u0c3e \u0c38\u0c02\u0c26\u0c47\u0c39\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41\u0c32 \u0c15\u0c4b\u0c38\u0c02 help@uidai.gov.in\u0c15\u0c3f \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c2a\u0c02\u0c2a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.                5. \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c40\u0c2f \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c3e\u0c32\u0c2f\u0c3e\u0c32 \u0c35\u0c26\u0c4d\u0c26 \u0c35\u0c3e\u0c15\u0c4d-\u0c07\u0c28\u0c4d: \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c41\u0c32\u0c41 \u0c24\u0c2e \u0c38\u0c02\u0c26\u0c47\u0c39\u0c3e\u0c32 \u0c2a\u0c30\u0c3f\u0c37\u0c4d\u0c15\u0c3e\u0c30\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41\u0c32 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c23 \u0c15\u0c4b\u0c38\u0c02 \u0c35\u0c3e\u0c30\u0c3f \u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c28\u0c41\u0c17\u0c41\u0c23\u0c02\u0c17\u0c3e \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c40\u0c2f \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c3e\u0c32\u0c2f\u0c3e\u0c32\u0c15\u0c41 \u0c28\u0c47\u0c30\u0c41\u0c17\u0c3e \u0c35\u0c46\u0c33\u0c4d\u0c32\u0c35\u0c1a\u0c4d\u0c1a\u0c41.        6. \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d/\u0c32\u0c46\u0c1f\u0c30\u0c4d: \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c41\u0c32\u0c41 \u0c24\u0c2e \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41\u0c32\u0c28\u0c41 UIDAI HO \u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c40\u0c2f \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c3e\u0c32\u0c2f\u0c3e\u0c32\u0c32\u0c4b \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c1a\u0c47\u0c24\u0c3f\u0c24\u0c4b \u0c26\u0c30\u0c16\u0c3e\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c40\u0c2f \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c3e\u0c32\u0c2f\u0c02/\u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c02 \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41\u0c28\u0c41 \u0c2a\u0c30\u0c3f\u0c37\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c1a\u0c30\u0c4d\u0c2f\u0c32\u0c41 \u0c24\u0c40\u0c38\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f.       7. \u0c2d\u0c3e\u0c30\u0c24 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2a\u0c2c\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c17\u0c4d\u0c30\u0c40\u0c35\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d (CPGRAMS): \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c40\u0c15\u0c43\u0c24 \u0c2a\u0c4d\u0c30\u0c1c\u0c3e \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41\u0c32 \u0c2a\u0c30\u0c3f\u0c37\u0c4d\u0c15\u0c3e\u0c30\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c30\u0c4d\u0c2f\u0c35\u0c47\u0c15\u0c4d\u0c37\u0c23 \u0c35\u0c4d\u0c2f\u0c35\u0c38\u0c4d\u0c25 (CPGRAMS) \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e UIDAI \u0c35\u0c26\u0c4d\u0c26 \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41\u0c32\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c07\u0c26\u0c3f \u0c2a\u0c4c\u0c30\u0c41\u0c32\u0c15\u0c41 24x7 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u200c\u0c2b\u0c3e\u0c30\u0c2e\u0c4d.            8. \u0c38\u0c4b\u0c37\u0c32\u0c4d \u0c2e\u0c40\u0c21\u0c3f\u0c2f\u0c3e: \u0c1f\u0c4d\u0c35\u0c3f\u0c1f\u0c4d\u0c1f\u0c30\u0c4d, \u0c2b\u0c47\u0c38\u0c4d\u200c\u0c2c\u0c41\u0c15\u0c4d, \u0c2f\u0c42 \u0c1f\u0c4d\u0c2f\u0c42\u0c2c\u0c4d, \u0c07\u0c28\u0c4d\u200c\u0c38\u0c4d\u0c1f\u0c3e\u0c17\u0c4d\u0c30\u0c3e\u0c2e\u0c4d \u0c2e\u0c4a\u0c26\u0c32\u0c48\u0c28 \u0c2c\u0c39\u0c41\u0c33 \u0c38\u0c4b\u0c37\u0c32\u0c4d \u0c2e\u0c40\u0c21\u0c3f\u0c2f\u0c3e \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u200c\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u200c\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41\u0c32\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24\u0c02\u0c17\u0c3e \u0c35\u0c3f\u0c35\u0c3f\u0c27 \u0c38\u0c4b\u0c37\u0c32\u0c4d \u0c2e\u0c40\u0c21\u0c3f\u0c2f\u0c3e \u0c38\u0c4d\u0c1f\u0c4d\u0c30\u0c40\u0c2e\u0c4d\u200c\u0c32\u0c32\u0c4b UIDAI \u0c32\u0c47\u0c26\u0c3e DM \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 \u0c2a\u0c47\u0c1c\u0c40\u0c28\u0c3f \u0c1f\u0c4d\u0c2f\u0c3e\u0c17\u0c4d \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c42 \u0c35\u0c3e\u0c30\u0c3f \u0c06\u0c02\u0c26\u0c4b\u0c33\u0c28/\u0c06\u0c02\u0c26\u0c4b\u0c33\u0c28\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d\u200c\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41."},{question:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c15\u0c41 \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32\u0c41 \u0c35\u0c47\u0c30\u0c4d\u0c35\u0c47\u0c30\u0c41\u0c17\u0c3e \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3e?",answer:"\u0c32\u0c47\u0c26\u0c41, \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c24\u0c4b \u0c38\u0c39\u0c3e \u0c26\u0c47\u0c36\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c32\u0c4b \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c32\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32\u0c41 \u0c12\u0c15\u0c47 \u0c35\u0c3f\u0c27\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c3f.\n\u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c1a\u0c42\u0c21\u0c02\u0c21\u0c3f: \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c0e\u0c28\u0c4d\u200c\u0c30\u0c4b\u0c32\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d & \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32\u0c41"},{question:"\u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3e \u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c28\u0c3f \u0c30\u0c40 \u0c37\u0c46\u0c21\u0c4d\u0c2f\u0c42\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c3e/ \u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c3e?",answer:"\u0c05\u0c35\u0c41\u0c28\u0c41, \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d\u200c\u0c15\u0c3f \u0c05\u0c26\u0c47 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d/\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c10\u0c21\u0c3f\u0c24\u0c4b \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e 24 \u0c17\u0c02\u0c1f\u0c32 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c05\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c28\u0c41 \u0c30\u0c40\u0c37\u0c46\u0c21\u0c4d\u0c2f\u0c42\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41 (\u0c2e\u0c41\u0c02\u0c26\u0c41\u0c17\u0c3e \u0c07\u0c1a\u0c4d\u0c1a\u0c3f\u0c28\u0c1f\u0c4d\u0c32\u0c41\u0c17\u0c3e)."},{question:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c02 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c28\u0c47\u0c28\u0c41 \u0c0f \u0c38\u0c47\u0c35\u0c32\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c17\u0c32\u0c28\u0c41?",answer:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c41 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c30\u0c15\u0c3e\u0c32 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f\n1. \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c35\u0c2f\u0c38\u0c41\u0c32 \u0c35\u0c3e\u0c30\u0c3f\u0c15\u0c3f \u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c28\u0c2e\u0c4b\u0c26\u0c41.\n2. \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c21\u0c46\u0c2e\u0c4b\u0c17\u0c4d\u0c30\u0c3e\u0c2b\u0c3f\u0c15\u0c4d \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 (\u0c2a\u0c47\u0c30\u0c41, \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e, \u0c32\u0c3f\u0c02\u0c17\u0c02, \u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c40, \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c10\u0c21\u0c3f) \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23.\n3. \u0c2c\u0c2f\u0c4b\u0c2e\u0c46\u0c1f\u0c4d\u0c30\u0c3f\u0c15\u0c4d \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 (\u0c2b\u0c4b\u0c1f\u0c4b, \u0c35\u0c47\u0c32\u0c3f\u0c2e\u0c41\u0c26\u0c4d\u0c30\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c10\u0c30\u0c3f\u0c38\u0c4d \u0c38\u0c4d\u0c15\u0c3e\u0c28\u0c4d\u200c\u0c32\u0c41) .\n4. \u0c2a\u0c3f\u0c32\u0c4d\u0c32\u0c32 \u0c24\u0c2a\u0c4d\u0c2a\u0c28\u0c3f\u0c38\u0c30\u0c3f \u0c2c\u0c2f\u0c4b\u0c2e\u0c46\u0c1f\u0c4d\u0c30\u0c3f\u0c15\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d (5 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 15 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c3e\u0c32 \u0c35\u0c2f\u0c38\u0c4d\u0c38\u0c41 \u0c35\u0c1a\u0c4d\u0c1a\u0c3e\u0c15).\n5.\u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d (POI \u0c2e\u0c30\u0c3f\u0c2f\u0c41 POA) .\n6.\u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c3f \u0c2a\u0c4d\u0c30\u0c3f\u0c02\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f."},{question:"UIDAI ASK\u0c32 (\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c41) \u0c38\u0c2e\u0c2f\u0c3e\u0c32\u0c41 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"\u0c1c\u0c3e\u0c24\u0c40\u0c2f/\u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c40\u0c2f \u0c38\u0c46\u0c32\u0c35\u0c41\u0c32\u0c41 \u0c2e\u0c3f\u0c28\u0c39\u0c3e \u0c35\u0c3e\u0c30\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c05\u0c28\u0c4d\u0c28\u0c3f 7 \u0c30\u0c4b\u0c1c\u0c41\u0c32\u0c42 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c41 \u0c24\u0c46\u0c30\u0c3f\u0c1a\u0c3f \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c3f. \u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23\u0c02\u0c17\u0c3e \u0c07\u0c26\u0c3f 9:30 AM \u0c28\u0c41\u0c02\u0c21\u0c3f 5:30 PM (IST) \u0c35\u0c30\u0c15\u0c41 \u0c2a\u0c28\u0c3f\u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.\nUIDAI ASK\u0c32\u0c41 \u0c15\u0c3e\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c07\u0c24\u0c30 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c41 \u0c35\u0c3e\u0c1f\u0c3f \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c4d\u0c30\u0c3e\u0c30\u0c4d\u0c32\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c1a\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c2e\u0c2f\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c28\u0c41\u0c38\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f. \u0c0e\u0c28\u0c4d\u200c\u0c30\u0c4b\u0c32\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c15\u0c4b\u0c30\u0c41\u0c15\u0c41\u0c28\u0c47 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c41\u0c32\u0c41/ \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d\u200c\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c02\u0c24 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c38\u0c2e\u0c40\u0c2a\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c35\u0c3e\u0c30\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c0e\u0c28\u0c4d\u200c\u0c30\u0c4b\u0c32\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c38\u0c46\u0c02\u0c1f\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41."},{question:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c02 (ASK) \u0c05\u0c02\u0c1f\u0c47 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c02\u2019 \u0c32\u0c47\u0c26\u0c3e ASK \u0c05\u0c28\u0c47\u0c26\u0c3f \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f\u0c24\u0c41\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c32\u0c15\u0c41 \u0c12\u0c15-\u0c38\u0c4d\u0c1f\u0c3e\u0c2a\u0c4d \u0c17\u0c2e\u0c4d\u0c2f\u0c02. ASK \u0c05\u0c24\u0c4d\u0c2f\u0c3e\u0c27\u0c41\u0c28\u0c3f\u0c15 \u0c35\u0c3e\u0c24\u0c3e\u0c35\u0c30\u0c23\u0c02\u0c32\u0c4b \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f\u0c24\u0c41\u0c32\u0c15\u0c41 \u0c05\u0c02\u0c15\u0c3f\u0c24\u0c2e\u0c48\u0c28 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c38\u0c47\u0c35\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c4b\u0c02\u0c26\u0c3f. \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c02 \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f\u0c24\u0c41\u0c32\u0c15\u0c41 \u0c38\u0c4c\u0c15\u0c30\u0c4d\u0c2f\u0c35\u0c02\u0c24\u0c2e\u0c48\u0c28 \u0c0e\u0c2f\u0c3f\u0c30\u0c4d \u0c15\u0c02\u0c21\u0c3f\u0c37\u0c28\u0c4d\u0c21\u0c4d \u0c35\u0c3e\u0c24\u0c3e\u0c35\u0c30\u0c23\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c05\u0c28\u0c4d\u0c28\u0c3f ASK\u0c32\u0c41 \u0c35\u0c40\u0c32\u0c4d\u200c\u0c1a\u0c48\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c05\u0c28\u0c41\u0c15\u0c42\u0c32\u0c2e\u0c48\u0c28\u0c35\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c43\u0c26\u0c4d\u0c27\u0c41\u0c32\u0c15\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c02\u0c17 \u0c35\u0c48\u0c15\u0c32\u0c4d\u0c2f\u0c02 \u0c09\u0c28\u0c4d\u0c28\u0c35\u0c3e\u0c30\u0c3f\u0c15\u0c3f \u0c38\u0c47\u0c35 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c47\u0c15 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c28\u0c41 \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f. ASK\u0c32 \u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f \u0c2e\u0c30\u0c3f\u0c02\u0c24 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f: uidai.gov.in \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d."},{question:"UIDAI ASK\u0c32 (\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c32\u0c41) \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e\u0c28\u0c41 \u0c28\u0c47\u0c28\u0c41 \u0c0e\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c17\u0c32\u0c28\u0c41?",answer:"\u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c2b\u0c02\u0c15\u0c4d\u0c37\u0c28\u0c32\u0c4d ASK\u0c32 \u0c0f\u0c15\u0c40\u0c15\u0c43\u0c24 \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f: \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30 \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e\n\u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c47 \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c41\u0c32\u0c41, \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c3e\u0c2b\u0c40\u0c38\u0c41\u0c32\u0c41, CSC, BSNL \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30 \u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35\u0c3e\u0c32\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c0e\u0c28\u0c4d\u200c\u0c30\u0c4b\u0c32\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c38\u0c46\u0c02\u0c1f\u0c30\u0c4d\u200c\u0c32\u0c15\u0c41 \u0c05\u0c26\u0c28\u0c02\u0c17\u0c3e \u0c08 ASK\u0c32\u0c41 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f."}],checkEnrolmentUpdateStatus:[{question:"\u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c28\u0c47\u0c28\u0c41 \u0c0f \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c17\u0c32\u0c28\u0c41?",answer:"\u0c08 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e, \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c21\u0c4d\u0c30\u0c38\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c1a\u0c47\u0c2f\u0c17\u0c32\u0c30\u0c41. \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c07\u0c24\u0c30 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c15\u0c4b\u0c38\u0c02, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c2e\u0c40\u0c2a\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f."}],checkAadhaarValidity:[{question:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c32\u0c47\u0c16 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c0e\u0c32\u0c3e \u0c2d\u0c3f\u0c28\u0c4d\u0c28\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f?",answer:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c32\u0c46\u0c1f\u0c30\u0c4d \u0c05\u0c28\u0c47\u0c26\u0c3f \u0c0e\u0c28\u0c4d\u200c\u0c30\u0c4b\u0c32\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d\u200c\u0c32\u0c15\u0c41 \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c32\u0c3e\u0c2e\u0c3f\u0c28\u0c47\u0c1f\u0c46\u0c21\u0c4d \u0c2a\u0c47\u0c2a\u0c30\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c2a\u0c24\u0c4d\u0c30\u0c02. \u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c05\u0c28\u0c47\u0c26\u0c3f PVC \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c2e\u0c28\u0c4d\u0c28\u0c3f\u0c15\u0c48\u0c28\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2c\u0c39\u0c41\u0c33 \u0c2d\u0c26\u0c4d\u0c30\u0c24\u0c3e \u0c32\u0c15\u0c4d\u0c37\u0c23\u0c3e\u0c32\u0c24\u0c4b \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c28\u0c41 \u0c24\u0c40\u0c38\u0c41\u0c15\u0c46\u0c33\u0c4d\u0c32\u0c21\u0c02 \u0c38\u0c41\u0c32\u0c2d\u0c02. \u0c06\u0c27\u0c3e\u0c30\u0c4d PVC \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c2e\u0c3e\u0c28\u0c02\u0c17\u0c3e \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f."}],lockUnlockAadhaar:[{question:"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c28\u0c3f \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32 \u0c15\u0c3e\u0c30\u0c23\u0c02\u0c17\u0c3e \u0c28\u0c3e \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c24\u0c3f\u0c30\u0c38\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \u0c26\u0c40\u0c28\u0c3f \u0c05\u0c30\u0c4d\u0c25\u0c02 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"\u0c2e\u0c40\u0c30\u0c41 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c05\u0c21\u0c4d\u0c30\u0c38\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c47 \u0c2a\u0c24\u0c4d\u0c30\u0c02 \u0c07\u0c32\u0c3e \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f:  \u2022 https://uidai.gov.in \u0c2a\u0c4d\u0c30\u0c15\u0c3e\u0c30\u0c02 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c2f\u0c4d\u0c2f\u0c47 \u0c2a\u0c24\u0c4d\u0c30\u0c02. \u2022 \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c2a\u0c24\u0c4d\u0c30\u0c02 \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f \u0c2a\u0c47\u0c30\u0c41 \u0c2e\u0c40\u0c26 \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f. \u2022 \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c02 \u0c05\u0c38\u0c32\u0c48\u0c28 \u0c2a\u0c24\u0c4d\u0c30\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c38\u0c4d\u0c2a\u0c37\u0c4d\u0c1f\u0c2e\u0c48\u0c28 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c15\u0c32\u0c30\u0c4d \u0c38\u0c4d\u0c15\u0c3e\u0c28\u0c4d\u200c\u0c17\u0c3e \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f.  \u0c2e\u0c40\u0c30\u0c41 \u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c35\u0c3e\u0c1f\u0c3f\u0c28\u0c3f \u0c05\u0c28\u0c41\u0c38\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c30\u0c28\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f."},{question:"\u0c06\u0c27\u0c3e\u0c30\u0c4d (UID) \u0c32\u0c3e\u0c15\u0c4d & \u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c05\u0c02\u0c1f\u0c47 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"\u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c41\u0c32\u0c15\u0c41, \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 \u0c21\u0c47\u0c1f\u0c3e \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2d\u0c26\u0c4d\u0c30\u0c24 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24 \u0c0e\u0c32\u0c4d\u0c32\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c42 \u0c2a\u0c4d\u0c30\u0c3e\u0c25\u0c2e\u0c3f\u0c15 \u0c06\u0c02\u0c26\u0c4b\u0c33\u0c28. \u0c05\u0c24\u0c28\u0c3f/\u0c06\u0c2e\u0c46 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2d\u0c26\u0c4d\u0c30\u0c24\u0c28\u0c41 \u0c2c\u0c32\u0c4b\u0c2a\u0c47\u0c24\u0c02 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f\u0c15\u0c3f \u0c28\u0c3f\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c23\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, UIDAI \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d (UID) \u0c32\u0c3e\u0c15\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c47 \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.   \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f UIDAI \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d www.myaadhaar.uidai.gov.in \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c32\u0c47\u0c26\u0c3e mAadhaar \u0c2f\u0c3e\u0c2a\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c05\u0c24\u0c28\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c06\u0c2e\u0c46 \u0c06\u0c27\u0c3e\u0c30\u0c4d (UID)\u0c28\u0c3f \u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41.  \u0c07\u0c32\u0c3e \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f \u0c2c\u0c2f\u0c4b\u0c2e\u0c46\u0c1f\u0c4d\u0c30\u0c3f\u0c15\u0c4d\u0c38\u0c4d, \u0c21\u0c46\u0c2e\u0c4b\u0c17\u0c4d\u0c30\u0c3e\u0c2b\u0c3f\u0c15\u0c4d & OTP \u0c2e\u0c4b\u0c21\u0c3e\u0c32\u0c3f\u0c1f\u0c40 \u0c15\u0c4b\u0c38\u0c02 UID, UID \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d & VID\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f \u0c0f \u0c35\u0c3f\u0c27\u0c2e\u0c48\u0c28 \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c32\u0c47\u0c30\u0c41. \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f UID\u0c28\u0c3f \u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c47 \u0c05\u0c24\u0c28\u0c41/\u0c06\u0c2e\u0c46 UIDAI \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d \u0c32\u0c47\u0c26\u0c3e mAadhaar \u0c2f\u0c3e\u0c2a\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c24\u0c3e\u0c1c\u0c3e VID\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c05\u0c32\u0c3e \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c06\u0c27\u0c3e\u0c30\u0c4d (UID)\u0c28\u0c3f \u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f UID, UID \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d & VID\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f \u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41."},{question:"\u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f UID\u0c28\u0c3f \u0c0e\u0c32\u0c3e \u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41?",answer:"UID\u0c28\u0c3f \u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f 16 \u0c05\u0c02\u0c15\u0c46\u0c32 VID \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c26\u0c3f \u0c2e\u0c41\u0c02\u0c26\u0c38\u0c4d\u0c24\u0c41 \u0c05\u0c35\u0c38\u0c30\u0c02. \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f VID\u0c28\u0c3f \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c02\u0c21\u0c15\u0c2a\u0c4b\u0c24\u0c47 SMS \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c32\u0c47\u0c26\u0c3e UIDAI \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d (www.myaadhaar.uidai.gov.in) \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c1c\u0c28\u0c30\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41. SMS \u0c38\u0c47\u0c35. UID \u0c1a\u0c3f\u0c35\u0c30\u0c3f 4 \u0c32\u0c47\u0c26\u0c3e 8 \u0c05\u0c02\u0c15\u0c46\u0c32 GVID \u0c38\u0c4d\u0c2a\u0c47\u0c38\u0c4d. 1947. Ex-GVID 1234\u0c15\u0c3f SMS \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f UIDAI \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d https://resident.uidai.gov.in/aadhaar-lockunlock \u0c28\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c1f\u0c4d\u0c2f\u0c3e\u0c2c\u0c4d \u0c15\u0c3f\u0c02\u0c26 \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41, \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c32\u0c3e\u0c15\u0c4d & \u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c38\u0c47\u0c35\u0c32\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. UID \u0c32\u0c3e\u0c15\u0c4d \u0c30\u0c47\u0c21\u0c3f\u0c2f\u0c4b \u0c2c\u0c1f\u0c28\u0c4d\u200c\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c41\u0c28\u0c3f, UID \u0c28\u0c02\u0c2c\u0c30\u0c4d, \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c2a\u0c47\u0c30\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c3f\u0c28\u0c4d \u0c15\u0c4b\u0c21\u0c4d\u200c\u0c28\u0c3f \u0c24\u0c3e\u0c1c\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c32\u0c4b \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c38\u0c3f, \u0c38\u0c46\u0c15\u0c4d\u0c2f\u0c42\u0c30\u0c3f\u0c1f\u0c40 \u0c15\u0c4b\u0c21\u0c4d\u200c\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. Send OTP\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c2c\u0c4d\u200c\u0c2e\u0c3f\u0c1f\u0c4d\u200c\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c2e\u0c40 UID \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c02\u0c17\u0c3e \u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f."},{question:"\u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f UID\u0c28\u0c3f \u0c0e\u0c32\u0c3e \u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41?",answer:"UID \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f \u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c24\u0c3e\u0c1c\u0c3e 16 \u0c05\u0c02\u0c15\u0c46\u0c32 VID\u0c28\u0c3f \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f 16 \u0c05\u0c02\u0c15\u0c46\u0c32 VID\u0c28\u0c3f \u0c2e\u0c30\u0c1a\u0c3f\u0c2a\u0c4b\u0c2f\u0c3f\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47 \u0c05\u0c24\u0c28\u0c41 SMS \u0c38\u0c47\u0c35\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c24\u0c3e\u0c1c\u0c3e VID\u0c28\u0c3f \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c35\u0c1a\u0c4d\u0c1a\u0c41. RVID \u0c38\u0c4d\u0c2a\u0c47\u0c38\u0c4d UID \u0c1a\u0c3f\u0c35\u0c30\u0c3f 4 \u0c32\u0c47\u0c26\u0c3e 8 \u0c05\u0c02\u0c15\u0c46\u0c32\u0c41. 1947\u0c15\u0c3f SMS \u0c1a\u0c47\u0c2f\u0c35\u0c32\u0c46\u0c28\u0c41. Ex- RVID 1234. UID\u0c28\u0c3f \u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f UIDAI \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d\u200c\u0c28\u0c41 \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41 https://resident.uidai.gov.in/aadhaar-lockunlock , \u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c30\u0c47\u0c21\u0c3f\u0c2f\u0c4b \u0c2c\u0c1f\u0c28\u0c4d\u200c\u0c28\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c41\u0c28\u0c3f, \u0c24\u0c3e\u0c1c\u0c3e VID \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2d\u0c26\u0c4d\u0c30\u0c24\u0c3e \u0c15\u0c4b\u0c21\u0c4d\u200c\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c38\u0c3f, Send OTP\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c3f, \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c41\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c2e\u0c40 UID \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c02\u0c17\u0c3e \u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f \u0c15\u0c42\u0c21\u0c3e mAadhaar \u0c2f\u0c3e\u0c2a\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c32\u0c3e\u0c15\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c38\u0c47\u0c35\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41."}],grievanceAndFeedback:[],generateOrRetrieveVid:[{question:"\u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3e VID\u0c28\u0c3f \u0c2e\u0c30\u0c4d\u0c1a\u0c3f\u0c2a\u0c4b\u0c2f\u0c3e\u0c28\u0c41. UID\u0c28\u0c3f \u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c28\u0c47\u0c28\u0c41 \u0c26\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c32\u0c3e \u0c2a\u0c4a\u0c02\u0c26\u0c17\u0c32\u0c28\u0c41?",answer:"\u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f VID\u0c28\u0c3f \u0c2e\u0c30\u0c1a\u0c3f\u0c2a\u0c4b\u0c2f\u0c3f\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47 UID\u0c28\u0c3f \u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f 16 \u0c05\u0c02\u0c15\u0c46\u0c32 VID\u0c28\u0c3f \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f SMS \u0c38\u0c47\u0c35\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f \u0c05\u0c24\u0c28\u0c3f/\u0c06\u0c2e\u0c46 \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c32\u0c4b VID\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c3e\u0c30\u0c41. \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c28\u0c41\u0c02\u0c21\u0c3f 1947\u0c15\u0c3f SMS \u0c2a\u0c02\u0c2a\u0c02\u0c21\u0c3f.  RVID \u0c38\u0c4d\u0c2a\u0c47\u0c38\u0c4d UID \u0c1a\u0c3f\u0c35\u0c30\u0c3f 4 \u0c32\u0c47\u0c26\u0c3e 8 \u0c05\u0c02\u0c15\u0c46\u0c32\u0c41. \u0c09\u0c26\u0c3e:- RVID 1234'"},{question:"\u0c35\u0c30\u0c4d\u0c1a\u0c41\u0c35\u0c32\u0c4d ID (VID) \u0c05\u0c02\u0c1f\u0c47 \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f?",answer:"VID \u0c05\u0c28\u0c47\u0c26\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c24\u0c4b \u0c2e\u0c4d\u0c2f\u0c3e\u0c2a\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c24\u0c3e\u0c24\u0c4d\u0c15\u0c3e\u0c32\u0c3f\u0c15, \u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c17\u0c32 16-\u0c05\u0c02\u0c15\u0c46\u0c32 \u0c2f\u0c3e\u0c26\u0c43\u0c1a\u0c4d\u0c1b\u0c3f\u0c15 \u0c38\u0c02\u0c16\u0c4d\u0c2f. \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c32\u0c47\u0c26\u0c3e e-KYC \u0c38\u0c47\u0c35\u0c32\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c32\u0c4d\u0c32\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c2c\u0c26\u0c41\u0c32\u0c41\u0c17\u0c3e VID\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c47 \u0c2a\u0c26\u0c4d\u0c27\u0c24\u0c3f\u0c32\u0c4b VID\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f \u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41. VID \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c21\u0c02 \u0c38\u0c3e\u0c27\u0c4d\u0c2f\u0c02 \u0c15\u0c3e\u0c26\u0c41."},{question:"\u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f VID\u0c28\u0c3f \u0c0e\u0c32\u0c3e \u0c2a\u0c4a\u0c02\u0c26\u0c41\u0c24\u0c3e\u0c21\u0c41?",answer:"VID \u0c05\u0c28\u0c47\u0c26\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c30\u0c42\u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c35\u0c3e\u0c30\u0c41 \u0c24\u0c2e VID\u0c28\u0c3f \u0c0e\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c2d\u0c30\u0c4d\u0c24\u0c40 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41 (\u0c15\u0c4a\u0c24\u0c4d\u0c24 VID\u0c28\u0c3f \u0c30\u0c42\u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41). \u0c0f \u0c38\u0c2e\u0c2f\u0c02\u0c32\u0c4b\u0c28\u0c48\u0c28\u0c3e \u0c12\u0c15 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c12\u0c15 VID \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. UIDAI \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c35\u0c3f\u0c35\u0c3f\u0c27 \u0c0e\u0c02\u0c2a\u0c3f\u0c15\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d\u200c\u0c32\u0c41 \u0c35\u0c3e\u0c30\u0c3f VID\u0c28\u0c3f \u0c30\u0c42\u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c35\u0c3e\u0c30\u0c41 \u0c2e\u0c30\u0c4d\u0c1a\u0c3f\u0c2a\u0c4b\u0c24\u0c47 \u0c35\u0c3e\u0c30\u0c3f VID\u0c28\u0c3f \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3e\u0c30\u0c3f VID\u0c28\u0c3f \u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c24\u0c4b \u0c2d\u0c30\u0c4d\u0c24\u0c40 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c08 \u0c0e\u0c02\u0c2a\u0c3f\u0c15\u0c32\u0c41 UIDAI \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d (www.myaadhaar.uidai.gov.in) , eAadhaar \u0c21\u0c4c\u0c28\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d, mAadhaar \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f. \u0c05\u0c2a\u0c4d\u0c32\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d, \u0c2e\u0c4a\u0c26\u0c32\u0c48\u0c28\u0c35\u0c3f.   \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c39\u0c46\u0c32\u0c4d\u0c2a\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d 1947\u0c15\u0c3f SMS \u0c2a\u0c02\u0c2a\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c15\u0c42\u0c21\u0c3e VID\u0c28\u0c3f \u0c30\u0c42\u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f \u201cGVID\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c1a\u0c3f\u0c35\u0c30\u0c3f 4 \u0c05\u0c02\u0c15\u0c46\u0c32\u0c41\u201d \u0c05\u0c28\u0c3f \u0c1f\u0c48\u0c2a\u0c4d \u0c1a\u0c47\u0c38\u0c3f, \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e 1947\u0c15\u0c3f \u0c2a\u0c02\u0c2a\u0c3e\u0c32\u0c3f."},{question:"\u0c28\u0c3e \u0c15\u0c4b\u0c38\u0c02 \u0c0e\u0c35\u0c30\u0c48\u0c28\u0c3e VID\u0c28\u0c3f \u0c30\u0c42\u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c17\u0c32\u0c30\u0c3e?",answer:"AUA/KUA \u0c35\u0c02\u0c1f\u0c3f \u0c0f \u0c07\u0c24\u0c30 \u0c38\u0c02\u0c38\u0c4d\u0c25 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c24\u0c30\u0c2a\u0c41\u0c28 VID\u0c28\u0c3f \u0c30\u0c42\u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c26\u0c41. VID\u0c28\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c17\u0c3e/\u0c06\u0c2e\u0c46 \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c17\u0c3e \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c30\u0c42\u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c17\u0c32\u0c30\u0c41. \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c15\u0c41 SMS \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e VID\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c3e\u0c30\u0c41."},{question:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d VID\u0c28\u0c3f \u0c2e\u0c30\u0c1a\u0c3f\u0c2a\u0c4b\u0c24\u0c47 \u0c0f\u0c2e\u0c3f \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c3f? \u0c05\u0c24\u0c28\u0c41/\u0c06\u0c2e\u0c46 \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4a\u0c02\u0c26\u0c17\u0c32\u0c30\u0c3e?",answer:"\u0c05\u0c35\u0c41\u0c28\u0c41, UIDAI \u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c2e\u0c30\u0c3f\u0c2f\u0c41/\u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24 VID\u0c28\u0c3f \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c28\u0c47\u0c15 \u0c2e\u0c3e\u0c30\u0c4d\u0c17\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c08 \u0c0e\u0c02\u0c2a\u0c3f\u0c15\u0c32\u0c41 UIDAI \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d (www.myaadhaar.uidai.gov.in) , eAadhaar, mAadhaar \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c05\u0c2a\u0c4d\u0c32\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d, SMS \u0c2e\u0c4a\u0c26\u0c32\u0c48\u0c28 \u0c35\u0c3e\u0c1f\u0c3f \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c1a\u0c2c\u0c21\u0c4d\u0c21\u0c3e\u0c2f\u0c3f. VID\u0c28\u0c3f \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c21\u0c02 \u0c15\u0c4b\u0c38\u0c02, \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c39\u0c46\u0c32\u0c4d\u0c2a\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d 1947\u0c15\u0c3f SMS \u0c2a\u0c02\u0c2a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f \u201cRVID \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c32\u0c4b\u0c28\u0c3f \u0c1a\u0c3f\u0c35\u0c30\u0c3f 4 \u0c05\u0c02\u0c15\u0c46\u0c32\u0c41\u201d \u0c05\u0c28\u0c3f \u0c1f\u0c48\u0c2a\u0c4d \u0c1a\u0c47\u0c38\u0c3f, \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e 1947\u0c15\u0c3f \u0c2a\u0c02\u0c2a\u0c3e\u0c32\u0c3f."},{question:"VID\u0c28\u0c3f OTP \u0c32\u0c47\u0c26\u0c3e \u0c2c\u0c2f\u0c4b\u0c2e\u0c46\u0c1f\u0c4d\u0c30\u0c3f\u0c15\u0c4d\u0c38\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c21\u0c46\u0c2e\u0c4b\u0c17\u0c4d\u0c30\u0c3e\u0c2b\u0c3f\u0c15\u0c4d\u0c38\u0c4d \u0c05\u0c25\u0c46\u0c02\u0c1f\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c3e?",answer:"\u0c05\u0c35\u0c41\u0c28\u0c41. \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c2c\u0c26\u0c41\u0c32\u0c41\u0c17\u0c3e VID\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41."},{question:"VID \u0c35\u0c3f\u0c37\u0c2f\u0c02\u0c32\u0c4b, \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c15\u0c4b\u0c38\u0c02 \u0c28\u0c47\u0c28\u0c41 \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3e?",answer:"\u0c05\u0c35\u0c41\u0c28\u0c41, VID \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c15\u0c4b\u0c38\u0c02 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f \u0c05\u0c35\u0c38\u0c30\u0c02. \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c09\u0c26\u0c4d\u0c26\u0c47\u0c36\u0c4d\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c0f\u0c1c\u0c46\u0c28\u0c4d\u0c38\u0c40 \u0c24\u0c46\u0c32\u0c3f\u0c2f\u0c1c\u0c47\u0c2f\u0c3e\u0c32\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c4d\u0c2a\u0c37\u0c4d\u0c1f\u0c2e\u0c48\u0c28 \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c28\u0c3f \u0c38\u0c47\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f."},{question:"\u0c0f\u0c1c\u0c46\u0c28\u0c4d\u0c38\u0c40 VID\u0c28\u0c3f \u0c28\u0c3f\u0c32\u0c4d\u0c35 \u0c1a\u0c47\u0c2f\u0c17\u0c32\u0c26\u0c3e?",answer:"\u0c32\u0c47\u0c26\u0c41. VID \u0c24\u0c3e\u0c24\u0c4d\u0c15\u0c3e\u0c32\u0c3f\u0c15\u0c2e\u0c48\u0c28\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41 \u0c15\u0c3e\u0c2c\u0c1f\u0c4d\u0c1f\u0c3f, VID\u0c28\u0c3f \u0c28\u0c3f\u0c32\u0c4d\u0c35 \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c35\u0c3f\u0c32\u0c41\u0c35\u0c28\u0c41 \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c02\u0c21\u0c26\u0c41. \u0c0f\u0c1c\u0c46\u0c28\u0c4d\u0c38\u0c40\u0c32\u0c41 VID\u0c28\u0c3f \u0c0f \u0c21\u0c47\u0c1f\u0c3e\u0c2c\u0c47\u0c38\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c32\u0c3e\u0c17\u0c4d\u200c\u0c32\u0c32\u0c4b \u0c28\u0c3f\u0c32\u0c4d\u0c35 \u0c1a\u0c47\u0c2f\u0c15\u0c42\u0c21\u0c26\u0c41."},{question:"VID \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c30\u0c40-\u0c1c\u0c28\u0c30\u0c47\u0c37\u0c28\u0c4d \u0c05\u0c26\u0c47 VID\u0c15\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c35\u0c47\u0c30\u0c47 VID\u0c15\u0c3f \u0c26\u0c3e\u0c30\u0c3f\u0c24\u0c40\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3e?",answer:"\u0c15\u0c28\u0c40\u0c38 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c35\u0c4d\u0c2f\u0c35\u0c27\u0c3f \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 (\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02 1 \u0c15\u0c4d\u0c2f\u0c3e\u0c32\u0c46\u0c02\u0c21\u0c30\u0c4d \u0c30\u0c4b\u0c1c\u0c41\u0c17\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c05\u0c30\u0c4d\u0c27\u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f 12 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c38\u0c46\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f), \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c15\u0c4a\u0c24\u0c4d\u0c24 VID \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c2a\u0c41\u0c28\u0c30\u0c41\u0c24\u0c4d\u0c2a\u0c24\u0c4d\u0c24\u0c3f\u0c28\u0c3f \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c08 \u0c35\u0c3f\u0c27\u0c02\u0c17\u0c3e, \u0c15\u0c4a\u0c24\u0c4d\u0c24 VID \u0c09\u0c24\u0c4d\u0c2a\u0c24\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c41\u0c28\u0c41\u0c2a\u0c1f\u0c3f VID \u0c28\u0c3f\u0c37\u0c4d\u0c15\u0c4d\u0c30\u0c3f\u0c2f\u0c02 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.  \u0c12\u0c15\u0c35\u0c47\u0c33, \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f VID\u0c28\u0c3f \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c21\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c47, \u0c1a\u0c3f\u0c35\u0c30\u0c3f\u0c17\u0c3e \u0c15\u0c4d\u0c30\u0c3f\u0c2f\u0c3e\u0c36\u0c40\u0c32\u0c02\u0c17\u0c3e \u0c09\u0c28\u0c4d\u0c28 VID \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d\u200c\u0c15\u0c41 SMS \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c02\u0c2a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f 'RVID \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c1a\u0c3f\u0c35\u0c30\u0c3f 4 \u0c05\u0c02\u0c15\u0c46\u0c32\u0c41' \u0c05\u0c28\u0c3f \u0c1f\u0c48\u0c2a\u0c4d \u0c1a\u0c47\u0c38\u0c3f, \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e 1947\u0c15\u0c3f \u0c2a\u0c02\u0c2a\u0c3e\u0c32\u0c3f."}],checkGrievanceFeedbackStatus:[{question:"VID \u0c17\u0c21\u0c41\u0c35\u0c41 \u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c3e\u0c32\u0c02 \u0c0e\u0c02\u0c24?",answer:"\u0c08 \u0c38\u0c2e\u0c2f\u0c02\u0c32\u0c4b VID \u0c15\u0c4b\u0c38\u0c02 \u0c0e\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c17\u0c21\u0c41\u0c35\u0c41 \u0c35\u0c4d\u0c2f\u0c35\u0c27\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c1a\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41. \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c15\u0c4a\u0c24\u0c4d\u0c24 VID\u0c28\u0c3f \u0c30\u0c42\u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c47 \u0c35\u0c30\u0c15\u0c41 VID \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f."}]}}},ur_IN:{translation:{dashboard:{header:{title:"\u0645\u06cc\u0631\u0627 \u0622\u062f\u06be\u0627\u0631",profile:{aadhaarTagLine:"\u0645\u06cc\u0631\u0627 \u0622\u062f\u06be\u0627\u0631 \u060c \u0645\u06cc\u0631\u06cc \u067e\u06c1\u0686\u0627\u0646",clickToFlip:"\u0622\u062f\u06be\u0627\u0631 \u06a9\u0627\u0631\u0688 \u067e\u0644\u0679\u0627\u0626\u06cc\u06ba",logOut:"\u0644\u0627\u06af \u0622\u0648\u0679"}},services:{title:"\u062e\u062f\u0645\u0627\u062a",description:"\u0622\u0646 \u0644\u0627\u0626\u0646 \u0622\u062f\u06be\u0627\u0631 \u062e\u062f\u0645\u0627\u062a \u06a9\u06d2 \u0645\u0646\u062f