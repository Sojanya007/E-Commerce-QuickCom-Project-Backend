0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",radioLabels:{uid:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c02\u0c16\u0c4d\u0c2f",eid:"\u0c28\u0c2e\u0c4b\u0c26\u0c41 ID \u0c38\u0c02\u0c16\u0c4d\u0c2f"},textFields:{uid:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",eid:"14 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",generic:"\u0c0e\u0c28\u0c4d \u0c30\u0c4b\u0c32\u0c4d \u0c2e\u0c46\u0c02\u0c1f\u0c4d \u0c10\u0c21\u0c3f \u0c32\u0c47\u0c26\u0c3e SRN \u0c32\u0c47\u0c26\u0c3e URN \u0c0e\u0c02\u0c1f\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",mobile:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",otp:"OTP \u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",securityCode:"\u0c15\u0c3e\u0c2a\u0c4d\u0c1a\u0c3e \u0c0e\u0c02\u0c1f\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f"},checkBox:{mobile:"\u0c28\u0c3e \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c38\u0c02\u0c16\u0c4d\u0c2f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c15\u0c3e\u0c32\u0c47\u0c26\u0c41",tnc:"\u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c37\u0c30\u0c24\u0c41\u0c32\u0c41"},button:{otp:"OTP \u0c2a\u0c02\u0c2a\u0c02\u0c21\u0c3f",submit:"\u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c2e\u0c28\u0c35\u0c3f \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f "},modal:{mobile:"\u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2e\u0c40 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c24\u0c4b \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c24\u0c47, \u0c2e\u0c48 \u0c06\u0c27\u0c3e\u0c30\u0c4d (myaadhaar.uidai.gov.in) \u0c15\u0c41 \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c05\u0c35\u0c4d\u0c35\u0c2e\u0c28\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c3f\u0c35\u0c3f\u0c38\u0c3f \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41 \u0c15\u0c4b\u0c38\u0c02 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c07\u0c35\u0c4d\u0c35\u0c2e\u0c28\u0c3f \u0c2e\u0c47\u0c2e\u0c41 \u0c2e\u0c3f\u0c2e\u0c4d\u0c2e\u0c32\u0c4d\u0c28\u0c3f \u0c38\u0c42\u0c1a\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c2e\u0c41",tnc:{heading:"OAC \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c32\u0c4d\u200c\u0c32\u0c4b \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c06\u0c2e\u0c4b\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 '\u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 & \u0c37\u0c30\u0c24\u0c41\u0c32\u0c41' ",t1:"\u0c28\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2a\u0c3f\u0c35\u0c3f\u0c38\u0c3f \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41 \u0c2e\u0c41\u0c26\u0c4d\u0c30\u0c23\u0c15\u0c41 \u0c28\u0c3e \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c28\u0c3f \u0c07\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41.",t2:"\u0c2e\u0c41\u0c26\u0c4d\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c28\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2a\u0c3f\u0c35\u0c3f\u0c38\u0c3f \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41 \u0c28\u0c3e \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c32\u0c4b \u0c2c\u0c1f\u0c4d\u0c35\u0c3e\u0c21\u0c3e \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c28\u0c3f \u0c28\u0c47\u0c28\u0c41 \u0c05\u0c30\u0c4d\u0c25\u0c02 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41, \u0c06\u0c27\u0c3e\u0c30\u0c4d\u200c\u0c32\u0c4b \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c2a\u0c3f\u0c28\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c30\u0c48\u0c28\u0c26\u0c3f.",t3:"\u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2a\u0c3f\u0c35\u0c3f\u0c38\u0c3f \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c47\u0c35 \u0c15\u0c4b\u0c38\u0c02 \u0c30\u0c42 .50 / - ( \u0c1c\u0c3f\u0c0e\u0c38\u0c4d\u0c1f\u0c3f)\u0c24\u0c4b \u0c38\u0c39\u0c3e \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c28\u0c47\u0c28\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41.",t4:"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2a\u0c3f\u0c35\u0c3f\u0c38\u0c3f \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41 \u0c35\u0c3e\u0c30\u0c3f \u0c21\u0c46\u0c32\u0c3f\u0c35\u0c30\u0c40 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c15\u0c41 \u0c05\u0c28\u0c41\u0c17\u0c41\u0c23\u0c02\u0c17\u0c3e \u0c07\u0c02\u0c21\u0c3f\u0c2f\u0c3e \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c38\u0c4d\u0c2a\u0c40\u0c21\u0c4d \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c38\u0c47\u0c35 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c02\u0c2a\u0c3f\u0c23\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c28\u0c3f \u0c28\u0c47\u0c28\u0c41 \u0c05\u0c30\u0c4d\u0c25\u0c02 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41. \u0c07\u0c02\u0c21\u0c3f\u0c2f\u0c3e \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c38\u0c4d\u0c1f\u0c47\u0c1f\u0c38\u0c4d \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c38\u0c47\u0c35\u0c32\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f \u0c21\u0c46\u0c32\u0c3f\u0c35\u0c30\u0c40 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41."}}},payment:{welcomeText:"\u0c2a\u0c4d\u0c30\u0c3f\u0c2f\u0c2e\u0c48\u0c28 \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f, ",srnInfo:"\u0c2e\u0c40 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 SRN # \u0c24\u0c4b \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f.",trackInfo:"\u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 UIDAI \u0c24\u0c4b \u0c05\u0c28\u0c41\u0c30\u0c42\u0c2a\u0c4d\u0c2f\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c08 \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",paymentText:"\u0c2a\u0c3f\u0c35\u0c3f\u0c38\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41 \u0c15\u0c4b\u0c38\u0c02 \u0c2e\u0c40\u0c15\u0c41 \u0c30\u0c42 .50 / - (\u0c1c\u0c40\u0c0e\u0c38\u0c4d\u0c1f\u0c40 & \u0c38\u0c4d\u0c2a\u0c40\u0c21\u0c4d \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32\u0c24\u0c4b \u0c38\u0c39\u0c3e) \u0c35\u0c38\u0c42\u0c32\u0c41 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",redirectInfo:" \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f \u0c2c\u0c1f\u0c28\u0c4d\u200c\u0c28\u0c41 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41, \u0c2e\u0c40\u0c30\u0c41 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c4b\u0c38\u0c02 PayU \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c17\u0c47\u0c1f\u0c4d\u200c\u0c35\u0c47\u0c15\u0c3f \u0c2e\u0c33\u0c4d\u0c33\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c30\u0c41. \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c2e\u0c48\u0c28 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41\u0c32\u0c4b, \u0c30\u0c38\u0c40\u0c26\u0c41 \u0c38\u0c4d\u0c32\u0c3f\u0c2a\u0c4d \u0c21\u0c4c\u0c28\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c2e\u0c40\u0c30\u0c41 \u0c08 \u0c2a\u0c47\u0c1c\u0c40\u0c15\u0c3f \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c2e\u0c33\u0c4d\u0c33\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c30\u0c41. \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c2b\u0c32\u0c2e\u0c48\u0c24\u0c47, \u0c2e\u0c40\u0c30\u0c41 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41\u0c28\u0c41 \u0c05\u0c28\u0c47\u0c15\u0c38\u0c3e\u0c30\u0c4d\u0c32\u0c41 \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",button:{cancel:"\u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",makePayment:"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f"}}},status:{srnField:"\u0c0e\u0c38\u0c4d.\u0c06\u0c30\u0c4d.\u0c0e\u0c28\u0c4d \u0c0e\u0c02\u0c1f\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",table:{srn:"\u0c0e\u0c38\u0c4d\u0c06\u0c30\u0c4d\u0c0e\u0c28\u0c4d",orderDate:"\u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c24\u0c47\u0c26\u0c40",currentStatus:"\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f",awb:"\u0c0e\u0c2f\u0c3f\u0c30\u0c4d \u0c35\u0c47 \u0c2c\u0c3f\u0c32\u0c4d \u0c28\u0c46\u0c02\u0c2c\u0c30\u0c41",dispatchDate:"\u0c2c\u0c1f\u0c4d\u0c35\u0c3e\u0c21\u0c3e \u0c24\u0c47\u0c26\u0c40",awb_subText:"\u0c2a\u0c48 \u0c28\u0c46\u0c02\u0c2c\u0c30\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f 'www.indiapost.gov.in' \u0c35\u0c26\u0c4d\u0c26 \u0c2e\u0c40\u0c30\u0c41 \u0c2e\u0c40 \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c28\u0c3f \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",demographic:"\u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c15\u0c3e\u0c30\u0c23\u0c3e\u0c32 \u0c35\u0c32\u0c4d\u0c32, \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c21\u0c46\u0c2e\u0c4b\u0c17\u0c4d\u0c30\u0c3e\u0c2b\u0c3f\u0c15\u0c4d\u0c38\u0c4d \u0c21\u0c47\u0c1f\u0c3e\u0c28\u0c41 \u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30\u0c02\u0c32\u0c4b \u0c35\u0c46\u0c32\u0c4d\u0c32\u0c21\u0c3f\u0c02\u0c1a\u0c32\u0c47\u0c2e\u0c41. \u0c05\u0c2f\u0c3f\u0c24\u0c47, \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c4d\u0c21 \u0c2a\u0c3f\u0c35\u0c3f\u0c38\u0c3f \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32\u0c4b \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c24\u0c3e\u0c1c\u0c3e \u0c21\u0c46\u0c2e\u0c4b\u0c17\u0c4d\u0c30\u0c3e\u0c2b\u0c3f\u0c15\u0c4d\u0c38\u0c4d \u0c21\u0c47\u0c1f\u0c3e \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f."}}},aadharStatus:{title:"\u0c28\u0c2e\u0c4b\u0c26\u0c41 & \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",description:{one:"\u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c1c\u0c46\u0c28\u0c46\u0c30\u0c47\u0c1f\u0c4d/\u0c05\u0c2a\u0c4d\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c4b \u0c32\u0c47\u0c26\u0c4b \u0c2a\u0c30\u0c3f\u0c36\u0c40\u0c32\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f .",twoEID:"\u0c28\u0c2e\u0c4b\u0c26\u0c41 / \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c15\u0c4b\u0c38\u0c02 \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2d\u0c4c\u0c24\u0c3f\u0c15\u0c02\u0c17\u0c3e \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c36\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c30\u0c38\u0c40\u0c26\u0c41 \u0c38\u0c4d\u0c32\u0c3f\u0c2a\u0c4d\u200c\u0c2a\u0c48 \u0c2e\u0c41\u0c26\u0c4d\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 14 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c38\u0c02\u0c16\u0c4d\u0c2f \u0c28\u0c2e\u0c42\u0c28\u0c3e: 1234/12345/12345",twoSRN:"'S' \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 13 \u0c05\u0c02\u0c15\u0c46\u0c32\u0c41, \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c47\u0c1f\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c30\u0c38\u0c40\u0c26\u0c41 \u0c38\u0c4d\u0c32\u0c3f\u0c2a\u0c4d\u200c\u0c2a\u0c48 \u0c2e\u0c41\u0c26\u0c4d\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f",twoURN:"8 \u0c05\u0c02\u0c15\u0c46\u0c32 URN, 'mAadhaar' \u0c05\u0c2a\u0c4d\u0c32\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c47\u0c1f\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c30\u0c38\u0c40\u0c26\u0c41 \u0c38\u0c4d\u0c32\u0c3f\u0c2a\u0c4d\u200c\u0c2a\u0c48 \u0c2e\u0c41\u0c26\u0c4d\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c35\u0c41\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f \u0c28\u0c2e\u0c42\u0c28\u0c3e: 12345678",twoSID:"\u2018S\u2019 followed by 27 digits, printed on acknowledgement slip while physically visiting Enrolment / Update center. Sample: S123456789123456789123456789",three:"\u0c12\u0c15\u0c35\u0c47\u0c33 \u0c2e\u0c40\u0c30\u0c41 EID \u0c28\u0c3f \u0c15\u0c4b\u0c32\u0c4d\u0c2a\u0c4b\u0c2f\u0c3f\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47, \u0c2e\u0c40\u0c30\u0c41 \u0c2e\u0c40 \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c15\u0c4b\u0c32\u0c4d\u0c2a\u0c4b\u0c2f\u0c3f\u0c28 \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c30\u0c4d\u0c1a\u0c3f\u0c2a\u0c4b\u0c2f\u0c3f\u0c28 EID \u0c28\u0c3f \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c35\u0c1a\u0c4d\u0c1a\u0c41."},optionalMessage:"\u0c30\u0c38\u0c40\u0c26\u0c41 \u0c38\u0c4d\u0c32\u0c3f\u0c2a\u0c4d \u0c2a\u0c4d\u0c30\u0c15\u0c3e\u0c30\u0c02 \u0c24\u0c47\u0c26\u0c40 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c2e\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c02\u0c21\u0c3f (<b>\u0c10\u0c1a\u0c4d\u0c1b\u0c3f\u0c15\u0c02</b>)"},complaintStatus:{title:"\u0c17\u0c4d\u0c30\u0c40\u0c35\u0c46\u0c28\u0c4d\u0c38\u0c4d / \u0c2b\u0c40\u0c21\u0c4d\u200c\u0c2c\u0c4d\u0c2f\u0c3e\u0c15\u0c4d \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",form:{complaintNumber:"\u0c38\u0c47\u0c35\u0c3e \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",QRCid:"Qrc Id",status:"\u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f",ComplaintNumber:"\u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41 / \u0c2b\u0c40\u0c21\u0c4d\u200c\u0c2c\u0c4d\u0c2f\u0c3e\u0c15\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d",ResolutionResponse:"\u0c30\u0c3f\u0c1c\u0c32\u0c4d\u0c2f\u0c42\u0c37\u0c28\u0c4d \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c28"}},fileComplaint:{title:"\u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c2d\u0c3f\u0c2a\u0c4d\u0c30\u0c3e\u0c2f\u0c02",description:"\u0c2e\u0c40 \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c2d\u0c3f\u0c2a\u0c4d\u0c30\u0c3e\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2b\u0c48\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",disclaimer:"\u0c06\u0c27\u0c3e\u0c30\u0c4d, \u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23\u0c02\u0c17\u0c3e \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c47 \u0c21\u0c3f\u0c1c\u0c3f\u0c1f\u0c32\u0c4d \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41\u0c17\u0c3e, \u0c05\u0c28\u0c47\u0c15 \u0c38\u0c2c\u0c4d\u0c38\u0c3f\u0c21\u0c40\u0c32\u0c41, \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c47\u0c35\u0c32\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c47\u0c02\u0c26\u0c41\u0c15\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c07\u0c26\u0c47 \u0c26\u0c43\u0c37\u0c4d\u0c1f\u0c4d\u0c2f\u0c3e, \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c21\u0c47\u0c1f\u0c3e\u0c2c\u0c47\u0c38\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c24\u0c4d\u0c35\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, UIDAI \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c15\u0c38\u0c30\u0c24\u0c4d\u0c24\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c3f\u0c02\u0c26\u0c3f. \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c21\u0c47\u0c1f\u0c3e\u0c2c\u0c47\u0c38\u0c4d\u200c\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d\u200c\u0c17\u0c3e \u0c09\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c1a\u0c47\u0c2a\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32\u0c32\u0c4b, \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d\u200c\u0c32\u0c15\u0c41 \u0c0e\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c1c\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c26\u0c40\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \u0c0e\u0c32\u0c3e\u0c02\u0c1f\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c32\u0c47\u0c26\u0c28\u0c3f \u0c38\u0c4d\u0c2a\u0c37\u0c4d\u0c1f\u0c02 \u0c1a\u0c47\u0c38\u0c3f\u0c02\u0c26\u0c3f. \u0c0e\u0c35\u0c30\u0c48\u0c28\u0c3e \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c08 \u0c35\u0c3f\u0c37\u0c2f\u0c02\u0c32\u0c4b \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41 \u0c09\u0c02\u0c1f\u0c47, \u0c35\u0c3e\u0c30\u0c41 \u0c24\u0c2e \u0c05\u0c2d\u0c3f\u0c2a\u0c4d\u0c30\u0c3e\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c05\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41 \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c09\u0c02\u0c1f\u0c47 \u0c24\u0c17\u0c3f\u0c28 \u0c35\u0c3f\u0c27\u0c02\u0c17\u0c3e \u0c2a\u0c30\u0c3f\u0c37\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",form:{heading:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",state:"\u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",enquirer:"\u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41\u0c32\u0c41 / \u0c05\u0c2d\u0c3f\u0c2a\u0c4d\u0c30\u0c3e\u0c2f\u0c02 (\u0c38\u0c4d\u0c35\u0c40\u0c2f/\u0c07\u0c24\u0c30\u0c41\u0c32\u0c41)",complaintType:"\u0c17\u0c4d\u0c30\u0c40\u0c35\u0c46\u0c28\u0c4d\u0c38\u0c4d / \u0c2b\u0c40\u0c21\u0c4d\u200c\u0c2c\u0c4d\u0c2f\u0c3e\u0c15\u0c4d \u0c30\u0c15\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",categoryType:"\u0c35\u0c30\u0c4d\u0c17\u0c02 \u0c30\u0c15\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",uploadDocumentLabel:"\u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f & \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f (\u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c09\u0c02\u0c1f\u0c47)",statusField:"EID / SRN / URN \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",placeholder:"\u0c2a\u0c4d\u0c30\u0c3f\u0c2f\u0c2e\u0c48\u0c28 \u0c28\u0c3f\u0c35\u0c3e\u0c38\u0c3f, \u0c2e\u0c40 \u0c06\u0c02\u0c26\u0c4b\u0c33\u0c28\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c