907\u0932 \u0928\u0902\u092c\u0930 \u0906\u0927\u093e\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0939\u094b\u0928\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964",description2:"",description3:"",loginCard:{loginText:"\u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0947\u0902\u0964",desc:"\u0906\u0927\u093e\u0930 \u0914\u0930 \u0913\u091f\u0940\u092a\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0947\u0902"},services:{description:"\u092f\u0926\u093f \u0906\u092a\u0915\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0906\u0927\u093e\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u093e \u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0935\u093f\u0936\u094d\u0935 \u0915\u0947 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0947 \u092a\u0939\u091a\u093e\u0928 \u092e\u0902\u091a \u092e\u0947\u0902 \u0905\u092a\u0928\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u093e\u092f\u093e \u0939\u0948, \u0924\u092c \u092d\u0940 \u0906\u092a \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",GenericDescription:"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0906\u0927\u093e\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0902 \u0939\u094b\u0928\u0947 \u092a\u0930 \u092d\u0940 \u091c\u093f\u0928 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u093e \u0932\u093e\u092d \u0909\u0920\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948",MobileDescription:"\u091c\u093f\u0928 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u0927\u093e\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0939\u094b\u0928\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948",MoblieNotRegistered:"\u092e\u094b\u092c\u093e\u0907\u0932 \u0906\u0927\u093e\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948?",StepsToRegisterText:"\u0915\u0943\u092a\u092f\u093e \u0907\u0938\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u0930\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0928 \u091a\u0930\u0923\u094b\u0902 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0947\u0902\u0964",AadhaarEnrolmentUpdateCharges:"\u0906\u0927\u093e\u0930 \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0914\u0930 \u0905\u0926\u094d\u092f\u0924\u0928 \u0936\u0941\u0932\u094d\u0915",AadhaarEnrolmentUpdateChargesForm:"\u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0914\u0930 \u0905\u0926\u094d\u092f\u0924\u0928 \u092a\u094d\u0930\u092a\u0924\u094d\u0930",ListofDocs:"\u0906\u0927\u093e\u0930 \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0914\u0930 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u093e\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0940 \u0938\u0942\u091a\u0940",serviceCards:{downloadAadhaar:{title:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0906\u0927\u093e\u0930",description:"\u0906\u0927\u093e\u0930 \u0915\u0940 \u0921\u093f\u091c\u093f\u091f\u0932\u0940 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930\u093f\u0924 \u0914\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0915\u0949\u092a\u0940 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"},orderPVC:{title:"\u0911\u0930\u094d\u0921\u0930 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921",description:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924, \u092c\u091f\u0941\u090f \u0915\u0947 \u0906\u0915\u093e\u0930 \u0915\u093e \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0911\u0930\u094d\u0921\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"},retrieveEID:{title:"\u0908\u0906\u0908\u0921\u0940/\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u093e\u092a\u094d\u0924",description:"\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u092f\u093e \u090f\u0928\u0930\u094b\u0932\u092e\u0947\u0902\u091f \u0906\u0908\u0921\u0940 (\u0908\u0906\u0908\u0921\u0940) \u091c\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"},verifyMobile:{title:"\u0908\u092e\u0947\u0932/\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902",description:"\u0906\u0927\u093e\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0914\u0930 \u0908\u092e\u0947\u0932 \u0915\u094b \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"},checkAadhaarValidity:{title:"\u0906\u0927\u093e\u0930 \u0915\u0940 \u0935\u0948\u0927\u0924\u093e \u091c\u093e\u0902\u091a\u0947\u0902",description:"\u0906\u0927\u093e\u0930 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"},orderPVCStatus:{title:"\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0911\u0930\u094d\u0921\u0930 \u0938\u094d\u0925\u093f\u0924\u093f \u091c\u093e\u0902\u091a\u0947\u0902",description:"\u092a\u0939\u0932\u0947 \u0938\u0947 \u0911\u0930\u094d\u0921\u0930 \u0915\u093f\u090f \u0917\u090f \u092a\u0940\u0935\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"},enrolmentAndUpdateStatus:{title:"\u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u091c\u093e\u0902\u091a\u0947\u0902 \u0914\u0930 \u0938\u094d\u0925\u093f\u0924\u093f \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902",description:"\u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u092f\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"},bookAppointment:{title:"\u090f\u0915 \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u092c\u0941\u0915 \u0915\u0930\u0947\u0902",description:"\u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u092f\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u092c\u0941\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"},vidGenerator:{title:"\u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0906\u0908\u0921\u0940 \u091c\u0928\u0930\u0947\u091f \u0915\u0930\u0947\u0902",description:"\u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u0938\u0947 \u091c\u0941\u0921\u093c\u0940 16 \u0905\u0902\u0915\u094b\u0902 \u0915\u0940 \u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0906\u0908\u0921\u0940 (VID) \u091c\u0947\u0928\u0930\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"},lec:{title:"\u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u090f\u0901",description:"\u0906\u0938-\u092a\u093e\u0938 \u0915\u0947 \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u094b\u0902 \u0915\u094b \u0916\u094b\u091c\u0928\u0947 \u0914\u0930 \u0916\u094b\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"},lockUnlockAadhaar:{title:"\u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0906\u0927\u093e\u0930",description:"\u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u0915\u094b \u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u0915\u0943\u092a\u092f\u093e \u0907\u0938 \u0938\u0947\u0935\u093e \u0915\u093e \u0938\u093e\u0935\u0927\u093e\u0928\u0940 \u0938\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"},fileComplaint:{title:"\u0936\u093f\u0915\u093e\u092f\u0924 \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e",description:"\u0905\u092a\u0928\u0940 \u0936\u093f\u0915\u093e\u092f\u0924 \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902"},complaintStatus:{title:"\u0936\u093f\u0915\u093e\u092f\u0924/\u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902",description:"\u0936\u093f\u0915\u093e\u092f\u0924/\u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u091c\u093e\u0902\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902"}}}},documentUpdate:{intentPage:{title:"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u0926\u094d\u092f\u0924\u0928 \u0938\u0947\u0935\u093e \u0915\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f",p1:"\u092a\u094d\u0930\u093f\u092f \u0928\u093f\u0935\u093e\u0938\u0940,",p2:"\u0906\u092a\u0915\u094b \u0938\u0932\u093e\u0939 \u0926\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u0906\u092a \u0928\u0935\u0940\u0928\u0924\u092e \u092a\u0939\u091a\u093e\u0928 \u092a\u094d\u0930\u092e\u093e\u0923 (\u092a\u0940\u0913\u0906\u0908) \u0914\u0930 \u092a\u0924\u0947 \u0915\u093e \u092a\u094d\u0930\u092e\u093e\u0923 (\u092a\u0940\u0913\u090f) \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u091c\u092e\u093e \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u092e\u0947\u0902 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u094b \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u0915\u094b \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0947\u0902\u0964 POI/POA \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u092e\u0947\u0902 \u0935\u093f\u0935\u0930\u0923 \u0906\u092a\u0915\u0947 \u0906\u0927\u093e\u0930 \u092e\u0947\u0902 \u0909\u0932\u094d\u0932\u093f\u0916\u093f\u0924 \u0935\u093f\u0935\u0930\u0923 \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0940 \u0928\u093f\u0930\u0902\u0924\u0930 \u0938\u091f\u0940\u0915\u0924\u093e \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0947\u0917\u093e\u0964",p3:"\u092f\u0926\u093f \u0906\u092a\u0928\u0947 \u0915\u093f\u0938\u0940 \u0906\u0927\u093e\u0930 \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0915\u0947\u0902\u0926\u094d\u0930 \u092f\u093e myAadhaar \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u094b \u092a\u0939\u0932\u0947 \u0939\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930 \u0926\u093f\u092f\u093e \u0939\u0948, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u0907\u0938\u0915\u0940 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0915\u0940 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902 \u092f\u093e \u0905\u0928\u094d\u092f\u0925\u093e\u0964 \u0938\u092c\u092e\u093f\u091f \u0915\u093f\u090f \u0917\u090f \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902, \u0906\u092a\u0915\u094b \u092b\u093f\u0930 \u0938\u0947 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u093e \u092a\u0921\u093c \u0938\u0915\u0924\u093e \u0939\u0948\u0964",p4:"\u092f\u0926\u093f \u0906\u092a \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u092e\u0947\u0902 \u092a\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u092f\u0939\u093e\u0902 ",p5:"\u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964",p6:"\u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u093e 25/- \u0930\u0941\u092a\u092f\u0947 \u0915\u093e \u092e\u093e\u092e\u0942\u0932\u0940 \u0936\u0941\u0932\u094d\u0915, \u091c\u094b \u0935\u093e\u092a\u0938 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964",p7:"\u092f\u0939 \u0938\u0947\u0935\u093e 14/06/2025 \u0924\u0915 \u0928\u093f\u0903\u0936\u0941\u0932\u094d\u0915 \u0939\u0948"},howItWorks:{description:"\u0915\u0943\u092a\u092f\u093e \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u091a\u0930\u0923\u094b\u0902 \u0915\u094b \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u092a\u0922\u093c\u0947\u0902\u0964 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u092f\u093e \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0926\u0947\u0930\u0940 \u0938\u0947 \u092c\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u091a\u0930\u0923\u094b\u0902 \u092e\u0947\u0902 \u0938\u0941\u091d\u093e\u090f \u0917\u090f \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0947\u0902\u0964 \u092f\u0926\u093f \u0906\u092a \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u092e\u0947\u0902 \u092a\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u092f\u0939\u093e\u0902 ",stepDescription:{one:"\u0905\u092a\u0928\u0940 \u092a\u0939\u091a\u093e\u0928 \u0915\u093e \u092a\u094d\u0930\u092e\u093e\u0923 (\u092a\u0940\u0913\u0906\u0908) \u0914\u0930 \u092a\u0924\u0947 \u0915\u093e \u092a\u094d\u0930\u092e\u093e\u0923 (\u092a\u0940\u0913\u090f) \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964",two:"\u0907\u0938 \u091a\u0930\u0923 \u092e\u0947\u0902, \u0906\u092a\u0915\u094b \u092e\u093e\u0928\u094d\u092f POI/POA \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0939\u093e \u091c\u093e\u090f\u0917\u093e  \u091c\u094b \u091a\u0930\u0923 1 \u092e\u0947\u0902 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0935\u093f\u0935\u0930\u0923 \u0936\u093e\u092e\u093f\u0932 \u092e\u0947\u0902 \u0939\u0948\u0902\u0964",three:"\u0907\u0938 \u0938\u0947\u0935\u093e \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u094b \u20b925 (\u092a\u091a\u094d\u091a\u0940\u0938 \u0930\u0941\u092a\u092f\u0947 \u092e\u093e\u0924\u094d\u0930) \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0906\u092a \u0915\u094d\u0930\u0947\u0921\u093f\u091f/\u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u092f\u093e \u0928\u0947\u091f \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0915\u0947 \u091c\u0930\u093f\u090f \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0930\u093e\u0936\u093f \u0928\u0949\u0928-\u0930\u093f\u092b\u0902\u0921\u0947\u092c\u0932 \u0939\u0948\u0964"},note:"\u092f\u0926\u093f \u0906\u092a \u0905\u092a\u0928\u093e \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940 \u0935\u093f\u0935\u0930\u0923 (\u0928\u093e\u092e, \u091c\u0928\u094d\u092e\u0924\u093f\u0925\u093f, \u0932\u093f\u0902\u0917 \u092f\u093e \u092a\u0924\u093e) \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0928\u093f\u0915\u091f\u0924\u092e \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u091c\u093e\u090f\u0902 \u0914\u0930 \u0915\u0947\u0935\u0932 \u092a\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902",noteLink:" \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"},currentSection:{form:{title:"\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0935\u093f\u0935\u0930\u0923 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902",name:"\u0928\u093e\u092e",gender:"\u0932\u093f\u0902\u0917",dob:"\u091c\u0928\u094d\u092e \u0915\u0940 \u0924\u093e\u0930\u0940\u0916",address:"\u092a\u0924\u093e",consent:"\u092e\u0948\u0902 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0924\u093e/\u0915\u0930\u0924\u0940 \u0939\u0942\u0902 \u0915\u093f \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u0935\u093f\u0935\u0930\u0923 \u0938\u0939\u0940 \u0939\u0948\u0902\u0964"},note:"\u092f\u0926\u093f \u0906\u092a\u0915\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0935\u093f\u0935\u0930\u0923 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0935\u093f\u0938\u0902\u0917\u0924\u093f \u0939\u0948, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u0928\u093f\u0915\u091f\u0924\u092e \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u0905\u092a\u0928\u093e \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0935\u093f\u0935\u0930\u0923 (\u0928\u093e\u092e, \u092a\u0924\u093e, \u091c\u0928\u094d\u092e\u0924\u093f\u0925\u093f \u092f\u093e \u0932\u093f\u0902\u0917) \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902 \u0914\u0930 \u0915\u0947\u0935\u0932 \u092a\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 ",noteLink:"\u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"},uploadSection:{confirmationPopUp:{title:"\u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902 \u0915\u093f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0935\u093f\u0935\u0930\u0923 \u0906\u0927\u093e\u0930 \u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0935\u093f\u0935\u0930\u0923 \u0938\u0947 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092e\u0947\u0932 \u0916\u093e\u0924\u0947 \u0939\u0948\u0902"},stepper:{verify:"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e",upload:"\u0905\u092a\u0932\u094b\u0921"},guidelines:{title:"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0926\u093f\u0936\u093e\u0928\u093f\u0930\u094d\u0926\u0947\u0936",l1:"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u093e \u0906\u0915\u093e\u0930 2 \u090f\u092e\u092c\u0940 \u0938\u0947 \u0915\u092e \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f",l2:"\u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u092b\u093c\u093e\u0907\u0932 \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u0939\u0948\u0902: <b>JPEG, PNG</b> \u0914\u0930 <b>PDF</b>"},form:{poiTitle:"\u0915\u0943\u092a\u092f\u093e \u092a\u0939\u091a\u093e\u0928 \u0915\u093e \u092a\u094d\u0930\u092e\u093e\u0923 (\u092a\u0940\u0913\u0906\u0908) \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902",poaTitle:"\u0915\u0943\u092a\u092f\u093e \u092a\u0924\u0947 \u0915\u093e \u092a\u094d\u0930\u092e\u093e\u0923 (\u092a\u0940\u0913\u090f) \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902"},consent:"\u092e\u0948\u0902 \u0938\u0939\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u092e\u0947\u0930\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u0917\u0908/\u0905\u092a\u0932\u094b\u0921 \u0915\u0940 \u0917\u0908 \u091c\u093e\u0928\u0915\u093e\u0930\u0940/\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u093e \u0938\u0930\u0915\u093e\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u094d\u0924\u0930 \u092a\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964"},faq:{card:{heading:"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u0926\u094d\u092f\u0924\u0928 ",description_1:"",description_2:""},guidelines:{heading_1:"\u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u092a\u0924\u0947 \u0915\u0947 \u0938\u092e\u0930\u094d\u0925\u0928 \u092e\u0947\u0902 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902",heading_2:"14/06/2025 \u0924\u0915 \u0928\u093f\u0903\u0936\u0941\u0932\u094d\u0915",question_1:{title:"\u0915\u094d\u092f\u093e \u091c\u092e\u093e \u0915\u0930\u0928\u093e \u0939\u0948?",content:{line_1:"\u0930\u093e\u0936\u0928 \u0915\u093e\u0930\u094d\u0921, \u092e\u0924\u0926\u093e\u0924\u093e \u092a\u0939\u091a\u093e\u0928 \u092a\u0924\u094d\u0930, \u0938\u0930\u0915\u093e\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u091c\u093e\u0930\u0940 \u092a\u0939\u091a\u093e\u0928 \u092a\u0924\u094d\u0930/\u092a\u0924\u0947 \u0935\u093e\u0932\u093e \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930, \u0914\u0930 \u092d\u093e\u0930\u0924\u0940\u092f \u092a\u093e\u0938\u092a\u094b\u0930\u094d\u091f \u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u092a\u0924\u0947 \u0926\u094b\u0928\u094b\u0902 \u0915\u0947 \u092a\u094d\u0930\u092e\u093e\u0923 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092e\u093e\u0928\u094d\u092f \u0939\u0948\u0902\u0964",line_2:"\u092a\u0948\u0928 \u0915\u093e\u0930\u094d\u0921, \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0932\u093e\u0907\u0938\u0947\u0902\u0938, \u0938\u0947\u0915\u0947\u0902\u0921\u0930\u0940 \u092f\u093e \u0938\u0940\u0928\u093f\u092f\u0930 \u0938\u094d\u0915\u0942\u0932 \u0915\u0940 \u092e\u093e\u0930\u094d\u0915\u0936\u0940\u091f/\u092b\u094b\u091f\u094b\u0917\u094d\u0930\u093e\u092b \u092f\u0941\u0915\u094d\u0924 \u0938\u094d\u0915\u0942\u0932 \u091b\u094b\u0921\u093c\u0928\u0947 \u0915\u093e \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930, \u0938\u0930\u0915\u093e\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u091c\u093e\u0930\u0940 \u092a\u0939\u091a\u093e\u0928 \u092a\u0924\u094d\u0930/\u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930 - \u0915\u0947\u0935\u0932 \u092a\u0939\u091a\u093e\u0928 \u0915\u0947 \u092a\u094d\u0930\u092e\u093e\u0923 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092e\u093e\u0928\u094d\u092f  \u0939\u0948\u0902\u0964",line_3:"\u092c\u093f\u091c\u0932\u0940/\u092a\u093e\u0928\u0940/\u0917\u0948\u0938 \u092c\u093f\u0932 (\u092a\u093f\u091b\u0932\u0947 3 \u092e\u0939\u0940\u0928\u0947 \u0915\u093e ), \u092c\u0948\u0902\u0915/\u092a\u094b\u0938\u094d\u091f \u0911\u092b\u093f\u0938 \u092a\u093e\u0938\u092c\u0941\u0915, \u0915\u093f\u0930\u093e\u092f\u093e/ \u092a\u091f\u094d\u091f\u093e/ \u0932\u0940\u0935 \u090f\u0935\u0902 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0938\u092e\u091d\u094c\u0924\u093e \u0915\u0947\u0935\u0932 \u092a\u0924\u0947 \u0915\u0947 \u092a\u094d\u0930\u092e\u093e\u0923 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092e\u093e\u0928\u094d\u092f  \u0939\u0948\u0964",line_4:"\u0938\u094d\u0935\u0940\u0915\u093e\u0930\u094d\u092f \u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u092a\u0924\u0947 \u0915\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u0915\u0940 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u0938\u0942\u091a\u0940 \u0915\u0947 \u0932\u093f\u090f, \u0915\u0943\u092a\u092f\u093e \u0915\u094d\u0932\u093f\u0915 \u092f\u0939\u093e\u0901  \u0915\u0930\u0947\u0902",line_5:" \u092f\u0939\u093e\u0901"}},question_2:{title:"\u0915\u0948\u0938\u0947 \u091c\u092e\u093e \u0915\u0930\u0947\u0902?",content:{line_1:"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c myAadhaar \u092a\u094b\u0930\u094d\u091f\u0932 \u092a\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u092f\u093e \u0915\u093f\u0938\u0940 \u092d\u0940 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u091c\u093e\u0915\u0930 \u091c\u092e\u093e \u0915\u093f\u090f \u091c\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",line_2:"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0911\u0928\u0932\u093e\u0907\u0928 \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0915\u0940 \u091a\u0930\u0923-\u0926\u0930-\u091a\u0930\u0923 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u092f\u0939\u093e\u0901 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902",line_3:" \u092f\u0939\u093e\u0901"}},main_content:{submit:"\u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902",title:"\u092e\u0926\u0926 \u091a\u093e\u0939\u093f\u090f?",videoText:"\u0935\u0940\u0921\u093f\u092f\u094b \u0917\u093e\u0907\u0921",knowMoreText:"\u0905\u0927\u093f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f",callText:"\u091f\u094b\u0932-\u092b\u094d\u0930\u0940 \u0928\u0902\u092c\u0930 1947 \u092a\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902"}},one:{title:"\u092e\u0941\u091d\u0947 \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u092a\u0924\u0947 \u0915\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u094d\u092f\u094b\u0902 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0928\u0947 \u091a\u093e\u0939\u093f\u090f?",content:"\u0906\u0927\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u092a\u0924\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0926\u094d\u092f\u0924\u0928 \u0938\u0939\u093e\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u091c\u0940\u0935\u0928\u092f\u093e\u092a\u0928 \u092e\u0947\u0902 \u0906\u0938\u093e\u0928\u0940, \u092c\u0947\u0939\u0924\u0930 \u0938\u0947\u0935\u093e \u0935\u093f\u0924\u0930\u0923 \u0914\u0930 \u0938\u091f\u0940\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938\u0932\u093f\u090f, \u0939\u093e\u0932 \u0939\u0940 \u0915\u093e \u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u092a\u0924\u0947 \u0915\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0928\u093e \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0927\u093e\u0930\u0915 \u0915\u0947 \u0939\u093f\u0924 \u092e\u0947\u0902 \u0939\u0948\u0964"},two:{title:"\u092e\u0941\u091d\u0947 \u0905\u092a\u0928\u0947 \u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u092a\u0924\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094c\u0928 \u0938\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f?",content:{para_1:{heading_one:"\u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u092a\u0924\u0947 \u0926\u094b\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c :",list_1:"(\u090f) \u0930\u093e\u0936\u0928 \u0915\u093e\u0930\u094d\u0921",list_2:"(\u092c\u0940) \u092e\u0924\u0926\u093e\u0924\u093e \u092a\u0939\u091a\u093e\u0928 \u092a\u0924\u094d\u0930",list_3:"(\u0938\u0940) \u0915\u093f\u0938\u093e\u0928 \u092b\u094b\u091f\u094b \u092a\u093e\u0938\u092c\u0941\u0915",list_4:"(\u0921\u0940) \u092d\u093e\u0930\u0924\u0940\u092f \u092a\u093e\u0938\u092a\u094b\u0930\u094d\u091f",list_5:"(\u0908) \u0938\u0930\u0915\u093e\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u091c\u093e\u0930\u0940 \u092a\u0939\u091a\u093e\u0928 \u092a\u0924\u094d\u0930/\u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930, \u090f\u0938\u091f\u0940/\u090f\u0938\u0938\u0940/\u0913\u092c\u0940\u0938\u0940 \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930 \u092f\u093e \u0935\u093f\u0935\u093e\u0939 \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930, \u091c\u093f\u0938\u092e\u0947\u0902 \u092b\u094b\u091f\u094b \u0939\u094b",list_6:"(\u090f\u092b) \u0935\u093f\u0915\u0932\u093e\u0902\u0917\u0924\u093e \u092a\u0939\u091a\u093e\u0928 \u092a\u0924\u094d\u0930 / \u0935\u093f\u0915\u0932\u093e\u0902\u0917\u0924\u093e \u0915\u093e \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930",list_7:"(\u091c\u0940) \u091f\u094d\u0930\u093e\u0902\u0938\u091c\u0947\u0902\u0921\u0930 \u092a\u0939\u091a\u093e\u0928 \u092a\u0924\u094d\u0930/\u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930",list_8:"(\u090f\u091a) \u092f\u094c\u0928\u0915\u0930\u094d\u092e\u0940 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u093e\u0930\u0940 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930",list_9:"(\u0906\u0908) \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0906\u0936\u094d\u0930\u092f \u0917\u0943\u0939\u094b\u0902 \u092f\u093e \u0905\u0928\u093e\u0925\u093e\u0932\u092f\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u093e\u0930\u0940 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930",list_10:"(\u091c\u0947) \u091c\u0947\u0932 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u091c\u093e\u0930\u0940 \u0915\u0948\u0926\u0940 \u092a\u094d\u0930\u0947\u0930\u0923 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c"},para_2:{heading_one:"\u092a\u0939\u091a\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c:",list_1:"(\u090f) \u092b\u094b\u091f\u094b \u0915\u0947 \u0938\u093e\u0925 \u0938\u094d\u0915\u0942\u0932 \u091b\u094b\u0921\u093c\u0928\u0947 \u0915\u093e \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930 / \u0938\u094d\u0915\u0942\u0932 \u0938\u094d\u0925\u093e\u0928\u093e\u0902\u0924\u0930\u0923 \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930",list_2:"(\u092c\u0940) \u092b\u094b\u091f\u094b \u0915\u0947 \u0938\u093e\u0925 \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0936\u093f\u0915\u094d\u0937\u093e \u092c\u094b\u0930\u094d\u0921 \u092f\u093e \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u091c\u093e\u0930\u0940 \u092e\u093e\u0930\u094d\u0915\u0936\u0940\u091f/\u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930",list_3:"(\u0938\u0940) \u092a\u0948\u0928/\u0908-\u092a\u0948\u0928 \u0915\u093e\u0930\u094d\u0921",list_4:"(\u0921\u0940) \u0938\u0930\u0915\u093e\u0930/\u0935\u0948\u0927\u093e\u0928\u093f\u0915 \u0928\u093f\u0915\u093e\u092f/\u092a\u0940\u090f\u0938\u092f\u0942 \u0926\u094d\u0935\u093e\u0930\u093e \u091c\u093e\u0930\u0940 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940/\u092a\u0947\u0902\u0936\u0928\u092d\u094b\u0917\u0940 \u092b\u094b\u091f\u094b \u092a\u0939\u091a\u093e\u0928 \u092a\u0924\u094d\u0930, \u092a\u0947\u0902\u0936\u0928 \u092d\u0941\u0917\u0924\u093e\u0928 \u0906\u0926\u0947\u0936 \u092f\u093e \u092e\u0947\u0921\u0940-\u0915\u094d\u0932\u0947\u092e \u0915\u093e\u0930\u094d\u0921",list_5:"(\u0908) \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0932\u093e\u0907\u0938\u0947\u0902\u0938",list_6:"(\u090f\u092b) \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930\u0924\u093e \u0938\u0947\u0928\u093e\u0928\u0940 \u092b\u094b\u091f\u094b \u092a\u0939\u091a\u093e\u0928 \u092a\u0924\u094d\u0930"},para_3:{heading_one:"\u092a\u0924\u0947 \u0915\u0947 \u0932\u093f\u090f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c:",list_1:"(\u090f) \u092c\u093f\u091c\u0932\u0940, \u092a\u093e\u0928\u0940, \u0917\u0948\u0938 \u092f\u093e \u091f\u0947\u0932\u0940\u092b\u094b\u0928/\u092e\u094b\u092c\u093e\u0907\u0932/\u092c\u094d\u0930\u0949\u0921\u092c\u0948\u0902\u0921 \u092c\u093f\u0932 (\u0924\u0940\u0928 \u092e\u0939\u0940\u0928\u0947 \u0938\u0947 \u0905\u0927\u093f\u0915 \u092a\u0941\u0930\u093e\u0928\u093e \u0928\u0939\u0940\u0902)",list_2:"(\u092c\u0940) \u0935\u093f\u0927\u093f\u0935\u0924 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930\u093f\u0924 \u0914\u0930 \u092e\u094b\u0939\u0930 \u0932\u0917\u0940 \u0939\u0941\u0908\u0905\u0928\u0941\u0938\u0942\u091a\u093f\u0924 \u0935\u093e\u0923\u093f\u091c\u094d\u092f\u093f\u0915 \u092c\u0948\u0902\u0915/\u0921\u093e\u0915\u0918\u0930 \u092b\u094b\u091f\u094b\u092f\u0941\u0915\u094d\u0924 \u092a\u093e\u0938\u092c\u0941\u0915",list_3:"(\u0938\u0940) \u0935\u093f\u0927\u093f\u0935\u0924 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930\u093f\u0924 \u0914\u0930 \u092e\u0941\u0939\u0930 \u0932\u0917\u0940 \u0905\u0928\u0941\u0938\u0942\u091a\u093f\u0924 \u0935\u093e\u0923\u093f\u091c\u094d\u092f\u093f\u0915 \u092c\u0948\u0902\u0915 / \u0921\u093e\u0915\u0918\u0930 \u0916\u093e\u0924\u093e / \u0915\u094d\u0930\u0947\u0921\u093f\u091f-\u0915\u093e\u0930\u094d\u0921 \u0935\u093f\u0935\u0930\u0923 (\u0924\u0940\u0928 \u092e\u0939\u0940\u0928\u0947 \u0938\u0947 \u0905\u0927\u093f\u0915 \u092a\u0941\u0930\u093e\u0928\u093e \u0928\u0939\u0940\u0902)",list_4:"(\u0921\u0940) \u0935\u0948\u0927 \u0915\u093f\u0930\u093e\u092f\u093e, \u092a\u091f\u094d\u091f\u093e \u092f\u093e \u091b\u0941\u091f\u094d\u091f\u0940 \u0914\u0930 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u090f\u0917\u094d\u0930\u0940\u092e\u0947\u0902\u091f",list_5:"(\u0908) \u0938\u093e\u0902\u0938\u0926, \u0935\u093f\u0927\u093e\u092f\u0915, \u090f\u092e\u090f\u0932\u0938\u0940, \u0928\u0917\u0930 \u092a\u093e\u0930\u094d\u0937\u0926, \u0938\u092e\u0942\u0939 '\u090f' \u092f\u093e '\u092c\u0940' \u0930\u093e\u091c\u092a\u0924\u094d\u0930\u093f\u0924 \u0905\u0927\u093f\u0915\u093e\u0930\u0940, \u0908\u092a\u0940\u090f\u092b\u0913 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u092f\u093e \u0924\u0939\u0938\u0940\u0932\u0926\u093e\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u093e\u0930\u0940 \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930",list_6:"(\u090f\u092b) \u0917\u094d\u0930\u093e\u092e \u092a\u0902\u091a\u093e\u092f\u0924 \u092a\u094d\u0930\u0927\u093e\u0928/\u0938\u091a\u093f\u0935, \u0917\u094d\u0930\u093e\u092e \u0930\u093e\u091c\u0938\u094d\u0935 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u092f\u093e \u0938\u092e\u0915\u0915\u094d\u0937 (\u0917\u094d\u0930\u093e\u092e\u0940\u0923 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f) \u0926\u094d\u0935\u093e\u0930\u093e \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u093e\u0930\u0940 \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930",list_7:"(\u091c\u0940) \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0936\u0948\u0915\u094d\u0937\u0923\u093f\u0915 \u0938\u0902\u0938\u094d\u0925\u093e\u0928 \u0915\u0947 \u092a\u094d\u0930\u092e\u0941\u0916 \u0926\u094d\u0935\u093e\u0930\u093e \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u092e\u0947\u0902 \u090f\u0915 \u091b\u093e\u0924\u094d\u0930 \u0915\u094b \u091c\u093e\u0930\u0940 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930",list_8:"(\u090f\u091a) \u0938\u0902\u092a\u0924\u094d\u0924\u093f \u0915\u0930 \u0930\u0938\u0940\u0926 (\u090f\u0915 \u0935\u0930\u094d\u0937 \u0938\u0947 \u0905\u0927\u093f\u0915 \u092a\u0941\u0930\u093e\u0928\u0940 \u0928\u0939\u0940\u0902)",list_9:"(\u0906\u0908) \u0935\u0948\u0927 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092c\u093f\u0915\u094d\u0930\u0940 \u0938\u092e\u091d\u094c\u0924\u093e \u092f\u093e \u0909\u092a\u0939\u093e\u0930 \u0935\u093f\u0932\u0947\u0916",list_10:"(\u091c\u0947) \u0938\u0930\u0915\u093e\u0930/\u0935\u0948\u0927\u093e\u0928\u093f\u0915 \u0928\u093f\u0915\u093e\u092f/\u092a\u0940\u090f\u0938\u092f\u0942 \u0926\u094d\u0935\u093e\u0930\u093e \u091c\u093e\u0930\u0940 \u0906\u0935\u093e\u0938 \u0906\u0935\u0902\u091f\u0928 \u092a\u0924\u094d\u0930 (\u090f\u0915 \u0935\u0930\u094d\u0937 \u0938\u0947 \u0905\u0927\u093f\u0915 \u092a\u0941\u0930\u093e\u0928\u093e \u0928\u0939\u0940\u0902)",list_11:"(\u0915\u0947) \u091c\u0940\u0935\u0928 \u092f\u093e \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u092c\u0940\u092e\u093e \u092a\u0949\u0932\u093f\u0938\u0940 (\u090f\u0915 \u0935\u0930\u094d\u0937 \u0938\u0947 \u0905\u0927\u093f\u0915 \u092a\u0941\u0930\u093e\u0928\u0940 \u0928\u0939\u0940\u0902)"}}},three:{title:"\u092e\u0948\u0902 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0948\u0938\u0947 \u0938\u092c\u092e\u093f\u091f \u0938\u0915\u0924\u093e \u0939\u0942\u0901?",content:"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092e\u093e\u092f\u0906\u0927\u093e\u0930 \u092a\u094b\u0930\u094d\u091f\u0932  https://myaadhaar.uidai.gov.in/ \u092a\u0930\u0911\u0928\u0932\u093e\u0907\u0928 \u092f\u093e \u0915\u093f\u0938\u0940 \u092d\u0940 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u0938\u092c\u092e\u093f\u091f\u0915\u093f\u090f \u091c\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},four:{title:"\u092e\u0948\u0902 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0911\u0928\u0932\u093e\u0907\u0928 \u0915\u0948\u0938\u0947 \u0938\u092c\u092e\u093f\u091f \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?",content:{list_1:"(1) https://myaadhaar.uidai.gov.in/ \u092a\u0930 \u091c\u093e\u090f\u0902\u0914\u0930 \u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0914\u0930 \u0905\u092a\u0928\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0935\u0928-\u091f\u093e\u0907\u092e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 (\u0913\u091f\u0940\u092a\u0940) \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0947\u0902\u0964",list_2:"(2) \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092e\u0947\u0902 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0905\u092a\u0928\u0940 \u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u092a\u0924\u0947 \u0915\u0947 \u0935\u093f\u0935\u0930\u0923 \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902\u0964",list_3:"(3) \u092f\u0926\u093f \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092e\u0947\u0902 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0935\u093f\u0935\u0930\u0923 \u0917\u0932\u0924 \u0939\u0948\u0902, \u0924\u094b \u0928\u0940\u091a\u0947 \u092a\u094d\u0930\u0936\u094d\u0928 5 \u0915\u0947 \u0909\u0924\u094d\u0924\u0930 \u092e\u0947\u0902 \u092c\u0924\u093e\u090f \u0905\u0928\u0941\u0938\u093e\u0930 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930\u0947\u0902\u0964",list_4:"(4) \u092f\u0926\u093f \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092e\u0947\u0902 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0935\u093f\u0935\u0930\u0923 \u0938\u0939\u0940 \u0939\u0948\u0902, \u0924\u094b \u0915\u0943\u092a\u092f\u093e '\u092e\u0948\u0902 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u0935\u093f\u0935\u0930\u0923 \u0938\u0939\u0940 \u0939\u0948\u0902' \u091f\u0948\u092c \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964",list_5:"(5) \u0921\u094d\u0930\u0949\u092a-\u0921\u093e\u0909\u0928 \u092e\u0947\u0928\u0942 \u0938\u0947 \u0935\u0939 \u092a\u0939\u091a\u093e\u0928 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u091a\u0941\u0928\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964",list_6:"(6) \u0905\u092a\u0928\u093e \u092a\u0939\u091a\u093e\u0928 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902 (\u0906\u0915\u093e\u0930 2 \u090f\u092e\u092c\u0940 \u0938\u0947 \u0915\u092e; \u092b\u093c\u093e\u0907\u0932 \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u091c\u0947\u092a\u0940\u0908\u091c\u0940, \u092a\u0940\u090f\u0928\u091c\u0940 \u092f\u093e \u092a\u0940\u0921\u0940\u090f\u092b)",list_7:"(7) \u0921\u094d\u0930\u0949\u092a-\u0921\u093e\u0909\u0928 \u092e\u0947\u0928\u0942 \u0938\u0947 \u0935\u0939 \u092a\u0924\u093e \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u091a\u0941\u0928\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964",list_8:"(8) \u0905\u092a\u0928\u093e \u092a\u0924\u093e \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902 (\u0906\u0915\u093e\u0930 2 \u090f\u092e\u092c\u0940 \u0938\u0947 \u0915\u092e; \u092b\u093c\u093e\u0907\u0932 \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u091c\u0947\u092a\u0940\u0908\u091c\u0940, \u092a\u0940\u090f\u0928\u091c\u0940 \u092f\u093e \u092a\u0940\u0921\u0940\u090f\u092b)\u0964",list_9:"(9) \u0905\u092a\u0928\u0940 \u0938\u0939\u092e\u0924\u093f \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0947\u0902\u0964 "}},five:{title:"\u092f\u0926\u093f \u092e\u0947\u0930\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092e\u0947\u0902 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u092a\u0924\u093e \u092e\u0947\u0930\u0947 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092a\u0924\u0947 \u0938\u0947 \u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u093e \u0939\u0948, \u0924\u094b \u092e\u0941\u091d\u0947 \u0915\u094d\u092f\u093e \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f?",content:{list_1:"(1) \u0915\u0943\u092a\u092f\u093e '\u092e\u0948\u0902 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u0935\u093f\u0935\u0930\u0923 \u0938\u0939\u0940 \u0939\u0948\u0902' \u091f\u0948\u092c \u0915\u0947 \u0928\u0940\u091a\u0947 '\u092f\u0926\u093f \u092a\u0924\u0947 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0935\u093f\u0938\u0902\u0917\u0924\u093f \u0939\u0948, \u0924\u094b \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902'\u0932\u093f\u0902\u0915 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964",list_2:"(2) \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u092b\u0949\u0930\u094d\u092e \u092e\u0947\u0902 \u092a\u0924\u0947 \u0915\u093e \u0935\u093f\u0935\u0930\u0923 \u092d\u0930\u0947\u0902\u0964",list_3:"(3) \u0921\u094d\u0930\u0949\u092a-\u0921\u093e\u0909\u0928 \u092e\u0947\u0928\u0942 \u0938\u0947 \u0935\u0939 \u092a\u0924\u093e \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u091a\u0941\u0928\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964",list_4:"(4) \u0905\u092a\u0928\u093e \u092a\u0924\u093e \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902 (\u0906\u0915\u093e\u0930 2 \u090f\u092e\u092c\u0940 \u0938\u0947 \u0915\u092e; \u092b\u093c\u093e\u0907\u0932 \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u091c\u0947\u092a\u0940\u0908\u091c\u0940, \u092a\u0940\u090f\u0928\u091c\u0940 \u092f\u093e \u092a\u0940\u0921\u0940\u090f\u092b)\u0964",list_5:"(5) \u0906\u0935\u0936\u094d\u092f\u0915 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0947\u0902.",list_6:"(6) \u0905\u092a\u0928\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0947\u0902\u0964"}},six:{title:"\u092f\u0926\u093f \u0915\u094b\u0908 \u092a\u0939\u091a\u093e\u0928 \u0935\u093f\u0935\u0930\u0923 (\u0928\u093e\u092e, \u0932\u093f\u0902\u0917 \u092f\u093e \u091c\u0928\u094d\u092e \u0924\u093f\u0925\u093f) \u092e\u0947\u0930\u0947 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u092a\u0939\u091a\u093e\u0928 \u0935\u093f\u0935\u0930\u0923 \u0938\u0947 \u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u093e \u0939\u0948, \u0924\u094b \u092e\u0941\u091d\u0947 \u0915\u094d\u092f\u093e \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f?",content:"\u0915\u0943\u092a\u092f\u093e https://uidai.gov.in/images/commdoc/List_of_Supporting_Document_for_Aadhaar_Enrolment_and_Update.pdf \u092a\u0930 \u0938\u0942\u091a\u0940\u092c\u0926\u094d\u0927 \u092e\u0942\u0932 \u092a\u0939\u091a\u093e\u0928 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u091c\u093e\u090f\u0902\u0964"},seven:{title:"\u092f\u0926\u093f \u092e\u0948\u0902 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u091c\u092e\u093e \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902, \u0924\u094b \u092e\u0948\u0902 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u0948\u0938\u0947 \u0922\u0942\u0902\u0922 \u0938\u0915\u0924\u093e \u0939\u0942\u0902?",content:{list_1:"(1) \u0915\u0943\u092a\u092f\u093e https://shuvan.nrsc.gov.in/aadhaar/ \u092a\u0930 \u091c\u093e\u090f\u0902",list_2:"(2) \u0906\u0938-\u092a\u093e\u0938 \u0915\u0947 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u094b\u0902 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, '\u0906\u0938-\u092a\u093e\u0938 \u0915\u0947\u0902\u0926\u094d\u0930' \u091f\u0948\u092c \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u0906\u0938-\u092a\u093e\u0938 \u0915\u0947 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0938\u094d\u0925\u093e\u0928 \u0935\u093f\u0935\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964",list_3:"(3) \u0905\u092a\u0928\u0947 \u092a\u093f\u0928 \u0915\u094b\u0921 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u094b\u0902 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, '\u092a\u093f\u0928 \u0915\u094b\u0921 \u0926\u094d\u0935\u093e\u0930\u093e \u0916\u094b\u091c\u0947\u0902' \u091f\u0948\u092c \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u0909\u0938 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u093e \u092a\u093f\u0928 \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964"}},eight:{title:"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0928\u0947 \u0915\u093e \u0936\u0941\u0932\u094d\u0915 \u0915\u094d\u092f\u093e \u0939\u0948?",content:"14 \u0938\u093f\u0924\u0902\u092c\u0930 2023 \u0924\u0915 \u092e\u093e\u092f\u0906\u0927\u093e\u0930 \u092a\u094b\u0930\u094d\u091f\u0932 \u092a\u0930 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u091c\u092e\u093e \u0915\u0930\u0928\u093e \u0928\u093f\u0903\u0936\u0941\u0932\u094d\u0915 \u0939\u0948\u0964 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0932\u093e\u0917\u0942 \u0936\u0941\u0932\u094d\u0915 \u0930\u0941. 50 \u0939\u0948\u0964"},nine:{title:"\u092e\u0941\u091d\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u092c \u0924\u0915 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0928\u0947 \u091a\u093e\u0939\u093f\u090f?",content:"\u091c\u0940\u0935\u0928\u092f\u093e\u092a\u0928 \u092e\u0947\u0902 \u0906\u0938\u093e\u0928\u0940, \u092c\u0947\u0939\u0924\u0930 \u0938\u0947\u0935\u093e \u0935\u093f\u0924\u0930\u0923 \u0914\u0930 \u0938\u091f\u0940\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u094b \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u0915\u094b \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930\u0928\u093e \u0935\u093e\u0902\u091b\u0928\u0940\u092f \u0939\u0948\u0964 \u0907\u0938\u0932\u093f\u090f, \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u0915\u094b \u0936\u0940\u0918\u094d\u0930\u0924\u093e \u0938\u0947 \u091c\u092e\u093e \u0915\u0930\u0928\u093e \u0906\u092a\u0915\u0947 \u0939\u093f\u0924 \u092e\u0947\u0902 \u0939\u0948\u0964"},ten:{title:"\u092e\u0948\u0902 \u090f\u0915 \u0905\u0928\u093f\u0935\u093e\u0938\u0940 \u092d\u093e\u0930\u0924\u0940\u092f (\u090f\u0928\u0906\u0930\u0906\u0908) \u0939\u0942\u0902\u0964 \u092e\u0948\u0902 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0948\u0938\u0947 \u0938\u092c\u092e\u093f\u091f \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?",content:"\u091c\u092c \u092d\u0940 \u0906\u092a \u092d\u093e\u0930\u0924 \u092e\u0947\u0902 \u0939\u094b\u0902 \u0924\u094b \u0906\u092a \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0938\u092c\u092e\u093f\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"}}},aadharUpdateHistory:{title1:"\u0905\u092a\u0928\u093e \u0906\u0927\u093e\u0930 \u0905\u092a\u0921\u0947\u091f \u0907\u0924\u093f\u0939\u093e\u0938 \u091c\u093e\u0902\u091a\u0947\u0902",label1:"\u0905\u092d\u093f\u0932\u0947\u0916",label2:"\u0928\u093e\u092e\u093e\u0902\u0915\u0928/\u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0940 \u0924\u093f\u0925\u093f",label3:"URN/EID",label4:"\u092a\u094d\u0930\u0915\u093e\u0930",list1:"\u0928\u093e\u092e",list2:"\u092e\u094b\u092c\u093e\u0907\u0932",list3:"\u0908\u092e\u0947\u0932",list4:"\u091c\u0928\u094d\u092e \u0924\u093f\u0925\u093f",list5:"\u0932\u093f\u0902\u0917",list6:"\u092a\u0924\u093e"},ssup:{howItWorks:{title:"\u092f\u0939 \u0915\u093f\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948?",description:"\u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u0926\u094d\u092f\u0924\u0928 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094b \u0938\u092e\u091d\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u091a\u0930\u0923\u094b\u0902 \u0915\u094b \u092a\u0922\u093c\u0947\u0902\u0964 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u092f\u093e \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0926\u0947\u0930\u0940 \u0938\u0947 \u092c\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u091a\u0930\u0923\u094b\u0902 \u092e\u0947\u0902 \u0938\u0941\u091d\u093e\u090f \u0917\u090f \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0947\u0902\u0964",proceedToUpdateAadhaar:"\u0906\u0927\u093e\u0930 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0917\u0947 \u092c\u0922\u093c\u0947\u0902\u0964",stepDescription:{one:"\u0938\u0942\u091a\u0940 \u0938\u0947 \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0924\u093e \u092b\u093c\u0940\u0932\u094d\u0921 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902\u0964 \u0907\u0938 \u0911\u0928\u0932\u093e\u0907\u0928 \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u0947 \u091c\u0930\u093f\u090f \u0906\u092a \u092a\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0928\u093e\u092e, \u0932\u093f\u0902\u0917, \u091c\u0928\u094d\u092e \u0924\u093f\u0925\u093f, \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930, \u0908\u092e\u0947\u0932 \u0914\u0930 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0921\u0947\u091f\u093e \u0915\u0947 \u0932\u093f\u090f, \u0915\u0943\u092a\u092f\u093e \u0928\u093f\u0915\u091f\u0924\u092e \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u091c\u093e\u090f\u0901\u0964",two:"\u0915\u0943\u092a\u092f\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0921\u0947\u091f\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964 \u0915\u0941\u091b \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0921\u0947\u091f\u093e \u0915\u094b \u0921\u094d\u0930\u0949\u092a\u0921\u093e\u0909\u0928 \u0938\u0942\u091a\u0940 \u0938\u0947 \u091a\u092f\u0928 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940 \u0921\u0947\u091f\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u092f\u093e \u0921\u094d\u0930\u0949\u092a\u0921\u093e\u0909\u0928 \u0935\u093f\u0915\u0932\u094d\u092a\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u091a\u092f\u0928 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0915\u0943\u092a\u092f\u093e \u0938\u093e\u0935\u0927\u093e\u0928 \u0930\u0939\u0947\u0902\u0964",three:"\u092a\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u0942\u0932 \u0938\u0939\u093e\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0940 \u0938\u094d\u0915\u0948\u0928 \u0915\u0949\u092a\u0940 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0938\u0939\u093e\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0906\u092a\u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u0939\u0948 \u0914\u0930 \u092e\u093e\u0928\u094d\u092f \u0939\u0948\u0964 \u092f\u0926\u093f \u0906\u092a \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u092e\u0947\u0902 \u090f\u0915 \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0924\u094b \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0940 \u0905\u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0938\u0947 \u092c\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u091c\u093e\u0930\u0940 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0924\u093e\u0930\u0940\u0916, \u0915\u094d\u0930\u0949\u0938\u094d\u0921 \u0938\u093e\u0907\u0928, \u092b\u094b\u091f\u094b \u092a\u0930 \u0938\u094d\u091f\u093e\u092e\u094d\u092a \u0914\u0930 \u0915\u094b\u0908 \u0913\u0935\u0930\u0930\u093e\u0907\u091f\u093f\u0902\u0917 \u091c\u0948\u0938\u0940 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0917\u0932\u0924\u093f\u092f\u094b\u0902 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902\u0964",four:"\u0906\u092a\u0915\u094b \u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u092a\u0921\u0947\u091f \u0936\u0941\u0932\u094d\u0915 \u0915\u0947 \u0932\u093f\u090f \u20b9 50 (\u0915\u0947\u0935\u0932 \u092a\u091a\u093e\u0938 \u0930\u0941\u092a\u092f\u0947) \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0906\u092a \u0915\u094d\u0930\u0947\u0921\u093f\u091f/\u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u092f\u093e \u0928\u0947\u091f \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0915\u0947 \u091c\u0930\u093f\u090f \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0930\u093e\u0936\u093f \u0905\u092a\u094d\u0930\u0924\u093f\u0926\u0947\u092f \u0939\u0948\u0964 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902, \u0906\u092a \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u093e \u092a\u0941\u0928: \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",five:"\u0906\u092a\u0915\u094b \u090f\u0915 \u0938\u0902\u0926\u0930\u094d\u092d \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u090f\u0915 \u0938\u0947\u0935\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u0902\u0916\u094d\u092f\u093e (SRN) \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u0940\u0964 \u0905\u0926\u094d\u092f\u0924\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u091f\u094d\u0930\u0948\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u093e \u092f\u0942\u0906\u0908\u0921\u0940\u090f\u0906\u0908 \u0939\u0947\u0932\u094d\u092a\u0921\u0947\u0938\u094d\u0915 \u0915\u0947 \u0938\u093e\u0925 \u092d\u0935\u093f\u0937\u094d\u092f \u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u0902\u091a\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938 \u0928\u0902\u092c\u0930 \u0915\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0947\u0902\u0964",six:"\u0906\u092a\u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0939\u092e\u093e\u0930\u0947 \u0906\u0902\u0924\u0930\u093f\u0915 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u091c\u093e\u0902\u091a \u092a\u094d\u0930\u091a\u093e\u0932\u0915\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0907\u0938 \u0938\u094d\u0924\u0930 \u092a\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u090f \u0917\u090f \u091c\u0928\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940 \u0921\u0947\u091f\u093e \u0915\u094b \u0938\u0939\u093e\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0947 \u0935\u093f\u0930\u0941\u0926\u094d\u0927 \u091c\u093e\u0902\u091a\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u092f\u0926\u093f \u0915\u094b\u0908 \u092c\u0947\u092e\u0947\u0932 \u0939\u0948, \u0924\u094b \u0906\u092a\u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u093f\u090f \u091c\u093e\u0928\u0947 \u0915\u0940 \u0938\u0902\u092d\u093e\u0935\u0928\u093e \u0939\u0948\u0964",seven:"\u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u091c\u093e\u0902\u091a \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u0942\u0930\u0940 \u0939\u094b\u0928\u0947 \u092a\u0930, \u0906\u092a\u0915\u094b \u092a\u0930\u093f\u0923\u093e\u092e \u0915\u0947 \u0924\u094c\u0930 \u092a\u0930  \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0906\u0908\u0921\u0940 \u092f\u0941\u0915\u094d\u0924 \u090f\u0915 \u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u0942\u091a\u0928\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u0940\u0964",eight:"\u0939\u092e\u093e\u0930\u0947 \u092c\u0948\u0915\u090f\u0902\u0921 \u0938\u0949\u092b\u093c\u094d\u091f\u0935\u0947\u092f\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u0941\u091b \u0914\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0947 \u092c\u093e\u0926, \u0906\u092a\u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u0942\u0930\u0940 \u0939\u094b \u091c\u093e\u090f\u0917\u0940\u0964 \u0906\u092a\u0915\u094b \u092a\u0930\u093f\u0923\u093e\u092e \u0915\u0947 \u0924\u094c\u0930 \u092a\u0930  \u090f\u0915 \u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u0942\u091a\u0928\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u0940\u0964",nine:"\u0906\u092e \u0924\u094c\u0930 \u092a\u0930 \u0905\u0926\u094d\u092f\u0924\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 90% \u0938\u0947\u0935\u093e \u092e\u093e\u0928\u0915\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 30 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u092d\u0940\u0924\u0930 \u092a\u0942\u0930\u093e \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0939\u093e\u0932\u093e\u0902\u0915\u093f, \u0939\u092e \u0905\u092a\u0928\u0947 \u0938\u093f\u0938\u094d\u091f\u092e \u092e\u0947\u0902 \u0938\u0941\u0927\u093e\u0930 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0905\u0927\u093f\u0915 \u0938\u0902\u092d\u093e\u0935\u0928\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u092c\u0924\u093e\u090f \u0917\u090f \u0938\u092e\u092f \u0938\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930 \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0964 \u0906\u092a myaadhaar.uidai.gov.in \u092a\u0930 \u091c\u093e\u0915\u0930 \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f \u092a\u094d\u0930\u094b\u0938\u0947\u0938\u093f\u0902\u0917 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"}},updateSelectPage:{title:"\u0906\u0927\u093e\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902",selectFields:{smallDescription:"\u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e \u092b\u093c\u0940\u0932\u094d\u0921 \u091a\u0941\u0928\u0947\u0902\u0964",longDescription:"\u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u092e\u094d\u0928 \u092e\u0947\u0902 \u0938\u0947 \u0915\u093f\u0938\u0940 \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e \u092b\u093c\u0940\u0932\u094d\u0921 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902\u0964",updatesLeft:" \u0905\u092a\u0921\u0947\u091f \u092c\u093e\u0915\u0940",noLimit:"\u0915\u094b\u0908 \u0938\u0940\u092e\u093e \u0928\u0939\u0940\u0902",demoGraphics:{language:"\u092d\u093e\u0937\u093e",name:"\u0928\u093e\u092e",dob:"\u091c\u0928\u094d\u092e \u0915\u0940 \u0924\u093e\u0930\u0940\u0916",gender:"\u0932\u093f\u0902\u0917",hof:"\u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0947 \u092e\u0941\u0916\u093f\u092f\u093e (\u090f\u091a\u0913\u090f\u092b) \u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u0924\u093e \u0905\u0926\u094d\u092f\u0924\u0928",address:"\u092a\u0924\u093e"}},documentDescriptionLinkText:"\u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0940\u0913\u0906\u0908 / \u092a\u0940\u0913\u090f / \u092a\u0940\u0913\u092c\u0940 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0906\u0935\u0936\u094d\u092f\u0915 \u0935\u0948\u0927 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u0926\u0947\u0916\u0947\u0902",proceedToUpdateAadhaar:"\u0906\u0927\u093e\u0930 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0917\u0947 \u092c\u0922\u093c\u0947\u0902",faq:"\u0932\u0917\u093e\u0924\u093e\u0930 \u092a\u0942\u091b\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u094d\u0930\u0936\u094d\u0928"},dashboard:"\u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921",hof:{title:"\u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0947 \u092e\u0941\u0916\u093f\u092f\u093e (\u090f\u091a\u0913\u090f\u092b) \u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u0924\u093e \u0905\u0926\u094d\u092f\u0924\u0928",description:"\u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0947 \u092e\u0941\u0916\u093f\u092f\u093e \u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u0924\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0901 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0915\u0947 \u0906\u0917\u0947 \u092c\u095d\u0947\u0902 ",howItWorks:{step1:"\u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u0947 \u092a\u0924\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0947 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0947 \u092e\u0941\u0916\u093f\u092f\u093e \u0915\u0940 \u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964 \u0915\u0947\u0935\u0932 18 \u0935\u0930\u094d\u0937 \u092f\u093e \u0909\u0938\u0938\u0947 \u0905\u0927\u093f\u0915 \u0906\u092f\u0941 \u0915\u0947 \u0928\u093f\u0935\u093e\u0938\u093f\u092f\u094b\u0902 \u0915\u094b \u090f\u091a\u0913\u090f\u092b \u092e\u093e\u0928\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964",step2:'\u0915\u0943\u092a\u092f\u093e \u0938\u0902\u092c\u0902\u0927 \u0915\u093e \u092a\u094d\u0930\u092e\u093e\u0923 (\u092a\u0940\u0913\u0906\u0930) \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902 \u091c\u093f\u0938\u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0928\u093e\u092e \u0914\u0930 \u0906\u092a\u0915\u0947 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0947 \u092e\u0941\u0916\u093f\u092f\u093e \u0915\u093e \u0928\u093e\u092e \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u0909\u0932\u094d\u0932\u093f\u0916\u093f\u0924 \u0939\u094b\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0947 \u0938\u093e\u0925 \u090f\u091a\u0913\u090f\u092b \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902, \u0909\u0926\u093e\u0939\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u092f\u0926\u093f \u090f\u091a\u0913\u090f\u092b \u0906\u092a\u0915\u093e \u092a\u0924\u093f \u0939\u0948, \u0924\u094b "\u092a\u0924\u093f" \u091a\u0941\u0928\u0947\u0902\u0964',step3:"\u0906\u092a\u0915\u094b \u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u092a\u0921\u0947\u091f \u0936\u0941\u0932\u094d\u0915 \u0915\u0947 \u0932\u093f\u090f \u20b9 50 (\u0915\u0947\u0935\u0932 \u092a\u091a\u093e\u0938 \u0930\u0941\u092a\u092f\u0947) \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0906\u092a \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u094d\u0930\u0947\u0921\u093f\u091f/\u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u092f\u093e \u0928\u0947\u091f \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0930\u093e\u0936\u093f \u0905\u092a\u094d\u0930\u0924\u093f\u0926\u0947\u092f \u0939\u0948\u0964",step4:"\u091c\u092c \u0906\u092a\u0915\u0947 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0947 \u092e\u0941\u0916\u093f\u092f\u093e \u0905\u092a\u0928\u0947 \u092e\u093e\u092f\u0906\u0927\u093e\u0930  \u092a\u094b\u0930\u094d\u091f\u0932 \u092a\u0930 \u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0905\u0928\u0941\u0930\u094b\u0927 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u093e, \u091c\u093f\u0938\u0947 \u0935\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u092f\u093e \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u090f\u091a\u0913\u090f\u092b \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930/\u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u093e \u092f\u0939 \u0935\u093f\u0915\u0932\u094d\u092a \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0947 \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u0940 \u0924\u093e\u0930\u0940\u0916 \u0938\u0947 30 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0935\u0948\u0927 \u0939\u094b\u0917\u093e\u0964"},currentSection:{title:"\u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u090f\u091a\u0913\u090f\u092b \u0915\u093e \u0935\u093f\u0935\u0930\u0923"},updateSection:{forms:{hofUid:{label:"\u090f\u091a\u0913\u090f\u092b \u0915\u0940 \u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902"},mobileField:{label:"\u090f\u091a\u0913\u090f\u092b \u0915\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930"},documentUpload:{label:"\u092e\u093e\u0928\u094d\u092f \u0938\u0939\u093e\u092f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902"},relationshipDropdown:{label:"\u0906\u0935\u0947\u0926\u0915 \u0915\u0947 \u0938\u093e\u0925 \u090f\u091a\u0913\u090f\u092b  \u0915\u093e \u0938\u0902\u092c\u0902\u0927 \u091a\u0941\u0928\u0947\u0902",values:{father:"\u092a\u093f\u0924\u093e",mother:"\u092e\u093e\u0924\u093e",husband:"\u092a\u0924\u093f",wife:"\u092a\u0924\u094d\u0928\u0940",guardian:"\u0905\u092d\u093f\u092d\u093e\u0935\u0915",Others:"\u0905\u0928\u094d\u092f"}}}}},documentInfoPopup:{title:"\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u092e\u093e\u0928\u094d\u092f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964",identityDocumentInfo:"\u092f\u0926\u093f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092a\u0939\u091a\u093e\u0928 \u092a\u094d\u0930\u092e\u093e\u0923 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948, \u0924\u094b \u092f\u0939 \u0906\u092a\u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u0914\u0930 \u0909\u0938\u092a\u0930 \u090f\u0915 \u092b\u094b\u091f\u094b\u0917\u094d\u0930\u093e\u092b \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u0915\u0943\u092a\u092f\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u092b\u093c\u0949\u0930\u094d\u092e \u092e\u0947\u0902 \u090a\u092a\u0930 \u0909\u0932\u094d\u0932\u093f\u0916\u093f\u0924 '\u0928\u093e\u092e' \u0906\u092a\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u092a\u0932\u094b\u0921 \u0915\u093f\u090f \u091c\u093e \u0930\u0939\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0947 '\u0928\u093e\u092e' \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u0924\u093e \u0939\u0948\u0964",addressDocumentInfo:"\u092f\u0926\u093f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092a\u0924\u0947 \u0915\u0947 \u092a\u094d\u0930\u092e\u093e\u0923 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948, \u0924\u094b \u092f\u0939 \u0906\u092a\u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u092a\u0924\u093f \u092f\u093e \u092a\u0924\u094d\u0928\u0940, \u0905\u092d\u093f\u092d\u093e\u0935\u0915 \u092f\u093e \u092e\u093e\u0924\u093e-\u092a\u093f\u0924\u093e \u0915\u0947 \u0928\u093e\u092e \u0915\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u0915\u093f\u090f \u091c\u093e\u090f\u0902\u0917\u0947\u0964 \u0915\u0943\u092a\u092f\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u092a\u094d\u0930\u092a\u0924\u094d\u0930 \u092e\u0947\u0902 \u090a\u092a\u0930 \u0909\u0932\u094d\u0932\u093f\u0916\u093f\u0924 '\u092a\u0924\u093e' \u0906\u092a\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u092a\u0932\u094b\u0921 \u0915\u093f\u090f \u091c\u093e \u0930\u0939\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0947 '\u092a\u0924\u0947' \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u0924\u093e \u0939\u0948\u0964",close:"\u092c\u0902\u0926 \u0915\u0930\u0947\u0964",continueToUpload:"\u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u093e \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902\u0964"},forms:{reUseDocText:"\u0906\u092a \u092a\u0939\u0932\u0947 \u0938\u0947 \u0905\u092a\u0932\u094b\u0921 \u0915\u093f\u090f \u0917\u090f \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \