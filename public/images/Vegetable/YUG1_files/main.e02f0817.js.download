0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u093e",goToDashboard:"\u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921\u0935\u0930 \u091c\u093e"},invalidShareCode:"Invalid Share Code! Please retry with correct share code.",shareCode:{title:"\u090f\u0915 \u0936\u0947\u0905\u0930 \u0915\u094b\u0921 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e",descText:"\u0924\u0941\u092e\u091a\u0940 eKYC \u0905\u0938\u0932\u0947\u0932\u0940 ZIP \u092b\u093e\u0907\u0932 \u0935\u0930\u0940\u0932 \u0936\u0947\u0905\u0930 \u0915\u094b\u0921 \u0935\u093e\u092a\u0930\u0942\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0902\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u0947\u0932\u0940 \u091c\u093e\u0908\u0932. \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0935\u0930, \u092b\u093e\u0907\u0932 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 / \u0921\u0947\u0938\u094d\u0915\u091f\u0949\u092a\u0935\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0947\u0932\u0940 \u091c\u093e\u0908\u0932.",placeholderText:"4 - \u0905\u0902\u0915 \u0936\u0947\u0905\u0930 \u0915\u094b\u0921 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u093e \u091c\u093e\u0923\u093e\u0930 \u0906\u0939\u0947"},success:{desc:"\u0938\u0947\u0935\u0947\u091a\u093e \u0932\u093e\u092d \u0918\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0943\u092a\u092f\u093e \u0936\u0947\u0905\u0930 \u0915\u0930\u093e",p1:"ZIP \u092b\u093e\u0907\u0932",p2:"\u0915\u094b\u0921 \u0936\u0947\u0905\u0930 \u0915\u0930\u093e",p3:"\u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0926\u093e\u0924\u094d\u092f\u093e\u0915\u0921\u0947 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915",summary:"\u0939\u0947 \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0926\u093e\u0924\u094d\u092f\u093e\u0902\u0928\u093e/\u0911\u092b\u0932\u093e\u0907\u0928 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u0936\u094b\u0927\u0923\u093e\u0930\u094d\u200d\u092f\u093e \u0938\u0902\u0938\u094d\u0925\u093e\u0902\u0928\u093e (OVSE) \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0938\u0902\u0915\u0932\u093f\u0924 \u0915\u093f\u0902\u0935\u093e \u0938\u0902\u0917\u094d\u0930\u0939\u093f\u0924 \u0928 \u0915\u0930\u0924\u093e \u0911\u092b\u0932\u093e\u0907\u0928 \u0906\u0927\u093e\u0930 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0947\u0932."},descTextStep1:"\u0906\u0927\u093e\u0930 \u092a\u0947\u092a\u0930\u0932\u0947\u0938 \u0911\u092b\u0932\u093e\u0907\u0928 \u0908-\u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0939\u093e \u090f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0923\u093f \u0936\u0947\u0905\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u092f\u094b\u0917\u094d\u092f \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0906\u0939\u0947 \u091c\u094b \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0906\u0927\u093e\u0930 \u0927\u093e\u0930\u0915\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u0913\u0933\u0916\u0940\u091a\u094d\u092f\u093e \u0911\u092b\u0932\u093e\u0907\u0928 \u092a\u0921\u0924\u093e\u0933\u0923\u0940\u0938\u093e\u0920\u0940 \u0935\u093e\u092a\u0930\u0932\u093e \u091c\u093e\u090a \u0936\u0915\u0924\u094b. \u0924\u092a\u0936\u0940\u0932\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u0928\u093e\u0935, \u092a\u0924\u094d\u0924\u093e, \u092b\u094b\u091f\u094b, \u0932\u093f\u0902\u0917, DoB, \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930\u091a\u093e \u0939\u0945\u0936, \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u0908\u092e\u0947\u0932 \u092a\u0924\u094d\u0924\u093e \u0906\u0923\u093f \u0938\u0902\u0926\u0930\u094d\u092d \u0906\u092f\u0921\u0940\u091a\u093e \u0939\u0945\u0936 \u0905\u0938\u0947\u0932 \u091c\u094d\u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u091a\u0947 \u0936\u0947\u0935\u091f\u091a\u0947 4 \u0905\u0902\u0915 \u0905\u0938\u0924\u0940\u0932 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u094d\u0935\u093e\u0915\u094d\u0937\u0930\u0940 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e XML \u092e\u0927\u094d\u092f\u0947 \u091f\u093e\u0907\u092e \u0938\u094d\u091f\u0945\u092e\u094d\u092a \u0905\u0938\u0947\u0932.",descTextStep2:"\u0911\u092b\u0932\u093e\u0907\u0928 eKYC \u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u0940 ZIP \u092b\u093e\u0907\u0932 \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u093f\u0924\u094d\u092f\u093e \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0947\u0932\u0940 \u0917\u0947\u0932\u0940 \u0906\u0939\u0947"},lockUnlockBiometrics:{serviceCard:{errorMessage:"\u0915\u0943\u092a\u092f\u093e \u0906\u092e\u094d\u0939\u0940 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0938\u094d\u0925\u093f\u0924\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u092a\u0930\u094d\u092f\u0902\u0924 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u093e."},howItWorks:{title:"\u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0915\u0938\u0947 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0924\u0947",description:"\u092c\u093e\u092f\u094b \u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f \u0928\u093f\u0935\u093e\u0938\u0940 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0921\u0947\u091f\u093e\u091a\u093e \u0938\u0902\u092d\u093e\u0935\u094d\u092f \u0917\u0948\u0930\u0935\u093e\u092a\u0930 \u0930\u094b\u0916\u0924\u0947. \u0932\u0949\u0915 \u0915\u0947\u0932\u0947\u0932\u0947 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923\u093e\u0938\u093e\u0920\u0940 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u092e\u093e\u0939\u093f\u0924\u0940\u091a\u093e \u0935\u093e\u092a\u0930 \u0930\u094b\u0916\u0924\u093e\u0924. \u092f\u093e \u0938\u0947\u0935\u0947\u091a\u094d\u092f\u093e \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\u0928\u093e \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0938\u0947\u0935\u093e \u0928\u093e\u0915\u093e\u0930\u0923\u094d\u092f\u093e\u092a\u093e\u0938\u0942\u0928 \u0930\u094b\u0916\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u093e\u0933\u091c\u0940 \u0918\u0947\u090a\u0928 \u0905\u0938\u0947 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u093e\u0935\u0927 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u0947.",infoData:{stepOneDescription:"\u0924\u0941\u092e\u091a\u0947 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0943\u092a\u092f\u093e \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921\u0935\u0930\u0942\u0928 \u0939\u0940 \u0938\u0947\u0935\u093e \u0935\u093e\u092a\u0930\u093e. \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u0947 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 (\u092b\u093f\u0902\u0917\u0930\u092a\u094d\u0930\u093f\u0902\u091f, \u092c\u0941\u092c\u0941\u0933 \u0906\u0923\u093f \u091a\u0947\u0939\u0930\u093e) \u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0924\u0947\u0935\u094d\u0939\u093e \u0924\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923\u093e\u0938\u093e\u0920\u0940 \u0935\u093e\u092a\u0930\u0932\u0947 \u091c\u093e\u090a \u0936\u0915\u0924 \u0928\u093e\u0939\u0940\u0924. \u0924\u0925\u093e\u092a\u093f, \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u0947\u0928\u0941\u0938\u093e\u0930 OTP-\u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0909\u092a\u0932\u092c\u094d\u0927 \u0930\u093e\u0939\u0940\u0932.",stepTwoDescription:"\u0915\u0943\u092a\u092f\u093e \u092f\u093e \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930 \u092a\u0930\u0924 \u092f\u093e \u0906\u0923\u093f \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0941\u0922\u0947 \u091c\u093e. \u0924\u0941\u092e\u091a\u0947 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0905\u0928\u0932\u0949\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0935\u0930 (\u092b\u093f\u0902\u0917\u0930\u092a\u094d\u0930\u093f\u0902\u091f + \u0906\u092f\u0930\u093f\u0938 + \u092b\u0947\u0938) OTP \u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923\u093e\u0938\u0939 \u0938\u0915\u094d\u0937\u092e \u0915\u0947\u0932\u0947 \u091c\u093e\u0908\u0932."}},selectionScreen:{unlockCard:{heading:"\u0915\u0943\u092a\u092f\u093e \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0928\u093f\u0935\u0921\u093e",consentText:"\u092e\u0932\u093e \u0938\u092e\u091c\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940 \u092e\u093e\u091d\u0947 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u0905\u0928\u0932\u0949\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930, \u092e\u0940 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u0915\u094d\u0937\u092e \u0905\u0938\u0947\u0932.",label:"\u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u093e"},lockCard:{heading:"\u0915\u0943\u092a\u092f\u093e \u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0928\u093f\u0935\u0921\u093e",consentText:"\u092e\u0932\u093e \u0938\u092e\u091c\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940 \u092e\u093e\u091d\u0947 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u0932\u0949\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930, \u092e\u0940 \u092e\u093e\u091d\u0947 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u092a\u0930\u094d\u092f\u0902\u0924 \u092e\u0940 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930\u0942 \u0936\u0915\u0923\u093e\u0930 \u0928\u093e\u0939\u0940.",label:"\u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0932\u0949\u0915 \u0915\u0930\u093e"},selectOptionError:"\u0915\u0943\u092a\u092f\u093e \u092b\u0915\u094d\u0924 \u090f\u0915\u091a \u092a\u0930\u094d\u092f\u093e\u092f \u0928\u093f\u0935\u0921\u093e.",selectButton:{tempUnlock:"\u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0924\u093e\u0924\u094d\u092a\u0941\u0930\u0924\u0947 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u093e",tempUnlockInfo:"\u0915\u092e\u0940 \u0915\u093e\u0932\u093e\u0935\u0927\u0940\u0938\u093e\u0920\u0940",unlock:"\u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0915\u093e\u092f\u092e\u091a\u0947 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u093e",unlockInfo:"\u092a\u0941\u0922\u091a\u094d\u092f\u093e \u0935\u0947\u0933\u0947\u092a\u0930\u094d\u092f\u0902\u0924 \u0924\u0941\u092e\u094d\u0939\u0940 \u0932\u0949\u0915 \u0915\u0930\u093e"}},successScreen:{tempUnlockMessage:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0915\u093e\u092f\u092e\u091a\u0947 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u093e\u092f\u091a\u0947 \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0915\u0943\u092a\u092f\u093e \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921\u0935\u0930\u0942\u0928 \u092f\u093e \u0938\u0947\u0935\u0947\u0932\u093e \u092a\u0941\u0928\u094d\u0939\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e."}},lockUnlockAadhaar:{howItWorks:{title:"\u0906\u0927\u093e\u0930 \u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0915\u0938\u0947 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0924\u0947",infoData:{stepOneLabel:"\u092a\u093e\u092f\u0930\u0940 3 \u092a\u0948\u0915\u0940 1: ",stepOneDescription:"\u0906\u0927\u093e\u0930 \u0932\u0949\u0915 / \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0941\u0922\u0947 \u091c\u093e\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940, \u0915\u0943\u092a\u092f\u093e 16-\u0905\u0902\u0915\u0940 \u0935\u094d\u0939\u0930\u094d\u091a\u094d\u092f\u0941\u0905\u0932 \u0906\u092f\u0921\u0940 (\u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940) \u0935\u094d\u092f\u0941\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0930\u093e, \u0915\u093e\u0930\u0923 \u0915\u0947\u0935\u0933 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940\u092e\u0927\u094d\u092f\u0947 \u0906\u0927\u093e\u0930 \u0932\u0949\u0915 / \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0906\u0939\u0947. \u0906\u092a\u0923 \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921\u0935\u0930\u0942\u0928 \u0935\u094d\u092f\u0941\u0924\u094d\u092a\u0928\u094d\u0928 \u0935\u094d\u0939\u0930\u094d\u091a\u094d\u092f\u0941\u0905\u0932 \u0906\u092f\u0921\u0940 \u0938\u0947\u0935\u0947\u091a\u093e \u0935\u093e\u092a\u0930 \u0915\u0930\u0942\u0928 \u0915\u093f\u0902\u0935\u093e \u0967\u096f\u096a\u096d \u0930\u094b\u091c\u0940 \u090f\u0938\u090f\u092e\u090f\u0938 \u092a\u093e\u0920\u0935\u0942\u0928 \u0906\u092a\u0932\u0947 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0935\u094d\u092f\u0941\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e. RVID [UID \u091a\u0947 \u0936\u0947\u0935\u091f\u091a\u0947 4 \u0915\u093f\u0902\u0935\u093e 8 \u0905\u0902\u0915] {ex: RVID 1234}. ",stepOneLinkText:" VID \u0924\u092f\u093e\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e",stepTwoLabel:"\u092a\u093e\u092f\u0930\u0940 3 \u092a\u0948\u0915\u0940 2: ",stepTwoDescription:"\u0924\u0941\u092e\u091a\u093e \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u091c\u0928\u0930\u0947\u091f \u091d\u093e\u0932\u093e \u0915\u0940, \u0915\u0943\u092a\u092f\u093e \u092f\u093e \u092a\u0947\u091c\u0935\u0930 \u092a\u0930\u0924 \u092f\u093e \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u093e \u0906\u0927\u093e\u0930 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940\u0938\u0939 \u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0941\u0922\u0947 \u091c\u093e, \u0924\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u091c\u0947\u0935\u094d\u0939\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0905\u0938\u0947\u0932 \u0924\u0947\u0935\u094d\u0939\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940\u0938\u0939 \u0911\u0925\u0947\u0902\u091f\u093f\u0915\u0947\u091f \u0915\u0930\u093e, \u0915\u093e\u0930\u0923 \u090f\u0915\u0926\u093e \u0932\u0949\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0911\u0925\u0947\u0902\u091f\u093f\u0915\u0947\u0936\u0928\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u093e \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0935\u093e\u092a\u0930\u0923\u0947 \u0905\u0915\u094d\u0937\u092e \u0915\u0947\u0932\u0947 \u091c\u093e\u0908\u0932.",stepThreeLabel:"\u092a\u093e\u092f\u0930\u0940 3 \u092a\u0948\u0915\u0940 3: ",stepThreeDescription:"\u0915\u0943\u092a\u092f\u093e \u092f\u093e \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930 \u092a\u0930\u0924 \u092f\u093e \u0906\u0923\u093f \u0906\u0927\u093e\u0930 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0941\u0922\u0947 \u091c\u093e; \u092b\u0915\u094d\u0924 VID \u092e\u0927\u094d\u092f\u0947 \u0906\u0927\u093e\u0930 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0906\u0939\u0947, \u0924\u0930 \u0906\u0927\u093e\u0930 \u0905\u0928\u0932\u0949\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0947 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915-\u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923\u093e\u0938 \u0926\u0947\u0916\u0940\u0932 \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u092e\u093f\u0933\u0924\u0947."}},formScreen:{title:"\u0915\u0943\u092a\u092f\u093e \u0906\u0927\u093e\u0930 \u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0924\u092a\u0936\u0940\u0932 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",radioLabels:{lockAadhaar:"\u0906\u0927\u093e\u0930 \u0932\u0949\u0915 \u0915\u0930\u093e",unlockAadhaar:"\u0906\u0927\u093e\u0930 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u093e"},consent:{lockConsent:"\u092e\u0932\u093e \u0938\u092e\u091c\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940 \u092e\u093e\u091d\u0947 \u0906\u0927\u093e\u0930 \u0932\u0949\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930, \u092e\u0940 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0928\u0935\u094d\u0939\u0947 \u0924\u0930 \u092b\u0915\u094d\u0924 \u0935\u094d\u0939\u0930\u094d\u091a\u094d\u092f\u0941\u0905\u0932 \u0906\u092f\u0921\u0940 (VID) \u0935\u093e\u092a\u0930\u0942\u0928 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930\u0942 \u0936\u0915\u0947\u0928.",unlockConsent:"\u092e\u0932\u093e \u0938\u092e\u091c\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940 \u092e\u093e\u091d\u0947 \u0906\u0927\u093e\u0930 \u0905\u0928\u0932\u0949\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930, \u092e\u0940 \u0935\u094d\u0939\u0930\u094d\u091a\u094d\u092f\u0941\u0905\u0932 \u0906\u092f\u0921\u0940 (\u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940) \u0906\u0923\u093f \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0926\u094b\u0928\u094d\u0939\u0940 \u0935\u093e\u092a\u0930\u0942\u0928 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u0915\u094d\u0937\u092e \u0905\u0938\u0947\u0932."},textFields:{name:"\u092a\u0942\u0930\u094d\u0923 \u0928\u093e\u0935 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",pincode:"\u092a\u093f\u0928\u0915\u094b\u0921 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e"}}},verifyEmailMobile:{desc:"\u0915\u0943\u092a\u092f\u093e \u0908\u092e\u0947\u0932/\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0924\u092a\u0936\u0940\u0932 \u0928\u093f\u0935\u0921\u093e \u0906\u0923\u093f \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e",verifyMobile:"\u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u093e",verifyEmail:"\u0908\u092e\u0947\u0932 \u092a\u0924\u094d\u0924\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u093e",verifyEmailMobile:"\u0908\u092e\u0947\u0932/\u092e\u094b\u092c\u093e\u0907\u0932 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u093e"},bankLinkingStatus:{sectionTitle:"\u0906\u0927\u093e\u0930 \u092c\u0901\u0915 \u0926\u0941\u0935\u093e \u0938\u093e\u0927\u0923\u094d\u092f\u093e\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u093e",aadhaarNumber:"\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915",bankLinkingStatus:"\u092c\u0901\u0915 \u091c\u094b\u0921\u0923\u094d\u092f\u093e\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940",active:"\u0938\u0915\u094d\u0930\u093f\u092f",inactive:"\u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f",prevBankDetails:"\u092e\u093e\u0917\u0940\u0932 \u092c\u0901\u0915 \u0932\u093f\u0902\u0915\u093f\u0902\u0917 \u0924\u092a\u0936\u0940\u0932",lastUpdatedDate:"\u0905\u0902\u0924\u093f\u092e \u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0924\u093e\u0930\u0940\u0916",failureMessage:"\u092f\u093e \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0938\u093e\u0920\u0940 \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u092c\u0901\u0915 \u092e\u0945\u092a\u093f\u0902\u0917 \u0930\u0947\u0915\u0949\u0930\u094d\u0921 \u0906\u0922\u0933\u0932\u0947 \u0928\u093e\u0939\u0940",successMessage:"\u0924\u0941\u092e\u091a\u0947 \u0906\u0927\u093e\u0930-\u092c\u0901\u0915 \u092e\u0945\u092a\u093f\u0902\u0917 \u091d\u093e\u0932\u0947 \u0906\u0939\u0947",disclaimer:"\u090f\u0928\u092a\u0940\u0938\u0940\u0906\u092f \u0938\u0930\u094d\u0935\u094d\u0939\u0930 \u0935\u0930\u0942\u0928 \u0906\u0927\u093e\u0930 \u091c\u094b\u0921\u0923\u094d\u092f\u093e\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0947\u0932\u0940 \u0906\u0939\u0947. \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u092a\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u0940\u0924, \u092f\u0942\u0906\u092f\u0921\u0940\u090f\u0906\u092f \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0938\u094d\u0925\u093f\u0924\u0940\u091a\u094d\u092f\u093e \u0936\u0941\u0926\u094d\u0927\u0924\u0947\u0938\u093e\u0920\u0940 \u091c\u092c\u093e\u092c\u0926\u093e\u0930 \u0930\u093e\u0939\u0923\u093e\u0930 \u0928\u093e\u0939\u0940. \u092a\u0941\u0922\u0947, \u092f\u0942\u0906\u092f\u0921\u0940\u090f\u0906\u092f \u090f\u0928\u092a\u0940\u0938\u0940\u0906\u092f \u0938\u0930\u094d\u0935\u094d\u0939\u0930\u0935\u0930\u0942\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0947\u0932\u0947\u0932\u0940 \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0938\u0902\u0917\u094d\u0930\u0939\u093f\u0924 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940.",noRecordsAvailable:"\u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u0930\u0947\u0915\u0949\u0930\u094d\u0921 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u093e\u0939\u0940",checkWithBank:"\u0924\u0941\u092e\u091a\u093e \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092c\u0901\u0915 \u0916\u093e\u0924\u094d\u092f\u093e\u0936\u0940 \u091c\u094b\u0921\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092c\u0901\u0915\u0947\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e"},bankSeedingStatus:{AadhaarNumber:"\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915",BankName:"\u092c\u0901\u0915\u0947\u091a\u0947 \u0928\u093e\u0935",BankSeedingStatus:"\u092c\u0901\u0915 \u0938\u0940\u0921\u093f\u0902\u0917 \u0938\u094d\u0925\u093f\u0924\u0940",LastUpdatedDate:"\u0905\u0902\u0924\u093f\u092e \u0905\u0926\u094d\u092f\u0924\u0928\u093f\u0924 \u0924\u093e\u0930\u0940\u0916",noRecordAlert:"\u0924\u0941\u092e\u091a\u093e \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092c\u0901\u0915 \u0916\u093e\u0924\u094d\u092f\u093e\u0936\u0940 \u0932\u093f\u0902\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092c\u0901\u0915\u0947\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e",note:"\u0932\u093f\u0902\u0915\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0947\u0932\u0947\u0932\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0928\u0945\u0936\u0928\u0932 \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0949\u0930\u094d\u092a\u094b\u0930\u0947\u0936\u0928 \u0911\u092b \u0907\u0902\u0921\u093f\u092f\u093e (NPCI) \u091a\u094d\u092f\u093e \u0938\u0930\u094d\u0935\u094d\u0939\u0930\u0935\u0930\u0942\u0928 \u0906\u0923\u0932\u0940 \u0917\u0947\u0932\u0940 \u0906\u0939\u0947. \u092f\u0942\u0906\u092f\u0921\u0940\u090f\u0906\u092f \u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0905\u091a\u0942\u0915\u0924\u0947\u0938\u093e\u0920\u0940 \u091c\u092c\u093e\u092c\u0926\u093e\u0930 \u0928\u093e\u0939\u0940. \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0947\u0932\u0947\u0932\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 UIDAI \u0926\u094d\u0935\u093e\u0930\u0947 \u0938\u0902\u0917\u094d\u0930\u0939\u093f\u0924 \u0915\u0947\u0932\u0947\u0932\u0940 \u0928\u093e\u0939\u0940.",ActiveText:"\u0938\u0915\u094d\u0930\u093f\u092f",InactiveText:"\u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f"},FAQ:{checkAadhaarPvcCardOrderStatus:[{question:"\u0906\u0927\u093e\u0930\u091a\u0947 \u0935\u0947\u0917\u0935\u0947\u0917\u0933\u0947 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u094b\u0923\u0924\u0947 \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0902\u091a\u0940 \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f\u0947 \u0915\u093e\u092f \u0906\u0939\u0947\u0924?",answer:"\u0906\u0927\u093e\u0930\u091a\u0947 \u0935\u0947\u0917\u0935\u0947\u0917\u0933\u0947 \u0938\u094d\u0935\u0930\u0942\u092a \u092e\u094d\u0939\u0923\u091c\u0947 \u0906\u0927\u093e\u0930 \u092a\u0924\u094d\u0930, \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921, eAadhaar \u0906\u0923\u093f mAadhaar. \u0906\u0927\u093e\u0930\u091a\u0947 \u0938\u0930\u094d\u0935 \u092a\u094d\u0930\u0915\u093e\u0930 \u0938\u093e\u0930\u0916\u0947\u091a \u0935\u0948\u0927 \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u094d\u092f."},{question:"\u092e\u0940 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u092a\u094d\u0930\u0915\u093e\u0930\u091a\u0947 \u0906\u0927\u093e\u0930 \u0905\u0938\u0923\u0947 \u0906\u0923\u093f \u0935\u093e\u092a\u0930\u0923\u0947 \u0928\u093f\u0935\u0921\u0942 \u0936\u0915\u0924\u094b \u0915\u093e?",answer:"\u0939\u094b\u092f"},{question:"\u0911\u0930\u094d\u0921\u0930 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0938\u0947\u0935\u093e \u0915\u093e\u092f \u0906\u0939\u0947?",answer:"\u0911\u0930\u094d\u0921\u0930 \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0939\u0940 UIDAI \u0928\u0947 \u0938\u0941\u0930\u0942 \u0915\u0947\u0932\u0947\u0932\u0940 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u093e \u0906\u0939\u0947 \u091c\u0940 \u0906\u0927\u093e\u0930 \u0927\u093e\u0930\u0915\u093e\u0902\u0928\u093e \u0924\u094d\u092f\u093e\u0902\u091a\u0947 \u0906\u0927\u093e\u0930 \u0924\u092a\u0936\u0940\u0932 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u0926\u0947\u0924\u0947.  \u0928\u093e\u092e\u092e\u093e\u0924\u094d\u0930 \u0936\u0941\u0932\u094d\u0915 \u092d\u0930\u0942\u0928 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921\u0935\u0930 \u091b\u093e\u092a\u0932\u0947 \u091c\u093e\u0924\u0947."},{question:"\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u091a\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f\u0947 \u0915\u093e\u092f \u0906\u0939\u0947\u0924?",answer:"\u092f\u093e \u0915\u093e\u0930\u094d\u0921\u092e\u0927\u094d\u092f\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f\u0947 \u0906\u0939\u0947\u0924 \u091c\u0938\u0947:                                                1. \u091b\u0947\u0921\u091b\u093e\u0921 \u092a\u094d\u0930\u0942\u092b QR \u0915\u094b\u0921,                                                                 2. \u0939\u094b\u0932\u094b\u0917\u094d\u0930\u093e\u092e                                                                                      3. \u0938\u0942\u0915\u094d\u0937\u094d\u092e \u092e\u091c\u0915\u0942\u0930                                                                                 4. \u092d\u0942\u0924 \u092a\u094d\u0930\u0924\u093f\u092e\u093e                                                                                   5. \u091c\u093e\u0930\u0940 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0924\u093e\u0930\u0940\u0916 \u0906\u0923\u093f \u092e\u0941\u0926\u094d\u0930\u093f\u0924 \u0924\u093e\u0930\u0940\u0916,                                        6. Guilloche \u0928\u092e\u0941\u0928\u093e,                                                                          7. \u090f\u092e\u094d\u092c\u0949\u0938\u094d\u0921 \u0906\u0927\u093e\u0930 \u0932\u094b\u0917\u094b"},{question:"\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0938\u093e\u0920\u0940 \u0915\u094b\u0923\u0924\u0947 \u0936\u0941\u0932\u094d\u0915 \u092d\u0930\u093e\u0935\u0947 \u0932\u093e\u0917\u0947\u0932?",answer:"\u092d\u0930\u093e\u0935\u0947 \u0932\u093e\u0917\u0923\u093e\u0930\u0947 \u0936\u0941\u0932\u094d\u0915 \u0930\u0941. 50/- (\u091c\u0940\u090f\u0938\u091f\u0940 \u0906\u0923\u093f \u0938\u094d\u092a\u0940\u0921 \u092a\u094b\u0938\u094d\u091f \u0936\u0941\u0932\u094d\u0915\u093e\u0902\u0938\u0939) \u0906\u0939\u0947\u0924."},{question:"\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0938\u093e\u0920\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0936\u0940 \u0915\u0930\u0942 \u0936\u0915\u0924\u0947?",answer:"\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921' \u0935\u093f\u0928\u0902\u0924\u0940 UIDAI \u0905\u0927\u093f\u0915\u0943\u0924 \u0935\u0947\u092c\u0938\u093e\u0907\u091f (https://www.uidai.gov.in \u0915\u093f\u0902\u0935\u093e https://myaadhaar.uidai.gov.in) \u0915\u093f\u0902\u0935\u093e mAadhaar \u090d\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928\u0932\u093e \u092d\u0947\u091f \u0926\u0947\u090a\u0928 \u0915\u0947\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924\u0947."},{question:"\u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0935\u093e\u092a\u0930\u0942\u0928 \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0936\u0940 \u0915\u0930\u093e\u0935\u0940?",answer:"1. \u0915\u0943\u092a\u092f\u093e https://uidai.gov.in \u0915\u093f\u0902\u0935\u093e https://myaadhaar.uidai.gov.in/genricPVC \u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e.                                2. \u0924\u0941\u092e\u091a\u093e 12 \u0905\u0902\u0915\u0940 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 (UID) \u0915\u093f\u0902\u0935\u093e 28 \u0905\u0902\u0915\u0940 \u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0906\u092f\u0921\u0940 \u091f\u093e\u0915\u093e.                                                                                                                     3. \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u094b\u0921 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e.                                                                                   4. \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0935\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u091d\u093e\u0932\u0947\u0932\u093e OTP \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e.                  5. \u201c\u091f\u0930\u094d\u092e\u094d\u0938 \u0905\u0901\u0921 \u0915\u0902\u0921\u093f\u0936\u0928\u201d \u092e\u0927\u0940\u0932 \u091a\u0947\u0915 \u092c\u0949\u0915\u094d\u0938\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. (\u091f\u0940\u092a: \u0924\u092a\u0936\u0940\u0932 \u092a\u093e\u0939\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0939\u093e\u092f\u092a\u0930 \u0932\u093f\u0902\u0915\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e).                                                       6. OTP \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 '\u0938\u092c\u092e\u093f\u091f' \u092c\u091f\u0923\u093e\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e.           7. \u092a\u0941\u0922\u0940\u0932 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0935\u0930, \u092a\u0941\u0928\u0930\u094d\u092e\u0941\u0926\u094d\u0930\u0923\u093e\u0938\u093e\u0920\u0940 \u0911\u0930\u094d\u0921\u0930 \u0926\u0947\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u0921\u0924\u093e\u0933\u0923\u0940\u0938\u093e\u0920\u0940 \u0906\u0927\u093e\u0930 \u0924\u092a\u0936\u0940\u0932\u093e\u091a\u0947 \u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928 \u0926\u093f\u0938\u0947\u0932.                                   8. '\u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0930\u093e' \u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0915\u094d\u0930\u0947\u0921\u093f\u091f/\u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921, \u0928\u0947\u091f \u092c\u0901\u0915\u093f\u0902\u0917 \u0906\u0923\u093f \u092a\u0947\u092e\u0947\u0902\u091f \u092a\u0930\u094d\u092f\u093e\u092f\u093e\u0902\u0938\u0939 \u092a\u0947\u092e\u0947\u0902\u091f \u0917\u0947\u091f\u0935\u0947 \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930 \u092a\u0941\u0928\u094d\u0939\u093e \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u0947\u0932\u0947 \u091c\u093e\u0908\u0932.             9. \u092f\u0936\u0938\u094d\u0935\u0940 \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930, \u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u094d\u0935\u093e\u0915\u094d\u0937\u0930\u0940 \u0905\u0938\u0932\u0947\u0932\u0940 \u092a\u093e\u0935\u0924\u0940 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u0940 \u091c\u093e\u0908\u0932 \u091c\u0940 \u092a\u0940\u0921\u0940\u090f\u092b \u092b\u0949\u0930\u092e\u0945\u091f\u092e\u0927\u094d\u092f\u0947 \u0930\u0939\u093f\u0935\u093e\u0938\u0940 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0942 \u0936\u0915\u0924\u0947. \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0928\u093e \u090f\u0938\u090f\u092e\u090f\u0938\u0926\u094d\u0935\u093e\u0930\u0947 \u0938\u0947\u0935\u093e \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0926\u0947\u0916\u0940\u0932 \u092e\u093f\u0933\u0947\u0932.                       10.  \u0924\u092a\u093e\u0938\u093e \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u0938\u094d\u0925\u093f\u0924\u0940\u0935\u0930 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u092a\u093e\u0920\u0935\u0932\u0947 \u091c\u093e\u0908\u092a\u0930\u094d\u092f\u0902\u0924 \u0906\u0927\u093e\u0930 \u0927\u093e\u0930\u0915 \u090f\u0938. \u0906\u0930. \u090f\u0928. \u091a\u094d\u092f\u093e \u0938\u094d\u0925\u093f\u0924\u0940\u091a\u093e \u092e\u093e\u0917\u094b\u0935\u093e \u0918\u0947\u090a \u0936\u0915\u0924\u094b.                                11. DoP \u0935\u0930\u0942\u0928 \u092a\u093e\u0920\u0935\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 AWB \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0905\u0938\u0932\u0947\u0932\u0947 SMS \u0926\u0947\u0916\u0940\u0932 \u092a\u093e\u0920\u0935\u0932\u0947 \u091c\u093e\u0924\u0940\u0932. \u0906\u0927\u093e\u0930 \u0927\u093e\u0930\u0915 \u092d\u0947\u091f \u0926\u0947\u090a\u0928 \u0935\u093f\u0924\u0930\u0923 \u0938\u094d\u0925\u093f\u0924\u0940\u091a\u093e \u092a\u0941\u0922\u0940\u0932 \u092e\u093e\u0917\u094b\u0935\u093e \u0918\u0947\u090a \u0936\u0915\u0924\u094b DoP \u0935\u0947\u092c\u0938\u093e\u0907\u091f."},{question:"\u0928\u0949\u0928-\u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924/\u092a\u0930\u094d\u092f\u093e\u092f\u0940 \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930 \u0935\u093e\u092a\u0930\u0942\u0928 \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0936\u0940 \u0915\u0930\u093e\u0935\u0940?",answer:"\u0915\u0943\u092a\u092f\u093e https://uidai.gov.in \u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e \u0915\u093f\u0902\u0935\u093e https://myaadhaar.uidai.gov.in/genricPVC '\u0911\u0930\u094d\u0921\u0930 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921' \u0938\u0947\u0935\u093e \u0915\u093f\u0902\u0935\u093e mAadhaar \u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. \u0905\u0930\u094d\u091c \u0924\u0941\u092e\u091a\u093e 12 \u0905\u0902\u0915\u0940 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 (UID) \u0915\u093f\u0902\u0935\u093e 28 \u0905\u0902\u0915\u0940 \u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0906\u092f\u0921\u0940 \u091f\u093e\u0915\u093e. \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u094b\u0921 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e \u091a\u0947\u0915 \u092c\u0949\u0915\u094d\u0938\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e.  '\u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0915\u0921\u0947 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0928\u0938\u0932\u094d\u092f\u093e\u0938, \u0915\u0943\u092a\u092f\u093e \u092c\u0949\u0915\u094d\u0938\u092e\u0927\u094d\u092f\u0947 \u091a\u0947\u0915 \u0915\u0930\u093e'. \u0915\u0943\u092a\u092f\u093e \u0928\u0949\u0928-\u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924/\u092a\u0930\u094d\u092f\u093e\u092f\u0940 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e. \u0928\u0949\u0928-\u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0935\u093e\u092a\u0930\u0942\u0928 \u0911\u0930\u094d\u0921\u0930 \u0915\u0930\u0923\u093e\u0931\u094d\u092f\u093e \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0938\u093e\u0920\u0940 \u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u094b\u0923\u093e\u0930 \u0928\u093e\u0939\u0940. \u0911\u0930\u094d\u0921\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092c\u093e\u0915\u0940\u091a\u094d\u092f\u093e \u092a\u093e\u092f\u0931\u094d\u092f\u093e \u0938\u092e\u093e\u0928 \u0930\u093e\u0939\u0924\u0940\u0932."},{question:"\u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u094b\u0923\u0924\u0947 \u092e\u094b\u0921 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947\u0924?",answer:"\u0938\u0927\u094d\u092f\u093e, \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0916\u093e\u0932\u0940\u0932 \u0911\u0928\u0932\u093e\u0907\u0928 \u092a\u0947\u092e\u0947\u0902\u091f \u092e\u094b\u0921 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947\u0924:-\u0915\u094d\u0930\u0947\u0921\u093f\u091f \u0915\u093e\u0930\u094d\u0921                                                                                 \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921                                                                                     \u0928\u0947\u091f \u092c\u0901\u0915\u093f\u0902\u0917                                                                                     UPI                                                                                                                \u092a\u0947\u091f\u0940\u090f\u092e"},{question:"SRN \u092e\u094d\u0939\u0923\u091c\u0947 \u0915\u093e\u092f?",answer:"SRN \u0939\u093e 14 \u0905\u0902\u0915\u0940 \u0938\u0947\u0935\u093e \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0906\u0939\u0947 \u091c\u094b \u0906\u0927\u093e\u0930 \u0905\u092a\u0921\u0947\u091f\u0938\u093e\u0920\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0935\u093e\u0922\u0935\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u093e \u091c\u093e\u0924\u094b. \u0924\u0941\u092e\u094d\u0939\u0940 \u090f\u0915\u0926\u093e\u091a \u0924\u0947 \u091c\u0928\u0930\u0947\u091f \u0915\u0947\u0932\u0947 \u091c\u093e\u0908\u0932.  \u0935\u093f\u0928\u0902\u0924\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0923\u0947 \u0938\u0941\u0930\u0942 \u0915\u0930\u093e. \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092a\u0942\u0930\u094d\u0923 \u0939\u094b\u0908\u092a\u0930\u094d\u092f\u0902\u0924 '\u0930\u0947\u091d\u094d\u092f\u0941\u092e\u0947' \u092a\u0930\u094d\u092f\u093e\u092f \u0909\u092a\u0932\u092c\u094d\u0927 \u0905\u0938\u0947\u0932."},{question:"AWB \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0915\u093e\u092f \u0906\u0939\u0947?",answer:"\u090f\u0905\u0930\u0935\u0947 \u092c\u093f\u0932 \u0928\u0902\u092c\u0930 \u0939\u093e \u091f\u094d\u0930\u0945\u0915\u093f\u0902\u0917 \u0928\u0902\u092c\u0930 \u0906\u0939\u0947 \u091c\u094b \u0921\u0940\u0913\u092a\u0940 \u0926\u094d\u0935\u093e\u0930\u0947 \u0935\u094d\u092f\u0941\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0947\u0932\u093e \u091c\u093e\u0924\u094b, \u092e\u094d\u0939\u0923\u091c\u0947 \u092d\u093e\u0930\u0924 \u0938\u094d\u092a\u0940\u0921 \u092a\u094b\u0938\u094d\u091f \u091c\u094d\u092f\u093e \u0905\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f/\u0909\u0924\u094d\u092a\u093e\u0926\u0928\u093e\u0938\u093e\u0920\u0940 \u0924\u0947 \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u0930\u0924\u093e\u0924"},{question:"\u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0928\u093e \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0924\u094d\u092f\u093e\u0902\u0928\u093e \u0939\u0935\u094d\u092f\u093e \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0924\u092a\u0936\u0940\u0932\u093e\u0902\u0938\u0939 \u091b\u093e\u092a\u093e\u092f\u091a\u0947 \u0905\u0938\u0932\u094d\u092f\u093e\u0938 \u0915\u093e\u092f?",answer:"\u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0928\u093e \u092e\u0941\u0926\u094d\u0930\u093f\u0924 \u0906\u0927\u093e\u0930 \u092a\u0924\u094d\u0930 \u0915\u093f\u0902\u0935\u093e \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921\u091a\u094d\u092f\u093e \u0924\u092a\u0936\u093f\u0932\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u0915\u093e\u0939\u0940 \u092c\u0926\u0932 \u0939\u0935\u0947 \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0924\u094d\u092f\u093e\u0902\u0928\u0940 \u092a\u094d\u0930\u0925\u092e \u0915\u093e\u092f\u092e\u0938\u094d\u0935\u0930\u0942\u092a\u0940 \u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u093f\u0902\u0935\u093e \u090f\u0938\u090f\u0938\u092f\u0942\u092a\u0940 \u092a\u094b\u0930\u094d\u091f\u0932\u0935\u0930 (\u0905\u092a\u0921\u0947\u091f\u0935\u0930 \u0905\u0935\u0932\u0902\u092c\u0942\u0928) \u091c\u093e\u090a\u0928 \u0924\u094d\u092f\u093e\u0902\u091a\u0947 \u0906\u0927\u093e\u0930 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u093e\u0935\u0947 \u0932\u093e\u0917\u0924\u0940\u0932 \u0906\u0923\u093f \u0928\u0902\u0924\u0930 \u0935\u093f\u0928\u0902\u0924\u0940 \u0935\u093e\u0922\u0935\u093e\u0935\u0940 \u0915\u093e\u0930\u0923 \u0939\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u093e\u092a\u0930\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924\u0947. \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921/\u092a\u0924\u094d\u0930\u093e\u091a\u0940 \u0939\u093e\u0930\u094d\u0921 \u0915\u0949\u092a\u0940."},{question:"\u092f\u0936\u0938\u094d\u0935\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 '\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921' \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u093f\u0924\u0940 \u0926\u093f\u0935\u0938 \u0932\u093e\u0917\u0924\u0940\u0932?",answer:"\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915\u093e\u0915\u0921\u0942\u0928 \u0906\u0927\u093e\u0930 PVC \u0915\u093e\u0930\u094d\u0921\u0938\u093e\u0920\u0940 \u0911\u0930\u094d\u0921\u0930 \u092e\u093f\u0933\u093e\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930, UIDAI \u091b\u093e\u092a\u0940\u0932 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 5 \u0915\u093e\u092e\u0915\u093e\u091c\u093e\u091a\u094d\u092f\u093e \u0926\u093f\u0935\u0938\u093e\u0902\u0924 (\u0935\u093f\u0928\u0902\u0924\u0940\u091a\u0940 \u0924\u093e\u0930\u0940\u0916 \u0935\u0917\u0933\u0942\u0928) DoP \u0932\u093e \u0938\u0941\u092a\u0942\u0930\u094d\u0926 \u0915\u0930\u0924\u0947. \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u092d\u093e\u0930\u0924\u0940\u092f \u092a\u094b\u0938\u094d\u091f\u091a\u094d\u092f\u093e \u0938\u094d\u092a\u0940\u0921 \u092a\u094b\u0938\u094d\u091f \u0938\u0947\u0935\u0947\u0926\u094d\u0935\u093e\u0930\u0947 \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e\u092c\u0947\u0938\u092e\u0927\u094d\u092f\u0947 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u0935\u0930 \u0938\u0927\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0935\u093f\u0924\u0930\u0923 \u0928\u093f\u092f\u092e\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u0947. \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915 https://www.indiapost.gov.in/_layouts/15/dop.portal.track \u0935\u0930 DoP \u091f\u094d\u0930\u0945\u0915\u093f\u0902\u0917 \u0938\u0947\u0935\u093e \u0935\u093e\u092a\u0930\u0942\u0928 \u0935\u093f\u0924\u0930\u0923 \u0938\u094d\u0925\u093f\u0924\u0940\u091a\u093e \u092e\u093e\u0917\u094b\u0935\u093e \u0918\u0947\u090a \u0936\u0915\u0924\u094b."}],verifyEmailMobile:[{question:"\u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930 \u0924\u092a\u0936\u0940\u0932 \u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u093e\u0939\u0940 \u0936\u0941\u0932\u094d\u0915 \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0906\u0939\u0947 \u0915\u093e?",answer:"\u0939\u094b\u092f, \u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f \u092e\u093e\u0939\u093f\u0924\u0940\u091a\u094d\u092f\u093e \u0911\u0928\u0932\u093e\u0907\u0928 \u0905\u092a\u0921\u0947\u091f\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0930\u0941. 50/- (\u091c\u0940\u090f\u0938\u091f\u0940\u0938\u0939)."}],orderAadhaarPvcCard:[{question:"\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915 \u0908-\u0906\u0927\u093e\u0930 \u0915\u094b\u0920\u0942\u0928 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b?",answer:"\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915 UIDAI \u091a\u094d\u092f\u093e MyAadhaar porta- https://myaadhaar.uidai.gov.in \u0935\u0930 \u092d\u0947\u091f \u0926\u0947\u090a\u0928 \u0915\u093f\u0902\u0935\u093e \u0935\u093e\u092a\u0930\u0942\u0928 \u0908-\u0906\u0927\u093e\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b."}],retrieveEidAadhaarNumber:[{question:"\u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e \u0915\u093f\u0924\u0940 \u0935\u0947\u0933\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0947\u0932\u093e \u091c\u093e\u090a \u0936\u0915\u0924\u094b?",answer:"\u0906\u0927\u093e\u0930 \u092e\u093e\u0939\u093f\u0924\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0916\u093e\u0932\u0940\u0932 \u092e\u0930\u094d\u092f\u093e\u0926\u093e \u0932\u093e\u0917\u0942 \u0906\u0939\u0947\u0924:                 \u2022 \u0928\u093e\u0935: \u0906\u092f\u0941\u0937\u094d\u092f\u093e\u0924 \u0926\u094b\u0928\u0926\u093e                                                                        \u2022 \u0932\u093f\u0902\u0917: \u0906\u092f\u0941\u0937\u094d\u092f\u093e\u0924 \u090f\u0915\u0926\u093e\u091a                                                                     \u2022 \u091c\u0928\u094d\u092e\u0924\u093e\u0930\u0940\u0916: \u0906\u092f\u0941\u0937\u094d\u092f\u093e\u0924 \u090f\u0915\u0926\u093e\u091a"},{question:"\u0906\u0927\u093e\u0930\u092e\u0927\u0940\u0932 \u092e\u093e\u091d\u094d\u092f\u093e \u0928\u093e\u0935\u093e\u0924 \u092e\u0940 \u0915\u094b\u0923\u0924\u0947 \u092c\u0926\u0932 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b?",answer:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0928\u093e\u0935\u093e\u0924\u0940\u0932 \u0915\u093f\u0930\u0915\u094b\u0933 \u0926\u0941\u0930\u0941\u0938\u094d\u0924\u094d\u092f\u093e \u0915\u093f\u0902\u0935\u093e \u0928\u093e\u0935 \u092c\u0926\u0932\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0915\u0943\u092a\u092f\u093e \u091c\u0935\u0933\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e."},{question:"\u0911\u0928\u0932\u093e\u0907\u0928 \u092a\u0924\u094d\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u094b\u0923\u0924\u0940 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947\u0924?",answer:"\u0938\u092e\u0930\u094d\u0925\u0928 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0938\u0942\u091a\u0940\u0928\u0941\u0938\u093e\u0930 POA \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0906\u0935\u0936\u094d\u092f\u0915 \u0905\u0938\u0947\u0932. https://uidai.gov.in \u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e."},{question:"\u0906\u0927\u093e\u0930 \u092a\u0924\u094d\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u094b\u0923\u0924\u0940 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947\u0924?",answer:"\u0924\u0941\u092e\u094d\u0939\u0940 \u0928\u093f\u0935\u0921\u0942 \u0936\u0915\u0924\u093e \u0905\u0936\u093e \u0906\u0927\u093e\u0930\u092d\u0942\u0924 \u0926\u0938\u094d\u0924\u0910\u0935\u091c\u093e\u0902\u091a\u0940 \u092f\u093e\u0926\u0940 \u092f\u0947\u0925\u0947 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947. \u0915\u0943\u092a\u092f\u093e \u0938\u0942\u091a\u0940\u092e\u0927\u0942\u0928 \u092f\u094b\u0917\u094d\u092f \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0928\u093f\u0935\u0921\u093e \u0906\u0923\u093f \u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f \u0921\u0947\u091f\u093e \u0926\u0941\u0930\u0941\u0938\u094d\u0924 \u0915\u0930\u0924\u093e\u0928\u093e \u0924\u094d\u092f\u093e\u091a\u0940 \u0938\u094d\u0915\u0945\u0928/\u0907\u092e\u0947\u091c \u0926\u094d\u092f\u093e."},{question:"\u0972\u0921\u094d\u0930\u0947\u0938 \u0905\u092a\u0921\u0947\u091f \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u0947\u091a\u094d\u092f\u093e \u092c\u093e\u092c\u0924\u0940\u0924 \u092e\u0940 \u092e\u093e\u091d\u0940 \u0938\u0939\u093e\u092f\u094d\u092f\u0915 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0915\u0936\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u094b?",answer:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0938\u0939\u093e\u092f\u094d\u092f\u0915 \u0926\u0938\u094d\u0924\u0910\u0935\u091c\u093e\u091a\u0940 \u0938\u094d\u0915\u0945\u0928/\u0907\u092e\u0947\u091c pdf \u0915\u093f\u0902\u0935\u093e jpeg \u092b\u0949\u0930\u092e\u0945\u091f\u092e\u0927\u094d\u092f\u0947 \u0905\u092a\u0921\u0947\u091f \u0972\u0921\u094d\u0930\u0947\u0938 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u0947\u092e\u0927\u094d\u092f\u0947 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u093e\u0902\u0917\u093f\u0924\u0932\u0947 \u091c\u093e\u0908\u0932. \u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0935\u093f\u0928\u0902\u0924\u0940\u0935\u0930 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u094b\u0917\u094d\u092f \u0938\u0939\u093e\u092f\u094d\u092f\u0915 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u093e. \u092a\u093e\u0938\u092a\u094b\u0930\u094d\u091f, \u092d\u093e\u0921\u0947 \u0906\u0923\u093f \u092e\u093e\u0932\u092e\u0924\u094d\u0924\u093e \u0915\u0930\u093e\u0930 \u092f\u093e\u0902\u0938\u093e\u0930\u0916\u094d\u092f\u093e \u0915\u093e\u0939\u0940 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u093e\u0902\u0938\u093e\u0920\u0940, \u090f\u0915\u093e\u0927\u093f\u0915 \u092a\u0943\u0937\u094d\u0920\u093e\u0902\u091a\u0940 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0905\u0938\u0947\u0932."},{question:"\u0906\u0927\u093e\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u0947\u0926\u094d\u0935\u093e\u0930\u0947 \u092e\u0940 \u092e\u093e\u091d\u0940 \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u092d\u093e\u0937\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u094b \u0915\u093e?",answer:"\u0938\u0927\u094d\u092f\u093e \u0924\u0941\u092e\u094d\u0939\u0940 \u0911\u0928\u0932\u093e\u0907\u0928 \u092a\u094b\u0930\u094d\u091f\u0932\u0926\u094d\u0935\u093e\u0930\u0947 \u0924\u0941\u092e\u091a\u0940 \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u092d\u093e\u0937\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0942 \u0936\u0915\u0924 \u0928\u093e\u0939\u0940."},{question:"\u0906\u0927\u093e\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u0947\u0926\u094d\u0935\u093e\u0930\u0947 \u092e\u0940 \u092e\u093e\u091d\u0940 \u091c\u0928\u094d\u092e\u0924\u093e\u0930\u0940\u0916 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u094b \u0915\u093e?",answer:"\u0928\u093e\u0939\u0940, \u091c\u0928\u094d\u092e\u0924\u093e\u0930\u0940\u0916 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 (DoB) \u0915\u0943\u092a\u092f\u093e DoB \u092a\u0941\u0930\u093e\u0935\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u093e\u0938\u0939 \u091c\u0935\u0933\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e."},{question:"\u092e\u0940 \u092e\u093e\u091d\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u092e\u0927\u094d\u092f\u0947 \u091c\u0928\u094d\u092e\u0924\u093e\u0930\u0940\u0916 \u0906\u0927\u0940\u091a \u0905\u092a\u0921\u0947\u091f \u0915\u0947\u0932\u0940 \u0906\u0939\u0947. \u092e\u0940 \u0924\u0947 \u0905\u092a\u0921\u0947\u091f/\u0926\u0941\u0930\u0941\u0938\u094d\u0924 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b \u0915\u093e?",answer:"\u0928\u093e\u0939\u0940. \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u0940 \u091c\u0928\u094d\u092e\u0924\u093e\u0930\u0940\u0916 (DoB) \u092b\u0915\u094d\u0924 \u090f\u0915\u0926\u093e\u091a \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e. \u092a\u0941\u0922\u0940\u0932 \u091c\u0928\u094d\u092e\u0924\u093e\u0930\u0940\u0916 (DoB) \u0905\u092a\u0935\u093e\u0926\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u0940\u0924 \u092c\u0926\u0932\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924\u0947, \u0915\u0943\u092a\u092f\u093e \u092f\u093e \u0938\u0902\u0926\u0930\u094d\u092d\u093e\u0924 1947 \u0935\u0930 \u0915\u0949\u0932 \u0915\u0930\u093e."},{question:"\u0935\u093f\u0928\u0902\u0924\u0940 \u0938\u093e\u0926\u0930 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0947 \u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f \u092e\u093e\u0939\u093f\u0924\u0940\u091a\u094d\u092f\u093e \u0905\u092a\u0921\u0947\u091f\u091a\u0940 \u0939\u092e\u0940 \u092e\u093f\u0933\u0924\u0947 \u0915\u093e?",answer:"\u092e\u093e\u0939\u093f\u0924\u0940 \u0938\u093e\u0926\u0930 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0947 \u0906\u0927\u093e\u0930 \u0921\u0947\u091f\u093e \u0905\u092a\u0921\u0947\u091f\u091a\u0940 \u0939\u092e\u0940 \u092e\u093f\u0933\u0924 \u0928\u093e\u0939\u0940. \u0905\u092a\u0921\u0947\u091f \u0906\u0927\u093e\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u0947\u0926\u094d\u0935\u093e\u0930\u0947 \u0938\u092c\u092e\u093f\u091f \u0915\u0947\u0932\u0947\u0932\u0947 \u092c\u0926\u0932 UIDAI \u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u0906\u0923\u093f \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923\u093e\u091a\u094d\u092f\u093e \u0905\u0927\u0940\u0928 \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923\u093e\u0928\u0902\u0924\u0930 \u0915\u0947\u0935\u0933 \u0906\u0927\u093e\u0930 \u0905\u092a\u0921\u0947\u091f\u0938\u093e\u0920\u0940 \u092c\u0926\u0932 \u0935\u093f\u0928\u0902\u0924\u0940\u0935\u0930 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947\u0932\u0940 \u091c\u093e\u0924\u0947."},{question:"\u092e\u093e\u091d\u093e \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930 \u0939\u0930\u0935\u0932\u093e \u0906\u0939\u0947/ \u092e\u0940 \u0906\u0927\u093e\u0930 \u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u0947\u0932\u0947\u0932\u093e \u0928\u0902\u092c\u0930 \u092e\u093e\u091d\u094d\u092f\u093e\u0915\u0921\u0947 \u0928\u093e\u0939\u0940. \u092e\u0940 \u092e\u093e\u091d\u0940 \u0905\u092a\u0921\u0947\u091f \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0936\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u093e\u0935\u0940?",answer:"\u091c\u0930 \u0924\u0941\u092e\u091a\u093e \u0906\u0927\u093e\u0930 \u0938\u094b\u092c\u0924 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930 \u0939\u0930\u0935\u0932\u093e \u0905\u0938\u0947\u0932/ \u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0915\u0921\u0947 \u0928\u0938\u0947\u0932, \u0924\u0930 \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915\u0930\u093f\u0924\u094d\u092f\u093e \u091c\u0935\u0933\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e\u0935\u0940 \u0932\u093e\u0917\u0947\u0932."},{question:"\u092e\u093e\u091d\u093e \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0905\u092a\u0921\u0947\u091f \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u092c\u0926\u0932\u0932\u093e \u091c\u093e\u0908\u0932 \u0915\u093e?",answer:"\u0928\u093e\u0939\u0940, \u0924\u0941\u092e\u091a\u093e \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0905\u092a\u0921\u0947\u091f \u091d\u093e\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930\u0939\u0940 \u0924\u094b\u091a \u0930\u093e\u0939\u0940\u0932."},{question:"\u092e\u0932\u093e \u0905\u092a\u0921\u0947\u091f \u0935\u093f\u0928\u0902\u0924\u0940 \u0930\u0926\u094d\u0926 \u0915\u0930\u093e\u092f\u091a\u0940 \u0906\u0939\u0947. \u092e\u0940 \u0924\u0947 \u0915\u0930\u0942 \u0936\u0915\u0947\u0928 \u0915\u093e?",answer:"\u092a\u0941\u0922\u0940\u0932 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u0947\u0938\u093e\u0920\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0909\u091a\u0932\u0947\u092a\u0930\u094d\u092f\u0902\u0924 \u0930\u0939\u093f\u0935\u093e\u0938\u0940 myAadhaar \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921\u092e\u0927\u0940\u0932 \u2018\u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e\u2019 \u091c\u093e\u0917\u0947\u0935\u0930\u0942\u0928 \u0905\u092a\u0921\u0947\u091f \u0935\u093f\u0928\u0902\u0924\u0940 \u0930\u0926\u094d\u0926 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b. \u0930\u0926\u094d\u0926 \u0915\u0947\u0932\u094d\u092f\u093e\u0938, \u092d\u0930\u0932\u0947\u0932\u0940 \u0930\u0915\u094d\u0915\u092e 21 \u0926\u093f\u0935\u0938\u093e\u0902\u091a\u094d\u092f\u093e \u0906\u0924 \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u092a\u0930\u0924 \u0915\u0947\u0932\u0940 \u091c\u093e\u0908\u0932."},{question:"\u092e\u0940 \u092e\u093e\u091d\u094d\u092f\u093e \u0938\u0930\u094d\u0935 \u0905\u092a\u0921\u0947\u091f \u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e \u0915\u0941\u0920\u0947 \u092a\u093e\u0939\u0942 \u0936\u0915\u0924\u094b?",answer:"\u0930\u0939\u093f\u0935\u093e\u0938\u0940 \u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e/\u0924\u093f\u091a\u094d\u092f\u093e \u0905\u092a\u0921\u0947\u091f \u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e MyAadhaar \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921\u092e\u0927\u0940\u0932 \u2018\u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e\u2019 \u0938\u094d\u092a\u0947\u0938\u092e\u0927\u094d\u092f\u0947 \u092a\u093e\u0939\u0942 \u0936\u0915\u0924\u094b."},{question:"\u092e\u093e\u091d\u094d\u092f\u093e \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u0935\u0930 \u092e\u0940 \u092e\u093e\u091d\u094d\u092f\u093e \u0935\u0921\u093f\u0932\u093e\u0902\u091a\u0947/\u092a\u0924\u0940\u091a\u0947 \u0928\u093e\u0935 \u0915\u0938\u0947 \u091c\u094b\u0921\u0942?",answer:"\u0930\u093f\u0932\u0947\u0936\u0928\u0936\u093f\u092a \u0921\u093f\u091f\u0947\u0932\u094d\u0938 \u0939\u093e \u0906\u0927\u093e\u0930\u092e\u0927\u0940\u0932 \u0972\u0921\u094d\u0930\u0947\u0938 \u092b\u0940\u0932\u094d\u0921\u091a\u093e \u090f\u0915 \u092d\u093e\u0917 \u0906\u0939\u0947. \u0939\u0947 C/o (\u0915\u0947\u0905\u0930 \u0911\u092b) \u092e\u0927\u094d\u092f\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0915\u0947\u0932\u0947 \u0917\u0947\u0932\u0947 \u0906\u0939\u0947. \u0939\u0947 \u092d\u0930\u0923\u0947 \u0910\u091a\u094d\u091b\u093f\u0915 \u0906\u0939\u0947."}],bookAnAppointment:[{question:"UIDAI \u092e\u0927\u094d\u092f\u0947 \u0924\u0915\u094d\u0930\u093e\u0930 \u0928\u093f\u0935\u093e\u0930\u0923 \u091a\u0945\u0928\u0947\u0932 \u0915\u094b\u0923\u0924\u0947 \u0906\u0939\u0947\u0924?",answer:"\u0935\u094d\u092f\u0915\u094d\u0924\u0940 \u0905\u0928\u0947\u0915 \u092e\u093e\u0927\u094d\u092f\u092e\u093e\u0902\u0926\u094d\u0935\u093e\u0930\u0947 UIDAI \u092a\u0930\u094d\u092f\u0902\u0924 \u092a\u094b\u0939\u094b\u091a\u0942 \u0936\u0915\u0924\u093e\u0924 \u0909\u0926\u093e. \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0924\u0915\u094d\u0930\u093e\u0930 \u0928\u093f\u0935\u093e\u0930\u0923\u093e\u0938\u093e\u0920\u0940 \u092b\u094b\u0928, \u0908\u092e\u0947\u0932, \u091a\u0945\u091f, \u092a\u0924\u094d\u0930/\u092a\u094b\u0938\u094d\u091f, \u0935\u0947\u092c \u092a\u094b\u0930\u094d\u091f\u0932, \u0935\u0949\u0915 \u0907\u0928 \u0906\u0923\u093f \u0938\u094b\u0936\u0932 \u092e\u0940\u0921\u093f\u092f\u093e.                                                                                                                                                                                                                  \u0909\u092a\u0932\u092c\u094d\u0927 \u091a\u0945\u0928\u0947\u0932\u092c\u0926\u094d\u0926\u0932 \u0924\u092a\u0936\u0940\u0932\u0935\u093e\u0930 \u092e\u093e\u0939\u093f\u0924\u0940 \u0916\u093e\u0932\u0940\u0932\u092a\u094d\u0930\u092e\u093e\u0923\u0947 \u0906\u0939\u0947:                          1. \u092b\u094b\u0928 \u0915\u0949\u0932 (\u091f\u094b\u0932 \u092b\u094d\u0930\u0940 \u0928\u0902\u092c\u0930) -                                                              \u0906\u0927\u093e\u0930\u0936\u0940 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u092e\u0938\u094d\u092f\u093e\u0902\u0938\u093e\u0920\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u0940 UIDAI \u091f\u094b\u0932 \u092b\u094d\u0930\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 (1947) \u0935\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u0942 \u0936\u0915\u0924\u093e\u0924. UIDAI \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u092e\u0927\u094d\u092f\u0947 \u0938\u0947\u0932\u094d\u092b \u0938\u0930\u094d\u0935\u094d\u0939\u093f\u0938 IVRS (\u0907\u0902\u091f\u0930\u090f\u0915\u094d\u091f\u093f\u0935\u094d\u0939 \u0935\u094d\u0939\u0949\u0908\u0938 \u0930\u093f\u0938\u094d\u092a\u0949\u0928\u094d\u0938 \u0938\u093f\u0938\u094d\u091f\u0940\u092e) \u0906\u0923\u093f \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u0938\u0939\u093e\u092f\u094d\u092f \u0915\u093e\u0930\u094d\u092f\u0915\u093e\u0930\u0940 \u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u0939\u093e\u092f\u094d\u092f \u0905\u0938\u0924\u0947. \u0935\u094d\u092f\u0915\u094d\u0924\u0940 \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0938\u0939\u091c\u0924\u0947\u0928\u0941\u0938\u093e\u0930 \u0938\u0902\u0935\u093e\u0926\u093e\u0938\u093e\u0920\u0940 \u0916\u093e\u0932\u0940\u0932\u092a\u0948\u0915\u0940 \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u092d\u093e\u0937\u093e \u0928\u093f\u0935\u0921\u0942 \u0936\u0915\u0924\u0947.                                                                                                                                                                                         1. \u0939\u093f\u0902\u0926\u0940                                                                                            2. \u0907\u0902\u0917\u094d\u0930\u091c\u0940                                                                                          3. \u0924\u0947\u0932\u0941\u0917\u0941                                                                                           4. \u0924\u092e\u093f\u0933                                                                                            5. \u0915\u0928\u094d\u0928\u0921                                                                                            6. \u092e\u0932\u094d\u092f\u093e\u0933\u092e                                                                                      7. \u0906\u0938\u093e\u092e\u0940                                                                                        8. \u092c\u0902\u0917\u093e\u0932\u0940                                                                                         9. \u0917\u0941\u091c\u0930\u093e\u0924\u0940                                                                                      10. \u092e\u0930\u093e\u0920\u0940                                                                                          11. \u092a\u0902\u091c\u093e\u092c\u0940                                                                                      12. \u0913\u0921\u093f\u092f\u093e"},{question:"\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0902\u0938\u093e\u0920\u0940 \u0938\u0947\u0935\u093e \u0936\u0941\u0932\u094d\u0915 \u0935\u0947\u0917\u0933\u0947 \u0906\u0939\u0947 \u0915\u093e?",answer:"\u0928\u093e\u0939\u0940, \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0902\u0938\u0939 \u0926\u0947\u0936\u093e\u0924\u0940\u0932 \u0938\u0930\u094d\u0935 \u0906\u0927\u093e\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0902\u0935\u0930 \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e\u0902\u091a\u0947 \u0936\u0941\u0932\u094d\u0915 \u0938\u093e\u0930\u0916\u0947\u091a \u0906\u0939\u0947\u0924.\nFor charges please refer : Aadhaar Enrolment & Update Charges"},{question:"\u092e\u0940 \u092e\u093e\u091d\u0940 \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u092a\u0941\u0928\u094d\u0939\u093e \u0936\u0947\u0921\u094d\u092f\u0942\u0932/\u0930\u0926\u094d\u0926 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b \u0915\u093e?",answer:"\u0939\u094b\u092f, \u0924\u0941\u092e\u094d\u0939\u0940 \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f\u092e\u0927\u094d\u092f\u0947 \u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0942\u0928 \u0968\u096a \u0924\u093e\u0938\u093e\u0902\u092a\u0942\u0930\u094d\u0935\u0940 \u092d\u0947\u091f\u0940\u091a\u0940 \u0935\u0947\u0933 \u092a\u0941\u0928\u094d\u0939\u093e \u0936\u0947\u0921\u094d\u092f\u0941\u0932 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e, \u0938\u092e\u093e\u0928 \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915/\u0908\u092e\u0947\u0932 \u0906\u092f."},{question:"\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0924\u0942\u0928 \u092e\u0940 \u0915\u094b\u0923\u0924\u094d\u092f\u093e \u0938\u0947\u0935\u093e\u0902\u091a\u093e \u0932\u093e\u092d \u0918\u0947\u090a \u0936\u0915\u0924\u094b?",answer:"\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u0947 \u0938\u0930\u094d\u0935 \u092a\u094d\u0930\u0915\u093e\u0930\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e\u0924 \u091c\u0938\u0947 \u0915\u0940\n1. \u0938\u0930\u094d\u0935 \u0935\u092f\u094b\u0917\u091f\u093e\u0938\u093e\u0920\u0940 \u0928\u0935\u0940\u0928 \u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940.\n2. \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u093e\u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f \u092e\u093e\u0939\u093f\u0924\u0940\u091a\u0947 \u0905\u0926\u094d\u092f\u0924\u0928 (\u0928\u093e\u0935, \u092a\u0924\u094d\u0924\u093e, \u0932\u093f\u0902\u0917, \u091c\u0928\u094d\u092e\u0924\u093e\u0930\u0940\u0916, \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930 \u0906\u0923\u093f \u0908\u092e\u0947\u0932 \u0906\u092f\u0921\u0940).\n3. \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u092e\u093e\u0939\u093f\u0924\u0940\u091a\u0947 \u0905\u092a\u0921\u0947\u091f (\u092b\u094b\u091f\u094b, \u092b\u093f\u0902\u0917\u0930\u092a\u094d\u0930\u093f\u0902\u091f \u0906\u0923\u093f \u0906\u092f\u0930\u0940\u0938 \u0938\u094d\u0915\u0945\u0928).\n4. \u092e\u0941\u0932\u093e\u0902\u091a\u0947 \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915 \u0905\u092a\u0921\u0947\u091f (\u0935\u092f 5 \u0906\u0923\u093f 15 \u0935\u0930\u094d\u0937\u0947 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0923\u0947).\n5.\u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u0926\u094d\u092f\u0924\u0928 (POI \u0906\u0923\u093f POA) .\n6. \u0906\u0927\u093e\u0930 \u0936\u094b\u0927\u093e \u0906\u0923\u093f \u092a\u094d\u0930\u093f\u0902\u091f \u0915\u0930\u093e."},{question:"UIDAI ASKs (\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u0947) \u091a\u094d\u092f\u093e \u0935\u0947\u0933\u093e \u0915\u093e\u092f \u0906\u0939\u0947\u0924?",answer:"\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f/\u092a\u094d\u0930\u093e\u0926\u0947\u0936\u093f\u0915 \u0938\u0941\u091f\u094d\u091f\u094d\u092f\u093e \u0935\u0917\u0933\u0924\u093e \u0906\u0920\u0935\u0921\u094d\u092f\u093e\u091a\u0947 \u0938\u0930\u094d\u0935 7 \u0926\u093f\u0935\u0938 \u0909\u0918\u0921\u0940 \u0905\u0938\u0924\u093e\u0924. \u0938\u093e\u0927\u093e\u0930\u0923\u092a\u0923\u0947 \u0924\u0947 \u0938\u0915\u093e\u0933\u0940 9:30 \u0924\u0947 \u0938\u0902\u0927\u094d\u092f\u093e\u0915\u093e\u0933\u0940 5:30 (IST) \u092a\u0930\u094d\u092f\u0902\u0924 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0924\u0947.\nUIDAI ASK \u0935\u094d\u092f\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0906\u0927\u093e\u0930 \u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u0947\u0902\u0926\u094d\u0930\u0947 \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0928\u093f\u092c\u0902\u0927\u0915\u093e\u0902\u0928\u0940 \u092a\u0930\u093f\u092d\u093e\u0937\u093f\u0924 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0935\u0947\u0933\u0947\u091a\u0947 \u092a\u093e\u0932\u0928 \u0915\u0930\u0924\u093e\u0924. \u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0907\u091a\u094d\u091b\u093f\u0923\u093e\u0931\u094d\u092f\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u0940/ \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915 \u0905\u0927\u093f\u0915 \u092e\u093e\u0939\u093f\u0924\u0940\u0938\u093e\u0920\u0940 \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u091c\u0935\u0933\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u0942 \u0936\u0915\u0924\u093e\u0924."},{question:"\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 (ASK) \u092e\u094d\u0939\u0923\u091c\u0947 \u0915\u093e\u092f?",answer:"\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930' \u0915\u093f\u0902\u0935\u093e \u090f.\u090f\u0938.\u0915\u0947.  \u0939\u0947 \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0938\u093e\u0920\u0940 \u0938\u0930\u094d\u0935 \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e\u0902\u0938\u093e\u0920\u0940 \u090f\u0915 \u0925\u093e\u0902\u092c\u093e \u0920\u093f\u0915\u093e\u0923 \u0906\u0939\u0947. \u090f.\u090f\u0938.\u0915\u0947. \u0905\u0924\u094d\u092f\u093e\u0927\u0941\u0928\u093f\u0915 \u0935\u093e\u0924\u093e\u0935\u0930\u0923\u093e\u0924 \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0928\u093e \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0906\u0927\u093e\u0930 \u0928\u094b\u0902\u0926\u0923\u0940 \u0906\u0923\u093f \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0947. \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0928\u093e \u0906\u0930\u093e\u092e\u0926\u093e\u092f\u0940 \u0935\u093e\u0924\u093e\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0947. \u0938\u0930\u094d\u0935 \u090f.\u090f\u0938.\u0915\u0947. \u0935\u094d\u0939\u0940\u0932\u091a\u0947\u0905\u0930 \u0938\u094d\u0928\u0947\u0939\u0940 \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u0935\u0943\u0926\u094d\u0927 \u0906\u0923\u093f \u0935\u093f\u0936\u0947\u0937\u0924\u0903 \u0938\u0915\u094d\u0937\u092e \u0932\u094b\u0915\u093e\u0902\u091a\u094d\u092f\u093e \u0938\u0947\u0935\u0947\u0938\u093e\u0920\u0940 \u0935\u093f\u0936\u0947\u0937 \u0924\u0930\u0924\u0941\u0926\u0940 \u0906\u0939\u0947\u0924. \u090f. \u090f\u0938. \u0915\u0947. \u0935\u093f\u0937\u092f\u0940 \u0905\u0927\u093f\u0915 \u092e\u093e\u0939\u093f\u0924\u0940 \u092f\u0947\u0925\u0947 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947\u0903 uidai.gov.in \u0938\u0902\u0915\u0947\u0924\u0938\u094d\u0925\u0933."},{question:"\u092e\u0932\u093e UIDAI ASK (\u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930) \u091a\u0940 \u092f\u093e\u0926\u0940 \u0915\u0941\u0920\u0947 \u092e\u093f\u0933\u0947\u0932?",answer:"\u0938\u0930\u094d\u0935 \u0915\u093e\u0930\u094d\u092f\u093e\u0924\u094d\u092e\u0915 ASK \u091a\u0940 \u090f\u0915\u0924\u094d\u0930\u093f\u0924 \u092f\u093e\u0926\u0940 \u092f\u0947\u0925\u0947 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947: \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0938\u0942\u091a\u0940.\n\u0939\u0947 ASK \u092c\u0901\u0915\u093e, \u092a\u094b\u0938\u094d\u091f \u0911\u092b\u093f\u0938, CSC, BSNL \u0906\u0923\u093f \u0930\u093e\u091c\u094d\u092f \u0938\u0930\u0915\u093e\u0930\u093e\u0902\u0926\u094d\u0935\u093e\u0930\u0947 \u0906\u0927\u0940\u091a \u091a\u093e\u0932\u0935\u0932\u094d\u092f\u093e \u091c\u093e\u0923\u093e\u0931\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0902\u0935\u094d\u092f\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947\u0924."}],checkEnrolmentUpdateStatus:[{question:"\u0906\u0927\u093e\u0930 \u0905\u092a\u0921\u0947\u091f \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u0947\u0926\u094d\u0935\u093e\u0930\u0947 \u092e\u0940 \u0915\u094b\u0923\u0924\u0947 \u0924\u092a\u0936\u0940\u0932 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u094b?",answer:"\u092f\u093e \u0911\u0928\u0932\u093e\u0907\u0928 \u092a\u094b\u0930\u094d\u091f\u0932\u0926\u094d\u0935\u093e\u0930\u0947 \u0924\u0941\u092e\u094d\u0939\u0940 \u092b\u0915\u094d\u0924 \u092a\u0924\u094d\u0924\u093e \u0906\u0923\u093f \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e. \u0907\u0924\u0930 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0905\u092a\u0921\u0947\u091f\u0938\u093e\u0920\u0940, \u0915\u0943\u092a\u092f\u093e \u091c\u0935\u0933\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e."}],eaadhaarDownload:[{question:"\u0908-\u0906\u0927\u093e\u0930 \u092e\u094d\u0939\u0923\u091c\u0947 \u0915\u093e\u092f?",answer:"\u0908-\u0906\u0927\u093e\u0930 \u0939\u0940 \u0906\u0927\u093e\u0930\u091a\u0940 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0902\u0930\u0915\u094d\u0937\u093f\u0924 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u092a\u094d\u0930\u0924 \u0906\u0939\u0947, \u091c\u0940 UIDAI \u0926\u094d\u0935\u093e\u0930\u0947 \u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u094d\u0935\u093e\u0915\u094d\u0937\u0930\u0940 \u0915\u0947\u0932\u0947\u0932\u0940 \u0906\u0939\u0947."},{question:"\u0908-\u0906\u0927\u093e\u0930 \u0939\u0947 \u0906\u0927\u093e\u0930\u091a\u094d\u092f\u093e \u092d\u094c\u0924\u093f\u0915 \u092a\u094d\u0930\u0924\u0940\u092a\u094d\u0930\u092e\u093e\u0923\u0947\u091a \u0935\u0948\u0927 \u0906\u0939\u0947 \u0915\u093e?",answer:"\u0906\u0927\u093e\u0930 \u0915\u093e\u092f\u0926\u094d\u092f\u093e\u0928\u0941\u0938\u093e\u0930, \u0908-\u0906\u0927\u093e\u0930 \u0938\u0930\u094d\u0935 \u0909\u0926\u094d\u0926\u0947\u0936\u093e\u0902\u0938\u093e\u0920\u0940 \u0906\u0927\u093e\u0930\u091a\u094d\u092f\u093e \u092d\u094c\u0924\u093f\u0915 \u092a\u094d\u0930\u0924\u0940\u092a\u094d\u0930\u092e\u093e\u0923\u0947\u091a \u0935\u0948\u0927 \u0906\u0939\u0947. \u0908\u0906\u0927\u093e\u0930\u091a\u094d\u092f\u093e \u0935\u0948\u0927\u0924\u0947\u0938\u093e\u0920\u0940, \u0915\u0943\u092a\u092f\u093e UIDAI \u092a\u0930\u093f\u092a\u0924\u094d\u0930\u0915\u093e\u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e- https://uidai.gov.in/images/ uidai_om_on_e_aadhaar_validity.pdf"},{question:"\u092e\u0941\u0916\u0935\u091f\u093e \u0918\u093e\u0924\u0932\u0947\u0932\u093e \u0906\u0927\u093e\u0930 \u092e\u094d\u0939\u0923\u091c\u0947 \u0915\u093e\u092f?",answer:"\u092e\u0941\u0916\u0935\u091f\u093e \u0918\u093e\u0924\u0932\u0947\u0932\u093e \u0906\u0927\u093e\u0930 \u092e\u094d\u0939\u0923\u091c\u0947 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u091a\u0947 \u092a\u0939\u093f\u0932\u0947 \u096e \u0905\u0902\u0915 \u201cxxxx-xxxx\u201d \u0928\u0947 \u092c\u0926\u0932\u0923\u0947 \u0924\u0930 \u0906\u0927\u093e\u0930\u091a\u0947 \u092b\u0915\u094d\u0924 \u0936\u0947\u0935\u091f\u091a\u0947 \u096a \u0905\u0902\u0915 \u0938\u0902\u0916\u094d\u092f\u093e \u0926\u0943\u0936\u094d\u092f\u092e\u093e\u0928 \u0906\u0939\u0947\u0924."},{question:"\u0908-\u0906\u0927\u093e\u0930\u092e\u0927\u094d\u092f\u0947 \u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u094d\u0935\u093e\u0915\u094d\u0937\u0930\u0940 \u0915\u0936\u0940 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0915\u0930\u093e\u0935\u0940?",answer:"\u0915\u0943\u092a\u092f\u093e \u0906\u0927\u093e\u0930 YouTube \u091a\u0945\u0928\u0932\u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e \u0906\u0923\u093f https://youtu.be/aVNfUNIccZs?si=ByW1O6BIPMwc0seL \u0935\u0930\u0940\u0932 \u091f\u094d\u092f\u0941\u091f\u094b\u0930\u093f\u092f\u0932 \u0932\u093f\u0902\u0915 \u092a\u0939\u093e"},{question:"\u0908-\u0906\u0927\u093e\u0930\u091a\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u093e\u092f \u0906\u0939\u0947?",answer:"eAadhaar \u091a\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0939\u093e \u0915\u0945\u092a\u093f\u091f\u0932\u092e\u0927\u0940\u0932 \u0928\u093e\u0935\u093e\u091a\u094d\u092f\u093e \u092a\u0939\u093f\u0932\u094d\u092f\u093e 4 \u0905\u0915\u094d\u0937\u0930\u093e\u0902\u091a\u093e \u0906\u0923\u093f \u091c\u0928\u094d\u092e\u093e\u091a\u0947 \u0935\u0930\u094d\u0937 (YYYY) \u092f\u093e\u0902\u091a\u0947 \u092e\u093f\u0936\u094d\u0930\u0923 \u0906\u0939\u0947.\n\u0909\u0926\u093e\u0939\u0930\u0923\u093e\u0930\u094d\u0925:\n\u0909\u0926\u093e\u0939\u0930\u0923 \u0967\n\u0928\u093e\u0935: \u0938\u0941\u0930\u0947\u0936 \u0915\u0941\u092e\u093e\u0930\n\u091c\u0928\u094d\u092e \u0935\u0930\u094d\u0937: 1990\n\u092a\u093e\u0938\u0935\u0930\u094d\u0921: SURE1990\n\u0909\u0926\u093e\u0939\u0930\u0923 \u0968\n\u0928\u093e\u0935: \u0938\u093e\u0908 \u0915\u0941\u092e\u093e\u0930\n\u091c\u0928\u094d\u092e \u0935\u0930\u094d\u0937: 1990\n\u092a\u093e\u0938\u0935\u0930\u094d\u0921: SAIK1990\n\u0909\u0926\u093e\u0939\u0930\u0923 \u0969\n\u0928\u093e\u0935: \u092a\u0940. \u0915\u0941\u092e\u093e\u0930\n\u091c\u0928\u094d\u092e \u0935\u0930\u094d\u0937: 1990\n\u092a\u093e\u0938\u0935\u0930\u094d\u0921: P.KU1990\n\u0909\u0926\u093e\u0939\u0930\u0923 \u096a\n\u0928\u093e\u0935: RIA\n\u091c\u0928\u094d\u092e \u0935\u0930\u094d\u0937: 1990\n\u092a\u093e\u0938\u0935\u0930\u094d\u0921: RIA1990"},{question:"\u0908-\u0906\u0927\u093e\u0930 \u0909\u0918\u0921\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u094b\u0923\u0924\u094d\u092f\u093e \u0938\u0939\u093e\u092f\u094d\u092f\u0915 \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u0905\u0930\u091a\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0906\u0939\u0947?",answer:"\u0908-\u0906\u0927\u093e\u0930 \u092a\u093e\u0939\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0928\u093e 'Adobe Reader' \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947. \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0938\u093f\u0938\u094d\u091f\u0940\u092e\u092e\u0927\u094d\u092f\u0947 'Adobe Reader' \u0907\u0928\u094d\u0938\u094d\u091f\u0949\u0932 \u0915\u0947\u0932\u0947\u0932\u0947 \u0906\u0939\u0947. Adobe Reader \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u092e\u0927\u094d\u092f\u0947 https://get.adobe.com/reader/ \u0932\u093e \u092d\u0947\u091f \u0926\u094d\u092f\u093e."},{question:"\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915 \u0908-\u0906\u0927\u093e\u0930 \u0915\u0938\u093e \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b?",answer:"\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915 \u0924\u0940\u0928 \u092e\u093e\u0930\u094d\u0917\u093e\u0902\u0928\u0940 \u0908-\u0906\u0927\u093e\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b.\n\u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0935\u093e\u092a\u0930\u0942\u0928:\n\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0935\u093e\u092a\u0930\u0942\u0928:\n\u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0935\u093e\u092a\u0930\u0942\u0928:\n\u0908-\u0906\u0927\u093e\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0913\u091f\u0940\u092a\u0940 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0935\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0908\u0932."}],checkAadhaarValidity:[{question:"\u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921 \u0906\u0927\u093e\u0930 \u092a\u0924\u094d\u0930\u093e\u092a\u0947\u0915\u094d\u0937\u093e \u0935\u0947\u0917\u0933\u0947 \u0915\u0938\u0947 \u0906\u0939\u0947?",answer:"\u0906\u0927\u093e\u0930 \u092a\u0924\u094d\u0930 \u0939\u0947 \u0932\u0945\u092e\u093f\u0928\u0947\u091f\u0947\u0921 \u0915\u093e\u0917\u0926\u093e\u0935\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0906\u0939\u0947 \u091c\u0947 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915\u093e\u0902\u0928\u093e \u0928\u093e\u0935\u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u093f\u0902\u0935\u093e \u0905\u0926\u094d\u092f\u0924\u0928\u093e\u0928\u0902\u0924\u0930 \u091c\u093e\u0930\u0940 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u0947. \u0906\u0927\u093e\u0930 PVC \u0915\u093e\u0930\u094d\u0921 \u0939\u0947 PVC \u0906\u0927\u093e\u0930\u093f\u0924 \u091f\u093f\u0915\u093e\u090a \u0906\u0923\u093f \u0905\u0928\u0947\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f\u093e\u0902\u0938\u0939 \u0935\u093e\u0939\u0942\u0928 \u0928\u0947\u0923\u094d\u092f\u093e\u0938 \u0938\u094b\u092a\u0947 \u0915\u093e\u0930\u094d\u0921 \u0906\u0939\u0947. \u0906\u0927\u093e\u0930 \u092a\u0940\u0935\u094d\u0939\u0940\u0938\u0940 \u0915\u093e\u0930\u094d\u0921\u0939\u0940 \u0924\u093f\u0924\u0915\u0947\u091a \u0935\u0948\u0927 \u0906\u0939\u0947."}],lockUnlockAadhaar:[{question:"\u092e\u093e\u091d\u0940 \u0905\u092a\u0921\u0947\u091f \u0935\u093f\u0928\u0902\u0924\u0940 \u0905\u0935\u0948\u0927 \u0926\u0938\u094d\u0924\u0910\u0935\u091c\u093e\u0902\u0938\u093e\u0920\u0940 \u0928\u093e\u0915\u093e\u0930\u0932\u0940 \u0917\u0947\u0932\u0940. \u092f\u093e\u091a\u093e \u0905\u0930\u094d\u0925 \u0915\u093e\u092f?",answer:"\u0911\u0928\u0932\u093e\u0907\u0928 \u092a\u0924\u094d\u0924\u093e \u0905\u092a\u0921\u0947\u091f\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u094d\u0939\u0940 \u0935\u093e\u092a\u0930\u0924 \u0905\u0938\u0932\u0947\u0932\u0947 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0939\u0947 \u0905\u0938\u093e\u0935\u0947:         \u2022 https://uidai.gov.in \u0928\u0941\u0938\u093e\u0930 \u0935\u0948\u0927 \u0926\u0938\u094d\u0924\u0910\u0935\u091c                                             \u2022 \u0905\u092a\u0932\u094b\u0921 \u0915\u0947\u0932\u0947\u0932\u093e \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u091a\u094d\u092f\u093e \u0928\u093e\u0935\u093e\u0935\u0930 \u0906\u0939\u0947.                                  \u2022 \u0905\u092a\u0932\u094b\u0921 \u0915\u0947\u0932\u0947\u0932\u0940 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u092e\u0942\u0933 \u0926\u0938\u094d\u0924\u0910\u0935\u091c\u093e\u091a\u0947 \u0938\u094d\u092a\u0937\u094d\u091f \u0906\u0923\u093f \u0930\u0902\u0917\u0940\u0924 \u0938\u094d\u0915\u0945\u0928 \u0905\u0938\u093e\u0935\u0940. \u0924\u0941\u092e\u094d\u0939\u0940 \u0928\u0935\u0940\u0928 \u0905\u092a\u0921\u0947\u091f \u0935\u093f\u0928\u0902\u0924\u0940 \u0924\u092f\u093e\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0924\u0941\u092e\u094d\u0939\u0940 \u0935\u0930\u0940\u0932 \u0917\u094b\u0937\u094d\u091f\u0940\u0902\u091a\u0947 \u092a\u093e\u0932\u0928 \u0915\u0947\u0932\u094d\u092f\u093e\u091a\u0940 \u0916\u093e\u0924\u094d\u0930\u0940 \u0915\u0930\u093e."},{question:"\u0906\u0927\u093e\u0930 (UID) \u0932\u0949\u0915 \u0906\u0923\u093f \u0905\u0928\u0932\u0949\u0915 \u092e\u094d\u0939\u0923\u091c\u0947 \u0915\u093e\u092f?",answer:"\u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0938\u093e\u0920\u0940, \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u0921\u0947\u091f\u093e\u091a\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0906\u0923\u093f \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0939\u0940 \u0928\u0947\u0939\u092e\u0940\u091a \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u091a\u093f\u0902\u0924\u093e \u0905\u0938\u0924\u0947. \u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e/\u0924\u093f\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u091a\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0935\u0930 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, UIDAI \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 (UID) \u0932\u0949\u0915 \u0906\u0923\u093f \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u092f\u0902\u0924\u094d\u0930\u0923\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0947.                   \u0930\u0939\u093f\u0935\u093e\u0938\u0940 UIDAI \u0935\u0947\u092c\u0938\u093e\u0907\u091f www.myaadhaar.uidai.gov.in \u0926\u094d\u0935\u093e\u0930\u0947 \u0915\u093f\u0902\u0935\u093e mAadhaar \u0972\u092a\u0926\u094d\u0935\u093e\u0930\u0947 \u0924\u094d\u092f\u093e\u091a\u0947 \u0906\u0927\u093e\u0930 (UID) \u0932\u0949\u0915 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924.                       \u0905\u0938\u0947 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0947 \u0930\u0939\u093f\u0935\u093e\u0938\u0940 \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938, \u0921\u0947\u092e\u094b\u0917\u094d\u0930\u093e\u092b\u093f\u0915 \u0906\u0923\u093f \u0913\u091f\u0940\u092a\u0940 \u092e\u094b\u0921\u0945\u0932\u093f\u091f\u0940\u0938\u093e\u0920\u0940 UID, UID \u091f\u094b\u0915\u0928 \u0906\u0923\u093f VID \u0935\u093e\u092a\u0930\u0942\u0928 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u092a\u094d\u0930\u0915\u093e\u0930\u091a\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930\u0942 \u0936\u0915\u0924 \u0928\u093e\u0939\u0940, \u091c\u0930 \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0928\u093e UID \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u093e\u092f\u091a\u093e \u0905\u0938\u0947\u0932 \u0924\u0930 \u0924\u094b UIDAI \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0915\u093f\u0902\u0935\u093e mAadhaar \u0972\u092a\u0926\u094d\u0935\u093e\u0930\u0947 \u0928\u0935\u0940\u0928\u0924\u092e VID \u0935\u093e\u092a\u0930\u0942\u0928 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b.               \u0906\u0927\u093e\u0930 (UID) \u0905\u0928\u0932\u0949\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930, \u0930\u0939\u093f\u0935\u093e\u0938\u0940 UID, UID \u091f\u094b\u0915\u0928 \u0906\u0923\u093f VID \u0935\u093e\u092a\u0930\u0942\u0928 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b."},{question:"\u0930\u0939\u093f\u0935\u093e\u0938\u0940 UID \u0915\u0938\u0947 \u0932\u0949\u0915 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924?",answer:"\u0932\u0949\u0915\u093f\u0902\u0917 UID \u0938\u093e\u0920\u0940, \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0915\u0921\u0947 16 \u0905\u0902\u0915\u0940 VID \u0928\u0902\u092c\u0930 \u0905\u0938\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947 \u0906\u0923\u093f \u0932\u0949\u0915\u093f\u0902\u0917\u0938\u093e\u0920\u0940 \u0939\u0940 \u092a\u0942\u0930\u094d\u0935-\u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0906\u0939\u0947. \u091c\u0930 \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0915\u0921\u0947 VID \u0928\u0938\u0947\u0932 \u0924\u0930 SMS \u0938\u0947\u0935\u093e \u0915\u093f\u0902\u0935\u093e UIDAI \u0935\u0947\u092c\u0938\u093e\u0907\u091f (www.myaadhaar.uidai.gov.in) \u0926\u094d\u0935\u093e\u0930\u0947 \u091c\u0928\u0930\u0947\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924.\u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u0947\u0935\u093e.                                                          GVID \u091c\u093e\u0917\u093e UID \u091a\u094d\u092f\u093e \u0936\u0947\u0935\u091f\u091a\u094d\u092f\u093e 4 \u0915\u093f\u0902\u0935\u093e 8 \u0905\u0902\u0915\u0940 \u0906\u0939\u0947. 1947. Ex-GVID 1234 \u0935\u0930 \u090f\u0938\u090f\u092e\u090f\u0938 \u0915\u0930\u093e.                                                                                     \u0930\u0939\u093f\u0935\u093e\u0938\u0940 UIDAI \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u0932\u093e \u092d\u0947\u091f \u0926\u0947\u090a \u0936\u0915\u0924\u093e\u0924 https://resident.uidai.gov.in/aadhaar-lockunlock \u092e\u093e\u091d\u0947 \u0906\u0927\u093e\u0930 \u091f\u0945\u092c \u0905\u0902\u0924\u0930\u094d\u0917\u0924, \u0906\u0927\u093e\u0930 \u0932\u0949\u0915 \u0906\u0923\u093f \u0905\u0928\u0932\u0949\u0915 \u0938\u0947\u0935\u093e\u0902\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. UID \u0932\u0949\u0915 \u0930\u0947\u0921\u093f\u0913 \u092c\u091f\u0923 \u0928\u093f\u0935\u0921\u093e \u0906\u0923\u093f \u0928\u0935\u0940\u0928\u0924\u092e \u0924\u092a\u0936\u0940\u0932\u093e\u0902\u092a\u094d\u0930\u092e\u093e\u0923\u0947 UID \u0915\u094d\u0930\u092e\u093e\u0902\u0915, \u092a\u0942\u0930\u094d\u0923 \u0928\u093e\u0935 \u0906\u0923\u093f \u092a\u093f\u0928 \u0915\u094b\u0921 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e \u0906\u0923\u093f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u094b\u0921 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e. Send OTP \u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e \u0906\u0923\u093f \u0938\u092c\u092e\u093f\u091f \u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. \u0924\u0941\u092e\u091a\u093e UID \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u093f\u0924\u094d\u092f\u093e \u0932\u0949\u0915 \u0915\u0947\u0932\u093e \u091c\u093e\u0908\u0932."},{question:"\u0930\u0939\u093f\u0935\u093e\u0938\u0940 UID \u0915\u0938\u0947 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924?",answer:"UID \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0915\u0921\u0947 \u0928\u0935\u0940\u0928\u0924\u092e 16 \u0905\u0902\u0915\u0940 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0905\u0938\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947 \u0906\u0923\u093f \u091c\u0930 \u0930\u0939\u093f\u0935\u093e\u0938\u0940 16 \u0905\u0902\u0915\u0940 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0935\u093f\u0938\u0930\u0932\u093e \u0905\u0938\u0947\u0932 \u0924\u0930 \u0924\u094b \u092f\u0942\u0906\u092f\u0921\u0940\u091a\u094d\u092f\u093e \u0936\u0947\u0935\u091f\u091a\u094d\u092f\u093e 4 \u0915\u093f\u0902\u0935\u093e 8 \u0905\u0902\u0915\u0940 \u0906\u0930\u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0938\u094d\u092a\u0947\u0938 \u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u0947\u0935\u093e\u0902\u0926\u094d\u0935\u093e\u0930\u0947 \u0928\u0935\u0940\u0928\u0924\u092e \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b.                  1947 \u0932\u093e \u090f\u0938\u090f\u092e\u090f\u0938 \u0915\u0930\u093e. \u092e\u093e\u091c\u0940 RVID 1234                                                    UID \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0930\u0939\u093f\u0935\u093e\u0938\u0940 UIDAI \u0935\u0947\u092c\u0938\u093e\u0907\u091f https://resident.uidai.gov.in/aadhaar-lockunlock \u0932\u093e \u092d\u0947\u091f \u0926\u0947\u090a \u0936\u0915\u0924\u093e\u0924, \u0905\u0928\u0932\u0949\u0915 \u0930\u0947\u0921\u093f\u0913 \u092c\u091f\u0923 \u0928\u093f\u0935\u0921\u093e, \u0928\u0935\u0940\u0928\u0924\u092e \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0906\u0923\u093f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u094b\u0921 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e \u0906\u0923\u093f \u0913\u091f\u0940\u092a\u0940 \u092a\u093e\u0920\u0935\u093e \u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e \u0906\u0923\u093f \u0938\u092c\u092e\u093f\u091f \u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. \u0924\u0941\u092e\u091a\u093e UID \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u093f\u0924\u094d\u092f\u093e \u0905\u0928\u0932\u0949\u0915 \u0915\u0947\u0932\u093e \u091c\u093e\u0908\u0932.                                      \u0930\u0939\u093f\u0935\u093e\u0938\u0940 \u090f\u092e\u0906\u0927\u093e\u0930 \u0905\u0945\u092a\u0926\u094d\u0935\u093e\u0930\u0947 \u0906\u0927\u093e\u0930 \u0932\u0949\u0915 \u0915\u093f\u0902\u0935\u093e \u0905\u0928\u0932\u0949\u0915 \u0938\u0947\u0935\u093e \u0926\u0947\u0916\u0940\u0932 \u0935\u093e\u092a\u0930\u0942 \u0936\u0915\u0924\u093e\u0924."}],grievanceAndFeedback:[],generateOrRetrieveVid:[{question:"\u092e\u0940 \u092e\u093e\u091d\u093e \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0935\u093f\u0938\u0930\u0932\u094b. UID \u0932\u0949\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u092e\u0932\u093e \u0924\u0947 \u0915\u0938\u0947 \u092e\u093f\u0933\u0947\u0932?",answer:"\u0930\u0939\u093f\u0935\u093e\u0938\u0940 mAadhaar \u0972\u092a\u0926\u094d\u0935\u093e\u0930\u0947 \u0906\u0927\u093e\u0930 \u0932\u0949\u0915 \u0915\u093f\u0902\u0935\u093e \u0905\u0928\u0932\u0949\u0915 \u0938\u0947\u0935\u093e \u0926\u0947\u0916\u0940\u0932 \u0935\u093e\u092a\u0930\u0942 \u0936\u0915\u0924\u093e\u0924. UID \u0932\u0949\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0930\u0939\u093f\u0935\u093e\u0938\u0940 VID \u0935\u093f\u0938\u0930\u0932\u094d\u092f\u093e\u0938, \u0930\u0939\u093f\u0935\u093e\u0938\u0940 16 \u0905\u0902\u0915\u0940 VID \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 SMS \u0938\u0947\u0935\u0947\u091a\u093e \u0935\u093e\u092a\u0930 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b.                                                                                                            \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0928\u093e \u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e/\u0924\u093f\u091a\u094d\u092f\u093e \u0930\u091c\u093f\u0938\u094d\u091f\u0930 \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930\u0935\u0930 VID \u092e\u093f\u0933\u0947\u0932.                                                                                                                                                 UID \u091a\u094d\u092f\u093e \u0936\u0947\u0935\u091f\u091a\u094d\u092f\u093e 4 \u0915\u093f\u0902\u0935\u093e 8 \u0905\u0902\u0915\u0940 RVID \u0938\u094d\u092a\u0947\u0938, \u0906\u0927\u093e\u0930 \u0930\u091c\u093f\u0938\u094d\u091f\u0930 \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930\u0935\u0930\u0942\u0928 1947 \u0935\u0930 \u090f\u0938\u090f\u092e\u090f\u0938 \u092a\u093e\u0920\u0935\u093e.                                                                 \u0909\u0926\u093e:- RVID 1234"},{question:"\u0935\u094d\u0939\u0930\u094d\u091a\u094d\u092f\u0941\u0905\u0932 \u0906\u092f\u0921\u0940 (\u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940) \u092e\u094d\u0939\u0923\u091c\u0947 \u0915\u093e\u092f?",answer:"\u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0939\u093e \u0924\u093e\u0924\u094d\u092a\u0941\u0930\u0924\u093e, \u0930\u093f\u0935\u094d\u0939\u094b\u0915\u0947\u092c\u0932 16-\u0905\u0902\u0915\u0940 \u092f\u093e\u0926\u0943\u091a\u094d\u091b\u093f\u0915 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0906\u0939\u0947 \u091c\u094b \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0938\u0939 \u092e\u0945\u092a \u0915\u0947\u0932\u0947\u0932\u093e \u0906\u0939\u0947. \u091c\u0947\u0935\u094d\u0939\u093e\u0939\u0940 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u093f\u0902\u0935\u093e \u0908-\u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0938\u0947\u0935\u093e \u0915\u0947\u0932\u094d\u092f\u093e \u091c\u093e\u0924\u093e\u0924 \u0924\u0947\u0935\u094d\u0939\u093e \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u091a\u094d\u092f\u093e \u0910\u0935\u091c\u0940 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0935\u093e\u092a\u0930\u0932\u093e \u091c\u093e\u090a \u0936\u0915\u0924\u094b.\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 VID \u0935\u093e\u092a\u0930\u0942\u0928 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0935\u093e\u092a\u0930\u0932\u094d\u092f\u093e\u092a\u094d\u0930\u092e\u093e\u0923\u0947 \u0915\u0947\u0932\u0947 \u091c\u093e\u090a \u0936\u0915\u0924\u0947. VID \u0935\u0930\u0942\u0928 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0915\u093e\u0922\u0923\u0947 \u0936\u0915\u094d\u092f \u0928\u093e\u0939\u0940."},{question:"\u0930\u0939\u093f\u0935\u093e\u0938\u0940 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0915\u0938\u093e \u092e\u093f\u0933\u0935\u0924\u094b?",answer:"\u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0915\u0947\u0935\u0933 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u093e \u091c\u093e\u090a \u0936\u0915\u0924\u094b. \u0924\u0947 \u0935\u0947\u0933\u094b\u0935\u0947\u0933\u0940 \u0924\u094d\u092f\u093e\u0902\u091a\u093e \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u092c\u0926\u0932\u0942 \u0936\u0915\u0924\u093e\u0924 (\u0928\u0935\u0940\u0928 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0924\u092f\u093e\u0930 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924). \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0935\u0947\u0933\u0940 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0938\u093e\u0920\u0940 \u092b\u0915\u094d\u0924 \u090f\u0915 VID \u0935\u0948\u0927 \u0905\u0938\u0947\u0932. UIDAI \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915\u093e\u0902\u0928\u093e \u0924\u094d\u092f\u093e\u0902\u091a\u093e \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u091c\u0928\u0930\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0924\u094d\u092f\u093e\u0902\u091a\u093e \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0935\u093f\u0938\u0930\u0932\u094d\u092f\u093e\u0938 \u0924\u094d\u092f\u093e\u0902\u091a\u093e \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940\u091a\u094d\u092f\u093e \u091c\u093e\u0917\u0940 \u0928\u0935\u0940\u0928 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0926\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u093f\u0935\u093f\u0927 \u092a\u0930\u094d\u092f\u093e\u092f \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u0942\u0928 \u0926\u0947\u0924\u093e\u0924. \u0939\u0947 \u092a\u0930\u094d\u092f\u093e\u092f UIDAI \u091a\u094d\u092f\u093e \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u0935\u0930 (www.myaadhaar.uidai.gov.in), eAadhaar \u0921\u093e\u0909\u0928\u0932\u094b\u0921, mAadhaar \u092e\u094b\u092c\u093e\u0907\u0932 \u0972\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0907\u0924\u094d\u092f\u093e\u0926\u0940\u0926\u094d\u0935\u093e\u0930\u0947 \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u0940\u0932.                                                                                                  \u0906\u0927\u093e\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u0928\u0902\u092c\u0930 1947 \u0935\u0930 \u090f\u0938\u090f\u092e\u090f\u0938 \u092a\u093e\u0920\u0935\u0942\u0928 VID \u0926\u0947\u0916\u0940\u0932 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u093e \u091c\u093e\u090a \u0936\u0915\u0924\u094b. \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0928\u093e '\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u091a\u0947 GVID\u0905\u0902\u0924\u093f\u092e 4 \u0905\u0902\u0915' \u091f\u093e\u0907\u092a \u0915\u0930\u093e\u0935\u0947 \u0932\u093e\u0917\u0947\u0932 \u0906\u0923\u093f \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0926\u094d\u0935\u093e\u0930\u0947 1947 \u0935\u0930 \u092a\u093e\u0920\u0935\u093e\u0935\u0947 \u0932\u093e\u0917\u0947\u0932."},{question:"\u0907\u0924\u0930 \u0915\u094b\u0923\u0940 \u092e\u093e\u091d\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0924\u092f\u093e\u0930 \u0915\u0930\u0942 \u0936\u0915\u0947\u0932 \u0915\u093e?",answer:"AUA/KUA \u0938\u093e\u0930\u0916\u0940 \u0907\u0924\u0930 \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0938\u0902\u0938\u094d\u0925\u093e \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915\u093e\u091a\u094d\u092f\u093e \u0935\u0924\u0940\u0928\u0947 VID \u0924\u092f\u093e\u0930 \u0915\u0930\u0942 \u0936\u0915\u0924 \u0928\u093e\u0939\u0940. \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915 \u0938\u094d\u0935\u0924\u0903/\u0938\u094d\u0935\u0924\u0903 \u0924\u092f\u093e\u0930 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b. \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915\u093e\u0938 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0935\u0930 \u090f\u0938\u090f\u092e\u090f\u0938\u0926\u094d\u0935\u093e\u0930\u0947 VID \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0908\u0932."},{question:"\u091c\u0930 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915 VID \u0935\u093f\u0938\u0930\u0932\u093e \u0924\u0930? \u0924\u094b/\u0924\u0940 \u092a\u0941\u0928\u094d\u0939\u093e \u092e\u093f\u0933\u0935\u0942 \u0936\u0915\u0924\u094b \u0915\u093e?",answer:"\u0939\u094b\u092f, UIDAI \u0928\u0935\u0940\u0928 \u0924\u092f\u093e\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f/\u0915\u093f\u0902\u0935\u093e \u0935\u0930\u094d\u0924\u092e\u093e\u0928 VID \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0928\u0947\u0915 \u092e\u093e\u0930\u094d\u0917 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0947. \u0939\u0947 \u092a\u0930\u094d\u092f\u093e\u092f UIDAI \u091a\u094d\u092f\u093e \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u0935\u0930 (www.myaadhaar.uidai.gov.in), eAadhaar, mAadhaar \u092e\u094b\u092c\u093e\u0907\u0932 \u0972\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928, SMS \u0907\u0924\u094d\u092f\u093e\u0926\u0940\u0926\u094d\u0935\u093e\u0930\u0947 \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u0942\u0928 \u0926\u093f\u0932\u0947 \u0906\u0939\u0947\u0924.                                                                                                                                                              VID \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915 \u0906\u0927\u093e\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 1947 \u0935\u0930 \u090f\u0938\u090f\u092e\u090f\u0938 \u092a\u093e\u0920\u0935\u0942 \u0936\u0915\u0924\u094b. '\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u091a\u0947 RVID \u0936\u0947\u0935\u091f\u091a\u0947 4 \u0905\u0902\u0915' \u091f\u093e\u0907\u092a \u0915\u0930\u093e\u0935\u0947 \u0932\u093e\u0917\u0947\u0932 \u0906\u0923\u093f \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0926\u094d\u0935\u093e\u0930\u0947 1947 \u0935\u0930 \u092a\u093e\u0920\u0935\u093e\u0935\u0947 \u0932\u093e\u0917\u0947\u0932."},{question:"OTP \u0915\u093f\u0902\u0935\u093e \u092c\u093e\u092f\u094b\u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0915\u093f\u0902\u0935\u093e \u0921\u0947\u092e\u094b\u0917\u094d\u0930\u093e\u092b\u093f\u0915\u094d\u0938 \u0911\u0925\u0947\u0902\u091f\u093f\u0915\u0947\u0936\u0928\u0938\u093e\u0920\u0940 VID \u0935\u093e\u092a\u0930\u0924\u093e \u092f\u0947\u0908\u0932 \u0915\u093e?",answer:"\u0939\u094b\u092f. \u0906\u0927\u093e\u0930 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u091a\u094d\u092f\u093e \u0910\u0935\u091c\u0940 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940\u091a\u093e \u0935\u093e\u092a\u0930 \u0915\u0947\u0932\u093e \u091c\u093e\u090a \u0936\u0915\u0924\u094b."},{question:"\u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940\u091a\u094d\u092f\u093e \u092c\u093e\u092c\u0924\u0940\u0924, \u092e\u0932\u093e \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923\u093e\u0938\u093e\u0920\u0940 \u0938\u0902\u092e\u0924\u0940 \u0926\u0947\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947 \u0915\u093e?",answer:"\u0939\u094b\u092f, \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923\u093e\u0938\u093e\u0920\u0940 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915\u093e\u091a\u0940 \u0938\u0902\u092e\u0924\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947. \u090f\u091c\u0928\u094d\u0938\u0940\u0928\u0947 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915\u093e\u0938 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923\u093e\u091a\u094d\u092f\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u093e\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0926\u0947\u0923\u0947 \u0906\u0923\u093f \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u094d\u092a\u0937\u094d\u091f \u0938\u0902\u092e\u0924\u0940 \u0918\u0947\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947."},{question:"\u090f\u091c\u0928\u094d\u0938\u0940 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0938\u0902\u091a\u092f\u093f\u0924 \u0915\u0930\u0942 \u0936\u0915\u0924\u0947?",answer:"\u0928\u093e\u0939\u0940. VID \u0924\u093e\u0924\u094d\u092a\u0941\u0930\u0924\u093e \u0905\u0938\u0932\u094d\u092f\u093e\u0928\u0947 \u0906\u0923\u093f \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915 \u092c\u0926\u0932\u0942 \u0936\u0915\u0924\u094b, VID \u0938\u0902\u091a\u092f\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0947 \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u092e\u0942\u0932\u094d\u092f \u0928\u093e\u0939\u0940. \u090f\u091c\u0928\u094d\u0938\u0940\u0902\u0928\u0940 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0915\u093f\u0902\u0935\u093e \u0932\u0949\u0917\u092e\u0927\u094d\u092f\u0947 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0938\u093e\u0920\u0935\u0942 \u0928\u092f\u0947."},{question:"\u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940\u091a\u0940 \u092a\u0941\u0928\u0930\u094d\u0928\u093f\u0930\u094d\u092e\u093f\u0924\u0940 \u0938\u092e\u093e\u0928 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0915\u093f\u0902\u0935\u093e \u0935\u0947\u0917\u0933\u094d\u092f\u093e \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940\u0935\u0930 \u0928\u0947\u0908\u0932?",answer:"\u0915\u093f\u092e\u093e\u0928 \u0935\u0948\u0927\u0924\u093e \u0915\u093e\u0932\u093e\u0935\u0927\u0940\u0928\u0902\u0924\u0930 (\u0938\u0927\u094d\u092f\u093e 1 \u0915\u0945\u0932\u0947\u0902\u0921\u0930 \u0926\u093f\u0935\u0938 \u0915\u093f\u0902\u0935\u093e \u092e\u0927\u094d\u092f\u0930\u093e\u0924\u094d\u0930\u0940 \u0928\u0902\u0924\u0930 \u0938\u0947\u091f \u0915\u0947\u0932\u0947 \u0906\u0939\u0947. \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915 \u0928\u0935\u0940\u0928 VID \u092a\u0941\u0928\u094d\u0939\u093e \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b. \u0905\u0936\u093e\u092a\u094d\u0930\u0915\u093e\u0930\u0947, \u0928\u0935\u0940\u0928 \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0924\u092f\u093e\u0930 \u0939\u094b\u0908\u0932 \u0906\u0923\u093f \u092a\u0942\u0930\u094d\u0935\u0940\u091a\u093e \u0935\u094d\u0939\u0940\u0906\u092f\u0921\u0940 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0915\u0947\u0932\u093e \u091c\u093e\u0908\u0932. \u091c\u0930 \u0930\u0939\u093f\u0935\u093e\u0938\u0940 VID \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u093e \u092a\u0930\u094d\u092f\u093e\u092f \u0928\u093f\u0935\u0921\u0924 \u0905\u0938\u0947\u0932 \u0924\u0930, \u0936\u0947\u0935\u091f\u091a\u093e \u0938\u0915\u094d\u0930\u093f\u092f VID \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915\u093e\u0938 SMS \u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u093e\u0920\u0935\u093f\u0932\u093e \u091c\u093e\u0908\u0932. \u0930\u0939\u093f\u0935\u093e\u0936\u093e\u0902\u0928\u093e '\u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u091a\u0947 RVID\u0905\u0902\u0924\u093f\u092e 4 \u0905\u0902\u0915' \u091f\u093e\u0907\u092a \u0915\u0930\u093e\u0935\u0947 \u0932\u093e\u0917\u0947\u0932 \u0906\u0923\u093f \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0926\u094d\u0935\u093e\u0930\u0947 1947 \u0935\u0930 \u092a\u093e\u0920\u0935\u093e\u0935\u0947 \u0932\u093e\u0917\u0947\u0932."}],checkGrievanceFeedbackStatus:[{question:"VID \u091a\u093e \u090f\u0915\u094d\u0938\u092a\u093e\u092f\u0930\u0940 \u0915\u093e\u0932\u093e\u0935\u0927\u0940 \u0915\u093f\u0924\u0940 \u0906\u0939\u0947?",answer:"\u092f\u093e\u0935\u0947\u0933\u0940 VID \u0938\u093e\u0920\u0940 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u0915\u093e\u0932\u092c\u093e\u0939\u094d\u092f \u0915\u093e\u0932\u093e\u0935\u0927\u0940 \u092a\u0930\u093f\u092d\u093e\u0937\u093f\u0924 \u0915\u0947\u0932\u0947\u0932\u093e \u0928\u093e\u0939\u0940. \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0927\u093e\u0930\u0915\u093e\u0928\u0947 \u0928\u0935\u0940\u0928 VID \u0924\u092f\u093e\u0930 \u0915\u0930\u0947\u092a\u0930\u094d\u092f\u0902\u0924 VID \u0935\u0948\u0927 \u0905\u0938\u0947\u0932."}]}}},or_IN:{translation:{dashboard:{header:{title:"\u0b2e\u0b4b \u0b06\u0b27\u0b3e\u0b30",profile:{aadhaarTagLine:"\u0b2e\u0b4b \u0b06\u0b27\u0b3e\u0b30, \u0b2e\u0b4b \u0b2a\u0b30\u0b3f\u0b1a\u0b5f",clickToFlip:"\u0b2b\u0b4d\u0b32\u0b3f\u0b2a\u0b4d \u0b06\u0b27\u0b3e\u0b30 \u0b15\u0b3e\u0b30\u0b4d\u0b21",logOut:"\u0b32\u0b17\u0b06\u0b09\u0b1f \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41"}},services:{title:"\u0b38\u0b47\u0b2c\u0b3e\u0b17\u0b41\u0b21\u0b3f\u0b15",description:"\u0b05\u0b28\u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b06\u0b27\u0b3e\u0b30 \u0b38\u0b47\u0b2c\u0b3e\u0b17\u0b41\u0b21\u0b3f\u0b15\u0b30 \u0b28\u0b3f\u0b2e\u0b4d\u0b28\u0b32\u0b3f\u0b16\u0b3f\u0b24 \u0b17\u0b41\u0b1a\u0b4d\u0b1b\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15 \u0b05\u0b28\u0b41\u0b2e\u0b24\u0b3f \u0b2a\u0b3e\u0b07\u0b01 \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 | \u0b38\u0b47\u0b2c\u0b3e-\u0b28\u0b3f\u0b30\u0b4d\u0b26\u0b4d\u0b26\u0b3f\u0b37\u0b4d\u0b1f \u0b2a\u0b43\u0b37\u0b4d\u0b20\u0b3e\u0b15\u0b41 \u0b28\u0b47\u0b2d\u0b3f\u0b17\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b1f\u0b4d\u0b5f\u0b3e\u0b2c\u0b4d \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b4d\u0b32\u0b3f\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41",serviceCards:{downloadAadhaar:{title:"\u0b21\u0b3e\u0b09\u0b28\u0b32\u0b4b\u0b21\u0b4d \u0b06\u0b27\u0b3e\u0b30",description:"\u0b06\u0b27\u0b3e\u0b30\u0b30 \u0b21\u0b3f\u0b1c\u0b3f\u0b1f\u0b3e\u0b32\u0b4d \u0b38\u0b4d\u0b35\u0b3e\u0b15\u0b4d\